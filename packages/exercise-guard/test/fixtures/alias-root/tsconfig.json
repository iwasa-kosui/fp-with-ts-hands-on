{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.ts", "exercises/guard/subjects/**/*.ts", "exercises/guard/mine/**/*.ts"],
  "exclude": []
}
