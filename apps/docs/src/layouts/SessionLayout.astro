---
import {
  sessionNeighbors,
  sessionPath,
  type SessionSummary,
} from "../sessions/catalog";
import "../styles/sessions.css";
import BaseLayout from "./BaseLayout.astro";

type Props = Readonly<{
  session: SessionSummary;
}>;

const { session } = Astro.props;
const { previous, next } = sessionNeighbors(session.slug);
const commonChapters = [
  { id: "incident", label: "何が起きたか" },
  { id: "legacy", label: "配布コードを読む" },
] as const;
const reviewChapter = { id: "review", label: "レビューと持ち帰り" } as const;
const orientationChapters = [
  { id: "incident", label: "現行業務と事故" },
  { id: "legacy", label: "画面・保存・ログ" },
] as const;
const chapters =
  session.kind === "exercise"
    ? [
        ...commonChapters,
        { id: "red", label: "失敗を再現する" } as const,
        { id: "refactor", label: "型で閉じる" } as const,
        reviewChapter,
      ]
    : session.kind === "workshop"
      ? [
          { id: "incident", label: "何が起きたか" } as const,
          { id: "workflow", label: "ワークフローを描く" } as const,
          reviewChapter,
        ]
      : session.kind === "orientation"
        ? [...orientationChapters, reviewChapter]
        : [...commonChapters, reviewChapter];
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header">
      <a href="/">WAN NYAN CLINIC</a>
    </header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.animal.name}（{session.animal.type}） {session.summary}
        </p>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </details>
        <article class="case-file__content"><slot /></article>
      </div>
      <nav class="case-file__session-nav" aria-label="前後のセッション">
        {
          previous === undefined ? null : (
            <a rel="prev" href={sessionPath(previous)}>前へ: {previous.title}</a>
          )
        }
        {
          next === undefined ? null : (
            <a rel="next" href={sessionPath(next)}>次へ: {next.title}</a>
          )
        }
      </nav>
    </main>
  </div>
</BaseLayout>
