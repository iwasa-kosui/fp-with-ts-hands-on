---
import { Code } from "astro:components";

type Props = { code: string };

const { code } = Astro.props;
const codeLines = code.split("\n").filter((line) => !line.trim().startsWith("//")).map((line) => line.replace(/\s*\/\/.*$/, ""));
const displayCode = codeLines.join("\n");
const lineOf = (text: string) => codeLines.findIndex((line) => line.includes(text));
const range = (start: number, end: number) => Array.from({ length: end - start + 1 }, (_, index) => start + index);

const frames = [
  {
    step: "まだ case を処理していない",
    values: [{ text: '"Scheduled"' }, { text: '"CheckedIn"' }],
    type: "Status",
    count: "値は2個",
    assignable: false,
  },
  {
    step: 'case "Scheduled" を処理した',
    values: [{ text: '"Scheduled"', leaving: true }, { text: '"CheckedIn"' }],
    type: '"CheckedIn"',
    count: "値は1個",
    assignable: false,
  },
  {
    step: 'case "CheckedIn" も処理した',
    values: [null, { text: '"CheckedIn"', leaving: true }],
    type: "never",
    count: "値は0個（空集合）",
    assignable: true,
  },
];

const scheduledLine = lineOf('case "Scheduled"');
const checkedInLine = lineOf('case "CheckedIn"');
const defaultLine = lineOf("default:");

const steps = [
  {
    frame: 0,
    lines: [lineOf("switch (status)")],
    text: "switch に入った時点では、status の型は Status で、値は2個です。",
  },
  {
    frame: 1,
    lines: range(scheduledLine, scheduledLine + 1),
    text: 'case "Scheduled" を処理すると、値 "Scheduled" が枠から出ます。default に残る型は "CheckedIn" です。',
  },
  {
    frame: 2,
    lines: range(checkedInLine, checkedInLine + 1),
    text: 'case "CheckedIn" を処理すると、枠が空になります。default に残る型は never です。',
  },
  {
    frame: 2,
    lines: range(defaultLine, lineOf("const rest")),
    text: "default に届く status の型は never なので、never 型の rest へ代入できます。",
  },
];
---

<figure class="never-set" data-never-set data-steps={JSON.stringify(steps)}>
  <p class="never-set__definition"><Code code={'type Status = "Scheduled" | "CheckedIn";'} lang="ts" inline />（説明用の型）</p>
  <div class="never-set__stage">
  <div class="never-set__code">
    <Code code={displayCode} lang="ts" />
  </div>
  <ol class="never-set__frames">
    {
      frames.map((frame) => (
        <li class:list={["never-set__frame", { "never-set__frame--empty": frame.assignable }]}>
          <p class="never-set__step">{frame.step}</p>
          <div class="never-set__set">
            {frame.values.map((value) =>
              value === null ? (
                <span class="never-set__slot" />
              ) : (
                <span class:list={["never-set__value", { "never-set__value--leaving": value.leaving }]} aria-hidden={value.leaving ? "true" : undefined}>
                  <Code code={value.text} lang="ts" inline />
                </span>
              ),
            )}
          </div>
          <p class="never-set__type">
            default に残る型
            <Code code={frame.type} lang="ts" inline />
          </p>
          <p class="never-set__count">{frame.count}</p>
          <p class:list={["never-set__assign", frame.assignable ? "never-set__assign--ok" : "never-set__assign--error"]}>
            {frame.assignable ? "✅ never へ代入できる" : "❌ never へ代入できない"}
          </p>
        </li>
      ))
    }
  </ol>
  </div>
  <div class="never-set__controls" data-never-set-controls data-controls hidden>
    <button type="button" data-never-set-play>▶ 再生</button>
    <button type="button" data-never-set-prev data-prev disabled>← 前へ</button>
    <button type="button" data-never-set-next data-next>次へ →</button>
  </div>
  <p class="never-set__status" data-never-set-status aria-live="polite" hidden></p>
  <figcaption>
    枠は型、枠の中は値です。枠が空になった型が never です。
  </figcaption>
</figure>

<script is:inline type="module">
  const AUTO_PLAY_INTERVAL_MS = 2800;

  const setup = (root) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const steps = JSON.parse(root.dataset.steps ?? "[]");
    const lines = root.querySelectorAll(".never-set__code .line");
    const frames = root.querySelectorAll(".never-set__frame");
    const controls = root.querySelector("[data-never-set-controls]");
    const status = root.querySelector("[data-never-set-status]");
    const play = root.querySelector("[data-never-set-play]");
    const prev = root.querySelector("[data-never-set-prev]");
    const next = root.querySelector("[data-never-set-next]");
    if (!controls || !status || !play || !prev || !next) return;

    const last = steps.length - 1;
    let current = 0;
    let timer;

    const render = (previous) => {
      const step = steps[current];
      const previousFrame = steps[previous]?.frame ?? -1;
      status.textContent = step.text;
      root.classList.toggle("is-final", current === last);
      lines.forEach((line, index) => line.classList.toggle("is-active", step.lines.includes(index)));
      frames.forEach((frame, index) => {
        const isActive = index === step.frame;
        frame.classList.toggle("is-active", isActive);
        frame.classList.toggle("is-entering", isActive && index > previousFrame);
      });
      prev.disabled = current === 0;
      next.disabled = current === last;
      play.textContent = timer !== undefined ? "⏸ 一時停止" : current === last ? "↺ 最初から" : "▶ 再生";
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const moveTo = (index) => {
      const previous = current;
      current = index;
      render(previous);
    };

    const start = () => {
      timer = window.setInterval(() => {
        if (current === last - 1) stop();
        moveTo(current + 1);
      }, AUTO_PLAY_INTERVAL_MS);
      render(current);
    };

    play.addEventListener("click", () => {
      if (timer !== undefined) {
        stop();
        render(current);
        return;
      }
      moveTo(current === last ? 0 : current + 1);
      if (current !== last) start();
    });

    prev.addEventListener("click", () => {
      stop();
      moveTo(current - 1);
    });

    next.addEventListener("click", () => {
      stop();
      moveTo(current + 1);
    });

    root.classList.add("is-playing");
    controls.hidden = false;
    status.hidden = false;
    render(-1);
  };

  document.querySelectorAll("[data-never-set]").forEach(setup);
</script>

<style>
  .never-set {
    margin: 1.25rem 0;
  }

  .never-set__definition {
    margin: 0 0 0.75rem;
  }

  .never-set__code {
    margin-bottom: 0.75rem;
  }

  .never-set__code :global(pre) {
    margin: 0;
    padding: 0.75rem 0;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .never-set__code :global(code) {
    display: grid;
    min-width: max-content;
  }

  .never-set__code :global(.line) {
    padding: 0 0.875rem;
    border-left: 4px solid transparent;
    transition: background-color 0.25s ease;
  }

  .never-set__code :global(.line.is-active) {
    border-left-color: #ffd84d;
    background: rgb(255 216 77 / 22%);
  }

  .never-set__controls:not([hidden]) {
    display: grid;
    grid-template-columns: 8rem 5.5rem 5.5rem;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .never-set__controls button {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    white-space: nowrap;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: #fffdf7;
    color: var(--case-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .never-set__controls button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .never-set__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .never-set__frames {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .never-set__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
  }

  .never-set__frame + .never-set__frame::before {
    content: "→";
    position: absolute;
    top: 6.25rem;
    left: -1.45rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--case-line);
  }

  .never-set__frame p {
    margin: 0;
  }

  .never-set__step {
    min-height: 2.8em;
    font-weight: 700;
    line-height: 1.4;
  }

  .never-set__set {
    display: grid;
    grid-template-rows: repeat(2, 2.25rem);
    gap: 0.5rem;
    padding: 0.75rem;
    border: 3px solid var(--case-line);
    border-radius: 1.25rem;
    background: #fffdf7;
  }

  .never-set__value {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #24292e;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  .never-set__value :global(code) {
    padding: 0;
    background: transparent !important;
    font-size: inherit;
  }

  .never-set__definition :global(code),
  .never-set__type :global(code) {
    width: fit-content;
    padding: 0.125rem 0.5rem;
    border-radius: 0.375rem;
  }

  .never-set__value--leaving {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .never-set__frame.is-entering .never-set__value--leaving {
      visibility: visible;
      animation: never-set-leave 0.5s ease-in 0.15s both;
    }

    @keyframes never-set-leave {
      from {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      to {
        opacity: 0;
        transform: translateY(-0.5rem) scale(0.92);
      }
    }
  }

  .never-set__frame--empty .never-set__set {
    border-color: #137333;
  }

  .never-set__type {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.875rem;
  }

  .never-set__type :global(code) {
    font-size: 1rem;
    font-weight: 700;
  }

  .never-set__count {
    font-weight: 700;
  }

  .never-set__assign {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .never-set__assign--ok {
    color: #137333;
  }

  .never-set__assign--error {
    color: #b42318;
  }

  .never-set > figcaption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--case-ink) 78%, var(--case-paper));
  }

  .never-set.is-playing .never-set__frames {
    display: block;
  }

  .never-set.is-playing .never-set__frame:not(.is-active) {
    display: none;
  }

  .never-set.is-playing .never-set__frame::before {
    content: none;
  }

  .never-set.is-playing .never-set__step,
  .never-set.is-playing .never-set__count,
  .never-set.is-playing .never-set__assign {
    display: none;
  }

  .never-set.is-final .never-set__frame .never-set__assign--ok {
    display: block;
  }

  .never-set.is-playing .never-set__type :global(code) {
    font-size: 1.25rem;
  }

  @media (min-width: 768px) {
    .never-set.is-playing .never-set__stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 1.25rem;
      align-items: start;
    }

    .never-set.is-playing .never-set__code {
      margin-bottom: 0;
    }

    .never-set.is-playing .never-set__set {
      grid-template-rows: repeat(2, 3rem);
    }

    .never-set.is-playing .never-set__value {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 767px) {
    .never-set__frames {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .never-set__frame {
      display: grid;
      grid-template-columns: 7.75rem minmax(0, 1fr);
      gap: 0.25rem 0.75rem;
      align-content: start;
    }

    .never-set__frame + .never-set__frame::before {
      content: "↓";
      top: -1.8rem;
      left: 3.5rem;
    }

    .never-set__step {
      grid-column: 1 / -1;
      min-height: 0;
    }

    .never-set__set {
      grid-column: 1;
      grid-row: 2 / span 3;
      align-self: start;
      padding: 0.5rem;
    }

    .never-set__value {
      font-size: 0.8125rem;
    }

    .never-set__type,
    .never-set__count,
    .never-set__assign {
      grid-column: 2;
    }

    .never-set__code :global(pre) {
      font-size: 0.75rem;
    }

    .never-set.is-playing .never-set__set {
      grid-row: 1 / span 3;
    }

    .never-set.is-playing .never-set__type :global(code) {
      font-size: 1rem;
    }

    .never-set__controls:not([hidden]) {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    }

    .never-set__controls button {
      font-size: 0.875rem;
    }
  }
</style>
