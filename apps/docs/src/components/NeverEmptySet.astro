---
import { Code } from "astro:components";
import StepControls from "./stepper/StepControls.astro";

type Slot = Readonly<{ text: string; gone: boolean }>;
type Box = Readonly<{ title: string; slots: readonly Slot[]; count: string }>;
type Frame = Readonly<{
  done: readonly string[];
  boxes: readonly Box[];
  final: boolean;
}>;

const scheduled = (gone: boolean): Slot => ({ text: '"Scheduled"', gone });
const checkedIn = (gone: boolean): Slot => ({ text: '"CheckedIn"', gone });

const startBox: Box = { title: "default に残る候補", slots: [scheduled(false), checkedIn(false)], count: "2個" };
const oneBox: Box = { title: "default に残る候補", slots: [scheduled(true), checkedIn(false)], count: "1個" };
const emptyBox: Box = { title: "default に残る候補", slots: [scheduled(true), checkedIn(true)], count: "0個" };

const frames: readonly Frame[] = [
  { done: [], boxes: [startBox], final: false },
  { done: ['"Scheduled"'], boxes: [oneBox], final: false },
  { done: ['"Scheduled"', '"CheckedIn"'], boxes: [emptyBox], final: false },
  {
    done: [],
    boxes: [
      { ...startBox, title: "case を処理する前" },
      { ...oneBox, title: '"Scheduled" を処理した後' },
      { ...emptyBox, title: '"CheckedIn" も処理した後' },
    ],
    final: true,
  },
];
---

<figure class="never" data-never-empty-set aria-label="case を処理するたびに、default に残る候補が減って0個になる図">
  <p class="never__type">
    説明用の型: <Code code={'type Status = "Scheduled" | "CheckedIn";'} lang="ts" inline />
  </p>
  <StepControls />

  <div aria-live="polite">
    <ol class="never__frames">
      {
        frames.map((frame, frameIndex) => (
          <li data-frame>
            <div class:list={["never__stage", { "never__stage--final": frame.final }]}>
              {!frame.final && (
                <div class="never__done">
                  <p class="never__title">処理した case</p>
                  {frame.done.length === 0 ? (
                    <p class="never__none">まだありません</p>
                  ) : (
                    <ul>
                      {frame.done.map((text) => (
                        <li><span aria-hidden="true">✓</span> <Code code={text} lang="ts" inline /></li>
                      ))}
                    </ul>
                  )}
                </div>
              )}
              {frame.boxes.map((box, boxIndex) => {
                const empty = box.slots.every(({ gone }) => gone);
                return (
                  <>
                    {boxIndex > 0 && <span class="never__arrow" aria-hidden="true">→</span>}
                    <div class:list={["never__box", { "never__box--empty": empty }]}>
                      <p class="never__title">{box.title}</p>
                      <ul class="never__slots">
                        {box.slots.map((slot) => (
                          <li class:list={["never__slot", { "never__slot--gone": slot.gone }]}>
                            <Code code={slot.text} lang="ts" inline />
                            {slot.gone && <small>処理済み</small>}
                          </li>
                        ))}
                      </ul>
                      {empty && <p class="never__empty"><span aria-hidden="true">∅</span> 空っぽ</p>}
                      <p class="never__count">
                        {box.count}
                        {empty && <span>（<code>never</code>）</span>}
                      </p>
                    </div>
                  </>
                );
              })}
            </div>
            <p class="never__caption" data-frame-index={frameIndex}>
              {frameIndex === 0 && <>まだ <code>case</code> を処理していないので、<code>default</code> に残る候補は2個です。</>}
              {frameIndex === 1 && <><code>case "Scheduled"</code> を処理しました。型検査が、この <code>case</code> の後に残る候補を数えると、1個です。<code>"Scheduled"</code> の札は箱から消えます。</>}
              {frameIndex === 2 && <><code>case "CheckedIn"</code> も処理しました。型検査が、この <code>case</code> の後に残る候補を数えると、0個です。箱は空になります。</>}
              {frameIndex === 3 && <>候補が0個の型を <code>never</code> と呼びます。<code>default</code> に届く値の型が <code>never</code> なら、case の処理漏れはありません。次のページのコードでは、<code>kind</code> で絞ると <code>appointment</code> の候補も同じように減ります。</>}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "./stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-never-empty-set]").forEach((root) => {
    mountStepper({ root });
  });
</script>

<style>
  .never {
    min-width: 0;
    margin: 0.5rem 0;
    color: var(--role-text);
  }

  .never :global(.step-controls) {
    margin-block-end: 0.5rem;
  }

  .never__type {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
  }

  .never__type :global(code),
  .never__slot :global(code),
  .never__done :global(code) {
    padding: 0.0625rem 0.5rem;
    border-radius: 0.375rem;
  }

  .never__frames {
    margin: 0;
    padding-inline-start: 1.5rem;
  }

  .never__frames > li + li {
    margin-block-start: 1rem;
  }

  .never[data-ready] .never__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .never[data-ready] .never__frames > li {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .never[data-ready] .never__frames > li + li {
    margin-block-start: 0;
  }

  .never[data-ready] .never__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .never__stage {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) minmax(0, 20rem);
    gap: 1rem;
    align-items: start;
    justify-content: center;
  }

  .never__stage--final {
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 0.5rem;
  }

  .never__stage p {
    margin: 0;
  }

  .never__title {
    color: var(--role-muted);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .never__done {
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .never__done ul {
    display: grid;
    gap: 0.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .never__done li {
    margin: 0;
    color: var(--role-positive);
    font-weight: 800;
  }

  .never__none {
    margin-block-start: 0.25rem;
    color: var(--role-muted);
    font-size: 0.875rem;
  }

  .never__box {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 3px solid var(--role-border);
    border-radius: 1rem;
    background: var(--role-surface);
  }

  .never__box--empty {
    border-color: var(--role-positive);
    border-style: dashed;
  }

  .never__slots {
    display: grid;
    grid-template-rows: repeat(2, 2.25rem);
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .never__slot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    border: 2px solid var(--role-accent);
    border-radius: 999px;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .never__slot--gone {
    border-color: var(--role-border);
    border-style: dashed;
    color: var(--role-muted);
  }

  .never__slot--gone :global(code) {
    text-decoration: line-through;
  }

  .never__slot small {
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .never__empty {
    color: var(--role-positive);
    font-size: 1.125rem;
    font-weight: 800;
    text-align: center;
  }

  .never__empty span {
    font-size: 1.5rem;
    line-height: 1;
  }

  .never__count {
    font-size: 1.125rem;
    font-weight: 800;
    text-align: center;
  }

  .never__count span {
    color: var(--role-positive);
  }

  .never__arrow {
    align-self: center;
    color: var(--role-muted);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .never__caption {
    margin: 0.75rem 0 0;
    font-weight: 700;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .never[data-ready] .never__frames > li:not([hidden]) .never__slot--gone {
      animation: never-fade 0.5s ease-out both;
    }

    @keyframes never-fade {
      from {
        opacity: 1;
        border-color: var(--role-accent);
        border-style: solid;
        color: inherit;
      }
    }
  }

  @media (max-width: 44rem) {
    .never__stage,
    .never__stage--final {
      grid-template-columns: minmax(0, 1fr);
    }

    .never__arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
