---
import { Code } from "astro:components";
import MiniTree from "./mini-tree/MiniTree.astro";
import { miniTree } from "./mini-tree/mini-tree";
import StepControls from "./stepper/StepControls.astro";
import { checkBands, lineAll, lineCount, lineIndex } from "./workflow-errors/lines";
import { lineLabelOf } from "../sessions/source-quotes";
import { matchCall, noticeMessage, onErrorLine, paths, pipelineBody, pipelineResultType } from "./workflow-errors/sources";
import "./workflow-errors/figure.css";

interface Props {
  scenario: "business" | "system";
}

const { scenario } = Astro.props;

const themes = { light: "github-light", dark: "github-dark" } as const;

const resolveLine = lineIndex(pipelineBody, "deps.resolver.resolveById");
const andThenLine = lineIndex(pipelineBody, ".andThen(ensureCheckedIn)");
const [transitionStart = 0, saveStart = 0] = lineAll(pipelineBody, ".map((appointment) =>");
const saveLine = lineIndex(pipelineBody, "deps.store.save");
const lastLine = lineCount(pipelineBody) - 1;
const range = (from: number, to: number): readonly number[] => Array.from({ length: to - from + 1 }, (_, i) => from + i);
const skipAfterAndThen = range(andThenLine + 1, lastLine);

const webCode = matchCall;
const failureArm = range(lineIndex(webCode, "(error) =>"), lineIndex(webCode, "(error) =>") + 5);
const boundaryCode = onErrorLine;

const resultType = (/:\s*(Result<.+>)\s*=>/.exec(pipelineResultType)?.[1]) ?? "";

type Mark = Readonly<{ bands?: Readonly<Record<string, readonly number[]>>; skip?: readonly number[] }>;
type Step = Readonly<{
  text: string;
  at: "use" | "dest";
  tone: "neutral" | "biz" | "sys";
  badge: string;
  mark: "ok" | "err" | "exc" | "none";
  use: Mark;
  dest: Mark;
  connector: boolean;
  files?: readonly string[];
}>;

const businessSteps: readonly Step[] = [
  {
    text: "獣医師が、存在しない予約IDで診察開始を依頼します。resolver.resolveById は予約を取得できず、undefined を返します。",
    at: "use", tone: "neutral", badge: "undefined", mark: "none", connector: false, dest: {},
    use: { bands: checkBands(pipelineBody, { a: [resolveLine] }) },
  },
  {
    text: "ensureAppointmentFound は例外を投げず、AppointmentNotFound を Err として返します。",
    at: "use", tone: "biz", badge: "Err", mark: "err", connector: false, dest: {},
    use: { bands: checkBands(pipelineBody, { err: range(0, andThenLine - 1) }) },
  },
  {
    text: "結果が Err であるため、後続の andThen と map は呼ばれません。状態遷移も保存も実行されません。",
    at: "use", tone: "biz", badge: "Err", mark: "err", connector: false, dest: {},
    use: { skip: skipAfterAndThen },
  },
  {
    text: `startExamination は Err を値として返します。戻り値の型 ${resultType} に、この失敗が含まれています。`,
    at: "use", tone: "biz", badge: "Err", mark: "err", connector: true, dest: {},
    use: { skip: skipAfterAndThen },
  },
  {
    text: "route の match が失敗側で Err を受け取り、失敗の種類に対応する画面のお知らせを選択します。獣医師は予約を探し直せます。",
    at: "dest", tone: "biz", badge: "Err", mark: "err", connector: true,
    use: { skip: skipAfterAndThen },
    dest: { bands: checkBands(webCode, { err: failureArm }) },
  },
];

const systemSteps: readonly Step[] = [
  {
    text: "予約は見つかり、来院済みです。ensureAppointmentFound と ensureCheckedIn は Ok を返します。",
    at: "use", tone: "neutral", badge: "Ok", mark: "ok", connector: false, dest: {}, files: ["useCase"],
    use: { bands: checkBands(pipelineBody, { ok: range(0, andThenLine) }) },
  },
  {
    text: "状態遷移で診察中の予約を作り、store.save で保存します。",
    at: "use", tone: "neutral", badge: "Ok", mark: "ok", connector: false, dest: {}, files: ["useCase"],
    use: { bands: checkBands(pipelineBody, { ok: range(transitionStart, saveLine) }) },
  },
  {
    text: "保存の途中でデータベースへの接続が切れ、store.save が例外を投げます。",
    at: "use", tone: "sys", badge: "例外", mark: "exc", connector: false, dest: {}, files: ["useCase", "store"],
    use: { bands: checkBands(pipelineBody, { err: [saveLine] }) },
  },
  {
    text: "この例外は Result に変換しません。startExamination は値を返さずに終了し、route の match と switch には渡されません。",
    at: "use", tone: "sys", badge: "例外", mark: "exc", connector: true, dest: {}, files: ["useCase"],
    use: { bands: checkBands(pipelineBody, { err: range(saveStart, saveLine) }), skip: range(saveLine + 1, lastLine) },
  },
  {
    text: "例外を最後に受け取る場所（app.onError）が例外を受け取り、500 を返します。",
    at: "dest", tone: "sys", badge: "例外", mark: "exc", connector: true, files: ["app"],
    use: { bands: checkBands(pipelineBody, { err: range(saveStart, saveLine) }), skip: range(saveLine + 1, lastLine) },
    dest: {},
  },
];

const steps = scenario === "business" ? businessSteps : systemSteps;
const isBusiness = scenario === "business";
const tree = miniTree("session-04-solution", "src/", [
  { folder: "useCase/", files: [{ id: "useCase", name: "startExamination.ts" }] },
  { folder: "adaptor/secondary/sqlite/", files: [{ id: "store", name: "appointmentStore.ts" }] },
  { folder: "", files: [{ id: "app", name: "app.ts" }] },
]);
const destTitle = isBusiness ? "route の match → 画面のお知らせ" : "例外を最後に受け取る場所（app.onError）→ 500";
const useCaseLabel = lineLabelOf("session-04-solution", "src/useCase/startExamination.ts", "    ensureAppointmentFound(", "      });");
const realRouteLabel = lineLabelOf("session-04-solution", "src/adaptor/primary/web/routes.ts", "    return result.match(", "    );");
const footnotes: readonly Readonly<{ text: string; file?: string }>[] = isBusiness
  ? [
    { text: "startExamination の引用元:", file: useCaseLabel },
    { text: "route の match は説明用（配布コードにはありません）。実物の route:", file: realRouteLabel },
  ]
  : [{ text: `引用元: ${paths.solutionUseCase}:29-44 と ${paths.solutionApp}:34` }];
const connectorText = isBusiness ? "Err を返す" : "例外が伝わる";
const legend = isBusiness ? "破線の枠: Err の値として返る経路" : "実線の枠: 例外として伝わる経路";
const data = JSON.stringify(steps.map(({ text: _text, ...rest }) => rest));
---

<figure class="we-fig we-fig--top eo-flow" data-exception-or-result data-scenario={scenario} data-steps={data} aria-label={isBusiness ? "業務の失敗が Err として route へ渡される流れ" : "障害の例外が外側で 500 になる流れ"}>
  <StepControls />

  <ol class="we-frames">
    {steps.map(({ text }) => (
      <li data-frame><p class="we-caption">{text}</p></li>
    ))}
  </ol>

  {!isBusiness && <MiniTree tree={tree} current={systemSteps[0]?.files} />}

  <div class="we-body eo-map">
    <section class="eo-box" data-place="use">
      <p class="eo-title"><span>startExamination</span><span class="eo-badge" data-badge></span><span class="eo-legend">{legend}</span></p>
      <figure class="we-code" data-code="use">
        <Code code={pipelineBody} lang="ts" themes={themes} defaultColor={false} />
      </figure>
    </section>

    <div class="eo-connector" data-connector>
      <span>{connectorText}</span>
      <span class="eo-connector__line" aria-hidden="true">→</span>
    </div>

    <section class="eo-box" data-place="dest">
      <p class="eo-title"><span>{destTitle}</span><span class="eo-badge" data-badge></span></p>
      <figure class="we-code" data-code="dest" data-wrap="true">
        <Code code={isBusiness ? webCode : boundaryCode} lang="ts" themes={themes} defaultColor={false} />
      </figure>
      {isBusiness && (
        <p class="eo-notice" data-notice>
          <span class="we-chip" data-band="err"><code class="we-mono">AppointmentNotFound</code></span>
          <span aria-hidden="true">→</span>
          <span class="we-box" data-tone="ok">「{noticeMessage("AppointmentNotFound")}」</span>
        </p>
      )}
      {!isBusiness && (
        <p class="eo-note">この教材の app.onError は 500 を返すだけです。実際の業務では、処理の取り消しや接続の解放を、このような外側の場所でまとめて実装することが多くあります。</p>
      )}
      <p class="eo-path">{footnotes.map(({ text, file }) => <span>{text}{file !== undefined && <> <span class="eo-path__file">{file}</span></>}</span>)}</p>
    </section>
  </div>
</figure>

<script>
  import { setMiniTreeCurrent } from "./mini-tree/mini-tree-client";
  import { mountStepper } from "./stepper/stepper";
  import { applyMark, type Mark } from "./workflow-errors/lit";

  type Step = {
    at: "use" | "dest";
    tone: string;
    badge: string;
    mark: string;
    use: Mark;
    dest: Mark;
    connector: boolean;
    files?: string[];
  };

  document.querySelectorAll<HTMLElement>("[data-exception-or-result]").forEach((root) => {
    const steps = JSON.parse(root.dataset.steps ?? "[]") as Step[];
    const boxes = [...root.querySelectorAll<HTMLElement>("[data-place]")];
    const connector = root.querySelector<HTMLElement>("[data-connector]");
    const codeOf = (place: string) => root.querySelector<HTMLElement>(`[data-code="${place}"]`);
    mountStepper({
      root,
      onStep: (index) => {
        const step = steps[index];
        if (step === undefined) return;
        boxes.forEach((box) => {
          const place = box.dataset.place ?? "";
          const here = place === step.at;
          box.dataset.current = String(here);
          box.dataset.reached = String(place === "use" || step.at === "dest");
          box.dataset.tone = here ? step.tone : "neutral";
          const badge = box.querySelector<HTMLElement>("[data-badge]");
          if (badge === null) return;
          badge.textContent = here ? step.badge : "";
          badge.dataset.mark = here ? step.mark : "";
        });
        if (connector !== null) connector.dataset.active = String(step.connector);
        const use = codeOf("use");
        const dest = codeOf("dest");
        if (use !== null) applyMark(use, step.use);
        if (dest !== null) applyMark(dest, step.dest);
        if (step.files !== undefined) setMiniTreeCurrent(root, step.files);
      },
    });
  });
</script>

<style>
  .eo-map {
    display: grid;
    grid-template-columns: minmax(0, 27rem) 3rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
  }

  .eo-box {
    min-width: 0;
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .eo-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-block-end: 0.125rem;
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .eo-badge {
    display: none;
    padding: 0 0.5rem;
    border: 2px solid var(--role-border);
    border-radius: 999px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .eo-badge[data-mark="ok"],
  .eo-badge[data-mark="err"],
  .eo-badge[data-mark="exc"],
  .eo-badge[data-mark="none"] {
    display: inline-block;
  }

  .eo-badge[data-mark="ok"] {
    border-color: var(--role-positive);
    background: var(--role-positive);
    color: var(--role-surface);
  }

  .eo-badge[data-mark="err"] {
    border-color: var(--role-negative);
    background: var(--role-negative);
    color: var(--role-surface);
  }

  .eo-badge[data-mark="exc"] {
    border-color: var(--role-negative);
    color: var(--role-negative);
  }

  .eo-path {
    margin-block-start: 0.25rem;
    color: var(--role-muted);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .eo-path > span {
    display: block;
  }

  .eo-path__file {
    white-space: nowrap;
  }

  .eo-legend {
    margin-inline-start: auto;
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .eo-box .we-code {
    border-color: var(--role-border);
  }

  .eo-box [data-wrap="true"] :global(.astro-code) {
    overflow-x: visible;
  }

  .eo-box [data-wrap="true"] :global(.astro-code code) {
    min-width: 0;
  }

  .eo-box [data-wrap="true"] :global(.line) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .eo-note {
    margin-block-start: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .eo-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin-block-start: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .eo-notice .we-box {
    padding-block: 0.125rem;
  }

  .eo-notice code {
    padding: 0;
    background: none;
    font-size: 0.8125rem;
  }

  .eo-connector {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.25rem;
    padding-block-start: 2rem;
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
  }

  .eo-connector__line {
    font-size: 1.5rem;
    line-height: 1;
  }

  .eo-flow[data-ready] .eo-box {
    transition: background-color 0.2s, border-color 0.2s;
  }

  .eo-flow[data-ready] .eo-box[data-reached="false"],
  .eo-flow[data-ready] .eo-box[data-reached="false"] .we-code {
    border-color: color-mix(in srgb, var(--role-border) 40%, transparent);
    background: color-mix(in srgb, var(--role-surface) 40%, transparent);
  }

  .eo-flow[data-ready] .eo-box[data-current="true"][data-tone="biz"] {
    border-style: dashed;
    border-color: var(--role-negative);
  }

  .eo-flow[data-ready] .eo-box[data-current="true"][data-tone="sys"] {
    border-style: solid;
    border-color: var(--role-negative);
  }

  .eo-flow[data-ready] .eo-box[data-current="true"][data-tone="neutral"] {
    border-color: var(--role-text);
  }

  .eo-flow[data-ready] .eo-connector[data-active="true"] {
    color: var(--role-negative);
  }

  @media (max-height: 700px) {
    .eo-flow[data-ready] .eo-map {
      margin-block-start: 0.125rem;
    }

    .eo-box {
      padding-block: 0.125rem;
    }

    .eo-flow :global(.mini-tree__file) {
      padding-block: 0;
    }
  }

  @media (max-width: 48rem) {
    .eo-map {
      grid-template-columns: minmax(0, 1fr);
    }

    .eo-connector {
      display: none;
    }
  }
</style>
