---
import { Code } from "astro:components";

interface Props {
  files: Readonly<Record<string, string>>;
}

const { files } = Astro.props;
const entries = Object.entries(files).sort(([left], [right]) =>
  left.localeCompare(right),
);
const languageOf = (path: string) => (path.endsWith(".mjs") ? "js" : "ts");
---

<details class="guard-answer" data-guard-answer>
  <summary>解答の例を見る</summary>
  <div class="guard-answer__panel">
    <div class="guard-answer__bar">
      <strong>解答の例</strong>
      <button type="button" data-guard-answer-close>閉じる</button>
    </div>
    <slot />
    {
      entries.length === 0 ? (
        <p>解答の例はまだありません。</p>
      ) : (
        entries.map(([path, source]) => (
          <figure>
            <figcaption>{path}</figcaption>
            <Code code={source} lang={languageOf(path)} />
          </figure>
        ))
      )
    }
  </div>
</details>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const close = target.closest("[data-guard-answer-close]");
    const details = close?.closest("details");
    if (details === null || details === undefined) return;
    details.open = false;
    details.querySelector<HTMLElement>(":scope > summary")?.focus();
  });
</script>
