---
import { Code } from "astro:components";
import appointmentSource from "../../../../examples/final/src/domain/appointment/appointment.ts?raw";
import cancellationReasonSource from "../../../../examples/final/src/domain/appointment/cancellationReason.ts?raw";
import authorizationSource from "../../../../examples/final/src/useCase/authorization.ts?raw";
import useCaseSource from "../../../../examples/final/src/useCase/cancelAppointmentUseCase.ts?raw";
import errorsSource from "../../../../examples/final/src/useCase/errors.ts?raw";
import { quote } from "../sessions/reference-quote";
import StepControls from "./stepper/StepControls.astro";
import "./states/states.css";

type Props = Readonly<{ scenes: "success" | "failures" }>;
const { scenes } = Astro.props;

type Row = Readonly<{
  group?: string;
  call: string;
  file: string;
  code?: string;
  io?: string;
  ok: readonly number[];
  err?: readonly number[];
}>;

const rows: readonly Row[] = [
  { call: "CancelSchema", file: "cancellationReason.ts", code: quote(cancellationReasonSource, 7, 13, "const CancellationReasonSchema"), ok: [3], err: [3] },
  { group: "実行者の確認", call: "resolveById", file: "userResolver.ts", io: "データベースから実行者を読みます。実装は省略します。", ok: [] },
  { call: "ensureUserFound", file: "errors.ts", code: quote(errorsSource, 25, 31, "ensureUserFound"), ok: [4, 6] },
  { call: "ensureCanManageClinic", file: "authorization.ts", code: quote(authorizationSource, 7, 12, "ensureCanManageClinic"), ok: [3, 4] },
  { group: "予約の確認", call: "resolveById", file: "appointmentResolver.ts", io: "データベースから予約を読みます。実装は省略します。", ok: [] },
  { call: "ensureAppointmentFound", file: "errors.ts", code: quote(errorsSource, 33, 39, "ensureAppointmentFound"), ok: [4, 6] },
  { call: "ensureCancellable", file: "cancelAppointmentUseCase.ts", code: quote(useCaseSource, 64, 71, "appointment.kind"), ok: [0, 1], err: [0, 2, 3, 4, 5, 6, 7] },
  { group: "結果を作る", call: "createEvent", file: "appointment.ts", code: quote(appointmentSource, 216, 225, "const aggregateState"), ok: [1, 6, 7, 8] },
  { group: "記録して返す", call: "andThrough(store)", file: "appointmentEventStore.ts", io: "予約の状態の更新と、イベントの追記を、1回の保存で行います。実装は省略します。", ok: [] },
  { call: "map", file: "cancelAppointmentUseCase.ts", code: quote(useCaseSource, 98, 98, ".map((event)"), ok: [0] },
  { call: "UseCaseOutput", file: "cancelAppointmentUseCase.ts", code: quote(useCaseSource, 49, 49, "export type UseCaseOutput"), ok: [0] },
];

const endRow = rows.length - 1;

const chainRow: Row = {
  call: "run",
  file: "cancelAppointmentUseCase.ts",
  code: quote(useCaseSource, 87, 98, "dependencies.userResolver"),
  ok: [],
};

type Step = Readonly<{
  overview?: true;
  row: number;
  failed: boolean;
  skipped: boolean;
  text: string;
  input: string;
  output: string;
}>;

const step = (row: number, text: string, input: string, output: string): Step => ({ row, failed: false, skipped: false, text, input, output });
const failAt = (row: number, text: string, input: string, output: string): Step => ({ ...step(row, text, input, output), failed: true });
const carry = (row: number, text: string, failure: string): Step => ({ ...step(row, text, failure, failure), failed: true, skipped: row !== endRow });

const user = `{ kind: "Receptionist", … }`;
const appointment = (kind: string) => `{ kind: "${kind}", … }`;
const event = `{ kind: "AppointmentCanceled" }`;
const canceled = `{ appointment: { kind: "Canceled" } }`;
const ok = (value: string) => `Ok(${value})`;
const invalid = `Err({ kind: "InvalidAppointmentState" })`;

const overview: Step = {
  overview: true,
  row: -1,
  failed: false,
  skipped: false,
  text: "ユースケース全体は、<code>andThen</code> をつないだ1本の連鎖です。実行者の確認、予約の確認、結果を作る、記録して返す、の順に進みます。次のコマから、値の流れを1行ずつ追います。",
  input: "",
  output: "",
};

const untilAppointment = (kind: string): readonly Step[] => [
  step(0, "ユースケースの手前の境界が、依頼を検査します。ここはレールの外です。理由は空ではないので、<code>.min(1)</code> を通ります。", `{ reason: "owner request" }`, `{ …, reason: "owner request" }`),
  step(1, "<code>resolveById</code> が、データベースから実行者を取得します。", `"（受付担当者の ID）"`, ok(user)),
  step(2, "<code>ensureUserFound</code> は、実行者を取得できたので <code>ok</code> を返します。", user, ok(user)),
  step(3, "<code>ensureCanManageClinic</code> が、権限を確かめます。<code>Receptionist</code> には権限があります。", user, ok(user)),
  step(4, "<code>resolveById</code> が、予約を取得します。値は実行者から予約へ変わります。", `"11111111-…"`, ok(appointment(kind))),
  step(5, "<code>ensureAppointmentFound</code> は、予約を取得できたので <code>ok</code> を返します。", appointment(kind), ok(appointment(kind))),
];

const allScenarios: readonly (Readonly<{ label: string; steps: readonly Step[] }>)[] = [
  {
    label: "成功",
    steps: [
      overview,
      ...untilAppointment("Scheduled"),
      step(6, "<code>ensureCancellable</code> が、状態を確かめます。<code>Scheduled</code> は診察開始前なので、<code>ok</code> を返します。", appointment("Scheduled"), ok(appointment("Scheduled"))),
      step(7, "<code>createEvent</code> が <code>Appointment.cancel</code> を呼び、入力の <code>reason</code> と <code>clock</code> の時刻から、<code>AppointmentCanceled</code> を作ります。", `予約、"owner request"、時刻`, ok(event)),
      step(8, "<code>andThrough</code> は、Ok のときだけ store を呼び、値をそのまま次へ渡します。予約の更新とイベントの追記を、1回の保存で行います。", event, ok(event)),
      step(9, "<code>map</code> が、イベントからキャンセル後の予約を取り出します。", event, ok(canceled)),
      step(endRow, "値は成功レールの終点に届きます。呼び出し側は、Ok に包まれたキャンセル後の予約を受け取ります。", canceled, ok(canceled)),
    ],
  },
  {
    label: "理由が空",
    steps: [
      failAt(0, "ユースケースの手前の境界が、依頼を検査します。理由が空なので、<code>.min(1)</code> で失敗します。", `{ reason: "" }`, `// 検査に失敗`),
      failAt(0, "検査に失敗した依頼は、ユースケースに入りません。境界が入力エラーの画面を返し、レールの上の行は1行も実行しません。", `// 検査に失敗`, `// 入力エラーの画面を返す`),
    ],
  },
  {
    label: "Paid の予約",
    steps: [
      ...untilAppointment("Paid"),
      failAt(6, "<code>ensureCancellable</code> が、状態を確かめます。<code>Paid</code> は診察開始前ではないので <code>err</code> を返し、値は失敗レールへ切り替わります。", appointment("Paid"), invalid),
      carry(7, "失敗の値は、失敗レールを進みます。<code>createEvent</code> は実行しないので、<code>Canceled</code> は作られません。", invalid),
      carry(8, "記録も実行しません。キャンセルは記録に残りません。", invalid),
      carry(9, "結果の取り出しも実行しません。失敗の値は変わりません。", invalid),
      carry(endRow, "失敗の値は、失敗レールの終点に届きます。呼び出し側は、<code>InvalidAppointmentState</code> を受け取ります。", invalid),
    ],
  },
];

const scenarios = scenes === "success" ? allScenarios.slice(0, 1) : allScenarios.slice(1);

type RowState = "todo" | "current" | "done" | "skipped";
const stateOf = (rowIndex: number, current: Step): RowState => {
  if (rowIndex === current.row) return current.skipped ? "skipped" : "current";
  if (rowIndex < current.row) return "done";
  return current.failed ? "skipped" : "todo";
};
const boundaryFailed = (current: Step): boolean => current.row === 0 && current.failed;
const rowState = (rowIndex: number, current: Step): RowState =>
  rowIndex > 0 && boundaryFailed(current) ? "skipped" : stateOf(rowIndex, current);
const markOf: Readonly<Record<RowState, string>> = { todo: "", current: "▶", done: "✓", skipped: "–" };

const rowHeightRem = 1.25;
---

<figure class="st-fig cf" data-cancel-flow data-step-figure aria-label="キャンセルのコードを実行すると、値がレールをどう進むか">
  <div class="cf__bar">
    {scenarios.length > 1 && (
      <div class="cf__tabs" role="group" aria-label="場面を選ぶ">
        {scenarios.map((scenario) => <button type="button" data-step-scene aria-pressed="false">{scenario.label}</button>)}
      </div>
    )}
    <StepControls />
    <span class="cf__note">説明用に項目を省略しています。</span>
  </div>

  <ol class="st-stack">
    {scenarios.flatMap((scenario, sceneIndex) =>
      scenario.steps.map((current, stepIndex) => {
        const row = current.overview ? chainRow : rows[current.row]!;
        const previous = stepIndex > 0 ? scenario.steps[stepIndex - 1]! : undefined;
        const distance = previous !== undefined && previous.row > 0 && current.row > 0 ? current.row - previous.row : 0;
        const lit = (current.skipped ? [] : current.failed ? (row.err ?? row.ok) : row.ok);
        return (
          <li data-frame data-scene={sceneIndex} data-step={stepIndex} data-lit={JSON.stringify(lit)} data-tone={current.failed ? "negative" : "accent"}>
            <div class="cf__body">
              <div class="cf__left">
                <div class="cf__code" data-skipped={current.skipped ? "" : undefined}>
                  <p class="cf__file">実行する関数 <code>{row.file}</code>{current.skipped && "（実行しません）"}</p>
                  {row.code !== undefined ? (
                    <figure class="code-block st-code"><Code code={row.code} lang="ts" /></figure>
                  ) : (
                    <p class="cf__io">{row.io}</p>
                  )}
                </div>
                {!current.overview && (
                  <div class="cf__values">
                    <div class="cf__value">
                      <p>受け取る値</p>
                      <figure class="code-block st-code"><Code code={current.input} lang="ts" wrap /></figure>
                    </div>
                    <span class="cf__arrow" aria-hidden="true">→</span>
                    <div class="cf__value" data-bad={current.failed ? "" : undefined}>
                      <p>返す値</p>
                      <figure class="code-block st-code"><Code code={current.output} lang="ts" wrap /></figure>
                    </div>
                  </div>
                )}
              </div>

              <div class="cf__right">
                <p class="cf__boundary" data-state={rowState(0, current)} data-failed={boundaryFailed(current) ? "" : undefined}>
                  <span class="cf__mark" aria-hidden="true">{markOf[rowState(0, current)]}</span>
                  <span>手前の境界: 入力を検査する</span>
                  <small>レールには乗らない</small>
                </p>
                <div class="cf__legend"><span>成功</span><span>失敗</span></div>
                <ol class="cf__rows">
                  {rows.slice(1).map((item, offset) => {
                    const index = offset + 1;
                    const state = rowState(index, current);
                    return (
                      <li class="cf__row" data-state={state}>
                        <span class="cf__rail cf__rail--ok">
                          {state === "current" && !current.failed && (
                            <span class="cf__token" data-ok style={`--dy: ${distance * rowHeightRem}rem`}>Ok</span>
                          )}
                        </span>
                        <span class="cf__label">
                          <span class="cf__mark" aria-hidden="true">{markOf[state]}</span>
                          <span class="cf__group">{item.group ?? ""}</span>
                          <code>{item.call}</code>
                        </span>
                        <span class="cf__rail cf__rail--bad">
                          {(state === "current" || state === "skipped") && current.failed && index === current.row && (
                            <span class="cf__token" data-bad style={`--dy: ${distance * rowHeightRem}rem`}>Err</span>
                          )}
                        </span>
                      </li>
                    );
                  })}
                </ol>
              </div>
            </div>
            <p class="st-caption" set:html={current.text} />
          </li>
        );
      }),
    )}
  </ol>
</figure>

<script>
  type Mark = "accent" | "negative";

  document.querySelectorAll<HTMLElement>("[data-cancel-flow]").forEach((root) => {
    if (root.dataset.ready !== undefined) return;
    const frames = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-step-scene]")];
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const play = root.querySelector<HTMLButtonElement>("[data-play]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    if (!controls || !prev || !play || !next || !progress) return;

    frames.forEach((frame) => {
      const lit = JSON.parse(frame.dataset.lit ?? "[]") as number[];
      const tone = (frame.dataset.tone ?? "accent") as Mark;
      frame.querySelectorAll<HTMLElement>(".cf__code .line").forEach((line, index) => {
        line.classList.toggle(tone === "negative" ? "is-lit-negative" : "is-lit", lit.includes(index));
      });
    });

    const inScene = (scene: number) => frames.filter((frame) => Number(frame.dataset.scene) === scene);
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let scene = 0;
    let index = 0;
    let timer: number | undefined;

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
      play.textContent = "▶ 再生";
    };

    const show = () => {
      const list = inScene(scene);
      frames.forEach((frame) => {
        const active = frame === list[index];
        frame.hidden = !active;
        frame.toggleAttribute("data-active", active);
      });
      tabs.forEach((tab, tabIndex) => tab.setAttribute("aria-pressed", String(tabIndex === scene)));
      progress.textContent = `${index + 1} / ${list.length}`;
      prev.disabled = index === 0;
      next.disabled = index === list.length - 1;
    };

    play.addEventListener("click", () => {
      if (timer !== undefined) {
        stop();
        return;
      }
      const last = inScene(scene).length - 1;
      if (index === last) {
        index = 0;
        show();
      }
      play.textContent = "❚❚ 一時停止";
      timer = window.setInterval(() => {
        index = Math.min(index + 1, last);
        show();
        if (index === last) stop();
      }, 6000);
    });
    prev.addEventListener("click", () => {
      stop();
      index = Math.max(index - 1, 0);
      show();
    });
    next.addEventListener("click", () => {
      stop();
      index = Math.min(index + 1, inScene(scene).length - 1);
      show();
    });
    tabs.forEach((tab, tabIndex) =>
      tab.addEventListener("click", () => {
        stop();
        scene = tabIndex;
        index = 0;
        show();
      }),
    );
    const applyMotion = () => {
      play.hidden = reducedMotion.matches;
      if (reducedMotion.matches) stop();
    };
    reducedMotion.addEventListener("change", applyMotion);
    applyMotion();

    root.dataset.ready = "";
    controls.hidden = false;
    show();
  });
</script>

<style>
  .cf__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin-block-end: 0.375rem;
  }

  .cf__bar :global(.step-controls) {
    margin-block-end: 0;
  }

  .cf__tabs {
    display: flex;
    gap: 0.375rem;
  }

  .cf__tabs button {
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .cf__tabs button[aria-pressed="true"] {
    border-color: var(--role-accent);
    background: color-mix(in srgb, var(--role-accent) 16%, var(--role-surface));
    box-shadow: inset 0 -3px 0 var(--role-accent);
  }

  .cf__tabs button:focus-visible {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  .cf {
    --lit-accent: color-mix(in srgb, var(--role-accent) 55%, var(--frame-code-text, #ffffff));
    --lit-negative: color-mix(in srgb, var(--role-negative) 55%, var(--frame-code-text, #ffffff));
  }

  .cf__code :global(.line.is-lit) {
    box-shadow: inset 4px 0 0 var(--lit-accent);
  }

  .cf__code :global(.line.is-lit-negative) {
    box-shadow: inset 4px 0 0 var(--lit-negative);
  }

  .cf__note {
    margin-inline-start: auto;
    color: var(--role-muted);
    font-size: 0.8125rem;
  }

  .cf__body {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  .cf__left {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }

  .cf__file,
  .cf__value p {
    margin: 0 0 0.125rem;
    color: var(--role-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .cf__file code {
    margin-inline-start: 0.25rem;
    color: var(--role-text);
    font-size: 0.8125rem;
  }

  .cf__code[data-skipped] .st-code,
  .cf__code[data-skipped] .cf__io {
    opacity: 0.45;
  }

  .cf__body :global(.st-code pre) {
    padding-block: 0.25rem;
    line-height: 1.3;
  }

  .cf__code :global(.st-code pre) {
    min-height: 10rem;
  }

  .cf__io {
    min-height: 10rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.375rem;
    background: var(--role-surface);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .cf__values {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 0.375rem;
    align-items: end;
  }

  .cf__arrow {
    align-self: center;
    color: var(--role-accent);
    font-weight: 800;
  }

  .cf__value {
    min-width: 0;
  }

  .cf__value[data-bad] p {
    color: var(--role-negative);
  }

  .cf__value[data-bad] :global(.st-code) {
    outline: 2px dashed var(--role-negative);
  }

  .cf__value :global(.st-code pre) {
    min-height: 2.75rem;
  }

  .cf__value :global(.st-code .line) {
    padding-inline: 0.5rem;
  }

  .cf__right {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .cf__boundary {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    align-items: baseline;
    margin: 0;
    padding: 0.125rem 0.5rem;
    border: 2px dashed var(--role-border);
    border-radius: 0.375rem;
    background: var(--role-surface);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .cf__boundary small {
    color: var(--role-muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .cf__boundary[data-state="current"] {
    border-color: var(--role-accent);
    background: color-mix(in srgb, var(--role-accent) 14%, var(--role-surface));
  }

  .cf__boundary[data-failed] {
    border-color: var(--role-negative);
    background: color-mix(in srgb, var(--role-negative) 12%, var(--role-surface));
  }

  .cf__legend {
    display: flex;
    justify-content: space-between;
    padding-inline: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .cf__legend span:first-child {
    color: var(--role-positive);
  }

  .cf__legend span:last-child {
    color: var(--role-negative);
  }

  .cf__rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cf__row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 2.25rem;
    align-items: center;
    height: 1.25rem;
    font-size: 0.8125rem;
  }

  .cf__rail {
    position: relative;
    display: grid;
    height: 100%;
    place-items: center;
  }

  .cf__rail::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline: calc(50% - 2px);
    background: var(--role-positive);
  }

  .cf__rail--bad::before {
    background: var(--role-negative);
  }

  .cf__label {
    display: grid;
    grid-template-columns: 1rem 5.75rem minmax(0, 1fr);
    gap: 0 0.25rem;
    align-items: center;
    height: 100%;
    min-width: 0;
    padding-inline: 0.25rem;
    border-block: 1px solid color-mix(in srgb, var(--role-border) 30%, var(--role-surface));
    background: var(--role-surface);
    color: var(--role-text);
    line-height: 1.2;
  }

  .cf__label code {
    overflow: hidden;
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cf__group {
    font-size: 0.8125rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .cf__mark {
    font-weight: 800;
    text-align: center;
  }

  .cf__row[data-state="current"] .cf__label {
    border: 2px solid var(--role-accent);
    background: color-mix(in srgb, var(--role-accent) 14%, var(--role-surface));
    font-weight: 800;
  }

  .cf__row[data-state="done"] .cf__label {
    color: var(--role-muted);
  }

  .cf__row[data-state="skipped"] .cf__label,
  .cf__row[data-state="todo"] .cf__label {
    color: var(--role-muted);
  }

  .cf__row[data-state="skipped"] .cf__label code {
    text-decoration: line-through;
  }

  .cf__token {
    position: relative;
    z-index: 1;
    padding: 0 0.375rem;
    border-radius: 999px;
    color: var(--role-surface);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.25rem;
  }

  .cf__token[data-ok] {
