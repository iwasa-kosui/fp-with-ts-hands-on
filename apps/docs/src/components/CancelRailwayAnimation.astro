---
import { Code } from "astro:components";
import routesSource from "../../../../examples/final/src/adaptor/primary/web/routes/appointmentRoutes.ts?raw";
import appointmentResolverSource from "../../../../examples/final/src/adaptor/secondary/sqlite/resolver/appointmentResolver.ts?raw";
import userResolverSource from "../../../../examples/final/src/adaptor/secondary/sqlite/resolver/userResolver.ts?raw";
import storeSource from "../../../../examples/final/src/adaptor/secondary/sqlite/store/appointmentEventStore.ts?raw";
import appointmentSource from "../../../../examples/final/src/domain/appointment/appointment.ts?raw";
import cancellationReasonSource from "../../../../examples/final/src/domain/appointment/cancellationReason.ts?raw";
import authorizationSource from "../../../../examples/final/src/useCase/authorization.ts?raw";
import useCaseSource from "../../../../examples/final/src/useCase/cancelAppointmentUseCase.ts?raw";
import errorsSource from "../../../../examples/final/src/useCase/errors.ts?raw";
import { quote } from "../sessions/reference-quote";
import StepPlayer from "./step-player/StepPlayer.astro";

const pipeline = [
  "// appointmentRoutes.ts",
  quote(routesSource, 74, 76, "const CancelSchema"),
  "",
  "// cancelAppointmentUseCase.ts",
  quote(useCaseSource, 87, 98, "dependencies.userResolver"),
  "",
  "// Output",
  quote(useCaseSource, 49, 49, "export type UseCaseOutput"),
].join("\n");

type Row = Readonly<{
  stage: string;
  lines: readonly number[];
  file: string;
  code: string;
  ok: readonly number[];
  err?: readonly number[];
}>;

const rows: readonly Row[] = [
  { stage: "入力を検査する", lines: [2], file: "cancellationReason.ts", code: quote(cancellationReasonSource, 7, 13, "const CancellationReasonSchema"), ok: [3], err: [3] },
  { stage: "対象を取得する", lines: [6, 7], file: "userResolver.ts", code: quote(userResolverSource, 54, 60, "resolveById"), ok: [3, 4] },
  { stage: "対象を取得する", lines: [8], file: "errors.ts", code: quote(errorsSource, 25, 31, "ensureUserFound"), ok: [4, 6] },
  { stage: "権限と状態を確認する", lines: [9], file: "authorization.ts", code: quote(authorizationSource, 7, 12, "ensureCanManageClinic"), ok: [3, 4] },
  { stage: "対象を取得する", lines: [10, 11, 12], file: "appointmentResolver.ts", code: quote(appointmentResolverSource, 111, 121, "resolveById"), ok: [3, 4, 5, 6, 7, 8] },
  { stage: "対象を取得する", lines: [13], file: "errors.ts", code: quote(errorsSource, 33, 39, "ensureAppointmentFound"), ok: [4, 6] },
  { stage: "権限と状態を確認する", lines: [14], file: "cancelAppointmentUseCase.ts", code: quote(useCaseSource, 61, 71, "ensureCancellable"), ok: [3, 4], err: [3, 5, 6, 7, 8, 9, 10] },
  { stage: "結果を作る", lines: [15], file: "appointment.ts", code: quote(appointmentSource, 210, 235, "const cancel"), ok: [7, 12, 13, 14, 17, 21] },
  {
    stage: "Event Store へ記録する",
    lines: [16],
    file: "appointmentEventStore.ts",
    code: [quote(storeSource, 189, 199, `case "AppointmentCanceled"`), "// …", quote(storeSource, 210, 216, "tx.insert(domainEventsTable)")].join("\n"),
    ok: [1, 2, 12, 13],
  },
  { stage: "Output を作る", lines: [17], file: "cancelAppointmentUseCase.ts", code: quote(useCaseSource, 98, 98, ".map((event)"), ok: [0] },
  { stage: "Output", lines: [20], file: "cancelAppointmentUseCase.ts", code: quote(useCaseSource, 49, 49, "export type UseCaseOutput"), ok: [0] },
];

const outputRow = rows.length - 1;
const appointmentId = `"11111111-…"`;
const requestWith = (reason: string) =>
  `{\n  actorUserId: "（受付担当者の ID）",\n  appointmentId: ${appointmentId},\n  reason: ${reason},\n}`;
const request = requestWith(`"owner request"`);
const userValue = `{ kind: "Receptionist", userId: "（受付担当者の ID）" }`;
const appointmentValue = (kind: string) =>
  `{\n  kind: "${kind}",\n  appointmentId: ${appointmentId},\n  reason: "skin check",\n}`;
const canceledValue = `{\n  kind: "Canceled",\n  appointmentId: ${appointmentId},\n  reason: "skin check",\n  cancellationReason: "owner request",\n  canceledAt: "2026-08-30T05:00:00.000Z",\n}`;
const indented = (value: string) => value.replaceAll("\n", "\n  ");
const ok = (value: string) => `Ok(${value})`;
const eventValue = `{\n  kind: "AppointmentCanceled",\n  aggregateState: ${indented(canceledValue)},\n}`;
const finalValue = ok(`{\n  appointment: ${indented(canceledValue)},\n}`);
const createEventInput = `// 前の行の値\n${appointmentValue("Scheduled")}\n// 最初に受け取った入力の input.reason（キャンセル理由）\n"owner request"\n// clock.now() の時刻\n"2026-08-30T05:00:00.000Z"`;
const emptyReason = `Err("reason が空である")`;
const invalidState = `Err({\n  kind: "InvalidAppointmentState",\n  appointmentId: ${appointmentId},\n  expectedKind: "ScheduledOrCheckedIn",\n  actualKind: "Paid",\n})`;

type Step = Readonly<{
  text: string;
  row: number;
  failed: boolean;
  skipped: boolean;
  input: string;
  output: string;
}>;

const step = (row: number, text: string, input: string, output: string): Step => ({ text, row, failed: false, skipped: false, input, output });
const failAt = (row: number, text: string, input: string, output: string): Step => ({ ...step(row, text, input, output), failed: true });
const carry = (row: number, text: string, failure: string): Step => ({ ...step(row, text, failure, failure), failed: true, skipped: row !== outputRow });

const untilAppointment = (kind: string): readonly Step[] => [
  step(0, "Web の入口が依頼を検査します。キャンセル理由は空ではないので、<code>.min(1)</code> を通ります。", request, ok(request)),
  step(1, "<code>resolveById</code> がデータベースから実行者を取得します。", request, ok(userValue)),
  step(2, "<code>ensureUserFound</code> は、実行者を取得できたので <code>ok(user)</code> を返します。", userValue, ok(userValue)),
  step(3, "<code>ensureCanManageClinic</code> が権限を確かめます。<code>Receptionist</code> には権限があります。", userValue, ok(userValue)),
  step(4, "<code>resolveById</code> が予約を取得します。ここで値は実行者から予約へ変わります。", userValue, ok(appointmentValue(kind))),
  step(5, "<code>ensureAppointmentFound</code> は、予約を取得できたので <code>ok(appointment)</code> を返します。", appointmentValue(kind), ok(appointmentValue(kind))),
];

const scenarios: readonly (Readonly<{ label: string; steps: readonly Step[] }>)[] = [
  {
    label: "成功",
    steps: [
      ...untilAppointment("Scheduled"),
      step(6, "<code>ensureCancellable</code> が状態を確かめます。<code>Scheduled</code> は診察開始前なので、<code>ok(appointment)</code> を返します。", appointmentValue("Scheduled"), ok(appointmentValue("Scheduled"))),
      step(7, "キャンセルの出来事を表すイベントを作る <code>createEvent</code> が、<code>Appointment.cancel</code> を呼びます。前の行の予約に加えて、最初に受け取った入力の <code>reason</code>（キャンセル理由）と、現在時刻を返す部品 <code>clock</code> の時刻を使い、<code>AppointmentCanceled</code> を作ります。予約の来院理由は <code>reason</code> に残り、キャンセル理由は <code>cancellationReason</code> に入ります。", createEventInput, ok(eventValue)),
      step(8, "<code>andThrough</code> は、<code>andThen</code> と同じように Ok のときだけ処理へ進み、成功すると元の値を次へ渡します。ここでは store を呼び、予約の更新とイベントの追記を1つの transaction で行います。値は同じイベントのままです。<code>andThrough</code> の詳細は S06 で学びます。", eventValue, ok(eventValue)),
      step(9, "<code>map</code> がイベントからキャンセル後の予約を取り出します。", eventValue, finalValue),
      step(outputRow, "値は成功レールの終点に届きます。呼び出し側はキャンセル後の予約を受け取ります。", finalValue, finalValue),
    ],
  },
  {
    label: "理由が空",
    steps: [
      failAt(0, "Web の入口が依頼を検査します。キャンセル理由が空なので、<code>.min(1)</code> で失敗します。", requestWith(`""`), emptyReason),
      failAt(0, "参照実装の入口は、検査に失敗するとユースケースを呼ばずに入力エラーの画面を返します。パイプラインの後ろの行は1行も実行しません。", emptyReason, "// run を呼ばず、入力エラーの画面を返す"),
    ],
  },
  {
    label: "Paid の予約",
    steps: [
      ...untilAppointment("Paid"),
      failAt(6, "<code>ensureCancellable</code> が状態を確かめます。<code>Paid</code> は診察開始前ではないので、<code>err</code> を返します。値は失敗レールへ切り替わります。", appointmentValue("Paid"), invalidState),
      carry(7, "失敗の値は失敗レールを進みます。<code>createEvent</code> は実行しないので、<code>Canceled</code> は作られません。", invalidState),
      carry(8, "Event Store への記録も実行しません。記録は残りません。", invalidState),
      carry(9, "結果の取り出しも実行しません。失敗の値は変わりません。", invalidState),
      carry(outputRow, "失敗の値は失敗レールの終点に届きます。呼び出し側は <code>InvalidAppointmentState</code> を受け取ります。", invalidState),
    ],
  },
];

const escapeHtml = (text: string): string => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;");
const stepHtml = ({ text, row, input, output }: Step): string =>
  `${text}<div data-step-extra><p>実行する関数（${rows[row]?.file ?? ""}）</p><pre>${escapeHtml(rows[row]?.code ?? "")}</pre><p>受け取る値</p><pre>${escapeHtml(input)}</pre><p>返す値</p><pre>${escapeHtml(output)}</pre></div>`;
const playerScenarios = scenarios.map(({ label, steps }) => ({ label, steps: steps.map(stepHtml) }));

const values = [...new Set(scenarios.flatMap(({ steps }) => steps.flatMap(({ input, output }) => [input, output])))];
const sceneData = JSON.stringify({
  rows: rows.map(({ stage, lines, file, ok, err }) => ({ stage, lines, file, ok, err })),
  scenarios: scenarios.map(({ steps }) =>
    steps.map(({ row, failed, skipped, input, output }) => ({
      row,
      failed,
      skipped,
      input: values.indexOf(input),
      output: values.indexOf(output),
    })),
  ),
});
const id = "cancel-railway-animation";
---

<StepPlayer
  id={id}
  title="キャンセルのコードを実行すると、値はどう流れるか"
  lead="再生すると、値がパイプラインの行に沿って上から下へ進みます。下の枠では、その行が受け取る値、実行する関数の実装、返す値を順に確かめます。ユースケースの中で失敗しても、処理は途中で抜けません。失敗の値は右の失敗レールを終点まで進みます。コードは完成形の参照実装（examples/final）から引用しています。"
  note="コードは完成形の参照実装 examples/final/src から引用しました。andThen の意味は S04 で学んだとおりです。andThen は Ok の中身を次の関数へ渡すので、受け取る値には Ok を付けていません。受付担当者の ID、Paid の予約、Err の理由の文は説明用です。値は読みやすさのため、UUID を「11111111-…」と省略し、petId、ownerId、scheduledAt などの項目と、reason を包む Sensitive も省略しています。"
  scenarios={playerScenarios}
>
  <div class="cancel-flow" data-cancel-flow={sceneData}>
    <div class="cancel-flow__pipeline" data-pipeline>
      <div class="cancel-flow__legend"><span>成功レール</span><span>失敗レール</span></div>
      <div class="cancel-flow__rails" data-rails>
        <span class="cancel-flow__token" data-token>Ok</span>
        <Code code={pipeline} lang="ts" wrap />
      </div>
    </div>
    <div class="cancel-flow__box" data-input-box><p>受け取る値</p><div data-input></div></div>
    <div class="cancel-flow__arrow" aria-hidden="true">↓</div>
    <div class="cancel-flow__box" data-impl-box><p><span data-stage></span> <small data-file></small></p><div data-impl></div></div>
    <div class="cancel-flow__arrow" aria-hidden="true">↓</div>
    <div class="cancel-flow__box" data-output-box><p>返す値</p><div data-output></div></div>
    <div hidden data-sources>
      {rows.map((row) => <div data-impl-source><Code code={row.code} lang="ts" wrap /></div>)}
      {values.map((value) => <div data-value-source><Code code={value} lang="ts" wrap /></div>)}
    </div>
  </div>
</StepPlayer>

<style is:inline>
  .cancel-flow { --ok: #4ade80; --bad: #ff8f7d; --bad-ink: #b42318; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.375rem; min-width: 0; }
  .cancel-flow pre { margin: 0; padding: 0.5rem 0.625rem; border-radius: 0.25rem; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.75rem; line-height: 1.5; }
  .cancel-flow pre code { display: flex; flex-direction: column; background: none; padding: 0; color: inherit; font-size: inherit; }
  .cancel-flow .line { display: block; min-width: 0; min-height: 1.5em; white-space: pre-wrap; overflow-wrap: anywhere; margin: 0 -0.625rem; padding: 0 0.625rem; border-left: 3px solid transparent; transition: background-color 200ms ease, opacity 200ms ease; }
  .cancel-flow__legend { display: flex; justify-content: space-between; padding: 0 0.125rem 0.25rem; font-size: 0.75rem; font-weight: 700; }
  .cancel-flow__legend span:first-child { color: #137333; }
  .cancel-flow__legend span:last-child { color: var(--bad-ink); }
  .cancel-flow__rails { position: relative; padding: 0 1.875rem; border-radius: 0.375rem; background: #24292e; }
  .cancel-flow__rails::before, .cancel-flow__rails::after { content: ""; position: absolute; top: 0; bottom: 0; width: 4px; }
  .cancel-flow__rails::before { left: 0.8125rem; background: var(--ok); }
  .cancel-flow__rails::after { right: 0.8125rem; background: var(--bad); }
  .cancel-flow__rails .line[data-state="done"] { opacity: 0.6; }
  .cancel-flow__rails .line[data-state="skipped"] { opacity: 0.35; }
  .cancel-flow .line[data-hi] { background: rgb(255 210 27 / 0.24); border-left-color: #ffd21b; }
  .cancel-flow .line[data-hi="bad"] { background: rgb(255 120 100 / 0.3); border-left-color: var(--bad); }
  .cancel-flow__token { position: absolute; z-index: 2; top: 0; left: 0; padding: 0 0.3125rem; border-radius: 999px; background: var(--ok); color: #111116; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.6875rem; font-weight: 800; line-height: 1.5; transition: transform 550ms cubic-bezier(0.3, 0.8, 0.3, 1), background-color 250ms ease; }
  .cancel-flow__token[data-rail="bad"] { background: var(--bad); }
  .cancel-flow__box { min-width: 0; margin-top: 0.25rem; }
  .cancel-flow__box p { margin: 0 0 0.25rem; color: var(--case-muted, #58596d); font-size: 0.8125rem; font-weight: 700; }
  .cancel-flow__box small { font-weight: 400; font-size: 0.75rem; }
  .cancel-flow__box[data-bad] p { color: var(--bad-ink); }
  .cancel-flow__box[data-bad] pre { outline: 2px solid var(--bad); }
  .cancel-flow__box[data-skipped] pre { opacity: 0.45; }
  .cancel-flow__arrow { color: var(--case-muted, #58596d); font-weight: 800; line-height: 1; text-align: center; }
  .cancel-flow[data-run] [data-input-box] { animation: cancel-flow-arrive 350ms ease both; }
  .cancel-flow[data-run] [data-impl-box] { animation: cancel-flow-arrive 350ms ease 300ms both; }
  .cancel-flow[data-run] [data-output-box] { animation: cancel-flow-arrive 400ms ease 650ms both; }
  @keyframes cancel-flow-arrive { from { opacity: 0; transform: translateY(-0.625rem); } to { opacity: 1; transform: none; } }
</style>
<script is:inline define:vars={{ id }}>
  const root = document.getElementById(id);
  const scene = root.querySelector("[data-cancel-flow]");
  const data = JSON.parse(scene.dataset.cancelFlow);
  const rails = scene.querySelector("[data-rails]");
  const token = scene.querySelector("[data-token]");
  const pipelineLines = [...rails.querySelectorAll(".line")];
  const implSources = [...scene.querySelectorAll("[data-impl-source]")];
  const valueSources = [...scene.querySelectorAll("[data-value-source]")];
  const part = (name) => scene.querySelector(`[data-${name}]`);
  const show = (target, source) => target.replaceChildren(source.firstElementChild.cloneNode(true));
  let current;

  const pipelineState = (rowIndex, step) => {
    if (rowIndex > step.row) return "";
    if (rowIndex < step.row) return step.failed ? "skipped" : "done";
    return step.skipped ? "skipped" : "current";
  };

  const place = () => {
    if (!current) return;
    const line = pipelineLines[data.rows[current.row].lines[0]];
    const railsRect = rails.getBoundingClientRect();
    const lineRect = line.getBoundingClientRect();
    const x = current.failed ? railsRect.width - token.offsetWidth - 2 : 2;
    const y = lineRect.top - railsRect.top + lineRect.height / 2 - token.offsetHeight / 2;
    token.style.transform = `translate(${x}px, ${y}px)`;
  };

  root.addEventListener("stepchange", ({ detail }) => {
    current = data.scenarios[detail.scenarioIndex][detail.stepIndex];
    const row = data.rows[current.row];
    pipelineLines.forEach((line) => {
      line.removeAttribute("data-hi");
      line.removeAttribute("data-state");
    });
    data.rows.forEach((item, rowIndex) => {
      const state = pipelineState(rowIndex, current);
      item.lines.forEach((lineIndex) => {
        const line = pipelineLines[lineIndex];
        if (state === "current") line.dataset.hi = current.failed ? "bad" : "ok";
        else if (state) line.dataset.state = state;
      });
    });
    show(part("input"), valueSources[current.input]);
    show(part("output"), valueSources[current.output]);
    show(part("impl"), implSources[current.row]);
    part("stage").textContent = current.skipped ? `${row.stage}（実行しません）` : row.stage;
    part("file").textContent = row.file;
    part("impl-box").toggleAttribute("data-skipped", current.skipped);
    part("output-box").toggleAttribute("data-bad", current.failed);
    if (!current.skipped) {
      const implLines = [...part("impl").querySelectorAll(".line")];
      const highlighted = current.failed ? row.err ?? row.ok : row.ok;
      highlighted.forEach((lineIndex) => {
        implLines[lineIndex].dataset.hi = current.failed ? "bad" : "ok";
      });
    }
    token.textContent = current.failed ? "Err" : "Ok";
    token.dataset.rail = current.failed ? "bad" : "ok";
    scene.removeAttribute("data-run");
    void scene.offsetWidth;
    scene.setAttribute("data-run", "");
    place();
  });
  new ResizeObserver(place).observe(rails);
</script>
