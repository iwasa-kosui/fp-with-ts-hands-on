---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import routesSource from "../../../../examples/session-05/src/web/routes.ts?raw";
import testSource from "../../../../examples/session-05/exercises/result-errors.test.ts?raw";
import useCaseSource from "../../../../examples/session-05/src/useCase/startExamination.ts?raw";

const quote = (source: string, from: number, to: number, firstLine: string, lastLine: string): string => {
  const lines = source.split("\n").slice(from - 1, to);
  if (!lines[0]?.includes(firstLine)) throw new Error(`引用元の先頭行がずれています: ${firstLine}`);
  if (!lines[lines.length - 1]?.includes(lastLine)) throw new Error(`引用元の末尾行がずれています: ${lastLine}`);
  const indent = Math.min(...lines.filter((line) => line.trim() !== "").map((line) => line.search(/\S/)));
  return lines.map((line) => line.slice(indent)).join("\n");
};

const snippets = {
  useCase: {
    path: "examples/session-05/src/useCase/startExamination.ts",
    code: quote(useCaseSource, 14, 30, "export const startExamination", "};"),
  },
  route: {
    path: "examples/session-05/src/web/routes.ts",
    code: quote(routesSource, 80, 86, "startExamination({", "});"),
  },
  test: {
    path: "examples/session-05/exercises/result-errors.test.ts",
    code: quote(testSource, 158, 170, "const createDependencies", "});"),
  },
} as const;

type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const KEY_MARK = /\s*\/\/ \[!deps-input-key\]$/;
const keyLineNumbers = (source: string, keyTexts: readonly string[]) =>
  keyTexts.map((text) => {
    const found = source.split("\n").flatMap((line, index) => (line.trim() === text ? [index + 1] : []));
    if (found.length !== 1) throw new Error(`強調する行が一意に見つかりません: ${text}`);
    return found[0];
  });
const withMarks = (source: string, keyLines: readonly number[]) =>
  source.split("\n").map((text, index) => (keyLines.includes(index + 1) ? `${text} // [!deps-input-key]` : text)).join("\n");
const markKeyLines: Transformer = {
  name: "mark-deps-input-key-lines",
  preprocess(source) {
    const lines = source.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((text, index) => (KEY_MARK.test(text) ? [index + 1] : []));
    return lines.map((text) => text.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "deps-input-flow__key");
  },
};

type Tone = "dim" | "normal" | "focus";
type Frame = Readonly<{
  caption: string;
  view: "function" | "compare";
  deps: Tone;
  input: Tone;
  body: Tone;
  sources: Tone;
  source: "none" | "db" | "test";
  wait: boolean;
  depsFilled: boolean;
  inputFilled: boolean;
  code?: Readonly<{ key: keyof typeof snippets; keys: readonly string[] }>;
}>;

const frames: readonly Frame[] = [
  {
    caption: "1段目は deps を受け取ります。deps は、予約を取得する resolver と、予約を保存する store をまとめた値です。",
    view: "function",
    deps: "focus",
    input: "dim",
    body: "dim",
    sources: "dim",
    source: "none",
    wait: false,
    depsFilled: false,
    inputFilled: false,
    code: { key: "useCase", keys: ["(deps: Dependencies) =>"] },
  },
  {
    caption: "deps を渡しても、まだ診察は始まりません。返ってくるのは input を待つ関数です。2段目は、予約ID、獣医師ID、開始時刻を受け取ります。",
    view: "function",
    deps: "normal",
    input: "focus",
    body: "dim",
    sources: "dim",
    source: "none",
    wait: true,
    depsFilled: true,
    inputFilled: false,
    code: { key: "useCase", keys: ["(input: StartExaminationInput): InExamination => {"] },
  },
  {
    caption: "input を受け取ると、本体が動きます。本体は、外部に触れる処理を deps.resolver と deps.store を通してだけ行います。本体の中に、データベースへの接続はありません。",
    view: "function",
    deps: "normal",
    input: "normal",
    body: "focus",
    sources: "dim",
    source: "none",
    wait: false,
    depsFilled: true,
    inputFilled: true,
    code: { key: "useCase", keys: ["deps.resolver.resolveById(input.appointmentId),", "deps.store.save(next);"] },
  },
  {
    caption: "Web ルートは、本物の保存先 store を resolver と store の両方として渡し、続けて依頼の値を渡します。",
    view: "function",
    deps: "focus",
    input: "normal",
    body: "normal",
    sources: "normal",
    source: "db",
    wait: false,
    depsFilled: true,
    inputFilled: true,
    code: { key: "route", keys: ["resolver: store,", "store,"] },
  },
  {
    caption: "テストは、決まった予約を返す resolver と、呼ばれた回数を数える store を渡します。本体は同じままで、データベースなしで動きます。",
    view: "function",
    deps: "focus",
    input: "normal",
    body: "normal",
    sources: "normal",
    source: "test",
    wait: false,
    depsFilled: true,
    inputFilled: true,
    code: { key: "test", keys: ["resolver: { resolveById: () => resolved },", "save: () => {"] },
  },
  {
    caption: "deps を使わない形と比べます。本体が保存先を自分で読み込むと、テストでも本物の保存先が動きます。deps で受け取ると、呼び出す側が保存先を選べます。",
    view: "compare",
    deps: "normal",
    input: "normal",
    body: "normal",
    sources: "normal",
    source: "none",
    wait: false,
    depsFilled: true,
    inputFilled: true,
  },
];

const overview = { deps: "normal", input: "normal", body: "normal", sources: "normal", source: "none", view: "function" } as const;

const playerData = JSON.stringify(frames.map(({ code: _code, ...frame }) => frame));
---

<figure
  class="deps-input-flow"
  aria-label="startExamination が deps と input を2段に分けて受け取る流れ"
  data-deps-input-flow
  data-frames={playerData}
  data-deps={overview.deps}
  data-input={overview.input}
  data-body={overview.body}
  data-sources={overview.sources}
  data-source={overview.source}
  data-view={overview.view}
>
  <div class="deps-input-flow__controls" data-controls hidden>
    <button type="button" data-prev disabled>前へ</button>
    <span data-progress>1 / {frames.length}</span>
    <button type="button" data-next>次へ</button>
  </div>

  <div class="deps-input-flow__diagram">
    <svg
      viewBox="0 0 340 232"
      role="img"
      aria-labelledby="deps-input-flow-title deps-input-flow-desc"
    >
      <title id="deps-input-flow-title">startExamination が deps と input を受け取る関数の図</title>
      <desc id="deps-input-flow-desc">
        関数 startExamination の上に、2つの受け口があります。1段目の deps には resolver と store が入り、2段目の input には予約ID、獣医師ID、開始時刻が入ります。枠の中の本体は、resolver と store への線でつながっています。
      </desc>

      <rect x="4" y="64" width="332" height="162" rx="10" class="deps-input-flow__frame"></rect>
      <text x="326" y="86" text-anchor="end" class="deps-input-flow__mono deps-input-flow__strong deps-input-flow__text">startExamination</text>
      <g class="deps-input-flow__wait">
        <rect x="208" y="94" width="118" height="22" rx="11"></rect>
        <text x="267" y="109" text-anchor="middle" class="deps-input-flow__text">input を待つ関数</text>
      </g>

      <g class="deps-input-flow__part deps-input-flow__part--body" data-part="body">
        <path d="M39 64 V150" class="deps-input-flow__line"></path>
        <path d="M97 64 V150" class="deps-input-flow__line"></path>
        <polygon points="39,56 34,65 44,65" class="deps-input-flow__head"></polygon>
        <polygon points="97,56 92,65 102,65" class="deps-input-flow__head"></polygon>
        <rect x="14" y="150" width="190" height="60" rx="8" class="deps-input-flow__body"></rect>
        <text x="109" y="186" text-anchor="middle" class="deps-input-flow__strong deps-input-flow__text deps-input-flow__body-text">本体</text>
      </g>

      <g class="deps-input-flow__part deps-input-flow__part--deps" data-part="deps">
        <rect x="4" y="4" width="128" height="60" rx="8" class="deps-input-flow__slot"></rect>
        <text x="12" y="19" class="deps-input-flow__strong deps-input-flow__text">1段目 deps</text>
        <g class="deps-input-flow__chip">
          <rect x="12" y="26" width="54" height="28" rx="6"></rect>
          <text x="39" y="44" text-anchor="middle" class="deps-input-flow__text">resolver</text>
        </g>
        <g class="deps-input-flow__chip">
          <rect x="70" y="26" width="54" height="28" rx="6"></rect>
          <text x="97" y="44" text-anchor="middle" class="deps-input-flow__text">store</text>
        </g>
        <g class="deps-input-flow__badge deps-input-flow__badge--deps">
          <circle cx="122" cy="12" r="8"></circle>
          <text x="122" y="16" text-anchor="middle">✓</text>
        </g>
      </g>

      <g class="deps-input-flow__part deps-input-flow__part--input" data-part="input">
        <rect x="140" y="4" width="196" height="60" rx="8" class="deps-input-flow__slot"></rect>
        <text x="148" y="19" class="deps-input-flow__strong deps-input-flow__text">2段目 input</text>
        <g class="deps-input-flow__chip">
          <rect x="148" y="26" width="56" height="28" rx="6"></rect>
          <text x="176" y="44" text-anchor="middle" class="deps-input-flow__text">予約ID</text>
        </g>
        <g class="deps-input-flow__chip">
          <rect x="208" y="26" width="56" height="28" rx="6"></rect>
          <text x="236" y="44" text-anchor="middle" class="deps-input-flow__text">獣医師ID</text>
        </g>
        <g class="deps-input-flow__chip">
          <rect x="268" y="26" width="56" height="28" rx="6"></rect>
          <text x="296" y="44" text-anchor="middle" class="deps-input-flow__text">開始時刻</text>
        </g>
        <g class="deps-input-flow__badge deps-input-flow__badge--input">
          <circle cx="326" cy="12" r="8"></circle>
          <text x="326" y="16" text-anchor="middle">✓</text>
        </g>
      </g>
    </svg>

    <div class="deps-input-flow__sources" data-part="sources">
      <p class="deps-input-flow__sources-title">deps の中身の出どころ</p>
      <ul>
        <li class="deps-input-flow__source" data-source-id="db">本物の保存先（データベース）</li>
        <li class="deps-input-flow__source" data-source-id="test">テスト用の部品</li>
      </ul>
    </div>
  </div>

  <p class="deps-input-flow__live" data-live aria-live="polite" hidden></p>

  <ol class="deps-input-flow__frames">
    {frames.map((frame) => (
      <li data-frame data-has-extra={frame.code || frame.view === "compare" ? "" : undefined}>
        <p class="deps-input-flow__caption">{frame.caption}</p>
        {frame.code && (
          <figure class="code-block deps-input-flow__code">
            <figcaption><code>{snippets[frame.code.key].path}</code></figcaption>
            <Code
              code={withMarks(snippets[frame.code.key].code, keyLineNumbers(snippets[frame.code.key].code, frame.code.keys))}
              lang="typescript"
              defaultColor={false}
              transformers={[markKeyLines]}
            />
          </figure>
        )}
        {frame.view === "compare" && (
          <div class="deps-input-flow__compare">
            <section class="deps-input-flow__side deps-input-flow__side--before">
              <p class="deps-input-flow__side-title">修正前: 本体が保存先を自分で読み込む</p>
              <div class="deps-input-flow__grid">
                <span class="deps-input-flow__box">Web ルート</span>
                <span class="deps-input-flow__box">テスト</span>
                <span class="deps-input-flow__arrow" aria-hidden="true">↓</span>
                <span class="deps-input-flow__arrow" aria-hidden="true">↓</span>
                <span class="deps-input-flow__box deps-input-flow__box--body deps-input-flow__box--wide">本体</span>
                <span class="deps-input-flow__arrow deps-input-flow__box--wide" aria-hidden="true">↓</span>
                <span class="deps-input-flow__box deps-input-flow__box--db deps-input-flow__box--wide">本物の保存先（データベース）</span>
              </div>
              <p class="deps-input-flow__verdict deps-input-flow__verdict--bad">テストでも本物の保存先が動く</p>
            </section>
            <section class="deps-input-flow__side deps-input-flow__side--after">
              <p class="deps-input-flow__side-title">修正後: deps で受け取る</p>
              <div class="deps-input-flow__grid">
                <span class="deps-input-flow__box">Web ルート</span>
                <span class="deps-input-flow__box">テスト</span>
                <span class="deps-input-flow__arrow" aria-hidden="true">↓</span>
                <span class="deps-input-flow__arrow" aria-hidden="true">↓</span>
                <span class="deps-input-flow__box deps-input-flow__box--db">本物の保存先（データベース）</span>
                <span class="deps-input-flow__box deps-input-flow__box--test">テスト用の部品</span>
                <span class="deps-input-flow__arrow" aria-hidden="true">↓</span>
                <span class="deps-input-flow__arrow" aria-hidden="true">↓</span>
                <span class="deps-input-flow__box deps-input-flow__box--body deps-input-flow__box--wide">本体</span>
              </div>
              <p class="deps-input-flow__verdict deps-input-flow__verdict--good">呼び出す側が保存先を選べる</p>
            </section>
          </div>
        )}
      </li>
    ))}
  </ol>
</figure>

<script>
  type Tone = "dim" | "normal" | "focus";
  type Frame = {
    caption: string;
    view: "function" | "compare";
    deps: Tone;
    input: Tone;
    body: Tone;
    sources: Tone;
    source: "none" | "db" | "test";
    wait: boolean;
    depsFilled: boolean;
    inputFilled: boolean;
  };

  const setUp = (root: HTMLElement) => {
    if (root.dataset.ready !== undefined) return;
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    if (!controls || !prev || !next || !progress || !live) return;
    if (frames.length !== panels.length) return;
    root.dataset.ready = "";

    let current = 0;
    const show = (index: number) => {
      const frame = frames[index];
      current = index;
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));

      root.dataset.view = frame.view;
      root.dataset.deps = frame.deps;
      root.dataset.input = frame.input;
      root.dataset.body = frame.body;
      root.dataset.sources = frame.sources;
      root.dataset.source = frame.source;
      root.toggleAttribute("data-wait", frame.wait);
      root.toggleAttribute("data-deps-filled", frame.depsFilled);
      root.toggleAttribute("data-input-filled", frame.inputFilled);

      live.textContent = frame.caption;
      progress.textContent = `${index + 1} / ${frames.length}`;
      prev.disabled = index === 0;
      next.disabled = index === frames.length - 1;
    };

    prev.addEventListener("click", () => show(Math.max(current - 1, 0)));
    next.addEventListener("click", () => show(Math.min(current + 1, frames.length - 1)));
    root.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(Math.max(current - 1, 0));
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(Math.min(current + 1, frames.length - 1));
      }
    });

    root.tabIndex = 0;
    root.dataset.animated = "";
    controls.hidden = false;
    live.hidden = false;
    show(0);
  };

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-deps-input-flow]").forEach(setUp);
  }
</script>

<style>
  .deps-input-flow {
    --focus-fill: color-mix(in srgb, var(--case-yellow, #ffd21b) 45%, var(--case-paper, #fffefa));
    --real: var(--case-blue, #2236b8);
    --test: #137333;
    --bad: #b3261e;
    container-type: inline-size;
    min-width: 0;
    max-width: 100%;
    margin: 1.5rem 0;
  }

  .deps-input-flow__diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  @container (min-width: 38rem) {
    .deps-input-flow__diagram {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .deps-input-flow svg {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
  }

  .deps-input-flow[data-view="compare"] .deps-input-flow__diagram {
    display: none;
  }

  .deps-input-flow__frame {
    fill: var(--case-paper, #fffefa);
    stroke: var(--case-line, #17204d);
    stroke-width: 2;
  }

  .deps-input-flow__text {
    fill: var(--case-ink, #111116);
    font-size: 11px;
  }

  .deps-input-flow__strong {
    font-weight: 700;
  }

  .deps-input-flow__mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }

  .deps-input-flow__body-text {
    font-size: 13px;
  }

  .deps-input-flow__slot {
    fill: var(--case-paper, #fffefa);
    stroke: var(--case-line, #17204d);
    stroke-width: 2;
  }

  .deps-input-flow__chip rect {
    fill: var(--case-cream, #fff8ce);
    stroke: var(--case-line, #17204d);
    stroke-width: 1.5;
  }

  .deps-input-flow__body {
    fill: var(--case-cream, #fff8ce);
    stroke: var(--case-line, #17204d);
    stroke-width: 2;
  }

  .deps-input-flow__line {
    fill: none;
    stroke: var(--case-line, #17204d);
    stroke-width: 2;
  }

  .deps-input-flow__head {
    fill: var(--case-line, #17204d);
  }

  .deps-input-flow__wait,
  .deps-input-flow__badge {
    display: none;
  }

  .deps-input-flow__wait rect {
    fill: var(--case-yellow, #ffd21b);
    stroke: var(--case-line, #17204d);
    stroke-width: 1.5;
  }

  .deps-input-flow[data-wait] .deps-input-flow__wait {
    display: block;
  }

  .deps-input-flow[data-deps-filled] .deps-input-flow__badge--deps,
  .deps-input-flow[data-input-filled] .deps-input-flow__badge--input {
    display: block;
  }

  .deps-input-flow__badge circle {
    fill: var(--test);
    stroke: var(--case-paper, #fffefa);
    stroke-width: 1.5;
  }

  .deps-input-flow__badge text {
    fill: #fff;
    font-size: 11px;
    font-weight: 700;
  }

  .deps-input-flow[data-deps="dim"] [data-part="deps"],
  .deps-input-flow[data-input="dim"] [data-part="input"],
  .deps-input-flow[data-body="dim"] [data-part="body"] {
    opacity: 0.35;
  }

  .deps-input-flow[data-deps="focus"] [data-part="deps"] .deps-input-flow__slot,
  .deps-input-flow[data-input="focus"] [data-part="input"] .deps-input-flow__slot {
    fill: var(--focus-fill);
    stroke: var(--real);
    stroke-width: 3.5;
  }

  .deps-input-flow[data-deps="focus"] [data-part="deps"] .deps-input-flow__chip rect,
  .deps-input-flow[data-input="focus"] [data-part="input"] .deps-input-flow__chip rect {
    fill: var(--case-yellow, #ffd21b);
  }

  .deps-input-flow[data-body="focus"] .deps-input-flow__line {
    stroke: var(--real);
    stroke-width: 4;
  }

  .deps-input-flow[data-body="focus"] .deps-input-flow__head {
    fill: var(--real);
  }

  .deps-input-flow[data-body="focus"] .deps-input-flow__body {
    fill: var(--focus-fill);
    stroke: var(--real);
    stroke-width: 3.5;
  }

  .deps-input-flow__sources {
    min-width: 0;
  }

  .deps-input-flow__sources ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 38rem) {
    .deps-input-flow__sources ul {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }

  .deps-input-flow__sources-title {
    margin: 0 0 0.75rem;
    font-weight: 700;
  }

  .deps-input-flow__source {
    position: relative;
    margin: 0;
    padding: 0.6rem 0.75rem;
    border: 2px solid var(--case-line, #17204d);
    border-radius: 0.5rem;
    background: var(--case-paper, #fffefa);
    color: var(--case-ink, #111116);
    font-size: 0.9rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .deps-input-flow__source::before {
    position: absolute;
    top: -1.1rem;
    left: 50%;
    display: none;
    color: var(--real);
    content: "▲";
    font-size: 0.9rem;
    line-height: 1;
    transform: translateX(-50%);
  }

