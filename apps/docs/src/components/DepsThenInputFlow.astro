---
import { Code } from "astro:components";
import routesSource from "../../../../examples/session-04/src/adaptor/primary/web/routes.ts?raw";
import testSource from "../../../../examples/session-04-solution/test/regression/result-errors.test.ts?raw";
import useCaseSource from "../../../../examples/session-04/src/useCase/startExamination.ts?raw";
import { quote } from "../sessions/reference-quote";
import MiniTree from "./mini-tree/MiniTree.astro";
import { miniTree } from "./mini-tree/mini-tree";
import StepControls from "./stepper/StepControls.astro";
import { bandMeta, bandTransformer, checkBands, lineIs } from "./workflow-errors/lines";
import "./workflow-errors/figure.css";

const snippets = {
  useCase: {
    path: "examples/session-04/src/useCase/startExamination.ts:14-30",
    code: quote(useCaseSource, 14, 30, "export const startExamination"),
  },
  route: {
    path: "examples/session-04/src/adaptor/primary/web/routes.ts:80-86",
    code: quote(routesSource, 80, 86, "startExamination({"),
  },
  test: {
    path: "examples/session-04-solution/test/regression/result-errors.test.ts:109-125",
    code: quote(testSource, 109, 125, "const createDependencies"),
  },
} as const;

type Tone = "dim" | "normal" | "focus";
type Frame = Readonly<{
  caption: string;
  deps: Tone;
  input: Tone;
  body: Tone;
  sources: Tone;
  source: "none" | "db" | "test";
  wait: boolean;
  depsFilled: boolean;
  inputFilled: boolean;
  code?: Readonly<{ key: keyof typeof snippets; keys: readonly string[] }>;
  compare?: true;
}>;

const frames: readonly Frame[] = [
  {
    caption: "依存を受け取る関数は、deps を受け取ります。deps は、予約を取得する resolver と、予約を保存する store をまとめた値です。",
    deps: "focus", input: "dim", body: "dim", sources: "dim", source: "none", wait: false, depsFilled: false, inputFilled: false,
    code: { key: "useCase", keys: ["(deps: Dependencies) =>"] },
  },
  {
    caption: "deps を渡しても診察は始まらず、入力を受け取る関数が返されます。この関数が、予約ID、獣医師ID、開始時刻を受け取ります。",
    deps: "normal", input: "focus", body: "dim", sources: "dim", source: "none", wait: true, depsFilled: true, inputFilled: false,
    code: { key: "useCase", keys: ["(input: StartExaminationInput): InExamination => {"] },
  },
  {
    caption: "input を受け取ると本体が実行されます。本体は、外部とやり取りする処理を deps.resolver と deps.store の呼び出しでだけ実行します。",
    deps: "normal", input: "normal", body: "focus", sources: "dim", source: "none", wait: false, depsFilled: true, inputFilled: true,
    code: { key: "useCase", keys: ["deps.resolver.resolveById(input.appointmentId),", "deps.store.save(next);"] },
  },
  {
    caption: "Web ルートは、本物の保存先 store を resolver と store の両方として渡し、続けて依頼の値を渡します。S04 の route は、依頼のたびにこの形で渡します。",
    deps: "focus", input: "normal", body: "normal", sources: "normal", source: "db", wait: false, depsFilled: true, inputFilled: true,
    code: { key: "route", keys: ["resolver: store,", "store,"] },
  },
  {
    caption: "テストは、固定の予約を返す resolver と、保存の回数を数える store を渡します。演習では、保存された予約を配列 saved に格納する偽物の Store を使います。",
    deps: "focus", input: "normal", body: "normal", sources: "normal", source: "test", wait: false, depsFilled: true, inputFilled: true,
    code: { key: "test", keys: ["resolver: { resolveById: () => resolved },", "observer.saveCalls += 1;"] },
  },
  {
    caption: "(deps, input) を1度に受け取る形と比べます。この形は、呼ぶたびに deps も渡します。2回に分ける形は、start を作れば、以後は input だけで呼び出せます。S04 のコードでは、この利点はまだ現れません。",
    deps: "normal", input: "normal", body: "normal", sources: "normal", source: "none", wait: false, depsFilled: true, inputFilled: true,
    compare: true,
  },
];

const keyBands = (frame: Frame) => {
  if (frame.code === undefined) return {};
  const code = snippets[frame.code.key].code;
  return checkBands(code, { a: frame.code.keys.map((text) => lineIs(code, text)) });
};

const tree = miniTree("session-04", "", [
  { folder: "src/useCase/", files: [{ id: "useCase", name: "startExamination.ts" }] },
  { folder: "src/adaptor/primary/web/", files: [{ id: "route", name: "routes.ts" }] },
  { folder: "test/regression/", files: [{ id: "test", name: "result-errors.test.ts", snapshot: "session-04-solution", note: "（解答: session-04-solution）" }] },
]);

const themes = { light: "github-light", dark: "github-dark" } as const;
const onePhase = `startExamination(deps, inputA);
startExamination(deps, inputB);`;
const twoPhase = `const start = startExamination(deps);
start(inputA);
start(inputB);`;

const playerData = JSON.stringify(frames.map(({ code: _code, compare: _compare, caption: _caption, ...frame }) => frame));
---

<figure
  class="we-fig deps-input-flow"
  aria-label="startExamination が deps と input を2回に分けて受け取る流れ"
  data-deps-input-flow
  data-frames={playerData}
>
  <div class="deps-input-flow__layout">
    <div class="deps-input-flow__left">
      <StepControls />
      <svg viewBox="0 0 340 232" role="img" aria-label="startExamination が deps と input を受け取る関数の図: 依存を受け取る関数の deps に resolver と store、入力を受け取る関数の input に予約ID、獣医師ID、開始時刻が含まれます。">
        <rect x="4" y="64" width="332" height="162" rx="10" class="deps-input-flow__frame"></rect>
        <text x="326" y="86" text-anchor="end" class="deps-input-flow__mono deps-input-flow__strong deps-input-flow__text">startExamination</text>
        <g class="deps-input-flow__wait">
          <rect x="208" y="94" width="118" height="22" rx="11"></rect>
          <text x="267" y="109" text-anchor="middle" class="deps-input-flow__text">input 待ちの関数</text>
        </g>

        <g class="deps-input-flow__part" data-part="body">
          <path d="M39 64 V150" class="deps-input-flow__line"></path>
          <path d="M97 64 V150" class="deps-input-flow__line"></path>
          <polygon points="39,56 34,65 44,65" class="deps-input-flow__head"></polygon>
          <polygon points="97,56 92,65 102,65" class="deps-input-flow__head"></polygon>
          <path d="M172 64 V142" class="deps-input-flow__line"></path>
          <polygon points="172,150 167,141 177,141" class="deps-input-flow__head"></polygon>
          <rect x="14" y="150" width="190" height="60" rx="8" class="deps-input-flow__body"></rect>
          <text x="109" y="186" text-anchor="middle" class="deps-input-flow__strong deps-input-flow__text deps-input-flow__body-text">本体</text>
        </g>

        <g class="deps-input-flow__part" data-part="deps">
          <rect x="4" y="4" width="128" height="60" rx="8" class="deps-input-flow__slot"></rect>
          <text x="12" y="19" class="deps-input-flow__strong deps-input-flow__text">依存 deps</text>
          <g class="deps-input-flow__chip">
            <rect x="12" y="26" width="54" height="28" rx="6"></rect>
            <text x="39" y="44" text-anchor="middle" class="deps-input-flow__text">resolver</text>
          </g>
          <g class="deps-input-flow__chip">
            <rect x="70" y="26" width="54" height="28" rx="6"></rect>
            <text x="97" y="44" text-anchor="middle" class="deps-input-flow__text">store</text>
          </g>
          <g class="deps-input-flow__badge deps-input-flow__badge--deps">
            <circle cx="122" cy="12" r="8"></circle>
            <text x="122" y="16" text-anchor="middle">✓</text>
          </g>
        </g>

        <g class="deps-input-flow__part" data-part="input">
          <rect x="140" y="4" width="196" height="60" rx="8" class="deps-input-flow__slot"></rect>
          <text x="148" y="19" class="deps-input-flow__strong deps-input-flow__text">入力 input</text>
          <g class="deps-input-flow__chip">
            <rect x="148" y="26" width="56" height="28" rx="6"></rect>
            <text x="176" y="44" text-anchor="middle" class="deps-input-flow__text">予約ID</text>
          </g>
          <g class="deps-input-flow__chip">
            <rect x="208" y="26" width="56" height="28" rx="6"></rect>
            <text x="236" y="44" text-anchor="middle" class="deps-input-flow__text">獣医師ID</text>
          </g>
          <g class="deps-input-flow__chip">
            <rect x="268" y="26" width="56" height="28" rx="6"></rect>
            <text x="296" y="44" text-anchor="middle" class="deps-input-flow__text">開始時刻</text>
          </g>
          <g class="deps-input-flow__badge deps-input-flow__badge--input">
            <circle cx="326" cy="12" r="8"></circle>
            <text x="326" y="16" text-anchor="middle">✓</text>
          </g>
        </g>
      </svg>

      <div class="deps-input-flow__sources" data-part="sources">
        <p class="deps-input-flow__sources-title">deps の中身の出どころ</p>
        <ul>
          <li class="deps-input-flow__source" data-source-id="db">本物の保存先（データベース）</li>
          <li class="deps-input-flow__source" data-source-id="test">テスト用のオブジェクト</li>
        </ul>
      </div>
    </div>

    <ol class="we-frames deps-input-flow__frames">
      {frames.map((frame) => (
        <li data-frame>
          <p class="we-caption">{frame.caption}</p>
          {frame.code && <MiniTree tree={tree} current={[frame.code.key]} />}
          {frame.code && (
            <figure class="we-code deps-input-flow__code">
              <Code
                code={snippets[frame.code.key].code}
                lang="typescript"
                themes={themes}
                defaultColor={false}
                transformers={[bandTransformer]} meta={bandMeta(keyBands(frame))}
              />
              <figcaption class="deps-input-flow__path"><code>{snippets[frame.code.key].path}</code></figcaption>
            </figure>
          )}
          {frame.compare && (
            <div class="deps-input-flow__compare">
              <section class="deps-input-flow__side" data-band="c">
                <p class="deps-input-flow__side-title">1度に受け取る: <code>(deps, input)</code></p>
                <figure class="we-code deps-input-flow__mini">
                  <Code code={onePhase} lang="typescript" themes={themes} defaultColor={false} />
                </figure>
                <p class="deps-input-flow__verdict">呼ぶたびに deps も渡す</p>
              </section>
              <section class="deps-input-flow__side" data-band="b">
                <p class="deps-input-flow__side-title">2回に分ける: <code>(deps)(input)</code></p>
                <figure class="we-code deps-input-flow__mini">
                  <Code code={twoPhase} lang="typescript" themes={themes} defaultColor={false} />
                </figure>
                <p class="deps-input-flow__verdict">deps を渡すのは1回。以後は input だけ</p>
              </section>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "./stepper/stepper";

  type Tone = "dim" | "normal" | "focus";
  type Frame = {
    deps: Tone;
    input: Tone;
    body: Tone;
    sources: Tone;
    source: "none" | "db" | "test";
    wait: boolean;
    depsFilled: boolean;
    inputFilled: boolean;
  };

  document.querySelectorAll<HTMLElement>("[data-deps-input-flow]").forEach((root) => {
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    mountStepper({
      root,
      onStep: (index) => {
        const frame = frames[index];
        if (frame === undefined) return;
        root.dataset.deps = frame.deps;
        root.dataset.input = frame.input;
        root.dataset.body = frame.body;
        root.dataset.sources = frame.sources;
        root.dataset.source = frame.source;
        root.toggleAttribute("data-wait", frame.wait);
        root.toggleAttribute("data-deps-filled", frame.depsFilled);
        root.toggleAttribute("data-input-filled", frame.inputFilled);
      },
    });
  });
</script>

<style>
  .deps-input-flow {
    --focus-fill: color-mix(in srgb, var(--role-accent) 22%, var(--role-surface));
    --chip-fill: color-mix(in srgb, var(--role-border) 14%, var(--role-surface));
    container-type: inline-size;
  }

  .deps-input-flow__layout {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .deps-input-flow__left {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .deps-input-flow svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .deps-input-flow__frame,
  .deps-input-flow__slot {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .deps-input-flow__text {
    fill: var(--role-text);
    font-size: 11px;
  }

  .deps-input-flow__strong {
    font-weight: 700;
  }

  .deps-input-flow__mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }

  .deps-input-flow__body-text {
    font-size: 13px;
  }

  .deps-input-flow__chip rect {
    fill: var(--chip-fill);
    stroke: var(--role-border);
    stroke-width: 1.5;
  }

  .deps-input-flow__body {
    fill: var(--chip-fill);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .deps-input-flow__line {
    fill: none;
    stroke: var(--role-text);
    stroke-width: 2;
  }

  .deps-input-flow__head {
    fill: var(--role-text);
  }

  .deps-input-flow__wait,
  .deps-input-flow__badge {
    display: none;
  }

  .deps-input-flow__wait rect {
    fill: var(--focus-fill);
    stroke: var(--role-accent);
    stroke-width: 1.5;
  }

  .deps-input-flow[data-wait] .deps-input-flow__wait {
    display: block;
  }

  .deps-input-flow[data-deps-filled] .deps-input-flow__badge--deps,
  .deps-input-flow[data-input-filled] .deps-input-flow__badge--input {
    display: block;
  }

  .deps-input-flow__badge circle {
    fill: var(--role-positive);
    stroke: var(--role-surface);
    stroke-width: 1.5;
  }

  .deps-input-flow__badge text {
    fill: var(--role-surface);
    font-size: 11px;
    font-weight: 700;
  }

  .deps-input-flow[data-deps="dim"] [data-part="deps"] :is(rect, path, polygon),
  .deps-input-flow[data-input="dim"] [data-part="input"] :is(rect, path, polygon),
  .deps-input-flow[data-body="dim"] [data-part="body"] :is(rect, path, polygon) {
    opacity: 0.35;
  }

  .deps-input-flow[data-deps="focus"] [data-part="deps"] .deps-input-flow__slot,
  .deps-input-flow[data-input="focus"] [data-part="input"] .deps-input-flow__slot {
    fill: var(--focus-fill);
    stroke: var(--role-accent);
    stroke-width: 3.5;
  }

  .deps-input-flow[data-deps="focus"] [data-part="deps"] .deps-input-flow__chip rect,
  .deps-input-flow[data-input="focus"] [data-part="input"] .deps-input-flow__chip rect {
    fill: var(--focus-fill);
    stroke: var(--role-accent);
  }

  .deps-input-flow[data-body="focus"] .deps-input-flow__line {
    stroke: var(--role-accent);
    stroke-width: 4;
  }

  .deps-input-flow[data-body="focus"] .deps-input-flow__head {
    fill: var(--role-accent);
  }

  .deps-input-flow[data-body="focus"] .deps-input-flow__body {
    fill: var(--focus-fill);
    stroke: var(--role-accent);
    stroke-width: 3.5;
  }

  .deps-input-flow__sources {
    min-width: 0;
  }

  .deps-input-flow__sources ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deps-input-flow__sources-title {
    margin: 0 0 1.125rem;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .deps-input-flow__source {
    position: relative;
    margin: 0;
    padding: 0.375rem 0.5rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.8125rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .deps-input-flow__source::before {
    position: absolute;
    top: -1.1rem;
    left: 50%;
    display: none;
    color: var(--role-accent);
    content: "▲";
    font-size: 0.8125rem;
    line-height: 1;
    transform: translateX(-50%);
  }

  .deps-input-flow[data-source="db"] .deps-input-flow__source[data-source-id="db"],
  .deps-input-flow[data-source="test"] .deps-input-flow__source[data-source-id="test"] {
    border-color: var(--role-accent);
    background: var(--focus-fill);
    font-weight: 700;
  }

  .deps-input-flow[data-source="db"] .deps-input-flow__source[data-source-id="db"]::before,
  .deps-input-flow[data-source="test"] .deps-input-flow__source[data-source-id="test"]::before {
    display: block;
  }

  .deps-input-flow[data-sources="dim"] .deps-input-flow__source,
  .deps-input-flow[data-source="db"] .deps-input-flow__source[data-source-id="test"],
  .deps-input-flow[data-source="test"] .deps-input-flow__source[data-source-id="db"] {
    border-color: color-mix(in srgb, var(--role-border) 35%, transparent);
    background: color-mix(in srgb, var(--role-surface) 35%, transparent);
  }

  .deps-input-flow__frames {
    min-width: 0;
  }

  .deps-input-flow__frames > li {
    min-width: 0;
  }

  .deps-input-flow .we-caption {
    min-height: 2.9rem;
    margin-block-end: 0.375rem;
  }

  .deps-input-flow__code {
    margin: 0;
  }

  .deps-input-flow__path {
    padding: 0.125rem 0.625rem;
    border-block-start: 1px solid var(--role-border);
    background: color-mix(in srgb, var(--role-border) 14%, var(--role-surface));
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .deps-input-flow__path code {
    padding: 0;
    background: none;
    font-size: inherit;
    overflow-wrap: anywhere;
  }

  .deps-input-flow__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .deps-input-flow__side {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.5rem;
    border: 2px solid var(--band);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .deps-input-flow__side-title {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .deps-input-flow__verdict {
    color: var(--band);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .deps-input-flow[data-ready] [data-part] :is(rect, path, polygon) {
    transition: opacity 0.3s;
  }

  .deps-input-flow[data-ready] .deps-input-flow__source {
    transition: background-color 0.3s, border-color 0.3s;
  }

  @media (max-height: 700px) {
    .deps-input-flow .we-caption {
      margin-block-end: 0.125rem;
    }

    .deps-input-flow :global(.mini-tree) {
      row-gap: 0;
    }

    .deps-input-flow :global(.mini-tree__file) {
      padding-block: 0;
    }

    .deps-input-flow__path {
      padding-block: 0;
    }
  }

  @container (max-width: 40rem) {
    .deps-input-flow__layout,
    .deps-input-flow__compare {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
