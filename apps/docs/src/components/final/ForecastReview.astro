---
import { sessionPageHref } from "../../sessions/pages/links";
import { incidents, mechanisms, stages } from "../handover/forecast-storage";

type Actual = Readonly<{
  stage: (typeof stages)[number]["value"];
  mechanisms: readonly (typeof mechanisms)[number]["value"][];
  text: string;
}>;

const actuals: Readonly<Record<(typeof incidents)[number]["id"], Actual>> = {
  "double-billing": {
    stage: "decide",
    mechanisms: ["write"],
    text: "S01 の状態の型で、許可されない遷移を型検査が報告します。",
  },
  "pii-audit": {
    stage: "save",
    mechanisms: ["write", "test"],
    text: "S03 の監査記録の型と、連絡先が残らないことを確かめるテストで検出します。",
  },
};

const stageLabel = (value: string) => stages.find((stage) => stage.value === value)?.label ?? value;
const mechanismLabel = (value: string) => mechanisms.find((mechanism) => mechanism.value === value)?.label ?? value;

const labels = {
  stage: Object.fromEntries(stages.map(({ value, label }) => [value, label])),
  mechanism: Object.fromEntries(mechanisms.map(({ value, label }) => [value, label])),
};
const forecastHref = sessionPageHref("00-system-handover", "forecast");
---

<figure class="fr" data-forecast-review data-labels={JSON.stringify(labels)} aria-label="S00 の予想と、実際に使った仕組みの比較">
  <p class="fr__notice" data-empty-notice>
    S00 の予想がこのブラウザに保存されていません。実際に使った仕組みだけを見てください。<a href={forecastHref}>S00 の予想のページ</a>
  </p>

  <table class="fr__table">
    <thead>
      <tr>
        <th scope="col">事故</th>
        <th scope="col">あなたの予想（段・仕組み）</th>
        <th scope="col">実際に使った仕組み</th>
      </tr>
    </thead>
    <tbody>
      {incidents.map((incident) => (
        <tr data-incident={incident.id}>
          <th scope="row">{incident.title}</th>
          <td>
            <p class="fr__label">あなたの予想（段・仕組み）</p>
            <dl class="fr__pairs">
              <dt>段</dt>
              <dd data-field="stage" data-empty>未回答</dd>
              <dt>仕組み</dt>
              <dd data-field="mechanism" data-empty>未回答</dd>
            </dl>
          </td>
          <td>
            <p class="fr__label">実際に使った仕組み</p>
            <dl class="fr__pairs">
              <dt>段</dt>
              <dd>{stageLabel(actuals[incident.id].stage)}</dd>
              <dt>仕組み</dt>
              <dd>{actuals[incident.id].mechanisms.map(mechanismLabel).join("、")}</dd>
            </dl>
            <p class="fr__text">{actuals[incident.id].text}</p>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</figure>

<script>
  import { load } from "../handover/forecast-storage";

  document.querySelectorAll<HTMLElement>("[data-forecast-review]").forEach((root) => {
    const labels = JSON.parse(root.dataset.labels ?? "{}") as Record<"stage" | "mechanism", Record<string, string>>;
    const saved = load();
    let answered = 0;

    root.querySelectorAll<HTMLElement>("[data-incident]").forEach((row) => {
      const choice = saved.incidents[row.dataset.incident ?? ""] ?? {};
      row.querySelectorAll<HTMLElement>("[data-field]").forEach((cell) => {
        const field = cell.dataset.field === "mechanism" ? "mechanism" : "stage";
        const value = choice[field];
        if (value === undefined) return;
        cell.textContent = labels[field][value] ?? value;
        cell.removeAttribute("data-empty");
        answered += 1;
      });
    });

    root.querySelector<HTMLElement>("[data-empty-notice]")?.toggleAttribute("hidden", answered > 0);
  });
</script>

<style>
  .fr {
    min-width: 0;
    margin: 1rem 0;
  }

  .fr__notice {
    margin: 0 0 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .fr__notice[hidden] {
    display: none;
  }

  .fr__notice a {
    margin-inline-start: 0.5rem;
    color: var(--role-accent);
    font-weight: 700;
  }

  .fr__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .fr__table th,
  .fr__table td {
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    text-align: start;
    vertical-align: top;
  }

  .fr__table thead th {
    color: var(--role-muted);
    font-size: 0.875rem;
  }

  .fr__table tbody th {
    width: 20%;
    font-weight: 800;
  }

  .fr__pairs {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.125rem 0.625rem;
    margin: 0;
  }

  .fr__pairs dt {
    color: var(--role-muted);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .fr__pairs dd {
    margin: 0;
    font-weight: 700;
  }

  .fr__pairs dd[data-empty] {
    color: var(--role-muted);
    font-weight: 400;
  }

  .fr__label {
    display: none;
    margin: 0 0 0.25rem;
    color: var(--role-muted);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .fr__text {
    margin: 0.375rem 0 0;
    color: var(--role-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 40rem) {
    .fr__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .fr__table,
    .fr__table tbody,
    .fr__table tr,
    .fr__table th,
    .fr__table td {
      display: block;
      width: auto;
    }

    .fr__table tbody th {
      width: auto;
    }

    .fr__label {
      display: block;
    }
  }
</style>
