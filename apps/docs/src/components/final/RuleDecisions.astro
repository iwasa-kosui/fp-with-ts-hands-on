---
import { Code } from "astro:components";

const options = ["コードを修正する", "ルールを修正する", "理由を付けて残す"] as const;

const cards = [
  {
    id: "clock",
    title: "new Date（2件）",
    code: "new Date(Date.parse(occurredAt) + sessionDurationMs).toISOString()",
    sources: [
      { label: "examples/final/src/useCase/logInUseCase.ts:84", href: "https://github.com/iwasa-kosui/fp-with-ts-hands-on/blob/main/examples/final/src/useCase/logInUseCase.ts#L84" },
      { label: "setUpInitialAdminUseCase.ts:77", href: "https://github.com/iwasa-kosui/fp-with-ts-hands-on/blob/main/examples/final/src/useCase/setUpInitialAdminUseCase.ts#L77" },
    ],
    decision: "ルールを修正する",
    results: {
      "コードを修正する": "指摘は消えますが、この行は受け取った時刻から計算しているだけで、現在時刻を取得していません。正しいコードを、誤検知に合わせて書き換えることになります。",
      "ルールを修正する": "ルールを、引数なしの new Date() だけを対象にする形に戻します。2件の指摘が消えます。現在時刻を取得する Date.now() は別のルールで検出されるため、検出できる範囲は減りません。",
      "理由を付けて残す": "2件に理由のコメントが必要です。引数のある new Date を書くたびに同じコメントが増え、ルールの誤りをコード側で打ち消し続けます。",
    },
  },
  {
    id: "corruption",
    title: "throw（1件）",
    code: [
      "export const rejectExamResultPetMismatch = (",
      "  mismatch: ExamResultPetMismatch,",
      "): never => {",
      "  throw new TypeError(",
      "    `Corrupt follow-up candidate: appointment ${mismatch.appointmentId} expects pet ${mismatch.expectedPetId} but its exam result has pet ${mismatch.actualPetId}`,",
      "  );",
      "};",
    ].join("\n"),
    sources: [{ label: "examples/final/src/useCase/rejectExamResultPetMismatch.ts:3-9", href: "https://github.com/iwasa-kosui/fp-with-ts-hands-on/blob/main/examples/final/src/useCase/rejectExamResultPetMismatch.ts#L3-L9" }],
    decision: "理由を付けて残す",
    results: {
      "コードを修正する": "throw を Err に変えると、利用者が選べる操作のない破損データを、業務の失敗として返すことになります。S06 では、このような障害を例外のまま渡しました。",
      "ルールを修正する": "useCase の throw を対象外にすると、業務の失敗を throw する誤りも検出されなくなります。1件のために、ルール全体を弱めることになります。",
      "理由を付けて残す": "この throw は、保存済みのデータの破損を検出したときに投げます。Err にせず例外の境界へ渡すため、この行だけ、理由のコメントを付けてルールを無効にします。",
    },
  },
] as const;
---

<div class="rd" data-rule-decisions>
  {cards.map((card) => (
    <section class="rd__card" data-card aria-labelledby={`rd-title-${card.id}`}>
      <h4 class="rd__title" id={`rd-title-${card.id}`}>{card.title}</h4>

      <figure class="code-block rd__code">
        <figcaption>{card.sources.map((source, index) => <>{index > 0 && " と "}<a href={source.href}><code>{source.label}</code></a></>)}</figcaption>
        <Code code={card.code} lang="typescript" wrap />
      </figure>

      <div class="rd__options" role="group" aria-label={`${card.title}の選択肢`}>
        {options.map((option) => (
          <button type="button" class="rd__option" data-option aria-pressed="false">{option}</button>
        ))}
      </div>

      <div class="rd__answer" data-answer aria-live="polite">
        <p class="rd__placeholder">選ぶと、ここにその対処の結果が表示されます。</p>
        <div class="rd__answer-body" data-answer-body>
          {options.map((option) => (
            <div class="rd__result" data-result={option}>
              <p class="rd__decision"><strong>{option}</strong>{option === card.decision ? "（この教材の判断）" : "（この教材の判断ではない）"}</p>
              <p class="rd__text">{card.results[option]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-rule-decisions]").forEach((root) => {
    root.querySelectorAll<HTMLElement>("[data-card]").forEach((card) => {
      const buttons = [...card.querySelectorAll<HTMLButtonElement>("[data-option]")];
      const results = [...card.querySelectorAll<HTMLElement>("[data-result]")];
      const answer = card.querySelector<HTMLElement>("[data-answer]");
      if (!answer) return;

      buttons.forEach((button) =>
        button.addEventListener("click", () => {
          buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
          results.forEach((result) => result.toggleAttribute("data-selected", result.dataset.result === button.textContent));
          answer.dataset.open = "";
        }),
      );
    });
  });
</script>

<style>
  .rd {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1rem;
    min-width: 0;
    margin: 0.25rem 0;
  }

  .rd__card {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
  }

  .rd__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
  }

  .rd__code {
    min-width: 0;
    margin: 0;
  }

  .rd__code figcaption code {
    font-size: 0.75rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .rd__code :global(figcaption) {
    display: block;
    padding: 0.25rem 0.5rem;
  }

  .rd__code :global(pre) {
    margin: 0;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .rd__code :global(pre code) {
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .rd__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .rd__option {
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .rd__option[aria-pressed="true"] {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
  }

  .rd__option[aria-pressed="true"]::before {
    content: "✓ ";
    color: var(--role-accent);
  }

  .rd__option:focus-visible {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  .rd__answer {
    padding: 0.375rem 0.625rem;
    border: 2px dashed var(--role-border);
    border-radius: 0.5rem;
  }

  .rd__answer {
    position: relative;
  }

  .rd__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.375rem 0.625rem;
    color: var(--role-muted);
    font-size: 0.875rem;
  }

  .rd__answer[data-open] .rd__placeholder {
    display: none;
  }

  .rd__answer-body {
    display: grid;
    visibility: hidden;
  }

  .rd__result {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .rd__result[data-selected] {
    visibility: visible;
  }

  .rd__answer[data-open] {
    border-style: solid;
  }

  .rd__answer[data-open] .rd__answer-body {
    visibility: visible;
  }

  .rd__answer p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .rd__decision {
    margin-block-end: 0.125rem;
    font-weight: 700;
  }

  .rd__text {
    color: var(--role-muted);
  }

  @media (max-height: 700px) {
    .rd {
      margin: 0;
    }

    .rd__card {
      gap: 0.125rem;
      padding-block: 0.25rem;
    }

    .rd__answer {
      padding-block: 0.25rem;
    }

    .rd__decision,
    .rd__text {
      display: inline;
    }

    .rd__decision {
      margin-inline-end: 0.5rem;
    }

    .rd__code :global(pre) {
      padding-block: 0.125rem;
      line-height: 1.35;
    }

    .rd__option {
      min-height: 2.25rem;
    }

    .rd__answer p {
      line-height: 1.4;
    }
  }

  @media (max-width: 55rem) {
    .rd {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
