---
import { sessionPageHref } from "../../sessions/pages/links";
import type { NoticeMomentId } from "../handover/notice-moments";

const mechanisms: Readonly<Record<NoticeMomentId, string>> = {
  write: "型と Linter のルールです。S01 から S06 までの演習で追加しました。",
  test: "テストです。S01 から S06 までの演習で追加しました。",
  run: "境界の検査と Result です。S03 と S04 で追加しました。",
  human: "相互レビューです。機械で検証できないことを、人が確認します。",
};
const noGoal = "検出できるようにする時点を選択すると、使用できる仕組みが表示されます。";

const ruleHref = sessionPageHref("00-system-handover", "your-rule");
---

<figure
  class="orr"
  data-own-rule-review
  data-mechanisms={JSON.stringify(mechanisms)}
  data-no-goal={noGoal}
  aria-label="S00 で記入した業務ルールと、使用できる仕組み"
>
  <p class="orr__notice" data-empty-notice hidden>
    S00 の業務ルールがこのブラウザに保存されていません。S00 のページに記入すると、ここに表示されます。<a href={ruleHref}>担当システムの暗黙の業務ルールを1つ選ぶ</a>
  </p>

  <div class="orr__body" data-body hidden>
    <section class="orr__block">
      <h3 class="orr__heading">記入した業務ルール</h3>
      <p class="orr__rule" data-rule tabindex="0"></p>
    </section>

    <section class="orr__block">
      <div class="orr__moments">
        <div class="orr__moment">
          <h3 class="orr__heading">現在検出される時点</h3>
          <p class="orr__value" data-moment="now"></p>
        </div>
        <span class="orr__arrow" aria-hidden="true">→</span>
        <div class="orr__moment">
          <h3 class="orr__heading">検出できるようにする時点</h3>
          <p class="orr__value" data-moment="goal"></p>
        </div>
      </div>
    </section>

    <section class="orr__block">
      <h3 class="orr__heading">その時点で検出するために使える仕組み</h3>
      <p class="orr__mechanism" data-mechanism></p>
    </section>
  </div>
</figure>

<script>
  import { load, momentLabel } from "../handover/own-rule-storage";

  document.querySelectorAll<HTMLElement>("[data-own-rule-review]").forEach((root) => {
    const mechanisms = JSON.parse(root.dataset.mechanisms ?? "{}") as Record<string, string>;
    const saved = load();
    const notice = root.querySelector<HTMLElement>("[data-empty-notice]");
    const body = root.querySelector<HTMLElement>("[data-body]");
    const rule = root.querySelector<HTMLElement>("[data-rule]");
    const mechanism = root.querySelector<HTMLElement>("[data-mechanism]");
    if (!notice || !body || !rule || !mechanism) return;

    if (saved.rule.trim() === "") {
      notice.hidden = false;
      return;
    }

    rule.textContent = saved.rule;
    for (const field of ["now", "goal"] as const) {
      const cell = root.querySelector<HTMLElement>(`[data-moment='${field}']`);
      const id = saved[field];
      if (!cell) continue;
      cell.textContent = id === undefined ? "未回答" : momentLabel(id);
      cell.toggleAttribute("data-empty", id === undefined);
    }
    mechanism.textContent = saved.goal === undefined ? (root.dataset.noGoal ?? "") : (mechanisms[saved.goal] ?? "");
    body.hidden = false;
  });
</script>

<style>
  .orr {
    min-width: 0;
    margin: 1rem 0;
    color: var(--role-text);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .orr__notice {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .orr__notice[hidden],
  .orr__body[hidden] {
    display: none;
  }

  .orr__notice a {
    margin-inline-start: 0.5rem;
    color: var(--role-accent);
    font-weight: 700;
  }

  .orr__body {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .orr__block {
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .orr__heading {
    margin: 0 0 0.25rem;
    color: var(--role-muted);
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .orr__rule,
  .orr__value,
  .orr__mechanism {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .orr__rule {
    max-height: 7.5rem;
    overflow: auto;
    font-weight: 800;
    white-space: pre-wrap;
  }

  .orr__rule:focus-visible {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  .orr__moments {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .orr__value {
    font-weight: 800;
  }

  .orr__value[data-empty] {
    color: var(--role-muted);
    font-weight: 400;
  }

  .orr__arrow {
    color: var(--role-accent);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .orr__mechanism {
    font-weight: 700;
  }

  @media (max-height: 700px) {
    .orr {
      margin-block: 0.5rem;
    }

    .orr__body {
      gap: 0.375rem;
    }

    .orr__block {
      padding-block: 0.25rem;
    }

    .orr__heading {
      margin-block-end: 0;
    }

    .orr__rule {
      max-height: 4.5rem;
    }
  }

  @media (max-width: 40rem) {
    .orr__moments {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .orr__arrow {
      display: none;
    }
  }
</style>
