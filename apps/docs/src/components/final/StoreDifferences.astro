---
import { Code } from "astro:components";
import StepControls from "../stepper/StepControls.astro";

type Snippet = Readonly<{ code: string; path: string }>;
type Props = Readonly<{
  code: Readonly<{
    s06Update: Snippet;
    finalUpdate: Snippet;
    s06Conflict: Snippet;
    finalConflict: Snippet;
    s06Port: Snippet;
    finalPort: Snippet;
  }>;
}>;

const { code } = Astro.props;

const scenes = [
  {
    label: "条件付き更新",
    left: code.s06Update,
    right: code.finalUpdate,
    text: "S06 は transaction の中で予約を再取得して分岐します。この形は、書き込みが直列に実行される SQLite に依存します。PostgreSQL の既定の分離レベルでは、2つの transaction がどちらも CheckedIn を取得し、どちらも書き込めます。参照実装は、status が CheckedIn の行だけを更新します。このように WHERE に条件を付けた更新を条件付き更新と呼び、更新した行が0件なら競合です。WHERE の条件で判定するため、ほかのデータベースでも成り立ちます。",
  },
  {
    label: "競合の伝え方",
    left: code.s06Conflict,
    right: code.finalConflict,
    text: "参照実装の store は複数のイベントを1つの transaction で保存します。S06 のように err を返すと transaction が確定するため、途中のイベントで競合したときは throw でそれまでの書き込みを取り消し、fromPromise の2つ目の引数で Err に戻します。それ以外は投げ直すため、障害は Err になりません。S06「保存先の障害と例外の伝播」の、fromPromise ですべてを AppointmentConflict に変える誤った例と異なります。",
  },
  {
    label: "port の配置先",
    left: code.s06Port,
    right: code.finalPort,
    text: "S06 は port を useCase に配置しました。参照実装は domain に配置しました。どちらの場合も、port は外側の実装に依存しません。配置先が違っても、この依存の向きは変わりません。",
  },
] as const;
---

<figure class="sd" data-store-differences data-step-figure aria-label="S06 と参照実装の、実装が異なる3点">
  <StepControls />
  <div class="sd__bar">
    <div class="sd__tabs" role="group" aria-label="実装が異なる点を選ぶ">
      {scenes.map((scene, index) => (
        <button type="button" class="sd__tab" data-step-scene aria-pressed={index === 0 ? "true" : "false"}>{scene.label}</button>
      ))}
    </div>
  </div>

  <div class="sd__scenes">
    {scenes.map((scene, index) => (
      <section class="sd__scene" data-scene data-current={index === 0 ? "" : undefined}>
        <h4 class="sd__scene-title">{scene.label}</h4>
        <div class="sd__cols">
          {[
            { side: "S06", snippet: scene.left },
            { side: "参照実装", snippet: scene.right },
          ].map(({ side, snippet }) => (
            <figure class="code-block sd__code">
              <figcaption>
                <strong>{side}</strong>
                <code>{snippet.path}</code>
              </figcaption>
              <Code code={snippet.code} lang="typescript" wrap />
            </figure>
          ))}
        </div>
        <p class="sd__text">{scene.text}</p>
      </section>
    ))}
  </div>
</figure>

<script>
  import { renderProgress } from "../stepper/step-progress";

  document.querySelectorAll<HTMLElement>("[data-store-differences]").forEach((root) => {
    if (root.dataset.ready !== undefined) return;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-step-scene]")];
    const scenes = [...root.querySelectorAll<HTMLElement>("[data-scene]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const controls = root.querySelector<HTMLElement>(":scope > [data-controls]");
    if (tabs.length === 0 || tabs.length !== scenes.length || !prev || !next || !progress || !controls) return;

    let current = 0;
    const select = (index: number) => {
      current = index;
      tabs.forEach((tab, tabIndex) => tab.setAttribute("aria-pressed", String(tabIndex === index)));
      scenes.forEach((scene, sceneIndex) => {
        scene.toggleAttribute("data-current", sceneIndex === index);
        scene.inert = sceneIndex !== index;
      });
      renderProgress(progress, index, scenes.length);
      prev.disabled = index === 0;
      next.disabled = index === scenes.length - 1;
    };

    tabs.forEach((tab, index) => tab.addEventListener("click", () => select(index)));
    prev.addEventListener("click", () => select(Math.max(current - 1, 0)));
    next.addEventListener("click", () => select(Math.min(current + 1, scenes.length - 1)));
    root.dataset.ready = "";
    controls.hidden = false;
    select(0);
  });
</script>

<style>
  .sd {
    min-width: 0;
    margin: 1rem 0;
  }

  .sd__bar {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-block-end: 0.5rem;
  }

  .sd[data-ready] .sd__bar {
    display: flex;
  }

  .sd__tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .sd__tab {
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .sd__tab[aria-pressed="true"] {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
  }

  .sd__tab[aria-pressed="true"]::before {
    content: "✓ ";
    color: var(--role-accent);
  }

  .sd__tab:focus-visible {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  .sd__scene + .sd__scene {
    margin-block-start: 1.25rem;
  }

  .sd__scene-title {
    margin: 0 0 0.375rem;
  }

  .sd[data-ready] .sd__scenes {
    display: grid;
  }

  .sd[data-ready] .sd__scene {
    grid-area: 1 / 1;
    margin-block-start: 0;
    visibility: hidden;
  }

  .sd[data-ready] .sd__scene[data-current] {
    visibility: visible;
  }

  .sd[data-ready] .sd__scene-title {
    display: none;
  }

  .sd__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .sd__code {
    min-width: 0;
    margin: 0;
  }

  .sd__code figcaption {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .sd__code figcaption strong {
    margin-inline-end: 0.5rem;
  }

  .sd__code figcaption code {
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .sd__code :global(pre) {
    margin: 0;
    padding: 0.5rem 0.75rem;
    overflow-x: hidden;
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .sd__code :global(pre code) {
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .sd__text {
    margin: 0.625rem 0 0;
    color: var(--role-text);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (max-height: 700px) {
    .sd__text {
      margin-block-start: 0.4rem;
      line-height: 1.5;
    }

    .sd__code :global(pre) {
      padding-block: 0.375rem;
    }
  }

  @media (max-width: 45rem) {
    .sd__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
