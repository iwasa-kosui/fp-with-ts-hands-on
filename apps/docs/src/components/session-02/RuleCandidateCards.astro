---
import StepControls from "../stepper/StepControls.astro";

type Candidate = Readonly<{
  kind: string;
  name: string;
  options?: string;
  sees: string;
  catches: readonly string[];
  misses: readonly string[];
}>;

const candidates: readonly Candidate[] = [
  {
    kind: "Linter の規則",
    name: "@typescript-eslint/switch-exhaustiveness-check",
    options: "considerDefaultExhaustiveForUnions",
    sees: "switch の case が、union の候補をすべて覆っているか",
    catches: [
      "false のとき: default があっても、足し忘れた case を検出する",
    ],
    misses: [
      "true のとき: default があると網羅とみなすので、「不明」を返す default はすり抜ける",
    ],
  },
  {
    kind: "Linter の規則",
    name: "no-restricted-syntax",
    options: "すべての default を禁止する規則",
    sees: "default という書き方",
    catches: [
      "すべての default",
      "前のページで書いた assertNever の default も検出する（誤検知）",
      "string を受け取る関数の、正しい default も検出する（誤検知）",
    ],
    misses: [
      "switch をやめて if の連なりで書いた「不明」",
    ],
  },
  {
    kind: "型のテスト",
    name: "// @ts-expect-error",
    sees: "その行が型エラーになるか",
    catches: [
      "引数が kind: string に戻り、知らない状態を渡せるようになる変更",
    ],
    misses: [
      "引数は Appointment のまま、default が「不明」を返す変更",
    ],
  },
];

const captions = [
  "規則は switch を見ます。considerDefaultExhaustiveForUnions の選び方で、default を残したコードの扱いが変わります。",
  "default を禁止する規則は、書き方だけを見ます。正しい default も、別の書き方の「不明」も区別しません。",
  "型のテストは、引数の型を見ます。分岐の中身は見ません。",
  "どの候補も、検出するものとすり抜けるものが違います。演習では、4件の悪い変更を検出できる組み合わせを、自分で選びます。",
] as const;
---

<figure class="cand" data-rule-candidates aria-label="default を残したときの、漏れを検出する候補の見比べ">
  <StepControls />

  <ul class="cand__cards">
    {candidates.map((candidate, index) => (
      <li class="cand__card" data-card={index}>
        <p class="cand__kind">{candidate.kind}</p>
        <p class="cand__name"><code>{candidate.name}</code></p>
        {candidate.options && <p class="cand__options"><code>{candidate.options}</code></p>}
        <div class="cand__row">
          <p class="cand__label">何を見るか</p>
          <p class="cand__text">{candidate.sees}</p>
        </div>
        <div class="cand__row" data-tone="positive">
          <p class="cand__label"><span aria-hidden="true">✓</span> 検出する</p>
          {candidate.catches.map((text) => <p class="cand__text">{text}</p>)}
        </div>
        <div class="cand__row" data-tone="negative">
          <p class="cand__label"><span aria-hidden="true">▲</span> すり抜ける</p>
          {candidate.misses.map((text) => <p class="cand__text">{text}</p>)}
        </div>
      </li>
    ))}
  </ul>

  <div aria-live="polite">
    <ol class="cand__frames">
      {captions.map((caption) => (
        <li data-frame>
          <p class="cand__caption">{caption}</p>
        </li>
      ))}
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-rule-candidates]").forEach((root) => {
    mountStepper({ root });
  });
</script>

<style>
  .cand {
    min-width: 0;
    margin: 0.5rem 0;
    color: var(--role-text);
  }

  .cand :global(.step-controls) {
    margin-block-end: 0.5rem;
  }

  .cand__cards {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .cand__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .cand__card {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    margin: 0;
    padding: 0.375rem 0.625rem 0.5rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .cand__card p {
    margin: 0;
  }

  .cand__kind {
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .cand__name {
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .cand__name code,
  .cand__options code {
    font-size: inherit;
  }

  .cand__options {
    color: var(--role-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .cand__row {
    display: grid;
    gap: 0.125rem;
    padding-inline-start: 0.5rem;
    border-inline-start: 0.25rem solid var(--role-border);
  }

  .cand__row[data-tone="positive"] {
    border-inline-start-color: var(--role-positive);
  }

  .cand__row[data-tone="negative"] {
    border-inline-start-color: var(--role-negative);
  }

  .cand__label {
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .cand__row[data-tone="positive"] .cand__label {
    color: var(--role-positive);
  }

  .cand__row[data-tone="negative"] .cand__label {
    color: var(--role-negative);
  }

  .cand__text {
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .cand__frames {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.5rem;
  }

  .cand__frames > li + li {
    margin-block-start: 0.5rem;
  }

  .cand__caption {
    margin: 0;
    font-weight: 700;
    line-height: 1.7;
  }

  .cand[data-ready] .cand__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .cand[data-ready] .cand__frames > li {
    grid-area: 1 / 1;
  }

  .cand[data-ready] .cand__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .cand[data-ready] .cand__card {
    transition: border-color 0.3s;
  }

  .cand[data-ready][data-step="0"] .cand__card:not([data-card="0"]),
  .cand[data-ready][data-step="1"] .cand__card:not([data-card="1"]),
  .cand[data-ready][data-step="2"] .cand__card:not([data-card="2"]) {
    border-style: dashed;
  }

  .cand[data-ready][data-step="0"] .cand__card[data-card="0"],
  .cand[data-ready][data-step="1"] .cand__card[data-card="1"],
  .cand[data-ready][data-step="2"] .cand__card[data-card="2"] {
    border-color: var(--role-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .cand[data-ready] .cand__card {
      transition: none;
    }
  }
</style>
