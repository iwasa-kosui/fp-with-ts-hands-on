---
import { Code } from "astro:components";
import StepControls from "../stepper/StepControls.astro";
import { frames, remainingOf } from "./never-switch-frames";

const segments = (text: string) => text.split("`").map((part, index) => ({ part, code: index % 2 === 1 }));
const wasDone = (frameIndex: number, name: string) => frames[frameIndex - 1]?.cards.some((card) => card.name === name && card.done) ?? false;
const isNewCard = (frameIndex: number, name: string) =>
  frameIndex > 0 && !(frames[frameIndex - 1]?.cards.some((card) => card.name === name) ?? false);
---

<figure
  class="nv"
  data-never-switch
  data-step-figure
  aria-label="switch 文の case を処理するたびに、default に残る候補が減って0個になる図"
>
  <StepControls />

  <div aria-live="polite">
    <ol class="nv__frames">
      {
        frames.map((frame, frameIndex) => {
          const empty = remainingOf(frame).length === 0;
          return (
            <li
              data-frame
              data-lit={JSON.stringify(frame.lit)}
              data-negative={JSON.stringify(frame.negative)}
              data-dim-after={frame.dimAfter}
            >
              <div class="nv__main">
                <figure class="code-block nv__code">
                  <Code code={frame.code} lang="ts" />
                </figure>
                <div class="nv__side">
                  <div class:list={["nv__box", { "nv__box--empty": empty }]}>
                    <p class="nv__title"><code>default</code> に残る候補</p>
                    <ul class="nv__cards">
                      {frame.cards.map((card) => (
                        <li
                          class:list={["nv__card", { "nv__card--done": card.done }]}
                          aria-label={card.done ? `"${card.name}" 処理済み` : undefined}
                          data-new={card.done && !wasDone(frameIndex, card.name) ? "" : undefined}
                          data-appear={isNewCard(frameIndex, card.name) ? "" : undefined}
                          data-forgotten={card.forgotten ? "" : undefined}
                        >
                          <code>{`"${card.name}"`}</code>
                          {card.forgotten && <span class="nv__missing">case なし</span>}
                        </li>
                      ))}
                    </ul>
                    {empty && <p class="nv__empty"><span aria-hidden="true">∅</span> 空</p>}
                    <p class="nv__count">
                      {remainingOf(frame).length}個
                      {frame.showNever && <> = <code>never</code></>}
                    </p>
                  </div>
                  {frame.verdict && (
                    <p class:list={["nv__verdict", `nv__verdict--${frame.verdict.kind}`]}>
                      <span>{frame.verdict.label}</span>
                      {frame.verdict.kind === "error" && <code>{frame.verdict.message}</code>}
                    </p>
                  )}
                </div>
              </div>
              <p class="nv__caption">
                {segments(frame.caption).map(({ part, code }) => (code ? <code>{part}</code> : part))}
              </p>
            </li>
          );
        })
      }
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  const indexes = (text: string | undefined) => JSON.parse(text ?? "[]") as number[];

  document.querySelectorAll<HTMLElement>("[data-never-switch]").forEach((root) => {
    root.querySelectorAll<HTMLElement>("[data-frame]").forEach((frame) => {
      const lit = indexes(frame.dataset.lit);
      const negative = indexes(frame.dataset.negative);
      const dimAfter = frame.dataset.dimAfter === undefined ? undefined : Number(frame.dataset.dimAfter);
      const forgotten = frame.querySelector<HTMLElement>("[data-forgotten] code")?.textContent;
      frame.querySelectorAll<HTMLElement>(".line").forEach((line, index) => {
        line.classList.toggle("is-lit", lit.includes(index));
        line.classList.toggle("is-negative", negative.includes(index));
        line.classList.toggle("is-dim", dimAfter !== undefined && index > dimAfter);
      });
      if (forgotten) {
        frame.querySelectorAll<HTMLElement>(".line")[0]?.querySelectorAll<HTMLElement>("span").forEach((span) => {
          if (span.textContent?.trim() === forgotten) span.classList.add("is-emphasis");
        });
      }
    });
    mountStepper({ root });
  });
</script>

<style>
  .nv {
    min-width: 0;
    margin: 0.5rem 0;
    color: var(--role-text);
  }

  .nv :global(.step-controls) {
    margin-block-end: 0.5rem;
  }

  .nv__frames {
    margin: 0;
    padding-inline-start: 1.5rem;
  }

  .nv__frames > li + li {
    margin-block-start: 1rem;
  }

  .nv[data-ready] .nv__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .nv[data-ready] .nv__frames > li {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .nv[data-ready] .nv__frames > li + li {
    margin-block-start: 0;
  }

  .nv[data-ready] .nv__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .nv__main {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: start;
  }

  .nv__code {
    min-width: 0;
    margin: 0;
  }

  .nv__code :global(pre) {
    margin: 0;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .nv__code :global(code) {
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .nv__code :global(.line) {
    display: inline-block;
    min-width: 100%;
    padding-inline: 0.75rem;
  }

  .nv__code :global(.line.is-lit) {
    background: color-mix(in srgb, var(--frame-code-text, var(--role-surface)) 18%, transparent);
    box-shadow: inset 5px 0 0 color-mix(in srgb, var(--role-accent) 55%, var(--role-surface));
  }

  .nv__code :global(.line.is-negative) {
    background: color-mix(in srgb, var(--role-negative) 30%, transparent);
    box-shadow: inset 5px 0 0 var(--role-negative);
  }

  .nv__code :global(.line.is-dim) {
    opacity: 0.45;
  }

  .nv__code :global(.line .is-emphasis) {
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--role-accent) 55%, transparent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--role-accent) 55%, transparent);
    font-weight: 800;
  }

  .nv__side {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .nv__side p {
    margin: 0;
  }

  .nv__box {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 3px solid var(--role-border);
    border-radius: 1rem;
    background: var(--role-surface);
  }

  .nv__box--empty {
    border-color: var(--role-positive);
    border-style: dashed;
  }

  .nv__title {
    color: var(--role-muted);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .nv__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nv__card {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0 0.5rem;
    min-width: 0;
    min-height: 2.125rem;
    margin: 0;
    padding: 0 0.5rem;
    border: 2px solid var(--role-accent);
    border-radius: 999px;
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .nv__missing {
    color: var(--role-negative);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .nv__card--done {
    border-color: var(--role-border);
    border-style: dashed;
    color: var(--role-muted);
  }

  .nv__card--done code {
    text-decoration: line-through;
  }

  .nv__empty {
    color: var(--role-positive);
    font-size: 1rem;
    font-weight: 800;
    text-align: center;
  }

  .nv__empty span {
    font-size: 1.375rem;
    line-height: 1;
  }

  .nv__count {
    font-size: 1.125rem;
    font-weight: 800;
    text-align: center;
  }

  .nv__verdict {
    display: grid;
    gap: 0.125rem;
    padding: 0.375rem 0.625rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.45;
  }

  .nv__verdict--ok {
    border-color: var(--role-positive);
    background: color-mix(in srgb, var(--role-positive) 12%, var(--role-surface));
    color: var(--role-positive);
  }

  .nv__verdict--error {
    border-color: var(--role-negative);
    background: color-mix(in srgb, var(--role-negative) 12%, var(--role-surface));
    color: var(--role-negative);
  }

  .nv__verdict code {
    font-size: 0.8125rem;
    font-weight: 700;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .nv__caption {
    margin: 0.5rem 0 0;
    font-weight: 700;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nv[data-ready] .nv__frames > li:not([hidden]) .nv__card[data-new] {
      animation: nv-fade 0.5s ease-out both;
    }

    .nv[data-ready] .nv__frames > li:not([hidden]) .nv__empty {
      animation: nv-appear 0.4s ease-out 0.2s both;
    }

    .nv[data-ready] .nv__frames > li:not([hidden]) .nv__card[data-appear],
    .nv[data-ready] .nv__frames > li:not([hidden]) .nv__verdict--error {
      animation: nv-fade-in 0.4s ease-out both;
    }

    @keyframes nv-fade-in {
      from {
        opacity: 0;
      }
    }

    @keyframes nv-fade {
      from {
        border-color: var(--role-accent);
        border-style: solid;
        color: var(--role-text);
      }
    }

    @keyframes nv-appear {
      from {
        opacity: 0;
        transform: scale(0.85);
      }
    }
  }

  @media (max-width: 44rem) {
    .nv__main {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-height: 700px) {
    .nv {
      margin-block: 0.25rem;
    }

    .nv :global(.step-controls) {
      margin-block-end: 0.25rem;
    }

    .nv__code :global(pre) {
      padding-block: 0.25rem;
      line-height: 1.3;
    }

    .nv__box {
      gap: 0.25rem;
      padding-block: 0.375rem;
    }

    .nv__card {
      min-height: 1.875rem;
    }

    .nv__count {
      font-size: 1rem;
    }

    .nv__caption {
      margin-block-start: 0.25rem;
      line-height: 1.5;
    }
  }
</style>
