---
const groups = [
  {
    id: "machine",
    mark: "✓",
    title: "機械で止めるもの",
    lead: "CI などに組み込むと、変更のたびに報告されます。",
    cards: [
      {
        what: "case が足りない分岐",
        by: "assertNever の引数の型 never による型検査と、switch を検査する Linter の規則",
      },
      {
        what: "default が「不明」を返して、足し忘れを隠す書き方",
        by: "considerDefaultExhaustiveForUnions を false にした Linter の規則",
      },
      {
        what: "引数が kind: string に戻り、知らない状態を渡せる変更",
        by: "// @ts-expect-error を使った型のテスト",
      },
    ],
  },
  {
    id: "human",
    mark: "▲",
    title: "人が確かめるもの",
    lead: "仕組みでは検出できないので、人が読んで確かめます。",
    cards: [
      {
        what: "分岐の中身が業務として正しいか（表示名の正しさなど）",
        by: "型は、書いた分岐のとおりに守るだけです。NoShow の表示名が、受付に伝わる文言かは分かりません。",
      },
      {
        what: "自分の仕組みをすり抜ける、新しい種類の変更",
        by: "相互レビューで見つけたすり抜けが、その例です。",
      },
    ],
  },
] as const;
---

<div class="guard-cards">
  {groups.map((group) => (
    <section class="guard-cards__group" data-group={group.id}>
      <p class="guard-cards__title"><span aria-hidden="true">{group.mark}</span> {group.title}</p>
      <p class="guard-cards__lead">{group.lead}</p>
      <ul>
        {group.cards.map((card) => (
          <li>
            <p class="guard-cards__what">{card.what}</p>
            <p class="guard-cards__by">{card.by}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .guard-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.5rem 0;
  }

  .guard-cards__group {
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
  }

  .guard-cards__group[data-group="machine"] {
    border-color: var(--role-positive);
  }

  .guard-cards__group[data-group="human"] {
    border-color: var(--role-negative);
    border-style: dashed;
  }

  .guard-cards__title {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .guard-cards__group[data-group="machine"] .guard-cards__title {
    color: var(--role-positive);
  }

  .guard-cards__group[data-group="human"] .guard-cards__title {
    color: var(--role-negative);
  }

  .guard-cards__lead {
    margin: 0 0 0.5rem;
    color: var(--role-muted);
    font-size: 0.8125rem;
  }

  ul {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.25rem 0.5rem;
    border-inline-start: 0.375rem solid var(--role-border);
  }

  [data-group="machine"] li {
    border-inline-start-color: var(--role-positive);
  }

  [data-group="human"] li {
    border-inline-start-color: var(--role-negative);
  }

  p {
    margin: 0;
  }

  .guard-cards__what {
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .guard-cards__by {
    color: var(--role-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-width: 55rem) {
    .guard-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
