---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";

type Snippet = Readonly<{
  code: string;
  solution: Readonly<{ path: string; lines: readonly [number, number] }>;
}>;
type Props = Readonly<{
  code: Readonly<{
    port: Snippet;
    dependencies: Snippet;
    secondary: Snippet;
    assembly: Snippet;
    route: Snippet;
  }>;
}>;

const { code } = Astro.props;

const title = "ポートとアダプタで層を分ける";

type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const KEY_MARK = /\s*\/\/ \[!ports-key\]$/;
const withMarks = (source: string, keyLines: readonly number[]) =>
  source.split("\n").map((text, index) => (keyLines.includes(index + 1) ? `${text} // [!ports-key]` : text)).join("\n");
const markKeyLines: Transformer = {
  name: "mark-ports-key-lines",
  preprocess(source) {
    const lines = source.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((text, index) => (KEY_MARK.test(text) ? [index + 1] : []));
    return lines.map((text) => text.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "ports-flow__key");
  },
};

type Emphasis = "normal" | "dim" | "focus";
type Frame = Readonly<{
  caption: string;
  code?: Readonly<{ key: keyof typeof code; lines: readonly number[] }>;
  nodes: "normal" | "dim";
  focus: readonly string[];
  calls: Emphasis;
  imports: Emphasis;
  token: boolean;
}>;

const frames: readonly Frame[] = [
  {
    caption:
      "Final のコードは、内側（domain と useCase）と外側（adaptor）に分かれます。adaptor/primary は外から依頼を受ける側、adaptor/secondary はユースケースが外へ頼む先です。",
    nodes: "normal",
    focus: [],
    calls: "normal",
    imports: "normal",
    token: false,
  },
  {
    caption:
      "port は参照実装では domain に置いた型です。S06 では useCase に置きました。S00 では adaptor/secondary/sqlite に置いていました。どちらでも、外側の実装を知らないことが大事です。ExaminationStartedStore は、ExaminationStarted を受け取って ResultAsync を返すことだけを決めます。",
    code: { key: "port", lines: [2, 6] },
    nodes: "dim",
    focus: ["domain"],
    calls: "dim",
    imports: "dim",
    token: false,
  },
  {
    caption: "ユースケースは、依存を port の型で受け取ります。どの実装が渡されるかは知りません。",
    code: { key: "dependencies", lines: [4] },
    nodes: "dim",
    focus: ["useCase"],
    calls: "dim",
    imports: "dim",
    token: false,
  },
  {
    caption:
      "adaptor/secondary の createAppointmentEventStore は、port の型を満たす実装を返します。データベース（SQLite）を扱うコードは、この層にだけあります。",
    code: { key: "secondary", lines: [1, 5] },
    nodes: "dim",
    focus: ["secondary"],
    calls: "dim",
    imports: "dim",
    token: false,
  },
  {
    caption: "app.ts が実装を作り、ユースケースへ渡します。S06 で見た注入です。",
    code: { key: "assembly", lines: [1, 4] },
    nodes: "dim",
    focus: ["app"],
    calls: "dim",
    imports: "dim",
    token: false,
  },
  {
    caption:
      "実行時は、route がユースケースを呼びます。ユースケースは domain の関数で判断し、保存は port の型を通して SQLite の store に頼みます。呼び出しは外側まで届きます。",
    code: { key: "route", lines: [1, 2] },
    nodes: "dim",
    focus: ["primary", "useCase", "domain", "secondary"],
    calls: "focus",
    imports: "dim",
    token: true,
  },
  {
    caption:
      "import の矢印はすべて内側を向きます。app.ts が domain、useCase、adaptor を import して組み立てます。domain と useCase は adaptor を import しないので、テストでは偽の実装を渡せます。",
    nodes: "normal",
    focus: [],
    calls: "dim",
    imports: "focus",
    token: false,
  },
];

const rangeLabel = ({ solution }: Snippet) => `${solution.path}:${solution.lines[0]}-${solution.lines[1]}`;

const playerData = JSON.stringify(frames.map(({ caption, nodes, focus, calls, imports, token }) => ({ caption, nodes, focus, calls, imports, token })));
---

<div class="ports-flow" data-ports-flow data-frames={playerData} role="group" aria-label={title}>
  <div class="ports-flow__stage">
    <div class="ports-flow__sticky">
      <div class="ports-flow__controls" data-controls hidden>
        <button type="button" data-first disabled>最初へ</button>
        <button type="button" data-prev disabled>← 前のコマ</button>
        <span data-progress>1 / {frames.length}</span>
        <button type="button" data-next>次のコマ →</button>
      </div>

      <p class="ports-flow__live" data-live aria-live="polite" hidden></p>
    </div>

    <svg viewBox="0 0 240 458" role="img" aria-labelledby="ports-flow-title ports-flow-desc" data-nodes="normal" data-calls="normal" data-imports="normal">
      <title id="ports-flow-title">{title}</title>
      <desc id="ports-flow-desc">
        「外側（adaptor）」と書かれた外側の枠の中に、上から primary（Hono の route）の箱、内側の枠、secondary（SQLite の store）の箱が並びます。内側の枠の中には useCase の箱があり、その中に domain（port の型）の箱があります。app.ts（組み立て）の箱は、外側の枠の外の下にあります。実線の矢印は呼び出しを表し、3本あります。primary から useCase へ、useCase から domain の port へ、useCase から secondary へ向かいます。useCase から secondary への矢印は、domain の箱の外側を通り、port の型を通す呼び出しです。破線の矢印は import を表し、6本あります。primary から useCase へ、secondary から domain へ、useCase から domain へ、app.ts から primary へ、app.ts から useCase へ、app.ts から secondary へ向かいます。import の矢印はすべて、外側から内側を向きます。
      </desc>
      <defs>
        <marker id="ports-flow-head-call" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="userSpaceOnUse">
          <path d="M 0 0 L 8 4 L 0 8 z" class="ports-flow__head ports-flow__head--call"></path>
        </marker>
        <marker id="ports-flow-head-import" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="userSpaceOnUse">
          <path d="M 0 0 L 8 4 L 0 8 z" class="ports-flow__head ports-flow__head--import"></path>
        </marker>
      </defs>

      <rect x="4" y="4" width="232" height="348" rx="12" class="ports-flow__frame ports-flow__frame--outer"></rect>
      <text x="120" y="25" text-anchor="middle" class="ports-flow__text ports-flow__text--bold">外側（adaptor）</text>
      <rect x="26" y="104" width="188" height="156" rx="10" class="ports-flow__frame"></rect>
      <text x="120" y="123" text-anchor="middle" class="ports-flow__text ports-flow__text--bold">内側</text>

      <g class="ports-flow__node ports-flow__dimmable" data-node="useCase">
        <rect x="40" y="132" width="160" height="116" rx="8" class="ports-flow__shape ports-flow__shape--usecase"></rect>
        <text x="120" y="152" text-anchor="middle" class="ports-flow__text ports-flow__mono">useCase</text>
      </g>
      <g class="ports-flow__node ports-flow__dimmable" data-node="domain">
        <rect x="56" y="180" width="128" height="56" rx="6" class="ports-flow__shape"></rect>
        <text x="120" y="203" text-anchor="middle" class="ports-flow__text ports-flow__mono">domain</text>
        <text x="120" y="224" text-anchor="middle" class="ports-flow__text">（port の型）</text>
      </g>
      <g class="ports-flow__node ports-flow__dimmable" data-node="primary">
        <rect x="40" y="36" width="160" height="54" rx="6" class="ports-flow__shape"></rect>
        <text x="120" y="57" text-anchor="middle" class="ports-flow__text ports-flow__mono">primary</text>
        <text x="120" y="77" text-anchor="middle" class="ports-flow__text">Hono の route</text>
      </g>
      <g class="ports-flow__node ports-flow__dimmable" data-node="secondary">
        <rect x="40" y="284" width="160" height="54" rx="6" class="ports-flow__shape"></rect>
        <text x="120" y="305" text-anchor="middle" class="ports-flow__text ports-flow__mono">secondary</text>
        <text x="120" y="325" text-anchor="middle" class="ports-flow__text">SQLite の store</text>
      </g>
      <g class="ports-flow__node ports-flow__dimmable" data-node="app">
        <rect x="36" y="374" width="168" height="36" rx="6" class="ports-flow__shape"></rect>
        <text x="120" y="397" text-anchor="middle" class="ports-flow__text"><tspan class="ports-flow__mono">app.ts</tspan>（組み立て）</text>
      </g>

      <g class="ports-flow__imports">
        <path d="M 150 90 V 132" class="ports-flow__line ports-flow__line--import" marker-end="url(#ports-flow-head-import)"></path>
        <path d="M 180 284 V 236" class="ports-flow__line ports-flow__line--import" marker-end="url(#ports-flow-head-import)"></path>
        <path d="M 160 156 V 180" class="ports-flow__line ports-flow__line--import" marker-end="url(#ports-flow-head-import)"></path>
        <path d="M 36 392 H 15 V 63 H 40" class="ports-flow__line ports-flow__line--import" marker-end="url(#ports-flow-head-import)"></path>
        <path d="M 120 374 V 338" class="ports-flow__line ports-flow__line--import" marker-end="url(#ports-flow-head-import)"></path>
        <path d="M 204 404 H 225 V 206 H 200" class="ports-flow__line ports-flow__line--import" marker-end="url(#ports-flow-head-import)"></path>
      </g>
      <g class="ports-flow__calls">
        <path d="M 48 90 V 132" class="ports-flow__line ports-flow__line--call" marker-end="url(#ports-flow-head-call)"></path>
        <path d="M 80 156 V 180" class="ports-flow__line ports-flow__line--call" marker-end="url(#ports-flow-head-call)"></path>
        <path d="M 48 156 V 284" class="ports-flow__line ports-flow__line--call" marker-end="url(#ports-flow-head-call)"></path>
      </g>
      <text x="56" y="277" class="ports-flow__text ports-flow__note">port の型を通す</text>
      <path d="M 48 90 V 284" class="ports-flow__track" data-track data-stops="0,42,194"></path>
      <circle r="8" class="ports-flow__token" data-token data-hidden></circle>

      <g class="ports-flow__legend">
        <path d="M 10 426 H 42" class="ports-flow__line ports-flow__line--call" marker-end="url(#ports-flow-head-call)"></path>
        <text x="50" y="431" class="ports-flow__text">実線 ＝ 呼び出し</text>
        <path d="M 10 446 H 42" class="ports-flow__line ports-flow__line--import" marker-end="url(#ports-flow-head-import)"></path>
        <text x="50" y="451" class="ports-flow__text">破線 ＝ import</text>
      </g>
    </svg>

    <ol class="ports-flow__frames">
      {frames.map((frame) => (
        <li data-frame data-has-code={frame.code ? "" : undefined}>
          <p class="ports-flow__caption">{frame.caption}</p>
          {frame.code && (
            <figure class="code-block ports-flow__code">
              <figcaption><code>{rangeLabel(code[frame.code.key])}</code></figcaption>
              <Code code={withMarks(code[frame.code.key].code, frame.code.lines)} lang="typescript" defaultColor="dark" wrap={null} transformers={[markKeyLines]} />
            </figure>
          )}
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  type Emphasis = "normal" | "dim" | "focus";
  type Frame = { caption: string; nodes: "normal" | "dim"; focus: string[]; calls: Emphasis; imports: Emphasis; token: boolean };

  const MOVE_MS = 700;
  const PAUSE_MS = 500;
  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

  const setUp = (root: HTMLElement) => {
    if (root.dataset.ready !== undefined) return;
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const svg = root.querySelector<SVGSVGElement>("svg");
    const nodes = [...root.querySelectorAll<SVGGElement>("[data-node]")];
    const track = root.querySelector<SVGPathElement>("[data-track]");
    const token = root.querySelector<SVGCircleElement>("[data-token]");
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const first = root.querySelector<HTMLButtonElement>("[data-first]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    if (!svg || !track || !token || !controls || !first || !prev || !next || !progress || !live || frames.length !== panels.length) return;
    root.dataset.ready = "";

    let frameId = 0;
    const stopToken = () => {
      cancelAnimationFrame(frameId);
      token.toggleAttribute("data-hidden", true);
    };
    const runToken = () => {
      cancelAnimationFrame(frameId);
      const stops = (track.dataset.stops ?? "").split(",").map(Number);
      const startedAt = performance.now();
      const place = (distance: number) => {
        const { x, y } = track.getPointAtLength(distance);
        token.setAttribute("transform", `translate(${x} ${y})`);
      };
      place(stops[0] ?? 0);
      token.removeAttribute("data-hidden");
      const tick = (now: number) => {
        const elapsed = now - startedAt;
        const segment = Math.floor(elapsed / (PAUSE_MS + MOVE_MS));
        if (segment >= stops.length - 1) {
          place(stops[stops.length - 1]);
          return;
        }
        const moving = elapsed - segment * (PAUSE_MS + MOVE_MS) - PAUSE_MS;
        const ratio = easeInOut(Math.min(Math.max(moving / MOVE_MS, 0), 1));
        place(stops[segment] + (stops[segment + 1] - stops[segment]) * ratio);
        frameId = requestAnimationFrame(tick);
      };
      frameId = requestAnimationFrame(tick);
    };

    let current: number | null = null;
    const show = (index: number) => {
      const frame = frames[index];
      current = index;
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));
      svg.dataset.nodes = frame.nodes;
      svg.dataset.calls = frame.calls;
      svg.dataset.imports = frame.imports;
      nodes.forEach((node) => node.toggleAttribute("data-focus", frame.focus.includes(node.dataset.node ?? "")));
      if (frame.token) runToken();
      else stopToken();
      live.textContent = frame.caption;
      progress.textContent = `${index + 1} / ${frames.length}`;
      first.disabled = index === 0;
      prev.disabled = index === 0;
      next.disabled = index === frames.length - 1;
    };

    first.addEventListener("click", () => show(0));
    prev.addEventListener("click", () => show(Math.max((current ?? 0) - 1, 0)));
    next.addEventListener("click", () => show(Math.min((current ?? 0) + 1, frames.length - 1)));

    root.dataset.animated = "";
    controls.hidden = false;
    live.hidden = false;
    show(0);
  };

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-ports-flow]").forEach(setUp);
  }
</script>

<style>
  .ports-flow {
    min-width: 0;
    max-width: 100%;
    margin: 1.5rem 0;
    container-type: inline-size;
  }

  .ports-flow svg {
    display: block;
    width: 100%;
    max-width: 16.5rem;
    height: auto;
    margin-inline: auto;
  }

  .ports-flow__frame {
    fill: var(--case-paper);
    stroke: var(--case-muted);
    stroke-width: 2;
  }

  .ports-flow__frame--outer {
    fill: none;
  }

  .ports-flow__text {
    fill: var(--case-ink);
    font-size: 15px;
  }

  .ports-flow__text--bold {
    font-weight: 700;
  }

  .ports-flow__mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .ports-flow__shape {
    fill: var(--case-cream);
    stroke: var(--case-line);
    stroke-width: 1.5;
  }

  .ports-flow__shape--usecase {
    fill: var(--case-paper);
  }

  .ports-flow__node[data-focus] .ports-flow__shape {
    fill: var(--case-yellow);
    stroke-width: 3.5;
  }

  .ports-flow__line {
    fill: none;
    stroke-width: 1.5;
  }

  .ports-flow__line--call {
    stroke: var(--case-line);
  }

  .ports-flow__line--import {
    stroke: var(--case-blue);
    stroke-dasharray: 5 4;
  }

  .ports-flow__head--call {
    fill: var(--case-line);
  }

  .ports-flow__head--import {
    fill: var(--case-blue);
  }

  .ports-flow__track {
    fill: none;
    stroke: none;
  }

  .ports-flow__note {
    fill: var(--role-text);
    font-size: 15px;
    paint-order: stroke;
    stroke: var(--role-surface);
    stroke-width: 4px;
  }

  .ports-flow__token {
    fill: var(--case-yellow);
    stroke: var(--case-line);
    stroke-width: 2;
  }

  .ports-flow__token[data-hidden] {
    display: none;
  }

  .ports-flow__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .ports-flow__controls[hidden] {
    display: none;
  }

  .ports-flow__controls button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--case-yellow);
    color: var(--case-ink);
    cursor: pointer;
    font-weight: 700;
  }

  .ports-flow__controls button:disabled {
    background: var(--case-paper);
    cursor: not-allowed;
    opacity: 0.55;
  }

  .ports-flow__live,
  .ports-flow__caption {
    margin: 0.75rem 0 0.5rem;
    font-weight: 700;
    line-height: 1.7;
  }

  .ports-flow__frames {
    margin: 0;
    padding-inline-start: 1.5rem;
  }

  .ports-flow__frames > li {
    min-width: 0;
  }

  .ports-flow__frames > li + li {
    margin-top: 1.25rem;
  }

  .ports-flow__code {
    min-width: 0;
    margin: 0.5rem 0 0;
    border-inline-start: 0.35rem solid var(--case-blue);
  }

  .ports-flow__code figcaption code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .ports-flow__code :global(pre) {
    max-width: 100%;
    margin: 0;
    overflow-x: auto;
    font-size: 0.8rem;
  }

  .ports-flow__code :global(pre code) {
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  [data-animated] .ports-flow__code :global(pre) {
    max-height: 10rem;
    overflow-y: auto;
  }

  .ports-flow :global(.ports-flow__key) {
    display: inline-block;
    min-width: calc(100% + 0.5rem);
    margin-left: -0.5rem;
    padding-left: 0.5rem;
    background: rgb(255 210 27 / 7%);
    box-shadow: inset 0.3rem 0 0 #ffd21b;
  }

  .ports-flow :global(.ports-flow__key span[style*="#6A737D"]) {
    color: #e1e4e8 !important;
  }

  [data-animated] .ports-flow__sticky {
    position: sticky;
    top: calc(var(--case-scroll-offset, 1.5rem) - 1.5rem);
    z-index: 2;
    display: grid;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 2px solid var(--case-line);
    background: var(--case-paper);
  }

  [data-animated] .ports-flow__live {
    margin: 0;
  }

  [data-animated] .ports-flow__frames {
    padding-inline-start: 0;
    list-style: none;
  }

  [data-animated] .ports-flow__frames > li {
    display: none;
    margin: 0;
  }

  [data-animated] .ports-flow__frames > li.is-current[data-has-code] {
    display: block;
  }

  [data-animated] .ports-flow__caption {
    display: none;
  }

  [data-animated] .ports-flow__line {
    transition: opacity 0.3s, stroke-width 0.3s;
  }

  [data-animated] .ports-flow__shape {
    transition: opacity 0.3s;
  }

  [data-animated] svg[data-nodes="dim"] .ports-flow__node:not([data-focus]) .ports-flow__shape {
    opacity: 0.3;
  }

  [data-animated] .ports-flow__note {
    transition: opacity 0.3s;
  }

  [data-animated] svg:not([data-calls="focus"]) .ports-flow__note {
    opacity: 0;
  }

  [data-animated] svg[data-calls="dim"] .ports-flow__calls {
    opacity: 0.25;
  }

  [data-animated] svg[data-calls="focus"] .ports-flow__calls .ports-flow__line {
    stroke-width: 3.5;
  }

  [data-animated] svg[data-imports="dim"] .ports-flow__imports {
    opacity: 0.25;
  }

  [data-animated] svg[data-imports="focus"] .ports-flow__imports .ports-flow__line {
    stroke-width: 3.5;
  }

  @container (max-width: 34rem) {
    [data-animated] .ports-flow__controls {
      flex-wrap: nowrap;
      gap: 0.4rem;
    }

    [data-animated] .ports-flow__controls button {
      padding: 0 0.6rem;
    }

    [data-animated] .ports-flow__live {
      font-size: 0.85rem;
      line-height: 1.5;
    }
  }

  @container (min-width: 44rem) {
    [data-animated] .ports-flow__stage {
      display: grid;
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      column-gap: 1.25rem;
      align-items: start;
    }

    [data-animated] .ports-flow__sticky {
      display: contents;
    }

    [data-animated] .ports-flow__controls {
      grid-column: 1 / -1;
      margin-bottom: 0.75rem;
    }

    [data-animated] svg {
      grid-column: 1;
      grid-row: 2 / span 2;
      max-width: 12.25rem;
    }

    [data-animated] .ports-flow__live {
      grid-column: 2;
      grid-row: 2;
      margin-bottom: 0.5rem;
    }

    [data-animated] .ports-flow__frames {
      grid-column: 2;
      grid-row: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animated] * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
