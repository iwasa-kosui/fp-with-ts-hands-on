---
import { Code } from "astro:components";

const shape = `const schema = /* 境界で確かめること */;

export type X = z.infer<typeof schema>; // 内側の型

export const X = {
  schema,
  parse: schemaResult(schema), // 外側の unknown を受け取る
} as const;`;

const rows = [
  {
    name: "診察開始の入力",
    scope: "今回の演習",
    outside: "HTTP の path と body",
    check: "予約IDと担当獣医師IDが UUID の形か",
    inside: "StartExaminationInput",
    path: "examples/session-05/src/boundary/startExaminationInput.ts",
  },
  {
    name: "支払金額",
    scope: "完成形のコード",
    outside: "入力された金額",
    check: "1以上の整数か",
    inside: "PaymentAmount",
    path: "examples/final/src/domain/appointment/paymentAmount.ts",
  },
  {
    name: "検査結果",
    scope: "時間外の補足",
    outside: "検査機関から届く JSON",
    check: "examId、petId、items、needsFollowUp の形",
    inside: "ExamResult",
    path: "examples/session-05/src/boundary/examResult.ts",
  },
  {
    name: "飼い主の連絡先",
    scope: "時間外の補足",
    outside: "氏名、メール、電話番号の文字列",
    check: "空でないか、メールの形か",
    inside: "OwnerContact（中身は Sensitive）",
    path: "examples/session-05/src/boundary/ownerContact.ts",
  },
] as const;
---

<div class="boundary-patterns" data-boundary-patterns>
  <table>
    <thead>
      <tr>
        <th scope="col">扱う値</th>
        <th scope="col" data-zone="outside">外側の姿</th>
        <th scope="col" data-zone="boundary">境界で確かめること</th>
        <th scope="col" data-zone="inside">内側の型</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">
            {row.name}
            <small>{row.scope}</small>
          </th>
          <td data-zone="outside" data-label="外側の姿">{row.outside}</td>
          <td data-zone="boundary" data-label="境界で確かめること">{row.check}</td>
          <td data-zone="inside" data-label="内側の型"><code>{row.inside}</code></td>
        </tr>
      ))}
    </tbody>
  </table>
  <figure class="code-block">
    <figcaption>4つに共通する形（説明のために中身を省き、型の名前を X にしています）</figcaption>
    <Code code={shape} lang="ts" />
  </figure>
  <p>実物のコードは次の4つです。</p>
  <ul>
    {rows.map((row) => <li><code>{row.path}</code></li>)}
  </ul>
</div>

<style>
  .boundary-patterns {
    margin-block: 1rem 1.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--case-line);
    text-align: start;
    vertical-align: top;
  }

  small {
    display: block;
    color: var(--case-muted);
    font-weight: 400;
  }

  [data-zone="outside"] {
    background: #f1f0e8;
  }

  [data-zone="boundary"] {
    background: var(--case-cream);
  }

  [data-zone="inside"] {
    background: #e2f9f3;
  }

  ul {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding-inline-start: 1.25rem;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
  }

  p {
    margin: 0.75rem 0 0.25rem;
  }

  @media (max-width: 767px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    tr {
      margin-block-end: 0.75rem;
    }

    td {
      border-block-start: 0;
    }

    td::before {
      display: block;
      color: var(--case-muted);
      content: attr(data-label);
      font-size: 0.75rem;
    }
  }
</style>
