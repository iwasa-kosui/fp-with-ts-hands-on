---
import { stages, type StageId } from "../../sessions/overview-map";
import StepControls from "../stepper/StepControls.astro";

type Problem = Readonly<{ number: number; text: string; tag?: string }>;

const problems: Readonly<Record<StageId, readonly Problem[]>> = {
  entry: [
    { number: 3, text: "予約、動物、飼い主、獣医師の ID を、どれも同じ文字列として扱っている" },
    { number: 4, text: "外から届く診察結果を、検査せずに受け取っている" },
  ],
  read: [],
  decide: [
    { number: 1, text: "予約の状態を、どんな文字列でも入る形で持ち、操作の前に確かめていない", tag: "課題1" },
    { number: 2, text: "状態ごとの情報を、どの状態でも空にできる項目で持っている" },
  ],
  save: [
    { number: 5, text: "飼い主の連絡先を監査記録に残している", tag: "課題2" },
    { number: 7, text: "時刻と監査記録の ID を、処理の中で直接作っている" },
    { number: 8, text: "予約と監査記録を、別々に保存している" },
  ],
  failure: [{ number: 6, text: "失敗の理由を、例外のメッセージの文章で見分けている" }],
};
---

<figure class="psm" data-problem-map aria-label="8つの問題が、5つの段のどこにあるか">
  <StepControls />

  <div aria-live="polite">
    <ol class="psm__frames">
      <li data-frame>
        <p class="psm__caption">入口の問題です。問題3は ID の種類を決めている <code>domain/appointment/appointment.ts</code>、問題4は <code>boundary/examResult.ts</code> にあります。</p>
      </li>
      <li data-frame>
        <p class="psm__caption">読み取りの段に、見つかった問題はありません。</p>
      </li>
      <li data-frame>
        <p class="psm__caption">業務の判断の問題です。今の状態を確かめないので、課題1の二重請求が起きました。場所は <code>domain/appointment/appointment.ts</code> です。</p>
      </li>
      <li data-frame>
        <p class="psm__caption">保存の問題です。問題5が課題2の連絡先の事故で、<code>adaptor/secondary/sqlite/appointmentRepository.ts</code> にあります。問題7と問題8は <code>useCase/startExamination.ts</code> にあります。問題8では、2つの保存の片方だけが成功することがあります。</p>
      </li>
      <li data-frame>
        <p class="psm__caption">失敗の返し方の問題です。場所は <code>web/routes.ts</code> です。</p>
      </li>
    </ol>
  </div>

  <ol class="psm__stages">
    {stages.map((stage, index) => (
      <li class:list={["psm__stage", { "psm__stage--fail": stage.id === "failure" }]} data-stage={index}>
        <p class="psm__name">{stage.label}</p>
        <ul class="psm__cards">
          {problems[stage.id].length === 0 && (
            <li class="psm__card psm__card--none" data-card={index}>
              <span class="psm__mark" aria-hidden="true">✓</span>
              <span>問題なし</span>
            </li>
          )}
          {problems[stage.id].map((problem) => (
            <li class="psm__card" data-card={index}>
              <span class="psm__number">{problem.number}</span>
              <span>{problem.text}</span>
              {problem.tag && <span class="psm__tag">{problem.tag}</span>}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-problem-map]").forEach((root) => {
    const stageItems = [...root.querySelectorAll<HTMLElement>("[data-stage]")];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
    mountStepper({
      root,
      onStep: (step) => {
        stageItems.forEach((item) => {
          item.dataset.state = Number(item.dataset.stage) === step ? "current" : "idle";
        });
        cards.forEach((card) => {
          const index = Number(card.dataset.card);
          card.toggleAttribute("data-shown", index <= step);
          card.toggleAttribute("data-fresh", index === step);
        });
      },
    });
  });
</script>

<style>
  .psm {
    min-width: 0;
    margin: 1rem 0;
  }

  .psm__frames {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.5rem;
  }

  .psm__frames > li + li {
    margin-block-start: 0.5rem;
  }

  .psm__caption {
    margin: 0;
    font-weight: 700;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .psm__stages {
    display: grid;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .psm__stage {
    display: grid;
    grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
  }

  .psm__name {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .psm__stage--fail .psm__name {
    border-style: dashed;
  }

  .psm__cards {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .psm__card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.25rem 0.625rem;
    border: 2px solid var(--role-negative);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .psm__card--none {
    border-color: var(--role-positive);
    color: var(--role-positive);
    font-weight: 800;
  }

  .psm__number {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background: var(--role-negative);
    color: var(--role-surface);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .psm__tag {
    flex: none;
    padding: 0 0.5rem;
    border: 2px solid var(--role-negative);
    border-radius: 999px;
    color: var(--role-negative);
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1.3;
    white-space: nowrap;
  }

  .psm__mark {
    flex: none;
  }

  .psm[data-ready] .psm__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .psm[data-ready] .psm__frames > li {
    grid-area: 1 / 1;
    margin: 0;
  }

  .psm[data-ready] .psm__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .psm[data-ready] .psm__card {
    visibility: hidden;
    opacity: 0;
  }

  .psm[data-ready] .psm__card[data-shown] {
    visibility: visible;
    opacity: 1;
  }

  .psm[data-ready] .psm__stage[data-state="idle"] .psm__name {
    color: var(--role-muted);
  }

  .psm[data-ready] .psm__stage[data-state="current"] .psm__name {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .psm[data-ready] .psm__card[data-fresh] {
      animation: psm-in 0.45s ease-out both;
    }

    @keyframes psm-in {
      from {
        opacity: 0;
        transform: translateX(-1rem);
      }
    }
  }

  @media (max-height: 700px) {
    .psm__frames {
      margin-block-start: 0.375rem;
    }

    .psm__stages {
      gap: 0.25rem;
      margin-block-start: 0.375rem;
    }

    .psm__name {
      padding-block: 0.25rem;
    }

    .psm__cards {
      gap: 0.125rem;
    }

    .psm__card {
      padding-block: 0.125rem;
    }

    .psm__number {
      width: 1.375rem;
      height: 1.375rem;
    }
  }

  @media (max-width: 55rem) {
    .psm__stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
