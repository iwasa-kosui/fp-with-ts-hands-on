---
import StepControls from "../stepper/StepControls.astro";

const frames = [
  {
    caption:
      "業務ロジックを中心に配置し、画面やデータベースとは、外側のアダプタ（接続用のコード）で接続します。",
    alt: "中央に六角形が2重にあります。内側の六角形が業務ロジック、それを囲む六角形がユースケースです。画面とデータベースは、アダプタを挟んで外側にあります。画面側のアダプタとデータベース側のアダプタから六角形へ、ユースケースから業務ロジックへ、矢印がすべて内側を向いています。図には、内側、外側、外の世界の札が付いています。",
  },
  {
    caption:
      "依頼は、画面から画面側のアダプタを通って内側に入り、データベース側のアダプタからデータベースへ向かいます。",
    alt: "画面からデータベースまで続く1本の点線が加わっています。点線は、画面側のアダプタから六角形の内側に入り、ユースケースと業務ロジックを通って、データベース側のアダプタへ出ていきます。",
  },
  {
    caption:
      "矢印は依存の向き（import）で、すべて内側を向きます。データベース側のアダプタも、内側の型を import します。詳しくは Session 06 で扱います。",
    alt: "画面からデータベースまで続く点線は消え、3本の依存の矢印が太くなっています。画面側のアダプタ、データベース側のアダプタ、ユースケースの矢印は、すべて内側を向いています。",
  },
  {
    caption:
      "この Session のコードのディレクトリを対応付けます。<code>domain/</code> と <code>useCase/</code> が内側、<code>adaptor/</code> が外側です。事故で欠けていた業務ロジックを実装する <code>domain/</code> が図の中心です。中心に配置すると、画面やデータベースの実装の差し替えが業務ロジックに影響しません。",
    alt: "ディレクトリの札が付いています。業務ロジックは domain/、ユースケースは useCase/、画面側のアダプタは adaptor/primary/web/、データベース側のアダプタは adaptor/secondary/sqlite/ です。図の中心にある domain/ の札を、塗りと太い枠で強調しています。",
  },
] as const;

const words = {
  screen: "画面",
  adapter: "アダプタ",
  database: "データベース",
  procedure: "ユースケース",
  rule: "業務ロジック",
  core: "内側",
  edge: "外側",
  world: "外の世界",
} as const;

const directories = {
  rule: "domain/",
  procedure: "useCase/",
  entry: "adaptor/primary/web/",
  store: "adaptor/secondary/sqlite/",
} as const;

type Point = readonly [number, number];
type Direction = "right" | "left" | "down" | "up";
type Box = Readonly<{ x: number; y: number; w: number; h: number; textY: number }>;
type Place = Readonly<{ x: number; y: number; anchor: "start" | "middle" | "end" }>;

const SLOPE = Math.sqrt(3) / 3;
const HEIGHT_RATIO = Math.sqrt(3) / 2;
const TAG_H = 18;
const HEAD = 7;
const unit: Readonly<Record<Direction, Point>> = { right: [1, 0], left: [-1, 0], down: [0, 1], up: [0, -1] };

const hexPoints = (cx: number, cy: number, radius: number, startDegree: number) =>
  Array.from({ length: 6 }, (_, k) => {
    const angle = ((startDegree + 60 * k) * Math.PI) / 180;
    return `${(cx + radius * Math.cos(angle)).toFixed(1)},${(cy + radius * Math.sin(angle)).toFixed(1)}`;
  }).join(" ");

const headPath = ([x, y]: Point, direction: Direction) => {
  const [dx, dy] = unit[direction];
  const bx = x - dx * HEAD;
  const by = y - dy * HEAD;
  return `M ${bx - dy * 4} ${by + dx * 4} L ${x} ${y} L ${bx + dy * 4} ${by - dx * 4} z`;
};

const arrow = (from: Point, tip: Point, direction: Direction) => {
  const [dx, dy] = unit[direction];
  return { line: `M ${from[0]} ${from[1]} L ${tip[0] - dx * HEAD} ${tip[1] - dy * HEAD}`, head: headPath(tip, direction) };
};

const pathOf = (points: readonly Point[]) => points.map(([x, y], i) => `${i === 0 ? "M" : "L"} ${x} ${y}`).join(" ");

const route = (points: readonly Point[], direction: Direction) => {
  const tip = points[points.length - 1];
  const [dx, dy] = unit[direction];
  const trimmed: Point[] = [...points.slice(0, -1), [tip[0] - dx * HEAD, tip[1] - dy * HEAD]];
  return { line: pathOf(trimmed), reveal: pathOf(points), head: headPath(tip, direction) };
};

const tagWidth = (text: string, fontSize: number) => Math.ceil(text.length * 0.6 * fontSize + 12);
const tag = (text: string, cx: number, y: number, fontSize: number) => ({ text, cx, y, w: tagWidth(text, fontSize) });

const horizontal = (() => {
  const cx = 360;
  const cy = 150;
  const rOut = 120;
  const rIn = 58;
  const boxY = 124;
  const boxH = 76;
  const box = (x: number, w: number): Box => ({ x, y: boxY, w, h: boxH, textY: boxY + 24 });
  const screen = box(4, 92);
  const adapterIn = box(110, 88);
  const adapterOut = box(522, 88);
  const database = box(624, 92);
  const mid = (b: Box) => b.x + b.w / 2;
  const hexTop = cy - rOut * HEIGHT_RATIO;
  const innerTop = cy - rIn * HEIGHT_RATIO;
  const edgeY = 140;
  const entryPoint: Point = [cx - rOut + (cy - edgeY) * SLOPE, edgeY];
  const exitPoint: Point = [cx + rOut - (cy - edgeY) * SLOPE, edgeY];
  const requestY = 164;
  const fs = 14;
  return {
    id: "h",
    size: [720, 290] as Point,
    boxes: { screen, adapterIn, adapterOut, database },
    outerHex: hexPoints(cx, cy, rOut, 0),
    innerHex: hexPoints(cx, cy, rIn, 0),
    procedure: { x: cx, y: 70, anchor: "middle" } as Place,
    rule: { x: cx, y: cy - 4, anchor: "middle" } as Place,
    arrows: [
      arrow([adapterIn.x + adapterIn.w, edgeY], entryPoint, "right"),
      arrow([adapterOut.x, edgeY], exitPoint, "left"),
      arrow([cx, 75], [cx, innerTop], "down"),
    ],
    request: route(
      [
        [screen.x + screen.w, requestY],
        [adapterIn.x + adapterIn.w + 12, requestY],
        entryPoint,
        [cx - 36, requestY],
        [cx + 36, requestY],
        exitPoint,
        [adapterOut.x - 12, requestY],
        [database.x, requestY],
      ],
      "right",
    ),
    tags: [
      { ...tag(directories.rule, cx, cy + rIn * HEIGHT_RATIO - TAG_H / 2, fs), core: true },
      { ...tag(directories.procedure, cx, cy + rOut * HEIGHT_RATIO - TAG_H / 2, fs), core: false },
      { ...tag(directories.entry, mid(adapterIn), boxY + boxH + 8, fs), core: false },
      { ...tag(directories.store, mid(adapterOut), boxY + boxH + 8, fs), core: false },
    ],
    tiers: [
      { text: words.world, x: mid(screen), y: boxY - 8, anchor: "middle" },
      { text: words.world, x: mid(database), y: boxY - 8, anchor: "middle" },
      { text: words.edge, x: mid(adapterIn), y: boxY - 8, anchor: "middle" },
      { text: words.edge, x: mid(adapterOut), y: boxY - 8, anchor: "middle" },
      { text: words.core, x: cx, y: hexTop - 8, anchor: "middle" },
    ] as readonly (Place & { text: string })[],
  };
})();

const vertical = (() => {
  const cx = 200;
  const rOut = 112;
  const rIn = 60;
  const smallH = 40;
  const wideH = 56;
  const gap = 34;
  const gapOut = 52;
  const outerBox = (y: number): Box => ({ x: cx - 85, y, w: 170, h: smallH, textY: y + 25 });
  const adapterBox = (y: number): Box => ({ x: cx - 112, y, w: 224, h: wideH, textY: y + 20 });
  const screen = outerBox(8);
  const adapterIn = adapterBox(screen.y + screen.h + 30);
  const hexTop = adapterIn.y + adapterIn.h + gap;
  const cy = hexTop + rOut;
  const hexBottom = cy + rOut;
  const adapterOut = adapterBox(hexBottom + gapOut);
  const database = outerBox(adapterOut.y + adapterOut.h + 30);
  const innerTop = cy - rIn;
  const requestX = cx + 75;
  const fs = 13;
  const mid = (b: Box) => b.y + b.h / 2 + 4;
  const entryPoint: Point = [cx, hexTop];
  const exitPoint: Point = [cx, hexBottom];
  return {
    id: "v",
    size: [360, database.y + database.h + 8] as Point,
    boxes: { screen, adapterIn, adapterOut, database },
    outerHex: hexPoints(cx, cy, rOut, 30),
    innerHex: hexPoints(cx, cy, rIn, 30),
    procedure: { x: cx, y: cy - 85, anchor: "middle" } as Place,
    rule: { x: cx, y: cy - 4, anchor: "middle" } as Place,
    arrows: [
      arrow([cx, adapterIn.y + adapterIn.h], entryPoint, "down"),
      arrow([cx, adapterOut.y], exitPoint, "up"),
      arrow([cx, cy - 80], [cx, innerTop], "down"),
    ],
    request: route(
      [
        [requestX, screen.y + screen.h],
        [requestX, adapterIn.y + adapterIn.h + 4],
        entryPoint,
        [requestX, hexTop + 47],
        [requestX, hexBottom - 47],
        exitPoint,
        [requestX, adapterOut.y - 4],
        [requestX, database.y],
      ],
      "down",
    ),
    tags: [
      { ...tag(directories.rule, cx, cy + 14, fs), core: true },
      { ...tag(directories.procedure, cx, cy + 68, fs), core: false },
      { ...tag(directories.entry, cx, adapterIn.y + 30, fs), core: false },
      { ...tag(directories.store, cx, adapterOut.y + 30, fs), core: false },
    ],
    tiers: [
      { text: words.world, x: 4, y: mid(screen), anchor: "start" },
      { text: words.edge, x: 4, y: mid(adapterIn), anchor: "start" },
      { text: words.core, x: 4, y: cy + 4, anchor: "start" },
      { text: words.edge, x: 4, y: mid(adapterOut), anchor: "start" },
      { text: words.world, x: 4, y: mid(database), anchor: "start" },
    ] as readonly (Place & { text: string })[],
  };
})();

const layouts = [horizontal, vertical];
const boxList = (layout: (typeof layouts)[number]) => [
  { box: layout.boxes.screen, text: words.screen, outside: true },
  { box: layout.boxes.database, text: words.database, outside: true },
  { box: layout.boxes.adapterIn, text: words.adapter, outside: false },
  { box: layout.boxes.adapterOut, text: words.adapter, outside: false },
];
---

<figure class="hx" data-hexagonal aria-label="ヘキサゴナルアーキテクチャの考え方を示す図">
  <StepControls />

  <div aria-live="polite">
    <ol class="hx__frames">
      {frames.map((frame) => (
        <li data-frame data-alt={frame.alt}>
          <p class="hx__caption" set:html={frame.caption} />
        </li>
      ))}
    </ol>
  </div>

  {layouts.map((layout) => (
    <svg class={`hx__svg hx__svg--${layout.id}`} viewBox={`0 0 ${layout.size[0]} ${layout.size[1]}`} role="img" aria-label={frames[0].alt} data-hx-svg>
      <defs>
        <mask id={`hx-reveal-${layout.id}`} maskUnits="userSpaceOnUse" x="0" y="0" width={layout.size[0]} height={layout.size[1]} mask-type="alpha" class="hx__mask">
          <path d={layout.request.reveal} pathLength="1" class="hx__reveal"></path>
        </mask>
      </defs>
      {boxList(layout).map(({ box, text, outside }) => (
        <g class={outside ? "hx__outside" : "hx__adapter"}>
          <rect x={box.x} y={box.y} width={box.w} height={box.h} rx="6"></rect>
          <text x={box.x + box.w / 2} y={box.textY} text-anchor="middle" class="hx__t-box">{text}</text>
        </g>
      ))}

      {layout.tiers.map((tier) => (
        <text x={tier.x} y={tier.y} text-anchor={tier.anchor} class="hx__t-tier">{tier.text}</text>
      ))}

      <polygon points={layout.outerHex} class="hx__hex hx__hex--outer"></polygon>
      <polygon points={layout.innerHex} class="hx__hex hx__hex--inner"></polygon>
      <text x={layout.procedure.x} y={layout.procedure.y} text-anchor={layout.procedure.anchor} class="hx__t-hex">{words.procedure}</text>
      <text x={layout.rule.x} y={layout.rule.y} text-anchor={layout.rule.anchor} class="hx__t-hex">{words.rule}</text>

      {layout.arrows.map((item) => (
        <>
          <path d={item.line} class="hx__dep"></path>
          <path d={item.head} class="hx__dep-head"></path>
        </>
      ))}

      <g class="hx__layer hx__request" mask={`url(#hx-reveal-${layout.id})`}>
        <path d={layout.request.line} class="hx__request-line"></path>
        <path d={layout.request.head} class="hx__request-head"></path>
      </g>

      <g class="hx__layer hx__tags">
        {layout.tags.map((item) => (
          <g class:list={["hx__tag", { "hx__tag--core": item.core }]}>
            <rect x={item.cx - item.w / 2} y={item.y} width={item.w} height={TAG_H} rx="4"></rect>
            <text x={item.cx} y={item.y + 13} text-anchor="middle" class="hx__t-tag">{item.text}</text>
          </g>
        ))}
      </g>
    </svg>
  ))}

  <p class="hx__legend">
    <span class="hx__legend-item"><span class="hx__legend-arrow" aria-hidden="true">→</span> 依存の向き（import）</span>
    <span class="hx__legend-item hx__legend-flow"><span class="hx__legend-dots" aria-hidden="true">┈→</span> 依頼の流れ</span>
  </p>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-hexagonal]").forEach((root) => {
    const svgs = [...root.querySelectorAll<SVGSVGElement>("[data-hx-svg]")];
    const alts = [...root.querySelectorAll<HTMLElement>("[data-frame]")].map((panel) => panel.dataset.alt ?? "");
    mountStepper({
      root,
      onStep: (step) => {
        svgs.forEach((svg) => {
          svg.dataset.scene = String(step + 1);
          svg.setAttribute("aria-label", alts[step] ?? "");
        });
      },
    });
  });
</script>

<style>
  .hx {
    min-width: 0;
    max-width: 100%;
    margin: 1rem 0;
  }

  .hx__caption {
    margin: 0;
    font-weight: 700;
    line-height: 1.7;
  }

  .hx__frames {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.5rem;
  }

  .hx__frames > li {
    min-width: 0;
  }

  .hx__frames > li + li {
    margin-top: 0.5rem;
  }

  .hx__svg {
    display: block;
    width: 100%;
    height: auto;
    margin: 0.5rem auto 0;
  }

  .hx__svg--h {
    --hx-fs-box: 13px;
    --hx-fs-hex: 14px;
    --hx-fs-tier: 12px;
    --hx-fs-tag: 13px;
    max-height: clamp(15rem, 52vh, 26rem);
  }

  .hx__svg--v {
    --hx-fs-box: 13px;
    --hx-fs-hex: 14px;
    --hx-fs-tier: 13px;
    --hx-fs-tag: 13px;
    display: none;
    max-width: 26rem;
  }

  .hx__outside rect {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 1.5;
    stroke-dasharray: 5 3;
  }

  .hx__adapter rect {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .hx__hex {
    stroke: var(--role-accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .hx__hex--outer {
    fill: var(--role-surface);
  }

  .hx__hex--inner {
    fill: var(--role-accent-soft);
  }

  .hx__svg text {
    fill: var(--role-text);
    font-weight: 700;
  }

  .hx__t-box {
    font-size: var(--hx-fs-box);
  }

  .hx__t-hex {
    font-size: var(--hx-fs-hex);
  }

  .hx__svg .hx__t-tier {
    fill: var(--role-muted);
    font-size: var(--hx-fs-tier);
    font-weight: 600;
  }

  .hx__t-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  .hx__t-tag {
    font-size: var(--hx-fs-tag);
  }

  .hx__dep {
    fill: none;
    stroke: var(--role-accent);
    stroke-width: 2.2;
  }

  .hx__dep-head {
    fill: var(--role-accent);
  }

  .hx__request-line {
    fill: none;
    stroke: var(--role-text);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 0.1 7;
  }

  .hx__mask {
    mask-type: alpha;
  }

  .hx__reveal {
    fill: none;
    stroke: var(--role-text);
    stroke-width: 14;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .hx__request-head {
    fill: var(--role-text);
  }

  .hx__tag rect {
    fill: var(--role-surface);
    stroke: var(--role-accent);
    stroke-width: 1.5;
  }

  .hx__request {
    opacity: 0;
  }

  .hx__svg[data-scene="2"] .hx__request {
    opacity: 1;
  }

  .hx__svg[data-scene="1"] .hx__tags,
  .hx__svg[data-scene="2"] .hx__tags,
  .hx__svg[data-scene="3"] .hx__tags {
    opacity: 0;
  }

  .hx__svg[data-scene="3"] .hx__dep {
    stroke-width: 4.5;
  }

  .hx__svg[data-scene="4"] .hx__tag--core rect {
    fill: color-mix(in srgb, var(--role-accent) 22%, var(--role-surface));
    stroke-width: 3.5;
  }

  .hx__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    margin: 0.5rem 0 0;
    color: var(--role-text);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .hx__legend-arrow {
    color: var(--role-accent);
  }

  .hx[data-ready]:not([data-step="1"]) .hx__legend-flow {
    visibility: hidden;
  }

  .hx[data-ready] .hx__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .hx[data-ready] .hx__frames > li {
    grid-area: 1 / 1;
    margin: 0;
  }

  .hx[data-ready] .hx__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .hx[data-ready] .hx__layer {
    transition: opacity 0.4s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hx[data-ready] .hx__svg[data-scene="2"] .hx__reveal {
      animation: hx-reveal 2.4s ease-in-out 1 both;
    }

    .hx[data-ready] .hx__svg[data-scene="3"] .hx__dep {
      animation: hx-emphasis 0.4s ease-out 1 both;
    }
  }

  @keyframes hx-reveal {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hx-emphasis {
    from {
      stroke-width: 2.2;
    }

    to {
      stroke-width: 4.5;
    }
  }

  @media (max-width: 56rem) {
    .hx__svg--h {
      --hx-fs-box: 15px;
      --hx-fs-hex: 16px;
      --hx-fs-tier: 14px;
      --hx-fs-tag: 14px;
    }
  }

  @media (max-height: 700px) {
    .hx {
      margin: 0.5rem 0;
    }

    .hx :global(.step-controls) {
      margin-bottom: 0.375rem;
    }

    .hx__frames {
      margin-top: 0.375rem;
    }

    .hx__svg {
      margin-top: 0.25rem;
    }

    .hx__svg--h {
      max-height: clamp(14rem, 44vh, 24rem);
    }
  }

  @media (max-width: 40rem) {
    .hx__svg--h {
      display: none;
    }

    .hx__svg--v {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hx[data-ready] * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
