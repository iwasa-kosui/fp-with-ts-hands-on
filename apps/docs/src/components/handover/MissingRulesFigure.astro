---
import { Code } from "astro:components";
import repositorySource from "../../../../../examples/session-00/src/adaptor/secondary/sqlite/appointmentRepository.ts?raw";
import appointmentSource from "../../../../../examples/session-00/src/domain/appointment/appointment.ts?raw";
import { keyedTransformer } from "../code-cache-key";
import StepControls from "../stepper/StepControls.astro";

const fail = (message: string): never => {
  throw new Error(`MissingRulesFigure: ${message}`);
};

const dedent = (lines: string[]): string[] => {
  const indents = lines.filter((line) => line.trim() !== "").map((line) => line.length - line.trimStart().length);
  const common = indents.length === 0 ? 0 : Math.min(...indents);
  return lines.map((line) => line.slice(common));
};

const findLine = (lines: string[], text: string, from = 0): number => {
  const found = lines.findIndex((line, index) => index >= from && line.trim().startsWith(text));
  return found === -1 ? fail(`ソースに「${text}」が見つかりません`) : found;
};

const blockEnd = (lines: string[], start: number): number => {
  const indent = lines[start].length - lines[start].trimStart().length;
  const end = lines.findIndex(
    (line, index) => index > start && line.length - line.trimStart().length === indent && line.trimStart().startsWith("}"),
  );
  return end === -1 ? fail(`「${lines[start].trim()}」の閉じ括弧が見つかりません`) : end;
};

const statementEnd = (lines: string[], start: number): number => {
  const end = lines.findIndex((line, index) => index >= start && line.trimEnd().endsWith(";"));
  return end === -1 ? fail(`「${lines[start].trim()}」の終わりが見つかりません`) : end;
};

const cut = (source: string, startText: string, endOf: (lines: string[], start: number) => number, hlText: string) => {
  const lines = source.split("\n");
  const start = findLine(lines, startText);
  const code = dedent(lines.slice(start, endOf(lines, start) + 1));
  while (code.length > 0 && code[code.length - 1].trim() === "") code.pop();
  return { code: code.join("\n"), highlight: findLine(code, hlText) + 1 };
};

const updateStatus = cut(
  appointmentSource,
  "export const updateStatus",
  statementEnd,
  "): Appointment => ({ ...appointment, ...extra, status });",
);
const appendAudit = cut(repositorySource, "const appendAudit = ", blockEnd, "payload: appointment,");

const codes = [
  { id: "update-status", file: "domain/appointment/appointment.ts", ...updateStatus },
  { id: "append-audit", file: "adaptor/secondary/sqlite/appointmentRepository.ts", ...appendAudit },
] as const;

const rules = [
  { id: "1", text: "会計済みの予約は、診察に戻せない" },
  { id: "2", text: "調査に不要な個人情報は、監査記録に出力しない" },
] as const;

const captions = [
  "病院の人は、会計済みの予約を診察に戻してはいけないと知っています。",
  "コードを見ます。updateStatus は、今の状態を確かめず、渡された状態をそのまま書き込みます。会計済みの予約を拒むロジックは、ここにありません。",
  "もう1件の事故にも、守るべき条件があります。調査に不要な個人情報を、監査記録に出力してはいけません。監査記録は長期間保存され、複数の担当者が閲覧します。出力した飼い主の氏名、メールアドレス、電話番号は、知る必要のない担当者にも開示されます。",
  "監査記録を保存するコードです。予約の内容を丸ごと payload に入れています。個人情報を除くロジックは、ここにもありません。",
  "決まりは、人の頭の中にしかありません。コードは決まりを知らないので、破られても止まりません。",
] as const;
---

<figure class="mrf" data-missing-rules aria-label="病院の人が知っている決まりと、コードに書かれていること">
  <StepControls />

  <div aria-live="polite">
    <ol class="mrf__frames">
      {captions.map((caption) => <li data-frame><p class="mrf__caption">{caption}</p></li>)}
    </ol>
  </div>

  <div class="mrf__grid">
    <section class="mrf__side mrf__side--rules" aria-labelledby="mrf-rules-title">
      <h4 class="mrf__title" id="mrf-rules-title">病院の人が知っている決まり</h4>
      <ul class="mrf__cards">
        {rules.map((rule) => (
          <li class="mrf__card" data-rule={rule.id}>
            <span class="mrf__number">決まり{rule.id}</span>
            <span>{rule.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mrf__side mrf__side--code" aria-labelledby="mrf-code-title">
      <h4 class="mrf__title" id="mrf-code-title">コードに書かれていること</h4>
      <div class="mrf__pane">
        {codes.map((block) => (
          <figure class="mrf__block" data-code={block.id}>
            <figcaption>{block.file}</figcaption>
            <Code
              code={block.code}
              lang="ts"
              transformers={[
                keyedTransformer("missing-rules-figure", {
                  line(node, line) {
                    if (line === codes.find((entry) => entry.code === this.source)?.highlight) this.addClassToHast(node, "is-hl");
                  },
                }),
              ]}
            />
          </figure>
        ))}
        <p class="mrf__empty" data-empty>決まりは書かれていない</p>
      </div>
    </section>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  const views = [
    { rules: 1, code: "none", emphasis: false },
    { rules: 1, code: "update-status", emphasis: false },
    { rules: 2, code: "none", emphasis: false },
    { rules: 2, code: "append-audit", emphasis: false },
    { rules: 2, code: "missing", emphasis: true },
  ] as const;

  document.querySelectorAll<HTMLElement>("[data-missing-rules]").forEach((root) => {
    mountStepper({
      root,
      onStep: (step) => {
        const view = views[step];
        if (!view) return;
        root.dataset.rules = String(view.rules);
        root.dataset.code = view.code;
        root.toggleAttribute("data-emphasis", view.emphasis);
      },
    });
  });
</script>

<style>
  .mrf {
    --mrf-code-bg: var(--role-text);
    --mrf-fs: 12px;
    --mrf-lh: 1.35;
    min-width: 0;
    margin: 0.75rem 0;
  }

  @media (prefers-color-scheme: dark) {
    .mrf {
      --mrf-code-bg: var(--role-bg);
    }
  }

  .mrf__frames {
    margin: 0;
    padding-inline-start: 1.5rem;
  }

  .mrf__frames > li + li {
    margin-block-start: 0.5rem;
  }

  .mrf__caption {
    margin: 0;
    font-weight: 700;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .mrf__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }

  .mrf__side {
    min-width: 0;
  }

  .mrf .mrf__title {
    margin: 0 0 0.375rem;
    color: var(--role-muted);
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .mrf__cards {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mrf__card {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .mrf__number {
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .mrf__pane {
    display: grid;
    min-width: 0;
  }

  .mrf .mrf__block {
    grid-area: 1 / 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--mrf-code-bg);
  }

  .mrf .mrf__block > figcaption {
    padding: 0.125rem 0.5rem;
    border-bottom: 1px solid var(--role-border);
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .mrf .mrf__block :global(pre) {
    margin: 0;
    padding: 0.25rem 0;
    overflow-x: auto;
    background: var(--mrf-code-bg) !important;
    font-size: var(--mrf-fs);
    line-height: var(--mrf-lh);
  }

  .mrf .mrf__block :global(code) {
    display: grid;
    min-width: 0;
    font-size: inherit;
  }

  .mrf .mrf__block :global(.line) {
    min-height: calc(var(--mrf-fs) * var(--mrf-lh));
    padding-inline: 0.5rem;
  }

  .mrf .mrf__block :global(.line.is-hl) {
    background: color-mix(in srgb, var(--frame-code-text) 6%, var(--mrf-code-bg));
    box-shadow: inset 4px 0 0 var(--role-accent);
  }

  .mrf__empty {
    display: none;
    margin: 0;
  }

  .mrf[data-ready] .mrf__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .mrf[data-ready] .mrf__frames > li {
    grid-area: 1 / 1;
    margin: 0;
  }

  .mrf[data-ready] .mrf__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .mrf:not([data-ready]) .mrf__pane {
    gap: 0.5rem;
  }

  .mrf:not([data-ready]) .mrf__block {
    grid-area: auto;
  }

  .mrf[data-ready] .mrf__pane {
    overflow: hidden;
    border: 1px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .mrf[data-ready] .mrf__block {
    border: 0;
    border-radius: 0;
    visibility: hidden;
  }

  .mrf[data-ready][data-code="update-status"] .mrf__block[data-code="update-status"],
  .mrf[data-ready][data-code="append-audit"] .mrf__block[data-code="append-audit"] {
    visibility: visible;
  }

  .mrf[data-ready] .mrf__empty {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    margin: 0.5rem;
    padding: 0.5rem;
    border: 2px dashed var(--role-border);
    border-radius: 0.5rem;
    color: var(--role-muted);
    font-size: 0.9375rem;
    font-weight: 800;
    visibility: hidden;
  }

  .mrf[data-ready][data-code="missing"] .mrf__empty {
    visibility: visible;
  }

  .mrf[data-ready][data-rules="1"] .mrf__card[data-rule="2"] {
    visibility: hidden;
  }

  .mrf[data-ready][data-emphasis] .mrf__card {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mrf[data-ready] .mrf__card {
      transition: box-shadow 0.3s, border-color 0.3s;
    }
  }

  @media (max-height: 700px) {
    .mrf {
      --mrf-fs: 11px;
      margin-block: 0.25rem;
    }

    .mrf__grid {
      gap: 0.5rem;
      margin-block-start: 0.375rem;
    }

    .mrf .mrf__title {
      margin-block-end: 0.125rem;
    }

    .mrf__cards {
      gap: 0.25rem;
    }

    .mrf__card {
      padding-block: 0.25rem;
      font-size: 0.875rem;
    }

    .mrf .mrf__block :global(pre) {
      padding-block: 0;
    }

    .mrf:not([data-ready]) {
      margin-block: 0;
    }

    .mrf:not([data-ready]) .mrf__frames > li + li {
      margin-block-start: 0.125rem;
    }

    .mrf:not([data-ready]) .mrf__caption {
      line-height: 1.4;
    }

    .mrf:not([data-ready]) .mrf__pane {
      gap: 0.25rem;
    }
  }

  @media (max-width: 55rem) {
    .mrf__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
