---
import { noticeMoments } from "./notice-moments";

const details = {
  write: {
    who: "変更した人",
    via: "型検査（値の種類の食い違いを実行の前に調べる仕組み）や Linter（書き方の誤りを調べる道具）が知らせます。",
    missLabel: "ここで気づかないと",
    risk: "開発チームも困る",
    miss: "誤りがテストまで進みます。",
  },
  test: {
    who: "開発チーム",
    via: "テスト（期待どおりに動くかを確かめるコード）が知らせます。",
    missLabel: "ここで気づかないと",
    risk: "操作できない人が出る",
    miss: "誤りが動いているシステムまで進み、サーバーが操作を受け付けません。",
  },
  run: {
    who: "操作した人",
    via: "サーバーが処理の途中で値を確かめます。",
    missLabel: "ここで気づかないと",
    risk: "データが壊れる",
    miss: "誤った操作や値がそのまま通ります。飼い主と病院も困ります。",
  },
  human: {
    who: "飼い主と病院",
    via: "請求を受けた飼い主や、記録を調べた担当者が見つけます。",
    missLabel: "ここで気づいたときには",
    risk: "お金や情報の被害",
    miss: "もう起きています。二重請求と、飼い主の連絡先まで読める監査記録です。",
  },
} as const;

const moments = noticeMoments.map((moment, index) => ({
  ...moment,
  ...details[moment.id],
  people: noticeMoments.slice(0, index + 1).map(({ id }) => details[id].who),
}));
---

<figure class="nm" aria-label="誤りに気づける4つの場面と、それぞれの場面で気づかないと増えるリスク">
  <ol class="nm__moments">
    {
      moments.map((moment, index) => (
        <li class="nm__moment" data-moment={moment.id} style={`--i: ${index}`}>
          <p class="nm__label">
            <span class="nm__number">{index + 1}</span>
            {moment.label}
          </p>
          <p class="nm__via">{moment.via}</p>
          <p class="nm__heading">ここで気づくと困る人</p>
          <ul class="nm__people">
            {moment.people.map((person, personIndex) => (
              <li class:list={["nm__person", { "nm__person--new": personIndex === index }]}>
                {person}
              </li>
            ))}
          </ul>
          <div class="nm__risk">
            <p class="nm__heading">{moment.missLabel}</p>
            <p class="nm__tag">{moment.risk}</p>
            <p class="nm__miss">{moment.miss}</p>
          </div>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .nm {
    --nm-gap: 1.75rem;
    --nm-person-h: 1.75rem;
    margin: 0 0 0.75rem;
  }

  .nm__moments {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 var(--nm-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nm__moment {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0.5rem;
  }

  .nm__moment:not(:last-child)::after {
    content: "→" / "";
    position: absolute;
    top: 0.4rem;
    right: calc(var(--nm-gap) * -1);
    width: var(--nm-gap);
    color: var(--role-muted);
    font-weight: 700;
    text-align: center;
  }

  .nm__moment p {
    margin: 0;
  }

  .nm__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-weight: 700;
  }

  .nm__number {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--role-accent);
    color: var(--role-on-accent);
    font-size: 0.85rem;
  }

  .nm__via {
    color: var(--role-text);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .nm__heading {
    color: var(--role-muted);
    font-size: 0.8rem;
  }

  .nm__people {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    min-height: calc(var(--nm-person-h) * 4 + 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nm__person {
    display: flex;
    align-items: center;
    min-height: var(--nm-person-h);
    padding: 0 0.6rem;
    border: 1px solid var(--role-border);
    border-radius: 0.375rem;
    color: var(--role-muted);
    font-size: 0.875rem;
  }

  .nm__person--new {
    border-color: var(--role-accent);
    background: var(--role-accent-soft);
    color: var(--role-text);
    font-weight: 700;
  }

  [data-moment="human"] .nm__person--new {
    border-color: var(--role-negative);
    background: color-mix(in srgb, var(--role-negative) 18%, var(--role-surface));
  }

  .nm__risk {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0.6rem;
    border-left: 3px solid var(--role-accent);
    background: var(--role-surface);
  }

  [data-moment="run"] .nm__risk,
  [data-moment="human"] .nm__risk {
    border-left-color: var(--role-negative);
  }

  .nm__tag {
    color: var(--role-text);
    font-weight: 700;
  }

  [data-moment="run"] .nm__tag,
  [data-moment="human"] .nm__tag {
    color: var(--role-negative);
  }

  .nm__miss {
    color: var(--role-text);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nm__person--new {
      animation: nm-rise 0.4s ease-out both;
      animation-delay: calc(var(--i) * 0.45s + 0.15s);
    }

    .nm__moment:not(:last-child)::after {
      animation: nm-fade 0.3s ease-out both;
      animation-delay: calc(var(--i) * 0.45s + 0.4s);
    }
  }

  @keyframes nm-rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @keyframes nm-fade {
    from {
      opacity: 0;
    }
  }

  @media (max-height: 700px) {
    .nm {
      --nm-person-h: 1.5rem;
    }

    .nm__moment {
      row-gap: 0.3rem;
    }

    .nm__risk {
      padding: 0.35rem 0.5rem;
    }

    .nm__miss {
      font-size: 0.85rem;
      line-height: 1.4;
    }
  }

  @media (max-width: 55rem) {
    .nm__moments {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--nm-gap);
    }

    .nm__moment {
      display: flex;
      flex-direction: column;
      grid-row: auto;
    }

    .nm__moment:not(:last-child)::after {
      content: "↓" / "";
      top: auto;
      right: auto;
      bottom: calc(var(--nm-gap) * -1);
      left: 0;
      width: 100%;
      line-height: var(--nm-gap);
    }

    .nm__people {
      flex-flow: row wrap;
      min-height: 0;
    }
  }
</style>
