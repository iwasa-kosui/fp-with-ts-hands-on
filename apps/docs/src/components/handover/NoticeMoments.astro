---
import StepControls from "../stepper/StepControls.astro";
import { noticeMoments, type NoticeMomentId } from "./notice-moments";

const details: Readonly<Record<NoticeMomentId, Readonly<{ who: string; caption: string }>>> = {
  write: {
    who: "書いた本人",
    caption: "型検査（値の種類の食い違いを実行の前に調べる仕組み）や Linter（書き方の誤りを調べる道具）が、書いているときに誤りを報告します。",
  },
  test: {
    who: "開発チーム",
    caption: "テスト（期待どおりに動くかを確かめるコード）を実行したときに、誤りが報告されます。",
  },
  run: {
    who: "操作した人",
    caption: "サーバーが処理の途中で値を確かめ、その操作を受け付けません。操作はできませんが、データは壊れません。",
  },
  human: {
    who: "飼い主と病院",
    caption: "請求を受けた飼い主や、記録を調べた担当者が見つけます。お金や情報への被害は、もう起きています。",
  },
};

const levels = [0.25, 0.5, 0.75, 1] as const;
---

<figure class="nm" data-notice-moments aria-label="誤りに気づける4つの場面と、それぞれの場面で困る人">
  <StepControls />

  <div aria-live="polite">
    <ol class="nm__frames">
      {noticeMoments.map((moment) => <li data-frame><p class="nm__caption">{details[moment.id].caption}</p></li>)}
    </ol>
  </div>

  <ol class="nm__moments">
    {noticeMoments.map((moment, index) => (
      <li class="nm__moment" data-moment={index} style={`--level: ${levels[index]}`}>
        <p class="nm__label">{moment.label}</p>
        <div class="nm__chart">
          <p class="nm__who"><span class="nm__who-label">困る人</span><span>{details[moment.id].who}</span></p>
          <div class="nm__bar"></div>
        </div>
      </li>
    ))}
  </ol>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-notice-moments]").forEach((root) => {
    const moments = [...root.querySelectorAll<HTMLElement>("[data-moment]")];
    mountStepper({
      root,
      onStep: (step) => {
        moments.forEach((moment) => {
          const index = Number(moment.dataset.moment);
          moment.dataset.state = index === step ? "current" : index < step ? "past" : "later";
        });
      },
    });
  });
</script>

<style>
  .nm {
    --nm-chart-h: 9rem;
    --nm-bar-max: 6rem;
    min-width: 0;
    margin: 1rem 0;
  }

  .nm__frames {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.5rem;
  }

  .nm__frames > li + li {
    margin-block-start: 0.5rem;
  }

  .nm__caption {
    margin: 0;
    font-weight: 700;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .nm__moments {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .nm__moment {
    min-width: 0;
  }

  .nm__label {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.9375rem;
    font-weight: 800;
    text-align: center;
  }

  .nm__chart {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: var(--nm-chart-h);
    margin-block-start: 0.5rem;
  }

  .nm__who {
    display: grid;
    margin: 0 0 0.25rem;
    color: var(--role-text);
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.4;
    text-align: center;
  }

  .nm__who-label {
    color: var(--role-muted);
    font-size: 0.75rem;
  }

  .nm__bar {
    flex: none;
    height: calc(var(--level) * var(--nm-bar-max));
    border: 2px solid var(--role-negative);
    border-radius: 0.375rem 0.375rem 0 0;
    background: color-mix(in srgb, var(--role-negative) 25%, var(--role-surface));
    transform-origin: bottom;
  }

  .nm[data-ready] .nm__moment[data-state="later"] .nm__chart {
    visibility: hidden;
  }

  .nm[data-ready] .nm__moment[data-state="later"] .nm__label {
    color: var(--role-muted);
  }

  .nm[data-ready] .nm__moment[data-state="current"] .nm__label {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
  }

  .nm[data-ready] .nm__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .nm[data-ready] .nm__frames > li {
    grid-area: 1 / 1;
    margin: 0;
  }

  .nm[data-ready] .nm__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nm[data-ready] .nm__moment[data-state="current"] .nm__bar {
      animation: nm-grow 0.5s ease-out both;
    }

    @keyframes nm-grow {
      from {
        transform: scaleY(0);
      }
    }
  }

  @media (max-height: 700px) {
    .nm {
      margin-block: 0.5rem;
    }

    .nm__frames {
      margin-block-start: 0.375rem;
    }

    .nm__moments {
      margin-block-start: 0.375rem;
    }

    .nm__label {
      padding-block: 0.25rem;
    }

    .nm__chart {
      margin-block-start: 0.25rem;
    }
  }

  @media (max-width: 55rem) {
    .nm__moments {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .nm__moment {
      display: grid;
      grid-template-columns: minmax(7rem, 9rem) minmax(0, 1fr);
      gap: 0.5rem;
      align-items: center;
    }

    .nm__chart {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      height: auto;
      min-height: 2.5rem;
      margin: 0;
      gap: 0.5rem;
    }

    .nm__who {
      flex: none;
      margin: 0;
      text-align: start;
    }

    .nm__bar {
      flex: none;
      width: calc(var(--level) * 40%);
      height: 1.5rem;
      border-radius: 0 0.375rem 0.375rem 0;
      transform-origin: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      .nm[data-ready] .nm__moment[data-state="current"] .nm__bar {
        animation-name: nm-grow-x;
      }

      @keyframes nm-grow-x {
        from {
          transform: scaleX(0);
        }
      }
    }
  }
</style>
