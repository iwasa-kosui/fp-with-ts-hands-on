---
import { incidents, mechanisms, stages } from "./forecast-storage";
---

<figure class="fb" data-forecast aria-label="2件の事故に、どの段のどの仕組みで気づけたかの予想">
  <div class="fb__columns">
    {incidents.map((incident) => (
      <section class="fb__column" data-incident={incident.id}>
        <h3 class="fb__title">{incident.title}</h3>

        <fieldset class="fb__group">
          <legend>どの段で</legend>
          <div class="fb__stages">
            {stages.map((stage) => (
              <label class="fb__card fb__card--stage">
                <input type="radio" name={`${incident.id}-stage`} value={stage.value} data-field="stage" />
                <span>{stage.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="fb__group">
          <legend>どの仕組みで</legend>
          <div class="fb__mechanisms">
            {mechanisms.map((mechanism) => (
              <label class="fb__card fb__card--mechanism">
                <input type="radio" name={`${incident.id}-mechanism`} value={mechanism.value} data-field="mechanism" />
                <span class="fb__body">
                  <span class="fb__label">{mechanism.label}</span>
                  <span class="fb__text">{mechanism.text}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      </section>
    ))}
  </div>
</figure>

<script>
  import { load, save } from "./forecast-storage";

  document.querySelectorAll<HTMLElement>("[data-forecast]").forEach((root) => {
    const saved = load();
    const columns = [...root.querySelectorAll<HTMLElement>("[data-incident]")];

    columns.forEach((column) => {
      const id = column.dataset.incident ?? "";
      const choice = saved.incidents[id] ?? {};
      column.querySelectorAll<HTMLInputElement>("input[type='radio']").forEach((input) => {
        const field = input.dataset.field === "mechanism" ? "mechanism" : "stage";
        input.checked = choice[field] === input.value;
        input.addEventListener("change", () => {
          if (!input.checked) return;
          const current = load();
          current.incidents[id] = { ...current.incidents[id], [field]: input.value };
          save(current);
        });
      });
    });
  });
</script>

<style>
  .fb {
    min-width: 0;
    margin: 1rem 0;
  }

  .fb__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .fb__column {
    min-width: 0;
  }

  .fb__title {
    margin: 0 0 0.5rem;
    font-size: 1.0625rem;
    font-weight: 800;
  }

  .fb__group {
    min-width: 0;
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
  }

  .fb__group legend {
    margin-block-end: 0.375rem;
    padding: 0;
    color: var(--role-muted);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .fb__stages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .fb__mechanisms {
    display: grid;
    gap: 0.375rem;
  }

  .fb__card {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.375rem 0.625rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .fb__card input {
    flex: none;
    margin: 0.3125rem 0 0;
    accent-color: var(--role-accent);
  }

  .fb__body {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .fb__label {
    font-weight: 800;
  }

  .fb__text {
    color: var(--role-muted);
    font-size: 0.8125rem;
  }

  .fb__card:has(input:checked) {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
  }

  .fb__card--stage:has(input:checked) > span::before,
  .fb__card--mechanism:has(input:checked) .fb__label::before {
    content: "✓ ";
    color: var(--role-accent);
    font-weight: 800;
  }

  .fb__card:has(input:focus-visible) {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  @media (max-height: 700px) {
    .fb__title {
      margin-block-end: 0.25rem;
    }

    .fb__group {
      margin-block-end: 0.375rem;
    }

    .fb__group legend {
      margin-block-end: 0.125rem;
    }

    .fb__stages {
      flex-wrap: nowrap;
      gap: 0.25rem;
    }

    .fb__card--stage {
      gap: 0.25rem;
      padding-inline: 0.375rem;
    }

    .fb__mechanisms {
      gap: 0.25rem;
    }

    .fb__card--mechanism {
      padding-block: 0.125rem;
    }
  }

  @media (max-width: 55rem) {
    .fb__columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
