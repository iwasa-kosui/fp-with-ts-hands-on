---
const incidents = [
  { id: "double-billing", title: "課題1 二重請求" },
  { id: "pii-audit", title: "課題2 連絡先が読める監査記録" },
] as const;

const stages = [
  { value: "entry", label: "入口" },
  { value: "read", label: "読み取り" },
  { value: "decide", label: "業務の判断" },
  { value: "save", label: "保存" },
  { value: "failure", label: "失敗の返し方" },
] as const;

const mechanisms = [
  { value: "write", label: "書いた時点で気づく", text: "型検査（値の種類の食い違いを実行の前に調べる仕組み）や Linter（書き方の誤りを調べる道具）が、書いているときに誤りを報告します。" },
  { value: "test", label: "テストで気づく", text: "テスト（期待どおりに動くかを確かめるコード）を実行したときに、誤りが報告されます。" },
  { value: "runtime", label: "動かしているときに気づく", text: "サーバーが処理の途中で値を確かめ、その操作を受け付けません。" },
  { value: "human", label: "人が気づく", text: "レビューや運用の確認で、担当者が見つけます。" },
] as const;
---

<figure class="fb" data-forecast aria-label="2件の事故に、どの段のどの仕組みで気づけたかの予想">
  <div class="fb__columns">
    {incidents.map((incident) => (
      <section class="fb__column" data-incident={incident.id}>
        <h3 class="fb__title">{incident.title}</h3>

        <fieldset class="fb__group">
          <legend>どの段で</legend>
          <div class="fb__stages">
            {stages.map((stage) => (
              <label class="fb__card fb__card--stage">
                <input type="radio" name={`${incident.id}-stage`} value={stage.value} data-field="stage" />
                <span>{stage.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="fb__group">
          <legend>どの仕組みで</legend>
          <div class="fb__mechanisms">
            {mechanisms.map((mechanism) => (
              <label class="fb__card fb__card--mechanism">
                <input type="radio" name={`${incident.id}-mechanism`} value={mechanism.value} data-field="mechanism" />
                <span class="fb__body">
                  <span class="fb__label">{mechanism.label}</span>
                  <span class="fb__text">{mechanism.text}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      </section>
    ))}
  </div>
</figure>

<script>
  const STORAGE_KEY = "fp-with-ts:forecast:session-00";
  const INCIDENTS = ["double-billing", "pii-audit"];
  const STAGES = ["entry", "read", "decide", "save", "failure"];
  const MECHANISMS = ["write", "test", "runtime", "human"];

  type Choice = { stage?: string; mechanism?: string };
  type Saved = { version: 1; incidents: Record<string, Choice> };

  const allowed: Record<string, readonly string[]> = { stage: STAGES, mechanism: MECHANISMS };

  const load = (): Saved => {
    const empty: Saved = { version: 1, incidents: {} };
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (raw === null) return empty;
      const parsed: unknown = JSON.parse(raw);
      if (typeof parsed !== "object" || parsed === null) return empty;
      const incidents = (parsed as { incidents?: unknown }).incidents;
      if (typeof incidents !== "object" || incidents === null) return empty;
      const result: Saved = { version: 1, incidents: {} };
      for (const id of INCIDENTS) {
        const entry = (incidents as Record<string, unknown>)[id];
        if (typeof entry !== "object" || entry === null) continue;
        const choice: Choice = {};
        for (const field of ["stage", "mechanism"] as const) {
          const value = (entry as Record<string, unknown>)[field];
          if (typeof value === "string" && allowed[field].includes(value)) choice[field] = value;
        }
        result.incidents[id] = choice;
      }
      return result;
    } catch {
      return empty;
    }
  };

  const save = (saved: Saved): void => {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
    } catch {
      return;
    }
  };

  document.querySelectorAll<HTMLElement>("[data-forecast]").forEach((root) => {
    const saved = load();
    const columns = [...root.querySelectorAll<HTMLElement>("[data-incident]")];

    columns.forEach((column) => {
      const id = column.dataset.incident ?? "";
      const choice = saved.incidents[id] ?? {};
      column.querySelectorAll<HTMLInputElement>("input[type='radio']").forEach((input) => {
        const field = input.dataset.field === "mechanism" ? "mechanism" : "stage";
        input.checked = choice[field] === input.value;
        input.addEventListener("change", () => {
          if (!input.checked) return;
          const current = load();
          current.incidents[id] = { ...current.incidents[id], [field]: input.value };
          save(current);
        });
      });
    });
  });
</script>

<style>
  .fb {
    min-width: 0;
    margin: 1rem 0;
  }

  .fb__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .fb__column {
    min-width: 0;
  }

  .fb__title {
    margin: 0 0 0.5rem;
    font-size: 1.0625rem;
    font-weight: 800;
  }

  .fb__group {
    min-width: 0;
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
  }

  .fb__group legend {
    margin-block-end: 0.375rem;
    padding: 0;
    color: var(--role-muted);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .fb__stages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .fb__mechanisms {
    display: grid;
    gap: 0.375rem;
  }

  .fb__card {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.375rem 0.625rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .fb__card input {
    flex: none;
    margin: 0.3125rem 0 0;
    accent-color: var(--role-accent);
  }

  .fb__body {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .fb__label {
    font-weight: 800;
  }

  .fb__text {
    color: var(--role-muted);
    font-size: 0.8125rem;
  }

  .fb__card:has(input:checked) {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
  }

  .fb__card--stage:has(input:checked) > span::before,
  .fb__card--mechanism:has(input:checked) .fb__label::before {
    content: "✓ ";
    color: var(--role-accent);
    font-weight: 800;
  }

  .fb__card:has(input:focus-visible) {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  @media (max-height: 700px) {
    .fb__title {
      margin-block-end: 0.25rem;
    }

    .fb__group {
      margin-block-end: 0.375rem;
    }

    .fb__group legend {
      margin-block-end: 0.125rem;
    }

    .fb__stages {
      flex-wrap: nowrap;
      gap: 0.25rem;
    }

    .fb__card--stage {
      gap: 0.25rem;
      padding-inline: 0.375rem;
    }

    .fb__mechanisms {
      gap: 0.25rem;
    }

    .fb__card--mechanism {
      padding-block: 0.125rem;
    }
  }

  @media (max-width: 55rem) {
    .fb__columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
