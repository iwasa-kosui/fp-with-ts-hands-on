---
import StepControls from "../stepper/StepControls.astro";

type Mark = "changed" | "added" | "personal";

type Row = Readonly<{ name: string; value: string; mark?: Mark; note?: string }>;

const markLabels = {
  changed: "変わった",
  added: "増えた",
  personal: "調査に要らない",
} as const satisfies Record<Mark, string>;

const auditEvents = [
  "appointment.seeded",
  "appointment.checked-in",
  "examination.started",
  "examination.result-recorded",
  "payment.recorded",
] as const;

const appointmentBefore: readonly Row[] = [
  { name: "status", value: "paid", note: "会計済み" },
  { name: "amount", value: "4800" },
  { name: "paidAt", value: "2026-08-30T07:10:00.000Z" },
];

const appointmentAfter: readonly Row[] = [
  { name: "status", value: "in-examination", note: "診察中", mark: "changed" },
  { name: "amount", value: "4800" },
  { name: "paidAt", value: "2026-08-30T07:10:00.000Z" },
];

const addedRowItems: readonly Row[] = [
  { name: "eventId", value: "操作ごとに作る新しい ID" },
  { name: "appointmentId", value: "11111111-1111-4111-8111-111111111111" },
  { name: "eventName", value: "examination.started" },
  { name: "occurredAt", value: "操作した時刻" },
];

const payloadItems: readonly Row[] = [
  { name: "petName", value: "Mugi" },
  { name: "status", value: "in-examination", note: "診察中" },
  { name: "ownerName", value: "Owner A", mark: "personal" },
  { name: "ownerEmail", value: "owner@example.test", mark: "personal" },
  { name: "ownerPhone", value: "090-0000-0000", mark: "personal" },
];
---

<figure class="rc" data-records aria-label="事故の前後で、データベースの値がどう変わるか">
  <StepControls />

  <div aria-live="polite">
    <ol class="rc__frames">
      <li data-frame>
        <p class="rc__caption">課題1。会計済みの予約で「診察を開始する」を押した前後です。現在の予約内容の状態が <code>in-examination</code> へ戻り、監査記録には会計の行のあとに診察開始の行が増えます。</p>
        <div class="rc__grid">
          <section class="rc__side" aria-label="操作の前">
            <h4 class="rc__title">操作の前</h4>
            <h5 class="rc__sub">現在の予約内容</h5>
            <dl class="rc__rows">
              {appointmentBefore.map((row) => (
                <div class="rc__row">
                  <dt>{row.name}</dt>
                  <dd>{row.value}{row.note && <span class="rc__note">（{row.note}）</span>}</dd>
                </div>
              ))}
            </dl>
            <h5 class="rc__sub">監査記録</h5>
            <ol class="rc__events">
              {auditEvents.map((event) => (
                <li class="rc__row">{event}</li>
              ))}
              <li class="rc__row rc__row--empty" aria-hidden="true">&nbsp;</li>
            </ol>
          </section>

          <div class="rc__operation">
            <p class="rc__operation-label">操作</p>
            <p class="rc__operation-name">診察を開始する</p>
            <p class="rc__arrow" aria-hidden="true">→</p>
          </div>

          <section class="rc__side" aria-label="操作の後">
            <h4 class="rc__title">操作の後</h4>
            <h5 class="rc__sub">現在の予約内容</h5>
            <dl class="rc__rows">
              {appointmentAfter.map((row) => (
                <div class="rc__row" data-mark={row.mark}>
                  <dt>{row.name}</dt>
                  <dd>
                    {row.value}{row.note && <span class="rc__note">（{row.note}）</span>}
                    {row.mark && <span class="rc__tag">{markLabels[row.mark]}</span>}
                  </dd>
                </div>
              ))}
            </dl>
            <h5 class="rc__sub">監査記録</h5>
            <ol class="rc__events">
              {auditEvents.map((event) => (
                <li class="rc__row">{event}</li>
              ))}
              <li class="rc__row" data-mark="added">
                examination.started
                <span class="rc__tag">{markLabels.added}</span>
              </li>
            </ol>
          </section>
        </div>
      </li>

      <li data-frame>
        <p class="rc__caption">課題2。同じ操作で増えた監査記録の1行です。操作名と時刻のほかに、飼い主の氏名、メールアドレス、電話番号まで保存されています。</p>
        <div class="rc__grid">
          <section class="rc__side" aria-label="操作の前">
            <h4 class="rc__title">操作の前</h4>
            <h5 class="rc__sub">監査記録</h5>
            <ol class="rc__events">
              {auditEvents.map((event) => (
                <li class="rc__row">{event}</li>
              ))}
              <li class="rc__row rc__row--empty">
                <span class="rc__none">診察開始の行は、まだありません</span>
              </li>
            </ol>
          </section>

          <div class="rc__operation">
            <p class="rc__operation-label">操作</p>
            <p class="rc__operation-name">診察を開始する</p>
            <p class="rc__arrow" aria-hidden="true">→</p>
          </div>

          <section class="rc__side" aria-label="操作の後">
            <h4 class="rc__title">操作の後</h4>
            <h5 class="rc__sub">増えた監査記録の1行</h5>
            <dl class="rc__rows">
              {addedRowItems.map((row) => (
                <div class="rc__row">
                  <dt>{row.name}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
              <div class="rc__row">
                <dt>payload</dt>
                <dd class="rc__payload-head">操作後の予約内容</dd>
              </div>
              {payloadItems.map((row) => (
                <div class="rc__row rc__row--nested" data-mark={row.mark}>
                  <dt>{row.name}</dt>
                  <dd>
                    {row.value}{row.note && <span class="rc__note">（{row.note}）</span>}
                    {row.mark && <span class="rc__tag">{markLabels[row.mark]}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      </li>
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-records]").forEach((root) => {
    mountStepper({ root });
  });
</script>

<style>
  .rc {
    min-width: 0;
    margin: 1rem 0;
  }

  .rc__frames {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.5rem;
  }

  .rc__frames > li {
    min-width: 0;
  }

  .rc__frames > li + li {
    margin-block-start: 1rem;
  }

  .rc__caption {
    margin: 0 0 0.75rem;
    font-weight: 700;
    line-height: 1.7;
  }

  .rc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.15fr);
    gap: 0.75rem;
    align-items: start;
  }

  .rc__side {
    min-width: 0;
    padding: 0.625rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
  }

  .rc__title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .rc__sub {
    margin: 0.5rem 0 0.25rem;
    color: var(--role-muted);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .rc__rows,
  .rc__events {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rc__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.5rem;
    min-height: 1.75rem;
    margin: 0;
    padding: 0.125rem 0.5rem;
    border-inline-start: 4px solid var(--role-border);
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .rc__row dt {
    min-width: 7rem;
    color: var(--role-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .rc__row dd {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .rc__row--nested {
    margin-inline-start: 1rem;
  }

  .rc__row--empty {
    border-inline-start-style: dashed;
  }

  .rc__row[data-mark] {
    border-inline-start-color: var(--role-negative);
    background: color-mix(in srgb, var(--role-negative) 14%, var(--role-surface));
    font-weight: 800;
  }

  .rc__payload-head {
    font-family: inherit;
  }

  .rc__note {
    font-family: inherit;
    font-weight: 400;
  }

  .rc__none {
    color: var(--role-muted);
  }

  .rc__tag {
    margin-inline-start: 0.5rem;
    padding: 0 0.5rem;
    border: 2px solid var(--role-negative);
    border-radius: 999px;
    color: var(--role-negative);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .rc__operation {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.25rem;
    padding-block-start: 2.5rem;
    text-align: center;
  }

  .rc__operation p {
    margin: 0;
  }

  .rc__operation-label {
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .rc__operation-name {
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--role-accent);
    border-radius: 999px;
    color: var(--role-accent);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .rc__arrow {
    color: var(--role-muted);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .rc[data-ready] .rc__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .rc[data-ready] .rc__frames > li {
    grid-area: 1 / 1;
    margin: 0;
  }

  .rc[data-ready] .rc__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rc[data-ready] .rc__row[data-mark] {
      animation: rc-flash 0.8s ease-out both;
    }

    @keyframes rc-flash {
      from {
        background: transparent;
      }
    }
  }

  @media (max-width: 55rem) {
    .rc__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .rc__operation {
      padding-block-start: 0;
    }

    .rc__arrow {
      transform: rotate(90deg);
    }
  }
</style>
