---
import { noticeMoments } from "./notice-moments";

const questions = [
  { field: "now", legend: "今、その決まりが破られたら、どの場面で気づきますか" },
  { field: "goal", legend: "どの場面で気づけるようにしたいですか" },
] as const;
---

<div class="orw" data-own-rule>
  <div class="orw__group">
    <label class="orw__legend" for="own-rule-text">人の頭の中にしかない決まり</label>
    <textarea class="orw__text" id="own-rule-text" rows="2" data-field="rule"></textarea>
  </div>

  {questions.map((question) => (
    <fieldset class="orw__group">
      <legend class="orw__legend">{question.legend}</legend>
      <div class="orw__choices">
        {noticeMoments.map((moment) => (
          <label class="orw__choice">
            <input type="radio" name={`own-rule-${question.field}`} value={moment.id} data-field={question.field} />
            <span>{moment.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  ))}
</div>

<script>
  const STORAGE_KEY = "fp-with-ts:own-rule:session-00";
  const MOMENTS = ["write", "test", "run", "human"];

  type Saved = { version: 1; rule: string; now?: string; goal?: string };

  const load = (): Saved => {
    const empty: Saved = { version: 1, rule: "" };
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (raw === null) return empty;
      const parsed: unknown = JSON.parse(raw);
      if (typeof parsed !== "object" || parsed === null) return empty;
      const record = parsed as Record<string, unknown>;
      const result: Saved = { version: 1, rule: typeof record.rule === "string" ? record.rule : "" };
      for (const field of ["now", "goal"] as const) {
        const value = record[field];
        if (typeof value === "string" && MOMENTS.includes(value)) result[field] = value;
      }
      return result;
    } catch {
      return empty;
    }
  };

  const save = (saved: Saved): void => {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
    } catch {
      return;
    }
  };

  document.querySelectorAll<HTMLElement>("[data-own-rule]").forEach((root) => {
    const saved = load();
    const text = root.querySelector<HTMLTextAreaElement>("textarea[data-field='rule']");
    if (text) {
      text.value = saved.rule;
      text.addEventListener("input", () => {
        save({ ...load(), rule: text.value });
      });
    }
    root.querySelectorAll<HTMLInputElement>("input[type='radio']").forEach((input) => {
      const field = input.dataset.field === "goal" ? "goal" : "now";
      input.checked = saved[field] === input.value;
      input.addEventListener("change", () => {
        if (!input.checked) return;
        save({ ...load(), [field]: input.value });
      });
    });
  });
</script>

<style>
  .orw {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    margin: 1rem 0;
  }

  .orw__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .orw__legend {
    display: block;
    margin: 0 0 0.375rem;
    padding: 0;
    color: var(--role-text);
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .orw__text {
    box-sizing: border-box;
    display: block;
    width: 100%;
    min-height: 0;
    margin: 0;
    padding: 0.5rem 0.625rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.5;
    resize: vertical;
  }

  .orw__text:focus-visible {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  .orw__choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .orw__choice {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    cursor: pointer;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .orw__choice input {
    flex: none;
    margin: 0;
    accent-color: var(--role-accent);
  }

  .orw__choice:has(input:checked) {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
    font-weight: 800;
  }

  .orw__choice:has(input:checked) > span::before {
    content: "✓ ";
    color: var(--role-accent);
  }

  .orw__choice:has(input:focus-visible) {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  @media (max-height: 700px) {
    .orw {
      gap: 0.375rem;
      margin-block: 0.5rem;
    }

    .orw__legend {
      margin-block-end: 0.125rem;
    }

    .orw__text {
      padding-block: 0.25rem;
    }

    .orw__choice {
      padding-block: 0.125rem;
    }
  }

  @media (max-width: 55rem) {
    .orw__choices {
      gap: 0.25rem;
    }

    .orw__choice {
      padding-inline: 0.5rem;
    }
  }
</style>
