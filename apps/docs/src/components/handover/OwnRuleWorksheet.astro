---
import { noticeMoments } from "./notice-moments";

const questions = [
  { field: "now", legend: "現在、この業務ルールに違反する操作が行われた場合、どの時点で検出されますか" },
  { field: "goal", legend: "このルールはどの時点で検出したいですか。Final で見直します" },
] as const;
---

<div class="orw" data-own-rule>
  <div class="orw__group">
    <label class="orw__legend" for="own-rule-text">担当者の記憶にしかない業務ルール</label>
    <textarea class="orw__text" id="own-rule-text" rows="2" data-field="rule"></textarea>
    <p class="orw__saved" role="status" data-saved></p>
  </div>

  {questions.map((question) => (
    <fieldset class="orw__group">
      <legend class="orw__legend">{question.legend}</legend>
      <div class="orw__choices">
        {noticeMoments.map((moment) => (
          <label class="orw__choice">
            <input type="radio" name={`own-rule-${question.field}`} value={moment.id} data-field={question.field} />
            <span>{moment.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  ))}
</div>

<script>
  import { isMomentId, load, save, type Saved } from "./own-rule-storage";

  document.querySelectorAll<HTMLElement>("[data-own-rule]").forEach((root) => {
    const saved = load();
    const text = root.querySelector<HTMLTextAreaElement>("textarea[data-field='rule']");
    const status = root.querySelector<HTMLElement>("[data-saved]");
    const saveAndNotify = (next: Saved) => {
      if (status) status.textContent = save(next) ? "このブラウザに保存しました。" : "";
    };
    if (text) {
      text.value = saved.rule;
      text.addEventListener("input", () => {
        saveAndNotify({ ...load(), rule: text.value });
      });
    }
    root.querySelectorAll<HTMLInputElement>("input[type='radio']").forEach((input) => {
      const field = input.dataset.field === "goal" ? "goal" : "now";
      input.checked = saved[field] === input.value;
      input.addEventListener("change", () => {
        if (!input.checked || !isMomentId(input.value)) return;
        saveAndNotify({ ...load(), [field]: input.value });
      });
    });
  });
</script>

<style>
  .orw {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    margin: 1rem 0;
  }

  .orw__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .orw__legend {
    display: block;
    margin: 0 0 0.375rem;
    padding: 0;
    color: var(--role-text);
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .orw__text {
    box-sizing: border-box;
    display: block;
    width: 100%;
    min-height: 0;
    margin: 0;
    padding: 0.5rem 0.625rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.5;
    resize: vertical;
  }

  .orw__saved {
    margin: 0.25rem 0 0;
    color: var(--role-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .orw__text:focus-visible {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  .orw__choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .orw__choice {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
    cursor: pointer;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .orw__choice input {
    flex: none;
    margin: 0;
    accent-color: var(--role-accent);
  }

  .orw__choice:has(input:checked) {
    border-color: var(--role-accent);
    box-shadow: 0 0 0 2px var(--role-accent);
    font-weight: 800;
  }

  .orw__choice:has(input:checked) > span::before {
    content: "✓ ";
    color: var(--role-accent);
  }

  .orw__choice:has(input:focus-visible) {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  @media (max-height: 700px) {
    .orw {
      gap: 0.375rem;
      margin-block: 0.5rem;
    }

    .orw__legend {
      margin-block-end: 0.125rem;
    }

    .orw__text {
      padding-block: 0.25rem;
    }

    .orw__choice {
      padding-block: 0.125rem;
    }
  }

  @media (max-width: 55rem) {
    .orw__choices {
      gap: 0.25rem;
    }

    .orw__choice {
      padding-inline: 0.5rem;
    }
  }
</style>
