---
import { Code } from "astro:components";
import type { CodeGuide } from "../code-explorer/code-guide";
import type { ProjectFiles } from "../code-explorer/types";
import MiniTree from "./mini-tree/MiniTree.astro";
import { breakBeforeMember } from "./break-before-member";
import type { MiniTreeData } from "./mini-tree/mini-tree";

interface Props {
  guides: readonly CodeGuide[];
  projectFiles: ProjectFiles;
  dedent?: boolean;
  trees?: Readonly<Record<string, { tree: MiniTreeData; current: readonly string[] }>>;
}

const { guides, projectFiles, dedent = false, trees } = Astro.props;
const removeIndent = (lines: readonly string[]): string[] => {
  const indent = Math.min(
    ...lines.filter((line) => line.trim() !== "").map((line) => line.search(/\S/)),
  );
  return lines.map((line) => line.slice(indent));
};
const cards = guides.map((guide) => {
  const source = projectFiles[guide.path];
  if (source === undefined) {
    throw new Error(`Guide source not found: ${guide.path}`);
  }

  return {
    guide,
    excerpts: guide.highlights.map(({ startLineNumber, endLineNumber }) => ({
      startLineNumber,
      endLineNumber,
      source: (() => {
        const lines = source.split("\n").slice(startLineNumber - 1, endLineNumber);
        return (dedent ? removeIndent(lines) : lines).join("\n");
      })(),
    })),
  };
});
---

<ol class="code-guide-cards" aria-label="教材のコードの設計課題">
  {
    cards.map(({ guide, excerpts }) => (
      <li data-code-guide-card={guide.id} data-has-tree={trees?.[guide.id] ? "" : undefined}>
        <h4>{guide.title}</h4>
        {trees?.[guide.id] ? <MiniTree tree={trees[guide.id].tree} current={trees[guide.id].current} /> : null}
        {excerpts.map(({ startLineNumber, endLineNumber, source }) => (
          <figure>
            <figcaption>{guide.path}<span class="line-range">:{startLineNumber}-{endLineNumber}</span></figcaption>
            <Code code={source} lang="ts" transformers={[breakBeforeMember]} />
          </figure>
        ))}
        <p>{guide.currentDesign} {guide.futureRisk}</p>
      </li>
    ))
  }
</ol>

<style>
  .code-guide-cards {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0;
    padding: 0;
    list-style: none;
  }

  .code-guide-cards > li {
    min-width: 0;
    padding: 1rem;
    border: 0.1875rem solid var(--playground-border);
    background: var(--playground-surface);
  }

  h4 {
    margin: 0 0 0.75rem;
  }

  figure {
    min-width: 0;
    margin: 0.75rem 0;
  }

  figcaption {
    padding: 0.4rem 0.6rem;
    background: var(--playground-highlight);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .line-range {
    white-space: nowrap;
  }

  figure :global(pre) {
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    border: 0.125rem solid var(--playground-border);
  }

  li > p {
    margin: 0.75rem 0 0;
  }

  @media (max-height: 700px) {
    .code-guide-cards > li[data-has-tree][data-code-guide-card] {
      padding-block: 0.125rem;
    }

    .code-guide-cards > li[data-has-tree] > h4 {
      margin-block-end: 0;
      line-height: 1.2;
    }

    .code-guide-cards > li[data-has-tree] > :global(.mini-tree) {
      row-gap: 0;
      line-height: 1.15;
    }

    .code-guide-cards > li[data-has-tree] > :global(.mini-tree) :global(.mini-tree__file) {
      padding-block: 0;
    }

    .code-guide-cards > li[data-has-tree] > figure {
      margin-block: 0;
    }

    .code-guide-cards > li[data-has-tree] > figure figcaption {
      padding-block: 0.0625rem;
      line-height: 1.3;
    }

    .code-guide-cards > li[data-has-tree] > figure :global(pre) {
      padding-block: 0.25rem;
    }

    .code-guide-cards > li[data-has-tree] > p {
      margin-block-start: 0.125rem;
      line-height: 1.35;
    }
  }

</style>
