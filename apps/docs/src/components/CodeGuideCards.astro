---
import { Code } from "astro:components";
import type { CodeGuide } from "../code-explorer/code-guide";
import type { ProjectFiles } from "../code-explorer/types";

interface Props {
  guides: readonly CodeGuide[];
  projectFiles: ProjectFiles;
  dedent?: boolean;
}

const { guides, projectFiles, dedent = false } = Astro.props;
const removeIndent = (lines: readonly string[]): string[] => {
  const indent = Math.min(
    ...lines.filter((line) => line.trim() !== "").map((line) => line.search(/\S/)),
  );
  return lines.map((line) => line.slice(indent));
};
const cards = guides.map((guide) => {
  const source = projectFiles[guide.path];
  if (source === undefined) {
    throw new Error(`Guide source not found: ${guide.path}`);
  }

  return {
    guide,
    excerpts: guide.highlights.map(({ startLineNumber, endLineNumber }) => ({
      startLineNumber,
      endLineNumber,
      source: (() => {
        const lines = source.split("\n").slice(startLineNumber - 1, endLineNumber);
        return (dedent ? removeIndent(lines) : lines).join("\n");
      })(),
    })),
  };
});
---

<ol class="code-guide-cards" aria-label="配布コードの設計課題">
  {
    cards.map(({ guide, excerpts }) => (
      <li data-code-guide-card={guide.id}>
        <h4>{guide.title}</h4>
        {excerpts.map(({ startLineNumber, endLineNumber, source }) => (
          <figure>
            <figcaption>{guide.path}<span class="line-range">:{startLineNumber}-{endLineNumber}</span></figcaption>
            <Code code={source} lang="ts" />
          </figure>
        ))}
        <p>{guide.currentDesign} {guide.futureRisk}</p>
      </li>
    ))
  }
</ol>

<style>
  .code-guide-cards {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0;
    padding: 0;
    list-style: none;
  }

  .code-guide-cards > li {
    min-width: 0;
    padding: 1rem;
    border: 0.1875rem solid var(--playground-border);
    background: var(--playground-surface);
  }

  h4 {
    margin: 0 0 0.75rem;
  }

  figure {
    min-width: 0;
    margin: 0.75rem 0;
  }

  figcaption {
    padding: 0.4rem 0.6rem;
    background: var(--playground-highlight);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .line-range {
    white-space: nowrap;
  }

  figure :global(pre) {
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    border: 0.125rem solid var(--playground-border);
  }

  li > p {
    margin: 0.75rem 0 0;
  }

</style>
