---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import type { ExerciseStep } from "../sessions/catalog";

type Props = Readonly<{
  step: ExerciseStep;
}>;

const { step } = Astro.props;
const snippets = await Promise.all(
  step.solutions.map(async (solution) => {
    const [start, end] = solution.lines;
    if (!Number.isInteger(start) || start < 1) {
      throw new Error(`StepSolution: 開始行は1以上で指定してください: ${solution.path}`);
    }
    if (!Number.isInteger(end) || end < start) {
      throw new Error(`StepSolution: 終了行は開始行以降で指定してください: ${solution.path}`);
    }

    const source = await readFile(resolve(process.cwd(), "../..", solution.path), "utf8");
    const sourceLines = source.split("\n");
    if (end > sourceLines.length) {
      throw new Error(`StepSolution: 指定行がソースの範囲外です: ${solution.path}:${start}-${end}`);
    }
    const code = sourceLines.slice(start - 1, end).join("\n");
    if (code.trim() === "") {
      throw new Error(`StepSolution: 指定範囲のコードが空です: ${solution.path}:${start}-${end}`);
    }
    return { solution, code };
  }),
);
---

<details class="step-solution">
  <summary>{step.goal}</summary>
  {
    snippets.map(({ solution, code }) => (
      <section class="step-solution__snippet">
        <h4><code>{solution.path}</code></h4>
        <pre><code>{code}</code></pre>
      </section>
    ))
  }
</details>
