---
import { Code } from "astro:components";
import css from "./effects-pipeline.css?raw";
import script from "./effects-pipeline.js?raw";
import { quote, quoteRows } from "./quote";
import Walkthrough from "./Walkthrough.astro";

type Tone = "ok" | "err" | "reject";
type Stage = Readonly<{ key: string; file?: string; outer?: true; code: string }>;
type Impl = Readonly<{
  stage: string;
  path: string;
  code: string;
  more?: readonly Readonly<{ path: string; code: string }>[];
}>;
type Card = Readonly<{
  key: string;
  stage: string;
  tone: Tone;
  chip: string;
  type: string;
  code: string;
  short: string;
}>;
type Flow = Readonly<{ kind: "err" | "reject"; from: string; to: string }>;
type Frame = Readonly<{
  text: string;
  at: string;
  impl?: string;
  lines?: readonly number[];
  out?: string;
  skipped?: readonly string[];
  flow?: Flow;
}>;
type SceneKey = "flow" | "reject" | "two-paths";
type Scene = Readonly<{
  label: string;
  outer?: string;
  settled: Readonly<Record<string, string>>;
  frames: readonly Frame[];
}>;

interface Props {
  scene?: SceneKey;
}

const { scene: sceneKey } = Astro.props;
const page = sceneKey !== undefined;
const sameUntil = page ? "成功の 6 コマ目まで同じです。" : "場面1の6コマ目まで同じです。";
const rejectStart = "予約の確認とイベントの作成まで進み、保存で失敗します。作った `event` を `store` に渡して呼びます。";

const startExaminationPath = "examples/session-06-solution/src/useCase/startExamination.ts";
const errorsPath = "examples/session-06-solution/src/useCase/errors.ts";
const storePath = "examples/session-06-solution/src/adaptor/secondary/sqlite/examinationStartedStore.ts";
const routesPath = "examples/session-06-solution/src/web/routes.ts";

const stages: readonly Stage[] = [
  {
    key: "sig",
    file: startExaminationPath,
    code: `export const startExaminationWithEffects =
  (deps: EffectsDependencies) =>
  (
    input: StartExaminationWithEffectsInput,
  ): ResultAsync<InExamination, StartExaminationWithEffectsError> =>`,
  },
  { key: "resolve", code: `    resolveAppointment(deps)(input.appointmentId)` },
  { key: "found", code: `      .andThen(ensureFound(input.appointmentId))` },
  { key: "checked", code: `      .andThen(ensureCheckedIn)` },
  { key: "start", code: `      .map(startExaminationEvent(deps, input.veterinarianId))` },
  { key: "through", code: `      .andThrough(deps.examinationStartedStore.store)` },
  { key: "map", code: `      .map((event) => event.aggregateState);` },
  {
    key: "route",
    outer: true,
    file: routesPath,
    code: `return result.match(
  () => context.redirect("/", 303),
  (error) =>
    context.redirect(
      \`/?notice=\${toStartExaminationWithEffectsNoticeCode(error)}\`,
      303,
    ),
);`,
  },
  {
    key: "onError",
    outer: true,
    file: "examples/session-06-solution/src/app.ts",
    code: `app.onError((_error, context) => context.text("Internal Server Error", 500));`,
  },
];

const impls: Readonly<Record<string, Impl>> = {
  resolve: {
    stage: "resolve",
    path: startExaminationPath,
    code: `const resolveAppointment =
  (deps: EffectsDependencies) =>
  (appointmentId: AppointmentId): ResultAsync<AppointmentState | undefined, never> =>
    ResultAsync.fromSafePromise(
      Promise.resolve().then(() => deps.resolver.resolveById(appointmentId)),
    );`,
  },
  found: {
    stage: "found",
    path: startExaminationPath,
    code: `const ensureFound =
  (appointmentId: AppointmentId) =>
  (appointment: AppointmentState | undefined) =>
    ensureAppointmentFound(appointment, appointmentId);`,
    more: [
      {
        path: errorsPath,
        code: `export const ensureAppointmentFound = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Result<Appointment, AppointmentNotFound> =>
  appointment === undefined
    ? err({ kind: "AppointmentNotFound", appointmentId })
    : ok(appointment);`,
      },
    ],
  },
  checkedin: {
    stage: "checked",
    path: errorsPath,
    code: `export const ensureCheckedIn = (
  appointment: Appointment,
): Result<CheckedIn, InvalidAppointmentState> =>
  appointment.kind === "CheckedIn"
    ? ok(appointment)
    : err({ kind: "InvalidAppointmentState", actual: appointment.kind });`,
  },
  event: {
    stage: "start",
    path: startExaminationPath,
    code: `export const createEventContext = (
  deps: EventContextDependencies,
): EventContext => ({
  eventId: deps.eventIdGenerator.generate(),
  occurredAt: deps.clock.now(),
});

const startExaminationEvent =
  (deps: EffectsDependencies, veterinarianId: VeterinarianId) =>
  (appointment: CheckedIn): ExaminationStarted =>
    Appointment.startExamination(createEventContext(deps))(
      appointment,
      veterinarianId,
    );`,
  },
  transition: {
    stage: "start",
    path: "examples/session-06-solution/src/domain/appointment/transitions.ts",
    code: `const aggregateState = startExamination(
  appointment,
  veterinarianId,
  context.occurredAt,
);

return {
  kind: "ExaminationStarted",
  eventId: context.eventId,
  occurredAt: context.occurredAt,
  appointmentId: aggregateState.appointmentId,
  aggregateState,
} as const satisfies ExaminationStarted;`,
  },
  store: {
    stage: "through",
    path: storePath,
    code: `store: (event) =>
  ResultAsync.fromSafePromise(
    Promise.resolve().then(() => storeAtomically(event)),
  ).andThen((result) => result),`,
  },
  atomic: {
    stage: "through",
    path: storePath,
    code: `if (current === undefined || current.kind !== "CheckedIn") {
  return err({
    kind: "AppointmentConflict",
    appointmentId: event.appointmentId,
  } as const);
}`,
  },
  notice: {
    stage: "route",
    path: routesPath,
    code: `error.kind === "AppointmentConflict"
  ? "conflict"
  : toStartExaminationNoticeCode(error);`,
  },
};

const started = `{ kind: "ExaminationStarted", eventId: "e-1" }`;
const conflict = `{ kind: "AppointmentConflict", appointmentId: "a-1" }`;
const checkedIn = `{ kind: "CheckedIn", appointmentId: "a-1" }`;

const cards: readonly Card[] = [
  { key: "r0", stage: "resolve", tone: "ok", chip: "Ok", type: "AppointmentState | undefined", code: checkedIn, short: `{ kind: "CheckedIn", … }` },
  { key: "r1", stage: "found", tone: "ok", chip: "Ok", type: "Appointment", code: checkedIn, short: `{ kind: "CheckedIn", … }` },
  { key: "r2", stage: "checked", tone: "ok", chip: "Ok", type: "CheckedIn", code: checkedIn, short: `{ kind: "CheckedIn", … }` },
  { key: "r3", stage: "start", tone: "ok", chip: "値", type: "EventContext", code: `{ eventId: "e-1", occurredAt: "2026-08-30T06:30:00.000Z" }`, short: `{ eventId: "e-1", … }` },
  { key: "r4", stage: "start", tone: "ok", chip: "値", type: "ExaminationStarted", code: started, short: `{ kind: "ExaminationStarted", … }` },
  { key: "r5", stage: "through", tone: "ok", chip: "Ok", type: "ExaminationStarted", code: started, short: `{ kind: "ExaminationStarted", … }` },
  { key: "r5e", stage: "through", tone: "err", chip: "Err", type: "AppointmentConflict", code: conflict, short: `{ kind: "AppointmentConflict", … }` },
  { key: "r5x", stage: "through", tone: "reject", chip: "reject", type: "AppointmentPersistenceError", code: `throw new AppointmentPersistenceError("append-audit", cause);`, short: `append-audit の書き込みが失敗` },
  { key: "r6", stage: "map", tone: "ok", chip: "Ok", type: "InExamination", code: `{ kind: "InExamination", appointmentId: "a-1" }`, short: `{ kind: "InExamination", … }` },
  { key: "r7r", stage: "route", tone: "err", chip: "応答", type: "Response", code: `context.redirect("/?notice=conflict", 303)`, short: `303 /?notice=conflict` },
  { key: "r7x", stage: "onError", tone: "reject", chip: "応答", type: "Response", code: `context.text("Internal Server Error", 500)`, short: `500 Internal Server Error` },
];

const upstream = { resolve: "r0", found: "r1", checked: "r2", start: "r4" } as const;

const scenes: readonly Scene[] = [
  {
    label: "成功",
    settled: {},
    frames: [
      {
        text: "`resolveById` が予約を読みます。値は `CheckedIn` の予約です。",
        at: "resolve",
        impl: "resolve",
        lines: [4],
        out: "r0",
      },
      {
        text: "`ensureAppointmentFound` は予約があるので `ok` を返し、値をそのまま次へ渡します。",
        at: "found",
        impl: "found",
        lines: [3, 8, 10],
        out: "r1",
      },
      {
        text: "`ensureCheckedIn` は `kind` を確かめます。ここから値の型は `CheckedIn` に絞られます。",
        at: "checked",
        impl: "checkedin",
        lines: [3, 4],
        out: "r2",
      },
      {
        text: "時刻と ID はイベントを作る瞬間に要るので、`map` の中で port から読みます。`createEventContext` が1回だけ読み、その1回の値を状態と監査記録の両方が使います。",
        at: "start",
        impl: "event",
        lines: [3, 4, 10],
        out: "r3",
      },
      {
        text: "`Appointment.startExamination` が `ExaminationStarted` を作ります。失敗しない計算なので `map` です。",
        at: "start",
        impl: "transition",
        lines: [0, 1, 2, 3, 4, 6, 7, 8, 9, 10, 11, 12],
        out: "r4",
      },
      {
        text: "`andThrough` が `store` を呼びます。結果の `ok` は捨てます。保存した後もイベントを渡すので、`event` がそのまま次へ流れます。",
        at: "through",
        impl: "store",
        lines: [0, 1, 2, 3],
        out: "r5",
      },
      {
        text: "最後の `map` が `event.aggregateState` を取り出します。呼び出し元には `InExamination` が返ります。",
        at: "map",
        out: "r6",
      },
    ],
  },
  {
    label: "競合: 業務エラーの経路",
    outer: "route",
    settled: upstream,
    frames: [
      {
        text: `${sameUntil}\`event\` ができて \`store\` を呼びます。`,
        at: "through",
        impl: "store",
        lines: [0, 1, 2, 3],
      },
      {
        text: "`store` は `err` で `AppointmentConflict` を返します。業務で起こりうる失敗なので型に残ります。",
        at: "through",
        impl: "atomic",
        lines: [0, 1, 2, 3, 4, 5],
        out: "r5e",
        flow: { kind: "err", from: "through", to: "through" },
      },
      {
        text: "`andThrough` は `Err` を次へ流し、最後の `map` は実行されません。",
        at: "map",
        skipped: ["map"],
        flow: { kind: "err", from: "through", to: "map" },
      },
      {
        text: "呼び出し元の route が `Err` を受け取り、`/?notice=conflict` への 303 リダイレクトに変換します。",
        at: "route",
        impl: "notice",
        lines: [0, 1],
        out: "r7r",
        skipped: ["map"],
        flow: { kind: "err", from: "through", to: "route" },
      },
    ],
  },
  {
    label: "保存障害: 例外の経路",
    outer: "onError",
    settled: upstream,
    frames: [
      {
        text: sceneKey === "reject" ? rejectStart : `${sameUntil}\`event\` ができて \`store\` を呼びます。`,
        at: "through",
        impl: "store",
        lines: [0, 1, 2, 3],
      },
      {
        text: "SQLite の書き込みが失敗すると、`store` は `fromSafePromise` の中で reject します。`fromSafePromise` は Promise を `ResultAsync` に包み、reject は変えないので、`Err` になりません。`fromPromise` は reject を指定した `Err` に変えますが、ここでは使いません。",
        at: "through",
        impl: "store",
        lines: [1, 2],
        out: "r5x",
        flow: { kind: "reject", from: "through", to: "through" },
      },
      {
        text: "`store` の Promise が reject するので、`andThrough` は `Result` を受け取れず、最後の `map` も実行されません。reject は `Result` の経路の外へ出ます。",
        at: "map",
        skipped: ["map"],
        flow: { kind: "reject", from: "through", to: "onError" },
      },
      {
        text: page ? "例外のまま外へ出て、外側で 500 を返します。詳細は含めません。業務エラーの型は増えません。" : "外側の `app.onError` が受け取り、詳細を含まない 500 応答を返します。業務エラーの型は増えません。",
        at: "onError",
        out: "r7x",
        skipped: ["map"],
        flow: { kind: "reject", from: "through", to: "onError" },
      },
    ],
  },
];

const shownScenes =
  sceneKey === "flow"
    ? [scenes[0]]
    : sceneKey === "reject"
      ? [scenes[2]]
      : sceneKey === "two-paths"
        ? [scenes[1], scenes[2]]
        : scenes;

const frameData = shownScenes.map(({ outer, settled, frames }) => ({
  outer,
  settled,
  frames: frames.map(({ text: _text, ...frame }) => frame),
}));

const pipelineLines = quoteRows("session-06-solution", "src/useCase/startExamination.ts", [
  "resolveAppointment(deps)(input.appointmentId)",
  ".andThen(ensureFound(input.appointmentId))",
  ".andThen(ensureCheckedIn)",
  ".map(startExaminationEvent(deps, input.veterinarianId))",
  ".andThrough(deps.examinationStartedStore.store)",
  ".map((event) => event.aggregateState);",
]);
const pageRows: readonly Readonly<{ key: string; code: string; outer?: true }>[] = [
  ...(["resolve", "found", "checked", "start", "through", "map"] as const).map((key, index) => ({
    key,
    code: pipelineLines[index] ?? "",
  })),
  {
    key: "route",
    outer: true,
    code: quote(
      "session-06-solution",
      "src/web/routes.ts",
      'error.kind === "AppointmentConflict"',
      ": toStartExaminationNoticeCode(error);",
    ),
  },
  {
    key: "onError",
    outer: true,
    code: quote(
      "session-06-solution",
      "src/app.ts",
      'app.onError((_error, context) => context.text("Internal Server Error", 500));',
    ),
  },
];

const usedChips = new Set(
  shownScenes.flatMap(({ settled, frames }) => [
    ...Object.values(settled),
    ...frames.flatMap(({ out }) => (out === undefined ? [] : [out])),
  ]).flatMap((key) => cards.filter((card) => card.key === key).map((card) => card.chip)),
);
const usesFlow = shownScenes.some(({ frames }) => frames.some(({ flow }) => flow !== undefined));
const legendLines = [
  `札「Ok」は成功の箱に入った値、札「値」は箱に入る前の値${usedChips.has("応答") ? "、札「応答」は呼び出し元へ返す HTTP の応答" : ""}です。`,
  ...(usedChips.has("Err") || usesFlow
    ? ["札「Err」は型に残る業務エラー、札「reject」は型に残らず外へ出る例外です。"]
    : []),
];
---

<Walkthrough
  id="effects-pipeline-walkthrough"
  title="値がワークフローを流れる"
  lead="診察開始のワークフローのコードを上から読みます。実行中の段の下には、その段の実装と出力が開きます。成功、競合、保存障害の3つの流れを追います。"
  note="値は説明用の例です。項目は一部だけを載せています。"
  scenes={shownScenes.map(({ label, frames }) => ({ label, frames: frames.map(({ text }) => ({ text })) }))}
  page={page}
  legend={page ? legendLines.length * 1.25 + 0.5 : undefined}
>
  {page ? (
    <div class="ep ep--page" data-effects-pipeline data-frames={JSON.stringify(frameData)}>
      <div class="ep-flow">
        {pageRows.map((row) => (
          <div class="ep-stage" data-stage={row.key} data-state="future" data-outer={row.outer === true ? "" : undefined}>
            <div class="ep-stage__code">
              <Code code={row.code} lang="ts" wrap />
            </div>
            <div class="ep-sums">
              <p class="ep-skip">実行されない</p>
              {cards.filter((card) => card.stage === row.key).map((card) => (
                <p class="ep-sum" data-sum={card.key} data-tone={card.tone}>
                  <span class="ep-chip">{card.chip}</span>
                  <code class="ep-sum__type">{card.type}</code>
                  <span class="ep-sum__val">{card.short}</span>
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <div class="ep" data-effects-pipeline data-frames={JSON.stringify(frameData)}>
      <div class="ep-flow">
        {stages.map((stage) => (
          <div class={`ep-stage${stage.outer === true ? " ep-stage--outer" : ""}`} data-stage={stage.key} data-state={stage.key === "sig" ? "static" : "future"} data-outer={stage.outer === true ? "" : undefined}>
            {stage.file === undefined ? null : (
              <p class="ep-file">
                <span class="walk-badge walk-badge--after">修正後</span>
                {stage.outer === true ? <span class="ep-file__tag">パイプラインの外</span> : null}
                <code>{stage.file}</code>
              </p>
            )}
            <div class="ep-stage__code">
              <Code code={stage.code} lang="ts" wrap />
            </div>
            {stage.key === "sig" ? null : (
              <>
                <p class="ep-skip">実行されない</p>
                <div class="ep-sums">
                  {cards.filter((card) => card.stage === stage.key).map((card) => (
                    <p class="ep-sum" data-sum={card.key} data-tone={card.tone}>
                      <span class="ep-sum__arrow">→</span>
                      <span class="ep-chip">{card.chip}</span>
                      <code class="ep-sum__type">{card.type}</code>
                      <span class="ep-sum__val">{card.short}</span>
                    </p>
                  ))}
                </div>
                <div class="ep-open">
                  <div class="ep-open__clip">
                    <div class="ep-open__body">
                      {Object.entries(impls).filter(([, impl]) => impl.stage === stage.key).map(([name, impl]) => (
                        <figure class="ep-impl" data-impl={name}>
                          <figcaption>
                            <span class="walk-badge walk-badge--after">修正後</span>
                            <code>{impl.path}</code>
                          </figcaption>
                          <Code code={impl.code} lang="ts" wrap />
                          {(impl.more ?? []).map((part) => (
                            <>
                              <p class="ep-impl__file">
                                <span class="walk-badge walk-badge--after">修正後</span>
                                <code>{part.path}</code>
                              </p>
                              <Code code={part.code} lang="ts" wrap />
                            </>
                          ))}
                        </figure>
                      ))}
                      {cards.filter((card) => card.stage === stage.key).map((card) => (
                        <figure class="ep-out" data-out={card.key} data-tone={card.tone}>
                          <figcaption>
                            <span class="ep-out__label">出力</span>
                            <span class="ep-chip">{card.chip}</span>
                            <code class="ep-out__type">{card.type}</code>
                          </figcaption>
                          <Code code={card.code} lang="ts" wrap />
                        </figure>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
  <div slot="legend">
    {legendLines.map((line) => <p>{line}</p>)}
  </div>
  <style is:inline set:html={css}></style>
  <script is:inline type="module" set:html={script}></script>
</Walkthrough>
