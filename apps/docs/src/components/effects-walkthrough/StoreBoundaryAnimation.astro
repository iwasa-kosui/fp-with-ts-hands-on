---
import { Code } from "astro:components";
import type { ExampleSnapshot } from "../../sessions/types";
import css from "./store-boundary.css?raw";
import script from "./store-boundary.js?raw";
import { excerptOf, type Part } from "./excerpt";
import PathLabel from "./PathLabel.astro";
import Walkthrough from "./Walkthrough.astro";

type Box = "call" | "impl";
type Snippet = Readonly<{ box: Box; snapshot: ExampleSnapshot; path: string; parts: readonly Part[] }>;
type Pane = Readonly<{ pane: string; lines: readonly number[] }>;
type CardState = "off" | "tx" | "tx-failed" | "tx-gone" | "home" | "home-failed";
type Tx = "none" | "wait" | "open" | "commit" | "rollback" | "ended";
type SceneKey = "dual-write" | "one-save" | "save-failure" | "conflict";
type Frame = Readonly<{
  text: string;
  call: Pane | null;
  impl: Pane | null;
  tx: Tx;
  old: "CheckedIn" | "InExamination" | "none";
  state: CardState;
  audit: CardState;
  read?: boolean;
  issue?: boolean;
}>;

interface Props {
  scene?: SceneKey;
}

const { scene: sceneKey } = Astro.props;

const snippets: Readonly<Record<string, Snippet>> = {
  "before-call": {
    box: "call",
    snapshot: "session-06",
    path: "src/useCase/startExamination.ts",
    parts: [{ from: "await deps.stateStore.save(event.aggregateState);", to: "await deps.eventLog.append(event);" }],
  },
  "before-save": {
    box: "impl",
    snapshot: "session-06",
    path: "src/adaptor/secondary/sqlite/appointmentStore.ts",
    parts: [
      { from: "save: async (appointment) => saveState(database, appointment)," },
      "…",
      { from: "executor", to: ".values(row)" },
    ],
  },
  "before-append": {
    box: "impl",
    snapshot: "session-06",
    path: "src/adaptor/secondary/sqlite/appointmentStore.ts",
    parts: [
      { from: "append: async (event) => appendAudit(database, event)," },
      "…",
      { from: "executor.insert(auditLogsTable).values(toAuditRow(event)).run();" },
      "…",
      { from: 'throw new AppointmentPersistenceError("append-audit", cause);' },
    ],
  },
  "after-call": {
    box: "call",
    snapshot: "session-06-solution",
    path: "src/useCase/startExamination.ts",
    parts: [{ from: ".andThrough(deps.examinationStartedStore.store)" }],
  },
  "after-store": {
    box: "impl",
    snapshot: "session-06-solution",
    path: "src/adaptor/secondary/sqlite/examinationStartedStore.ts",
    parts: [{ from: "store: (event) =>", to: ").andThen((result) => result)," }],
  },
  "after-open": {
    box: "impl",
    snapshot: "session-06-solution",
    path: "src/adaptor/secondary/sqlite/examinationStartedStore.ts",
    parts: [
      { from: "const storeAtomically = (event: ExaminationStarted) =>" },
      { from: "database.transaction((transaction) => {" },
      "…",
    ],
  },
  "after-read": {
    box: "impl",
    snapshot: "session-06-solution",
    path: "src/adaptor/secondary/sqlite/examinationStartedStore.ts",
    parts: [
      { from: "const current = findInTransaction(transaction, event.appointmentId);", to: 'if (current === undefined || current.kind !== "CheckedIn") {' },
      "…",
    ],
  },
  "after-rebuild": {
    box: "impl",
    snapshot: "session-06-solution",
    path: "src/adaptor/secondary/sqlite/examinationStartedStore.ts",
    parts: [{ from: "const committedEvent = Appointment.startExamination({", to: "})(current, event.aggregateState.veterinarianId);" }],
  },
  "after-save": {
    box: "impl",
    snapshot: "session-06-solution",
    path: "src/adaptor/secondary/sqlite/examinationStartedStore.ts",
    parts: [
      { from: "saveState(transaction, committedEvent.aggregateState);" },
      "…",
      { from: "executor", to: ".values(row)" },
      "…",
      { from: ".run();" },
    ],
  },
  "after-audit": {
    box: "impl",
    snapshot: "session-06-solution",
    path: "src/adaptor/secondary/sqlite/examinationStartedStore.ts",
    parts: [
      { from: "appendAudit(transaction, committedEvent);" },
      "…",
      { from: "executor.insert(auditLogsTable).values(toAuditRow(event)).run();" },
      "…",
      { from: 'throw new AppointmentPersistenceError("append-audit", cause);' },
    ],
  },
};

const boxes: readonly Readonly<{ box: Box; label: string }>[] = [
  { box: "call", label: "呼び出し元のコード" },
  { box: "impl", label: "実装のコード" },
];

const appointmentCards = [
  { id: "old-CheckedIn", old: true, code: `{ status: "CheckedIn",\n  state: '{"kind":"CheckedIn",…}' }` },
  { id: "old-InExamination", old: true, code: `{ status: "InExamination",\n  state: '{"kind":"InExamination",…}' }` },
  { id: "state", old: false, code: `{ status: "InExamination",\n  state: '{"kind":"InExamination",…}' }` },
] as const;
const auditCards = [
  { id: "audit", old: false, code: `{ eventId: "e-1",\n  eventName: "ExaminationStarted" }` },
] as const;

const appointmentRows = [
  { id: "old-CheckedIn", old: true, first: "CheckedIn", second: `{"kind":"CheckedIn",…}` },
  { id: "old-InExamination", old: true, first: "InExamination", second: `{"kind":"InExamination",…}` },
  { id: "state", old: false, first: "InExamination", second: `{"kind":"InExamination",…}` },
] as const;
const auditRows = [{ id: "audit", old: false, first: "e-1", second: "ExaminationStarted" }] as const;

const excerpts = Object.fromEntries(Object.entries(snippets).map(([name, snippet]) => [name, excerptOf(snippet)]));

const allScenes: readonly Readonly<{ key: SceneKey; label: string; frames: readonly Frame[] }>[] = [
  {
    key: "dual-write",
    label: "修正前: 2回の保存",
    frames: [
      {
        text: "`event` の生成が完了しました。予約はまだ `CheckedIn` で、監査記録はありません。",
        call: null,
        impl: null,
        tx: "none",
        old: "CheckedIn",
        state: "off",
        audit: "off",
      },
      {
        text: "`stateStore.save` は `saveState(database, …)` で、`database` に直接書き込みます。`InExamination` は、その場ですぐ書き込まれます。",
        call: { pane: "before-call", lines: [0] },
        impl: { pane: "before-save", lines: [0, 3] },
        tx: "none",
        old: "none",
        state: "home",
        audit: "off",
      },
      {
        text: "次に `eventLog.append` が監査記録の書き込みを試みますが失敗し、例外を投げます。",
        call: { pane: "before-call", lines: [1] },
        impl: { pane: "before-append", lines: [2, 4] },
        tx: "none",
        old: "none",
        state: "home",
        audit: "home-failed",
      },
      {
        text: "外側が例外を受け取り、500 を返します。状態は `InExamination` のまま、`ExaminationStarted` の監査記録はありません。誰が診察を開始したかを後から確認できません。",
        call: null,
        impl: null,
        tx: "none",
        old: "none",
        state: "home",
        audit: "off",
      },
    ],
  },
  {
    key: "one-save",
    label: "修正後: 成功",
    frames: [
      {
        text: "ユースケースは `store(event)` を1回だけ呼びます。`Promise.resolve().then` は、`storeAtomically` が同期で投げた例外を、Promise（非同期処理の結果を表す値）の reject（非同期で発生した例外）にします。`fromSafePromise` は、reject を `Err` に変えず例外のまま残します。`.andThen((result) => result)` は、transaction が返した `Result` を `ResultAsync` の結果にします。",
        call: { pane: "after-call", lines: [0] },
        impl: { pane: "after-store", lines: [0, 1, 2, 3] },
        tx: "wait",
        old: "CheckedIn",
        state: "off",
        audit: "off",
      },
      {
        text: "`storeAtomically` が transaction を開始します。transaction の中の書き込みは、確定するまで取り消せます。",
        call: null,
        impl: { pane: "after-open", lines: [0, 1] },
        tx: "open",
        old: "CheckedIn",
        state: "off",
        audit: "off",
      },
      {
        text: "transaction の中で予約を再度取得し、`current` に入れます。`CheckedIn` であるため先へ進みます。",
        call: null,
        impl: { pane: "after-read", lines: [0, 1] },
        tx: "open",
        old: "CheckedIn",
        state: "off",
        audit: "off",
        read: true,
      },
      {
        text: "`Appointment.startExamination` をもう一度実行します。受け取った `event` はそのまま保存せず、読み直した最新の予約 `current` から `committedEvent` を作り直して保存します。`eventId` と `occurredAt` は `event` の値を再利用します。",
        call: null,
        impl: { pane: "after-rebuild", lines: [0, 1, 2, 3] },
        tx: "open",
        old: "CheckedIn",
        state: "off",
        audit: "off",
      },
      {
        text: "`saveState` が新しい状態を書き込みます。まだ未確定です。",
        call: null,
        impl: { pane: "after-save", lines: [0] },
        tx: "open",
        old: "CheckedIn",
        state: "tx",
        audit: "off",
      },
      {
        text: "`appendAudit` が監査記録を書き込みます。これも未確定です。",
        call: null,
        impl: { pane: "after-audit", lines: [0] },
        tx: "open",
        old: "CheckedIn",
        state: "tx",
        audit: "tx",
      },
      {
        text: "`ok(undefined)` を返すと transaction が確定し、状態と監査記録が同時に残ります。",
        call: null,
        impl: null,
        tx: "commit",
        old: "none",
        state: "home",
        audit: "home",
      },
    ],
  },
  {
    key: "save-failure",
    label: "修正後: 監査記録の保存に失敗",
    frames: [
      {
        text: "`storeAtomically` が transaction を開始します。",
        call: { pane: "after-call", lines: [0] },
        impl: { pane: "after-open", lines: [0, 1] },
        tx: "open",
        old: "CheckedIn",
        state: "off",
        audit: "off",
      },
      {
        text: "予約を再度取得します。`CheckedIn` であるため先へ進みます。",
        call: null,
        impl: { pane: "after-read", lines: [0, 1] },
        tx: "open",
        old: "CheckedIn",
        state: "off",
        audit: "off",
        read: true,
      },
      {
        text: "`saveState` が状態を書き込みます。まだ未確定です。",
        call: null,
        impl: { pane: "after-save", lines: [0] },
        tx: "open",
        old: "CheckedIn",
        state: "tx",
        audit: "off",
      },
      {
        text: "`appendAudit` が書き込みに失敗し、`AppointmentPersistenceError` を投げます。",
        call: null,
        impl: { pane: "after-audit", lines: [2, 4] },
        tx: "open",
        old: "CheckedIn",
        state: "tx",
        audit: "tx-failed",
      },
      {
        text: "例外で transaction が取り消され、未確定だった状態の行も消えます。予約は `CheckedIn` のままで、監査記録もありません。",
        call: null,
        impl: null,
        tx: "rollback",
        old: "CheckedIn",
        state: "tx-gone",
        audit: "tx-gone",
      },
      {
        text: "例外は、`store` が返す Promise の reject（非同期で発生した例外）になります。状態だけが残ることはありません。",
        call: null,
        impl: null,
        tx: "rollback",
        old: "CheckedIn",
        state: "off",
        audit: "off",
      },
    ],
  },
  {
    key: "conflict",
    label: "修正後: 競合",
    frames: [
      {
        text: "ユースケースが予約を取得した後、保存の前に、別の依頼が先に診察を開始していました。データベースの予約はすでに `InExamination` です。",
        call: null,
        impl: null,
        tx: "wait",
        old: "InExamination",
        state: "off",
        audit: "off",
        issue: true,
      },
      {
        text: "transaction の中で再取得した予約の `current.kind` は、`CheckedIn` ではありません。",
        call: null,
        impl: { pane: "after-read", lines: [0, 1] },
        tx: "open",
        old: "InExamination",
        state: "off",
        audit: "off",
        read: true,
        issue: true,
      },
      {
        text: "何も書き込まずに `err` で `AppointmentConflict` を返します。`err` も値であるため transaction は確定しますが、書き込みの前に返すため何も残らず、状態も監査記録も増えません。",
        call: null,
        impl: null,
        tx: "ended",
        old: "InExamination",
        state: "off",
        audit: "off",
        issue: true,
      },
    ],
  },
];

const page = sceneKey !== undefined;
const scenes = sceneKey === undefined ? allScenes : allScenes.filter(({ key }) => key === sceneKey);
if (scenes.length === 0) throw new Error(`StoreBoundaryAnimation: unknown scene "${sceneKey}"`);

const writtenOnly = sceneKey === "dual-write";
const hasFailure = scenes.some(({ frames }) => frames.some(({ audit }) => audit.endsWith("failed")));
const legendLines = [
  writtenOnly
    ? "「保存済み」ははじめからある行、「書き込み済み」は書き込まれた行です。破線の空枠は、まだ行がない場所です。"
    : "「保存済み」ははじめからある行、「未確定」は transaction の中だけにある行、「確定」は書き込みが残った行です。",
];
const frameData = scenes.map(({ frames }) => frames.map(({ text: _text, ...frame }) => frame));
---

<Walkthrough
  id="store-boundary-walkthrough"
  title="状態と監査記録を1回で保存する"
  lead="保存の途中で失敗が発生したとき、データベースに何が残るかを、修正前と修正後で1コマずつ追います。"
  note="行の値は説明用の例です。列は一部だけを載せています。コードの insert(...).values(...) や select(...).from(...).where(...) は、データベースを操作するライブラリ Drizzle ORM の記法です。database.transaction に渡した関数の中の書き込みは、1つの transaction にまとまります。関数が値を返すと確定し、例外を投げると取り消されます。"
  scenes={scenes.map(({ label, frames }) => ({ label, frames: frames.map(({ text }) => ({ text })) }))}
  page={page}
  legend={page ? legendLines.length * 1.25 + 0.5 : undefined}
>
  <div class:list={["sb", { "sb--page": page }]} data-store-boundary data-written-only={writtenOnly ? "" : undefined} data-frames={JSON.stringify(frameData)}>
    <div class="sb-code">
      {boxes.map(({ box, label }) => (
        <section class="sb-box" data-box={box}>
          <div class="sb-box__clip">
            <div class="sb-box__inner">
              <p class="sb-box__label">{label}</p>
              <div class="sb-stack">
                {Object.entries(snippets).filter(([, snippet]) => snippet.box === box).map(([name]) => (
                  <figure class="sb-pane" data-pane={name} data-era={name.startsWith("before") ? "before" : "after"}>
                    <figcaption>
                      <span class={`walk-badge walk-badge--${name.startsWith("before") ? "before" : "after"}`}>{name.startsWith("before") ? "修正前" : "修正後"}</span>
                      <span class="sb-cap">
                        <code><PathLabel label={excerpts[name].label} /></code>
                        <span class="sb-role">{box === "call" ? "呼び出し元" : "実装"}</span>
                      </span>
                    </figcaption>
                    <Code code={excerpts[name].code} lang="ts" wrap />
                  </figure>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
    <div class:list={["sb-diagram", { "sb-diagram--failed": hasFailure }]} aria-hidden="true" inert>
      {page ? (
        <>
        <div class="sb-db sb-db--page" data-tx="none">
          <div class="sb-db__head">
            <p class="sb-db__label">database</p>
            <p class="sb-tx__label" data-tx-label></p>
            <p class="sb-issue" data-issue>問題: 別の依頼が先に診察を開始していた</p>
          </div>
          <div class="sb-table" data-table="appointments">
            <div class="sb-table__name sb-line"><span>appointments</span><span>status（状態名）</span><span>state（中身）</span></div>
            <div class="sb-cell">
              {appointmentRows.map(({ id, old, first, second }) => (
                <div class={`sb-card sb-line${old ? " sb-card--old" : ""}`} data-card={id} data-state="off">
                  <span class="sb-chip" data-chip>{old ? "保存済み" : ""}</span>
                  <code>{first}</code>
                  <code>{second}</code>
                </div>
              ))}
            </div>
          </div>
          <div class="sb-table" data-table="audit_logs">
            <div class="sb-table__name sb-line"><span>audit_logs</span><span>eventId（ID）</span><span>eventName（種類）</span></div>
            <div class="sb-cell sb-cell--landing">
              {auditRows.map(({ id, old, first, second }) => (
                <div class={`sb-card sb-line${old ? " sb-card--old" : ""}`} data-card={id} data-state="off">
                  <span class="sb-chip" data-chip></span>
                  <code>{first}</code>
                  <code>{second}</code>
                </div>
              ))}
            </div>
          </div>
        </div>
        {hasFailure ? (
          <div class="sb-failed" data-failed>
            <p class="sb-failed__label">書き込めなかった行（audit_logs には残りません）</p>
            {auditRows.map(({ first, second }) => (
              <div class="sb-failed__row sb-line">
                <span class="sb-chip">失敗</span>
                <code>{first}</code>
                <code>{second}</code>
              </div>
            ))}
          </div>
        ) : null}
        </>
      ) : (
        <>
          <div class="sb-tx" data-tx="none">
            <p class="sb-tx__label" data-tx-label>transaction</p>
            <div class="sb-cols">
              <div class="sb-slot" data-slot="state"></div>
              <div class="sb-slot" data-slot="audit"></div>
            </div>
          </div>
          <div class="sb-db">
            <p class="sb-db__label">database</p>
            <div class="sb-cols">
              <div class="sb-table" data-table="appointments">
                <p class="sb-table__name">appointments</p>
                <div class="sb-rows">
                  <div class="sb-cell">
                    {appointmentCards.map(({ id, old, code }) => (
                      <figure class={`sb-card${old ? " sb-card--old" : ""}`} data-card={id} data-state="off">
                        <figcaption class="sb-card__head"><span class="sb-chip" data-chip>{old ? "保存済み" : ""}</span></figcaption>
                        <Code code={code} lang="ts" wrap />
                      </figure>
                    ))}
                  </div>
                </div>
              </div>
              <div class="sb-table" data-table="audit_logs">
                <p class="sb-table__name">audit_logs</p>
                <div class="sb-rows">
                  {auditCards.map(({ id, old, code }) => (
                    <div class={`sb-cell${old ? "" : " sb-cell--landing"}`}>
                      <figure class={`sb-card${old ? " sb-card--old" : ""}`} data-card={id} data-state="off">
                        <figcaption class="sb-card__head"><span class="sb-chip" data-chip>{old ? "保存済み" : ""}</span></figcaption>
                        <Code code={code} lang="ts" wrap />
                      </figure>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
  <div slot="legend">
    {legendLines.map((line) => <p>{line.split("`").map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}</p>)}
  </div>
  <style is:inline set:html={css}></style>
  <script is:inline type="module" set:html={script}></script>
</Walkthrough>
