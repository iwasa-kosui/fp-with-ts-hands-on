---
import { Code } from "astro:components";
import css from "./final-boundaries.css?raw";
import script from "./final-boundaries.js?raw";
import type { ExampleSnapshot } from "../../sessions/types";
import MiniTree from "../mini-tree/MiniTree.astro";
import { miniTree } from "../mini-tree/mini-tree";
import { excerptOf, type Part } from "./excerpt";
import PathLabel from "./PathLabel.astro";
import Walkthrough from "./Walkthrough.astro";

type Tone = "ok" | "err" | "reject";
type Gate = Readonly<{ key: string; num: string; name: string; gloss: string }>;
type Impl = Readonly<{ stage: string; snapshot: ExampleSnapshot; path: string; parts: readonly Part[] }>;
type Card = Readonly<{
  key: string;
  stage: string;
  tone: Tone;
  chip: string;
  type: string;
  code: string;
  short: string;
}>;
type Frame = Readonly<{
  text: string;
  at: string;
  impl?: string;
  lines?: readonly number[];
  out?: string;
  skipped?: readonly string[];
  gloss?: string;
  treeFile?: string;
}>;
type Scene = Readonly<{ label: string; stop?: string; frames: readonly Frame[] }>;
type Props = Readonly<{ scenes: "success" | "failures" }>;

const { scenes: sceneKind } = Astro.props;

const gates: readonly Gate[] = [
  { key: "input", num: "1", name: "入力境界", gloss: "HTTP の入力を検証し、ユースケースの入力へ変換します。" },
  { key: "business", num: "2", name: "業務上の失敗", gloss: "予約なしや状態不正などの業務上の失敗を、型付きの `Err` として返します。" },
  { key: "event", num: "3", name: "出力イベント", gloss: "業務の検証に成功した経路だけが、`ExaminationStarted` の生成へ進みます。" },
  { key: "effect", num: "4", name: "副作用", gloss: "予約の状態と監査記録を、1つの transaction で保存します。" },
  { key: "exception", num: "5", name: "例外境界", gloss: "業務の `Result` に入らない障害を、共通の境界が受け取って 500 を返します。" },
  { key: "answer", num: "", name: "応答", gloss: "route が結果を HTTP の応答に変換します。" },
];

const impls: Readonly<Record<string, Impl>> = {
  parse: {
    stage: "input",
    snapshot: "final",
    path: "src/adaptor/primary/web/routes/appointmentRoutes.ts",
    parts: [
      { from: "context.req.parseBody()," },
      "…",
      { from: "const parsed = schema.safeParse(body);" },
      "…",
      { from: ".run({ actorUserId: actor.value.user.userId, appointmentId: appointmentId.value, veterinarianId })" },
    ],
  },
  run: {
    stage: "business",
    snapshot: "final",
    path: "src/useCase/startExaminationUseCase.ts",
    parts: [
      { from: "const run =" },
      "…",
      { from: ".andThen(ensureUserFound(input.actorUserId))", to: ".andThen(ensureCheckedIn)" },
    ],
  },
  checkedin: {
    stage: "business",
    snapshot: "final",
    path: "src/useCase/errors.ts",
    parts: [
      { from: "export const ensureCheckedIn = (" },
      "…",
      { from: "appointment.kind === \"CheckedIn\"", to: "kind: \"InvalidAppointmentState\"," },
      "…",
    ],
  },
  transition: {
    stage: "event",
    snapshot: "final",
    path: "src/domain/appointment/appointment.ts",
    parts: [
      { from: "const startExamination =" },
      "…",
      { from: "): ExaminationStarted => {" },
      { from: "kind: \"InExamination\",", to: "examinationStartedAt: context.occurredAt," },
    ],
  },
  update: {
    stage: "effect",
    snapshot: "final",
    path: "src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    parts: [
      { from: "store: (...events: readonly AppointmentProjectionEvent[]) =>" },
      { from: "db.transaction((tx) => {" },
      "…",
      { from: "case \"ExaminationStarted\":", to: "return tx.update(appointmentsTable)" },
      "…",
      { from: "eq(appointmentsTable.status, \"CheckedIn\")," },
    ],
  },
  commit: {
    stage: "effect",
    snapshot: "final",
    path: "src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    parts: [
      { from: "if (changes !== 1) {" },
      "…",
      { from: "}" },
      { from: "tx.insert(domainEventsTable)" },
      "…",
      { from: ".run();" },
    ],
  },
  "commit-conflict": {
    stage: "effect",
    snapshot: "final",
    path: "src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    parts: [
      { from: 'eq(appointmentsTable.status, "CheckedIn"),' },
      "…",
      { from: "if (changes !== 1) {", to: "}" },
    ],
  },
  convert: {
    stage: "effect",
    snapshot: "final",
    path: "src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    parts: [
      { from: "const AppointmentConflictSchema = z.object({" },
      "…",
      { from: "ResultAsync.fromPromise<void, AppointmentStoreError>(" },
      "…",
      { from: "(cause): AppointmentStoreError => {" },
      { from: "const conflict = AppointmentConflictSchema.safeParse(cause);" },
      { from: "if (conflict.success) return conflict.data;" },
    ],
  },
  "update-failure": {
    stage: "effect",
    snapshot: "final",
    path: "src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    parts: [
      { from: "store: (...events: readonly AppointmentProjectionEvent[]) =>" },
      { from: "db.transaction((tx) => {" },
      "…",
      { from: "case \"ExaminationStarted\":", to: "return tx.update(appointmentsTable)" },
      "…",
      { from: ".run().changes;" },
    ],
  },
  rethrow: {
    stage: "effect",
    snapshot: "final",
    path: "src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    parts: [
      { from: "ResultAsync.fromPromise<void, AppointmentStoreError>(" },
      "…",
      { from: "(cause): AppointmentStoreError => {", to: "throw cause;" },
    ],
  },
  onError: {
    stage: "exception",
    snapshot: "final",
    path: "src/app.ts",
    parts: [
      { from: "app.onError((error) =>", to: ");" },
    ],
  },
};

const excerpts = Object.fromEntries(Object.entries(impls).map(([name, impl]) => [name, excerptOf(impl)]));

const checkedIn = `{ kind: "CheckedIn", appointmentId: "a-1", … }`;
const started = `{
  kind: "ExaminationStarted",
  eventId: "e-1",
  aggregateId: "a-1",
  aggregateState: { kind: "InExamination", … },
  eventName: "appointment.examination-started",
  occurredAt: "2026-08-30T06:30:00.000Z",
}`;
const serverError = `new Response("Internal Server Error", { status: 500 })`;

const cards: readonly Card[] = [
  {
    key: "c2",
    stage: "input",
    tone: "ok",
    chip: "値",
    type: "UseCaseInput",
    code: `{
  actorUserId: "u-1",
  appointmentId: "a-1",
  veterinarianId: "v-1",
}`,
    short: `{ actorUserId: "u-1", … }`,
  },
  { key: "c4", stage: "business", tone: "ok", chip: "Ok", type: "CheckedIn", code: checkedIn, short: `{ kind: "CheckedIn", … }` },
  {
    key: "c4e",
    stage: "business",
    tone: "err",
    chip: "Err",
    type: "InvalidAppointmentState",
    code: `{
  kind: "InvalidAppointmentState",
  appointmentId: "a-1",
  expectedKind: "CheckedIn",
  actualKind: "InExamination",
}`,
    short: `{ kind: "InvalidAppointmentState", … }`,
  },
  { key: "c5", stage: "event", tone: "ok", chip: "Ok", type: "ExaminationStarted", code: started, short: `{ kind: "ExaminationStarted", … }` },
  { key: "c7r", stage: "effect", tone: "reject", chip: "reject", type: "unknown", code: `throw cause;`, short: `SQLite の書き込みが失敗` },
  {
    key: "c7c",
    stage: "effect",
    tone: "err",
    chip: "Err",
    type: "AppointmentConflict",
    code: `{ kind: "AppointmentConflict", appointmentId: "a-1" }`,
    short: `{ kind: "AppointmentConflict", … }`,
  },
  { key: "c8", stage: "exception", tone: "reject", chip: "応答", type: "Response", code: serverError, short: `500 Internal Server Error` },
  { key: "c9a", stage: "answer", tone: "ok", chip: "応答", type: "Response", code: `context.redirect("/appointments/a-1", 303)`, short: `303 /appointments/a-1` },
  {
    key: "c9b",
    stage: "answer",
    tone: "err",
    chip: "応答",
    type: "Response",
    code: `context.redirect("/appointments/a-1?error=invalid-state", 303)`,
    short: `303 /appointments/a-1?error=invalid-state`,
  },
  {
    key: "c9d",
    stage: "answer",
    tone: "err",
    chip: "応答",
    type: "Response",
    code: `context.redirect("/appointments/a-1?error=appointment-conflict", 303)`,
    short: `303 /appointments/a-1?error=appointment-conflict`,
  },
  { key: "c9c", stage: "answer", tone: "reject", chip: "応答", type: "Response", code: serverError, short: `500 Internal Server Error` },
];

const allScenes: readonly Scene[] = [
  {
    label: "成功",
    frames: [
      {
        text: "診察開始の依頼を route の入力境界で受け取ります。`parseBody` が HTTP のフォームを読み取り、`schema.safeParse` が内容を検証します。検証を通過した値だけが、ユースケースの実行（`run`）に渡す入力（`UseCaseInput`）になります。",
        at: "input",
        impl: "parse",
        lines: [0, 2],
        out: "c2",
      },
      {
        text: "`run` は検証の関数を `andThen` でつなぎます。ユーザー、権限、予約の有無、予約が `CheckedIn` であることを順に検証し、すべて `Ok` であるため次へ進みます。",
        at: "business",
        impl: "run",
        lines: [2, 3, 4, 5, 6],
        out: "c4",
      },
      {
        text: "`Appointment.startExamination` が予約を `InExamination` に遷移させ、`ExaminationStarted` を生成します。ID と時刻は、ユースケースが port から取得し、`context` で渡します。",
        at: "event",
        impl: "transition",
        lines: [2, 3, 5],
        out: "c5",
      },
      {
        text: "`store` は transaction の中で、`status` が `CheckedIn` の予約の行だけを更新します。",
        at: "effect",
        impl: "update",
        lines: [4, 5],
      },
      {
        text: "更新が1行であるため、監査記録のテーブル `domainEventsTable` に `ExaminationStarted` を追加します。transaction に渡した関数が最後まで完了すると、状態と監査記録が同時に確定します。",
        at: "effect",
        impl: "commit",
        lines: [0, 3],
      },
      {
        text: "route の `match`（`Result` を `Ok` と `Err` で分岐する処理）が `Ok` を受け取り、詳細ページへの 303 リダイレクトを返します。例外境界は通りません。",
        at: "answer",
        out: "c9a",
        skipped: ["exception"],
      },
    ],
  },
  {
    label: "業務上の失敗",
    stop: "business",
    frames: [
      {
        text: "予約がすでに `InExamination` だったとします。入力と検証は前のページの成功と同じく通過し、`ensureCheckedIn` で `kind` が異なるため、`InvalidAppointmentState` の `Err` を返します。以降のステップは実行されません。",
        at: "business",
        impl: "checkedin",
        lines: [2, 4, 5],
        out: "c4e",
        skipped: ["event", "effect", "exception"],
      },
      {
        text: "route の `match` は `invalidState` を呼びます。応答は、`error=invalid-state` が付いた詳細ページへの 303 です。",
        at: "answer",
        out: "c9b",
        skipped: ["event", "effect", "exception"],
      },
    ],
  },
  {
    label: "競合",
    stop: "effect",
    frames: [
      {
        text: "別の依頼が先に診察を開始していたとします。`status` が `CheckedIn` の行が無いため、更新は0行で、`changes !== 1` になります。`store` は `AppointmentConflict` を `throw` し、transaction は取り消されます。",
        at: "effect",
        impl: "commit-conflict",
        lines: [0, 2, 3, 4, 5, 6],
        out: "c5",
      },
      {
        text: "`throw` された値は `fromPromise` の変換関数に渡されます。`AppointmentConflictSchema` に一致するため、`Err` の `AppointmentConflict` に戻します。",
        at: "effect",
        impl: "convert",
        lines: [0, 5, 6],
        out: "c7c",
      },
      {
        text: "route の `match` が `AppointmentConflict` を受け取り、`error=appointment-conflict` が付いた詳細ページへの 303 を返します。例外境界は通りません。",
        at: "answer",
        out: "c9d",
        skipped: ["exception"],
      },
    ],
  },
  {
    label: "SQLite 障害",
    stop: "effect",
    frames: [
      {
        text: "前のページの成功と同じくイベントまで生成し、`store` が transaction の中で予約の行を更新します。SQLite の書き込みが失敗して `run()` が例外を投げ、transaction は取り消されます。",
        at: "effect",
        impl: "update-failure",
        lines: [4, 6],
        out: "c5",
      },
      {
        text: "例外は `fromPromise` の変換関数に渡されます。競合ではないため、変換せずに `throw cause` で投げ直します。",
        at: "effect",
        impl: "rethrow",
        lines: [2, 4, 5],
        out: "c7r",
      },
      {
        text: "投げ直された例外は `Err` にならず、Hono の `app.onError` に渡されます。`app.onError` は `HTTPException`（Hono で定義された HTTP 応答を表す例外）かどうかを判定し、該当しないため、詳細を含まない 500 の `Response` を生成します。",
        at: "exception",
        impl: "onError",
        lines: [0, 1, 3],
        out: "c8",
      },
      {
        text: "route の `Err` の分岐は使われず、応答は 500 です。SQLite の障害は業務の `Result` に含まれません。",
        at: "answer",
        gloss: "例外境界が作った 500 がそのまま応答になります。",
        treeFile: "app",
        out: "c9c",
      },
    ],
  },
];

const scenes = sceneKind === "success" ? allScenes.slice(0, 1) : allScenes.slice(1);
const title = sceneKind === "success" ? "診察開始の依頼が5つの境界を通る" : "失敗の依頼が5つの境界を進む範囲";
const lead =
  sceneKind === "success"
    ? "依頼カードの値が変わり、現在通過している境界の実コードが表示されます。"
    : undefined;

const treeFiles: Readonly<Record<string, string>> = {
  parse: "routes",
  run: "useCase",
  transition: "appointment",
  update: "store",
  commit: "store",
  "commit-conflict": "store",
  "update-failure": "store",
  rethrow: "store",
  convert: "store",
  checkedin: "errors",
  onError: "app",
};

const tree = miniTree("final", "src/", [
  { folder: "adaptor/primary/web/routes/", files: [{ id: "routes", name: "appointmentRoutes.ts" }] },
  {
    folder: "useCase/",
    files: [
      { id: "useCase", name: "startExaminationUseCase.ts" },
      { id: "errors", name: "errors.ts" },
    ],
  },
  { folder: "domain/appointment/", files: [{ id: "appointment", name: "appointment.ts" }] },
  { folder: "adaptor/secondary/sqlite/store/", files: [{ id: "store", name: "appointmentEventStore.ts" }] },
  { folder: "", files: [{ id: "app", name: "app.ts" }] },
]);

const frameData = scenes.map(({ stop, frames }) => ({
  stop,
  frames: frames.map(({ text: _text, ...frame }) => ({
    ...frame,
    treeFile: frame.treeFile ?? (frame.impl === undefined ? "routes" : treeFiles[frame.impl]),
  })),
}));
const cardData = Object.fromEntries(cards.map(({ key, tone, chip, type, short }) => [key, { tone, chip, type, short }]));
---

<Walkthrough
  id="final-boundaries-walkthrough"
  title={title}
  lead={lead}
  note="値は説明用の例です。項目は一部だけを記載しています。"
  scenes={scenes.map(({ label, frames }) => ({ label, frames: frames.map(({ text }) => ({ text })) }))}
>
  <MiniTree class="fb-tree" tree={tree} />
  <div class="fb" data-final-boundaries data-kind={sceneKind} data-frames={JSON.stringify(frameData)} data-cards={JSON.stringify(cardData)}>
    <ol class="fb-list">
      {gates.map((gate) => (
        <li class="fb-stage" data-stage={gate.key} data-state="future">
          <div class="fb-head">
            <span class="fb-num">{gate.num}</span>
            <span class="fb-name">{gate.name}</span>
            <span class="fb-tag" data-tag></span>
          </div>
        </li>
      ))}
    </ol>
    <div class="fb-panel">
      <div class="fb-card" data-card data-tone="ok" aria-hidden="true">
        <p class="fb-card__head">
          <span class="fb-card__label">依頼カード</span>
          <span class="fb-chip" data-card-chip></span>
          <code class="fb-card__type" data-card-type></code>
        </p>
        <p class="fb-card__val"><code data-card-val></code></p>
      </div>
      {gates.map((gate) => (
        <div class="fb-open" data-open={gate.key}>
          <p class="fb-gloss">{gate.gloss.split("`").map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}</p>
          {Object.entries(impls).filter(([, impl]) => impl.stage === gate.key).map(([name, impl]) => (
            <figure class="fb-impl" data-impl={name}>
              <figcaption>
                <span class="walk-badge walk-badge--ref">参照実装</span>
                <code><PathLabel label={excerpts[name].label} /></code>
              </figcaption>
              <Code code={excerpts[name].code} lang="ts" wrap />
            </figure>
          ))}
          {cards.filter((card) => card.stage === gate.key).map((card) => (
            <figure class="fb-out" data-out={card.key} data-tone={card.tone}>
              <figcaption>
                <span class="fb-out__label">出力</span>
                <span class="fb-chip">{card.chip}</span>
                <code class="fb-out__type">{card.type}</code>
              </figcaption>
              <Code code={card.code} lang="ts" wrap />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>
  <style is:inline set:html={css}></style>
  <script is:inline type="module" set:html={script}></script>
</Walkthrough>
