---
import { Code } from "astro:components";
import css from "./final-boundaries.css?raw";
import script from "./final-boundaries.js?raw";
import Walkthrough from "./Walkthrough.astro";

type Tone = "ok" | "err" | "reject";
type Gate = Readonly<{ key: string; num: string; name: string; gloss: string }>;
type Impl = Readonly<{ stage: string; path: string; code: string }>;
type Card = Readonly<{
  key: string;
  stage: string;
  tone: Tone;
  chip: string;
  type: string;
  code: string;
  short: string;
}>;
type Frame = Readonly<{
  text: string;
  at: string;
  impl?: string;
  lines?: readonly number[];
  out?: string;
  skipped?: readonly string[];
}>;
type Scene = Readonly<{ label: string; stop?: string; frames: readonly Frame[] }>;
type Props = Readonly<{ scenes: "success" | "failures" }>;

const { scenes: sceneKind } = Astro.props;

const gates: readonly Gate[] = [
  { key: "input", num: "1", name: "入力境界", gloss: "HTTP の入力を検証し、ユースケースの入力へ変換します。" },
  { key: "business", num: "2", name: "業務上の失敗", gloss: "予約なしや状態不正などの業務上の失敗を、型付きの `Err` として返します。" },
  { key: "event", num: "3", name: "出力イベント", gloss: "業務の検証に成功した経路だけが、`ExaminationStarted` の生成へ進みます。" },
  { key: "effect", num: "4", name: "副作用", gloss: "予約の状態と監査記録を、1つの transaction で保存します。" },
  { key: "exception", num: "5", name: "例外境界", gloss: "業務の `Result` に入らない障害を、共通の境界が受け取って 500 を返します。" },
  { key: "answer", num: "", name: "応答", gloss: "route が結果を HTTP の応答に変換します。" },
];

const impls: Readonly<Record<string, Impl>> = {
  parse: {
    stage: "input",
    path: "examples/final/src/adaptor/primary/web/routes/appointmentRoutes.ts",
    code: `const StartExaminationSchema = z.object({
  veterinarianId: VeterinarianId.schema.optional(),
});

ResultAsync.fromPromise(
  context.req.parseBody(),
  (): ValidationError => ({
    kind: "ValidationError",
    errors: { form: "入力内容を確認してください" },
  }),
).andThen((body) => {
  const parsed = schema.safeParse(body);
  return parsed.success
    ? ok(parsed.data)
    : err({
        kind: "ValidationError",
        errors: issuesToFieldErrors(parsed.error.issues),
      } as const satisfies ValidationError);
});`,
  },
  run: {
    stage: "business",
    path: "examples/final/src/useCase/startExaminationUseCase.ts",
    code: `(input: UseCaseInput): UseCaseOutput =>
  userResolver
    .resolveById(input.actorUserId)
    .andThen(ensureUserFound(input.actorUserId))
    .andThen(ensureCanStartExamination(input.veterinarianId))
    .andThen(() => appointmentResolver.resolveById(input.appointmentId))
    .andThen(ensureAppointmentFound(input.appointmentId))
    .andThen(ensureCheckedIn)
    .andThen(createEvent({ clock, eventIdGenerator }, input))
    .andThrough(examinationStartedStore.store)
    .map((event) => ({ appointment: event.aggregateState }));`,
  },
  checkedin: {
    stage: "business",
    path: "examples/final/src/useCase/errors.ts",
    code: `export const ensureCheckedIn = (
  appointment: Appointment,
): Result<CheckedIn, InvalidAppointmentState> =>
  appointment.kind === "CheckedIn"
    ? ok(appointment)
    : err({
        kind: "InvalidAppointmentState",
        appointmentId: appointment.appointmentId,
        expectedKind: "CheckedIn",
        actualKind: appointment.kind,
      });`,
  },
  transition: {
    stage: "event",
    path: "examples/final/src/domain/appointment/appointment.ts",
    code: `const startExamination =
  (context: EventContext) =>
  (
    checkedIn: CheckedIn,
    veterinarianId: VeterinarianId,
  ): ExaminationStarted => {
    const aggregateState = {
      ...checkedIn,
      kind: "InExamination",
      veterinarianId,
      examinationStartedAt: context.occurredAt,
    } as const satisfies InExamination;

    return AppointmentEvent.create(
      context,
      aggregateState.appointmentId,
      aggregateState,
      "ExaminationStarted",
      "appointment.examination-started",
      { appointmentId: aggregateState.appointmentId, veterinarianId },
    );
  };`,
  },
  update: {
    stage: "effect",
    path: "examples/final/src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    code: `store: (...events: readonly AppointmentProjectionEvent[]) =>
  ResultAsync.fromPromise<void, AppointmentStoreError>(
    Promise.resolve().then(() =>
      db.transaction((tx) => {
        events.forEach((event) => {

case "ExaminationStarted":
  return tx.update(appointmentsTable)
    .set(values)
    .where(and(
      eq(appointmentsTable.appointmentId, state.appointmentId),
      eq(appointmentsTable.status, "CheckedIn"),
    ))
    .run().changes;`,
  },
  commit: {
    stage: "effect",
    path: "examples/final/src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    code: `if (changes !== 1) {
  throw {
    kind: "AppointmentConflict",
    appointmentId: event.aggregateId,
  } as const;
}
tx.insert(domainEventsTable)
  .values(toEventRecord(
    event,
    safeState(state),
    safePayload(event),
  ))
  .run();`,
  },
  convert: {
    stage: "effect",
    path: "examples/final/src/adaptor/secondary/sqlite/store/appointmentEventStore.ts",
    code: `const AppointmentConflictSchema = z.object({
  kind: z.literal("AppointmentConflict"),
  appointmentId: AppointmentId.schema,
});

(cause): AppointmentStoreError => {
  const conflict = AppointmentConflictSchema.safeParse(cause);
  if (conflict.success) return conflict.data;
  throw cause;
},`,
  },
  onError: {
    stage: "exception",
    path: "examples/final/src/app.ts",
    code: `app.onError((error) =>
  error instanceof HTTPException
    ? error.getResponse()
    : new Response("Internal Server Error", { status: 500 }),
);`,
  },
};

const checkedIn = `{ kind: "CheckedIn", appointmentId: "a-1", … }`;
const started = `{
  kind: "ExaminationStarted",
  eventId: "e-1",
  aggregateId: "a-1",
  aggregateState: { kind: "InExamination", … },
  eventName: "appointment.examination-started",
  occurredAt: "2026-08-30T06:30:00.000Z",
}`;
const serverError = `new Response("Internal Server Error", { status: 500 })`;

const cards: readonly Card[] = [
  {
    key: "c2",
    stage: "input",
    tone: "ok",
    chip: "値",
    type: "UseCaseInput",
    code: `{
  actorUserId: "u-1",
  appointmentId: "a-1",
  veterinarianId: "v-1",
}`,
    short: `{ actorUserId: "u-1", … }`,
  },
  { key: "c4", stage: "business", tone: "ok", chip: "Ok", type: "CheckedIn", code: checkedIn, short: `{ kind: "CheckedIn", … }` },
  {
    key: "c4e",
    stage: "business",
    tone: "err",
    chip: "Err",
    type: "InvalidAppointmentState",
    code: `{
  kind: "InvalidAppointmentState",
  appointmentId: "a-1",
  expectedKind: "CheckedIn",
  actualKind: "InExamination",
}`,
    short: `{ kind: "InvalidAppointmentState", … }`,
  },
  { key: "c5", stage: "event", tone: "ok", chip: "Ok", type: "ExaminationStarted", code: started, short: `{ kind: "ExaminationStarted", … }` },
  { key: "c7r", stage: "effect", tone: "reject", chip: "reject", type: "unknown", code: `throw cause;`, short: `SQLite の書き込みが失敗` },
  { key: "c8", stage: "exception", tone: "reject", chip: "応答", type: "Response", code: serverError, short: `500 Internal Server Error` },
  { key: "c9a", stage: "answer", tone: "ok", chip: "応答", type: "Response", code: `context.redirect("/appointments/a-1", 303)`, short: `303 /appointments/a-1` },
  {
    key: "c9b",
    stage: "answer",
    tone: "err",
    chip: "応答",
    type: "Response",
    code: `context.redirect("/appointments/a-1?error=invalid-state", 303)`,
    short: `303 /appointments/a-1?error=invalid-state`,
  },
  { key: "c9c", stage: "answer", tone: "reject", chip: "応答", type: "Response", code: serverError, short: `500 Internal Server Error` },
];

const allScenes: readonly Scene[] = [
  {
    label: "成功",
    frames: [
      {
        text: "診察開始の依頼が route の入力境界に届きます。`parseBody` が `safeParse` で入力を検証します。通った値だけが、`run` へ渡す入力（`UseCaseInput`）になります。",
        at: "input",
        impl: "parse",
        lines: [5, 11],
        out: "c2",
      },
      {
        text: "`run` は確認の関数を `andThen` でつなぎます。ユーザー、権限、予約の有無、予約が `CheckedIn` であることを順に確かめ、すべて `Ok` なので次へ進みます。",
        at: "business",
        impl: "run",
        lines: [1, 2, 3, 4, 5, 6, 7],
        out: "c4",
      },
      {
        text: "`Appointment.startExamination` が予約を `InExamination` に進め、`ExaminationStarted` を作ります。ID と時刻は、`eventIdGenerator` と `clock` から受け取ります。",
        at: "event",
        impl: "transition",
        lines: [8, 10, 13],
        out: "c5",
      },
      {
        text: "`store` は transaction の中で、`status` が `CheckedIn` の予約の行だけを更新します。",
        at: "effect",
        impl: "update",
        lines: [7, 10, 11],
      },
      {
        text: "更新が1行なので、監査記録のテーブル `domainEventsTable` に `ExaminationStarted` を追加します。transaction に渡した関数が最後まで終わると、状態と監査記録が同時に確定します。",
        at: "effect",
        impl: "commit",
        lines: [0, 6],
      },
      {
        text: "route の `match` が `Ok` を受け取り、詳細ページへの 303 リダイレクトを返します。例外境界は通りません。",
        at: "answer",
        out: "c9a",
        skipped: ["exception"],
      },
    ],
  },
  {
    label: "業務上の失敗",
    stop: "business",
    frames: [
      {
        text: "予約がすでに `InExamination` だったとします。入力と確認は前のページの成功と同じく通り、`ensureCheckedIn` で `kind` が違うので、`InvalidAppointmentState` の `Err` を返します。以降の段は実行されません。",
        at: "business",
        impl: "checkedin",
        lines: [3, 5, 6],
        out: "c4e",
        skipped: ["event", "effect", "exception"],
      },
      {
        text: "route の `match` は `invalidState` を呼びます。応答は、`error=invalid-state` が付いた詳細ページへの 303 です。",
        at: "answer",
        out: "c9b",
        skipped: ["event", "effect", "exception"],
      },
    ],
  },
  {
    label: "SQLite 障害",
    stop: "effect",
    frames: [
      {
        text: "前のページの成功と同じくイベントまで作り、`store` が transaction の中で予約の行を更新します。SQLite の書き込みが失敗して `run()` が例外を投げ、transaction は取り消されます。",
        at: "effect",
        impl: "update",
        lines: [7, 13],
        out: "c5",
      },
      {
        text: "例外は `fromPromise` の変換関数に届きます。競合ではないので、変換せずに `throw cause` で投げ直します。",
        at: "effect",
        impl: "convert",
        lines: [5, 7, 8],
        out: "c7r",
      },
      {
        text: "投げ直された例外は `Err` にならず、Hono の `app.onError` に届きます。`app.onError` は `HTTPException`（Hono で決まった HTTP 応答を表す例外）かどうかを調べ、違うので、詳細を含まない 500 の `Response` を作ります。",
        at: "exception",
        impl: "onError",
        lines: [0, 1, 3],
        out: "c8",
      },
      {
        text: "route の `Err` の分岐は使われず、応答は 500 です。SQLite の障害は業務の `Result` に入りません。",
        at: "answer",
        out: "c9c",
      },
    ],
  },
];

const scenes = sceneKind === "success" ? allScenes.slice(0, 1) : allScenes.slice(1);
const title = sceneKind === "success" ? "診察開始の依頼が5つの境界を通る" : "失敗の依頼が5つの境界のどこまで進むか";
const lead =
  sceneKind === "success"
    ? "依頼カードの値が変わり、いま通っている境界の実コードと出力が開きます。"
    : undefined;

const frameData = scenes.map(({ stop, frames }) => ({
  stop,
  frames: frames.map(({ text: _text, ...frame }) => frame),
}));
const cardData = Object.fromEntries(cards.map(({ key, tone, chip, type, short }) => [key, { tone, chip, type, short }]));
---

<Walkthrough
  id="final-boundaries-walkthrough"
  title={title}
  lead={lead}
  note="値は説明用の例です。項目は一部だけを載せています。"
  scenes={scenes.map(({ label, frames }) => ({ label, frames: frames.map(({ text }) => ({ text })) }))}
>
  <div class="fb" data-final-boundaries data-kind={sceneKind} data-frames={JSON.stringify(frameData)} data-cards={JSON.stringify(cardData)}>
    <ol class="fb-list">
      {gates.map((gate) => (
        <li class="fb-stage" data-stage={gate.key} data-state="future">
          <div class="fb-head">
            <span class="fb-num">{gate.num}</span>
            <span class="fb-name">{gate.name}</span>
            <span class="fb-tag" data-tag></span>
          </div>
        </li>
      ))}
    </ol>
    <div class="fb-panel">
      <div class="fb-card" data-card data-tone="ok" aria-hidden="true">
        <p class="fb-card__head">
          <span class="fb-card__label">依頼カード</span>
          <span class="fb-chip" data-card-chip></span>
          <code class="fb-card__type" data-card-type></code>
        </p>
        <p class="fb-card__val"><code data-card-val></code></p>
      </div>
      {gates.map((gate) => (
        <div class="fb-open" data-open={gate.key}>
          <p class="fb-gloss">{gate.gloss.split("`").map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}</p>
          {Object.entries(impls).filter(([, impl]) => impl.stage === gate.key).map(([name, impl]) => (
            <figure class="fb-impl" data-impl={name}>
              <figcaption>
                <span class="walk-badge walk-badge--ref">参照実装</span>
                <code>{impl.path}</code>
              </figcaption>
              <Code code={impl.code} lang="ts" wrap />
            </figure>
          ))}
          {cards.filter((card) => card.stage === gate.key).map((card) => (
            <figure class="fb-out" data-out={card.key} data-tone={card.tone}>
              <figcaption>
                <span class="fb-out__label">出力</span>
                <span class="fb-chip">{card.chip}</span>
                <code class="fb-out__type">{card.type}</code>
              </figcaption>
              <Code code={card.code} lang="ts" wrap />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>
  <style is:inline set:html={css}></style>
  <script is:inline type="module" set:html={script}></script>
</Walkthrough>
