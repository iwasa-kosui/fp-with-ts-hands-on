---
import { Code } from "astro:components";
import "./step-figure.css";

const lintShape = `"no-restricted-syntax": ["error", {
  selector: "CallExpression[callee.object.name='crypto'][callee.property.name='randomUUID']",
  message: "ID を直接作らず、ID generator から受け取ります。",
}, {
  selector: "NewExpression[callee.name='Date'][…]",
  message: "…",
}]`;

const testShape = `store: (event) => {
  storeCalls += 1;
  …
},

expect(harness.storeCalls).toBe(1);`;

const cards = [
  {
    id: "lint",
    name: "Linter の no-restricted-syntax",
    about: "コードの構文を selector の形で指定して、その形の書き方を探す",
    shape: lintShape,
    catches: "規則に書いた形の書き方。引数なしの new Date() や crypto.randomUUID() の呼び出し。",
    misses: "規則に書いていない別の書き方。",
    note: "selector の […] には、検出する範囲を絞る条件を書きます。引数の個数は `[arguments.length=…]` で絞れます。",
  },
  {
    id: "test",
    name: "fake の store を使うテスト",
    about: "fake の store と clock を渡して、呼ばれた回数と結果を確かめる",
    shape: testShape,
    catches: "store を2回呼ぶ保存の分割。clock を読み直して、時刻がずれること。",
    misses: "fake に書いていない動き。fake はメモリ上で動くので、本物の永続化層の振る舞いは確かめられない。",
    note: "テストが確かめるのは、書いた期待だけです。期待に書いていない悪い変更は、すり抜けます。",
  },
] as const;
---

<div class="erc" role="list" aria-label="悪い変更を検出する仕組みの候補">
  {cards.map((card) => (
    <section class="erc__card" role="listitem" data-card={card.id}>
      <h4 class="erc__name">{card.name}</h4>
      <p class="erc__about">{card.about}</p>
      <figure class="sf-code erc__shape">
        <figcaption>形</figcaption>
        <Code code={card.shape} lang="ts" wrap />
      </figure>
      <p class="erc__row erc__row--catch"><span class="erc__label">✓ 検出できること</span>{card.catches}</p>
      <p class="erc__row erc__row--miss"><span class="erc__label">✗ すり抜けること</span>{card.misses}</p>
      <p class="erc__note">{card.note.split("`").map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}</p>
    </section>
  ))}
</div>

<style>
  .erc {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0.25rem 0;
    color: var(--role-text);
  }

  .erc__card {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-inline-start-width: 0.5rem;
    background: var(--role-surface);
  }

  .erc__card p,
  .erc__card h4 {
    margin: 0;
  }

  .erc__name {
    font-size: 1rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .erc__about {
    color: var(--role-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .erc__shape :global(pre) {
    font-size: 0.78125rem;
  }

  .erc__row {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .erc__label {
    display: inline;
    margin-inline-end: 0.5rem;
    font-weight: 800;
  }

  .erc__row--catch .erc__label {
    color: var(--role-positive);
  }

  .erc__row--miss .erc__label {
    color: var(--role-negative);
  }

  .erc__note {
    padding: 0.25rem 0.5rem;
    border-inline-start: 4px solid var(--role-border);
    background: var(--role-bg);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-height: 760px) {
    .erc__card {
      gap: 0.25rem;
      padding-block: 0.375rem;
    }

    .erc__shape :global(pre) {
      padding-block: 0.375rem;
      font-size: 0.75rem;
      line-height: 1.4;
    }
  }

  @media (max-width: 44rem) {
    .erc {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
