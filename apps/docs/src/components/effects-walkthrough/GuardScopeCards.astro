---
const groups = [
  {
    key: "machine",
    title: "機械が検出するもの",
    mark: "✓ 機械が検出",
    items: [
      {
        name: "直接の時刻と ID の生成",
        by: "Linter の no-restricted-syntax",
        about: "new Date()、Date.now()、crypto.randomUUID() を、clock と ID generator を通さずに呼ぶ実装。",
      },
      {
        name: "保存の分割",
        by: "fake の store を使うテスト",
        about: "状態と監査記録のために、store を2回呼ぶ実装。",
      },
    ],
  },
  {
    key: "human",
    title: "この演習の仕組みでは検出できないもの",
    mark: "✗ 検出できない",
    items: [
      {
        name: "別のファイルの補助関数の中の呼び出し",
        by: "ファイルを開いて確認する担当者",
        about: "この Linter のルールが検査するのは、診察開始のファイルです。別のファイルにある補助関数の中で時刻を取得していても、ルールは検出しません。テストは、期待値に影響するときだけ検出します。",
      },
      {
        name: "本番の永続化層の原子性",
        by: "保存先を使う結合テスト",
        about: "fake の store はメモリ上で動きます。本物の transaction が、全部残るか全部消えるかのどちらかになることは、この演習の仕組みでは検証しません。",
      },
    ],
  },
] as const;
---

<div class="gsc" aria-label="機械が検出するものと、この演習の仕組みでは検出できないもの">
  {groups.map((group) => (
    <section class={`gsc__group gsc__group--${group.key}`}>
      <h4>
        <span class="gsc__mark">{group.mark}</span>
        {group.title}
      </h4>
      <ul>
        {group.items.map((item) => (
          <li class="gsc__card">
            <p class="gsc__name">{item.name}</p>
            <p class="gsc__by"><span>検出する担当者・仕組み</span>{item.by}</p>
            <p class="gsc__about">{item.about}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .gsc {
    --tone: var(--role-border);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0.25rem 0;
    color: var(--role-text);
  }

  .gsc__group {
    min-width: 0;
    padding: 0.5rem 0.75rem 0.25rem;
    border: 2px solid var(--tone);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--tone) 10%, var(--role-surface));
  }

  .gsc__group--machine {
    --tone: var(--role-positive);
  }

  .gsc__group--human {
    --tone: var(--role-accent);
    border-style: dashed;
  }

  .gsc__group h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .gsc__mark {
    padding: 0 0.5rem;
    border: 2px solid var(--tone);
    border-radius: 0.375rem;
    background: var(--role-surface);
    color: var(--tone);
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.5;
    white-space: nowrap;
  }

  .gsc__group ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gsc__card {
    display: grid;
    gap: 0.125rem;
    margin-block-end: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--role-border);
    border-inline-start: 8px solid var(--tone);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .gsc__card p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .gsc__card .gsc__name {
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .gsc__by span {
    margin-inline-end: 0.5rem;
    color: var(--role-muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  @media (max-width: 40rem) {
    .gsc {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
