---
import { Code } from "astro:components";
import MiniTree from "../mini-tree/MiniTree.astro";
import { miniTree } from "../mini-tree/mini-tree";
import StepControls from "../stepper/StepControls.astro";
import { breakBeforeMember } from "../break-before-member";
import { quote } from "./quote";
import "./step-figure.css";

const lineOf = (source: string, needle: string) => {
  const index = source.split("\n").findIndex((line) => line.includes(needle));
  if (index < 0) throw new Error(`PortSwapFlow: "${needle}" is not in the excerpt`);
  return index;
};

const useCasePath = "src/useCase/startExamination.ts";
const resolverCode = quote("session-04-solution", useCasePath, "deps.resolver.resolveById(input.appointmentId),");
const storeCode = quote("session-06-solution", useCasePath, ".andThrough(deps.examinationStartedStore.store)");
const storeType = quote(
  "session-06-solution",
  "src/useCase/dependencies.ts",
  "export type ExaminationStartedStore = Readonly<{",
  "}>;",
);
const contextDeps = quote(
  "session-06-solution",
  "src/useCase/dependencies.ts",
  "export type EventContextDependencies = Readonly<{",
  "}>;",
);
const clockType = quote("session-06-solution", "src/domain/aggregate/clock.ts", "export type Clock = Readonly<{", "}>;");
const generatorType = quote(
  "session-06-solution",
  "src/domain/aggregate/eventIdGenerator.ts",
  "export type EventIdGenerator = Readonly<{",
  "}>;",
);
const sqliteCode = quote(
  "session-06-solution",
  "src/app.ts",
  "const store = createExaminationStartedStore(",
  ");",
);
const effectsCode = quote(
  "session-06-solution",
  "src/app.ts",
  "const defaultEffects: EventContextDependencies = {",
  "};",
);
const fakeCode = quote(
  "session-06-solution",
  "test/in-memory-store.test.ts",
  "const adapter = createInMemoryExaminationStartedStore([checkedIn]);",
  "})(input);",
);

const lit = JSON.stringify([
  {
    resolver: [lineOf(resolverCode, "deps.resolver")],
    store: [0],
    storeType: [lineOf(storeType, "store:")],
  },
  {
    context: [lineOf(contextDeps, "clock:"), lineOf(contextDeps, "eventIdGenerator:")],
    clock: [lineOf(clockType, "now:")],
    generator: [lineOf(generatorType, "generate:")],
  },
  {
    sqlite: [0],
    effects: [1, 2],
  },
  {
    fake: [
      lineOf(fakeCode, "createInMemoryExaminationStartedStore"),
      lineOf(fakeCode, "resolver:"),
      lineOf(fakeCode, "examinationStartedStore:"),
      lineOf(fakeCode, "clock:"),
      lineOf(fakeCode, "eventIdGenerator:"),
    ],
  },
]);

const tree = miniTree("session-06-solution", "", [
  {
    folder: "src/useCase/",
    files: [
      { id: "start", name: "startExamination.ts", note: "startExamination（S04）\nstartExaminationWithEffects（S06）" },
      { id: "dependencies", name: "dependencies.ts" },
    ],
  },
  {
    folder: "src/domain/aggregate/",
    files: [
      { id: "clock", name: "clock.ts" },
      { id: "eventIdGenerator", name: "eventIdGenerator.ts" },
    ],
  },
  { folder: "src/", files: [{ id: "app", name: "app.ts" }] },
  { folder: "test/", files: [{ id: "fake", name: "in-memory-store.test.ts" }] },
]);

const treeCurrent = [["start", "dependencies"], ["dependencies", "clock", "eventIdGenerator"], ["app"], ["fake"]] as const;

const frames = [
  "`deps.resolver`（S04）と `deps.examinationStartedStore`（S06）は、ユースケースが `deps` を通して外部に要求する処理です。ユースケースが外部に要求する処理の型を、port と呼びます。",
  "時刻と ID の取得も外部の処理です。`Clock` は「現在の時刻を返す」処理の型、`EventIdGenerator` は「新しい ID を返す」処理の型で、どちらも port です。ユースケースは処理の型だけを参照します。",
  "本番では、port に本番の実装を渡します。`app.ts` の `createExaminationStartedStore` は SQLite の resolver と store を作り、`defaultEffects` は `new Date()` を呼ぶ `clock` と `randomUUID()` を呼ぶ `eventIdGenerator` を作ります。",
  "テストでは、同じユースケースの port にテスト用の実装（fake）を渡します。メモリ上の store と、固定の時刻と ID を返す `clock` と `eventIdGenerator` を渡すため、ユースケースのコードを変更せずに結果を固定できます。",
] as const;

const ports = [
  {
    key: "resolver",
    name: ["deps", ".resolver"],
    from: 0,
    real: ["SQLite", ["データベースから", "予約を", "取得する"]],
    fake: ["fake の resolver", ["メモリ上の", "予約を返す"]],
  },
  {
    key: "store",
    name: ["deps", ".examinationStartedStore"],
    from: 0,
    real: ["SQLite", ["データベースへ", "保存する"]],
    fake: ["fake の store", ["メモリ上に保存し、", "呼ばれた回数を", "数える"]],
  },
  {
    key: "clock",
    name: ["deps", ".clock"],
    from: 1,
    real: ["new Date()", ["現在の時刻を", "返す"]],
    fake: ["固定の時刻", [{ keep: "2026-08-30T06:30:00.000Z" }, " を返す"]],
  },
  {
    key: "id",
    name: ["deps", ".eventIdGenerator"],
    from: 1,
    real: ["randomUUID()", ["実行のたびに", "新しい ID を", "返す"]],
    fake: ["固定の ID", ["常に同じ ID を", "返す"]],
  },
] as const;
---

<figure class="sf psf" data-port-swap data-step-figure data-lit={lit} data-tree-current={JSON.stringify(treeCurrent)} aria-label="port に本番の実装とテスト用の実装（fake）を差し替える流れ">
  <StepControls />

  <div aria-live="polite">
    <ol class="sf-frames">
      {frames.map((frame) => (
        <li data-frame>
          <p class="sf-caption">{frame.split("`").map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}</p>
        </li>
      ))}
    </ol>
  </div>

  <MiniTree class="psf__tree" tree={tree} current={treeCurrent[0]} />

  <div class="sf-stage psf__stage">
    <div class="psf__codes">
      <div class="psf__group" data-group="0">
        <figure class="sf-code" data-code="resolver" data-ports={JSON.stringify([lineOf(resolverCode, "deps.resolver")])}>
          <figcaption><code>startExamination.ts</code><span class="sf-tag sf-tag--before">S04</span></figcaption>
          <Code code={resolverCode} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
        <figure class="sf-code" data-code="store" data-ports={JSON.stringify([0])}>
          <figcaption><code>startExamination.ts</code><span class="sf-tag">S06</span></figcaption>
          <Code code={storeCode} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
        <figure class="sf-code" data-code="storeType" data-ports={JSON.stringify([0])}>
          <figcaption><code>dependencies.ts</code><span class="sf-tag">S06</span></figcaption>
          <Code code={storeType} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
      </div>

      <div class="psf__group psf__group--grid" data-group="1">
        <figure class="sf-code psf__wide" data-code="context" data-ports={JSON.stringify([lineOf(contextDeps, "clock:"), lineOf(contextDeps, "eventIdGenerator:")])}>
          <figcaption><code>dependencies.ts</code></figcaption>
          <Code code={contextDeps} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
        <figure class="sf-code" data-code="clock">
          <figcaption><code>clock.ts</code></figcaption>
          <Code code={clockType} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
        <figure class="sf-code" data-code="generator">
          <figcaption><code>eventIdGenerator.ts</code></figcaption>
          <Code code={generatorType} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
      </div>

      <div class="psf__group" data-group="2">
        <figure class="sf-code psf__wide" data-code="sqlite">
          <figcaption><code>app.ts</code></figcaption>
          <Code code={sqliteCode} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
        <figure class="sf-code psf__wide" data-code="effects">
          <figcaption><code>app.ts</code></figcaption>
          <Code code={effectsCode} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
      </div>

      <div class="psf__group" data-group="3">
        <figure class="sf-code" data-code="fake">
          <figcaption><code>in-memory-store.test.ts</code></figcaption>
          <Code code={fakeCode} lang="ts" wrap transformers={[breakBeforeMember]} />
        </figure>
      </div>
    </div>

    <div class="psf__diagram">
      <div class="psf__head">
        <span class="psf__title">useCase</span>
        <span class="psf__era" data-era="2"><span class="sf-tag">本番の実装</span></span>
        <span class="psf__era" data-era="3"><span class="sf-tag sf-tag--empty">テスト用の実装（fake）</span></span>
        <p class="psf__same">ユースケースの<wbr />コードは、<wbr />どちらでも<wbr />同じです。</p>
      </div>
      <ul class="psf__rows">
        {ports.map((port) => (
          <li class="psf__row" data-from={port.from}>
            <span class="psf__socket">
              <span class="sf-tag">port</span>
              <code>{port.name.map((part, i) => (<Fragment>{i > 0 && <wbr />}{part}</Fragment>))}</code>
            </span>
            <span class="psf__slot">
              <span class="psf__plug psf__plug--none">何も<wbr>つながって<wbr>いません</span>
              <span class="psf__plug psf__plug--real"><strong>{port.real[0]}</strong><small>{port.real[1].map((part, i) => (<Fragment>{i > 0 && <wbr />}{part}</Fragment>))}</small></span>
              <span class="psf__plug psf__plug--fake"><strong>{port.fake[0]}</strong><small>{port.fake[1].map((part, i) => (<Fragment>{i > 0 && <wbr />}{typeof part === "string" ? part : <span class="psf__keep">{part.keep}</span>}</Fragment>))}</small></span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

</figure>

<script>
  import { setMiniTreeCurrent } from "../mini-tree/mini-tree-client";
  import { mountLitFigure } from "./lit-figure";

  document.querySelectorAll<HTMLElement>("[data-port-swap]").forEach((root) => {
    const treeCurrent = JSON.parse(root.dataset.treeCurrent ?? "[]") as string[][];
    root.querySelectorAll<HTMLElement>("[data-ports]").forEach((panel) => {
      const marked = JSON.parse(panel.dataset.ports ?? "[]") as number[];
      panel.querySelectorAll(".line").forEach((line, index) => {
        if (!marked.includes(index)) return;
        const tag = document.createElement("span");
        tag.className = "psf__port-tag";
        tag.textContent = "port";
        line.append(tag);
      });
    });
    mountLitFigure(root, (index) => setMiniTreeCurrent(root, treeCurrent[index] ?? []));
  });
</script>

<style>
  .psf.sf[data-ready] {
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
  }

  .psf :global(.psf__tree) {
    margin-block-end: 0.5rem;
  }

  .psf :global(.mini-tree__file) {
    display: inline-flex;
    flex-direction: column;
  }

  .psf :global(.mini-tree__note) {
    margin-inline-start: 0;
    font-size: 0.625rem;
    white-space: pre-line;
  }

  .psf__stage {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: 1rem;
  }

  .psf__codes {
    display: grid;
    min-width: 0;
    min-height: 0;
    overflow: auto;
  }

  .psf__group {
    display: grid;
    grid-area: 1 / 1;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
  }

  .psf__group--grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .psf__wide {
    grid-column: 1 / -1;
  }

  .psf__codes :global(figcaption code) {
    white-space: nowrap;
  }

  .psf__codes :global(.psf__port-tag) {
    margin-inline-start: 0.75rem;
    padding: 0 0.4rem;
    border: 2px solid var(--frame-code-text, var(--role-surface));
    border-radius: 0.3rem;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .psf__diagram {
    display: grid;
    container-type: inline-size;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.5rem;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .psf__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    min-height: 1.75rem;
  }

  .psf__title {
    font-weight: 800;
  }

  .psf__era {
    display: none;
  }

  .psf__rows {
    display: grid;
    grid-template-rows: repeat(4, minmax(0, 1fr));
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .psf__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
  }

  .psf__socket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    min-width: 0;
  }

  .psf__socket code {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .psf__slot {
    display: grid;
    align-self: stretch;
    min-width: 0;
  }

  .psf__plug {
    display: grid;
    grid-area: 1 / 1;
    align-content: center;
    min-width: 0;
    padding: 0.125rem 0.625rem;
    border: 2px solid var(--role-border);
    border-radius: 0.375rem;
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .psf__keep {
    white-space: nowrap;
  }

  .psf__plug strong {
    font-size: 0.875rem;
  }

  .psf__plug small {
    color: var(--role-muted);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .psf__plug--none {
    border-style: dashed;
    color: var(--role-muted);
    font-size: 0.8125rem;
  }

  .psf__plug--real {
    border-color: var(--role-accent);
    background: color-mix(in srgb, var(--role-accent) 10%, var(--role-surface));
  }

  .psf__plug--fake {
    border-style: dashed;
    border-color: var(--role-text);
    background: var(--role-bg);
  }

  .psf__same {
    flex: 1 1 12em;
    text-align: right;
    word-break: keep-all;
    overflow-wrap: anywhere;
    margin: 0 0 0 auto;
    color: var(--role-muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .psf:not([data-ready]) .psf__group {
    grid-area: auto;
  }

  .psf:not([data-ready]) .psf__plug--none,
  .psf:not([data-ready]) .psf__plug--fake {
    display: none;
  }

  .psf[data-ready] .psf__group,
  .psf[data-ready] .psf__plug,
  .psf[data-ready] .psf__row {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s, transform 0.35s, visibility 0s linear 0.35s;
  }

  .psf[data-ready][data-step="0"] [data-group="0"],
  .psf[data-ready][data-step="1"] [data-group="1"],
  .psf[data-ready][data-step="2"] [data-group="2"],
  .psf[data-ready][data-step="3"] [data-group="3"],
  .psf[data-ready][data-step="0"] .psf__plug--none,
  .psf[data-ready][data-step="1"] .psf__plug--none,
  .psf[data-ready][data-step="2"] .psf__plug--real,
  .psf[data-ready][data-step="3"] .psf__plug--fake {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s, transform 0.35s;
  }

  .psf[data-ready] .psf__row[data-from="0"],
  .psf[data-ready][data-step="1"] .psf__row[data-from="1"],
  .psf[data-ready][data-step="2"] .psf__row[data-from="1"],
  .psf[data-ready][data-step="3"] .psf__row[data-from="1"] {
    opacity: 1;
    visibility: visible;
  }

  .psf[data-ready][data-step="2"] .psf__era[data-era="2"],
  .psf[data-ready][data-step="3"] .psf__era[data-era="3"] {
    display: inline;
  }

  .psf[data-ready]:is([data-step="0"], [data-step="1"]) .psf__same {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .psf[data-ready][data-step="2"] .psf__plug--real,
    .psf[data-ready][data-step="3"] .psf__plug--fake {
      animation: psf-plug 0.5s ease-out both;
    }

    @keyframes psf-plug {
      from {
        opacity: 0;
        transform: translateX(1.25rem);
      }
    }
  }

  @media (max-height: 700px) {
    .psf.sf[data-ready] .sf-frames {
      margin-block-end: 0.125rem;
    }

    .psf :global(.psf__tree) {
      margin-block-end: 0.25rem;
    }

    .psf :global(.sf-caption) {
      line-height: 1.5;
    }

    .psf__diagram {
      gap: 0.25rem;
      padding: 0.25rem 0.5rem;
    }

    .psf__rows {
      gap: 0.25rem;
    }

    .psf__row {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.2fr);
      gap: 0.25rem;
    }

    .psf__plug {
      padding-inline: 0.5rem;
    }

    .psf__plug small {
      font-size: 0.6875rem;
    }
  }

  @media (max-width: 52rem) {
    .psf__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: start;
      height: auto;
    }

    @container (max-width: 26rem) {
      .psf__row {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }
</style>
