---
import css from "./walkthrough.css?raw";
import script from "./walkthrough.js?raw";

type Scene = Readonly<{
  label: string;
  frames: readonly Readonly<{ text: string }>[];
}>;

interface Props {
  id: string;
  title: string;
  lead?: string;
  note?: string;
  scenes: readonly Scene[];
}

const { id, title, lead, note, scenes } = Astro.props;
const actions = [
  ["first", "最初へ"],
  ["prev", "前へ"],
  ["play", "再生"],
  ["next", "次へ"],
] as const;
---

<section class="walk" id={id} aria-labelledby={`${id}-title`} data-walk data-scene="0" data-frame="0">
  <h3 class="walk__title" id={`${id}-title`}>{title}</h3>
  {lead === undefined ? null : <p class="walk__lead">{lead}</p>}
  {note === undefined ? null : <p class="walk__note">{note}</p>}
  {scenes.length > 1 ? (
    <div class="walk__tabs" role="group" aria-label="場面">
      {scenes.map((scene, index) => (
        <button type="button" class="walk__btn walk__tab" data-walk-tab={index} aria-pressed={index === 0 ? "true" : "false"}>
          {scene.label}
        </button>
      ))}
    </div>
  ) : null}
  <div class="walk__sticky">
    <div class="walk__bar" data-controls>
      {actions.map(([name, label]) => (
        <button
          type="button"
          class={`walk__btn walk__btn--${name}`}
          data-walk-action={name}
          data-prev={name === "prev" ? "" : undefined}
          data-next={name === "next" ? "" : undefined}
        >{label}</button>
      ))}
      <span class="walk__progress" data-walk-progress></span>
    </div>
    <p class="walk__live" aria-live="polite" data-walk-live></p>
  </div>
  <div class="walk__scenes">
    {scenes.map((scene, sceneIndex) => (
      <section class="walk__scene" data-walk-scene={sceneIndex} data-current={sceneIndex === 0 ? "" : undefined}>
        <h4>{scenes.length > 1 ? `場面${sceneIndex + 1}「${scene.label}」` : scene.label}</h4>
        <ol>
          {scene.frames.map(({ text }) => (
            <li>{text.split("`").map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}</li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <div class="walk__figure">
    <slot />
  </div>
</section>
<style is:inline set:html={css}></style>
<script is:inline type="module" set:html={script}></script>
