---
import StepControls from "../stepper/StepControls.astro";
import css from "./walkthrough.css?raw";

type Scene = Readonly<{
  label: string;
  frames: readonly Readonly<{ text: string }>[];
}>;

interface Props {
  id: string;
  title: string;
  lead?: string;
  note?: string;
  scenes: readonly Scene[];
  page?: boolean;
  legend?: number;
}

const { id, title, lead, note, scenes, page = false, legend } = Astro.props;
const pageStyle = page && legend !== undefined ? `--walk-legend: ${legend}rem` : undefined;
---

<section
  class:list={["walk", { "walk--page": page, "walk--tabs": page && scenes.length > 1 }]}
  id={id}
  aria-labelledby={`${id}-title`}
  style={pageStyle}
  data-walk
  data-walk-page={page ? "" : undefined}
  data-step-figure
  data-scene="0"
  data-frame="0"
>
  <h3 class:list={["walk__title", { "walk__title--hidden": page }]} id={`${id}-title`}>{title}</h3>
  {lead === undefined || page ? null : <p class="walk__lead">{lead}</p>}
  {note === undefined || page ? null : <p class="walk__note">{note}</p>}
  {scenes.length > 1 ? (
    <div class="walk__tabs" role="group" aria-label="場面">
      {scenes.map((scene, index) => (
        <button type="button" class="walk__btn walk__tab" data-walk-tab={index} data-step-scene aria-pressed={index === 0 ? "true" : "false"}>
          {scene.label}
        </button>
      ))}
    </div>
  ) : null}
  <div class="walk__sticky">
    <StepControls />
    <p class="walk__live" aria-live="polite" data-walk-live></p>
  </div>
  <div class="walk__scenes">
    {scenes.map((scene, sceneIndex) => (
      <section class="walk__scene" data-walk-scene={sceneIndex} data-current={sceneIndex === 0 ? "" : undefined}>
        <h4>{scenes.length > 1 ? `場面${sceneIndex + 1}「${scene.label}」` : scene.label}</h4>
        <ol>
          {scene.frames.map(({ text }) => (
            <li>{text.split("`").map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}</li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <div class="walk__figure">
    <slot />
  </div>
  {Astro.slots.has("legend") ? <div class="walk__legend"><slot name="legend" /></div> : null}
</section>
<style is:inline set:html={css}></style>
<script>
  import "./walkthrough.js";
</script>
