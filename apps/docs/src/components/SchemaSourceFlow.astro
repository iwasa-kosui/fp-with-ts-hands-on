---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import { keyedTransformer } from "./code-cache-key";
import MiniTree from "./mini-tree/MiniTree.astro";
import { miniTree } from "./mini-tree/mini-tree";

type Snippet = Readonly<{ path: string; code: string }>;
type Props = Readonly<{
  code: Readonly<{
    before: Snippet;
    after: Snippet;
    schemaResult: Snippet;
  }>;
  part?: "schema" | "parse";
}>;

const { code, part } = Astro.props;

const versionLabels = { before: "修正前", after: "修正後" } as const;

type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const KEY_MARK = /\s*\/\/ \[!schema-source-key\]$/;
const withMarks = (source: string, keyLines: readonly number[]) =>
  source.split("\n").map((text, index) => (keyLines.includes(index + 1) ? `${text} // [!schema-source-key]` : text)).join("\n");
const markKeyLines = keyedTransformer<Transformer>("schema-source-flow", {
  name: "mark-schema-source-key-lines",
  preprocess(source) {
    const lines = source.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((text, index) => (KEY_MARK.test(text) ? [index + 1] : []));
    return lines.map((text) => text.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "schema-source-flow__key");
  },
});

type Mode = "off" | "dim" | "on" | "focus";
type ChipState = "off" | "home" | "through" | "stop";
type ResultState = "off" | "warn" | "ok" | "err";
type Frame = Readonly<{
  part: "schema" | "parse";
  caption: string;
  stage: keyof typeof versionLabels | null;
  code?: Readonly<{ key: keyof Props["code"]; lines: readonly number[] }>;
  parts: Readonly<{
    typeBox: Mode;
    typeGhost: Mode;
    schemaBox: Mode;
    linkType: Mode;
    linkCheck: Mode;
    checkBox: Mode;
    inside: Mode;
    sameName: Mode;
    unknown: Mode;
    note: Mode;
  }>;
  typeLabel: "name" | "hand" | "infer";
  check: "plain" | "none" | "checked";
  chips: readonly [ChipState, ChipState];
  results: readonly [ResultState, ResultState];
}>;

const frames: readonly Frame[] = [
  {
    part: "schema",
    caption: "TypeScript の型は、型検査のときだけ使われます。JavaScript に変換すると型は消えます。実行時に届いた値が型のとおりかどうかは、型とは別のコードで確かめる必要があります。",
    stage: null,
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "off", linkType: "off", linkCheck: "off", checkBox: "dim", inside: "dim", sameName: "off", unknown: "off", note: "off" },
    typeLabel: "name",
    check: "plain",
    chips: ["home", "off"],
    results: ["off", "off"],
  },
  {
    part: "schema",
    caption: "修正前は、StartExaminationInput の型を手で書いています。parse は raw を any で受け取り、中身を確かめずに項目をコピーします。any は、どんな使い方も型検査で許す型です。型はあっても実行時の検査がないので、night-shift も StartExaminationInput として内側へ進みます。",
    stage: "before",
    code: { key: "before", lines: [5, 6, 7, 8, 11, 12, 13, 14, 15] },
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "off", linkType: "off", linkCheck: "off", checkBox: "on", inside: "on", sameName: "off", unknown: "off", note: "off" },
    typeLabel: "hand",
    check: "none",
    chips: ["through", "off"],
    results: ["warn", "off"],
  },
  {
    part: "schema",
    caption: "修正後は、値が満たす形を schema というオブジェクトで書くライブラリ Zod を使います。z.object は UUID の形の文字列を表す2つの schema をまとめ、.readonly() は取り出す型の項目を読み取り専用にします。",
    stage: "after",
    code: { key: "after", lines: [7, 8, 9, 10] },
    parts: { typeBox: "dim", typeGhost: "dim", schemaBox: "focus", linkType: "off", linkCheck: "off", checkBox: "dim", inside: "dim", sameName: "off", unknown: "off", note: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "schema",
    caption: "型は schema から取り出します。z.infer<typeof schema> は、schema が受け入れる値の型です。typeof は、値である schema の型を、型を書く場所で使うための書き方です。型を手で書かないので、schema を直すと型も同じように変わります。",
    stage: "after",
    code: { key: "after", lines: [12] },
    parts: { typeBox: "focus", typeGhost: "on", schemaBox: "on", linkType: "focus", linkCheck: "off", checkBox: "dim", inside: "dim", sameName: "off", unknown: "off", note: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "実行時の検査も、同じ schema から作ります。この教材では、schema から検査を作る役を schemaResult という関数が担います。",
    stage: "after",
    code: { key: "schemaResult", lines: [1] },
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "on", linkType: "dim", linkCheck: "focus", checkBox: "on", inside: "dim", sameName: "off", unknown: "off", note: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["home", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "schemaResult は、関数を返す関数です。schema を1つ受け取り、raw を受け取る別の関数を返します。返された関数が parse です。",
    stage: "after",
    code: { key: "schemaResult", lines: [1, 2] },
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "on", linkType: "dim", linkCheck: "on", checkBox: "focus", inside: "dim", sameName: "off", unknown: "off", note: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["home", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "返された関数は、raw を unknown として受け取ります。unknown は、中身を確かめるまで項目を使えない型です。",
    stage: "after",
    code: { key: "schemaResult", lines: [2] },
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "on", linkType: "dim", linkCheck: "on", checkBox: "on", inside: "dim", sameName: "off", unknown: "on", note: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["home", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "safeParse は、schema で raw を検査します。検査に失敗しても例外を投げず、成否を success に入れて返します。schemaResult は success を見て、Ok か Err を返します。",
    stage: "after",
    code: { key: "schemaResult", lines: [3, 4] },
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "focus", linkType: "dim", linkCheck: "on", checkBox: "on", inside: "dim", sameName: "off", unknown: "on", note: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["home", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "TypeScript では、型と値に同じ名前 StartExaminationInput を付けられます。",
    stage: "after",
    code: { key: "after", lines: [12, 14, 15, 16, 17] },
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "on", linkType: "on", linkCheck: "on", checkBox: "on", inside: "dim", sameName: "focus", unknown: "off", note: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "この関数を使うと、night-shift は Err になります。使う場所は「境界を通った値だけが内側へ入る」のページで見ます。",
    stage: "after",
    parts: { typeBox: "on", typeGhost: "on", schemaBox: "on", linkType: "on", linkCheck: "on", checkBox: "on", inside: "on", sameName: "off", unknown: "off", note: "on" },
    typeLabel: "infer",
    check: "checked",
    chips: ["stop", "through"],
    results: ["err", "ok"],
  },
];

const inputFile = { id: "input", name: "startExaminationInput.ts" };
const treeBefore = miniTree("session-03", "src/", [{ folder: "adaptor/primary/web/", files: [inputFile] }]);
const treeAfter = miniTree("session-03-solution", "src/", [
  { folder: "domain/shared/", files: [{ id: "schemaResult", name: "schemaResult.ts" }] },
  { folder: "adaptor/primary/web/", files: [inputFile] },
]);
const treeFor = (key: keyof Props["code"]) => {
  if (key === "before") return { tree: treeBefore, current: ["input"] };
  if (key === "schemaResult") return { tree: treeAfter, current: ["schemaResult"] };
  return { tree: treeAfter, current: ["input"] };
};

const shownFrames = part === undefined ? frames : frames.filter((frame) => frame.part === part);
const initial = shownFrames[0];
const nightShift = "\"night-shift\"";
const uuidPreview = "\"3f2b…\"";

const playerData = JSON.stringify(shownFrames.map(({ code: _code, part: _part, ...frame }) => frame));
---

<div class="schema-source-flow" data-schema-source-flow data-frames={playerData}>
  <div class="schema-source-flow__controls" data-controls hidden>
    <button type="button" data-first>⏮ 最初へ</button>
    <button type="button" data-prev disabled>← 前のコマ</button>
    <button type="button" data-play>▶ 再生</button>
    <button type="button" data-next>次のコマ →</button>
    <span data-progress>1 / {shownFrames.length}</span>
  </div>

  <svg
    viewBox="0 0 340 494"
    role="img"
    aria-labelledby="schema-source-flow-title schema-source-flow-desc"
    data-stage={initial.stage ?? undefined}
    data-type-label={initial.typeLabel}
    data-check={initial.check}
  >
    <title id="schema-source-flow-title">1つの schema から型と検査を作る仕組み</title>
    <desc id="schema-source-flow-desc">
      上の帯は型検査のとき（TypeScript）、下の帯は実行時（JavaScript）です。JavaScript に変換すると型は消えるので、下の帯に型は残りません。修正前は、型を手で書き、parse は実行時の検査をしません。修正後は、1つの schema から z.infer で型を取り出し、schemaResult で実行時に検査する parse を作ります。修正前は night-shift という不正な値が内側へ進みます。修正後は night-shift が parse の検査で止まり、UUID の形をした値だけが内側へ進みます。
    </desc>

    <g class="schema-source-flow__badge schema-source-flow__badge--before">
      <rect x="0" y="0" width="340" height="32" rx="8"></rect>
      <text x="170" y="23" text-anchor="middle">修正前</text>
    </g>
    <g class="schema-source-flow__badge schema-source-flow__badge--after">
      <rect x="0" y="0" width="340" height="32" rx="8"></rect>
      <text x="170" y="23" text-anchor="middle">修正後</text>
    </g>

    <rect x="0" y="40" width="340" height="136" rx="8" class="schema-source-flow__band-bg"></rect>
    <text x="8" y="58" class="schema-source-flow__band-label">型検査のとき（TypeScript）</text>

    <line x1="8" y1="184" x2="332" y2="184" class="schema-source-flow__divider"></line>
    <text x="8" y="196" class="schema-source-flow__note">JavaScript に変換すると、</text>
    <text x="8" y="209" class="schema-source-flow__note">型は消える</text>

    <rect x="0" y="216" width="340" height="254" rx="8" class="schema-source-flow__band-bg schema-source-flow__band-bg--runtime"></rect>
    <text x="8" y="234" class="schema-source-flow__band-label">実行時（JavaScript）</text>

    <g class="schema-source-flow__part schema-source-flow__ghost" data-part="typeGhost" data-mode={initial.parts.typeGhost}>
      <rect x="10" y="256" width="136" height="52" rx="8"></rect>
      <text x="78" y="286" text-anchor="middle">型は残らない</text>
    </g>

    <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__type" data-part="typeBox" data-mode={initial.parts.typeBox}>
      <rect x="10" y="80" width="136" height="52" rx="8"></rect>
      <text x="78" y="102" text-anchor="middle" class="schema-source-flow__type-label" data-label="name">StartExaminationInput</text>
      <text x="78" y="118" text-anchor="middle" class="schema-source-flow__type-label" data-label="name">型</text>
      <text x="78" y="110" text-anchor="middle" class="schema-source-flow__type-label" data-label="hand">手で書いた型</text>
      <text x="78" y="102" text-anchor="middle" class="schema-source-flow__type-label" data-label="infer">z.infer で</text>
      <text x="78" y="118" text-anchor="middle" class="schema-source-flow__type-label" data-label="infer">取り出した型</text>
    </g>

    <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__schema" data-part="schemaBox" data-mode={initial.parts.schemaBox}>
      <rect x="208" y="96" width="128" height="100" rx="8"></rect>
      <text x="272" y="116" text-anchor="middle" class="schema-source-flow__strong">schema</text>
      <text x="216" y="144" class="schema-source-flow__code-text schema-source-flow__mono">z.object({"{"}…{"}"})</text>
      <text x="216" y="164" class="schema-source-flow__code-text schema-source-flow__mono">.readonly()</text>
    </g>

    <g class="schema-source-flow__part schema-source-flow__link" data-part="linkType" data-mode={initial.parts.linkType}>
      <line x1="208" y1="112" x2="155" y2="112"></line>
      <polygon points="146,112 155,107 155,117"></polygon>
      <text x="177" y="104" text-anchor="middle" class="schema-source-flow__mono">z.infer</text>
    </g>

    <g class="schema-source-flow__part schema-source-flow__link" data-part="linkCheck" data-mode={initial.parts.linkCheck}>
      <line x1="216" y1="196" x2="216" y2="316"></line>
      <polygon points="216,325 211,316 221,316"></polygon>
      <text x="224" y="264" class="schema-source-flow__mono">schemaResult</text>
    </g>

    <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__check" data-part="checkBox" data-mode={initial.parts.checkBox}>
      <rect x="116" y="326" width="106" height="114" rx="8"></rect>
      <text x="169" y="346" text-anchor="middle" class="schema-source-flow__check-label" data-label="plain">parse</text>
      <text x="169" y="346" text-anchor="middle" class="schema-source-flow__check-label" data-label="none">parse（検査なし）</text>
      <text x="169" y="346" text-anchor="middle" class="schema-source-flow__check-label" data-label="checked">parse（検査あり）</text>
    </g>

    <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__inside" data-part="inside" data-mode={initial.parts.inside}>
      <rect x="232" y="326" width="104" height="114" rx="8"></rect>
      <text x="284" y="344" text-anchor="middle" class="schema-source-flow__strong">内側</text>
      <text x="284" y="358" text-anchor="middle" class="schema-source-flow__small">（ユースケース）</text>
    </g>

    <g class="schema-source-flow__part schema-source-flow__unknown" data-part="unknown" data-mode={initial.parts.unknown}>
      <rect x="8" y="346" width="62" height="18" rx="9"></rect>
      <text x="39" y="359" text-anchor="middle" class="schema-source-flow__mono">unknown</text>
    </g>

    <g class="schema-source-flow__chip" data-chip="0" data-pos={initial.chips[0] === "off" ? "home" : initial.chips[0]} data-visible={String(initial.chips[0] !== "off")}>
      <rect x="4" y="370" width="96" height="30" rx="6"></rect>
      <text x="52" y="389" text-anchor="middle" class="schema-source-flow__mono">{nightShift}</text>
    </g>
    <g class="schema-source-flow__chip" data-chip="1" data-pos={initial.chips[1] === "off" ? "home" : initial.chips[1]} data-visible={String(initial.chips[1] !== "off")}>
      <rect x="4" y="404" width="96" height="30" rx="6"></rect>
      <text x="52" y="423" text-anchor="middle" class="schema-source-flow__mono">{uuidPreview}</text>
    </g>

    <g class="schema-source-flow__result" data-result="0" data-state={initial.results[0]}>
      <g class="schema-source-flow__result-pill schema-source-flow__result-pill--warn">
        <rect x="141" y="375" width="54" height="20" rx="10"></rect>
        <text x="168" y="389" text-anchor="middle">⚠ Ok</text>
      </g>
      <g class="schema-source-flow__result-pill schema-source-flow__result-pill--err">
        <rect x="141" y="375" width="54" height="20" rx="10"></rect>
        <text x="168" y="389" text-anchor="middle">✕ Err</text>
      </g>
      <g class="schema-source-flow__result-pill schema-source-flow__result-pill--ok">
        <rect x="141" y="375" width="54" height="20" rx="10"></rect>
        <text x="168" y="389" text-anchor="middle">✓ Ok</text>
      </g>
    </g>
    <g class="schema-source-flow__result" data-result="1" data-state={initial.results[1]}>
      <g class="schema-source-flow__result-pill schema-source-flow__result-pill--ok">
        <rect x="141" y="409" width="54" height="20" rx="10"></rect>
        <text x="168" y="423" text-anchor="middle">✓ Ok</text>
      </g>
    </g>

    <g class="schema-source-flow__part schema-source-flow__same-name" data-part="sameName" data-mode={initial.parts.sameName}>
      <text x="10" y="75" class="schema-source-flow__name schema-source-flow__mono">StartExaminationInput</text>
      <g class="schema-source-flow__name-tag">
        <rect x="10" y="136" width="56" height="18" rx="9"></rect>
        <text x="38" y="149" text-anchor="middle">型として</text>
      </g>
      <text x="116" y="320" class="schema-source-flow__name schema-source-flow__mono">StartExaminationInput</text>
      <g class="schema-source-flow__name-tag">
        <rect x="116" y="444" width="56" height="18" rx="9"></rect>
        <text x="144" y="457" text-anchor="middle">値として</text>
      </g>
    </g>

    <g class="schema-source-flow__part" data-part="note" data-mode={initial.parts.note}>
      <text x="170" y="487" text-anchor="middle" class="schema-source-flow__note">修正前は night-shift も ⚠ Ok で通っていた</text>
    </g>
  </svg>

  <div class="schema-source-flow__captions">
    <p class="schema-source-flow__live" data-live aria-live="polite" hidden></p>
    {shownFrames.map((frame) => (
      <p class="schema-source-flow__sizer" aria-hidden="true">{frame.caption}</p>
    ))}
  </div>

  <ol class="schema-source-flow__frames">
    {shownFrames.map((frame) => (
      <li data-frame data-has-code={frame.code ? "" : undefined}>
        <p class="schema-source-flow__caption">{frame.caption}</p>
        {frame.code && frame.stage && <MiniTree tree={treeFor(frame.code.key).tree} current={treeFor(frame.code.key).current} />}
        {frame.code && frame.stage && (
          <figure class="code-block schema-source-flow__code" data-version={frame.stage}>
            <figcaption><span class="schema-source-flow__tag" data-version={frame.stage}>{versionLabels[frame.stage]}</span> <code>{code[frame.code.key].path}</code></figcaption>
            <Code code={withMarks(code[frame.code.key].code, frame.code.lines)} lang="ts" defaultColor={false} transformers={[markKeyLines]} />
          </figure>
        )}
      </li>
    ))}
  </ol>
</div>

<script>
  type Mode = "off" | "dim" | "on" | "focus";
  type ChipState = "off" | "home" | "through" | "stop";
  type Frame = {
    caption: string;
    stage: "before" | "after" | null;
    parts: Record<string, Mode>;
    typeLabel: string;
    check: string;
    chips: ChipState[];
    results: string[];
  };

  const PLAY_INTERVAL_MS = 7000;

  const setUp = (root: HTMLElement) => {
    if (root.dataset.ready !== undefined) return;
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const svg = root.querySelector<SVGSVGElement>("svg");
    const parts = [...root.querySelectorAll<SVGGElement>("[data-part]")];
    const chips = [...root.querySelectorAll<SVGGElement>("[data-chip]")];
    const results = [...root.querySelectorAll<SVGGElement>("[data-result]")];
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const first = root.querySelector<HTMLButtonElement>("[data-first]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const play = root.querySelector<HTMLButtonElement>("[data-play]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    if (!svg || !controls || !first || !prev || !play || !next || !progress || !live) return;
    if (frames.length !== panels.length || chips.length !== 2 || results.length !== 2) return;
    root.dataset.ready = "";

    const last = frames.length - 1;
    let current = 0;
    let timer: number | undefined;

    const setChip = (chip: SVGGElement, state: ChipState) => {
      if (state === "off") {
        chip.dataset.visible = "false";
        return;
      }
      if (chip.dataset.visible !== "true") {
        chip.style.transition = "none";
        chip.dataset.pos = "home";
        chip.getBoundingClientRect();
        chip.style.transition = "";
        chip.dataset.visible = "true";
        chip.getBoundingClientRect();
      }
      chip.dataset.pos = state;
    };

    const show = (index: number) => {
      const frame = frames[index];
      current = index;
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));

      parts.forEach((part) => {
        part.dataset.mode = frame.parts[part.dataset.part ?? ""] ?? "off";
      });
      chips.forEach((chip, i) => setChip(chip, frame.chips[i]));
      results.forEach((result, i) => {
        result.dataset.state = frame.results[i];
      });

      svg.dataset.typeLabel = frame.typeLabel;
      svg.dataset.check = frame.check;
      if (frame.stage) svg.dataset.stage = frame.stage;
      else delete svg.dataset.stage;

      live.textContent = frame.caption;
      progress.textContent = `${index + 1} / ${frames.length}`;
      first.disabled = index === 0;
      prev.disabled = index === 0;
      next.disabled = index === last;
      play.textContent = timer !== undefined ? "❚❚ 一時停止" : "▶ 再生";
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      timer = window.setInterval(() => {
