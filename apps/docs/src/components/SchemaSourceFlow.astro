---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import { keyedTransformer } from "./code-cache-key";
import MiniTree from "./mini-tree/MiniTree.astro";
import { miniTree } from "./mini-tree/mini-tree";
import StepControls from "./stepper/StepControls.astro";

type Snippet = Readonly<{ path: string; code: string }>;
type Props = Readonly<{
  code: Readonly<{
    example: Snippet;
    schemaResult: Snippet;
  }>;
  part: "schema" | "parse";
}>;

const { code, part } = Astro.props;

type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const KEY_MARK = /\s*\/\/ \[!schema-source-key\]$/;
const withMarks = (source: string, keyLines: readonly number[]) =>
  source.split("\n").map((text, index) => (keyLines.includes(index + 1) ? `${text} // [!schema-source-key]` : text)).join("\n");
const markKeyLines = keyedTransformer<Transformer>("schema-source-flow", {
  name: "mark-schema-source-key-lines",
  preprocess(source) {
    const lines = source.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((text, index) => (KEY_MARK.test(text) ? [index + 1] : []));
    return lines.map((text) => text.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "schema-source-flow__key");
  },
});

type Mode = "off" | "dim" | "on" | "focus";
type ChipState = "off" | "home" | "stop";
type ResultState = "off" | "ok" | "err";
type Frame = Readonly<{
  part: "schema" | "parse";
  caption: string;
  code?: Readonly<{ key: keyof Props["code"]; lines: readonly number[] }>;
  parts: Readonly<{
    typeBox: Mode;
    typeGhost: Mode;
    schemaBox: Mode;
    linkType: Mode;
    linkCheck: Mode;
    checkBox: Mode;
    inside: Mode;
    sameName: Mode;
    unknown: Mode;
  }>;
  typeLabel: "plain" | "infer";
  check: "plain" | "checked";
  chips: readonly [ChipState, ChipState];
  results: readonly [ResultState, ResultState];
}>;

const frames: readonly Frame[] = [
  {
    part: "schema",
    caption: "TypeScript の型は、型検査のときだけ使われます。JavaScript に変換すると型は消えます。実行時に受け取った値が型のとおりかどうかは、型とは別のコードで検証する必要があります。",
    parts: { typeBox: "focus", typeGhost: "on", schemaBox: "off", linkType: "off", linkCheck: "off", checkBox: "off", inside: "off", sameName: "off", unknown: "off" },
    typeLabel: "plain",
    check: "plain",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "schema",
    caption: "z.object は、項目ごとの schema をまとめて、オブジェクト全体の schema を作ります。この例では、2つの項目がどちらも z.string().uuid() です。",
    code: { key: "example", lines: [3, 4, 5, 6] },
    parts: { typeBox: "dim", typeGhost: "off", schemaBox: "focus", linkType: "dim", linkCheck: "off", checkBox: "off", inside: "off", sameName: "off", unknown: "off" },
    typeLabel: "plain",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "schema",
    caption: "型は schema から取り出します。z.infer<typeof schema> は、schema が受け入れる値の型です。typeof は、値である schema の型を、型を指定する場所で使うための書き方です。型を手動で定義しないため、schema を修正すると型も同じように変わります。",
    code: { key: "example", lines: [8] },
    parts: { typeBox: "on", typeGhost: "off", schemaBox: "on", linkType: "focus", linkCheck: "off", checkBox: "off", inside: "off", sameName: "off", unknown: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "schema",
    caption: "TypeScript では、型と値に同じ名前を付けられます。この例の StartExaminationInput は、z.infer で取り出した型と、schema を持つ値の両方の名前です。",
    code: { key: "example", lines: [8, 9] },
    parts: { typeBox: "on", typeGhost: "off", schemaBox: "on", linkType: "on", linkCheck: "off", checkBox: "off", inside: "off", sameName: "focus", unknown: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "実行時の検査も、同じ schema から作ります。この教材では、schema から検査を作る関数 schemaResult を使います。T は検査を通った値の型で、z.ZodType の残りの引数は読み飛ばしてかまいません。",
    code: { key: "schemaResult", lines: [1] },
    parts: { typeBox: "off", typeGhost: "off", schemaBox: "on", linkType: "off", linkCheck: "focus", checkBox: "on", inside: "off", sameName: "off", unknown: "off" },
    typeLabel: "infer",
    check: "plain",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "schemaResult は、関数を返す関数です。schema を1つ受け取り、raw を受け取る別の関数を返します。返された関数が parse です。",
    code: { key: "schemaResult", lines: [1, 2] },
    parts: { typeBox: "off", typeGhost: "off", schemaBox: "on", linkType: "off", linkCheck: "on", checkBox: "focus", inside: "off", sameName: "off", unknown: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "返された関数は、raw を unknown として受け取ります。unknown は、中身を検証するまで項目を使えない型です。",
    code: { key: "schemaResult", lines: [2] },
    parts: { typeBox: "off", typeGhost: "off", schemaBox: "dim", linkType: "off", linkCheck: "dim", checkBox: "on", inside: "off", sameName: "off", unknown: "on" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "safeParse は、schema で raw を検査します。検査に失敗しても例外を投げず、成否を success に格納して返します。schemaResult は success を参照して、Ok か Err を返します。",
    code: { key: "schemaResult", lines: [3, 4] },
    parts: { typeBox: "off", typeGhost: "off", schemaBox: "focus", linkType: "off", linkCheck: "on", checkBox: "on", inside: "off", sameName: "off", unknown: "dim" },
    typeLabel: "infer",
    check: "checked",
    chips: ["off", "off"],
    results: ["off", "off"],
  },
  {
    part: "parse",
    caption: "schemaResult が返す関数に night-shift を渡すと Err になり、UUID の形の値を渡すと Ok になって内側へ進みます。使う場所は「境界を通過した値だけを内側へ渡す構成」のページで確認します。",
    code: { key: "schemaResult", lines: [] },
    parts: { typeBox: "off", typeGhost: "off", schemaBox: "dim", linkType: "off", linkCheck: "dim", checkBox: "on", inside: "on", sameName: "off", unknown: "off" },
    typeLabel: "infer",
    check: "checked",
    chips: ["stop", "home"],
    results: ["err", "ok"],
  },
];

const schemaResultTree = miniTree("session-03-solution", "src/", [
  { folder: "domain/shared/", files: [{ id: "schemaResult", name: "schemaResult.ts" }] },
]);

const shownFrames = frames.filter((frame) => frame.part === part);
const initial = shownFrames[0];
const nightShift = "\"night-shift\"";
const uuidPreview = "\"3f2b…\"";

const playerData = JSON.stringify(shownFrames.map(({ code: _code, part: _part, ...frame }) => frame));
---

<div class="schema-source-flow" data-schema-source-flow data-frames={playerData}>
  <StepControls />

  {part === "parse" ? (
    <svg
      viewBox="0 212 340 214"
      role="img"
      aria-labelledby="schema-source-flow-title schema-source-flow-desc"
      data-type-label={initial.typeLabel}
      data-check={initial.check}
      data-has-result={String(initial.results.some((state) => state !== "off"))}
    >
      <title id="schema-source-flow-title">1つの schema から実行時の検査を作る仕組み</title>
      <desc id="schema-source-flow-desc">
        schema から schemaResult で、実行時の検査である parse を作ります。parse は raw を unknown として受け取ります。night-shift という値は parse の検査で Err になり、UUID の形をした値は Ok になって内側へ進みます。
      </desc>

      <rect x="0" y="216" width="340" height="206" rx="8" class="schema-source-flow__band-bg schema-source-flow__band-bg--runtime"></rect>
      <text x="8" y="234" class="schema-source-flow__band-label">実行時（JavaScript）</text>

      <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__schema" data-part="schemaBox" data-mode={initial.parts.schemaBox}>
        <rect x="148" y="226" width="128" height="44" rx="8"></rect>
        <text x="212" y="244" text-anchor="middle" class="schema-source-flow__strong">schema</text>
        <text x="156" y="260" class="schema-source-flow__code-text schema-source-flow__mono">z.object({"{"}…{"}"})</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__link" data-part="linkCheck" data-mode={initial.parts.linkCheck}>
        <line x1="168" y1="270" x2="168" y2="301"></line>
        <polygon points="168,310 163,301 173,301"></polygon>
        <text x="176" y="294" class="schema-source-flow__mono">schemaResult</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__check" data-part="checkBox" data-mode={initial.parts.checkBox}>
        <rect x="110" y="310" width="106" height="102" rx="8"></rect>
        <text x="163" y="330" text-anchor="middle" class="schema-source-flow__check-label" data-label="plain">検査</text>
        <text x="163" y="330" text-anchor="middle" class="schema-source-flow__check-label" data-label="checked">parse（検査あり）</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__inside" data-part="inside" data-mode={initial.parts.inside}>
        <rect x="238" y="310" width="98" height="102" rx="8"></rect>
        <text x="287" y="328" text-anchor="middle" class="schema-source-flow__strong">内側</text>
        <text x="287" y="342" text-anchor="middle" class="schema-source-flow__small">（業務の処理）</text>
        <rect x="252" y="372" width="70" height="30" rx="6" class="schema-source-flow__item"></rect>
        <text x="287" y="391" text-anchor="middle" class="schema-source-flow__item-text schema-source-flow__mono">{uuidPreview}</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__unknown" data-part="unknown" data-mode={initial.parts.unknown}>
        <line x1="92" y1="328" x2="100" y2="328"></line>
        <polygon points="109,328 100,323 100,333"></polygon>
        <rect x="2" y="319" width="90" height="18" rx="9"></rect>
        <text x="47" y="332" text-anchor="middle" class="schema-source-flow__mono">raw: unknown</text>
      </g>

      <g class="schema-source-flow__chip" data-chip="0" data-pos={initial.chips[0] === "off" ? "home" : initial.chips[0]} data-visible={String(initial.chips[0] !== "off")}>
        <rect x="2" y="336" width="86" height="30" rx="6"></rect>
        <text x="45" y="355" text-anchor="middle" class="schema-source-flow__mono">{nightShift}</text>
      </g>
      <g class="schema-source-flow__chip" data-chip="1" data-pos={initial.chips[1] === "off" ? "home" : initial.chips[1]} data-visible={String(initial.chips[1] !== "off")}>
        <rect x="2" y="372" width="86" height="30" rx="6"></rect>
        <text x="45" y="391" text-anchor="middle" class="schema-source-flow__mono">{uuidPreview}</text>
      </g>

      <g class="schema-source-flow__result" data-result="0" data-state={initial.results[0]}>
        <g class="schema-source-flow__result-arrow">
          <line x1="90" y1="351" x2="125" y2="351"></line>
          <polygon points="134,351 125,346 125,356"></polygon>
        </g>
        <g class="schema-source-flow__result-pill schema-source-flow__result-pill--err">
          <rect x="136" y="341" width="54" height="20" rx="10"></rect>
          <text x="163" y="355" text-anchor="middle">✕ Err</text>
        </g>
        <g class="schema-source-flow__result-pill schema-source-flow__result-pill--ok">
          <rect x="136" y="341" width="54" height="20" rx="10"></rect>
          <text x="163" y="355" text-anchor="middle">✓ Ok</text>
        </g>
      </g>
      <g class="schema-source-flow__result" data-result="1" data-state={initial.results[1]}>
        <g class="schema-source-flow__result-arrow">
          <line x1="90" y1="387" x2="125" y2="387"></line>
          <polygon points="134,387 125,382 125,392"></polygon>
          <line x1="192" y1="387" x2="241" y2="387"></line>
          <polygon points="250,387 241,382 241,392"></polygon>
        </g>
        <g class="schema-source-flow__result-pill schema-source-flow__result-pill--ok">
          <rect x="136" y="377" width="54" height="20" rx="10"></rect>
          <text x="163" y="391" text-anchor="middle">✓ Ok</text>
        </g>
      </g>
    </svg>
  ) : (
    <svg
      viewBox="0 36 340 306"
      role="img"
      aria-labelledby="schema-source-flow-title schema-source-flow-desc"
      data-type-label={initial.typeLabel}
      data-check={initial.check}
    >
      <title id="schema-source-flow-title">1つの schema から型を取り出す仕組み</title>
      <desc id="schema-source-flow-desc">
        上の帯は型検査のとき（TypeScript）、下の帯は実行時（JavaScript）です。JavaScript に変換すると型は消えるので、下の帯に型は残りません。schema は実行時の値であるため下の帯にあり、z.infer の矢印だけが上の帯の型へ伸びます。同じ名前 StartExaminationInput を、取り出した型と schema を持つ値の両方に付けます。
      </desc>

      <rect x="0" y="40" width="340" height="136" rx="8" class="schema-source-flow__band-bg"></rect>
      <text x="8" y="58" class="schema-source-flow__band-label">型検査のとき（TypeScript）</text>

      <line x1="8" y1="184" x2="332" y2="184" class="schema-source-flow__divider"></line>
      <text x="8" y="196" class="schema-source-flow__note">JavaScript に変換すると、</text>
      <text x="8" y="209" class="schema-source-flow__note">型は消える</text>

      <rect x="0" y="216" width="340" height="122" rx="8" class="schema-source-flow__band-bg schema-source-flow__band-bg--runtime"></rect>
      <text x="8" y="234" class="schema-source-flow__band-label">実行時（JavaScript）</text>

      <g class="schema-source-flow__part schema-source-flow__ghost" data-part="typeGhost" data-mode={initial.parts.typeGhost}>
        <rect x="10" y="256" width="136" height="52" rx="8"></rect>
        <text x="78" y="286" text-anchor="middle">型は残らない</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__type" data-part="typeBox" data-mode={initial.parts.typeBox}>
        <rect x="10" y="88" width="136" height="52" rx="8"></rect>
        <text x="78" y="118" text-anchor="middle" class="schema-source-flow__type-label" data-label="plain">型</text>
        <text x="78" y="110" text-anchor="middle" class="schema-source-flow__type-label" data-label="infer">z.infer で</text>
        <text x="78" y="126" text-anchor="middle" class="schema-source-flow__type-label" data-label="infer">取り出した型</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__box schema-source-flow__schema" data-part="schemaBox" data-mode={initial.parts.schemaBox}>
        <rect x="208" y="222" width="128" height="104" rx="8"></rect>
        <text x="272" y="240" text-anchor="middle" class="schema-source-flow__strong">schema</text>
        <text x="216" y="256" class="schema-source-flow__code-text schema-source-flow__mono">z.object({"{"}</text>
        <rect x="220" y="262" width="108" height="20" rx="4" class="schema-source-flow__item"></rect>
        <text x="274" y="276" text-anchor="middle" class="schema-source-flow__item-text schema-source-flow__mono">z.string().uuid()</text>
        <rect x="220" y="286" width="108" height="20" rx="4" class="schema-source-flow__item"></rect>
        <text x="274" y="300" text-anchor="middle" class="schema-source-flow__item-text schema-source-flow__mono">z.string().uuid()</text>
        <text x="216" y="319" class="schema-source-flow__code-text schema-source-flow__mono">{"}"})</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__link" data-part="linkType" data-mode={initial.parts.linkType}>
        <line x1="272" y1="222" x2="272" y2="114"></line>
        <line x1="272" y1="114" x2="155" y2="114"></line>
        <polygon points="146,114 155,109 155,119"></polygon>
        <text x="218" y="106" text-anchor="middle" class="schema-source-flow__link-text schema-source-flow__mono">{"z.infer<typeof schema>"}</text>
      </g>

      <g class="schema-source-flow__part schema-source-flow__same-name" data-part="sameName" data-mode={initial.parts.sameName}>
        <text x="10" y="80" class="schema-source-flow__name schema-source-flow__mono">StartExaminationInput</text>
        <g class="schema-source-flow__name-tag">
          <rect x="10" y="144" width="56" height="18" rx="9"></rect>
          <text x="38" y="157" text-anchor="middle">型として</text>
        </g>
        <text x="10" y="266" class="schema-source-flow__name schema-source-flow__mono">StartExaminationInput</text>
        <g class="schema-source-flow__name-link">
          <line x1="154" y1="262" x2="198" y2="262"></line>
          <polygon points="207,262 198,257 198,267"></polygon>
        </g>
        <g class="schema-source-flow__name-tag">
          <rect x="10" y="272" width="56" height="18" rx="9"></rect>
          <text x="38" y="285" text-anchor="middle">値として</text>
        </g>
      </g>
    </svg>
  )}

  <div class="schema-source-flow__captions">
    <p class="schema-source-flow__live" data-live aria-live="polite" hidden></p>
    {shownFrames.map((frame) => (
      <p class="schema-source-flow__sizer" aria-hidden="true">{frame.caption}</p>
    ))}
  </div>

  <ol class="schema-source-flow__frames">
    {shownFrames.map((frame) => (
      <li data-frame data-has-code={frame.code ? "" : undefined} data-code-borrowed={frame.code && frame.code.lines.length === 0 ? "" : undefined}>
        <p class="schema-source-flow__caption">{frame.caption}</p>
        {frame.code?.key === "schemaResult" && <MiniTree tree={schemaResultTree} current={["schemaResult"]} />}
        {frame.code && (
          <figure class="code-block schema-source-flow__code">
            <figcaption><code>{code[frame.code.key].path}</code></figcaption>
            <Code code={withMarks(code[frame.code.key].code, frame.code.lines)} lang="ts" defaultColor={false} transformers={[markKeyLines]} />
          </figure>
        )}
      </li>
    ))}
  </ol>
</div>

<script>
  import { renderProgress } from "./stepper/step-progress";

  type Mode = "off" | "dim" | "on" | "focus";
  type ChipState = "off" | "home" | "stop";
  type Frame = {
    caption: string;
    parts: Record<string, Mode>;
    typeLabel: string;
    check: string;
    chips: ChipState[];
    results: string[];
  };

  const setUp = (root: HTMLElement) => {
    if (root.dataset.ready !== undefined) return;
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const svg = root.querySelector<SVGSVGElement>("svg");
    const parts = [...root.querySelectorAll<SVGGElement>("[data-part]")];
    const chips = [...root.querySelectorAll<SVGGElement>("[data-chip]")];
    const results = [...root.querySelectorAll<SVGGElement>("[data-result]")];
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    if (!svg || !controls || !prev || !next || !progress || !live) return;
    if (frames.length !== panels.length) return;
    root.dataset.ready = "";

    const last = frames.length - 1;
    let current = 0;

    const setChip = (chip: SVGGElement, state: ChipState) => {
      if (state === "off") {
        chip.dataset.visible = "false";
        return;
      }
      if (chip.dataset.visible !== "true") {
        chip.style.transition = "none";
        chip.dataset.pos = "home";
        chip.getBoundingClientRect();
        chip.style.transition = "";
        chip.dataset.visible = "true";
        chip.getBoundingClientRect();
      }
      chip.dataset.pos = state;
    };

    const show = (index: number) => {
      const frame = frames[index];
      current = index;
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));

      parts.forEach((part) => {
        part.dataset.mode = frame.parts[part.dataset.part ?? ""] ?? "off";
      });
      chips.forEach((chip, i) => setChip(chip, frame.chips[i]));
      results.forEach((result, i) => {
        result.dataset.state = frame.results[i];
      });

      svg.dataset.typeLabel = frame.typeLabel;
      svg.dataset.check = frame.check;
      svg.dataset.hasResult = String(frame.results.some((state) => state !== "off"));

      live.textContent = frame.caption;
      renderProgress(progress, index, frames.length);
      prev.disabled = index === 0;
      next.disabled = index === last;
    };

    prev.addEventListener("click", () => {
      show(Math.max(current - 1, 0));
    });
    next.addEventListener("click", () => {
      show(Math.min(current + 1, last));
    });
    svg.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      show(event.key === "ArrowLeft" ? Math.max(current - 1, 0) : Math.min(current + 1, last));
    });

    svg.setAttribute("tabindex", "0");
    root.dataset.animated = "";
    controls.hidden = false;
    live.hidden = false;
    show(0);
  };

  document.querySelectorAll<HTMLElement>("[data-schema-source-flow]").forEach(setUp);
</script>

<style>
  .schema-source-flow {
    min-width: 0;
    max-width: 100%;
    margin: 1.5rem 0;
  }

  .schema-source-flow svg {
    display: block;
    width: 100%;
