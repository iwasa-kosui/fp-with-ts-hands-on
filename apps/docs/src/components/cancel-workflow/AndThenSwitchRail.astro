---
import { Code } from "astro:components";
import finalUseCaseSource from "../../../../../examples/final/src/useCase/cancelAppointmentUseCase.ts?raw";
import startExaminationSource from "../../../../../examples/session-04-solution/src/useCase/startExamination.ts?raw";
import { quote } from "../../sessions/reference-quote";
import { lineLabelOf } from "../../sessions/source-quotes";
import StepControls from "../stepper/StepControls.astro";
import "../states/states.css";

const s04Code = quote(startExaminationSource, 29, 44, "ensureAppointmentFound(");
const s04Label = lineLabelOf("session-04-solution", "src/useCase/startExamination.ts", "    ensureAppointmentFound(", "      });");
const finalCode = quote(finalUseCaseSource, 95, 98, ".andThen(ensureCancellable)");
const finalLabel = lineLabelOf("final", "src/useCase/cancelAppointmentUseCase.ts", "      .andThen(ensureCancellable)", "      .map((event) => ({ appointment: event.aggregateState }));");
const s04Lines = s04Code.split("\n");
const indexOf = (needle: string): number => {
  const index = s04Lines.findIndex((line) => line.includes(needle));
  if (index < 0) throw new Error(`"${needle}" is not in the excerpt`);
  return index;
};
const range = (from: number, to: number): readonly number[] => Array.from({ length: to - from + 1 }, (_, offset) => from + offset);

const andThenAt = indexOf(".andThen(ensureCheckedIn)");
const transitionAt = indexOf(".map((appointment) =>");
const saveAt = indexOf(".map((appointment) => {");
const lines = {
  entry: range(0, andThenAt - 1),
  andThen: [andThenAt],
  transition: range(transitionAt, saveAt - 1),
  save: range(saveAt, s04Lines.length - 1),
} as const;

const centers = [76, 200, 324, 448] as const;

type Station = Readonly<{ name: string; line?: "switch" | "none" | "unused" }>;

const s04Stations: readonly Station[] = [{ name: "入口" }, { name: "andThen", line: "switch" }, { name: "map", line: "none" }, { name: "map", line: "none" }];
const finalStations: readonly Station[] = [{ name: "andThen", line: "switch" }, { name: "andThen", line: "unused" }, { name: "andThrough", line: "switch" }, { name: "map", line: "none" }];

type Row = Readonly<{ tone: "positive" | "negative" | "none" | "text"; from: string; to: string; note: string }>;

type Frame = Readonly<{
  source: "s04" | "final";
  stations: readonly Station[];
  lit: readonly number[];
  current: readonly number[];
  rows: readonly Row[];
  caption: string;
}>;

const errPassThrough: Row = { tone: "none", from: "Err(…)", to: "Err(…)", note: "失敗のレールでは関数を呼ばず、そのまま通過する" };

const frames: readonly Frame[] = [
  {
    source: "s04",
    stations: s04Stations,
    lit: [],
    current: [],
    rows: [
      { tone: "positive", from: "Ok(…)", to: "", note: "上のレール。成功の値が進む" },
      { tone: "negative", from: "Err(…)", to: "", note: "下のレール。失敗の値が進む" },
    ],
    caption: "S04 の診察開始のコードを、2本のレールに対応付けます。呼び出し 1 つが、レールの 1 区間に当たります。",
  },
  {
    source: "s04",
    stations: s04Stations,
    lit: lines.entry,
    current: [0],
    rows: [
      { tone: "positive", from: "Ok(Appointment)", to: "", note: "予約が存在する。成功のレールから始まる" },
      { tone: "negative", from: "Err(AppointmentNotFound)", to: "", note: "存在しない。失敗のレールから始まる" },
    ],
    caption: "最初の ensureAppointmentFound は、Result を返します。存在すれば成功のレール、存在しなければ失敗のレールから始まります。",
  },
  {
    source: "s04",
    stations: s04Stations,
    lit: lines.andThen,
    current: [1],
    rows: [
      { tone: "positive", from: "Ok(CheckedIn)", to: "Ok(CheckedIn)", note: "ensureCheckedIn が ok を返す。成功のレールのまま" },
      { tone: "negative", from: "Ok(Paid)", to: "Err(InvalidAppointmentState)", note: "ensureCheckedIn が err を返す。切り替え線で失敗のレールへ移る" },
    ],
    caption: "andThen に渡す ensureCheckedIn は、ok か err を返します。err を返せるため、andThen は失敗のレールへ切り替えられる線です。",
  },
  {
    source: "s04",
    stations: s04Stations,
    lit: lines.transition,
    current: [2],
    rows: [
      { tone: "positive", from: "Ok(CheckedIn)", to: "Ok(InExamination)", note: "成功のレールの上で、値を変えるだけ" },
      errPassThrough,
    ],
    caption: "map に渡す関数は、通常の値を返します。失敗を返せないため、切り替え線はありません。値を CheckedIn から InExamination に変えるだけです。",
  },
  {
    source: "s04",
    stations: s04Stations,
    lit: lines.save,
    current: [3],
    rows: [
      { tone: "positive", from: "Ok(InExamination)", to: "Ok(InExamination)", note: "保存してから同じ値を返す。レールは切り替わらない" },
      errPassThrough,
    ],
    caption: "最後の map は、保存の処理を行い、同じ値を返します。S04 は保存の接続断を障害として例外のままにするため、保存を Result を返さない map で行います。",
  },
  {
    source: "final",
    stations: finalStations,
    lit: [1, 2],
    current: [1, 2],
    rows: [
      { tone: "positive", from: "Ok(Scheduled)", to: "Ok(…)", note: "andThen(createEvent): 結果を作る工程の関数（Ok の中身は省略）。Err を返さないため、切り替え線はない" },
      { tone: "positive", from: "Ok(…)", to: "Ok(…)", note: "andThrough(store): 記録して返す工程の関数。Ok の値は捨てて、元の値が次へ渡る" },
      { tone: "negative", from: "Ok(…)", to: "Err(AppointmentConflict)", note: "andThrough(store): 別のリクエストの先行更新（競合）の err で失敗のレールへ移る" },
    ],
    caption: "記録して返す工程は andThrough です。保存は競合を Err で返せるため、切り替え線を持ちます。",
  },
  {
    source: "final",
    stations: finalStations,
    lit: [0, 1, 2, 3],
    current: [],
    rows: [
      { tone: "text", from: "andThen", to: "", note: "渡す関数が Err を返すときに切り替え線がある。Ok の値は次へ渡る" },
      { tone: "text", from: "andThrough", to: "", note: "渡す関数が Err を返すときに切り替え線がある。Ok の値は捨てて元の値が次へ渡る" },
      { tone: "text", from: "map", to: "", note: "切り替え線なし。渡す関数は通常の値を返す" },
    ],
    caption: "切り替え線の有無は、渡す関数が Err を返すかどうかで異なります。前の工程が Err のときは、どの関数も呼びません。",
  },
];

const markOf = (tone: Row["tone"]): string => (tone === "positive" ? "✓" : tone === "negative" ? "×" : "・");
---

<figure class="st-fig rail" data-and-then-rail aria-label="S04 の診察開始のコードと、参照実装のキャンセルのコードを、成功と失敗の2本のレールに対応付ける図">
  <div class="rail__head">
    <StepControls />
  </div>

  <ol class="st-stack">
    {frames.map((frame, frameIndex) => (
      <li data-frame data-lit={JSON.stringify(frame.lit)}>
        <div class="rail__split">
          <figure class="code-block st-code">
            <figcaption>{frame.source === "s04" ? s04Label : finalLabel}</figcaption>
            <Code code={frame.source === "s04" ? s04Code : finalCode} lang="ts" />
          </figure>

          <div class="rail__side">
            <svg viewBox="0 0 560 160" role="img" aria-label="上が成功のレール、下が失敗のレール。切り替え線がある区間と、線がない区間を示す">
              <defs>
                <marker id={`rail-head-ok-${frameIndex}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
                  <path d="M 0 0 L 10 5 L 0 10 z" class="rail__head rail__head--ok"></path>
                </marker>
                <marker id={`rail-head-bad-${frameIndex}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
                  <path d="M 0 0 L 10 5 L 0 10 z" class="rail__head rail__head--bad"></path>
                </marker>
              </defs>
              <text x="12" y="24" class="rail__label rail__label--ok">成功のレール</text>
              <text x="12" y="152" class="rail__label rail__label--bad">失敗のレール</text>
              <path d="M 12 56 H 546" class="rail__line rail__line--ok" marker-end={`url(#rail-head-ok-${frameIndex})`}></path>
              <path d="M 12 130 H 546" class="rail__line rail__line--bad" marker-end={`url(#rail-head-bad-${frameIndex})`}></path>
              {frame.stations.map((station, index) => station.line === "switch" && (
                <path d={`M ${centers[index]! + 50} 56 C ${centers[index]! + 80} 56, ${centers[index]! + 66} 130, ${centers[index]! + 98} 130`} class="rail__switch" data-active={frame.current.includes(index) ? "" : undefined} marker-end={`url(#rail-head-bad-${frameIndex})`}></path>
              ))}
              {frame.stations.map((station, index) => station.line !== undefined && (
                <text x={centers[index]} y="100" text-anchor="middle" class={station.line === "switch" ? "rail__note rail__note--bad" : "rail__note"}>{station.line === "switch" ? "切り替え線" : "線なし"}</text>
              ))}
              {frame.stations.map((station, index) => (
                <g class="rail__station" data-current={frame.current.includes(index) ? "" : undefined} transform={`translate(${centers[index]! - 50} 36)`}>
                  <rect width="100" height="40" rx="8"></rect>
                  <text x="50" y="26" text-anchor="middle">{station.name}</text>
                </g>
              ))}
            </svg>

            <ul class="rail__rows">
              {frame.rows.map((row) => (
                <li data-tone={row.tone}>
                  {row.tone !== "text" && <span class="st-mark rail__mark" data-tone={row.tone === "none" ? undefined : row.tone} aria-hidden="true">{markOf(row.tone)}</span>}
                  <span class="rail__value">
                    <code>{row.from}</code>
                    {row.to !== "" && <><span aria-hidden="true"> → </span><code>{row.to}</code></>}
                  </span>
                  <span class="rail__row-note">{row.note}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p class="st-caption">{frame.caption}</p>
      </li>
    ))}
  </ol>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-and-then-rail]").forEach((root) => {
    root.querySelectorAll<HTMLElement>("[data-frame]").forEach((frame) => {
      const lit = JSON.parse(frame.dataset.lit ?? "[]") as number[];
      frame.querySelectorAll<HTMLElement>(".line").forEach((line, index) => {
        line.classList.toggle("is-lit", lit.includes(index));
      });
    });
    mountStepper({ root });
  });
</script>

<style>
  .rail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .rail__split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 0.75rem;
    align-items: start;
    margin-block-end: 0.125rem;
  }

  .rail__split :global(.st-code pre) {
    padding-block: 0.125rem;
    line-height: 1.3;
  }

  .rail :global(.st-caption) {
    line-height: 1.5;
  }

  .rail {
    --lit-accent: color-mix(in srgb, var(--role-accent) 55%, var(--frame-code-text, #ffffff));
  }

  .rail__split :global(.st-code .line.is-lit) {
    box-shadow: inset 4px 0 0 var(--lit-accent);
  }

  .rail__side {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }

  .rail__side svg {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .rail__line,
  .rail__switch {
    fill: none;
    stroke-linecap: round;
    stroke-width: 5;
  }

  .rail__line--ok {
    stroke: var(--role-positive);
  }

  .rail__line--bad {
    stroke: var(--role-negative);
  }

  .rail__switch {
    stroke: var(--role-negative);
    stroke-dasharray: 7 6;
    opacity: 0.55;
  }

  .rail__switch[data-active] {
    stroke-dasharray: none;
    stroke-width: 6;
    opacity: 1;
  }

  .rail__head--ok {
    fill: var(--role-positive);
  }

  .rail__head--bad {
    fill: var(--role-negative);
  }

  .rail__label {
    font-size: 15px;
    font-weight: 800;
  }

  .rail__label--ok {
    fill: var(--role-positive);
  }

  .rail__label--bad {
    fill: var(--role-negative);
  }

  .rail__note {
    fill: var(--role-muted);
    font-size: 14px;
    font-weight: 700;
  }

  .rail__note--bad {
    fill: var(--role-negative);
  }

  .rail__station rect {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .rail__station text {
    fill: var(--role-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 15px;
    font-weight: 800;
  }

  .rail__station[data-current] rect {
    fill: color-mix(in srgb, var(--role-accent) 16%, var(--role-surface));
    stroke: var(--role-accent);
    stroke-width: 4;
  }

  .rail__rows {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail__rows li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0 0.5rem;
    align-items: baseline;
    padding: 0.125rem 0.5rem;
    border: 2px solid var(--role-border);
    border-radius: 0.375rem;
    background: var(--role-surface);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .rail__rows li[data-tone="positive"] {
    border-color: var(--role-positive);
  }

  .rail__rows li[data-tone="negative"] {
    border-style: dashed;
    border-color: var(--role-negative);
  }

  .rail__value code {
    font-size: 0.8125rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .rail__row-note {
    grid-column: 2;
    color: var(--role-muted);
  }

  .rail__rows li[data-tone="text"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .rail__rows li[data-tone="text"] .rail__row-note {
    grid-column: 1;
  }

  @media (max-width: 55rem) {
    .rail__split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
