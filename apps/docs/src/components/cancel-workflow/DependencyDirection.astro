---
import { Code } from "astro:components";
import routesSource from "../../../../../examples/final/src/adaptor/primary/web/routes/appointmentRoutes.ts?raw";
import appointmentSource from "../../../../../examples/final/src/domain/appointment/appointment.ts?raw";
import useCaseSource from "../../../../../examples/final/src/useCase/cancelAppointmentUseCase.ts?raw";
import { quote } from "../../sessions/reference-quote";
import StepControls from "../stepper/StepControls.astro";
import "../states/states.css";

const webImport = quote(routesSource, 20, 20, "import type { CancelAppointmentUseCase }");
const useCaseImport = quote(useCaseSource, 18, 18, "import type { AppointmentId }");
const domainImport = quote(appointmentSource, 1, 1, "import type { Timestamp }");
const reverseImport = `import type { AppointmentPageView } from "../../adaptor/primary/web/routes/appointmentRoutes.js";`;

type Layer = "web" | "useCase" | "domain";

const layers: readonly Readonly<{ id: Layer; name: string; path: string }>[] = [
  { id: "web", name: "web", path: "appointmentRoutes.ts" },
  { id: "useCase", name: "useCase", path: "cancelAppointmentUseCase.ts" },
  { id: "domain", name: "domain", path: "appointment.ts" },
];

type Frame = Readonly<{
  tag: string;
  fixed: boolean;
  imports: Readonly<Record<Layer, string>>;
  domainPath: string;
  caption: string;
}>;

const frames: readonly Frame[] = [
  {
    tag: "修正前",
    fixed: false,
    imports: { web: webImport, useCase: useCaseImport, domain: reverseImport },
    domainPath: "appointment.ts（仮の悪い例）",
    caption: "修正前です。矢印は import の向きです。domain が web を import しているので、矢印が内側から外側へ逆向きに伸びます。",
  },
  {
    tag: "修正後",
    fixed: true,
    imports: { web: webImport, useCase: useCaseImport, domain: domainImport },
    domainPath: "appointment.ts",
    caption: "修正後です。矢印は import の向きです。web は useCase を、useCase は domain を import し、矢印は外側から内側へだけ向かいます。",
  },
];
---

<figure class="st-fig dep" data-dependency-direction aria-label="import の向きを、修正前と修正後で見比べる図">
  <StepControls />

  <ol class="st-stack">
    {frames.map((frame, index) => (
      <li data-frame data-fixed={frame.fixed ? "true" : "false"}>
        <svg viewBox="0 0 900 134" role="img" aria-label={frame.fixed ? "web から useCase、useCase から domain へ向かう矢印だけがある" : "web から useCase、useCase から domain へ向かう矢印に加えて、domain から web へ逆向きの矢印がある"}>
          <defs>
            <marker id={`dep-head-ok-${index}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
              <path d="M 0 0 L 10 5 L 0 10 z" class="dep__tip dep__tip--ok"></path>
            </marker>
            <marker id={`dep-head-bad-${index}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
              <path d="M 0 0 L 10 5 L 0 10 z" class="dep__tip dep__tip--bad"></path>
            </marker>
            <marker id={`dep-head-plain-${index}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
              <path d="M 0 0 L 10 5 L 0 10 z" class="dep__tip"></path>
            </marker>
          </defs>

          <g class="dep__tag" data-tone={frame.fixed ? "positive" : "negative"}>
            <rect x="12" y="10" width="76" height="30" rx="6"></rect>
            <text x="50" y="31" text-anchor="middle">{frame.tag}</text>
          </g>

          {layers.map((layer, column) => (
            <g class="dep__layer" data-bad={!frame.fixed && layer.id === "domain" ? "" : undefined} transform={`translate(${50 + column * 300} 46)`}>
              <rect width="200" height="56" rx="10"></rect>
              <text x="100" y="35" text-anchor="middle">{layer.name}</text>
            </g>
          ))}

          <path d="M 254 74 H 346" class={frame.fixed ? "dep__arrow dep__arrow--ok" : "dep__arrow"} marker-end={frame.fixed ? `url(#dep-head-ok-${index})` : `url(#dep-head-plain-${index})`}></path>
          <path d="M 554 74 H 646" class={frame.fixed ? "dep__arrow dep__arrow--ok" : "dep__arrow"} marker-end={frame.fixed ? `url(#dep-head-ok-${index})` : `url(#dep-head-plain-${index})`}></path>

          {frame.fixed ? (
            <>
              <text x="300" y="62" text-anchor="middle" class="dep__mark dep__mark--ok">✓ import</text>
              <text x="600" y="62" text-anchor="middle" class="dep__mark dep__mark--ok">✓ import</text>
              <text x="450" y="26" text-anchor="middle" class="dep__mark dep__mark--ok">矢印は外側から内側へだけ向かう</text>
            </>
          ) : (
            <>
              <path d="M 750 44 C 750 -12, 150 -12, 150 40" class="dep__arrow dep__arrow--bad" marker-end={`url(#dep-head-bad-${index})`}></path>
              <text x="450" y="34" text-anchor="middle" class="dep__mark dep__mark--bad">× domain が web を import している</text>
            </>
          )}
        </svg>

        <div class="dep__imports">
          {layers.map((layer) => {
            const bad = !frame.fixed && layer.id === "domain";
            return (
              <div class="dep__import" data-tone={bad ? "negative" : frame.fixed ? "positive" : undefined}>
                <p><strong>{layer.name}</strong> <code>{layer.id === "domain" ? frame.domainPath : layer.path}</code></p>
                <figure class="code-block st-code" data-bad={bad ? "" : undefined}>
                  <Code code={frame.imports[layer.id]} lang="ts" />
                </figure>
              </div>
            );
          })}
        </div>

        <p class="st-caption">{frame.caption}</p>
      </li>
    ))}
  </ol>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-dependency-direction]").forEach((root) => {
    root.querySelectorAll<HTMLElement>("[data-frame]").forEach((frame) => {
      const lines = frame.querySelectorAll<HTMLElement>(".st-code .line");
      lines.forEach((line) => {
        if (line.closest("[data-bad]") !== null) line.classList.add("is-lit-negative");
        else if (frame.dataset.fixed === "true") line.classList.add("is-lit-positive");
      });
    });
    mountStepper({ root });
  });
</script>

<style>
  .dep {
    --lit-negative: color-mix(in srgb, var(--role-negative) 55%, var(--frame-code-text, #ffffff));
    --lit-positive: color-mix(in srgb, var(--role-positive) 55%, var(--frame-code-text, #ffffff));
  }

  .dep__tag rect {
    fill: var(--role-surface);
    stroke-width: 2;
  }

  .dep__tag text {
    font-size: 16px;
    font-weight: 800;
  }

  .dep__tag[data-tone="positive"] rect {
    stroke: var(--role-positive);
  }

  .dep__tag[data-tone="positive"] text {
    fill: var(--role-positive);
  }

  .dep__tag[data-tone="negative"] rect {
    stroke: var(--role-negative);
    stroke-dasharray: 5 3;
  }

  .dep__tag[data-tone="negative"] text {
    fill: var(--role-negative);
  }

  .dep svg {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .dep__layer rect {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .dep__layer[data-bad] rect {
    stroke: var(--role-negative);
    stroke-dasharray: 7 5;
    stroke-width: 3;
  }

  .dep__layer text {
    fill: var(--role-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 20px;
    font-weight: 800;
  }

  .dep__arrow {
    fill: none;
    stroke: var(--role-border);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .dep__arrow--ok {
    stroke: var(--role-positive);
    stroke-width: 5;
  }

  .dep__arrow--bad {
    stroke: var(--role-negative);
    stroke-dasharray: 9 6;
    stroke-width: 5;
  }

  .dep__tip {
    fill: var(--role-border);
  }

  .dep__tip--ok {
    fill: var(--role-positive);
  }

  .dep__tip--bad {
    fill: var(--role-negative);
  }

  .dep__mark {
    font-size: 16px;
    font-weight: 800;
  }

  .dep__mark--ok {
    fill: var(--role-positive);
  }

  .dep__mark--bad {
    fill: var(--role-negative);
  }

  .dep__imports {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-block-start: 0.375rem;
  }

  .dep__import {
    min-width: 0;
    padding-inline-start: 0.375rem;
    border-inline-start: 4px solid var(--role-border);
  }

  .dep__import[data-tone="positive"] {
    border-inline-start-color: var(--role-positive);
  }

  .dep__import[data-tone="negative"] {
    border-inline-start-color: var(--role-negative);
  }

  .dep__import p {
    margin: 0 0 0.125rem;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .dep__import code {
    color: var(--role-muted);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .dep__imports :global(.st-code pre) {
    padding-block: 0.125rem;
    line-height: 1.4;
  }

  .dep :global(.st-caption) {
    margin-block-start: 0.375rem;
    line-height: 1.5;
  }

  .dep :global(.st-code .line.is-lit-positive) {
    box-shadow: inset 4px 0 0 var(--lit-positive);
  }

  .dep :global(.st-code .line.is-lit-negative) {
    box-shadow: inset 4px 0 0 var(--lit-negative);
  }

  @media (max-width: 55rem) {
    .dep__imports {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
