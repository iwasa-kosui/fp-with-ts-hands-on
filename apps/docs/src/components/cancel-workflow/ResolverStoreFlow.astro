---
import { Code } from "astro:components";
import useCaseSource from "../../../../../examples/final/src/useCase/cancelAppointmentUseCase.ts?raw";
import { quote } from "../../sessions/reference-quote";
import StepControls from "../stepper/StepControls.astro";
import "../states/states.css";

type Part = "resolver" | "createEvent" | "cancel" | "store";
type Arrow = "read" | "pass" | "clock" | "return" | "write";

type Frame = Readonly<{
  part: Part | undefined;
  arrows: readonly Arrow[];
  heading: string;
  code?: string;
  lines?: readonly string[];
  caption: string;
}>;

const createEventCall = quote(useCaseSource, 77, 81, "Appointment.cancel({");

const frames: readonly Frame[] = [
  {
    part: undefined,
    arrows: [],
    heading: "業務ロジックの外に配置するもの",
    lines: ["取得するのは Resolver", "保存するのは Store", "時刻と ID を取得して渡すのは createEvent", "値だけで結果を返すのは Appointment.cancel"],
    caption: "データベースから取得する Resolver を左に、データベースへ保存する Store を右に、時刻と ID を取得して渡す createEvent を中央に配置します。",
  },
  {
    part: "resolver",
    arrows: ["read", "pass"],
    heading: "Resolver が渡す値",
    code: `{\n  kind: "Scheduled",\n  appointmentId: "11111111-…",\n  …\n}`,
    caption: "Resolver は、データベースから予約を取得します。条件の検証 ensureCancellable を通った予約が、createEvent へ渡されます。",
  },
  {
    part: "createEvent",
    arrows: ["clock"],
    heading: "createEvent が Appointment.cancel へ渡す値",
    code: createEventCall,
    caption: "createEvent は、時計から時刻を、ID の生成器から ID を取得し、Appointment.cancel へ渡します。",
  },
  {
    part: "cancel",
    arrows: [],
    heading: "Appointment.cancel が返す値",
    code: `{\n  kind: "AppointmentCanceled",\n  aggregateState: { kind: "Canceled", … },\n}`,
    caption: "Appointment.cancel は、渡された値だけで結果を返します。データベースにも時計にも触れません。",
  },
  {
    part: "store",
    arrows: ["return", "write"],
    heading: "Store が受け取る値",
    code: `{ kind: "AppointmentCanceled", … }`,
    caption: "Store は、createEvent が返したイベントを受け取り、データベースへ保存します。",
  },
];

const activeOf = (frame: Frame, arrow: Arrow): string | undefined => (frame.arrows.includes(arrow) ? "" : undefined);
const headOf = (frame: Frame, arrow: Arrow, index: number): string => (frame.arrows.includes(arrow) ? `url(#rsf-head-active-${index})` : `url(#rsf-head-${index})`);
---

<figure class="st-fig rsf" data-resolver-store aria-label="中央の createEvent が時計と ID の生成器から取得して Appointment.cancel へ渡し、左の Resolver が取得し、右の Store が保存する図">
  <StepControls />

  <ol class="st-stack">
    {frames.map((frame, index) => (
      <li data-frame>
        <div class="rsf__split">
          <svg viewBox="0 0 660 250" role="img" aria-label="左の Resolver がデータベースから予約を取得して中央の createEvent へ渡す。createEvent は時計と ID の生成器から時刻と ID を取得し、内側の Appointment.cancel へ渡す。Appointment.cancel は値だけでイベントを返し、右の Store がデータベースへ保存する">
            <defs>
              <marker id={`rsf-head-${index}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
                <path d="M 0 0 L 10 5 L 0 10 z" class="rsf__head"></path>
              </marker>
              <marker id={`rsf-head-active-${index}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
                <path d="M 0 0 L 10 5 L 0 10 z" class="rsf__head rsf__head--active"></path>
              </marker>
            </defs>

            <g class="rsf__box rsf__box--io" data-current={frame.part === "resolver" ? "" : undefined} transform="translate(6 18)">
              <rect width="160" height="72" rx="10"></rect>
              <text x="80" y="34" text-anchor="middle" class="rsf__title">Resolver</text>
              <text x="80" y="60" text-anchor="middle" class="rsf__sub">データベースから取得</text>
            </g>
            <g class="rsf__box rsf__box--io" data-current={frame.part === "createEvent" ? "" : undefined} transform="translate(222 6)">
              <rect width="216" height="112" rx="10"></rect>
              <text x="108" y="24" text-anchor="middle" class="rsf__title rsf__title--sm">createEvent</text>
              <text x="108" y="42" text-anchor="middle" class="rsf__sub">時刻と ID を取得して渡す</text>
            </g>
            <g class="rsf__box" data-current={frame.part === "cancel" ? "" : undefined} transform="translate(238 54)">
              <rect width="184" height="56" rx="8"></rect>
              <text x="92" y="24" text-anchor="middle" class="rsf__title rsf__title--sm">Appointment.cancel</text>
              <text x="92" y="44" text-anchor="middle" class="rsf__sub">値だけで結果を返す</text>
            </g>
            <g class="rsf__box rsf__box--io" data-current={frame.part === "store" ? "" : undefined} transform="translate(494 18)">
              <rect width="160" height="72" rx="10"></rect>
              <text x="80" y="34" text-anchor="middle" class="rsf__title">Store</text>
              <text x="80" y="60" text-anchor="middle" class="rsf__sub">データベースへ保存</text>
            </g>

            <path d="M 166 54 H 218" class="rsf__arrow" data-active={activeOf(frame, "pass")} marker-end={headOf(frame, "pass", index)}></path>
            <text x="194" y="44" text-anchor="middle" class="rsf__label">予約</text>
            <path d="M 438 54 H 490" class="rsf__arrow" data-active={activeOf(frame, "return")} marker-end={headOf(frame, "return", index)}></path>
            <text x="464" y="44" text-anchor="middle" class="rsf__label rsf__label--sm">イベント</text>

            <path d="M 86 204 V 94" class="rsf__arrow" data-active={activeOf(frame, "read")} marker-end={headOf(frame, "read", index)}></path>
            <text x="98" y="150" class="rsf__label">取得</text>
            <path d="M 574 94 V 200" class="rsf__arrow" data-active={activeOf(frame, "write")} marker-end={headOf(frame, "write", index)}></path>
            <text x="586" y="150" class="rsf__label">保存</text>

            <g class="rsf__db rsf__db--clock" transform="translate(222 150)">
              <rect width="216" height="40" rx="8"></rect>
              <text x="108" y="25" text-anchor="middle">時計と ID の生成器</text>
            </g>
            <path d="M 330 150 V 122" class="rsf__arrow" data-active={activeOf(frame, "clock")} marker-end={headOf(frame, "clock", index)}></path>
            <text x="342" y="141" class="rsf__label">時刻と ID</text>

            <g class="rsf__db" transform="translate(6 206)">
              <rect width="648" height="38" rx="8"></rect>
              <text x="324" y="25" text-anchor="middle">データベース</text>
            </g>
          </svg>

          <div class="rsf__panel">
            <p class="rsf__heading">{frame.heading}</p>
            {frame.code !== undefined && <figure class="code-block st-code"><Code code={frame.code} lang="ts" /></figure>}
            {frame.lines !== undefined && (
              <ul>
                {frame.lines.map((line) => <li>{line}</li>)}
              </ul>
            )}
          </div>
        </div>
        <p class="st-caption">{frame.caption}</p>
      </li>
    ))}
  </ol>

  <p class="rsf__note">注: 工程ごとに取得と検証を繰り返す。図は関数と I/O の関係だけを示し、実行の順序は示さない。</p>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-resolver-store]").forEach((root) => {
    mountStepper({ root });
  });
</script>

<style>
  .rsf__split {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    margin-block-end: 0.125rem;
  }

  .rsf__split svg {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .rsf__box rect {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .rsf__box--io rect {
    stroke-dasharray: 6 4;
  }

  .rsf__box[data-current] rect {
    fill: color-mix(in srgb, var(--role-accent) 16%, var(--role-surface));
    stroke: var(--role-accent);
    stroke-width: 4;
  }

  .rsf__title {
    fill: var(--role-text);
    font-size: 17px;
    font-weight: 800;
  }

  .rsf__title--sm {
    font-size: 15px;
  }

  .rsf__label--sm {
    font-size: 13px;
  }

  .rsf__sub {
    fill: var(--role-muted);
    font-size: 14px;
    font-weight: 700;
  }

  .rsf__arrow {
    fill: none;
    stroke: var(--role-border);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .rsf__arrow[data-active] {
    stroke: var(--role-accent);
    stroke-width: 5;
  }

  .rsf__head {
    fill: var(--role-border);
  }

  .rsf__head--active {
    fill: var(--role-accent);
  }

  .rsf__label {
    fill: var(--role-text);
    font-size: 14px;
    font-weight: 800;
  }

  .rsf__label--muted {
    fill: var(--role-muted);
  }

  .rsf__db rect {
    fill: color-mix(in srgb, var(--role-border) 16%, var(--role-surface));
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .rsf__db text {
    fill: var(--role-text);
    font-size: 16px;
    font-weight: 800;
  }

  .rsf__panel {
    display: grid;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-accent);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .rsf__heading {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .rsf__panel ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding-inline-start: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .rsf__panel :global(.st-code pre) {
    padding-block: 0.125rem;
    line-height: 1.4;
  }

  .rsf :global(.st-caption) {
    line-height: 1.5;
  }

  .rsf__note {
    margin: 0.25rem 0 0;
    color: var(--role-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-width: 55rem) {
    .rsf__split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
