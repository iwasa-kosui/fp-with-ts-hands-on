---
import { Code } from "astro:components";
import StepControls from "../stepper/StepControls.astro";
import "../states/states.css";

type Part = "resolver" | "decision" | "store";
type Arrow = "read" | "pass" | "return" | "write";

type Frame = Readonly<{
  part: Part | undefined;
  arrows: readonly Arrow[];
  heading: string;
  code?: string;
  lines?: readonly string[];
  caption: string;
}>;

const frames: readonly Frame[] = [
  {
    part: undefined,
    arrows: [],
    heading: "データベースを操作するオブジェクト",
    lines: ["取得するのは Resolver", "保存するのは Store", "判定の関数は、データベースを操作しない"],
    caption: "判定の関数を中央に配置します。データベースから取得する Resolver を左に、データベースへ保存する Store を右に配置します。",
  },
  {
    part: "resolver",
    arrows: ["read", "pass"],
    heading: "Resolver が判定の関数へ渡す値",
    code: `{\n  kind: "Scheduled",\n  appointmentId: "11111111-…",\n  …\n}`,
    caption: "Resolver は、データベースから予約を取得し、判定の関数へ渡します。",
  },
  {
    part: "decision",
    arrows: [],
    heading: "判定の関数が返す値",
    code: `{\n  kind: "AppointmentCanceled",\n  aggregateState: { kind: "Canceled", … },\n}`,
    caption: "判定の関数は、受け取った値だけで結果を返します。データベースは操作しません。",
  },
  {
    part: "store",
    arrows: ["return", "write"],
    heading: "Store が受け取る値",
    code: `{ kind: "AppointmentCanceled", … }`,
    caption: "Store は、判定の関数が返したイベントを受け取り、データベースへ保存します。",
  },
];

const activeOf = (frame: Frame, arrow: Arrow): string | undefined => (frame.arrows.includes(arrow) ? "" : undefined);
---

<figure class="st-fig rsf" data-resolver-store aria-label="判定の関数を中央に、左に Resolver、右に Store を配置する図">
  <StepControls />

  <ol class="st-stack">
    {frames.map((frame, index) => (
      <li data-frame>
        <div class="rsf__split">
          <svg viewBox="0 0 640 204" role="img" aria-label="左の Resolver がデータベースから取得し、中央の判定の関数へ予約を渡す。判定の関数がイベントを返し、右の Store がデータベースへ保存する">
            <defs>
              <marker id={`rsf-head-${index}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
                <path d="M 0 0 L 10 5 L 0 10 z" class="rsf__head"></path>
              </marker>
              <marker id={`rsf-head-active-${index}`} viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16" orient="auto">
                <path d="M 0 0 L 10 5 L 0 10 z" class="rsf__head rsf__head--active"></path>
              </marker>
            </defs>

            <g class="rsf__box rsf__box--io" data-current={frame.part === "resolver" ? "" : undefined} transform="translate(10 14)">
              <rect width="160" height="72" rx="10"></rect>
              <text x="80" y="34" text-anchor="middle" class="rsf__title">Resolver</text>
              <text x="80" y="60" text-anchor="middle" class="rsf__sub">データベースから取得</text>
            </g>
            <g class="rsf__box" data-current={frame.part === "decision" ? "" : undefined} transform="translate(230 14)">
              <rect width="180" height="72" rx="10"></rect>
              <text x="90" y="34" text-anchor="middle" class="rsf__title">判定の関数</text>
              <text x="90" y="60" text-anchor="middle" class="rsf__sub">値だけで結果を返す</text>
            </g>
            <g class="rsf__box rsf__box--io" data-current={frame.part === "store" ? "" : undefined} transform="translate(470 14)">
              <rect width="160" height="72" rx="10"></rect>
              <text x="80" y="34" text-anchor="middle" class="rsf__title">Store</text>
              <text x="80" y="60" text-anchor="middle" class="rsf__sub">データベースへ保存</text>
            </g>

            <path d="M 170 50 H 226" class="rsf__arrow" data-active={activeOf(frame, "pass")} marker-end={frame.arrows.includes("pass") ? `url(#rsf-head-active-${index})` : `url(#rsf-head-${index})`}></path>
            <text x="200" y="40" text-anchor="middle" class="rsf__label">予約</text>
            <path d="M 410 50 H 466" class="rsf__arrow" data-active={activeOf(frame, "return")} marker-end={frame.arrows.includes("return") ? `url(#rsf-head-active-${index})` : `url(#rsf-head-${index})`}></path>
            <text x="440" y="40" text-anchor="middle" class="rsf__label">イベント</text>

            <path d="M 90 150 V 92" class="rsf__arrow" data-active={activeOf(frame, "read")} marker-end={frame.arrows.includes("read") ? `url(#rsf-head-active-${index})` : `url(#rsf-head-${index})`}></path>
            <text x="102" y="128" class="rsf__label">取得</text>
            <path d="M 550 92 V 144" class="rsf__arrow" data-active={activeOf(frame, "write")} marker-end={frame.arrows.includes("write") ? `url(#rsf-head-active-${index})` : `url(#rsf-head-${index})`}></path>
            <text x="562" y="128" class="rsf__label">保存</text>

            <text x="320" y="124" text-anchor="middle" class="rsf__label rsf__label--muted">データベースを操作しない</text>

            <g class="rsf__db" transform="translate(10 150)">
              <rect width="620" height="42" rx="8"></rect>
              <text x="310" y="27" text-anchor="middle">データベース</text>
            </g>
          </svg>

          <div class="rsf__panel">
            <p class="rsf__heading">{frame.heading}</p>
            {frame.code !== undefined && <figure class="code-block st-code"><Code code={frame.code} lang="ts" /></figure>}
            {frame.lines !== undefined && (
              <ul>
                {frame.lines.map((line) => <li>{line}</li>)}
              </ul>
            )}
          </div>
        </div>
        <p class="st-caption">{frame.caption}</p>
      </li>
    ))}
  </ol>

  <p class="rsf__note">注: Store は、保存するオブジェクトの総称です。完成形の Store は Event Store です。</p>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-resolver-store]").forEach((root) => {
    mountStepper({ root });
  });
</script>

<style>
  .rsf__split {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    margin-block-end: 0.125rem;
  }

  .rsf__split svg {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .rsf__box rect {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .rsf__box--io rect {
    stroke-dasharray: 6 4;
  }

  .rsf__box[data-current] rect {
    fill: color-mix(in srgb, var(--role-accent) 16%, var(--role-surface));
    stroke: var(--role-accent);
    stroke-width: 4;
  }

  .rsf__title {
    fill: var(--role-text);
    font-size: 17px;
    font-weight: 800;
  }

  .rsf__sub {
    fill: var(--role-muted);
    font-size: 14px;
    font-weight: 700;
  }

  .rsf__arrow {
    fill: none;
    stroke: var(--role-border);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .rsf__arrow[data-active] {
    stroke: var(--role-accent);
    stroke-width: 5;
  }

  .rsf__head {
    fill: var(--role-border);
  }

  .rsf__head--active {
    fill: var(--role-accent);
  }

  .rsf__label {
    fill: var(--role-text);
    font-size: 14px;
    font-weight: 800;
  }

  .rsf__label--muted {
    fill: var(--role-muted);
  }

  .rsf__db rect {
    fill: color-mix(in srgb, var(--role-border) 16%, var(--role-surface));
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .rsf__db text {
    fill: var(--role-text);
    font-size: 16px;
    font-weight: 800;
  }

  .rsf__panel {
    display: grid;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-accent);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .rsf__heading {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .rsf__panel ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding-inline-start: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .rsf__panel :global(.st-code pre) {
    padding-block: 0.125rem;
    line-height: 1.4;
  }

  .rsf :global(.st-caption) {
    line-height: 1.5;
  }

  .rsf__note {
    margin: 0.25rem 0 0;
    color: var(--role-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-width: 55rem) {
    .rsf__split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
