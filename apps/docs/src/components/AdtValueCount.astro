---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import { keyedTransformer } from "./code-cache-key";
import appointmentSource from "../../../../examples/session-02-solution/src/domain/appointment/appointment.ts?raw";
import statusLabelSource from "../../../../examples/session-02-solution/src/domain/appointment/statusLabel.ts?raw";
import beforeStatusLabelSource from "../../../../examples/session-02/src/domain/appointment/statusLabel.ts?raw";
import MiniTree from "./mini-tree/MiniTree.astro";
import { miniTree } from "./mini-tree/mini-tree";
import StepControls from "./stepper/StepControls.astro";

type Props = { part: "count" | "exhaustive" };

const { part } = Astro.props;

const KEY_MARK = /\s*\/\/ \[!key\]$/;
type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const markKeyLines = keyedTransformer<Transformer>("adt-value-count", {
  name: "adt-count-mark-key-lines",
  preprocess(code) {
    const lines = code.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((line, index) => (KEY_MARK.test(line) ? [index + 1] : []));
    return lines.map((line) => line.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "adt-count__key");
  },
});

const lineIndex = (lines: string[], matches: (line: string) => boolean, description: string, from = 0) => {
  const index = lines.findIndex((line, position) => position >= from && matches(line));
  if (index < 0) throw new Error(`AdtValueCount: ${description} が見つかりません`);
  return index;
};
const markRange = (lines: string[], start: number, end: number) =>
  lines.map((line, index) => (index >= start && index <= end ? `${line} // [!key]` : line)).join("\n");
const slice = (lines: string[], start: number, end: number) => lines.slice(start, end + 1);

const kinds = ["Scheduled", "CheckedIn", "InExamination", "AwaitingPayment", "Paid", "Canceled"] as const;

const flagNames = ["isCheckedIn", "isExaminationStarted", "isExaminationCompleted", "isPaid", "isCanceled"];
const flagsCode = markRange(
  [
    "type AppointmentFlags = Readonly<{",
    ...flagNames.map((name) => `  ${name}: boolean;`),
    "}>;",
  ],
  1,
  flagNames.length,
);

const stringCode = "Readonly<{ kind: string }> // [!key]";
const stringSamples = ["Scheduled", "Paid", "Schedulde", "NoShow", "123", "…"];

const twoFlagsCode = `type Flags = Readonly<{
  isCheckedIn: boolean; // [!key]
  isPaid: boolean; // [!key]
}>;`;

const appointmentLines = appointmentSource.split("\n");
const unionStart = lineIndex(appointmentLines, (line) => line.startsWith("export type Appointment ="), "export type Appointment =");
const unionEnd = lineIndex(appointmentLines, (line) => line.trim() === "| Canceled;", "| Canceled;", unionStart);
const unionCode = markRange(slice(appointmentLines, unionStart, unionEnd), 0, unionEnd - unionStart);
const canceledStart = lineIndex(appointmentLines, (line) => line.startsWith("export type Canceled = Readonly<{"), "export type Canceled = Readonly<{");
const canceledEnd = lineIndex(appointmentLines, (line) => line === "}>;", "}>;", canceledStart);
const canceledLines = slice(appointmentLines, canceledStart, canceledEnd);
const canceledCode = markRange(canceledLines, 0, canceledLines.length - 1);
const canceledFields = canceledLines.flatMap((line) => line.match(/^ {2}(\w+):/)?.[1] ?? []);
if (canceledFields.length === 0 || canceledFields[0] !== "kind") throw new Error("AdtValueCount: Canceled の項目が見つかりません");

const labelLines = statusLabelSource.split("\n");
const switchFunctionStart = lineIndex(labelLines, (line) => line.startsWith("export const toStatusLabel ="), "export const toStatusLabel =");
const switchFunctionEnd = lineIndex(labelLines, (line) => line === "};", "};", switchFunctionStart);
const assertStart = lineIndex(labelLines, (line) => line.startsWith("const assertNever ="), "const assertNever =");
const assertEnd = lineIndex(labelLines, (line) => line === "};", "};", assertStart);
const switchBodyStart = lineIndex(labelLines, (line) => line.trim() === "switch (appointment.kind) {", "switch (appointment.kind) {", switchFunctionStart);
const defaultCase = lineIndex(labelLines, (line) => line.trim() === "default:", "default:", switchBodyStart);
const switchLines = [
  ...slice(labelLines, assertStart, assertEnd),
  "",
  ...slice(labelLines, switchFunctionStart, switchBodyStart),
  "    …",
  ...slice(labelLines, defaultCase, switchFunctionEnd),
];
const fixLines = new Set([
  switchLines.findIndex((line) => line.startsWith("export const toStatusLabel =")),
  switchLines.findIndex((line) => line.trim() === "return assertNever(appointment);"),
]);
if (fixLines.has(-1) || switchLines.length > 20) throw new Error("AdtValueCount: toStatusLabel の抜粋が想定と違います");
const switchCode = switchLines.map((line, index) => (fixLines.has(index) ? `${line} // [!key]` : line)).join("\n");
const switchPath = "src/domain/appointment/statusLabel.ts（抜粋）";
const compareExcerpt = (lines: string[], returnLine: string) => {
  const start = lineIndex(lines, (line) => line.startsWith("export const toStatusLabel ="), "export const toStatusLabel =");
  const switchAt = lineIndex(lines, (line) => line.trim() === "switch (appointment.kind) {", "switch (appointment.kind) {", start);
  const defaultAt = lineIndex(lines, (line) => line.trim() === "default:", "default:", switchAt);
  const end = lineIndex(lines, (line) => line === "};", "};", defaultAt);
  const excerpt = [...slice(lines, start, switchAt), "    …", ...slice(lines, defaultAt, end)];
  const keys = new Set([0, excerpt.findIndex((line) => line.trim() === returnLine)]);
  if (keys.has(-1)) throw new Error(`AdtValueCount: ${returnLine} が見つかりません`);
  return excerpt.map((line, index) => (keys.has(index) ? `${line} // [!key]` : line)).join("\n");
};
const beforeCompareCode = compareExcerpt(beforeStatusLabelSource.split("\n"), 'return "不明";');
const afterCompareCode = compareExcerpt(labelLines, "return assertNever(appointment);");
const comparePath = "src/domain/appointment/statusLabel.ts（抜粋）";
const addedUnionCode = ["export type Appointment =", "  …", "  | Canceled", "  | NoShow; // [!key]"].join("\n");
const noShowError = "Argument of type 'NoShow' is not assignable to parameter of type 'never'.";

const indexOf = (...on: string[]) =>
  flagNames.reduce((sum, name, position) => sum + (on.includes(name) ? 2 ** (flagNames.length - 1 - position) : 0), 0);
const usedTiles = new Map<number, (typeof kinds)[number]>([
  [indexOf(), "Scheduled"],
  [indexOf("isCheckedIn"), "CheckedIn"],
  [indexOf("isCheckedIn", "isExaminationStarted"), "InExamination"],
  [indexOf("isCheckedIn", "isExaminationStarted", "isExaminationCompleted"), "AwaitingPayment"],
  [indexOf("isCheckedIn", "isExaminationStarted", "isExaminationCompleted", "isPaid"), "Paid"],
  [indexOf("isCanceled"), "Canceled"],
]);
const impossibleTile = indexOf("isPaid", "isCanceled");
const allTiles = Array.from({ length: 2 ** flagNames.length }, (_, index) => index);

const booleans = [false, true];

type Tone = "neutral" | "negative" | "positive";
type Frame = Readonly<{
  id: string;
  tone: Tone;
  codeLabel?: string;
  codePath?: string;
  code?: string;
  extra?: Readonly<{ label: string; path: string; code: string }>;
  pair?: Readonly<{ before: string; after: string; path: string }>;
  error?: string;
}>;

const countFrames: readonly Frame[] = [
  { id: "string", tone: "negative", code: stringCode, codeLabel: "▲ 修正前の引数の型" },
  { id: "sum", tone: "positive", code: unionCode, codeLabel: "● 直和型で書いた場合" },
  { id: "product", tone: "neutral", code: twoFlagsCode, codeLabel: "2個のフラグの直積型" },
  { id: "flags", tone: "negative", code: flagsCode, codeLabel: "▲ 仮にフラグで書くと" },
  { id: "adt", tone: "positive", code: canceledCode, codeLabel: "● 直和型の候補 Canceled は直積型" },
];

const exhaustiveFrames: readonly Frame[] = [
  { id: "compare", tone: "neutral", pair: { before: beforeCompareCode, after: afterCompareCode, path: comparePath } },
  { id: "before", tone: "positive", code: switchCode, codeLabel: "● 状態を足す前", codePath: switchPath },
  {
    id: "after",
    tone: "negative",
    code: switchCode,
    codeLabel: "▲ NoShow を足した後",
    codePath: switchPath,
    extra: { label: "NoShow を足した変更", path: "src/domain/appointment/appointment.ts（抜粋）", code: addedUnionCode },
    error: noShowError,
  },
];

const labelTree = miniTree("session-02-solution", "src/", [
  { folder: "domain/appointment/", files: [{ id: "label", name: "statusLabel.ts" }, { id: "appointment", name: "appointment.ts" }] },
]);
const noShowTree = miniTree("session-02-solution", "src/", [
  {
    folder: "domain/appointment/",
    files: [
      { id: "label", name: "statusLabel.ts" },
      { id: "appointment", name: "appointment.ts", note: "（NoShow は説明用の変更）" },
    ],
  },
]);
const compareTree = miniTree("session-02-solution", "src/", [
  {
    folder: "domain/appointment/",
    files: [
      { id: "before", name: "statusLabel.ts", snapshot: "session-02", note: "（修正前）" },
      { id: "after", name: "statusLabel.ts", note: "（修正後）" },
    ],
  },
]);
const exhaustiveTrees: Readonly<Record<string, Readonly<{ tree: typeof labelTree; current: readonly string[] }>>> = {
  compare: { tree: compareTree, current: ["before", "after"] },
  before: { tree: labelTree, current: ["label"] },
  after: { tree: noShowTree, current: ["label", "appointment"] },
};

const frames = part === "count" ? countFrames : exhaustiveFrames;
---

<figure class="adt-count" data-adt-count data-step-figure aria-label={part === "count" ? "型の候補を数える図" : "修正前と修正後を並べ、状態を足す前と足した後で残りの候補を数える図"}>
  <div class="adt-count__bar">
    <StepControls />
    {
      part === "exhaustive" && (
        <div class="adt-count__toggle" role="group" aria-label="修正前と修正後、状態を足す前、足した後を切り替える">
          <button type="button" data-toggle="0" data-step-scene aria-pressed="true">修正前と修正後</button>
          <button type="button" data-toggle="1" data-step-scene aria-pressed="false">状態を足す前</button>
          <button type="button" data-toggle="2" data-step-scene aria-pressed="false">NoShow を足した後</button>
        </div>
      )
    }
  </div>
  <div aria-live="polite">
    <ol class="adt-count__frames">
      {
        frames.map((frame) => (
          <li class="adt-count__frame" data-frame>
            {part === "exhaustive" && exhaustiveTrees[frame.id] && (
              <MiniTree tree={exhaustiveTrees[frame.id].tree} current={exhaustiveTrees[frame.id].current} class="adt-count__tree" />
            )}
            <div class:list={["adt-count__body", { "adt-count__body--code": frame.code !== undefined }]}>
              {frame.code && (
                <div class="adt-count__codes">
                  {frame.extra && (
                    <figure class="code-block adt-count__code adt-count__code--negative">
                      <figcaption>
                        <span class="adt-count__badge adt-count__badge--negative">{frame.extra.label}</span>
                        <code>{frame.extra.path}</code>
                      </figcaption>
                      <Code code={frame.extra.code} lang="typescript" transformers={[markKeyLines]} />
                    </figure>
                  )}
                  <figure class={`code-block adt-count__code adt-count__code--${frame.tone}`}>
                    <figcaption>
                      <span class={`adt-count__badge adt-count__badge--${frame.tone}`}>{frame.codeLabel}</span>
                      {frame.codePath && <code>{frame.codePath}</code>}
                    </figcaption>
                    <Code code={frame.code} lang="typescript" transformers={[markKeyLines]} />
                  </figure>
                </div>
              )}
              {frame.pair && (
                <div class="adt-count__pair">
                  <figure class="code-block adt-count__code adt-count__code--negative">
                    <figcaption>
                      <span class="adt-count__badge adt-count__badge--negative">▲ 修正前</span>
                      <code>examples/session-02/{frame.pair.path}</code>
                    </figcaption>
                    <Code code={frame.pair.before} lang="typescript" transformers={[markKeyLines]} />
                  </figure>
                  <figure class="code-block adt-count__code adt-count__code--positive">
                    <figcaption>
                      <span class="adt-count__badge adt-count__badge--positive">● 修正後</span>
                      <code>examples/session-02-solution/{frame.pair.path}</code>
                    </figcaption>
                    <Code code={frame.pair.after} lang="typescript" transformers={[markKeyLines]} />
                  </figure>
                </div>
              )}
              <div class="adt-count__side">
                <div class="adt-count__diagram">
                  {frame.id === "string" && (
                    <>
                      <ul class="adt-count__samples">
                        {stringSamples.map((sample, sampleIndex) => (
                          <li>
                            <span class="adt-count__tile adt-count__tile--wide adt-count__tile--sample" style={`--i: ${sampleIndex}`}>{sample === "…" ? sample : `"${sample}"`}</span>
                          </li>
                        ))}
                      </ul>
                      <p class="adt-count__formula adt-count__formula--error">kind の取れる値: 数え切れない</p>
                    </>
                  )}
                  {frame.id === "product" && (
                    <>
                      <table class="adt-count__table">
                        <thead>
                          <tr>
                            <td />
                            {booleans.map((paid) => (
                              <th scope="col">
                                <span>isPaid:</span>
                                <span>{String(paid)}</span>
                              </th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {booleans.map((checkedIn, row) => (
                            <tr>
                              <th scope="row">
                                <span>isCheckedIn:</span>
                                <span>{String(checkedIn)}</span>
                              </th>
                              {booleans.map((_, column) => (
                                <td>
                                  <span class="adt-count__tile adt-count__tile--used adt-count__tile--cell" style={`--i: ${row * 2 + column}`} />
                                </td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      <p class="adt-count__formula">フラグの値の組み合わせ: 2 × 2 = 4 通り</p>
                    </>
                  )}
                  {frame.id === "flags" && (
                    <>
                      <div class="adt-count__grid-wrap">
                        <p class="adt-count__bubble">× 会計済みかつキャンセル済み</p>
                        <div class="adt-count__grid" aria-hidden="true">
                          {allTiles.map((tile) => (
                            <span
                              class:list={[
                                "adt-count__tile",
                                "adt-count__tile--grid",
                                usedTiles.has(tile) ? "adt-count__tile--used" : tile === impossibleTile ? "adt-count__tile--danger" : "adt-count__tile--unused",
                              ]}
                              style={`--i: ${tile}`}
                            >
                              {usedTiles.has(tile) ? kinds.indexOf(usedTiles.get(tile)!) + 1 : tile === impossibleTile ? "×" : ""}
                            </span>
                          ))}
                        </div>
                      </div>
                      <ol class="adt-count__mapping">
                        {kinds.map((kind, kindIndex) => (
                          <li><b>{kindIndex + 1}</b> {kind}</li>
                        ))}
                      </ol>
                      <p class="adt-count__formula adt-count__formula--error">仮にフラグで書くと: 2 × 2 × 2 × 2 × 2 = 32 通り</p>
                    </>
                  )}
                  {frame.id === "sum" && (
                    <>
                      <ul class="adt-count__stack">
                        {kinds.map((kind, kindIndex) => (
                          <li>
                            <span class="adt-count__tile adt-count__tile--used adt-count__tile--wide" style={`--i: ${kindIndex}`}>{kind}</span>
                          </li>
                        ))}
                      </ul>
                      <p class="adt-count__formula adt-count__formula--ok">状態の候補: 1 + 1 + 1 + 1 + 1 + 1 = 6 個</p>
                    </>
                  )}
                  {frame.id === "adt" && (
                    <div class="adt-count__canceled">
                      <ul class="adt-count__others">
                        {kinds.filter((kind) => kind !== "Canceled").map((kind) => (
                          <li><span class="adt-count__tile adt-count__tile--used adt-count__tile--dim adt-count__tile--small">{kind}</span></li>
                        ))}
                      </ul>
                      <span class="adt-count__tile adt-count__tile--used adt-count__tile--strong adt-count__tile--wide">Canceled</span>
                      <ul class="adt-count__fields">
                        {canceledFields.map((field, fieldIndex) => (
                          <li class:list={["adt-count__tile", "adt-count__tile--field", fieldIndex === 0 ? "adt-count__tile--state" : "adt-count__tile--ignored"]} style={`--i: ${fieldIndex}`}>
                            <code>{field}</code>
                            <small>{fieldIndex === 0 ? "状態を決める: 1通り" : "状態を決めない"}</small>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {frame.id === "before" && (
                    <>
                      <ul class="adt-count__checks">
                        {kinds.map((kind, kindIndex) => (
                          <li>
                            <span class="adt-count__tile adt-count__tile--used adt-count__tile--wide">
                              {kind}
                              <span class="adt-count__check" style={`--i: ${kindIndex}`}>✓</span>
                            </span>
                          </li>
                        ))}
                      </ul>
                      <p class="adt-count__formula adt-count__formula--ok">残りの候補: 0 個</p>
                      <p class="adt-count__result adt-count__result--ok">✓ <code>appointment</code> は <code>never</code> 型です。<code>assertNever</code> に渡せるので、型検査を通ります。</p>
                    </>
                  )}
                  {frame.id === "after" && (
                    <>
                      <ul class="adt-count__checks">
                        {kinds.map((kind) => (
                          <li>
                            <span class="adt-count__tile adt-count__tile--used adt-count__tile--wide">
                              {kind}
                              <span class="adt-count__check">✓</span>
                            </span>
                          </li>
                        ))}
                        <li>
                          <span class="adt-count__tile adt-count__tile--danger adt-count__tile--wide" style="--i: 0">× NoShow</span>
                        </li>
                      </ul>
                      <p class="adt-count__formula adt-count__formula--error">残りの候補: 1 個（NoShow）</p>
                      <p class="adt-count__result adt-count__result--error">▲ <code>appointment</code> は <code>NoShow</code> 型です。<code>never</code> 型の引数に渡すと型エラーになるので、型検査で見つかります。</p>
                      <p class="adt-count__error">
                        <span><code>default</code> の行に出る型エラー</span>
                        <code>{frame.error}</code>
                      </p>
                    </>
                  )}
                </div>
                <div class="adt-count__text">
                  {frame.id === "string" && <p><code>kind: string</code> は、どんな文字列も取れます。取れる値は数え切れず、<code>case</code> で処理した後に何が残るかも数えられません。</p>}
                  {frame.id === "sum" && <p><code>Appointment</code> の <code>kind</code> は6個で、1つずつ並べられます。「または」で組み立てた型を直和型と呼びます。会計済みかつキャンセル済みのような、業務で起きない組み合わせは候補に入りません。</p>}
                  {frame.id === "product" && <p>「かつ」で組み立てた型を直積型と呼びます。直積型の値は、項目をすべて持ちます。<code>isCheckedIn</code> の2通りと <code>isPaid</code> の2通りを掛けて、組み合わせは 2 × 2 = 4 通りです。</p>}
                  {frame.id === "flags" && <p>仮に5個のフラグの直積型で書くと、6状態に6通りを割り当てても、会計済みかつキャンセル済みのような残りの26通りが型検査を通ります。</p>}
                  {frame.id === "adt" && <p>代数的データ型（ADT）は、型を直積と直和で組み立てる考え方です。<code>Appointment</code> は直和型で、候補の <code>Canceled</code> は直積型です。状態を決めるのは <code>kind</code> だけで、<code>string</code> の項目は状態を決めないので数えません。候補を数えられる型なら、足し忘れた候補を見つけられます。</p>}
                  {frame.id === "compare" && <p>左が修正前、右が修正後です。線を付けた2行が、直した点です。引数の型を <code>Appointment</code> にして、<code>default</code> で <code>assertNever</code> を呼びます。</p>}
                  {frame.id === "before" && <p>6個の case をすべて処理すると、<code>default</code> に残る候補は0個です。<code>appointment</code> は <code>never</code> 型になり、<code>assertNever</code> に渡せます。線を付けた2行が、直した点です。</p>}
                  {frame.id === "after" && <p><code>NoShow</code> を足して case を足し忘れると、<code>default</code> に残る候補は <code>NoShow</code> の1個です。この型エラーは、エディタの赤線と、型検査のコマンドの両方に出ます。</p>}
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "./stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-adt-count]").forEach((root) => {
    const toggles = [...root.querySelectorAll<HTMLButtonElement>("[data-toggle]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");

    mountStepper({
      root,
      onStep: (index) => {
        toggles.forEach((toggle) => toggle.setAttribute("aria-pressed", String(Number(toggle.dataset.toggle) === index)));
      },
    });

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const wanted = Number(toggle.dataset.toggle);
        if (toggle.getAttribute("aria-pressed") === "true") return;
        for (let step = Number(root.dataset.step); step !== wanted; step = Number(root.dataset.step)) {
          (wanted > step ? next : prev)?.click();
          if (Number(root.dataset.step) === step) break;
        }
      });
    });
  });
</script>

<style>
  .adt-count {
    min-width: 0;
    margin: 0.5rem 0;
    container-type: inline-size;
    color: var(--role-text);
  }

  .adt-count__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-block-end: 0.5rem;
  }

  .adt-count__bar :global(.step-controls) {
    margin-block-end: 0;
  }

  .adt-count__toggle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .adt-count__toggle button {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 2px solid var(--role-accent);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-accent);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .adt-count__toggle button[aria-pressed="true"] {
    background: var(--role-accent);
