---
import { peerReviewPromises } from "../sessions/catalog";

type Props = Readonly<{
  id: string;
  heading?: string;
}>;

const { id, heading = "相互レビューの進行上の約束事" } = Astro.props;
---

<section id={id} class="peer-review-promises">
  <h3>{heading}</h3>
  <ol>
    {peerReviewPromises.map((promise) => <li>{promise}</li>)}
  </ol>
</section>
