---
import { sessionNavigationItems } from "../sessions/navigation";
import { sessionOverviews, stages, type StageId } from "../sessions/overview-map";

type StageState = "fill" | "past" | "empty";

const stateLabels = { fill: "この回で埋める", past: "前の回で埋めた", empty: "まだ" } as const satisfies Record<StageState, string>;

const stageLabel = (id: StageId) => stages.find((stage) => stage.id === id)?.label ?? id;

const frames = sessionNavigationItems.map(({ slug, title }, index) => {
  const { summary, fills } = sessionOverviews[slug];
  const earlier = sessionNavigationItems.slice(0, index).flatMap((item) => sessionOverviews[item.slug].fills);
  const states: readonly StageState[] = stages.map(({ id }) => (fills.includes(id) ? "fill" : earlier.includes(id) ? "past" : "empty"));
  const number = slug === "final" ? "Final" : slug.slice(0, 2);
  const label = slug === "final" ? "Final" : `S${number}`;
  const filled = fills.length === 0 ? "なし" : fills.map(stageLabel).join("、");
  const alt = `${label} が埋める段は、${filled}です。上から、${stages.map((stage, i) => `${stage.label}は${stateLabels[states[i]]}`).join("、")}。`;
  return { slug, title, summary, states, label, href: `/sessions/${slug}/`, alt };
});

const stageHeight = 28;
const pitch = 38;
const failGap = 16;
const lastIndex = stages.length - 1;
const boxY = (index: number) => 4 + index * pitch + (index === lastIndex ? failGap : 0);
const viewHeight = boxY(lastIndex) + stageHeight + 4;

const playerData = JSON.stringify(frames.map(({ title, summary, states, label, href, alt }) => ({ title, summary, states, label, href, alt })));
---

<figure id="session-roadmap" class="roadmap" data-session-roadmap data-frames={playerData}>
  <figcaption class="roadmap__title">Session ごとに埋まる段</figcaption>

  <div class="roadmap__controls" data-controls hidden>
    <button type="button" data-first disabled>最初へ</button>
    <button type="button" data-prev disabled>前へ</button>
    <button type="button" data-play>再生</button>
    <button type="button" data-next>次へ</button>
    <span data-progress>1 / {frames.length}</span>
  </div>

  <div class="roadmap__stage" data-stage hidden>
    <p class="roadmap__head"><a data-stage-link></a></p>
    <div data-stage-figure></div>
  </div>

  <p class="roadmap__live" data-live aria-live="polite" hidden></p>

  <ol class="roadmap__frames">
    {frames.map((frame) => (
      <li data-frame>
        <div class="roadmap__visual">
          <p class="roadmap__head"><a href={frame.href}>{frame.label} {frame.title}</a></p>
          <p class="roadmap__summary">{frame.summary}</p>
          <svg viewBox={`0 0 340 ${viewHeight}`} role="img" aria-label={frame.alt}>
            {stages.slice(0, -2).map((_, i) => (
              <path d={`M 170 ${boxY(i) + stageHeight} V ${boxY(i + 1)}`} class="roadmap__line"></path>
            ))}
            {stages.map((stage, i) => (
              <g class="roadmap__box" data-state={frame.states[i]}>
                <rect x="10" y={boxY(i)} width="320" height={stageHeight} rx="6"></rect>
                <text x="22" y={boxY(i) + 19} font-size="12">{stage.label}</text>
                {(Object.keys(stateLabels) as StageState[]).map((state) => (
                  <text class="roadmap__tag" data-tag={state} x="320" y={boxY(i) + 18} text-anchor="end" font-size="10">{stateLabels[state]}</text>
                ))}
              </g>
            ))}
          </svg>
        </div>
      </li>
    ))}
  </ol>
</figure>

<script>
  type Frame = { title: string; summary: string; states: string[]; label: string; href: string; alt: string };

  const STEP_MS = 3500;

  const setUp = (root: HTMLElement) => {
    if (root.dataset.ready !== undefined) return;
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const source = root.querySelector<SVGSVGElement>("li svg");
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const stageLink = root.querySelector<HTMLAnchorElement>("[data-stage-link]");
    const stageFigure = root.querySelector<HTMLElement>("[data-stage-figure]");
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const first = root.querySelector<HTMLButtonElement>("[data-first]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const play = root.querySelector<HTMLButtonElement>("[data-play]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    if (!source || !stage || !stageLink || !stageFigure || !controls || !first || !prev || !play || !next || !progress || !live || frames.length !== panels.length) return;
    root.dataset.ready = "";

    const svg = source.cloneNode(true) as SVGSVGElement;
    stageFigure.append(svg);
    const boxes = [...svg.querySelectorAll<SVGGElement>("[data-state]")];

    let current = 0;
    let timer: number | null = null;

    const stop = () => {
      if (timer !== null) window.clearInterval(timer);
      timer = null;
      play.textContent = "再生";
    };

    const show = (index: number) => {
      const frame = frames[index];
      current = index;
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));
      boxes.forEach((box, i) => {
        box.dataset.state = frame.states[i];
      });
      svg.setAttribute("aria-label", frame.alt);
      stageLink.textContent = `${frame.label} ${frame.title}`;
      stageLink.href = frame.href;
      live.textContent = frame.summary;
      progress.textContent = `${index + 1} / ${frames.length}`;
      first.disabled = index === 0;
      prev.disabled = index === 0;
      next.disabled = index === frames.length - 1;
    };

    first.addEventListener("click", () => {
      stop();
      show(0);
    });
    prev.addEventListener("click", () => {
      stop();
      show(Math.max(current - 1, 0));
    });
    next.addEventListener("click", () => {
      stop();
      show(Math.min(current + 1, frames.length - 1));
    });
    play.addEventListener("click", () => {
      if (timer !== null) {
        stop();
        return;
      }
      if (current === frames.length - 1) show(0);
      play.textContent = "停止";
      timer = window.setInterval(() => {
        if (current >= frames.length - 1) {
          stop();
          return;
        }
        show(current + 1);
      }, STEP_MS);
    });

    root.dataset.animated = "";
    controls.hidden = false;
    stage.hidden = false;
    live.hidden = false;
    show(0);
  };

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-session-roadmap]").forEach(setUp);
  }
</script>

<style>
  .roadmap {
    min-width: 0;
    max-width: 100%;
    margin: 1.5rem 0;
  }

  .roadmap__title {
    margin: 0 0 0.75rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .roadmap svg {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    margin: 0.5rem auto 0;
  }

  .roadmap__head {
    margin: 0;
    font-weight: 700;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .roadmap__summary,
  .roadmap__live {
    margin: 0.25rem 0 0;
    line-height: 1.7;
  }

  .roadmap__live {
    font-weight: 700;
  }

  .roadmap__line {
    fill: none;
    stroke: var(--case-line);
    stroke-width: 1.5;
  }

  .roadmap__box {
    --box-fill: transparent;
    --box-stroke: var(--case-muted);
    --box-ink: var(--case-muted);
    --box-dash: 4 3;
    --box-width: 1.5;
    --box-weight: 400;
  }

  .roadmap__box[data-state="past"] {
    --box-fill: var(--case-paper);
    --box-stroke: var(--case-divider);
    --box-dash: none;
  }

  .roadmap__box[data-state="fill"] {
    --box-fill: var(--case-yellow);
    --box-stroke: var(--case-blue);
    --box-ink: var(--case-ink);
    --box-dash: none;
    --box-width: 2.5;
    --box-weight: 700;
  }

  .roadmap__box rect {
    fill: var(--box-fill);
    stroke: var(--box-stroke);
    stroke-width: var(--box-width);
    stroke-dasharray: var(--box-dash);
  }

  .roadmap__box text {
    fill: var(--box-ink);
    font-weight: var(--box-weight);
  }

  .roadmap__tag {
    display: none;
  }

  .roadmap__box[data-state="fill"] .roadmap__tag[data-tag="fill"],
  .roadmap__box[data-state="past"] .roadmap__tag[data-tag="past"],
  .roadmap__box[data-state="empty"] .roadmap__tag[data-tag="empty"] {
    display: inline;
  }

  .roadmap__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  .roadmap__controls[hidden] {
    display: none;
  }

  .roadmap__controls button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--case-yellow);
    color: var(--case-ink);
    cursor: pointer;
    font-weight: 700;
  }

  .roadmap__controls button:disabled {
    background: var(--case-paper);
    cursor: not-allowed;
    opacity: 0.55;
  }

  .roadmap__frames {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap__frames > li {
    min-width: 0;
  }

  .roadmap__frames > li + li {
    margin-top: 1.5rem;
  }

  [data-animated] .roadmap__frames {
    display: none;
  }

  [data-animated] .roadmap__box rect,
  [data-animated] .roadmap__box text {
    transition: fill 0.4s, stroke 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animated] * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
