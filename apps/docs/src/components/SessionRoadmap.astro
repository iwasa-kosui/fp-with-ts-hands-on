---
import { sessionNavigationItems } from "../sessions/navigation";
import { sessionOverviews } from "../sessions/overview-map";

const rows = sessionNavigationItems.flatMap(({ slug }) => {
  if (slug === "00-system-handover") return [];
  const overview = sessionOverviews[slug];
  const label = slug === "final" ? "Final" : `S${slug.slice(0, 2)}`;
  const openLabel = slug === "final" ? "Final を開く" : `Session ${slug.slice(0, 2)} を開く`;
  return [{ label, openLabel, href: `/sessions/${slug}/`, rule: overview.rule, incident: overview.incident }];
});
---

<ol class="roadmap" aria-label="Session ごとに実装する業務ルール">
  {rows.map((row) => (
    <li class="roadmap__row">
      <p class="roadmap__title"><a href={row.href} aria-label={row.openLabel}>{row.label}</a></p>
      <p class="roadmap__rule">{row.rule}</p>
      <p class="roadmap__tags">{row.incident && <span class="roadmap__tag">{row.incident}</span>}</p>
    </li>
  ))}
</ol>

<style>
  .roadmap {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
  }

  .roadmap__row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 4.5rem;
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
  }

  .roadmap__row p {
    margin: 0;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .roadmap__title {
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .roadmap__rule {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .roadmap__tags {
    text-align: end;
  }

  .roadmap__tag {
    display: inline-block;
    padding: 0 0.5rem;
    border: 2px solid var(--role-negative);
    border-radius: 999px;
    color: var(--role-negative);
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1.3;
    white-space: nowrap;
  }

  @media (max-height: 700px) {
    .roadmap {
      gap: 0.25rem;
      margin-block: 0.5rem;
    }

    .roadmap__row {
      padding-block: 0.125rem;
    }

    .roadmap__row p {
      line-height: 1.4;
    }
  }

  @media (max-width: 55rem) {
    .roadmap__row {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 0.125rem 0.5rem;
    }

    .roadmap__tags {
      grid-column: 2;
      text-align: start;
    }
  }
</style>
