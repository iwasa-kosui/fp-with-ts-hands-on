---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";

const SOLUTION = "examples/session-03/src/domain/appointment/transitions.ts";
const DISTRIBUTED = "examples/session-02/src/domain/appointment/transitions.ts";

const flow = [
  { kind: "Scheduled", label: "予約済み", y: 2 },
  { kind: "CheckedIn", label: "来院済み", y: 98 },
  { kind: "InExamination", label: "診察中", y: 194 },
  { kind: "AwaitingPayment", label: "会計待ち", y: 290 },
  { kind: "Paid", label: "会計済み", y: 386, final: true },
] as const;
const transitions = [
  { name: "checkIn", y: 54 },
  { name: "startExamination", y: 150 },
  { name: "completeExamination", y: 246 },
  { name: "recordPayment", y: 342 },
] as const;

const KEY_MARK = /\s*\/\/ \[!key\]$/;
type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const markKeyLines: Transformer = {
  name: "mark-key-lines",
  preprocess(code) {
    const lines = code.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((line, index) => (KEY_MARK.test(line) ? [index + 1] : []));
    return lines.map((line) => line.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "state-diagram__key");
  },
};

const versions = [
  { version: "origin", label: "以前のコード" },
  { version: "before", label: "修正前" },
  { version: "after", label: "修正後" },
] as const;
const versionLabels = Object.fromEntries(versions.map(({ version, label }) => [version, label])) as Record<(typeof versions)[number]["version"], string>;

const frames = [
  {
    edges: ["checkIn"],
    states: ["Scheduled", "CheckedIn"],
    path: [[154, 38], [154, 134]],
    caption: "受付で来院を記録します。<code>Scheduled</code> だけが <code>CheckedIn</code> になります。",
  },
  {
    edges: ["startExamination"],
    states: ["CheckedIn", "InExamination"],
    path: [[154, 134], [154, 230]],
    caption: "獣医師が診察を始めます。<code>CheckedIn</code> だけが <code>InExamination</code> になります。",
  },
  {
    edges: ["completeExamination"],
    states: ["InExamination", "AwaitingPayment"],
    path: [[154, 230], [154, 326]],
    caption: "診察結果を記録します。<code>InExamination</code> だけが <code>AwaitingPayment</code> になります。",
  },
  {
    edges: ["recordPayment"],
    states: ["AwaitingPayment", "Paid"],
    path: [[154, 326], [154, 422]],
    caption: "会計します。<code>AwaitingPayment</code> だけが <code>Paid</code> になります。<code>Paid</code> から先へは進めません。",
  },
  {
    edges: ["cancelFromScheduled", "cancelFromCheckedIn"],
    states: ["Scheduled", "CheckedIn", "Canceled"],
    path: [[154, 134], [170, 124], [241, 88], [336, 88]],
    caption: "キャンセルできるのは <code>Scheduled</code> と <code>CheckedIn</code> だけです。理由は省略できません。",
  },
  {
    edges: ["denied"],
    states: ["Paid", "InExamination"],
    note: "s0",
    path: [[154, 422], [170, 412], [197, 372], [204, 316], [197, 262], [173, 220], [154, 230]],
    caption: "ひと幕の事故です。状態を文字列で持っていた以前の <code>updateStatus</code> はどの状態も受け取るため、会計済みの予約が診察中へ戻ります。",
    code: {
      version: "origin" as const,
      source: "examples/session-00/src/domain/appointment/appointment.ts",
      input: `updateStatus(
  { status: "paid" /* 省略 */ }, // [!key]
  "in-examination", // [!key]
);`,
      impl: `export const updateStatus = (
  appointment: Appointment, // [!key]
  status: string, // [!key]
  extra?: AppointmentExtra,
): Appointment => ({
  ...appointment,
  ...extra,
  status,
});`,
      outputLabel: "出力: 診察中へ戻った予約",
      output: `{
  status: "in-examination", // [!key]
  // 他の項目は入力のまま
}`,
    },
  },
  {
    edges: ["denied"],
    states: ["Paid"],
    note: "s2",
    path: [[154, 422], [170, 412], [197, 372], [204, 316], [197, 372], [170, 412], [154, 422]],
    caption: "修正前の配布コードは実行時に止めます。ただし引数が <code>Appointment</code> 全体なので、<code>Paid</code> を渡してもコンパイルは通り、実行するまで誤りに気づけません。",
    code: {
      version: "before" as const,
      source: DISTRIBUTED,
      input: `startExamination(
  { kind: "Paid" /* 省略 */ }, // [!key]
  "vet-001",
  "2026-08-30T11:00:00+09:00",
);`,
      impl: `export const startExamination = (
  appointment: Appointment, // [!key]
  veterinarianId: string,
  examinationStartedAt: string,
): Appointment => {
  requireKind(appointment, ["CheckedIn"]); // [!key]
  return ({
    ...appointment,
    kind: "InExamination",
    veterinarianId,
    examinationStartedAt,
  }) as Appointment;
};`,
      outputLabel: "出力: 実行時の例外",
      output: `throw new Error("Cannot transition from Paid"); // [!key]`,
    },
  },
  {
    edges: ["denied"],
    states: ["Paid"],
    note: "after",
    path: [[154, 422], [172, 410], [160, 416], [172, 410], [154, 422]],
    caption: "修正後は引数が <code>CheckedIn</code> です。<code>Paid</code> を渡すと型検査でコンパイルエラーになるので、実行する前に誤りに気づけます。",
    code: {
      version: "after" as const,
      source: SOLUTION,
      input: `startExamination(
  { kind: "Paid" /* 省略 */ }, // [!key]
  "vet-001",
  "2026-08-30T11:00:00+09:00",
);`,
      impl: `export const startExamination = (
  appointment: CheckedIn, // [!key]
  veterinarianId: string,
  examinationStartedAt: string,
): InExamination =>
  ({
    ...appointment,
    kind: "InExamination",
    veterinarianId,
    examinationStartedAt,
  }) as const satisfies InExamination;`,
      outputLabel: "型検査の結果: コンパイルエラー",
      outputLang: "plaintext" as const,
      output: `型検査でコンパイルエラーになります。 // [!key]
型は実行時に消えるので、 // [!key]
実行時の検査ではありません。 // [!key]`,
    },
  },
];

const playerData = JSON.stringify(frames.map(({ edges, states, path, note }) => ({ edges, states, path, note })));
---

<figure id="appointment-state-diagram" class="state-diagram" data-state-diagram data-frames={playerData}>
  <div class="state-diagram__controls" data-controls hidden>
    <button type="button" data-prev aria-keyshortcuts="ArrowLeft">前へ</button>
    <button type="button" data-play>再生</button>
    <button type="button" data-next aria-keyshortcuts="ArrowRight">次へ</button>
    <span data-progress aria-live="polite"></span>
    <span class="state-diagram__key-hint">← → キーでも動かせます</span>
  </div>
  <div class="state-diagram__stage">
    <svg viewBox="-4 0 354 440" role="img" aria-labelledby="state-diagram-title state-diagram-desc">
      <title id="state-diagram-title">予約の6つの状態と遷移関数</title>
      <desc id="state-diagram-desc">
        Scheduled から checkIn で CheckedIn へ、startExamination で InExamination へ、completeExamination で AwaitingPayment へ、recordPayment で Paid へ進みます。Scheduled と CheckedIn は cancel で Canceled へ進めます。Paid から InExamination へ戻る遷移は、以前のコードでは実行でき、修正前の配布コードでは実行時に例外になり、修正後はコンパイルエラーになります。
      </desc>
      <defs>
        <marker id="state-diagram-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="state-diagram__arrow-head"></path>
        </marker>
        <marker id="state-diagram-arrow-denied" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="state-diagram__arrow-head--denied"></path>
        </marker>
      </defs>

      {transitions.map(({ name, y }) => (
        <g data-edge={name}>
          <line x1="154" y1={y} x2="154" y2={y + 42} class="state-diagram__edge" marker-end="url(#state-diagram-arrow)"></line>
          <text x="146" y={y + 26} text-anchor="end" class="state-diagram__function">{name}</text>
        </g>
      ))}

      <line data-edge="cancelFromScheduled" x1="170" y1="28" x2="241" y2="66" class="state-diagram__edge" marker-end="url(#state-diagram-arrow)"></line>
      <line data-edge="cancelFromCheckedIn" x1="170" y1="124" x2="241" y2="88" class="state-diagram__edge" marker-end="url(#state-diagram-arrow)"></line>
      <text data-edge="cancelFromCheckedIn" x="204" y="81" text-anchor="middle" class="state-diagram__function">cancel</text>

      <g data-edge="denied" class="state-diagram__denied">
        <path d="M 170 412 C 215 412, 215 220, 173 220" class="state-diagram__edge--denied" marker-end="url(#state-diagram-arrow-denied)"></path>
        <g data-note="s2 after">
          <circle cx="204" cy="316" r="9" class="state-diagram__denied-mark"></circle>
          <path d="M 200 312 L 208 320 M 208 312 L 200 320" class="state-diagram__denied-cross"></path>
        </g>
        <text x="220" y="280" class="state-diagram__note state-diagram__note--strong">ひと幕の事故</text>
        <text data-note="s0" x="220" y="298" class="state-diagram__note">以前: そのまま戻る</text>
        <text data-note="s2" x="220" y="316" class="state-diagram__note">修正前: 実行時に例外</text>
        <text data-note="after" x="220" y="334" class="state-diagram__note">修正後: コンパイル</text>
        <text data-note="after" x="220" y="350" class="state-diagram__note">エラー</text>
      </g>

      {flow.map((state) => (
        <g data-state={state.kind} transform={`translate(0 ${state.y})`}>
          <rect width="170" height="52" rx="8" class:list={["state-diagram__state", { "state-diagram__state--final": "final" in state }]}></rect>
          <text x="14" y="23" class="state-diagram__kind">{state.kind}</text>
          <text x="14" y="42" class="state-diagram__label">{state.label}</text>
        </g>
      ))}
      <g data-state="Canceled" transform="translate(242 50)">
        <rect width="108" height="52" rx="8" class="state-diagram__state state-diagram__state--final"></rect>
        <text x="12" y="23" class="state-diagram__kind">Canceled</text>
        <text x="12" y="42" class="state-diagram__label">キャンセル</text>
      </g>

      <g data-token class="state-diagram__token" aria-hidden="true">
        <circle r="11"></circle>
        <text text-anchor="middle" y="5" font-size="14">🐇</text>
      </g>
    </svg>

    <ol class="state-diagram__frames">
      {frames.map((frame) => (
        <li data-frame data-frame-view={frame.code ? "code" : "story"}>
          {frame.code && (
            <ol class="state-diagram__versions" aria-label="コードの版">
              {versions.map(({ version, label }) => (
                <li data-version={version} aria-current={version === frame.code.version ? "step" : undefined}>{label}</li>
              ))}
            </ol>
          )}
          <p class="state-diagram__caption" set:html={frame.caption}></p>
          {frame.code && (
            <>
              <div class="code-block state-diagram__part state-diagram__part--input">
                <p class="state-diagram__part-label">入力</p>
                <Code code={frame.code.input} lang="ts" transformers={[markKeyLines]} />
              </div>
              <div class="code-block state-diagram__part state-diagram__part--impl" data-version={frame.code.version}>
                <p class="state-diagram__part-label"><span class="state-diagram__version-tag" data-version={frame.code.version}>{versionLabels[frame.code.version]}</span>関数の実装: <code>{frame.code.source}</code></p>
                <Code code={frame.code.impl} lang="ts" transformers={[markKeyLines]} />
              </div>
              <div class="code-block state-diagram__part state-diagram__part--output">
                <p class="state-diagram__part-label">{frame.code.outputLabel}</p>
                <Code code={frame.code.output} lang={frame.code.outputLang ?? "ts"} transformers={[markKeyLines]} />
              </div>
            </>
          )}
        </li>
      ))}
    </ol>
  </div>

  <figcaption>矢印に付いた名前が遷移関数です。<code>Paid</code> と <code>Canceled</code> から先へは進めません。矢印のない遷移は型エラーにします。入力と出力の値は説明用で、項目の一部を省略しています。</figcaption>
</figure>

<script is:inline>
  {
  const FRAME_MS = 8000;
  const MOVE_MS = 1100;
  const translate = ([x, y]) => `translate(${x}px, ${y}px)`;

  const start = (root) => {
    const frames = JSON.parse(root.dataset.frames ?? "[]");
    const panels = [...root.querySelectorAll("[data-frame]")];
    const token = root.querySelector("[data-token]");
    const controls = root.querySelector("[data-controls]");
    const play = root.querySelector("[data-play]");
    const progress = root.querySelector("[data-progress]");
    if (!token || !controls || !play || !progress || frames.length !== panels.length) return;

    let current = 0;
    let timer;
    let move;

    const show = (index) => {
      current = index;
      const frame = frames[index];
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));
      root.dataset.view = panels[index].dataset.frameView ?? "";
      root.querySelectorAll("[data-edge]").forEach((el) => {
        el.classList.toggle("is-active", frame.edges.includes(el.dataset.edge ?? ""));
      });
      root.querySelectorAll("[data-state]").forEach((el) => {
        el.classList.toggle("is-active", frame.states.includes(el.dataset.state ?? ""));
      });
      root.querySelectorAll("[data-note]").forEach((el) => {
        el.classList.toggle("is-hidden", !el.dataset.note?.split(" ").includes(frame.note ?? ""));
      });
      progress.textContent = `${index + 1} / ${frames.length}`;
      move?.cancel();
      token.style.transform = translate(frame.path[frame.path.length - 1]);
      move = token.animate(frame.path.map((point) => ({ transform: translate(point) })), {
        duration: MOVE_MS,
        easing: "ease-in-out",
      });
    };

    const pause = () => {
      window.clearInterval(timer);
      timer = undefined;
      play.textContent = "再生";
    };

    const resume = () => {
      window.clearInterval(timer);
      if (current === frames.length - 1) show(0);
      play.textContent = "一時停止";
      timer = window.setInterval(() => {
        show(current + 1);
        if (current === frames.length - 1) pause();
      }, FRAME_MS);
    };

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      if (timer !== undefined) return;
      show(0);
      resume();
    }, { threshold: 0.5 });

    const step = (delta) => {
      observer.disconnect();
      pause();
      show(Math.min(Math.max(current + delta, 0), frames.length - 1));
    };

    play.addEventListener("click", () => {
      observer.disconnect();
      if (timer === undefined) resume();
      else pause();
    });
    root.querySelector("[data-prev]")?.addEventListener("click", () => step(-1));
    root.querySelector("[data-next]")?.addEventListener("click", () => step(1));

    document.addEventListener("keydown", (event) => {
      if (event.defaultPrevented || event.repeat) return;
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const delta = event.key === "ArrowLeft" ? -1 : event.key === "ArrowRight" ? 1 : 0;
      if (delta === 0) return;
      const active = document.activeElement;
      if (active && active !== document.body && !root.contains(active)) return;
      if (!root.contains(active)) {
        const { top, bottom } = root.getBoundingClientRect();
        if (bottom <= 0 || top >= window.innerHeight) return;
      }
      event.preventDefault();
      step(delta);
    });

    root.dataset.animated = "";
    controls.hidden = false;
    show(0);

    observer.observe(root.querySelector("svg"));
  };

  const root = document.querySelector("[data-state-diagram]");
  if (root && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) start(root);
  }
</script>

<style>
  .state-diagram {
    margin: 1.5rem 0;
    container-type: inline-size;
    --version-origin: #4b5563;
    --version-before: #c2185b;
    --version-after: #137333;
  }

  [data-version="origin"] {
    --version-color: var(--version-origin);
  }

  [data-version="before"] {
    --version-color: var(--version-before);
  }

  [data-version="after"] {
    --version-color: var(--version-after);
  }

  .state-diagram svg {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
  }

  .state-diagram figcaption {
    margin-top: 0.75rem;
    color: var(--case-muted);
    font-size: 0.875rem;
  }

  .state-diagram__frames {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  [data-frame] + [data-frame] {
    margin-top: 1rem;
  }

  .state-diagram__caption {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  [data-frame-view="story"] .state-diagram__caption {
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .state-diagram__versions {
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
  }

  .state-diagram__versions > li {
    padding: 0.35rem 0.25rem;
    border: 2px solid currentColor;
    border-radius: 0.375rem;
    background: none;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    opacity: 0.6;
  }

  .state-diagram__versions > [aria-current="step"] {
    border-color: var(--version-color);
    background: var(--version-color);
    color: #fff;
    opacity: 1;
  }

  .state-diagram__version-tag {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.05rem 0.45rem;
    border-radius: 0.25rem;
    background: var(--version-color);
    color: #fff;
    font-weight: 700;
  }

  .state-diagram__part--impl[data-version] {
    outline: 3px solid var(--version-color);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  .state-diagram__part {
    min-width: 0;
    margin: 0;
  }

  .state-diagram__part + .state-diagram__part {
    position: relative;
    margin-top: 1.5rem;
  }

  .state-diagram__part + .state-diagram__part::before {
    content: "↓";
    position: absolute;
    top: -1.45rem;
    left: 1rem;
    color: var(--case-line);
    font-weight: 800;
  }

  .state-diagram__part-label {
    margin: 0;
    padding: 0.35rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .state-diagram__part-label code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .state-diagram__part :global(pre) {
    margin: 0;
    font-size: 0.74rem;
  }

  .state-diagram :global(.state-diagram__key) {
    display: inline-block;
    min-width: 100%;
    background: rgb(255 210 27 / 28%);
  }

  .state-diagram__state {
    fill: var(--case-paper);
    stroke: var(--case-line);
    stroke-width: 1.5;
  }

  .state-diagram__state--final {
    fill: var(--case-cream);
  }

  .state-diagram__kind,
  .state-diagram__function {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .state-diagram__kind {
    fill: var(--case-ink);
    font-size: 15px;
    font-weight: 700;
  }

  .state-diagram__label {
    fill: var(--case-muted);
    font-size: 13px;
  }

  .state-diagram__function {
    fill: var(--case-blue);
    font-size: 13px;
  }

  .state-diagram__edge {
    stroke: var(--case-line);
    stroke-width: 1.5;
  }

  .state-diagram__arrow-head {
    fill: var(--case-line);
  }

  .state-diagram__edge--denied {
    fill: none;
    stroke: #c2185b;
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }

  .state-diagram__arrow-head--denied {
    fill: #c2185b;
  }

  .state-diagram__denied-mark {
    fill: var(--case-paper);
    stroke: #c2185b;
    stroke-width: 1.5;
  }

  .state-diagram__denied-cross {
    stroke: #c2185b;
    stroke-width: 2;
  }

  .state-diagram__note {
    fill: #c2185b;
    font-size: 12.5px;
  }

  .state-diagram__note--strong {
    font-weight: 700;
  }

  .state-diagram__token {
    display: none;
  }

  .state-diagram__token circle {
    fill: var(--case-yellow);
    stroke: var(--case-line);
    stroke-width: 1.5;
  }

  .state-diagram__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .state-diagram__key-hint {
    color: var(--case-muted);
    font-size: 0.75rem;
  }

  .state-diagram__controls[hidden] {
    display: none;
  }

  .state-diagram__controls button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--case-paper);
    color: var(--case-ink);
    cursor: pointer;
    font-weight: 700;
  }

  .state-diagram__controls [data-play] {
    min-width: 6rem;
    background: var(--case-yellow);
  }

  [data-animated] .state-diagram__token {
    display: block;
  }

  [data-animated] .state-diagram__frames {
    display: grid;
  }

  [data-animated] [data-frame] {
    grid-area: 1 / 1;
    min-width: 0;
    margin: 0;
    visibility: hidden;
  }

  [data-animated] [data-frame].is-current {
