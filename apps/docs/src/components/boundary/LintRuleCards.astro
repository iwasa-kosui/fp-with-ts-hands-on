---
const rules = [
  {
    names: ["@typescript-eslint/no-explicit-any"],
    about: "コードに any と書くこと",
    catches: "raw: any のように、型として any を書いたとき。",
    misses: "any と書かずに、any を返す関数の結果をそのまま受け取ったとき。",
  },
  {
    names: [
      "@typescript-eslint/no-unsafe-assignment",
      "@typescript-eslint/no-unsafe-argument",
      "@typescript-eslint/no-unsafe-member-access",
      "@typescript-eslint/no-unsafe-call",
      "@typescript-eslint/no-unsafe-return",
    ],
    about: "型が any の値を使うこと",
    catches: "型が any の値を、代入、関数の呼び出し、項目の参照、return、引数に使ったとき。",
    misses: "any を使わずに、検査をしない別の書き方をしたとき。",
  },
  {
    names: ["@typescript-eslint/consistent-type-assertions"],
    setting: '["error", { assertionStyle: "never" }]',
    about: "as による型アサーション",
    catches: "raw as StartExaminationInput のように、as で型を書き換えたとき。",
    misses: "as も any も使わずに、UUID の形を検査しない schema を書いたとき。",
  },
] as const;
---

<div class="lint-rules" role="list" aria-label="規則の候補">
  <div class="lint-rules__head" aria-hidden="true">
    <span>規則が見るもの</span>
    <span>検出できること</span>
    <span>検出できないこと</span>
  </div>
  {rules.map((rule) => (
    <div class="lint-rules__rule" role="listitem">
      <p class="lint-rules__name">
        {rule.names.map((name) => <code>{name}</code>)}
        {"setting" in rule && <code class="lint-rules__setting">{rule.setting}</code>}
      </p>
      <div class="lint-rules__cells">
        <p class="lint-rules__about">{rule.about}</p>
        <p class="lint-rules__text"><span class="lint-rules__label">検出できること</span>{rule.catches}</p>
        <p class="lint-rules__text"><span class="lint-rules__label">検出できないこと</span>{rule.misses}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .lint-rules {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  .lint-rules__head {
    display: none;
  }

  .lint-rules__rule {
    min-width: 0;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--case-line);
    border-inline-start-width: 0.5rem;
    background: var(--case-paper);
  }

  .lint-rules__rule p {
    margin: 0;
  }

  .lint-rules__name {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .lint-rules__name code {
    font-size: inherit;
  }

  .lint-rules__setting {
    font-weight: 400;
  }

  .lint-rules__cells {
    display: grid;
    gap: 0.25rem 1rem;
  }

  .lint-rules__about {
    color: var(--case-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .lint-rules__text {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .lint-rules__label {
    display: block;
    color: var(--case-ink);
    font-weight: 800;
  }

  @media (max-height: 760px) {
    .lint-rules__rule {
      padding-block: 0.25rem;
    }
  }

  @media (min-width: 44rem) {
    .lint-rules__head,
    .lint-rules__rule {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1fr);
    }

    .lint-rules__rule {
      display: grid;
      gap: 0.25rem 1rem;
      align-content: start;
    }

    .lint-rules__cells {
      display: contents;
    }

    .lint-rules__name {
      grid-column: 1;
      grid-row: 1;
    }

    .lint-rules__about {
      grid-column: 1;
      grid-row: 2;
    }

    .lint-rules__text {
      grid-row: 1 / span 2;
    }

    .lint-rules__head {
      display: grid;
      gap: 0 1rem;
      padding-inline: calc(0.5rem + 2px + 0.75rem) calc(2px + 0.75rem);
      color: var(--case-ink);
      font-size: 0.875rem;
      font-weight: 800;
    }

    .lint-rules__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
