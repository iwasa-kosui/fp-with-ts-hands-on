---
const rows = [
  {
    name: "診察開始の入力",
    scope: "今回の演習",
    outside: "HTTP の path と body",
    check: "予約IDと担当獣医師IDが UUID の形か",
    inside: "StartExaminationInput",
    path: "src/adaptor/primary/web/startExaminationInput.ts",
  },
  {
    name: "支払金額",
    scope: "発展のページ",
    outside: "入力された金額",
    check: "1以上の整数か",
    inside: "PaymentAmount",
    path: "src/domain/appointment/paymentAmount.ts",
    note: "発展のページには、実物を短くした例を載せています。",
  },
  {
    name: "検査結果",
    scope: "教材のコードの補足",
    outside: "検査機関から受け取る JSON",
    check: "examId、petId、items、needsFollowUp の形",
    inside: "ExamResult",
    path: "src/adaptor/primary/web/examResult.ts",
  },
  {
    name: "飼い主の連絡先",
    scope: "発展のページ",
    outside: "氏名、メール、電話番号の文字列",
    check: "空でないか、メールの形か",
    inside: "OwnerContact（中身は Sensitive）",
    path: "src/adaptor/primary/web/ownerContact.ts",
  },
] as const;

const zones = [
  { key: "outside", zone: "外側", label: "外側の姿" },
  { key: "check", zone: "検査", label: "境界で検証すること" },
  { key: "inside", zone: "内側", label: "内側の型" },
] as const;
---

<figure class="shapes" data-shapes-tabs aria-label="扱う値が変わっても外側・検査・内側の形は同じ">
  <div class="shapes__tabs" role="tablist" aria-label="扱う値を選ぶ">
    {rows.map((row, index) => (
      <button type="button" role="tab" id={`shapes-tab-${index}`} aria-controls={`shapes-panel-${index}`} aria-selected={index === 0 ? "true" : "false"}>
        {row.name}
        <small>{row.scope}</small>
      </button>
    ))}
  </div>

  {rows.map((row, index) => (
    <div class="shapes__panel" role="tabpanel" id={`shapes-panel-${index}`} aria-labelledby={`shapes-tab-${index}`}>
      <p class="shapes__name">{row.name}（{row.scope}）</p>
      <div class="shapes__flow">
        <span class="shapes__dot" aria-hidden="true"></span>
        {zones.map((zone, zoneIndex) => (
          <>
            {zoneIndex > 0 && <span class="shapes__arrow" aria-hidden="true">→</span>}
            <div class={`shapes__box shapes__box--${zone.key}`} style={`--n: ${zoneIndex}`}>
              <p class="shapes__zone">{zone.zone}</p>
              <p class="shapes__label">{zone.label}</p>
              <p class="shapes__text">
                {zone.key === "inside" ? <code>{row[zone.key]}</code> : row[zone.key]}
              </p>
            </div>
          </>
        ))}
      </div>
      <p class="shapes__path"><span>実物のコード</span> <code>{row.path}</code>{"note" in row && ` ${row.note}`}</p>
    </div>
  ))}
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-shapes-tabs]").forEach((root) => {
    if (root.dataset.ready !== undefined) return;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    if (tabs.length === 0 || tabs.length !== panels.length) return;

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, tabIndex) => {
        tab.setAttribute("aria-selected", String(tabIndex === index));
        tab.tabIndex = tabIndex === index ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const target =
          event.key === "ArrowRight" ? (index === last ? 0 : index + 1)
          : event.key === "ArrowLeft" ? (index === 0 ? last : index - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : undefined;
        if (target === undefined) return;
        event.preventDefault();
        select(target, true);
      });
    });

    root.dataset.ready = "";
    select(0);
  });
</script>

<style>
  .shapes {
    --outside-tone: color-mix(in srgb, var(--case-divider) 45%, var(--case-paper));
    --check-tone: var(--case-cream);
    --inside-tone: var(--case-paper);
    min-width: 0;
    margin: 1rem 0;
  }

  .shapes__tabs {
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
  }

  .shapes[data-ready] .shapes__tabs {
    display: flex;
  }

  button {
    padding: 0.4rem 0.875rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--case-paper);
    color: var(--case-ink);
    cursor: pointer;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    text-align: start;
  }

  button small {
    display: block;
    color: var(--case-muted);
    font-size: 0.75rem;
    font-weight: 400;
  }

  button[aria-selected="true"] {
    border-color: var(--case-blue);
    background: var(--case-blue);
    color: var(--case-paper);
  }

  button[aria-selected="true"] small {
    color: inherit;
  }

  button:focus-visible {
    outline: 3px solid var(--case-blue);
    outline-offset: 2px;
  }

  .shapes[data-ready] .shapes__name {
    display: none;
  }

  .shapes__panel + .shapes__panel {
    margin-block-start: 1.25rem;
  }

  .shapes[data-ready] {
    display: grid;
  }

  .shapes[data-ready] .shapes__tabs {
    grid-row: 1;
  }

  .shapes[data-ready] .shapes__panel {
    grid-area: 2 / 1;
    margin-block-start: 0;
  }

  .shapes[data-ready] .shapes__panel[hidden] {
    display: block;
    visibility: hidden;
  }

  .shapes__name {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .shapes__flow {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem minmax(0, 1.2fr) 2rem minmax(0, 1fr);
    align-items: stretch;
  }

  .shapes__box {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-height: 9.5rem;
    padding: 0.625rem 0.75rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--tone);
    color: var(--case-ink);
  }

  .shapes__box--outside {
    --tone: var(--outside-tone);
  }

  .shapes__box--check {
    --tone: var(--check-tone);
    border-inline-width: 6px;
  }

  .shapes__box--inside {
    --tone: var(--inside-tone);
  }

  .shapes__box p {
    margin: 0;
  }

  .shapes__zone {
    font-size: 1rem;
    font-weight: 800;
  }

  .shapes__label {
    color: var(--case-muted);
    font-size: 0.75rem;
  }

  .shapes__text {
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .shapes__arrow {
    display: grid;
    place-items: center;
    color: var(--case-line);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .shapes__dot {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 5%;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--case-line);
    border-radius: 50%;
    background: var(--case-blue);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .shapes__path {
    margin: 0.625rem 0 0;
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .shapes__path span {
    display: inline-block;
    margin-inline-end: 0.5rem;
    padding: 0 0.5rem;
    border: 1px solid var(--case-line);
    border-radius: 0.25rem;
    background: var(--case-cream);
    color: var(--case-ink);
    font-weight: 700;
  }

  @media (max-width: 40rem) {
    .shapes__flow {
      grid-template-columns: 1fr;
    }

    .shapes__arrow {
      transform: rotate(90deg);
    }

    .shapes__dot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .shapes[data-ready] .shapes__panel:not([hidden]) .shapes__box {
      animation: shapes-enter 0.45s ease-out both;
      animation-delay: calc(var(--n) * 0.35s);
    }

    .shapes[data-ready] .shapes__panel:not([hidden]) .shapes__dot {
      animation: shapes-travel 1.3s ease-in-out both;
    }

    @keyframes shapes-enter {
      from {
        opacity: 0;
        transform: translateX(-0.75rem);
      }
    }

    @keyframes shapes-travel {
      0% {
        inset-inline-start: 5%;
        opacity: 0;
      }

      15%,
      85% {
        opacity: 1;
      }

      100% {
        inset-inline-start: 95%;
        opacity: 0;
      }
    }
  }
</style>
