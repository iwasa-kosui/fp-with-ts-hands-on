---
const mechanisms = [
  {
    id: "type",
    name: "型のテスト",
    about: "型エラーになるはずの行を、@ts-expect-error で確かめる",
    catches: "監査記録の型にない項目を、直接書いたとき。",
    misses: "監査記録の型に現れない形で、連絡先が混ざったとき。",
  },
  {
    id: "test",
    name: "テスト",
    about: "fast-check で任意の連絡先を作り、確かめる",
    catches: "どんな連絡先を入れても、JSON に連絡先が含まれないこと。",
    misses: "テストに書いていない経路から、連絡先が出たとき。",
  },
  {
    id: "lint",
    name: "Linter",
    about: "コードの書き方を機械で調べる",
    catches: "規則に書いた、特定の書き方。",
    misses: "規則に書いていない、別の書き方で同じことをしたとき。",
  },
] as const;

const groups = [
  { key: "catches", title: "検出できること" },
  { key: "misses", title: "検出できないこと" },
] as const;
---

<figure class="guard" data-guard-compare aria-label="3つの仕組みが検出できることと、検出できないこと">
  <div class="guard__pick">
    <p class="guard__pick-title">自分が演習で使った仕組みを選びます。</p>
    <div class="guard__chips" role="group" aria-label="仕組みを選ぶ">
      {mechanisms.map((mechanism) => (
        <button type="button" data-mechanism={mechanism.id} aria-pressed="true">
          {mechanism.name}
          <small>{mechanism.about}</small>
        </button>
      ))}
    </div>
    <button type="button" class="guard__replay" data-replay hidden>もう一度見る</button>
  </div>

  <div class="guard__groups">
    {groups.map((group) => (
      <section class={`guard__group guard__group--${group.key}`}>
        <h4>{group.title}</h4>
        <ul>
          {mechanisms.map((mechanism) => (
            <li class="guard__slot" data-card={mechanism.id} data-on="true">
              <div class="guard__card">
                <div class="guard__card-head">
                  <p class="guard__card-name">{mechanism.name}</p>
                </div>
                <p>{mechanism[group.key]}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-guard-compare]").forEach((root) => {
    if (root.dataset.ready !== undefined) return;
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-mechanism]")];
    const replay = root.querySelector<HTMLButtonElement>("[data-replay]");
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
    if (chips.length === 0 || !replay) return;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const timers: number[] = [];

    const apply = (id: string, on: boolean) => {
      chips.forEach((chip) => {
        if (chip.dataset.mechanism === id) chip.setAttribute("aria-pressed", String(on));
      });
      cards.forEach((card) => {
        if (card.dataset.card === id) card.dataset.on = String(on);
      });
    };

    const cancel = () => {
      timers.splice(0).forEach((timer) => window.clearTimeout(timer));
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        cancel();
        apply(chip.dataset.mechanism ?? "", chip.getAttribute("aria-pressed") !== "true");
      });
    });

    replay.addEventListener("click", () => {
      cancel();
      const ids = chips.map((chip) => chip.dataset.mechanism ?? "");
      ids.forEach((id) => apply(id, false));
      ids.forEach((id, index) => {
        if (reducedMotion.matches) {
          apply(id, true);
          return;
        }
        timers.push(window.setTimeout(() => apply(id, true), 400 + index * 700));
      });
    });

    root.dataset.ready = "";
    replay.hidden = false;
  });
</script>

<style>
  .guard {
    --catch-tone: var(--case-highlight);
    --miss-tone: var(--case-muted);
    min-width: 0;
    margin: 0.5rem 0;
  }

  .guard__pick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .guard__pick-title {
    flex-basis: 100%;
    margin: 0;
    color: var(--case-muted);
    font-size: 0.875rem;
  }

  .guard__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  button {
    padding: 0.4rem 0.875rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--case-paper);
    color: var(--case-ink);
    cursor: pointer;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    text-align: start;
  }

  button[hidden] {
    display: none;
  }

  button small {
    display: block;
    max-width: 14rem;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
  }

  button[aria-pressed="true"] {
    border-color: var(--case-blue);
    background: var(--case-blue);
    color: var(--case-paper);
  }

  button:focus-visible {
    outline: 3px solid var(--case-blue);
    outline-offset: 2px;
  }

  .guard__replay {
    border-color: var(--case-blue);
    background: var(--case-paper);
    color: var(--case-blue);
    font-size: 0.8125rem;
  }

  .guard__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block-start: 0.5rem;
  }

  .guard__group {
    min-width: 0;
    padding: 0.375rem 0.75rem 0.125rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--tone) 14%, var(--case-paper));
    color: var(--case-ink);
  }

  .guard__group--catches {
    --tone: var(--catch-tone);
  }

  .guard__group--misses {
    --tone: var(--miss-tone);
  }

  .guard__group h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    margin: 0 0 0.375rem;
    font-size: 1rem;
  }

  .guard__group h4 small {
    color: var(--case-muted);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .guard__group ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guard__slot {
    display: grid;
    grid-template-rows: 1fr;
    min-height: 0;
  }

  .guard__card {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0 0.75rem;
    align-items: start;
    min-height: 0;
    margin-block-end: 0.375rem;
    padding: 0.375rem 0.75rem;
    overflow: hidden;
    border: 2px solid var(--case-line);
    border-inline-start: 8px solid var(--tone);
    border-radius: 0.5rem;
    background: var(--case-paper);
  }

  .guard__card p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .guard__card .guard__card-name {
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .guard[data-ready] .guard__slot {
    transition: grid-template-rows 0.4s ease, opacity 0.4s ease, transform 0.4s ease;
  }

  .guard[data-ready] .guard__slot[data-on="false"] {
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-0.75rem);
  }

  .guard[data-ready] .guard__slot[data-on="false"] .guard__card {
    margin-block-end: 0;
    padding-block: 0;
    border-width: 0;
  }

  @media (max-width: 40rem) {
    .guard__groups {
      grid-template-columns: 1fr;
    }

    .guard__card {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guard[data-ready] .guard__slot {
      transition: none;
    }
  }
</style>
