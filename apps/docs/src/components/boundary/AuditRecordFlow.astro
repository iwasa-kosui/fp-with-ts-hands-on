---
import { Code } from "astro:components";
import { clinicFixture } from "../../../../../examples/fixtures/clinic";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import MiniTree from "../mini-tree/MiniTree.astro";
import { miniTree } from "../mini-tree/mini-tree";
import { blockOf, lineLabelOf } from "../../sessions/source-quotes";
import StepControls from "../stepper/StepControls.astro";

interface Props {
  part?: "problem" | "solution";
}

const { part } = Astro.props;

const repositoryPath = "src/adaptor/secondary/sqlite/appointmentRepository.ts";
const auditPayloadPath = "src/adaptor/secondary/sqlite/auditPayload.ts";

const repositoryFile = { id: "repo", name: "appointmentRepository.ts" };
const treeBefore = miniTree("session-03", "src/", [{ folder: "adaptor/secondary/sqlite/", files: [repositoryFile] }]);
const treeAfter = miniTree("session-03-solution", "src/", [
  {
    folder: "adaptor/secondary/sqlite/",
    files: [repositoryFile, { id: "audit", name: "auditPayload.ts", note: "（新しいファイル）" }],
  },
]);

const dedent = (source: string) => {
  const lines = source.split("\n");
  const indent = Math.min(
    ...lines.filter((line) => line.trim() !== "").map((line) => line.length - line.trimStart().length),
  );
  return lines.map((line) => line.slice(indent)).join("\n");
};
const lineOf = (source: string, needle: string) => {
  const index = source.split("\n").findIndex((line) => line.includes(needle));
  if (index < 0) throw new Error(`AuditRecordFlow: "${needle}" is not in the excerpt`);
  return index;
};

const beforeCode = dedent(
  blockOf(
    projectFilesForSnapshot("session-03"),
    repositoryPath,
    "        payload: {",
    "        },",
  ),
);
const afterCode = dedent(
  blockOf(
    projectFilesForSnapshot("session-03-solution"),
    auditPayloadPath,
    "export const toAuditPayload = (",
    "});",
  ),
);

const sides = {
  before: {
    label: part === "problem" ? "現在のコード" : "修正前",
    path: lineLabelOf(
      "session-03",
      repositoryPath,
      "        payload: {",
      "        },",
    ),
    code: beforeCode,
  },
  after: {
    label: "修正後",
    path: lineLabelOf(
      "session-03-solution",
      auditPayloadPath,
      "export const toAuditPayload = (",
      "});",
    ),
    code: afterCode,
  },
} as const;

const lit = {
  before: { 1: [lineOf(beforeCode, "ownerContact:")] },
  after: {
    2: [lineOf(afterCode, "appointmentId:"), lineOf(afterCode, "veterinarianId:"), lineOf(afterCode, "examinationStartedAt:")],
    3: [lineOf(afterCode, "veterinarianId:"), lineOf(afterCode, "examinationStartedAt:")],
  },
};

const contact = clinicFixture.ownerContact;
const frames = [
  {
    caption: "診察を開始するたびに、監査記録が1件記録されます。",
  },
  {
    caption: `${part === "problem" ? "現在" : "修正前"}のコードは、監査記録に ownerContact を含めています。個人情報（氏名・メールアドレス・電話番号）が、そのまま記録に残ります。`,
  },
  {
    caption: "修正後のコードは、appointmentId・veterinarianId・examinationStartedAt の3項目だけを記録に含めます。個人情報は含まれません。",
  },
  {
    caption: "個人情報を残さなくても、veterinarianId で「誰が」、examinationStartedAt で「いつ」診察を開始したかは確認できます。",
  },
] as const;

const [firstFrame, endFrame] =
  part === "problem" ? [0, 2] : part === "solution" ? [2, 4] : [0, 4];
const shownFrames = frames.slice(firstFrame, endFrame);
const showsAfter = part !== "problem";

const litData = JSON.stringify(lit);
---

<figure class="audit-flow" data-audit-record-flow data-lit={litData} data-offset={firstFrame} aria-label="診察開始の監査記録の修正前と修正後">
  <StepControls />

  <div class="audit-flow__trigger">
    <span class="audit-flow__button">獣医師が「診察を開始する」</span>
    <span class="audit-flow__arrows" aria-hidden="true">▼　　　　▼</span>
  </div>

  <div class:list={["audit-flow__columns", { "audit-flow__columns--single": !showsAfter }]}>
    <section class="audit-flow__column" data-side="before">
      <MiniTree tree={treeBefore} current={["repo"]} />
      <figure class="code-block audit-flow__code">
        <figcaption>
          <span class="audit-flow__tag audit-flow__tag--before">{sides.before.label}</span>
          <code>{sides.before.path}</code>
        </figcaption>
        <Code code={sides.before.code} lang="ts" />
      </figure>
      <div class="audit-flow__record">
        <p class="audit-flow__record-title">監査記録 1件</p>
        <ul>
          <li class="audit-flow__row audit-flow__row--muted" data-from="1" style="--i: 0">
            <span>appointment</span><span>予約の内容</span>
          </li>
          <li class="audit-flow__row audit-flow__row--danger" data-from="1" style="--i: 1">
            <span>ownerName</span><span>{contact.ownerName}</span>
          </li>
          <li class="audit-flow__row audit-flow__row--danger" data-from="1" style="--i: 2">
            <span>ownerEmail</span><span>{contact.ownerEmail}</span>
          </li>
          <li class="audit-flow__row audit-flow__row--danger" data-from="1" style="--i: 3">
            <span>ownerPhone</span><span>{contact.ownerPhone}</span>
          </li>
        </ul>
      </div>
    </section>

    {showsAfter && (
      <section class="audit-flow__column" data-side="after">
        <MiniTree tree={treeAfter} current={["audit"]} />
        <figure class="code-block audit-flow__code">
          <figcaption>
            <span class="audit-flow__tag audit-flow__tag--after">{sides.after.label}</span>
            <code>{sides.after.path}</code>
          </figcaption>
          <Code code={sides.after.code} lang="ts" />
        </figure>
        <div class="audit-flow__record">
          <p class="audit-flow__record-title">監査記録 1件</p>
          <ul>
            <li class="audit-flow__row audit-flow__row--keep" data-from="2" style="--i: 0">
              <span>appointmentId</span><span>どの予約か</span>
            </li>
            <li class="audit-flow__row audit-flow__row--keep" data-from="2" style="--i: 1">
              <span>veterinarianId</span><span>誰が</span>
            </li>
            <li class="audit-flow__row audit-flow__row--keep" data-from="2" style="--i: 2">
              <span>examinationStartedAt</span><span>いつ</span>
            </li>
            <li class="audit-flow__row audit-flow__row--ghost" data-from="3" style="--i: 3">
              <span>ownerContact</span><span>残さない</span>
            </li>
          </ul>
        </div>
      </section>
    )}
  </div>

  <div aria-live="polite">
    <ol class="audit-flow__frames">
      {shownFrames.map((frame) => (
        <li data-frame>
          <p class="audit-flow__caption">{frame.caption}</p>
        </li>
      ))}
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  type Lit = Partial<Record<"before" | "after", Record<string, number[]>>>;

  document.querySelectorAll<HTMLElement>("[data-audit-record-flow]").forEach((root) => {
    const lit = JSON.parse(root.dataset.lit ?? "{}") as Lit;
    const offset = Number(root.dataset.offset ?? 0);
    const lines = (side: "before" | "after") =>
      [...root.querySelectorAll<HTMLElement>(`[data-side="${side}"] .line`)];
    const rows = [...root.querySelectorAll<HTMLElement>("[data-from]")];

    mountStepper({
      root,
      onStep: (index) => {
        const step = index + offset;
        root.dataset.phase = String(step);
        (["before", "after"] as const).forEach((side) => {
          const active = lit[side]?.[String(step)] ?? [];
          lines(side).forEach((line, index) => line.classList.toggle("is-lit", active.includes(index)));
        });
        rows.forEach((row) => row.classList.toggle("is-shown", Number(row.dataset.from) <= step));
      },
    });
  });
</script>

<style>
  .audit-flow {
    min-width: 0;
    margin: 0.5rem 0;
  }

  .audit-flow :global(.step-controls) {
    margin-block-end: 0.5rem;
  }

  .audit-flow__trigger {
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    margin-block-end: 0.25rem;
  }

  .audit-flow__button {
    padding: 0.375rem 1rem;
    border: 2px solid var(--case-line);
    border-radius: 999px;
    background: var(--case-paper);
    color: var(--case-ink);
    font-weight: 700;
  }

  .audit-flow__arrows {
    color: var(--case-muted);
    line-height: 1.2;
    white-space: pre;
  }

  .audit-flow__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .audit-flow__column {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-width: 0;
  }

  .audit-flow :global(.mini-tree) {
    column-gap: 0.25rem;
  }

  .audit-flow :global(.mini-tree .mini-tree__group) {
    display: contents;
  }

  .audit-flow__code {
    min-width: 0;
    margin: 0;
  }

  .audit-flow__code figcaption {
    justify-content: flex-start;
    align-items: center;
    padding-block: 0.25rem;
    row-gap: 0;
  }

  .audit-flow__code figcaption code {
    font-family: inherit;
    font-size: 0.6875rem;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .audit-flow__code :global(pre) {
    margin: 0;
    padding: 0.5rem 0;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .audit-flow__code :global(.line) {
    display: inline-block;
    min-width: 100%;
    padding-inline: 0.75rem;
  }

  .audit-flow__code :global(.line.is-lit) {
    background: color-mix(in srgb, var(--case-blue) 28%, transparent);
    box-shadow: inset 4px 0 0 var(--case-blue);
  }

  .audit-flow__tag {
    display: inline-block;
    padding: 0 0.5rem;
    border-radius: 0.25rem;
    color: var(--case-paper);
    font-weight: 700;
  }

  .audit-flow__tag--before {
    background: var(--case-pink);
  }

  .audit-flow__tag--after {
    background: var(--case-highlight);
  }

  .audit-flow__record {
    padding: 0.5rem 0.75rem 0.75rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--case-paper);
    color: var(--case-ink);
  }

  .audit-flow__record-title {
    margin: 0 0 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .audit-flow__record ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audit-flow__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.75rem;
    padding: 0.1875rem 0.5rem;
    border-inline-start: 4px solid var(--case-divider);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--case-divider) 35%, var(--case-paper));
    font-size: 0.8125rem;
  }

  .audit-flow__row span:first-child {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
  }

  .audit-flow__row--muted {
    color: var(--case-muted);
  }

  .audit-flow__row--danger {
    border-inline-color: var(--case-pink);
    background: color-mix(in srgb, var(--case-pink) 22%, var(--case-paper));
  }

  .audit-flow__row--keep {
    border-inline-color: var(--case-highlight);
    background: color-mix(in srgb, var(--case-highlight) 22%, var(--case-paper));
  }

  .audit-flow__row--ghost {
    border-style: dashed;
    border-inline-color: var(--case-muted);
    background: transparent;
    color: var(--case-muted);
  }

  .audit-flow__row--ghost span:first-child {
    text-decoration: line-through;
  }

  .audit-flow__frames {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.5rem;
  }

  .audit-flow__frames > li + li {
    margin-block-start: 0.5rem;
  }

  .audit-flow__caption {
    margin: 0;
    font-weight: 700;
    line-height: 1.7;
  }

  .audit-flow[data-ready] .audit-flow__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .audit-flow[data-ready] .audit-flow__frames > li {
    grid-area: 1 / 1;
  }

  .audit-flow[data-ready] .audit-flow__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .audit-flow[data-ready] .audit-flow__column,
  .audit-flow[data-ready] .audit-flow__code,
  .audit-flow[data-ready] .audit-flow__code :global(.line),
  .audit-flow[data-ready] .audit-flow__row,
  .audit-flow[data-ready] .audit-flow__record,
  .audit-flow[data-ready] .audit-flow__tag {
    transition: opacity 0.35s, transform 0.35s, background-color 0.25s, border-color 0.25s, filter 0.35s;
  }

  .audit-flow[data-ready] .audit-flow__row:not(.is-shown) {
    opacity: 0;
    transform: translateY(-0.5rem);
  }

  .audit-flow[data-ready] .audit-flow__row.is-shown {
    transition-delay: calc(var(--i) * 0.12s);
  }

  .audit-flow[data-ready][data-phase="0"] .audit-flow__code,
  .audit-flow[data-ready][data-phase="1"] .audit-flow__column[data-side="after"] .audit-flow__code,
  .audit-flow[data-ready][data-phase="2"] .audit-flow__column[data-side="before"] .audit-flow__code,
  .audit-flow[data-ready][data-phase="3"] .audit-flow__column[data-side="before"] .audit-flow__code {
    border-color: var(--case-divider);
    filter: grayscale(1);
  }

  .audit-flow[data-ready][data-phase="1"] .audit-flow__column[data-side="after"] .audit-flow__record,
  .audit-flow[data-ready][data-phase="2"] .audit-flow__column[data-side="before"] .audit-flow__record,
  .audit-flow[data-ready][data-phase="3"] .audit-flow__column[data-side="before"] .audit-flow__record {
    border-color: var(--case-divider);
  }

  .audit-flow[data-ready][data-phase="1"] .audit-flow__column[data-side="after"] .audit-flow__row,
  .audit-flow[data-ready][data-phase="2"] .audit-flow__column[data-side="before"] .audit-flow__row,
  .audit-flow[data-ready][data-phase="3"] .audit-flow__column[data-side="before"] .audit-flow__row {
    border-inline-color: var(--case-divider);
    background: transparent;
  }

  .audit-flow[data-ready][data-phase="1"] .audit-flow__column[data-side="after"] .audit-flow__tag,
  .audit-flow[data-ready][data-phase="2"] .audit-flow__column[data-side="before"] .audit-flow__tag,
  .audit-flow[data-ready][data-phase="3"] .audit-flow__column[data-side="before"] .audit-flow__tag {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--case-divider);
    color: var(--case-ink);
  }

  .audit-flow[data-ready][data-phase="3"] .audit-flow__column[data-side="after"] .audit-flow__row--keep:nth-child(n + 2) {
    outline: 2px solid var(--case-blue);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .audit-flow[data-ready][data-phase="0"] .audit-flow__arrows {
      animation: audit-flow-nudge 1.1s ease-in-out infinite;
    }

    @keyframes audit-flow-nudge {
      50% {
        transform: translateY(0.25rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audit-flow[data-ready] .audit-flow__column,
    .audit-flow[data-ready] .audit-flow__code,
    .audit-flow[data-ready] .audit-flow__code :global(.line),
    .audit-flow[data-ready] .audit-flow__row {
      transition: none;
    }
  }

  .audit-flow__columns--single {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 56rem) {
    .audit-flow__columns--single .audit-flow__column {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .audit-flow__columns--single .audit-flow__column > :global(.mini-tree) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .audit-flow__columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-height: 844px) {
    .audit-flow__trigger {
      margin-block-end: 0;
    }

    .audit-flow__button {
      padding-block: 0.1875rem;
    }

    .audit-flow__column {
      gap: 0.5rem;
    }

    .audit-flow__record {
      padding-block: 0.375rem 0.5rem;
    }

    .audit-flow__row {
      padding-block: 0.125rem;
    }

    .audit-flow__code :global(pre) {
      padding-block: 0.25rem;
      line-height: 1.35;
    }

    .audit-flow__frames {
      margin-block-start: 0.25rem;
    }
  }

  @media (max-height: 700px) {
    .audit-flow :global(.step-controls) {
      margin-block-end: 0.25rem;
    }

    .audit-flow__arrows {
      display: none;
    }

    .audit-flow__frames {
      margin-block-start: 0;
    }

    .audit-flow__record {
      padding-block: 0.25rem;
    }

    .audit-flow__record-title {
      margin-block-end: 0.125rem;
    }

    .audit-flow__row {
      padding-block: 0.0625rem;
    }
  }
</style>
