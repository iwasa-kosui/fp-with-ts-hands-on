---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import { keyedTransformer } from "../code-cache-key";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import { blockOf, lineLabelOf } from "../../sessions/source-quotes";
import StepControls from "../stepper/StepControls.astro";

type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
type Side = "before" | "after" | "plain";
type FlowStep = Readonly<{ title: string; body: readonly (string | Readonly<{ code: string }>)[]; code?: string }>;
type Item =
  | Readonly<{ kind: "flow"; steps: readonly [FlowStep, FlowStep, FlowStep] }>
  | Readonly<{ kind: "code"; path: string; code: string; marks: readonly number[] }>
  | Readonly<{ kind: "result"; label: string; tone: "pass" | "fail"; text: string; hit?: string }>
  | Readonly<{ kind: "samples"; label: string; values: readonly string[] }>;
type Column = Readonly<{ side: Side; heading: string; items: readonly Item[] }>;
type Frame = Readonly<{ caption: string; columns: readonly Column[] }>;
type Props = Readonly<{ example?: "uuid" | "sensitive" }>;

const { example = "uuid" } = Astro.props;

const lineOf = (source: string, needle: string) => {
  const index = source.split("\n").findIndex((line) => line.includes(needle));
  if (index < 0) throw new Error(`PropertyTestFlow: "${needle}" is not in the excerpt`);
  return index + 1;
};

const markLines = (lines: readonly number[]) => keyedTransformer<Transformer>(`property-test-flow-${JSON.stringify(lines)}`, {
  name: "property-flow-mark-lines",
  line(node, line) {
    if (lines.includes(line)) this.addClassToHast(node, "is-mark");
  },
});

const contactPath = "src/adaptor/primary/web/ownerContact.ts";
const protectedLine = '.brand<"OwnerEmail">().transform(Sensitive.of),';
const unprotectedLine = '.brand<"OwnerEmail">(),';
const goodContact = blockOf(
  projectFilesForSnapshot("session-03-solution"),
  contactPath,
  "const OwnerContactSchema = z",
  "  .readonly();",
);
const badContact = goodContact.replace(protectedLine, unprotectedLine);
if (badContact === goodContact) throw new Error(`PropertyTestFlow: ${protectedLine} is not in ${contactPath}`);
const emailLine = lineOf(goodContact, "ownerEmail:");

const teachingLabel = "説明用（教材のコードにはありません）";
const contactBlockLabel = lineLabelOf(
  "session-03-solution",
  contactPath,
  "const OwnerContactSchema = z",
  "  .readonly();",
);

const testCode = `import fc from "fast-check";
import { it } from "vitest";
import { OwnerContact } from "../src/adaptor/primary/web/ownerContact.js";
import { clinicFixture } from "../../fixtures/clinic.js";
const emailAddress = fc.stringMatching(/^[a-z]{1,8}@example\\.test$/);
it("どんなメールアドレスでも、JSON にしても出ない", () => {
  fc.assert(
    fc.property(emailAddress, (ownerEmail) => {
      const contact = OwnerContact.parse({
        ...clinicFixture.ownerContact,
        ownerEmail,
      })._unsafeUnwrap();
      return !JSON.stringify(contact).includes(ownerEmail);
    }),
  );
});`;

const typeTestCode = `import type { OwnerContact } from "../src/adaptor/primary/web/ownerContact.js";
declare const contact: OwnerContact;
// @ts-expect-error
const plain: string = contact.ownerEmail;
export { plain };`;

const redactedJson = '{"ownerName":"[REDACTED]","ownerEmail":"[REDACTED]","ownerPhone":"[REDACTED]"}';
const leakedEmail = "a@example.test";
const leakedJson = `{"ownerName":"[REDACTED]","ownerEmail":"${leakedEmail}","ownerPhone":"[REDACTED]"}`;
const jsonLabel = "JSON.stringify(contact) の結果";

const passedRun = [
  "✓ test/contact.test.ts (1 test)",
  " Test Files  1 passed (1)",
  "      Tests  1 passed (1)",
].join("\n");
const failedRun = [
  "× どんなメールアドレスでも、JSON にしても出ない",
  "  → Property failed after 1 tests",
  `Counterexample: ["${leakedEmail}"]`,
  "Shrunk 2 time(s)",
  " Test Files  1 failed (1)",
  "      Tests  1 failed (1)",
].join("\n");
const passedCompile = "（出力なし。終了コード 0）";
const failedCompile = "test/contact.type-test.ts(5,1): error TS2578: Unused '@ts-expect-error' directive.";

const contactCode = (code: string, path: string): Item => ({
  kind: "code",
  path,
  code,
  marks: [emailLine],
});
const typeTestItem: Item = {
  kind: "code",
  path: teachingLabel,
  code: typeTestCode,
  marks: [lineOf(typeTestCode, "@ts-expect-error"), lineOf(typeTestCode, "const plain")],
};

const badLabel = (label: string) => `${teachingLabel} 実物: ${label}`;

const beforeHeading = "変更前（正しいコード）";
const afterHeading = "変更後（誤った変更）";

const sensitiveFlow: Item = {
  kind: "flow",
  steps: [
    { title: "入力", body: ["メールアドレス。fast-check が多数生成します。"] },
    {
      title: "検証する処理",
      body: [{ code: "OwnerContact.parse" }, " で連絡先を作り、", { code: "JSON.stringify" }, " で JSON にします。"],
    },
    { title: "守りたい性質", body: ["JSON の文字列に、メールアドレスが含まれません。"], code: redactedJson },
  ],
};

const sensitiveFrames: readonly Frame[] = [
  {
    caption:
      "守りたい性質は、どんなメールアドレスで OwnerContact を作っても、JSON にした文字列にそのメールアドレスが含まれないことです。fast-check は、ランダムな入力を多数生成するライブラリです。",
    columns: [{ side: "plain", heading: "守りたい性質", items: [sensitiveFlow] }],
  },
  {
    caption:
      "テストは、fast-check が作ったメールアドレスごとに JSON を作り、その文字列にメールアドレスが含まれていなければ true を返します。false を返す入力が1つでもあるか、例外が投げられると、テストは失敗します。clinicFixture は、このハンズオンのテスト用の固定データです。fc.stringMatching は、正規表現に合う文字列を作ります。",
    columns: [
      {
        side: "plain",
        heading: "テストのコード",
        items: [
          {
            kind: "code",
            path: teachingLabel,
            code: testCode,
            marks: [lineOf(testCode, "const emailAddress"), lineOf(testCode, "return !JSON.stringify")],
          },
        ],
      },
      {
        side: "plain",
        heading: "fast-check が作る入力",
        items: [
          {
            kind: "samples",
            label: "fc.stringMatching が正規表現に合わせて作る文字列の例",
            values: ["eod@example.test", "ruc@example.test", "i@example.test", "wc@example.test"],
          },
        ],
      },
    ],
  },
  {
    caption:
      "正しいコードでは、ownerEmail の値が Sensitive（値を包み、ログと JSON では [REDACTED] に置き換える型）で包まれるので、JSON では [REDACTED] になり、テストは通ります。",
    columns: [
      { side: "before", heading: beforeHeading, items: [contactCode(goodContact, contactBlockLabel)] },
      {
        side: "before",
        heading: "テストの結果（説明用）",
        items: [
          { kind: "result", label: jsonLabel, tone: "pass", text: redactedJson },
          { kind: "result", label: "vitest の出力（説明用）", tone: "pass", text: passedRun },
        ],
      },
    ],
  },
  {
    caption:
      "誤った変更の例として、ownerEmail の行から .transform(Sensitive.of) を外します。メールアドレスは包まれなくなります。",
    columns: [
      { side: "before", heading: beforeHeading, items: [contactCode(goodContact, contactBlockLabel)] },
      { side: "after", heading: afterHeading, items: [contactCode(badContact, badLabel(contactBlockLabel))] },
    ],
  },
  {
    caption:
      "誤った変更を加えると、fast-check が失敗する入力を検出して、反例として表示します。fast-check は、失敗した入力を、失敗を保ったまま単純な入力に縮めて表示します。",
    columns: [
      {
        side: "before",
        heading: beforeHeading,
        items: [
          { kind: "result", label: jsonLabel, tone: "pass", text: redactedJson },
          { kind: "result", label: "vitest の出力（説明用）", tone: "pass", text: passedRun },
        ],
      },
      {
        side: "after",
        heading: afterHeading,
        items: [
          { kind: "result", label: jsonLabel, tone: "fail", text: leakedJson, hit: leakedEmail },
          { kind: "result", label: "vitest の出力（説明用）", tone: "fail", text: failedRun, hit: `["${leakedEmail}"]` },
        ],
      },
    ],
  },
  {
    caption:
      "型のテストでは、@ts-expect-error の次の行が型エラーであれば tsc は成功し、型エラーがなければ tsc は失敗します。declare const contact は、値を作らずに、型だけを宣言します。変更前は、次の行が型エラーになるので、tsc は成功します。",
    columns: [
      {
        side: "before",
        heading: beforeHeading,
        items: [
          contactCode(goodContact, contactBlockLabel),
          typeTestItem,
          { kind: "result", label: "tsc の出力（説明用）", tone: "pass", text: passedCompile },
        ],
      },
    ],
  },
  {
    caption:
      "誤った変更で ownerEmail の行から .transform(Sensitive.of) を外すと、ownerEmail が string に代入できる型になり、@ts-expect-error の次の行の型エラーが消えます。tsc は「未使用の @ts-expect-error」を報告し、失敗します。演習では exercises/guard/mine/ に *.type-test.ts という名前で置きます。",
    columns: [
      {
        side: "after",
        heading: afterHeading,
        items: [
          contactCode(badContact, badLabel(contactBlockLabel)),
          typeTestItem,
          { kind: "result", label: "tsc の出力（説明用）", tone: "fail", text: failedCompile },
        ],
      },
    ],
  },
];

const inputPath = "src/adaptor/primary/web/startExaminationInput.ts";
const inputOpen = "const schema = z.object({";
const inputClose = "}).readonly();";
const appointmentLine = "  appointmentId: AppointmentId.schema,";
const veterinarianLine = "  veterinarianId: VeterinarianId.schema,";
const goodInput = blockOf(projectFilesForSnapshot("session-03-solution"), inputPath, inputOpen, inputClose);
const withoutUuid = goodInput
  .replace(appointmentLine, '  appointmentId: z.string().brand<"AppointmentId">(),')
  .replace(veterinarianLine, '  veterinarianId: z.string().brand<"VeterinarianId">(),');
const swappedIds = goodInput.replace(veterinarianLine, "  veterinarianId: AppointmentId.schema,");
if (withoutUuid === goodInput || swappedIds === goodInput) throw new Error(`PropertyTestFlow: the schema lines are not in ${inputPath}`);
const inputLine = lineOf(goodInput, "appointmentId:");
const inputBlockLabel = lineLabelOf("session-03-solution", inputPath, inputOpen, inputClose);

const uuidTestCode = `import fc from "fast-check";
import { it } from "vitest";

import { StartExaminationInput } from "../subjects/input.js";

const veterinarianId = "44444444-4444-4444-8444-444444444444";
const uuidLike = /^[0-9a-f-]{36}$/i;
const notUuid = fc.string().filter((s) => !uuidLike.test(s));

it("UUID でない予約 ID は Err になる", () => {
  fc.assert(
    fc.property(notUuid, (appointmentId) => {
      const input = { appointmentId, veterinarianId };
      return StartExaminationInput.parse(input).isErr();
    }),
  );
});`;

const idsTypeTestCode = `import type { AppointmentId }
  from "../../../src/domain/appointment/index.js";
import { StartExaminationInput } from "../subjects/input.js";

declare const input: StartExaminationInput;

// @ts-expect-error
const appointmentId: AppointmentId = input.veterinarianId;`;
const idsTypeTestItem: Item = {
  kind: "code",
  path: teachingLabel,
  code: idsTypeTestCode,
  marks: [lineOf(idsTypeTestCode, "@ts-expect-error"), lineOf(idsTypeTestCode, "const appointmentId")],
};
const veterinarianCode = (code: string, path: string): Item => ({
  kind: "code",
  path,
  code,
  marks: [lineOf(code, "veterinarianId:")],
});

const errText = "Err()";
const parseLabel = "StartExaminationInput.parse の結果";
const uuidPassedRun = [
  "✓ mine/input.test.ts (1 test)",
  " Test Files  1 passed (1)",
  "      Tests  1 passed (1)",
].join("\n");
const acceptedText = 'Ok({ appointmentId: "", veterinarianId: "44444444-4444-4444-8444-444444444444" })';
const acceptedHit = 'appointmentId: ""';
const emptyCounterexample = '[""]';
const uuidFailedRun = [
  "× UUID でない予約 ID は Err になる",
  "  → Property failed after 1 tests",
  `Counterexample: ${emptyCounterexample}`,
  "Shrunk 1 time(s)",
  " Test Files  1 failed (1)",
  "      Tests  1 failed (1)",
].join("\n");
const uuidFailedCompile = `mine/ids.type-test.ts(${lineOf(idsTypeTestCode, "@ts-expect-error")},1): error TS2578: Unused '@ts-expect-error' directive.`;

const uuidFrames: readonly Frame[] = [
  {
    caption:
      "守りたい性質は、UUID でない文字列を予約ID として渡したとき、StartExaminationInput.parse が Err を返すことです。値の性質のテスト（プロパティベーステスト）は、ランダムな入力を多数生成して、この性質が常に成り立つかを検証します。fast-check は、その入力を生成するライブラリです。",
    columns: [
      {
        side: "plain",
        heading: "守りたい性質",
        items: [
          {
            kind: "flow",
            steps: [
              { title: "入力", body: ["UUID でない文字列。fast-check が多数生成します。"] },
              { title: "検証する処理", body: ["予約IDとして ", { code: "StartExaminationInput.parse" }, " に渡します。"] },
              { title: "守りたい性質", body: ["結果は Err です。"], code: errText },
            ],
          },
        ],
      },
    ],
  },
  {
    caption:
      "テストは、fast-check が作った UUID でない文字列を予約IDとして parse に渡し、結果が Err であれば true を返します。false を返す入力が1つでもあるか、例外が投げられると、テストは失敗します。fc.string() は任意の文字列を作り、filter は UUID の形の文字列を除きます。",
    columns: [
      {
        side: "plain",
        heading: "テストのコード",
        items: [
          {
            kind: "code",
            path: teachingLabel,
            code: uuidTestCode,
            marks: [lineOf(uuidTestCode, "const notUuid"), lineOf(uuidTestCode, ".isErr()")],
          },
        ],
      },
      {
        side: "plain",
        heading: "fast-check が作る入力",
        items: [
          {
            kind: "samples",
            label: "notUuid が作る文字列の例",
            values: ['""', '" "', '"a"', '"gm0"'],
          },
        ],
      },
    ],
  },
  {
    caption:
      "正しいコードでは、予約IDの schema が UUID の形を検査するので、UUID でない文字列は Err になり、テストは通ります。",
    columns: [
      {
        side: "before",
        heading: beforeHeading,
        items: [{ kind: "code", path: inputBlockLabel, code: goodInput, marks: [inputLine] }],
      },
      {
        side: "before",
        heading: "テストの結果（説明用）",
        items: [
          { kind: "result", label: parseLabel, tone: "pass", text: errText },
          { kind: "result", label: "vitest の出力（説明用）", tone: "pass", text: uuidPassedRun },
        ],
      },
    ],
  },
  {
    caption:
      "誤った変更の例として、2つの ID の schema から UUID の検査を外します。UUID でない文字列も受け付けるようになります。",
    columns: [
      {
        side: "before",
        heading: beforeHeading,
        items: [{ kind: "code", path: inputBlockLabel, code: goodInput, marks: [inputLine, inputLine + 1] }],
      },
      {
        side: "after",
        heading: afterHeading,
        items: [{ kind: "code", path: badLabel(inputBlockLabel), code: withoutUuid, marks: [inputLine, inputLine + 1] }],
      },
    ],
  },
  {
    caption:
      "誤った変更を加えると、fast-check が失敗する入力を検出して、反例として表示します。fast-check は、失敗した入力を、失敗を保ったまま単純な入力に縮めて表示します。",
    columns: [
      {
        side: "before",
        heading: beforeHeading,
        items: [
          { kind: "result", label: parseLabel, tone: "pass", text: errText },
          { kind: "result", label: "vitest の出力（説明用）", tone: "pass", text: uuidPassedRun },
        ],
      },
      {
        side: "after",
        heading: afterHeading,
        items: [
          { kind: "result", label: parseLabel, tone: "fail", text: acceptedText, hit: acceptedHit },
          { kind: "result", label: "vitest の出力（説明用）", tone: "fail", text: uuidFailedRun, hit: emptyCounterexample },
        ],
      },
    ],
  },
  {
    caption:
      "型のテストでは、@ts-expect-error の次の行が型エラーであれば tsc は成功し、型エラーがなければ tsc は失敗します。declare const input は、値を作らずに、型だけを宣言します。変更前は、獣医師IDを予約IDの変数へ代入する次の行が型エラーになるので、tsc は成功します。",
    columns: [
      {
        side: "before",
        heading: beforeHeading,
        items: [
          veterinarianCode(goodInput, inputBlockLabel),
          idsTypeTestItem,
          { kind: "result", label: "tsc の出力（説明用）", tone: "pass", text: passedCompile },
        ],
      },
    ],
  },
  {
    caption:
      "別の誤った変更として、veterinarianId の schema を AppointmentId.schema に変えます。2つの ID が同じ型になり、@ts-expect-error の次の行の型エラーが消えます。tsc は「未使用の @ts-expect-error」を報告し、失敗します。演習では exercises/guard/mine/ に *.type-test.ts という名前で置きます。",
    columns: [
      {
        side: "after",
        heading: afterHeading,
        items: [
          veterinarianCode(swappedIds, badLabel(inputBlockLabel)),
          idsTypeTestItem,
          { kind: "result", label: "tsc の出力（説明用）", tone: "fail", text: uuidFailedCompile },
        ],
      },
    ],
  },
];

const frames = example === "sensitive" ? sensitiveFrames : uuidFrames;

const sideMark = { before: "●", after: "▲", plain: "■" } as const;
---

<figure class="property-flow" data-property-flow aria-label="値の性質のテストと型のテストで誤った変更を検出する流れ">
  <StepControls />

  <div aria-live="polite">
    <ol class="property-flow__frames">
      {frames.map((frame) => (
        <li data-frame>
          <p class="property-flow__caption">{frame.caption}</p>
          <div class:list={["property-flow__columns", { "property-flow__columns--single": frame.columns.length === 1 }]}>
            {frame.columns.map((column) => (
              <section class="property-flow__column" data-side={column.side}>
                <h4 class="property-flow__heading"><span aria-hidden="true">{sideMark[column.side]}</span> {column.heading}</h4>
                {column.items.map((item) => {
                  if (item.kind === "flow") {
                    return (
                      <ol class="property-flow__steps">
                        {item.steps.flatMap((step, index) => [
                          ...(index > 0 ? [<li class="property-flow__arrow" aria-hidden="true">→</li>] : []),
                          <li>
                            <p class="property-flow__step-title">{step.title}</p>
                            <p>{step.body.map((part) => (typeof part === "string" ? part : <code>{part.code}</code>))}</p>
                            {step.code !== undefined && <p><code>{step.code}</code></p>}
                          </li>,
                        ])}
                      </ol>
                    );
                  }
                  if (item.kind === "code") {
                    return (
                      <figure class="code-block property-flow__code">
                        <figcaption><code>{item.path}</code></figcaption>
                        <Code code={item.code} lang="ts" transformers={[markLines(item.marks)]} />
                      </figure>
                    );
                  }
                  if (item.kind === "samples") {
                    return (
                      <div class="property-flow__samples">
                        <p>{item.label}</p>
                        <ul>
                          {item.values.map((value) => <li><code>{value}</code></li>)}
                        </ul>
                      </div>
                    );
                  }
                  const [head = "", tail = ""] = item.hit === undefined ? [item.text, ""] : item.text.split(item.hit);
                  return (
                    <figure class="property-flow__result" data-tone={item.tone}>
                      <figcaption>{item.label}</figcaption>
                      <pre><code>{head}{item.hit !== undefined && <mark>{item.hit}</mark>}{tail}</code></pre>
                    </figure>
                  );
                })}
              </section>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-property-flow]").forEach((root) => {
    mountStepper({ root });
  });
</script>

<style>
  .property-flow {
    --tone: var(--role-accent);
    min-width: 0;
    margin: 0.5rem 0;
    color: var(--role-text);
  }

  .property-flow :global(.step-controls) {
    margin-block-end: 0.5rem;
  }

  .property-flow__frames {
    margin: 0;
    padding-inline-start: 1.5rem;
  }

  .property-flow__frames > li + li {
    margin-block-start: 1rem;
  }

  .property-flow__caption {
    margin: 0 0 0.5rem;
    font-weight: 700;
    line-height: 1.7;
  }

  .property-flow__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  .property-flow__columns--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .property-flow__column {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.5rem 0.625rem;
    border: 2px solid var(--tone);
    border-radius: 0.5rem;
    background: var(--role-surface);
  }

  .property-flow__column[data-side="before"] {
    --tone: var(--role-positive);
  }

  .property-flow__column[data-side="after"] {
    --tone: var(--role-negative);
  }

  .property-flow__heading {
    margin: 0;
    color: var(--tone);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .property-flow__code {
    min-width: 0;
    margin: 0;
  }

  .property-flow__code figcaption {
    padding-block: 0.125rem;
  }

  .property-flow__code figcaption code {
    font-family: inherit;
    font-size: 0.6875rem;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .property-flow__code :global(pre) {
    margin: 0;
    padding: 0.375rem 0;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .property-flow__code :global(:is(pre, code, .line)) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .property-flow__code :global(.line) {
    display: inline-block;
    min-width: 100%;
