---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import { keyedTransformer } from "./code-cache-key";
import appointmentSource from "../../../../examples/final/src/domain/appointment/appointment.ts?raw";
import transitionsSource from "../../../../examples/session-06-solution/src/domain/appointment/transitions.ts?raw";
import { lineLabelOf } from "../sessions/source-quotes";
import StepControls from "./stepper/StepControls.astro";

type SceneName = "cancel" | "start-examination";

interface Props {
  auditLabel?: string;
  condensedCode?: boolean;
  scene?: SceneName;
}

const { auditLabel = "履歴", condensedCode = false, scene = "cancel" } = Astro.props;
const audit = (text: string) => text.replaceAll("履歴", auditLabel);

const quote = (source: string, from: number, to: number, firstLine: string, lastLine: string): string => {
  const lines = source.split("\n").slice(from - 1, to);
  if (!lines[0]?.includes(firstLine)) throw new Error(`引用元の先頭行がずれています: ${firstLine}`);
  if (!lines[lines.length - 1]?.includes(lastLine)) throw new Error(`引用元の末尾行がずれています: ${lastLine}`);
  const indent = Math.min(...lines.filter((line) => line.trim() !== "").map((line) => line.search(/\S/)));
  return lines.map((line) => line.slice(indent)).join("\n");
};

const condenseCancel = (code: string): string => {
  const lines = code.split("\n");
  const kind = lines.findIndex((line) => line.trim() === 'kind: "Canceled",');
  const close = lines.findIndex((line) => line.trim() === "} as const satisfies Canceled;");
  const create = lines.findIndex((line) => line.trim() === "return AppointmentEvent.create(");
  const state = lines.findIndex((line) => line.trim() === "aggregateState,");
  const end = lines.map((line) => line.trim()).lastIndexOf(");");
  if (kind < 0 || close < kind || create < close || state < create || end < state) {
    throw new Error("引用元の形がずれていて、コードを短くできません");
  }
  const omitted = (index: number) => `${lines[index].slice(0, lines[index].search(/\S/))}…`;
  return [
    ...lines.slice(0, kind + 1),
    omitted(kind),
    lines[close],
    lines[create],
    omitted(create + 1),
    lines[state],
    omitted(state),
    lines[end],
  ].join("\n");
};

const condenseStart = (code: string): string => {
  const lines = code.split("\n");
  const find = (text: string, from = 0) => lines.findIndex((line, index) => index >= from && line.trim() === text);
  const create = find("const aggregateState = startExamination(");
  const closeArgs = find(");", create);
  const ret = find("return {", closeArgs);
  const kind = find('kind: "ExaminationStarted",', ret);
  const state = find("aggregateState,", kind);
  const close = find("} as const satisfies ExaminationStarted;", state);
  const signature = lines[0].replace("veterinarianId: VeterinarianId", "…");
  if (signature === lines[0] || create < 1 || closeArgs < create || ret < closeArgs || kind < ret || state < kind || close < state) {
    throw new Error("引用元の形がずれていて、コードを短くできません");
  }
  const omitted = (index: number) => `${lines[index].slice(0, lines[index].search(/\S/))}…`;
  return [
    signature,
    lines[create],
    omitted(create + 1),
    lines[closeArgs],
    lines[ret],
    lines[kind],
    omitted(kind + 1),
    lines[state],
    lines[close],
  ].join("\n");
};

const cancelCode = quote(appointmentSource, 215, 234, "): AppointmentCanceled => {", ");");
const startCode = quote(transitionsSource, 68, 82, "(appointment: CheckedIn, veterinarianId: VeterinarianId): ExaminationStarted => {", "},");

type Chip = Readonly<{ text: string; mono?: boolean; ghost?: boolean; note?: boolean; arrow?: boolean }>;
type Field = Readonly<{ label?: string; chips: readonly Chip[] }>;

const scenes = {
  cancel: {
    label: "キャンセルで予約の集約の現在の状態と履歴を一致させて保存する流れ",
    from: "Scheduled",
    to: "Canceled",
    fromAudit: "予約された",
    toAudit: "キャンセルされた",
    missingAudit: "キャンセルが無い",
    snippet: {
      path: "examples/final/src/domain/appointment/appointment.ts",
      code: condensedCode ? condenseCancel(cancelCode) : cancelCode,
      keys: ['kind: "Canceled",', "return AppointmentEvent.create("],
    },
    captions: [
      "予約1件の現在の状態と、その予約の履歴を、1つの枠で囲みます。キャンセルで変わるのは、この枠の中だけです。別の予約や飼い主のデータは変わりません。",
      "キャンセルの処理 Appointment.cancel は、イベント AppointmentCanceled を返します。このイベントは、キャンセル後の予約の状態（aggregateState）を持ちます。1つの値が、書き込む現在の状態と履歴の両方を表します。",
      "保存を2回に分けた場合です。現在の状態を書き込んだ後で履歴の追記が失敗すると、予約は Canceled ですが、履歴にキャンセルが残りません。整合性が崩れた状態です。",
      "集約を単位に1回で保存すると、結果は、両方が書かれるか、どちらも書かれないかの2通りになります。どちらの場合も、現在の状態と履歴は一致します。",
    ],
  },
  "start-examination": {
    label: "診察開始で予約の集約の現在の状態と履歴を一致させて保存する流れ",
    from: "CheckedIn",
    to: "InExamination",
    fromAudit: "来院を受け付けた",
    toAudit: "診察が始まった",
    missingAudit: "診察開始が無い",
    snippet: {
      path: lineLabelOf(
        "session-06-solution",
        "src/domain/appointment/transitions.ts",
        "    (appointment: CheckedIn, veterinarianId: VeterinarianId): ExaminationStarted => {",
        "    },",
      ),
      code: condensedCode ? condenseStart(startCode) : startCode,
      keys: ['kind: "ExaminationStarted",', "aggregateState,"],
    },
    captions: [
      "枠の中は、予約1件の現在の状態と履歴です。この枠は、一緒に扱うデータのまとまりとしては予約の集約、1回で変更を確定する範囲としては整合性境界と呼び、診察開始では同じ範囲です。別の予約や飼い主のデータは枠の外にあり、変わりません。",
      "診察開始の処理 Appointment.startExamination は、イベント ExaminationStarted を返します。図のコードは、この処理の抜粋です（「…」は省略した部分）。ExaminationStarted は、診察開始後の予約の状態（aggregateState）を持ち、この1つの値が、書き込む現在の状態と履歴の両方を表します。",
      "保存を2回に分けた場合です。現在の状態を書き込んだ後で履歴の追記が失敗すると、予約は InExamination ですが、履歴に診察開始が残りません。整合性が崩れた状態です。",
      "整合性境界を単位に1回で保存すると、結果は、両方が書かれるか、どちらも書かれないかの2通りになります。どちらの場合も、現在の状態と履歴は一致します。",
    ],
  },
} as const satisfies Record<SceneName, unknown>;
const config = scenes[scene];
const showBoundary = scene === "start-examination";
const saveUnit = showBoundary ? "整合性境界" : "集約";

type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const KEY_MARK = /\s*\/\/ \[!aggregate-flow-key\]$/;
const keyLineNumbers = (source: string, keyTexts: readonly string[]) =>
  keyTexts.map((text) => {
    const found = source.split("\n").flatMap((line, index) => (line.trim() === text ? [index + 1] : []));
    if (found.length !== 1) throw new Error(`強調する行が一意に見つかりません: ${text}`);
    return found[0];
  });
const withMarks = (source: string, keyLines: readonly number[]) =>
  source.split("\n").map((text, index) => (keyLines.includes(index + 1) ? `${text} // [!aggregate-flow-key]` : text)).join("\n");
const markKeyLines = keyedTransformer<Transformer>("aggregate-consistency-flow", {
  name: "mark-aggregate-flow-key-lines",
  preprocess(source) {
    const lines = source.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((text, index) => (KEY_MARK.test(text) ? [index + 1] : []));
    return lines.map((text) => text.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "aggregate-flow__key");
  },
});

const appointmentFields = (ghost: boolean): readonly Field[] => [
  {
    label: "現在の状態",
    chips: [
      { text: config.from, mono: true },
      ...(ghost ? [{ text: config.to, mono: true, ghost: true, arrow: true }] : []),
    ],
  },
  {
    label: audit("履歴"),
    chips: [{ text: config.fromAudit }, ...(ghost ? [{ text: config.toAudit, ghost: true }] : [])],
  },
];

const mismatchFields: readonly Field[] = [
  { label: "現在の状態", chips: [{ text: config.to, mono: true }] },
  { label: audit("履歴"), chips: [{ text: config.missingAudit, note: true }] },
];

const outcomes: readonly Readonly<{ tag: string; fields: readonly Field[] }>[] = [
  {
    tag: "成功",
    fields: [
      { label: "現在の状態", chips: [{ text: config.to, mono: true }] },
      { label: audit("履歴"), chips: [{ text: config.toAudit }] },
    ],
  },
  {
    tag: "失敗",
    fields: [
      { label: "現在の状態", chips: [{ text: config.from, mono: true }] },
      { label: audit("履歴"), chips: [{ text: "変化なし", note: true }] },
    ],
  },
];

type Frame = Readonly<{
  caption: string;
  view: "aggregate" | "compare";
  ghost?: boolean;
  after?: boolean;
  code?: boolean;
}>;

const frames: readonly Frame[] = [
  { caption: audit(config.captions[0]), view: "aggregate" },
  { caption: audit(config.captions[1]), view: "aggregate", ghost: true, code: true },
  { caption: audit(config.captions[2]), view: "compare", after: false },
  {
    caption: audit(config.captions[3]),
    view: "compare",
    after: true,
  },
];
---

<figure
  class="aggregate-flow"
  aria-label={audit(config.label)}
  data-aggregate-flow
>
  <StepControls />

  <p class="aggregate-flow__live" data-live aria-live="polite" hidden></p>

  <ol class="aggregate-flow__frames">
    {frames.map((frame) => (
      <li data-frame data-view={frame.view}>
        <p class="aggregate-flow__caption" data-caption>{frame.caption}</p>

        {frame.view === "aggregate" && (
          <div class="aggregate-flow__diagram">
            <div class:list={["aggregate-flow__aggregate", { "aggregate-flow__aggregate--boundary": showBoundary }]}>
              <p class="aggregate-flow__aggregate-title">予約の集約{showBoundary && <span class="aggregate-flow__alias">整合性境界</span>}</p>
              <div class="aggregate-flow__fields">
                {appointmentFields(frame.ghost === true).map((field) => (
                  <div class="aggregate-flow__field">
                    <p class="aggregate-flow__field-label">{field.label}</p>
                    <div class="aggregate-flow__values aggregate-flow__values--stack">
                      {field.chips.map((chip) => (
                        <>
                          {chip.arrow && <span class="aggregate-flow__to" aria-hidden="true">↓</span>}
                          <span
                            class:list={[
                              "aggregate-flow__chip",
                              { "aggregate-flow__chip--mono": chip.mono, "aggregate-flow__chip--ghost": chip.ghost },
                            ]}
                          >
                            {chip.text}
                          </span>
                        </>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <ul class="aggregate-flow__outside">
              <li class="aggregate-flow__other">別の予約</li>
              <li class="aggregate-flow__other">飼い主</li>
            </ul>
            {frame.ghost && <p class="aggregate-flow__legend">破線: これから書き込む内容</p>}
          </div>
        )}

        {frame.view === "compare" && (
          <div class="aggregate-flow__compare">
            <section class="aggregate-flow__side">
              <p class="aggregate-flow__side-title"><span class="aggregate-flow__side-label">もし2回に分けたら</span>状態と{auditLabel}を別々に保存する</p>
              <ol class="aggregate-flow__steps">
                <li class="aggregate-flow__step">
                  <span class="aggregate-flow__step-no">1回目</span>
                  <span>現在の状態を書き込む</span>
                  <span class="aggregate-flow__tag aggregate-flow__tag--ok"><span aria-hidden="true">✓ </span>成功</span>
                </li>
                <li class="aggregate-flow__step">
                  <span class="aggregate-flow__step-no">2回目</span>
                  <span>{auditLabel}を追記する</span>
                  <span class="aggregate-flow__tag aggregate-flow__tag--bad"><span aria-hidden="true">✕ </span>失敗</span>
                </li>
              </ol>
              <p class="aggregate-flow__result-label">結果</p>
              <div class:list={["aggregate-flow__aggregate", { "aggregate-flow__aggregate--boundary": showBoundary }]}>
                <p class="aggregate-flow__aggregate-title">予約の集約{showBoundary && <span class="aggregate-flow__alias">整合性境界</span>}</p>
                <div class="aggregate-flow__fields">
                  {mismatchFields.map((field) => (
                    <div class="aggregate-flow__field">
                      <p class="aggregate-flow__field-label">{field.label}</p>
                      <div class="aggregate-flow__values">
                        {field.chips.map((chip) => (
                          <span
                            class:list={["aggregate-flow__chip", { "aggregate-flow__chip--mono": chip.mono, "aggregate-flow__chip--note": chip.note }]}
                          >
                            {chip.text}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              <p class="aggregate-flow__verdict aggregate-flow__verdict--bad"><span aria-hidden="true">✕ </span>状態と{auditLabel}が不一致</p>
            </section>

            <section class="aggregate-flow__side">
              <p class="aggregate-flow__side-title"><span class="aggregate-flow__side-label">1回にまとめたら</span>{saveUnit}を単位に1回で保存する</p>
              {frame.after ? (
                outcomes.map((outcome) => (
                  <div class="aggregate-flow__outcome">
                    <p class="aggregate-flow__outcome-tag"><span class="aggregate-flow__tag aggregate-flow__tag--plain">{outcome.tag}</span></p>
                    <div class:list={["aggregate-flow__aggregate", { "aggregate-flow__aggregate--boundary": showBoundary }]}>
                      <p class="aggregate-flow__aggregate-title">予約の集約{showBoundary && <span class="aggregate-flow__alias">整合性境界</span>}</p>
                      <div class="aggregate-flow__fields">
                        {outcome.fields.map((field) => (
                          <div class="aggregate-flow__field">
                            <p class="aggregate-flow__field-label">{field.label}</p>
                            <div class="aggregate-flow__values">
                              {field.chips.map((chip) => (
                                <span
                                  class:list={["aggregate-flow__chip", { "aggregate-flow__chip--mono": chip.mono, "aggregate-flow__chip--note": chip.note }]}
                                >
                                  {chip.text}
                                </span>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                    <p class="aggregate-flow__verdict aggregate-flow__verdict--good"><span aria-hidden="true">✓ </span>状態と{auditLabel}が一致</p>
                  </div>
                ))
              ) : (
                <div class="aggregate-flow__placeholder" aria-hidden="true"></div>
              )}
            </section>
          </div>
        )}

        {frame.code && (
          <figure class="code-block aggregate-flow__code">
            <figcaption><code>{config.snippet.path}</code></figcaption>
            <Code
              code={withMarks(config.snippet.code, keyLineNumbers(config.snippet.code, config.snippet.keys))}
              lang="typescript"
              defaultColor="dark"
              transformers={[markKeyLines]}
            />
          </figure>
        )}
      </li>
    ))}
  </ol>
</figure>

<script>
  import { renderProgress } from "./stepper/step-progress";

  const setUp = (root: HTMLElement) => {
    if (root.dataset.ready !== undefined) return;
    const panels = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const captions = panels.map((panel) => panel.querySelector<HTMLElement>("[data-caption]")?.textContent ?? "");
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    if (!controls || !prev || !next || !progress || !live) return;
    if (panels.length === 0) return;
    root.dataset.ready = "";

    let current = 0;
    const show = (index: number) => {
      current = index;
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));
      live.textContent = captions[index];
      renderProgress(progress, index, panels.length);
      prev.disabled = index === 0;
      next.disabled = index === panels.length - 1;
    };

    prev.addEventListener("click", () => {
      show(Math.max(current - 1, 0));
    });
    next.addEventListener("click", () => {
      show(Math.min(current + 1, panels.length - 1));
    });
    root.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(Math.max(current - 1, 0));
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(Math.min(current + 1, panels.length - 1));
      }
    });

    root.tabIndex = 0;
    root.dataset.animated = "";
    controls.hidden = false;
    live.hidden = false;
    show(0);
  };

  document.querySelectorAll<HTMLElement>("[data-aggregate-flow]").forEach(setUp);
</script>

<style>
  .aggregate-flow {
    --agg: var(--case-blue, #2236b8);
    --ok: var(--role-positive, #137333);
    --bad: var(--role-negative, #b3261e);
    --muted: color-mix(in srgb, var(--case-ink, #111116) 72%, var(--case-paper, #fffefa));
    container-type: inline-size;
    min-width: 0;
    max-width: 100%;
    margin: 1.5rem 0;
  }

  .aggregate-flow__live,
  .aggregate-flow__caption {
    margin: 0.75rem 0 0.5rem;
    font-weight: 700;
    line-height: 1.7;
  }

  .aggregate-flow__live[hidden] {
    display: none;
  }

  .aggregate-flow__frames {
    margin: 0;
    padding-inline-start: 1.5rem;
  }

  .aggregate-flow__frames > li {
    min-width: 0;
  }

  .aggregate-flow__frames > li + li {
    margin-top: 1.5rem;
  }

  .aggregate-flow__diagram,
  .aggregate-flow__compare {
    margin-top: 0.75rem;
  }

  .aggregate-flow__aggregate {
    min-width: 0;
    overflow: hidden;
    border: 3px solid var(--agg);
    border-radius: 0.75rem;
    background: var(--case-paper, #fffefa);
    color: var(--case-ink, #111116);
  }

  .aggregate-flow__aggregate--boundary {
    background: color-mix(in srgb, var(--agg) 16%, var(--case-paper, #fffefa));
  }

  .aggregate-flow__alias {
    margin-inline-start: 0.5rem;
    padding: 0 0.4rem;
    border: 1.5px solid currentColor;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .aggregate-flow__aggregate-title {
    margin: 0;
    padding: 0.3rem 0.6rem;
    background: var(--agg);
    color: var(--role-surface, #fff);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .aggregate-flow__fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(8rem, 100%), 1fr));
    gap: 0.5rem;
    padding: 0.5rem;
  }

  .aggregate-flow__field {
    min-width: 0;
    padding: 0.4rem;
    border: 2px solid var(--case-line, #17204d);
    border-radius: 0.4rem;
    background: var(--case-cream, #fff8ce);
  }

  .aggregate-flow__field-label {
    margin: 0 0 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .aggregate-flow__values {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
  }

  .aggregate-flow__values--stack {
    flex-direction: column;
    align-items: flex-start;
  }

  .aggregate-flow__chip {
    display: inline-block;
    max-width: 100%;
    padding: 0.15rem 0.45rem;
    border: 2px solid var(--case-line, #17204d);
    border-radius: 0.35rem;
    background: var(--case-paper, #fffefa);
    font-size: 0.8rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .aggregate-flow__chip--mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    overflow-wrap: normal;
    white-space: nowrap;
  }

  .aggregate-flow__chip--ghost {
    border-color: var(--agg);
    border-style: dashed;
    background: transparent;
    color: var(--agg);
    font-weight: 700;
  }

  .aggregate-flow__chip--note {
    border-style: dotted;
    border-color: var(--muted);
    background: transparent;
    color: var(--muted);
  }

  .aggregate-flow__to {
    color: var(--agg);
    font-weight: 700;
    line-height: 1;
  }

  .aggregate-flow__outside {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .aggregate-flow__other {
    padding: 0.4rem 0.75rem;
    border: 2px solid var(--muted);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--case-ink, #111116) 6%, var(--case-paper, #fffefa));
    color: var(--muted);
    font-size: 0.85rem;
  }

  .aggregate-flow__legend {
    margin: 0.5rem 0 0;
    color: var(--agg);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .aggregate-flow__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    align-items: start;
  }

  .aggregate-flow__side {
    min-width: 0;
    padding: 0.4rem;
    border: 2px solid var(--case-line, #17204d);
    border-radius: 0.5rem;
    background: var(--case-paper, #fffefa);
    color: var(--case-ink, #111116);
    font-size: 0.8rem;
    line-height: 1.5;
