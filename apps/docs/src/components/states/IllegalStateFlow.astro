---
import { Code } from "astro:components";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import { sourceOf } from "../../sessions/source-quotes";
import StepControls from "../stepper/StepControls.astro";
import "./states.css";

const generations = {
  before: { snapshot: "session-00", tag: "S00 のコード" },
  after: { snapshot: "session-01", tag: "S01 の開始コード" },
} as const;

const directory = "src/domain/appointment";

const fileDefinitions = [
  { key: "before-appointment", generation: "before", name: "appointment.ts" },
  { key: "before-statusLabel", generation: "before", name: "statusLabel.ts" },
  { key: "after-appointment", generation: "after", name: "appointment.ts" },
  { key: "after-statusLabel", generation: "after", name: "statusLabel.ts" },
  { key: "after-transitions", generation: "after", name: "transitions.ts" },
] as const;

type FileKey = (typeof fileDefinitions)[number]["key"];

const files = fileDefinitions.map((definition) => {
  const { snapshot, tag } = generations[definition.generation];
  const relativePath = `${directory}/${definition.name}`;
  return {
    ...definition,
    tag,
    snapshot,
    path: `examples/${snapshot}/${relativePath}`,
    source: sourceOf(projectFilesForSnapshot(snapshot), relativePath),
  };
});

const sourceOfKey = (key: FileKey): string => {
  const file = files.find((candidate) => candidate.key === key);
  if (file === undefined) throw new Error(`${key} is not a file in the figure`);
  return file.source;
};

const litLinesOf = (source: string, blockStart: string, needles: readonly string[]): readonly number[] => {
  const lines = source.split("\n");
  const start = lines.indexOf(blockStart);
  if (start < 0) throw new Error(`"${blockStart}" is not in the source`);
  return needles.map((needle) => {
    const offset = lines.slice(start).findIndex((line) => line.includes(needle));
    if (offset < 0) throw new Error(`"${needle}" is not after "${blockStart}"`);
    return start + offset;
  });
};

type Lit = Readonly<{ line: number; note?: string }>;

const withNotes = (lines: readonly number[], notes: readonly string[]): readonly Lit[] =>
  lines.map((line, index) => ({ line, note: notes[index] }));

const rangeOf = (source: string, firstLine: string, lastLine: string): Readonly<{ start: number; end: number }> => {
  const lines = source.split("\n");
  const start = lines.indexOf(firstLine);
  const end = lines.indexOf(lastLine, start);
  if (start < 0 || end < 0) throw new Error(`"${firstLine}" to "${lastLine}" is not in the source`);
  return { start, end };
};

const plain = (lines: readonly number[]): readonly Lit[] => lines.map((line) => ({ line }));

const spanOf = (range: Readonly<{ start: number; end: number }>): readonly number[] =>
  Array.from({ length: range.end - range.start + 1 }, (_, offset) => range.start + offset);

const beforeTypeStart = "export type Appointment = Readonly<{";
const beforeTypeNeedles = ["status: string;", "veterinarianId?: string;", "examinationStartedAt?: string;"];
const beforeTypeLines = litLinesOf(sourceOfKey("before-appointment"), beforeTypeStart, beforeTypeNeedles);
const beforeUpdateStart = "export const updateStatus = (";
const beforeUpdateLines = litLinesOf(sourceOfKey("before-appointment"), beforeUpdateStart, ["status: string"]);
const beforeTypeRange = rangeOf(sourceOfKey("before-appointment"), beforeTypeStart, "}>;");
const beforeTypeShown = [beforeTypeRange.start, ...beforeTypeLines, beforeTypeRange.end];
const beforeUpdateRange = rangeOf(
  sourceOfKey("before-appointment"),
  beforeUpdateStart,
  "): Appointment => ({ ...appointment, ...extra, status });",
);

const afterTypeStart = "export type InExamination = Readonly<{";
const afterTypeNeedles = ['kind: "InExamination";', "veterinarianId: string;", "examinationStartedAt: string;"];
const afterTypeLines = litLinesOf(sourceOfKey("after-appointment"), afterTypeStart, afterTypeNeedles);
const afterRequiredLines = litLinesOf(sourceOfKey("after-appointment"), afterTypeStart, afterTypeNeedles.slice(1));
const afterTypeRange = rangeOf(sourceOfKey("after-appointment"), afterTypeStart, "}>;");
const afterTypeShown = [afterTypeRange.start, ...afterTypeLines, afterTypeRange.end];

const beforeValue = `declare const checkedIn: Appointment;
const broken = updateStatus(
  checkedIn,
  "in-examination",
);`;
const afterValue = `declare const checkedIn: CheckedIn;
const broken: InExamination = {
  ...checkedIn,
  kind: "InExamination",
};`;

type Candidate = Readonly<{
  ok: boolean;
  reason: string;
  before: string;
  after: string;
}>;

const candidates: readonly Candidate[] = [
  {
    ok: true,
    reason: "獣医師と開始時刻がそろっている",
    before: `{
  status: "in-examination",
  veterinarianId: "vet-001",
  examinationStartedAt: "10:00",
}`,
    after: `{
  kind: "InExamination",
  veterinarianId: "vet-001",
  examinationStartedAt: "10:00",
}`,
  },
  {
    ok: false,
    reason: "診察中なのに、獣医師も開始時刻もない",
    before: `{
  status: "in-examination",
}`,
    after: `{
  kind: "InExamination",
}`,
  },
  {
    ok: false,
    reason: "状態の綴りが誤っている",
    before: `{
  status: "in-examintion",
}`,
    after: `{
  kind: "InExamintion",
}`,
  },
];

const scratchViews = [
  { id: "value-before", body: "value", generation: "before" },
  { id: "board-before", body: "board", generation: "before" },
  { id: "value-after", body: "value", generation: "after" },
  { id: "board-after", body: "board", generation: "after" },
] as const;

type ScratchId = (typeof scratchViews)[number]["id"];

type Frame = Readonly<{
  file: FileKey;
  part: string;
  focus: "file" | "scratch" | "board";
  scratch?: ScratchId;
  lit: readonly Lit[];
  show: readonly number[];
  treeNote?: Readonly<{ file: FileKey; text: string }>;
  caption: string;
}>;

const frames: readonly Frame[] = [
  {
    file: "before-appointment",
    part: "Appointment 型",
    focus: "file",
    lit: withNotes(beforeTypeLines, ["どんな文字列でも格納できる", "省略できる", "省略できる"]),
    show: beforeTypeShown,
    caption:
      "S00 のコードの Appointment は、状態を string で持ちます。診察中にだけ必要な veterinarianId と examinationStartedAt は、? を付けて省略できます。Readonly<{…}> は、項目を書き換えられない型にします。",
  },
  {
    file: "before-appointment",
    part: "updateStatus 関数",
    focus: "scratch",
    scratch: "value-before",
    lit: plain(beforeUpdateLines),
    show: spanOf(beforeUpdateRange),
    caption:
      "S00 の updateStatus は、状態を文字列で受け取ります。診察中なのに獣医師も開始時刻もない予約を作る呼び出しが、型検査を通ります。",
  },
  {
    file: "before-appointment",
    part: "Appointment 型",
    focus: "board",
    scratch: "board-before",
    lit: plain(beforeTypeLines),
    show: beforeTypeShown,
    caption: "この型は、業務上ありえない組み合わせを、すべて受け入れます。",
  },
  {
    file: "after-appointment",
    part: "InExamination 型",
    focus: "file",
    lit: withNotes(afterTypeLines, ['"InExamination" だけ', "必須", "必須"]),
    show: spanOf(afterTypeRange),
    caption:
      "S01 の開始コードは、状態ごとに別の型を持ちます。S00 の status: \"in-examination\" に当たる値は kind: \"InExamination\" で、値を型の名前と同じ綴りにしています。InExamination では veterinarianId と examinationStartedAt が必須です。型の定義はここまでで完了しており、残りは遷移関数の引数です。",
  },
  {
    file: "after-appointment",
    part: "InExamination 型",
    focus: "scratch",
    scratch: "value-after",
    lit: plain(afterRequiredLines),
    show: afterTypeShown,
    caption:
      "...checkedIn は、checkedIn の項目のコピーです。この値は、S00 のような関数の呼び出しではなく、オブジェクトの定義です。同じ状況の値を InExamination として定義すると、veterinarianId と examinationStartedAt がないことを、型検査が報告します。実行前に検出できます。",
  },
  {
    file: "after-appointment",
    part: "InExamination 型",
    focus: "board",
    scratch: "board-after",
    lit: plain(afterRequiredLines),
    show: afterTypeShown,
    caption:
      "同じ3つの値のうち、型検査が受け入れるのは、業務上ありえる1つだけです。業務上ありえない値を、型検査のときに報告できる形にする考え方です。",
  },
];

const oneLine = (literal: string): string => literal.replace(/\n\s*/g, " ").replace(/, }$/, " }");

const generationKeys = ["before", "after"] as const;
---

<figure class="st-fig illegal" data-illegal data-step-figure aria-label="必要な情報が欠けた予約を、型で排除する">
  <StepControls />

  <div class="illegal__stage">
    <nav class="illegal__tree" aria-label="ファイルツリー">
      <ul class="illegal__tree-list">
        {generationKeys.map((generation) => (
          <li class="illegal__tree-gen" data-gen={generation}>
            <p class="illegal__folder">{generations[generation].snapshot}</p>
            <p class="illegal__tree-tag"><span class="illegal__gen" data-gen={generation}>{generations[generation].tag}</span></p>
            <ul class="illegal__tree-dir">
              <li>
                <p class="illegal__folder">{directory}/</p>
                <ul class="illegal__tree-files">
                  {files.filter((file) => file.generation === generation).map((file) => (
                    <li>
                      <button type="button" data-file={file.key} data-step-scene>{file.name}</button>
                      <span class="illegal__tree-note" data-tree-note={file.key} hidden></span>
                    </li>
                  ))}
                </ul>
              </li>
            </ul>
          </li>
        ))}
      </ul>
    </nav>

    <div class="illegal__right">
      <section class="illegal__file">
        {files.map((file) => (
          <div class="illegal__panel" data-panel={file.key}>
            <p class="illegal__pane-head">
              <code class="illegal__path">{file.path}</code>
              <span class="illegal__gen" data-gen={file.generation}>{file.tag}</span>
              <span class="illegal__part" data-part hidden></span>
              <button type="button" class="illegal__restore" data-restore data-step-scene hidden>このコマのファイルに戻す</button>
            </p>
            <div class="illegal__codebox">
              <div class="illegal__code" data-scroll data-step-scene tabindex="0" role="region" aria-label={file.path}>
                <Code code={file.source} lang="ts" />
              </div>
            </div>
          </div>
        ))}
      </section>

      <section class="illegal__scratch">
        <p class="illegal__pane-head">
          <span class="illegal__scratch-title"><strong>説明用のコード</strong><span class="illegal__scratch-off">: このコマにはありません</span></span>
          <span class="illegal__scratch-sub">ファイルにはない、短い例です</span>
        </p>
        <div class="illegal__scratch-body">
          {scratchViews.map((view) => (
            <div class="illegal__view" data-scratch={view.id}>
              {view.body === "value" && (
                <p class="illegal__view-note">
                  <span class="st-tag">{generations[view.generation].tag}</span>
                  <span><code>declare const</code> は、値があるものとして型検査だけに伝える書き方です。</span>
                </p>
              )}

              {view.body === "value" && (
                <div class="illegal__split">
                  <figure class="code-block st-code">
                    <Code code={view.generation === "before" ? beforeValue : afterValue} lang="ts" />
                  </figure>
                  <div class="illegal__result" data-tone="negative">
                    <p class="illegal__result-title">
                      {view.generation === "before" ? "! 型検査: エラーなし" : "× 型検査: エラー"}
                    </p>
                    <p>診察中の値に、次の項目がありません。</p>
                    <p class="illegal__blanks">
                      <span class="st-blank">veterinarianId</span>
                      <span class="st-blank">examinationStartedAt</span>
                    </p>
                  </div>
                </div>
              )}

              {view.body === "board" && (
                <div class="illegal__table" role="table">
                  <div class="illegal__row illegal__row--head" role="row">
                    <span role="columnheader">業務上</span>
                    <span role="columnheader">
                      値（共通の項目は省略）
                      <span class="st-tag">{generations[view.generation].tag}</span>
                    </span>
                    <span role="columnheader">型検査</span>
                  </div>
                  {candidates.map((candidate) => (
                    <div class="illegal__row" role="row" data-ok={candidate.ok ? "true" : "false"}>
                      <span class="illegal__cell-verdict" role="cell">
                        <span class="st-mark" data-tone={candidate.ok ? "positive" : "negative"} aria-hidden="true">
                          {candidate.ok ? "✓" : "×"}
                        </span>
                        <span class="illegal__sr">{candidate.ok ? "業務上ありえる" : "業務上ありえない"}</span>
                        <span>{candidate.reason}</span>
                      </span>
                      <span class="illegal__cell-value" role="cell">
                        <figure class="code-block st-code illegal__cell-code">
                          <Code code={oneLine(view.generation === "before" ? candidate.before : candidate.after)} lang="ts" />
                        </figure>
                      </span>
                      <span class="illegal__cell-check st-mark" role="cell" data-tone={candidate.ok ? "positive" : "negative"}>
                        {view.generation === "before"
                          ? candidate.ok ? "型検査: 受け入れる" : "! 型検査: 受け入れる"
                          : candidate.ok ? "✓ 型検査: 受け入れる" : "× 型検査: エラー"}
                      </span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <div aria-live="polite">
    <ol class="st-stack">
      {frames.map((frame) => (
        <li
          data-frame
          data-view={JSON.stringify({
            file: frame.file,
            part: frame.part,
            focus: frame.focus,
            scratch: frame.scratch,
            lit: frame.lit,
            show: frame.show,
            treeNote: frame.treeNote,
          })}
        >
          <p class="st-caption">{frame.caption}</p>
        </li>
      ))}
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  type Lit = { line: number; note?: string };
  type View = {
    file: string;
    part: string;
    focus: "file" | "scratch" | "board";
    scratch?: string;
    lit: Lit[];
    show: number[];
    treeNote?: { file: string; text: string };
  };

  document.querySelectorAll<HTMLElement>("[data-illegal]").forEach((root) => {
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const fileButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-file]")];
    const scratchViews = [...root.querySelectorAll<HTMLElement>("[data-scratch]")];
    const frameViews = [...root.querySelectorAll<HTMLElement>("[data-frame]")].map(
      (frame) => JSON.parse(frame.dataset.view ?? "{}") as View,
    );

    let frameView = frameViews[0];
    let chosen: string | null = null;
    let shown: string | null = null;

    const panelOf = (key: string) => panels.find((panel) => panel.dataset.panel === key);

    const render = () => {
      if (!frameView) return;
      const key = chosen ?? frameView.file;
      const following = key === frameView.file;
      const changed = shown !== null && shown !== key;
      shown = key;

      panels.forEach((panel) => {
        const active = panel.dataset.panel === key;
        panel.hidden = !active;
        const show = active && following ? new Set(frameView?.show) : undefined;
        panel.querySelectorAll(".illegal__gap").forEach((gap) => gap.remove());
        const panelLines = panel.querySelectorAll<HTMLElement>(".line");
        const firstShown = show === undefined ? 0 : Math.min(...show);
        panelLines.forEach((line, index) => {
          line.classList.remove("is-lit");
          delete line.dataset.note;
          line.hidden = show !== undefined && !show.has(index);
          line.style.setProperty("counter-set", `illegal-line ${index + 1}`);
          if (show !== undefined && show.has(index) && index > firstShown && !show.has(index - 1)) {
            const gap = document.createElement("span");
            gap.className = "illegal__gap";
            gap.textContent = "  // …";
            line.before(gap);
          }
        });
        const part = panel.querySelector<HTMLElement>("[data-part]");
        const restore = panel.querySelector<HTMLElement>("[data-restore]");
        if (part) {
          part.textContent = active && following ? frameView.part : "";
          part.hidden = !(active && following);
        }
        if (restore) restore.hidden = !(active && !following);
      });
      fileButtons.forEach((button) => {
        if (button.dataset.file === key) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });

      const panel = panelOf(key);
      if (!panel) return;
      if (changed) {
        panel.classList.remove("is-entering");
        void panel.offsetWidth;
        panel.classList.add("is-entering");
      }
      if (!following) {
        panel.querySelector<HTMLElement>("[data-scroll]")?.scrollTo({ top: 0, behavior: "auto" });
        return;
      }
      const lines = panel.querySelectorAll<HTMLElement>(".line");
      frameView.lit.forEach(({ line, note }) => {
        const element = lines[line];
        if (!element) return;
        element.classList.add("is-lit");
        if (note) element.dataset.note = note;
      });
    };

    fileButtons.forEach((button) => {
      button.addEventListener("click", () => {
        chosen = button.dataset.file === frameView?.file ? null : (button.dataset.file ?? null);
        render();
      });
    });

    root.querySelectorAll<HTMLElement>("[data-restore]").forEach((button) => {
      button.addEventListener("click", () => {
        chosen = null;
        render();
      });
    });

    panels.forEach((panel) => panel.querySelector("pre")?.removeAttribute("tabindex"));

    mountStepper({
      root,
      onStep: (index) => {
        frameView = frameViews[index];
        chosen = null;
        if (!frameView) return;
        root.dataset.focus = frameView.focus;
        root.querySelectorAll<HTMLElement>("[data-tree-note]").forEach((note) => {
          const visible = frameView?.treeNote?.file === note.dataset.treeNote;
          note.textContent = visible ? (frameView?.treeNote?.text ?? "") : "";
          note.hidden = !visible;
        });
        scratchViews.forEach((view) => {
          view.hidden = view.dataset.scratch !== frameView?.scratch;
        });
        render();
      },
    });
  });
</script>

<style>
  .illegal :global(.st-caption) {
    line-height: 1.5;
  }

  .illegal__stage {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 0.5rem;
    margin-block-end: 0.5rem;
  }

  .illegal[data-ready] .illegal__stage {
    height: calc(var(--frame-figure-height) - 1.75rem);
  }

  .illegal__tree {
    min-width: 0;
    min-height: 0;
    padding: 0.5rem;
    overflow: auto;
    border: 1px solid var(--role-border);
    border-radius: 0.375rem;
    background: var(--role-surface);
    color: var(--role-text);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .illegal__tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .illegal__tree p {
    margin: 0;
  }

  .illegal__tree-gen {
    padding-inline-start: 0.5rem;
    border-inline-start: 3px solid var(--role-border);
  }

  .illegal__tree-gen[data-gen="before"] {
    border-inline-start-color: var(--role-negative);
  }

  .illegal__tree-gen[data-gen="after"] {
    border-inline-start-color: var(--role-positive);
  }

  .illegal__tree-gen + .illegal__tree-gen {
    margin-block-start: 0.75rem;
  }

  .illegal__tree-tag {
    margin-block: 0.125rem 0.25rem;
  }

  .illegal__tree-dir {
    margin-inline-start: 0.25rem;
  }

  .illegal__tree-files {
    margin-inline-start: 0.75rem;
  }

  .illegal__folder {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .illegal__folder::before {
    content: "▾ ";
    color: var(--role-muted);
  }

  .illegal__tree-files > li {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .illegal__tree-note {
    flex: none;
    padding: 0 0.375rem;
    border-radius: 0.25rem;
    background: var(--role-accent-soft);
    color: var(--role-accent);
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1.5;
    white-space: nowrap;
    animation: illegal-fade 0.25s ease-out;
  }

  .illegal__tree-note[hidden] {
    display: none;
  }

  .illegal__tree button {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    width: auto;
    padding: 0.125rem 0.375rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--role-text);
    cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: inherit;
    text-align: start;
    white-space: nowrap;
  }

  .illegal__tree button:hover {
    background: var(--role-accent-soft);
  }

  .illegal__tree button[aria-current="true"] {
    background: var(--role-accent-soft);
    box-shadow: inset 3px 0 0 var(--role-accent);
    color: var(--role-accent);
    font-weight: 800;
  }

  .illegal__tree button:focus-visible,
  .illegal__restore:focus-visible {
    outline: 3px solid var(--role-accent);
    outline-offset: 2px;
  }

  .illegal:not([data-ready]) .illegal__tree button {
    cursor: default;
    pointer-events: none;
  }

  .illegal__gen {
    display: inline-block;
    padding: 0 0.5rem;
    border: 2px solid var(--role-border);
    border-radius: 0.375rem;
    background: var(--role-surface);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.5;
    white-space: nowrap;
  }

  .illegal__gen[data-gen="before"] {
    border-color: var(--role-negative);
    color: var(--role-negative);
  }

  .illegal__gen[data-gen="after"] {
    border-color: var(--role-positive);
    color: var(--role-positive);
  }

  .illegal__right {
    display: grid;
    grid-template-rows: auto auto;
    gap: 0.5rem;
    min-width: 0;
    min-height: 0;
  }

  .illegal[data-ready] .illegal__right {
    grid-template-rows: 4fr 6fr;
    transition: grid-template-rows 0.35s ease;
  }

  .illegal[data-ready][data-focus="file"] .illegal__right {
    grid-template-rows: 1fr 0fr;
  }

  .illegal[data-ready][data-focus="scratch"] .illegal__right {
    grid-template-rows: 45fr 55fr;
  }

