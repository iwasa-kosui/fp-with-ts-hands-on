---
import StepControls from "../stepper/StepControls.astro";
import "./states.css";

const cardWidth = 132;
const cardHeight = 64;
const pitch = 208;
const left = 4;
const rowTop = 28;
const arrowY = rowTop + 50;

const states = [
  { kind: "Scheduled", label: "予約済み" },
  { kind: "CheckedIn", label: "来院済み" },
  { kind: "InExamination", label: "診察中" },
  { kind: "AwaitingPayment", label: "会計待ち" },
  { kind: "Paid", label: "会計済み" },
] as const;

const events = [
  ["受付", "する"],
  ["診察を", "開始する"],
  ["診察結果を", "記録する"],
  ["会計を", "記録する"],
] as const;

const x = (index: number) => left + index * pitch;
const cancel = { x: x(0) + 104, y: 150, width: 152 };
const cancelCenter = cancel.x + cancel.width / 2;

const forward = events.map(([first, second], index) => {
  const from = x(index) + cardWidth + 3;
  const to = x(index + 1) - 3;
  return {
    edge: `e${index}`,
    line: `M ${from} ${arrowY} H ${to - 7}`,
    head: `M ${to - 9} ${arrowY - 5} L ${to} ${arrowY} L ${to - 9} ${arrowY + 5} z`,
    centerX: (from + to) / 2,
    first,
    second,
  };
});

const cancelPaths = [0, 1].map((index) => {
  const startX = x(index) + cardWidth / 2;
  const endX = index === 0 ? cancelCenter - 38 : cancelCenter + 38;
  return {
    line: `M ${startX} ${rowTop + cardHeight + 3} V 124 H ${endX} V ${cancel.y - 10}`,
    head: `M ${endX - 5} ${cancel.y - 11} L ${endX} ${cancel.y - 2} L ${endX + 5} ${cancel.y - 11} z`,
  };
});

const frames = [
  {
    edge: "e0",
    states: ["Scheduled", "CheckedIn"],
    caption: "受付すると、「予約済み」の予約が「来院済み」になります。",
  },
  {
    edge: "e1",
    states: ["CheckedIn", "InExamination"],
    caption: "診察を開始すると、「来院済み」の予約が「診察中」になります。",
  },
  {
    edge: "e2",
    states: ["InExamination", "AwaitingPayment"],
    caption: "診察結果を記録すると、「診察中」の予約が「会計待ち」になります。",
  },
  {
    edge: "e3",
    states: ["AwaitingPayment", "Paid"],
    caption: "会計を記録すると、「会計待ち」の予約が「会計済み」になります。「会計済み」から先へは進みません。",
  },
  {
    edge: "cancel",
    states: ["Scheduled", "CheckedIn", "Canceled"],
    caption: "キャンセルできるのは「予約済み」と「来院済み」の予約だけです。キャンセルすると「キャンセル」になり、そこから先へは進みません。",
  },
] as const;

const framesData = JSON.stringify(frames.map(({ edge, states: active }) => ({ edge, states: active })));
---

<figure class="st-fig road" data-state-road data-frames={framesData} aria-label="予約が進む6つの状態と、状態を変える業務イベント">
  <StepControls />

  <svg class="road__svg" viewBox="0 0 972 226" role="img" aria-label="予約済み、来院済み、診察中、会計待ち、会計済みの順に進む。予約済みと来院済みからはキャンセルへ進める。">
    {forward.map((edge) => (
      <g class="road__edge" data-edge={edge.edge}>
        <path d={edge.line} class="road__line"></path>
        <path d={edge.head} class="road__head"></path>
        <text x={edge.centerX} y={arrowY - 24} text-anchor="middle" class="road__event">{edge.first}</text>
        <text x={edge.centerX} y={arrowY - 10} text-anchor="middle" class="road__event">{edge.second}</text>
      </g>
    ))}

    <g class="road__edge" data-edge="cancel">
      {cancelPaths.map((path) => (
        <>
          <path d={path.line} class="road__line"></path>
          <path d={path.head} class="road__head"></path>
        </>
      ))}
      <text x={cancelCenter} y="116" text-anchor="middle" class="road__event">キャンセルする</text>
    </g>

    {states.map((state, index) => (
      <g class="road__state" data-state={state.kind} transform={`translate(${x(index)} ${rowTop})`}>
        <rect width={cardWidth} height={cardHeight} rx="8"></rect>
        <text x={cardWidth / 2} y="29" text-anchor="middle" class="road__label">{state.label}</text>
        <text x={cardWidth / 2} y="49" text-anchor="middle" class="road__kind">{state.kind}</text>
      </g>
    ))}
    <text x={x(4) + cardWidth / 2} y={rowTop + cardHeight + 18} text-anchor="middle" class="road__end">遷移の終点</text>

    <g class="road__state" data-state="Canceled" transform={`translate(${cancel.x} ${cancel.y})`}>
      <rect width={cancel.width} height={cardHeight} rx="8"></rect>
      <text x={cancel.width / 2} y="29" text-anchor="middle" class="road__label">キャンセル</text>
      <text x={cancel.width / 2} y="49" text-anchor="middle" class="road__kind">Canceled</text>
    </g>
    <text x={cancelCenter + cancel.width / 2 + 12} y={cancel.y + 36} class="road__end">遷移の終点</text>
  </svg>

  <div aria-live="polite">
    <ol class="st-stack">
      {frames.map((frame) => (
        <li data-frame><p class="st-caption">{frame.caption}</p></li>
      ))}
    </ol>
  </div>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  type Frame = { edge: string; states: string[] };

  document.querySelectorAll<HTMLElement>("[data-state-road]").forEach((root) => {
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    mountStepper({
      root,
      onStep: (index) => {
        const frame = frames[index];
        if (frame === undefined) return;
        root.querySelectorAll<SVGGElement>("[data-edge]").forEach((edge) => {
          edge.classList.toggle("is-on", edge.dataset.edge === frame.edge);
        });
        root.querySelectorAll<SVGGElement>("[data-state]").forEach((state) => {
          state.classList.toggle("is-active", frame.states.includes(state.dataset.state ?? ""));
        });
      },
    });
  });
</script>

<style>
  .road__svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 17rem;
  }

  .road__state rect {
    fill: var(--role-surface);
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .road__label {
    fill: var(--role-text);
    font-size: 16px;
    font-weight: 800;
  }

  .road__kind {
    fill: var(--role-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
  }

  .road__end {
    fill: var(--role-muted);
    font-size: 12px;
  }

  .road__line {
    fill: none;
    stroke: var(--role-border);
    stroke-width: 2;
  }

  .road__head {
    fill: var(--role-border);
  }

  .road__event {
    fill: var(--role-muted);
    font-size: 12px;
  }

  .road[data-ready] .road__state rect,
  .road[data-ready] .road__line,
  .road[data-ready] .road__head {
    transition: opacity 0.3s;
  }

  .road[data-ready] .road__state:not(.is-active) rect,
  .road[data-ready] .road__edge:not(.is-on) .road__line,
  .road[data-ready] .road__edge:not(.is-on) .road__head {
    opacity: 0.45;
  }

  .road[data-ready] .road__state.is-active rect {
    fill: color-mix(in srgb, var(--role-accent) 12%, var(--role-surface));
    stroke: var(--role-accent);
    stroke-width: 4;
  }

  .road[data-ready] .road__edge.is-on .road__line {
    stroke: var(--role-accent);
    stroke-width: 4;
  }

  .road[data-ready] .road__edge.is-on .road__head {
    fill: var(--role-accent);
  }

  .road[data-ready] .road__edge.is-on .road__event {
    fill: var(--role-accent);
    font-weight: 800;
  }
</style>
