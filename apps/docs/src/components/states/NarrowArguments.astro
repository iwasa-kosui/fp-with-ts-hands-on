---
import { Code } from "astro:components";
import StepControls from "../stepper/StepControls.astro";
import { lineIndexOf, quotes } from "./quotes";
import "./states.css";

const versions = {
  before: {
    tag: "修正前: S01 の開始コード",
    label: "関数",
    name: "startExamination",
    path: quotes.startStartExamination.path,
    code: quotes.startStartExamination.code,
    changed: [
      lineIndexOf(quotes.startStartExamination.code, "  appointment: Appointment,"),
      lineIndexOf(quotes.startStartExamination.code, "): Appointment =>"),
      lineIndexOf(quotes.startStartExamination.code, ") as Appointment;"),
    ],
    tone: "negative",
  },
  after: {
    tag: "修正後: S01 の完成コード",
    label: "関数",
    name: "startExamination",
    path: quotes.solutionStartExamination.path,
    code: quotes.solutionStartExamination.code,
    changed: [
      lineIndexOf(quotes.solutionStartExamination.code, "  appointment: CheckedIn,"),
      lineIndexOf(quotes.solutionStartExamination.code, "): InExamination =>"),
      lineIndexOf(quotes.solutionStartExamination.code, "}) as const satisfies InExamination;"),
    ],
    tone: "positive",
  },
  caller: {
    tag: "呼び出し側: S01 の完成コード",
    label: "診察開始のルート",
    name: null,
    path: quotes.solutionStartRoute.path,
    code: quotes.solutionStartRoute.code,
    changed: [
      lineIndexOf(quotes.solutionStartRoute.code, 'if (current.kind !== "CheckedIn")'),
      lineIndexOf(quotes.solutionStartRoute.code, "startExamination("),
      lineIndexOf(quotes.solutionStartRoute.code, "current,"),
    ],
    tone: "positive",
  },
} as const;

const inputs = {
  checked: { label: "来院済み", kind: "CheckedIn", allowed: true },
  paid: { label: "会計済み", kind: "Paid", allowed: false },
} as const;

type Output =
  | Readonly<{ type: "done" }>
  | Readonly<{ type: "exception" }>
  | Readonly<{ type: "typeError" }>
  | Readonly<{ type: "rejected" }>;

const frames: readonly Readonly<{
  event: Readonly<{ label: string; text: string }>;
  version: keyof typeof versions;
  input: keyof typeof inputs;
  output: Output;
  caption: string;
  explain?: string;
}>[] = [
  {
    event: { label: "業務イベント", text: "獣医師が「診察を開始する」を押す" },
    version: "before",
    input: "checked",
    output: { type: "done" },
    caption:
      "修正前のコードは、引数の型が Appointment、返す型が Appointment です。末尾の as Appointment は、値の中身を検証せずに型を伝える書き方（型アサーション）です。来院済みの予約を渡すと、診察中の予約が返ります。",
  },
  {
    event: { label: "コードの誤り", text: "開発者が、会計済みの予約を startExamination へ渡すコードを書く" },
    version: "before",
    input: "paid",
    output: { type: "exception" },
    caption:
      "会計済みの予約を渡しても、型検査は報告しません。実行すると requireKind が例外を投げます。誤りを検出できるのは、この呼び出しを実行した時点だけです。",
  },
  {
    event: { label: "業務イベント", text: "獣医師が「診察を開始する」を押す" },
    version: "after",
    input: "checked",
    output: { type: "done" },
    caption:
      "修正後のコードは、引数の型が CheckedIn、返す型が InExamination で、末尾が as const satisfies InExamination です。引数を CheckedIn に絞ったため、関数の中の requireKind は不要になりました。来院済みの予約を渡すと、診察中の予約が返ります。",
    explain:
      "<code>as const satisfies InExamination</code> は、2 つの指定です。<code>as const</code> は、<code>\"InExamination\"</code> を string に広げず、その文字列のまま残します。<code>satisfies InExamination</code> は、戻す値が <code>InExamination</code> を満たすかを、値の定義の位置で型検査が検証します。型を上書きする <code>as</code> とは異なり、満たさなければ型検査が報告します。戻り値の型の指定だけでも、同じ誤りは報告されます。",
  },
  {
    event: { label: "コードの誤り", text: "開発者が、会計済みの予約を startExamination へ渡すコードを書く" },
    version: "after",
    input: "paid",
    output: { type: "typeError" },
    caption:
      "会計済みの予約を渡すコードは、実行前の型検査が報告します。このコードの誤りは、型検査の時点で判明します。",
  },
  {
    event: { label: "業務イベント", text: "サーバーが、会計済みの予約に対する診察開始の依頼を受け取る" },
    version: "caller",
    input: "paid",
    output: { type: "rejected" },
    caption:
      "データベースから取得する予約は、どの状態の値が返るかが、実行するまで分かりません。型は Appointment であるため、routes.ts（HTTP リクエストを受ける関数）が kind を検証し、CheckedIn でなければ依頼を拒否します。この検証は修正前からあり、この Session の修正では変わりません。検証の後は current が CheckedIn に絞り込まれ、startExamination に渡せます。演習では、同じ検証を関数に切り出した startExaminationFor（cases/G2-callers-check-state.ts）を扱います。",
  },
];
---

<figure class="st-fig na" data-narrow-arguments aria-label="startExamination の入力と出力を、修正前と修正後で比較する図">
  <StepControls />

  <ol class="st-stack">
    {frames.map((frame) => {
      const version = versions[frame.version];
      const input = inputs[frame.input];
      return (
        <li
          data-frame
          data-lit={JSON.stringify(version.changed)}
          data-tone={version.tone}
        >
          <div class="na__head">
            <span class="st-tag">{version.tag}</span>
            <p class="na__event">
              <strong>{frame.event.label}</strong>
              {frame.event.text}
            </p>
          </div>

          <div class="na__flow">
            <div class="na__io" data-allowed={input.allowed ? "true" : "false"}>
              <p class="na__label">遷移前（入力）</p>
              <p class="na__state"><strong>{input.label}</strong><code>{input.kind}</code></p>
              {!input.allowed && <p class="na__note">× 許されない入力</p>}
            </div>

            <span class="na__arrow" aria-hidden="true">→</span>

            <figure class="code-block st-code na__code">
              <figcaption>{version.label}{version.name && <> <code>{version.name}</code></>} <code>{version.path}</code></figcaption>
              <Code code={version.code} lang="ts" />
            </figure>

            <span class="na__arrow" aria-hidden="true">→</span>

            <div class="na__io" data-output={frame.output.type}>
              <p class="na__label">{frame.output.type === "done" ? "遷移後（出力）" : "結果"}</p>
              {frame.output.type === "done" && (
                <>
                  <p class="na__state"><strong>診察中</strong><code>InExamination</code></p>
                  <p class="na__note st-mark" data-tone="positive">✓ 許される遷移</p>
                </>
              )}
              {frame.output.type === "exception" && (
                <>
                  <p class="na__state"><strong>実行時の例外</strong><code>Cannot transition from Paid</code></p>
                  <p class="na__note">型検査は報告しない</p>
                </>
              )}
              {frame.output.type === "rejected" && (
                <>
                  <p class="na__state"><strong>実行時の例外</strong><code>Invalid appointment state</code></p>
                  <p class="na__note">依頼を拒否する</p>
                </>
              )}
              {frame.output.type === "typeError" && (
                <>
                  <p class="na__state"><strong>型検査の報告</strong><code>Argument of type 'Paid' is not assignable to parameter of type 'CheckedIn'.</code></p>
                  <p class="na__note">実行前の型検査が報告する</p>
                </>
              )}
            </div>
          </div>

          <p class="st-caption">{frame.caption}</p>

          <p class="na__explain" data-active={frame.explain === undefined ? "false" : "true"} aria-hidden={frame.explain === undefined ? "true" : undefined} set:html={frame.explain ?? ""} />
        </li>
      );
    })}
  </ol>
</figure>

<script>
  import { mountStepper } from "../stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-narrow-arguments]").forEach((root) => {
    root.querySelectorAll<HTMLElement>("[data-frame]").forEach((frame) => {
      const lit = JSON.parse(frame.dataset.lit ?? "[]") as number[];
      const tone = frame.dataset.tone === "positive" ? "is-lit-positive" : "is-lit-negative";
      frame.querySelectorAll<HTMLElement>(".line").forEach((line, index) => {
        line.classList.toggle(tone, lit.includes(index));
      });
    });
    mountStepper({ root });
  });
</script>

<style>
  .na__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
    align-items: center;
    margin-block-end: 0.125rem;
  }

  .na__event {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .na__event strong {
    margin-inline-end: 0.5rem;
    padding: 0 0.5rem;
    border: 2px solid var(--role-border);
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }

  .na :global(.st-caption) {
    line-height: 1.5;
  }

  .na__explain {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .na__explain[data-active="false"] {
    visibility: hidden;
  }

  .na__flow {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) auto minmax(0, 2.6fr) auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
    margin-block-end: 0.125rem;
  }

  .na__flow .na__code :global(pre) {
    padding-block: 0.125rem;
  }

  .na__arrow {
    align-self: center;
    color: var(--role-muted);
    font-weight: 800;
  }

  .na__io {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.5rem 0.625rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .na__io[data-allowed="false"],
  .na__io[data-output="exception"],
  .na__io[data-output="rejected"],
  .na__io[data-output="typeError"] {
    border: 2px dashed var(--role-negative);
  }

  .na__io[data-output="done"] {
    border-color: var(--role-positive);
  }

  .na__io p {
    margin: 0;
  }

  .na__label {
    color: var(--role-muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .na__state {
    display: grid;
    gap: 0.125rem;
  }

  .na__state code {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .na__note {
    font-size: 0.75rem;
    font-weight: 800;
  }

  .na__io[data-allowed="false"] .na__note {
    color: var(--role-negative);
  }

  @media (max-width: 55rem) {
    .na__flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .na__arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
