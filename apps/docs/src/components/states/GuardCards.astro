---
const groups = [
  {
    id: "machine",
    title: "機械が検出するもの",
    lead: "仕組みを足すと、変更のたびに自動で報告されます。",
    cards: [
      {
        what: "受け取れない状態の予約を、遷移関数へ渡す呼び出し",
        by: "型検査と、型のテスト",
      },
      {
        what: "as Appointment のように、型を書き換える書き方",
        by: "Linter の規則",
      },
      {
        what: "結果の項目に、渡した値ではなく前の状態の値が入る変更",
        by: "テスト",
      },
    ],
  },
  {
    id: "human",
    title: "人が確かめるもの（この回では解決しません）",
    lead: "仕組みでは検出できないので、人が読んで確かめます。",
    cards: [
      {
        what: "最初のページの矢印の一覧そのものが、業務と合っているか",
        by: "型は、書いた一覧のとおりに守るだけです。",
      },
      {
        what: "別の関数の分岐漏れ",
        by: "状態ごとに表示や処理を分ける関数に、足した状態の分岐がないことです。S02 で扱います。",
      },
      {
        what: "自分の仕組みをすり抜ける、新しい種類の変更",
        by: "相互レビューで見つけたすり抜けが、その例です。",
      },
    ],
  },
] as const;
---

<div class="guard-cards">
  {groups.map((group) => (
    <section class="guard-cards__group" data-group={group.id}>
      <p class="guard-cards__title">{group.title}</p>
      <p class="guard-cards__lead">{group.lead}</p>
      <ul>
        {group.cards.map((card) => (
          <li>
            <p class="guard-cards__what">{card.what}</p>
            <p class="guard-cards__by">{card.by}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .guard-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.5rem 0;
  }

  .guard-cards__group {
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--role-border);
    border-radius: 0.5rem;
    background: var(--role-surface);
    color: var(--role-text);
  }

  .guard-cards__group[data-group="machine"] {
    border-color: var(--role-positive);
  }

  .guard-cards__group[data-group="human"] {
    border-color: var(--role-negative);
    border-style: dashed;
  }

  .guard-cards__title {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .guard-cards__lead {
    margin: 0 0 0.5rem;
    color: var(--role-muted);
    font-size: 0.8125rem;
  }

  ul {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.25rem 0.5rem;
    border-inline-start: 0.375rem solid var(--role-border);
  }

  [data-group="machine"] li {
    border-inline-start-color: var(--role-positive);
  }

  [data-group="human"] li {
    border-inline-start-color: var(--role-negative);
  }

  p {
    margin: 0;
  }

  .guard-cards__what {
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .guard-cards__by {
    color: var(--role-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-width: 55rem) {
    .guard-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
