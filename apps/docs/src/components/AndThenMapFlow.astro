---
import { Code } from "astro:components";

type Value =
  | { tag: "plain"; text: string }
  | { tag: "ok" | "err"; inner: Value };

type Row = {
  title: string;
  code: string;
  tone: "success" | "failure" | "warning";
  input: Value;
  call: string;
  returned: Value;
  returnedNote: string;
  result: Value;
  resultNote: string;
};

const plain = (text: string): Value => ({ tag: "plain", text });
const okOf = (inner: Value): Value => ({ tag: "ok", inner });
const errOf = (inner: Value): Value => ({ tag: "err", inner });
const notPositive = errOf(plain('"NotPositive"'));

const renderValue = (value: Value): string =>
  value.tag === "plain"
    ? `<span class="and-then-map__plain${/^-?\d/.test(value.text) ? " and-then-map__plain--number" : value.text.startsWith('"') ? " and-then-map__plain--string" : ""}">${value.text}</span>`
    : `<span class="and-then-map__box and-then-map__box--${value.tag}"><span class="and-then-map__tag">${value.tag === "ok" ? "Ok(" : "Err("}</span>${renderValue(value.inner)}<span class="and-then-map__tag">)</span></span>`;

const rows: Row[] = [
  {
    title: "map: 素の値を返す関数に使う",
    code: "ok(3).map(double)",
    tone: "success",
    input: okOf(plain("3")),
    call: "double(3)",
    returned: plain("6"),
    returnedNote: "素の値",
    result: okOf(plain("6")),
    resultNote: "map が戻り値を Ok で包む",
  },
  {
    title: "andThen: Result を返す関数に使う",
    code: "ok(3).andThen(ensurePositive)",
    tone: "success",
    input: okOf(plain("3")),
    call: "ensurePositive(3)",
    returned: okOf(plain("3")),
    returnedNote: "Result",
    result: okOf(plain("3")),
    resultNote: "andThen は戻り値をそのまま返す",
  },
  {
    title: "間違いやすい例: Result を返す関数を map に渡す",
    code: "ok(3).map(ensurePositive)",
    tone: "warning",
    input: okOf(plain("3")),
    call: "ensurePositive(3)",
    returned: okOf(plain("3")),
    returnedNote: "Result",
    result: okOf(okOf(plain("3"))),
    resultNote: "map が Result をさらに Ok で包むので、Result が二重になる",
  },
  {
    title: "andThen: 関数が Err を返したとき",
    code: "ok(-1).andThen(ensurePositive)",
    tone: "failure",
    input: okOf(plain("-1")),
    call: "ensurePositive(-1)",
    returned: notPositive,
    returnedNote: "Result",
    result: notPositive,
    resultNote: "andThen は戻り値の Err をそのまま返す",
  },
  {
    title: "入力が Err のとき: map も andThen も関数を呼ばない",
    code: 'err("NotPositive").map(double)',
    tone: "failure",
    input: notPositive,
    call: "double",
    returned: plain("呼ばれない"),
    returnedNote: "入力が Err のため",
    result: notPositive,
    resultNote: "入力の Err をそのまま返す。andThen でも同じ",
  },
];

type SegKey = "input" | "method" | "fn" | "body" | "result";
type Seg = { text: string; hl?: SegKey };
type Step = { state: "input" | "extract" | "call" | "return" | "wrap" | "result"; focus: SegKey; text: string };
type Scene = {
  tab: string;
  lines: Seg[][];
  arg: string;
  fn: string;
  returned: Value;
  wrap: "none" | "ok" | "nest";
  action: string;
  steps: Step[];
};

const ensurePositiveLines: Seg[][] = [
  [{ text: "const " }, { text: "ensurePositive", hl: "fn" }, { text: " = (value: number):" }],
  [{ text: '  Result<number, "NotPositive"> =>' }],
  [{ text: "  " }, { text: "value > 0", hl: "body" }],
  [{ text: "    ? " }, { text: "ok(value)", hl: "body" }],
  [{ text: '    : err("NotPositive");' }],
  [],
];

const scenes: Scene[] = [
  {
    tab: "map(double)",
    lines: [
      [{ text: "const " }, { text: "double", hl: "fn" }, { text: " = (value: number): number =>" }],
      [{ text: "  " }, { text: "value * 2", hl: "body" }, { text: ";" }],
      [],
      [{ text: "ok(3)", hl: "input" }, { text: ".map", hl: "method" }, { text: "(" }, { text: "double", hl: "fn" }, { text: ");" }],
      [{ text: "// Ok(6)", hl: "result" }],
    ],
    arg: "3",
    fn: "double",
    returned: plain("6"),
    wrap: "ok",
    action: "map が Ok で包む",
    steps: [
      { state: "input", focus: "input", text: "入力は、3 が入った Ok です。" },
      { state: "extract", focus: "method", text: "map は Ok の中の 3 を取り出します。" },
      { state: "call", focus: "fn", text: "取り出した 3 で double(3) を呼びます。" },
      { state: "return", focus: "body", text: "double は素の値 6 を返します。" },
      { state: "wrap", focus: "method", text: "map は戻り値の 6 を Ok で包みます。" },
      { state: "result", focus: "result", text: "結果は Ok(6) です。" },
    ],
  },
  {
    tab: "andThen(ensurePositive)",
    lines: [
      ...ensurePositiveLines,
      [{ text: "ok(3)", hl: "input" }, { text: ".andThen", hl: "method" }, { text: "(" }, { text: "ensurePositive", hl: "fn" }, { text: ");" }],
      [{ text: "// Ok(3)", hl: "result" }],
    ],
    arg: "3",
    fn: "ensurePositive",
    returned: okOf(plain("3")),
    wrap: "none",
    action: "andThen は包まない",
    steps: [
      { state: "input", focus: "input", text: "入力は、3 が入った Ok です。" },
      { state: "extract", focus: "method", text: "andThen は Ok の中の 3 を取り出します。" },
      { state: "call", focus: "fn", text: "取り出した 3 で ensurePositive(3) を呼びます。" },
      { state: "return", focus: "body", text: "ensurePositive は Result の Ok(3) を返します。" },
      { state: "wrap", focus: "method", text: "andThen は戻り値を包みません。Result をそのまま結果にします。" },
      { state: "result", focus: "result", text: "結果は Ok(3) です。Ok は一重のままです。" },
    ],
  },
  {
    tab: "map(ensurePositive)",
    lines: [
      ...ensurePositiveLines,
      [{ text: "ok(3)", hl: "input" }, { text: ".map", hl: "method" }, { text: "(" }, { text: "ensurePositive", hl: "fn" }, { text: ");" }],
      [{ text: "// Ok(Ok(3))", hl: "result" }],
    ],
    arg: "3",
    fn: "ensurePositive",
    returned: okOf(plain("3")),
    wrap: "nest",
    action: "map がさらに Ok で包む",
    steps: [
      { state: "input", focus: "input", text: "入力は、3 が入った Ok です。" },
      { state: "extract", focus: "method", text: "map は Ok の中の 3 を取り出します。" },
      { state: "call", focus: "fn", text: "取り出した 3 で ensurePositive(3) を呼びます。" },
      { state: "return", focus: "body", text: "ensurePositive は Result の Ok(3) を返します。" },
      { state: "wrap", focus: "method", text: "map は戻り値が Result でも Ok で包みます。ここで Ok の中に Ok が入ります。" },
      { state: "result", focus: "result", text: "結果は Ok(Ok(3)) です。次の map や andThen には 3 ではなく Ok(3) が渡ります。" },
    ],
  },
];

const toCode = (lines: Seg[][]): string => lines.map((line) => line.map((seg) => seg.text).join("")).join("\n");

type HastNode = { type: string; value?: string; properties?: Record<string, unknown>; children?: HastNode[] };

const splitLine = (lineNode: HastNode, segs: Seg[]): void => {
  let segIndex = 0;
  let segOffset = 0;
  lineNode.children = (lineNode.children ?? []).flatMap((span) => {
    let rest = span.children?.[0]?.value ?? "";
    const parts: HastNode[] = [];
    while (rest.length > 0 && segIndex < segs.length) {
      const seg = segs[segIndex];
      const size = Math.min(rest.length, seg.text.length - segOffset);
      parts.push({
        ...span,
        properties: { ...span.properties, ...(seg.hl ? { "data-hl": seg.hl } : {}) },
        children: [{ type: "text", value: rest.slice(0, size) }],
      });
      rest = rest.slice(size);
      segOffset += size;
      if (segOffset === seg.text.length) {
        segIndex += 1;
        segOffset = 0;
      }
    }
    if (rest.length > 0) {
      parts.push({ ...span, children: [{ type: "text", value: rest }] });
    }
    return parts.length > 0 ? parts : [span];
  });
};

// Code はハイライターを設定の JSON でキャッシュし、transformer の違いを区別しないので、行の情報は meta で渡す
const marks = {
  name: "and-then-map-marks",
  code(this: { options: { meta?: { __raw?: string } } }, node: HastNode) {
    const lines = JSON.parse(this.options.meta?.__raw ?? "[]") as Seg[][];
    (node.children ?? [])
      .filter((child) => child.type === "element")
      .forEach((lineNode, index) => splitLine(lineNode, lines[index] ?? []));
  },
};
---

<figure class="and-then-map" data-and-then-map>
  <div class="and-then-map__player">
    <div class="and-then-map__tabs">
      {scenes.map((scene) => (
        <button type="button" class="and-then-map__tab" data-scene-tab aria-pressed="false"><code>{scene.tab}</code></button>
      ))}
    </div>
    {scenes.map((scene) => (
      <div class="and-then-map__scene" data-scene>
        <div class="and-then-map__source"><Code code={toCode(scene.lines)} lang="ts" meta={JSON.stringify(scene.lines)} transformers={[marks]} /></div>
        <div class="and-then-map__stage-area" data-stage data-state="input">
          <span class="and-then-map__slot" style="--y: 0rem">入力</span>
          <span class="and-then-map__slot" style="--y: 4.5rem">渡す関数</span>
          <span class="and-then-map__slot" style="--y: 9rem">戻り値</span>
          <span class="and-then-map__slot" style="--y: 13.5rem">結果</span>
          <span class="and-then-map__arrow" style="--y: 2.75rem">↓</span>
          <span class="and-then-map__arrow" style="--y: 7.25rem">↓</span>
          <span class="and-then-map__arrow" style="--y: 11.75rem">↓</span>
          <span class="and-then-map__token and-then-map__token--input"><Fragment set:html={renderValue(okOf(plain(scene.arg)))} /></span>
          <span class="and-then-map__token and-then-map__token--fn"><code><span class="and-then-map__fn-name">{scene.fn}</span>(<span class="and-then-map__fn-arg">{scene.arg}</span>)</code></span>
          <span class="and-then-map__token and-then-map__token--arg"><Fragment set:html={renderValue(plain(scene.arg))} /></span>
          <span class="and-then-map__token and-then-map__token--returned"><Fragment set:html={renderValue(scene.returned)} /></span>
          <span class="and-then-map__token and-then-map__token--result">
            <span class:list={["and-then-map__frame", `and-then-map__frame--${scene.wrap}`]}>
              {scene.wrap !== "none" && <span class="and-then-map__frame-tag">Ok(</span>}
              <Fragment set:html={renderValue(scene.returned)} />
              {scene.wrap !== "none" && <span class="and-then-map__frame-tag">)</span>}
            </span>
          </span>
          <span class="and-then-map__action">{scene.action}</span>
        </div>
        <ol class="and-then-map__steps" aria-live="polite">
          {scene.steps.map((step) => (
            <li data-step={step.state} data-focus={step.focus}>{step.text}</li>
          ))}
        </ol>
      </div>
    ))}
    <div class="and-then-map__controls" data-controls>
      <button type="button" data-prev>前へ</button>
      <button type="button" data-play>再生</button>
      <button type="button" data-next>次へ</button>
      <span class="and-then-map__counter" data-counter></span>
    </div>
  </div>
  <div class="and-then-map__static">
  <ol class="and-then-map__rows">
    {
      rows.map((row) => (
        <li class:list={["and-then-map__row", `and-then-map__row--${row.tone}`]}>
          <p class="and-then-map__title">{row.title}</p>
          <div class="and-then-map__source and-then-map__source--static"><Code code={row.code} lang="ts" /></div>
          <div class="and-then-map__flow">
            <div class="and-then-map__stage">
              <span class="and-then-map__label">入力</span>
              <Fragment set:html={renderValue(row.input)} />
            </div>
            <div class="and-then-map__stage">
              <span class="and-then-map__label">渡す関数の戻り値</span>
              <div class="and-then-map__source and-then-map__source--call"><Code code={row.call} lang="ts" /></div>
              <Fragment set:html={renderValue(row.returned)} />
              <small>{row.returnedNote}</small>
            </div>
            <div class="and-then-map__stage">
              <span class="and-then-map__label">結果</span>
              <Fragment set:html={renderValue(row.result)} />
              <small>{row.resultNote}</small>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
  </div>
  <figcaption>
    関数の戻り値と結果の違いを見比べます。map は戻り値を Ok で包み、andThen は戻り値をそのまま返します。
  </figcaption>
</figure>

<style>
  .and-then-map {
    margin: 1.5rem 0;
  }

  .and-then-map__rows {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .and-then-map__row {
    border: 2px solid var(--case-line);
    border-left-width: 6px;
    background: #fffdf7;
    padding: 0.75rem 1rem;
  }

  .and-then-map__row--success {
    border-left-color: #137333;
  }

  .and-then-map__row--failure {
    border-left-color: #b42318;
  }

  .and-then-map__row--warning {
    border-left-color: #9a5b00;
    background: #fff6df;
  }

  .and-then-map__title {
    margin: 0;
    font-weight: 700;
  }

  .and-then-map__flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .and-then-map__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .and-then-map__stage + .and-then-map__stage::before {
    content: "→";
    position: absolute;
    top: 1.5rem;
    left: -1.25rem;
    font-weight: 700;
  }

  .and-then-map__label {
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .and-then-map__stage small {
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .and-then-map :global(.and-then-map__box) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.125rem;
    max-width: 100%;
    border: 2px solid;
    border-radius: 6px;
    background: #24292e;
    color: #e1e4e8;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono, monospace);
  }

  .and-then-map :global(.and-then-map__box--ok) {
    border-color: #137333;
  }

  .and-then-map :global(.and-then-map__box--err) {
    border-color: #b42318;
  }

  .and-then-map :global(.and-then-map__tag) {
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .and-then-map :global(.and-then-map__box--ok > .and-then-map__tag) {
    color: #b392f0;
  }

  .and-then-map :global(.and-then-map__box--err > .and-then-map__tag) {
    color: #b392f0;
  }

  .and-then-map :global(.and-then-map__plain) {
    border-radius: 4px;
    background: #24292e;
    color: #e1e4e8;
    padding: 0 0.25rem;
    font-family: var(--font-mono, monospace);
  }

  .and-then-map :global(.and-then-map__box > .and-then-map__plain) { padding: 0; }
  .and-then-map :global(.and-then-map__plain--number) { color: #79b8ff; }
  .and-then-map :global(.and-then-map__plain--string) { color: #9ecbff; }

  .and-then-map figcaption {
    margin-top: 0.5rem;
  }

  .and-then-map__player { display: none; }
  .and-then-map.is-animated .and-then-map__player { display: block; }
  .and-then-map.is-animated .and-then-map__static { display: none; }
  .and-then-map__scene[hidden], .and-then-map__steps li[hidden] { display: none; }
  .and-then-map__tabs { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 0.5rem; }
  .and-then-map__tab { border: 2px solid var(--case-line); border-radius: 6px; background: #fffdf7; padding: 0.25rem 0.5rem; cursor: pointer; }
  .and-then-map__tab[aria-pressed="true"] { background: var(--case-line); color: #fffdf7; }
  .and-then-map__tab code { background: none; color: inherit; font-size: 0.8125rem; }
  .and-then-map__source { margin: 0; }
  .and-then-map__source :global(pre) { margin: 0; border-radius: 6px; padding: 0.625rem 0.75rem; font-size: 0.8125rem; line-height: 1.5; white-space: pre-wrap; overflow-x: auto; }
  .and-then-map__source--static { margin: 0.25rem 0 0.75rem; }
  .and-then-map__source--call :global(pre) { padding: 0.125rem 0.5rem; }
  .and-then-map :global([data-hl]) { border-radius: 3px; transition: background-color 0.3s ease; }
  .and-then-map :global([data-hl].is-active) { background: #ffe08a; color: #16251f !important; }
  .and-then-map :global([data-hl="result"]:not(.is-active)) { visibility: hidden; }
  .and-then-map__stage-area { position: relative; height: 18rem; margin-top: 0.75rem; }
  .and-then-map__slot, .and-then-map__arrow, .and-then-map__token, .and-then-map__action { position: absolute; top: var(--y, 0rem); }
  .and-then-map__slot { left: 0; padding-top: 0.5rem; font-size: 0.8125rem; font-weight: 700; }
  .and-then-map__arrow { left: calc(50% + 2rem); transform: translateX(-50%); font-weight: 700; color: #6b7a73; }
  .and-then-map__token { left: calc(50% + 2rem); display: inline-flex; width: max-content; white-space: nowrap; transform: translate(-50%, 0); transition: top 0.7s ease, opacity 0.4s ease; }
  .and-then-map__token :global(.and-then-map__box) { flex-wrap: nowrap; }
  .and-then-map__token--fn { --y: 4.5rem; border: 2px solid var(--case-line); border-radius: 6px; background: #24292e; color: #e1e4e8; padding: 0.125rem 0.5rem; }
  .and-then-map__token--fn code { background: none; color: inherit; padding: 0; font-size: 0.875rem; }
  .and-then-map__fn-name { color: #b392f0; }
  .and-then-map__fn-arg { color: #79b8ff; opacity: 0; transition: opacity 0.3s ease 0.35s; }
  .and-then-map__token--arg { --y: 0rem; opacity: 0; }
  .and-then-map__token--result { --y: 4.5rem; opacity: 0; }
  .and-then-map__token--returned { --y: 9rem; opacity: 0; }
  .and-then-map__frame { position: relative; isolation: isolate; display: inline-flex; align-items: center; gap: 0.125rem; padding: 0.25rem 0.5rem; font-family: var(--font-mono, monospace); }
  .and-then-map__frame::before { content: ""; position: absolute; inset: 0; border: 2px solid #137333; border-radius: 6px; background: #24292e; z-index: -1; opacity: 0; transform: scale(1.6); transition: opacity 0.4s ease, transform 0.6s ease; }
  .and-then-map__frame--none::before { display: none; }
  .and-then-map__frame--nest::before { border-width: 3px; border-color: #9a5b00; }
  .and-then-map__frame-tag { font-size: 0.8125rem; font-weight: 700; color: #b392f0; opacity: 0; transition: opacity 0.4s ease 0.2s; }
  .and-then-map__frame--nest .and-then-map__frame-tag { color: #b392f0; }
  .and-then-map__action { left: calc(50% + 2rem); --y: 16.25rem; transform: translateX(-50%); white-space: nowrap; font-size: 0.8125rem; font-weight: 700; opacity: 0; transition: opacity 0.4s ease; }
  [data-state="extract"] .and-then-map__token--arg { --y: 2.5rem; opacity: 1; }
  [data-state="call"] .and-then-map__token--arg, [data-state="return"] .and-then-map__token--arg, [data-state="wrap"] .and-then-map__token--arg, [data-state="result"] .and-then-map__token--arg { --y: 4.5rem; opacity: 0; }
  [data-state="call"] .and-then-map__fn-arg, [data-state="return"] .and-then-map__fn-arg, [data-state="wrap"] .and-then-map__fn-arg, [data-state="result"] .and-then-map__fn-arg { opacity: 1; }
  [data-state="return"] .and-then-map__token--result { --y: 9rem; opacity: 1; }
  [data-state="wrap"] .and-then-map__token--result, [data-state="result"] .and-then-map__token--result { --y: 13.5rem; opacity: 1; }
  [data-state="wrap"] .and-then-map__token--returned, [data-state="result"] .and-then-map__token--returned { opacity: 0.6; }
  [data-state="wrap"] .and-then-map__frame::before, [data-state="result"] .and-then-map__frame::before { opacity: 1; transform: none; }
  [data-state="wrap"] .and-then-map__frame-tag, [data-state="result"] .and-then-map__frame-tag { opacity: 1; }
  [data-state="wrap"] .and-then-map__action, [data-state="result"] .and-then-map__action { opacity: 1; }
  .and-then-map__steps { min-height: 4.5rem; margin: 0.25rem 0 0; padding: 0; list-style: none; font-weight: 700; }
  .and-then-map__steps li { margin: 0; }
  .and-then-map__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; margin-top: 0.25rem; }
  .and-then-map__controls button { border: 2px solid var(--case-line); border-radius: 6px; background: #fffdf7; padding: 0.25rem 0.75rem; cursor: pointer; }
  .and-then-map__controls [data-play] { min-width: calc(4em + 1.5rem + 4px); }
  .and-then-map__controls button:disabled { opacity: 0.4; cursor: default; }
  .and-then-map__counter { font-size: 0.8125rem; }

  @media (max-width: 767px) {
    .and-then-map__row {
      padding: 0.5rem 0.625rem;
    }

    .and-then-map__source :global(pre) { font-size: 0.75rem; padding: 0.5rem; }
    .and-then-map__source--call :global(pre) { padding: 0.125rem 0.375rem; }

    .and-then-map__flow {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .and-then-map__stage {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.125rem 0.375rem;
    }

    .and-then-map__label,
    .and-then-map__stage small {
      flex-basis: 100%;
    }

    .and-then-map__stage + .and-then-map__stage::before {
      content: none;
    }

    .and-then-map__stage + .and-then-map__stage .and-then-map__label::before {
      content: "↓ ";
    }
  }
</style>

<script is:inline>
  {
    const STEP_MS = 3200;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll("[data-and-then-map]").forEach((root) => {
      const tabs = [...root.querySelectorAll("[data-scene-tab]")];
      const scenes = [...root.querySelectorAll("[data-scene]")];
      const prev = root.querySelector("[data-prev]");
      const play = root.querySelector("[data-play]");
      const next = root.querySelector("[data-next]");
      const counter = root.querySelector("[data-counter]");
      let sceneIndex = 0;
      let stepIndex = 0;
      let timer;

      const stepsOf = () => [...scenes[sceneIndex].querySelectorAll("[data-step]")];

      const render = () => {
        const steps = stepsOf();
        const current = steps[stepIndex];
        scenes.forEach((scene, index) => { scene.hidden = index !== sceneIndex; });
        tabs.forEach((tab, index) => tab.setAttribute("aria-pressed", String(index === sceneIndex)));
        steps.forEach((step, index) => { step.hidden = index !== stepIndex; });
        const scene = scenes[sceneIndex];
        scene.querySelector("[data-stage]").dataset.state = current.dataset.step;
        scene.querySelectorAll("[data-hl]").forEach((seg) => {
          seg.classList.toggle("is-active", seg.dataset.hl === current.dataset.focus);
        });
        counter.textContent = `${stepIndex + 1} / ${steps.length}`;
        prev.disabled = stepIndex === 0;
        next.disabled = stepIndex === steps.length - 1;
      };

      const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
        play.textContent = "再生";
      };

      const start = () => {
        window.clearInterval(timer);
        const lastIndex = stepsOf().length - 1;
        stepIndex = stepIndex === lastIndex ? 0 : stepIndex + 1;
        render();
        if (stepIndex === lastIndex) {
          stop();
          return;
        }
        play.textContent = "一時停止";
        timer = window.setInterval(() => {
          stepIndex += 1;
          render();
          if (stepIndex === stepsOf().length - 1) stop();
        }, STEP_MS);
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          sceneIndex = index;
          stop();
          stepIndex = 0;
          render();
        });
      });
      play.addEventListener("click", () => (timer === undefined ? start() : stop()));
      prev.addEventListener("click", () => {
        stop();
        stepIndex = Math.max(0, stepIndex - 1);
        render();
      });
      next.addEventListener("click", () => {
        stop();
        stepIndex = Math.min(stepsOf().length - 1, stepIndex + 1);
        render();
      });

      const syncMotion = () => {
        root.classList.toggle("is-animated", !reducedMotion.matches);
        if (reducedMotion.matches) stop();
      };
      reducedMotion.addEventListener("change", syncMotion);
      syncMotion();
      render();
    });
  }
</script>
