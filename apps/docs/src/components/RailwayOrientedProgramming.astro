    stroke-width: 2;
  }

  .rop-basics__stage text,
  .rop-basics__endpoint {
    fill: #16251f;
    font-size: 15px;
    font-weight: 800;
  }

  .rop-basics__endpoint {
    font-size: 17px;
  }

  .rop-basics__success-label,
  .rop-basics__failure-label {
    font-size: 15px;
    font-weight: 800;
  }

  .rop-basics__success-label {
    fill: #137333;
  }

  .rop-basics__failure-label {
    fill: #b42318;
  }

  @media (max-width: 767px) {
