      right: 0;
      width: max-content;
      margin: -0.25rem 0 0 auto;
      padding: 0.25rem 0.5rem;
      background: var(--case-line);
      color: var(--case-paper);
      content: "横にスクロール";
      font-size: 0.75rem;
      font-weight: 800;
    }
  }
