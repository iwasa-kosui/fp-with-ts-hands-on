---
import { sessions, type ExerciseSessionSummary } from "../sessions/catalog";

type Props = Readonly<{
  currentSession?: ExerciseSessionSummary;
  placement: "opening" | "review";
}>;

const { currentSession, placement } = Astro.props;
const workflowSessions = sessions.filter((session) => session.kind === "exercise");
const placementLabel = placement === "opening" ? "開始時" : "レビュー時";
---

<aside
  class="workflow-risk-map"
  data-placement={placement}
  data-current-focus={currentSession?.workflowFocus}
  aria-label={`S2からS6の共通ワークフロー・リスクマップ（${placementLabel}）`}
>
  <h3>共通ワークフロー・リスクマップ</h3>
  <p>同じ診察開始のワークフローを、未解決のリスクごとに小さく実装していきます。</p>
  <ol class="decision-list">
    {
      workflowSessions.map((session) => {
        const isCurrent = session.slug === currentSession?.slug;
        return (
          <li
            class="decision-card"
            data-session-sequence={session.sequence}
            data-workflow-focus={session.workflowFocus}
            aria-current={isCurrent ? "step" : undefined}
          >
            <strong>SESSION {session.sequence}: {session.workflowFocus}</strong>
            <p><strong>解決するリスク:</strong> {session.workflowRisks.resolvedFromPrevious}</p>
            <p><strong>今回扱わないリスク:</strong> {session.workflowRisks.remainingForNext}</p>
          </li>
        );
      })
    }
  </ol>
</aside>
