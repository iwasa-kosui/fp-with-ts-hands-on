---
type Variant = "blank" | "answer";

type Props = Readonly<{
  variant: Variant;
}>;

const { variant } = Astro.props;
const fields = [
  {
    id: "trigger",
    prompt: "何が起きたことで始まるか",
    answer: "受付が診察室へ案内した患者を、担当獣医師が引き受けて診察に取りかかったこと。",
  },
  {
    id: "input",
    prompt: "誰が何を依頼するか",
    answer:
      "その担当獣医師、または代理で操作する受付スタッフが、予約IDと担当獣医師IDを添えて診察開始を依頼する。開始時刻と記録IDは依頼に含めず、実行時に一度だけ決める。",
  },
  {
    id: "current state",
    prompt: "開始前に何が成り立っているか",
    answer: "対象の予約が受付済みの状態にあり、その予約に来院時刻が記録されていること。",
  },
  {
    id: "expected failures",
    prompt: "どのような失敗が予想されるか",
    answer:
      "依頼された予約が見つからない失敗と、予約が受付済みではない（未受付・診察中・会計済み）ために開始できない失敗。",
  },
  {
    id: "output event",
    prompt: "成功したとき何が起きたと記録するか",
    answer:
      "誰がいつどの予約の診察を開始したかを ExaminationStarted として記録し、その予約が診察中になったことを残す。",
  },
  {
    id: "side effects",
    prompt: "どこへ何を保存・通知するか",
    answer:
      "予約ストアへ診察中になった予約状態を、監査記録へ ExaminationStarted を、同じ保存境界の中で一緒に保存する。飼い主や外部システムへの通知はこのワークフローでは行わない。",
  },
] as const;
---

<section
  class="workflow-card"
  data-variant={variant}
  aria-label={variant === "blank" ? "班で埋めるワークフローカード" : "講師回答例のワークフローカード"}
>
  <h4>{variant === "blank" ? "班で埋める空欄カード" : "講師回答例"}</h4>
  <div class="decision-list">
    {
      fields.map((field) => (
        <article class="decision-card" data-workflow-field={field.id}>
          <h5>{field.prompt}</h5>
          {variant === "blank" ? (
            <label>
              <span>班の答え</span>
              <textarea
                name={field.id}
                rows="2"
                placeholder="ここに書き込む"
                aria-label={field.prompt}
              ></textarea>
            </label>
          ) : (
            <p>{field.answer}</p>
          )}
        </article>
      ))
    }
  </div>
  {
    variant === "answer" ? (
      <p class="before-after">
        <strong>ワークフローを分ける:</strong>
        検査結果の到着は診察開始の途中処理ではなく、別のきっかけから始まるワークフローです。
      </p>
    ) : null
  }
</section>
