---
import { Code } from "astro:components";
import type { CodeGuide } from "../code-explorer/code-guide";
import {
  sessionPath,
  sessions,
  type ExerciseSessionSummary,
  type SessionSummary,
} from "../sessions/catalog";
import CommandBlock from "./CommandBlock.astro";
import ExerciseReviewChecklist from "./ExerciseReviewChecklist.astro";
import PeerReviewPanel from "./PeerReviewPanel.astro";
import PeerReviewPromises from "./PeerReviewPromises.astro";
import StepSolution from "./StepSolution.astro";
import WorkflowRiskMap from "./WorkflowRiskMap.astro";
import SessionCodeOverview from "./code-explorer/SessionCodeOverview.astro";
import SessionCodePlayground from "./code-explorer/SessionCodePlayground.astro";

type Narrative = Readonly<{
  requirement: string;
  currentRisk: string;
  pitfallCode?: SourcedCode;
  design: string;
  limitation: string;
  nextQuestion: string;
  legacy: string;
  reviewFocus: string;
  fallback: string;
}>;

type SourcedCode = Readonly<{
  sources: readonly [string, ...string[]];
  code: string;
}>;

type TeachingCode = Readonly<{
  sources?: readonly [string, ...string[]];
  caption?: string;
  code: string;
}>;

type TeachingTopic = Readonly<{
  name: string;
  definition: string;
  before: TeachingCode;
  after: TeachingCode;
  example?: Readonly<{
    caption: string;
    code: string;
  }>;
  why: string;
}>;

type Props = Readonly<{
  session: SessionSummary;
  guides: readonly CodeGuide[];
  narrative: Narrative;
  teaching?: readonly TeachingTopic[];
}>;

const { session, guides, narrative, teaching = [] } = Astro.props;
if (
  session.kind !== "exercise" ||
  session.exerciseCommand === undefined ||
  session.exerciseModule === undefined ||
  session.adv === undefined ||
  session.peerReview === undefined
) {
  throw new Error(`ExerciseSessionContent requires exercise metadata: ${session.slug}`);
}
const exerciseSession: ExerciseSessionSummary = session;
const promisesSession = sessions.find(
  (candidate) =>
    candidate.kind === "exercise" && candidate.peerReviewPromises === "inline",
);
if (promisesSession === undefined) {
  throw new Error("ExerciseSessionContent requires one inline peer-review promise session");
}
const promisesHref =
  exerciseSession.peerReviewPromises === "inline"
    ? "#peer-review-promises"
    : `${sessionPath(promisesSession)}#peer-review-promises`;
---

<section id="incident">
  <h2>今回つくるもの</h2>
  <h3 data-story-stage="use-case">追加したい機能</h3>
  <p>{narrative.requirement}</p>
  <h3 data-story-stage="pitfall">素朴な実装の落とし穴</h3>
  <p>{narrative.currentRisk}</p>
  {
    narrative.pitfallCode === undefined ? null : (
      <figure class="code-block pitfall-code" data-pitfall-code>
        <figcaption>
          配布コードをもとにした例:
          {narrative.pitfallCode.sources.map((source, index) => (
            <Fragment>{index === 0 ? " " : "、"}<code>{source}</code></Fragment>
          ))}
        </figcaption>
        <Code code={narrative.pitfallCode.code} lang="ts" />
      </figure>
    )
  }
  <h3 data-story-stage="goal">このセッションのゴール</h3>
  <p>{narrative.design}</p>
  <h3>このセッションで守ること</h3>
  <ul class="decision-list">
    {session.decisions.map(({ invariant }) => <li>{invariant}</li>)}
  </ul>
  <p>今回の変更は <code>{session.exerciseModule.dir}</code> 内の1モジュールに限定します。</p>
  <WorkflowRiskMap currentSession={exerciseSession} placement="opening" />
</section>

<section id="legacy">
  <h2>コードを読み、失敗を再現する</h2>
  <p>{narrative.legacy}</p>
  <p>
    編集する範囲は <code>{session.exerciseModule.dir}</code>、変更するファイル数は最大
    {session.exerciseModule.fileBudget}ファイル・約{session.exerciseModule.lineBudget}行です。
  </p>
  <SessionCodeOverview slug={session.slug} guides={guides} />
  <h3>見つけた問題を RED で確かめる</h3>
  <p>配布コードで見つけた問題が、業務名を持つ assertion の失敗として現れることを確認します。</p>
  <CommandBlock
    phase="red"
    command={session.exerciseCommand}
    expected={`${session.steps.length}件の参加者ステップが、業務上の未解決条件として失敗します。`}
  />
  <h3>今回のステップ</h3>
  <ol class="exercise-steps">
    {session.steps.map((step) => <li><strong>{step.goal}</strong></li>)}
  </ol>
</section>

{
  teaching.length === 0 ? null : (
    <section id="teach">
      <h2>事前知識（{session.timeBreakdown.teach}分）</h2>
      <p>
        この回で利用する型について確認します。配布コードの書き方を before、次のスナップショットの書き方を after として並べています。
      </p>
      {teaching.map((topic) => (
        <article class="teaching-topic">
          <h3>{topic.name}</h3>
          <p>{topic.definition}</p>
          <div class="teaching-topic__diff">
            <figure class="code-block">
              <figcaption>
                before:
                {
                  topic.before.caption === undefined ? (
                    topic.before.sources?.map((source, index) => (
                      <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                    ))
                  ) : (
                    <span>{topic.before.caption}</span>
                  )
                }
              </figcaption>
              <Code code={topic.before.code} lang="ts" />
            </figure>
            <figure class="code-block">
              <figcaption>
                after:
                {
                  topic.after.caption === undefined ? (
                    topic.after.sources?.map((source, index) => (
                      <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                    ))
                  ) : (
                    <span>{topic.after.caption}</span>
                  )
                }
              </figcaption>
              <Code code={topic.after.code} lang="ts" />
            </figure>
          </div>
          {
            topic.example === undefined ? null : (
              <figure class="code-block" data-teaching-example>
                <figcaption>{topic.example.caption}</figcaption>
                <Code code={topic.example.code} lang="ts" />
              </figure>
            )
          }
          <p class="teaching-topic__why"><strong>なぜこの型を使うのか:</strong> {topic.why}</p>
        </article>
      ))}
    </section>
  )
}

<section id="refactor">
  <h2>演習</h2>
  <h3>進め方: 言語化 → Agentへの依頼 → 検証</h3>
  <ol class="adv-flow">
    <li><strong>言語化（{session.adv.articulate}分）</strong>: 守るべき不変条件を1文で書く。</li>
    <li><strong>依頼（{session.adv.delegate}分）</strong>: 不変条件をもとにプロンプトを作成し、Agent に依頼する</li>
    <li><strong>検証（{session.adv.verify}分）</strong>: 型、テスト、差分の範囲を確認する。</li>
  </ol>
  <div class="delegation-prompt">
    <h3>プロンプトのテンプレート</h3>
    <pre><code>{`${session.exerciseModule.dir}/ の中だけを変更してください。
不変条件: ____________
検証: ${session.exerciseCommand} を全てパスすること。
禁止: as によるキャスト。モジュール外のファイルの変更。`}</code></pre>
  </div>
  <h3>この演習で解決しないこと</h3>
  <p>{narrative.limitation}</p>
  <h3 data-solution-heading>{exerciseSession.solutionPresentation === "completed-file" ? "完成ファイルの解答例" : "ステップごとの解答"}</h3>
  {
    exerciseSession.solutionPresentation === "completed-file" ? (
      <div class="before-after" aria-label="業務結果と非同期例外経路の見比べ方">
        <p><strong>演習の開始時点:</strong> 予期できる業務 Result と、保存処理が reject する技術的な例外経路を分けて読む。</p>
        <p><strong>完成例:</strong> 下のすべての target file には、後続 step を含む完成状態が表示される。</p>
      </div>
    ) : null
  }
  {
    session.steps.map((step) => (
      <div class="solution-step">
        <StepSolution step={step} />
      </div>
    ))
  }
  <SessionCodePlayground slug={session.slug} />
  <CommandBlock
    phase="green"
    command={session.exerciseCommand}
    expected="assertionが成功することを確認する"
  />
</section>

<section id="review">
  <h2>レビュー観点と振り返り</h2>
  <h3>改善前の事故と照らし合わせる</h3>
  <p><strong>背景にある事故:</strong> {session.incident}</p>
  <p><strong>この回の固有観点:</strong> {narrative.reviewFocus}</p>
  <ExerciseReviewChecklist snapshot={session.snapshot} />
  <h3>設計判断と差分を照らし合わせる</h3>
  <div class="decision-list">
    {session.decisions.map((decision) => (
      <article class="decision-card">
        <h4>{decision.invariant}</h4>
        <p><strong>型で表す:</strong> {decision.byType}</p>
        <p><strong>型だけでは守れないこと:</strong> {decision.notByType}</p>
      </article>
    ))}
  </div>
  {
    exerciseSession.peerReviewPromises === "inline" ? (
      <PeerReviewPromises id="peer-review-promises" />
    ) : null
  }
  <PeerReviewPanel peerReview={session.peerReview} promisesHref={promisesHref} />

  <h3>参照実装との接続</h3>
  <ul class="reference-list">
    {session.finalReferences.map((reference) => <li><code>{reference}</code></li>)}
  </ul>
  <h3>演習を完了できないとき</h3>
  <p>{narrative.fallback}</p>
  <h3>次のセッションへの問い</h3>
  <p>{narrative.nextQuestion}</p>
  <WorkflowRiskMap currentSession={exerciseSession} placement="review" />
</section>
