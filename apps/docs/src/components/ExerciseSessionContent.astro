---
import type { CodeGuide } from "../code-explorer/code-guide";
import type { SessionSummary } from "../sessions/catalog";
import CommandBlock from "./CommandBlock.astro";
import ExerciseReviewChecklist from "./ExerciseReviewChecklist.astro";
import PeerReviewPanel from "./PeerReviewPanel.astro";
import PeerReviewPromises from "./PeerReviewPromises.astro";
import StepSolution from "./StepSolution.astro";
import SessionCodeOverview from "./code-explorer/SessionCodeOverview.astro";
import SessionCodePlayground from "./code-explorer/SessionCodePlayground.astro";

type Narrative = Readonly<{
  requirement: string;
  legacy: string;
  technique: string;
  limitation: string;
  reviewFocus: string;
  fallback: string;
}>;

type Props = Readonly<{
  session: SessionSummary;
  guides: readonly CodeGuide[];
  narrative: Narrative;
}>;

const { session, guides, narrative } = Astro.props;
if (
  session.kind !== "exercise" ||
  session.exerciseCommand === undefined ||
  session.exerciseModule === undefined ||
  session.adv === undefined ||
  session.peerReview === undefined
) {
  throw new Error(`ExerciseSessionContent requires exercise metadata: ${session.slug}`);
}
const promisesHref =
  session.slug === "01-state-modeling"
    ? "#peer-review-promises"
    : "/sessions/01-state-modeling/#peer-review-promises";
---

<section id="incident">
  <h2>何が起きたか</h2>
  <p><strong>要求:</strong> {narrative.requirement}</p>
  <p><strong>事故:</strong> {session.incident}</p>
  <h3>今回守ること</h3>
  <ul class="decision-list">
    {session.decisions.map(({ invariant }) => <li>{invariant}</li>)}
  </ul>
  <p>今回の変更は <code>{session.exerciseModule.dir}</code> の1モジュールだけに閉じます。</p>
</section>

<section id="legacy">
  <h2>配布コードを読む</h2>
  <p>{narrative.legacy}</p>
  <p>
    編集範囲は <code>{session.exerciseModule.dir}</code>、予算は最大
    {session.exerciseModule.fileBudget}ファイル・実効{session.exerciseModule.lineBudget}行です。
  </p>
  <SessionCodeOverview slug={session.slug} guides={guides} />
</section>

<section id="red">
  <h2>失敗を再現する</h2>
  <p>開始スナップショットの失敗は module-not-found ではなく、業務の言葉を持つ assertion です。</p>
  <CommandBlock
    phase="red"
    command={session.exerciseCommand}
    expected={`${session.steps.length}件の参加者ステップが、業務上の未解決条件として失敗します。`}
  />
  <h3>今回のステップ</h3>
  <ol class="exercise-steps">
    {session.steps.map((step) => <li><strong>{step.goal}</strong></li>)}
  </ol>
</section>

<section id="refactor">
  <h2>型で閉じる</h2>
  <h3>ADV: 言語化 → 委譲 → 個人検証</h3>
  <ol class="adv-flow">
    <li><strong>言語化（{session.adv.articulate}分）</strong>: 守る不変条件を1文で書く。</li>
    <li><strong>委譲（{session.adv.delegate}分）</strong>: 依頼文へ変換し、モジュール内だけを変更する。</li>
    <li><strong>個人検証（{session.adv.verify}分）</strong>: 型、テスト、差分範囲を確認する。</li>
  </ol>
  <div class="delegation-prompt">
    <h3>穴を埋めて使う依頼文</h3>
    <pre><code>{`${session.exerciseModule.dir}/ の中だけを変更してください。
守る不変条件: ____________
検証: ${session.exerciseCommand} が緑になること。
禁止: as によるキャスト。モジュール外のファイルの変更。`}</code></pre>
  </div>
  <p><strong>採用する手段:</strong> {narrative.technique}</p>
  <p><strong>この手段の限界:</strong> {narrative.limitation}</p>
  <h3>{session.slug === "04-effects-and-events" ? "完成ファイルの解答例" : "ステップごとの解答"}</h3>
  {
    session.steps.map((step) => (
      <div class="solution-step">
        {session.slug === "04-effects-and-events" && step.id === "s4-result-async" ? (
          <div class="before-after" aria-label="同期版と非同期版の見比べ方">
            <p><strong>開始側:</strong> 同期 Result と Promise + try/catch の境界を先に読む。</p>
            <p><strong>完成例:</strong> 下の全target fileには、ResultAsync と andThroughに加えて後続stepも含まれる。</p>
          </div>
        ) : null}
        <StepSolution step={step} />
      </div>
    ))
  }
  <SessionCodePlayground slug={session.slug} />
  <CommandBlock
    phase="green"
    command={session.exerciseCommand}
    expected="同じ業務名の assertion が成功し、通常テストと型検査も保たれます。"
  />
</section>

<section id="review">
  <h2>レビューと持ち帰り</h2>
  <ExerciseReviewChecklist snapshot={session.snapshot} />
  <h3>設計判断を差分へ照らす</h3>
  <div class="decision-list">
    {session.decisions.map((decision) => (
      <article class="decision-card">
        <h4>{decision.invariant}</h4>
        <p><strong>型で表す:</strong> {decision.byType}</p>
        <p><strong>型で守れない残り:</strong> {decision.notByType}</p>
      </article>
    ))}
  </div>
  <p><strong>この回の固有観点:</strong> {narrative.reviewFocus}</p>

  {
    session.slug === "01-state-modeling" ? (
      <PeerReviewPromises id="peer-review-promises" />
    ) : null
  }
  <PeerReviewPanel peerReview={session.peerReview} promisesHref={promisesHref} />

  <h3>参照実装との接続</h3>
  <ul class="reference-list">
    {session.finalReferences.map((reference) => <li><code>{reference}</code></li>)}
  </ul>
  <h3>完走できないとき</h3>
  <p>{narrative.fallback}</p>
</section>
