---

<div class="step-controls" data-controls hidden>
  <button type="button" data-prev disabled>← 前へ</button>
  <button type="button" data-play>▶ 再生</button>
  <button type="button" data-next>次へ →</button>
  <span data-progress></span>
</div>

<style>
  .step-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-block-end: 0.75rem;
  }

  .step-controls[hidden] {
    display: none;
  }

  button {
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 2px solid var(--case-blue);
    border-radius: 0.5rem;
    background: var(--case-blue);
    color: var(--case-paper);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    white-space: nowrap;
  }

  button[data-play] {
    min-width: 8.5rem;
  }

  button:disabled {
    border-color: var(--case-line);
    background: var(--case-paper);
    color: var(--case-ink);
    cursor: not-allowed;
    opacity: 0.55;
  }

  button:focus-visible {
    outline: 3px solid var(--case-blue);
    outline-offset: 2px;
  }

  [data-progress] {
    color: var(--case-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
</style>
