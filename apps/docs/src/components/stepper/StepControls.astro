---
import "./step-controls.css";
---

<div class="step-controls" data-controls hidden>
  <button type="button" class="step-btn step-btn--prev" data-prev disabled>戻る</button>
  <span class="step-progress" data-progress aria-live="polite"></span>
  <button type="button" class="step-btn step-btn--next" data-next>次へ</button>
</div>
