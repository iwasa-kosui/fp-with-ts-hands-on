---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import { keyedTransformer } from "./code-cache-key";
import MiniTree from "./mini-tree/MiniTree.astro";
import { miniTree } from "./mini-tree/mini-tree";
import { clinicFixture } from "../../../../examples/fixtures/clinic";

type Snippet = Readonly<{ path: string; code: string }>;
type Props = Readonly<{
  code: Readonly<{
    beforeId: Snippet;
    afterId: Snippet;
    beforeSwap: Snippet;
    afterSwap: Snippet;
    afterParse: Snippet;
  }>;
}>;

const { code } = Astro.props;

const versionLabels = { before: "ブランドなし", after: "ブランドあり" } as const;

type Transformer = NonNullable<ComponentProps<typeof Code>["transformers"]>[number];
const KEY_MARK = /\s*\/\/ \[!branded-key\]$/;
const withMarks = (source: string, keyLines: readonly number[]) =>
  source.split("\n").map((text, index) => (keyLines.includes(index + 1) ? `${text} // [!branded-key]` : text)).join("\n");
const markKeyLines = keyedTransformer<Transformer>("branded-id-flow", {
  name: "mark-branded-key-lines",
  preprocess(source) {
    const lines = source.split("\n");
    (this.meta as { keyLines?: number[] }).keyLines = lines.flatMap((text, index) => (KEY_MARK.test(text) ? [index + 1] : []));
    return lines.map((text) => text.replace(KEY_MARK, "")).join("\n");
  },
  line(node, line) {
    if ((this.meta as { keyLines?: number[] }).keyLines?.includes(line)) this.addClassToHast(node, "branded-id-flow__key");
  },
});

type Mode = "normal" | "dim";
type TokenState = "off" | "home" | "through" | "stop";
type Frame = Readonly<{
  caption: string;
  extra?: "fixture" | "compare";
  stage: keyof typeof versionLabels | null;
  code?: Readonly<{ key: keyof Props["code"]; lines: readonly number[] }>;
  modes: readonly [Mode, Mode, Mode, Mode];
  tokens: readonly [TokenState, TokenState, TokenState];
  marks: "string" | "ghost" | "brand";
  plug: "home" | "slot" | "stop";
  slotTag: "string" | "brand";
  verdict: "pass" | "error" | null;
  gate: "pass" | "stop" | null;
  runtime: boolean;
}>;

const frames: readonly Frame[] = [
  {
    caption: "予約IDと獣医師IDは、どちらもUUIDの形をした文字列です。値を見ただけでは、どちらのIDか判別できません。",
    stage: null,
    modes: ["normal", "dim", "dim", "dim"],
    tokens: ["home", "home", "off"],
    marks: "string",
    plug: "home",
    slotTag: "string",
    verdict: null,
    gate: null,
    runtime: false,
  },
  {
    caption: "ブランドなしのschemaは z.string().uuid() だけです。z.infer で得る AppointmentId 型の中身は string で、VeterinarianId 型も同じ string です。",
    stage: "before",
    code: { key: "beforeId", lines: [3, 5] },
    modes: ["dim", "dim", "normal", "dim"],
    tokens: ["home", "home", "off"],
    marks: "string",
    plug: "home",
    slotTag: "string",
    verdict: null,
    gate: null,
    runtime: false,
  },
  {
    caption: "獣医師IDを受け取る関数に予約IDを渡しても、どちらの型も string であるため型検査は誤りを報告しません。取り違えは、実行して記録に異常が出てから発見されます。",
    stage: "before",
    code: { key: "beforeSwap", lines: [5] },
    modes: ["dim", "dim", "normal", "normal"],
    tokens: ["home", "home", "off"],
    marks: "string",
    plug: "slot",
    slotTag: "string",
    verdict: "pass",
    gate: null,
    runtime: false,
  },
  {
    caption: ".brand<\"AppointmentId\">() を付けた schema が AppointmentId.schema で、推論される型は string に AppointmentId というブランドを追加した型です。獣医師IDの VeterinarianId.schema には VeterinarianId という別のブランドが付きます。",
    stage: "after",
    code: { key: "afterId", lines: [3, 5] },
    modes: ["dim", "dim", "normal", "dim"],
    tokens: ["home", "home", "off"],
    marks: "brand",
    plug: "home",
    slotTag: "brand",
    verdict: null,
    gate: null,
    runtime: false,
  },
  {
    caption: "ブランドの違う値を渡すと、型検査が型エラーとして報告します。@ts-expect-error は、この行で型エラーが発生することを検証するための注釈です。",
    stage: "after",
    code: { key: "afterSwap", lines: [7, 8] },
    modes: ["dim", "dim", "normal", "normal"],
    tokens: ["home", "home", "off"],
    marks: "brand",
    plug: "stop",
    slotTag: "brand",
    verdict: "error",
    gate: null,
    runtime: false,
  },
  {
    caption: "ブランドは型検査のときだけ使われます。TypeScript を JavaScript に変換すると型は消え、実行時の値はブランドなしと同じ文字列のままです。",
    stage: "after",
    modes: ["dim", "dim", "normal", "dim"],
    tokens: ["home", "home", "off"],
    marks: "ghost",
    plug: "home",
    slotTag: "brand",
    verdict: null,
    gate: null,
    runtime: true,
  },
  {
    caption: "ブランドが付いた値を作る正規の入口は parse です。parse は文字列がUUIDの形かを検査し、通った値だけを AppointmentId 型として返します。as で型だけを付ける回避は、別に Linter で検出します。",
    stage: "after",
    code: { key: "afterParse", lines: [4, 5] },
    extra: "fixture",
    modes: ["normal", "normal", "normal", "dim"],
    tokens: ["through", "through", "off"],
    marks: "brand",
    plug: "home",
    slotTag: "brand",
    verdict: null,
    gate: "pass",
    runtime: false,
  },
  {
    caption: "UUIDの形でない文字列は AppointmentId.parse を通らず、AppointmentId 型の値は作られません。この parse は正しいと分かっている値に使い、誤りはコードの誤りとして S02 の fail-fast と同じく例外で中断します。外部入力には、検査に失敗すると Err を返す StartExaminationInput.parse を使います。",
    extra: "compare",
    stage: null,
    modes: ["normal", "normal", "dim", "dim"],
    tokens: ["home", "home", "stop"],
    marks: "brand",
    plug: "home",
    slotTag: "brand",
    verdict: null,
    gate: "stop",
    runtime: false,
  },
];

const compareExamples = [
  {
    label: "例外を投げる parse",
    text: "検査に失敗すると例外を投げます。",
    code: `parse: schema.parse\nAppointmentId.parse("night-shift")`,
  },
  {
    label: "Err を返す parse",
    text: "検査に失敗すると Err を返します。",
    code: `parse: schemaResult(schema)\nStartExaminationInput.parse(raw)`,
  },
] as const;

const treeGroups = [
  { folder: "domain/appointment/", files: [{ id: "appointmentId", name: "appointmentId.ts" }] },
  { folder: "domain/", files: [{ id: "test-types", name: "domain.test-types.ts" }] },
];
const treeBefore = miniTree("session-03-supplement", "src/", treeGroups);
const treeAfter = miniTree("session-03-supplement-solution", "src/", treeGroups);
const treeFor = (key: keyof Props["code"]) => ({
  tree: key === "beforeId" || key === "beforeSwap" ? treeBefore : treeAfter,
  current: [key === "beforeId" || key === "afterId" ? "appointmentId" : "test-types"],
});

const initial = frames[0];
const idPreview = (id: string) => `${id.slice(0, 8)}…`;

const tokens = [
  { x: 40, label: "予約ID", value: idPreview(clinicFixture.appointmentId) },
  { x: 240, label: "獣医師ID", value: idPreview(clinicFixture.veterinarianId) },
  { x: 440, label: "文字列", value: "\"not-a-uuid\"" },
] as const;

const cards = [
  { id: "appointment", label: "予約ID", value: tokens[0].value, brand: "AppointmentId" },
  { id: "veterinarian", label: "獣医師ID", value: tokens[1].value, brand: "VeterinarianId" },
] as const;

const playerData = JSON.stringify(frames.map(({ code: _code, extra: _extra, ...frame }) => frame));
---

<div class="branded-id-flow" data-branded-id-flow data-frames={playerData}>
  <div class="branded-id-flow__controls" data-controls hidden>
    <button type="button" data-prev disabled>← 前のコマ</button>
    <span data-progress>1 / {frames.length}</span>
    <button type="button" data-next>次のコマ →</button>
    <div class="branded-id-flow__stage" data-stage hidden>
      <span class="branded-id-flow__tag" data-stage-tag hidden></span>
    </div>
  </div>

  <svg
    viewBox="0 0 640 454"
    role="img"
    aria-labelledby="branded-id-flow-title branded-id-flow-desc"
    data-marks={initial.marks}
    data-plug={initial.plug}
    data-slot-tag={initial.slotTag}
  >
    <title id="branded-id-flow-title">Branded Type が取り違えを防止する仕組み</title>
    <desc id="branded-id-flow-desc">
      一番上の「外部入力の文字列」の行は、外部から受け取る予約IDと獣医師IDの文字列です。上から2番目の「parse」の行は、UUIDの形かを検査する parse です。上から3番目の「値」の行は、予約IDと獣医師IDの値です。ブランドなしではどちらも string 型で、ブランドありでは AppointmentId と VeterinarianId という別のブランドが付きます。一番下の「受け取る関数」の行は、獣医師IDを受け取る関数です。ブランドなしでは予約IDを渡しても型検査を通り、ブランドありではブランドが違うため型検査が型エラーとして報告します。
    </desc>

    <g class="branded-id-flow__band" data-band="0" data-mode={initial.modes[0]}>
      <rect x="0" y="0" width="640" height="76" rx="8" class="branded-id-flow__band-bg"></rect>
      <text x="10" y="18" class="branded-id-flow__band-label branded-id-flow__dimmable">外部入力の文字列</text>
    </g>

    <g class="branded-id-flow__band" data-band="1" data-mode={initial.modes[1]}>
      <rect x="0" y="84" width="640" height="56" rx="8" class="branded-id-flow__band-bg"></rect>
      <text x="10" y="102" class="branded-id-flow__band-label branded-id-flow__dimmable">parse</text>
      <g class="branded-id-flow__gate branded-id-flow__dimmable" data-gate-group data-gate={initial.gate}>
        <rect x="80" y="108" width="480" height="26" rx="6"></rect>
        <text x="320" y="126" text-anchor="middle" class="branded-id-flow__node-text">parse（UUIDの形かを検査）</text>
        <g class="branded-id-flow__badge branded-id-flow__badge--pass">
          <circle cx="552" cy="108" r="10"></circle>
          <text x="552" y="113" text-anchor="middle">✓</text>
        </g>
        <g class="branded-id-flow__badge branded-id-flow__badge--stop">
          <circle cx="552" cy="108" r="10"></circle>
          <text x="552" y="113" text-anchor="middle">×</text>
        </g>
      </g>
    </g>

    <g class="branded-id-flow__band" data-band="2" data-mode={initial.modes[2]}>
      <rect x="0" y="148" width="640" height="116" rx="8" class="branded-id-flow__band-bg"></rect>
      <text x="10" y="166" class="branded-id-flow__band-label branded-id-flow__dimmable">値</text>
      <text x="320" y="258" text-anchor="middle" class="branded-id-flow__note branded-id-flow__runtime-note branded-id-flow__dimmable">実行時の値にはブランドがない</text>
    </g>

    <g class="branded-id-flow__band" data-band="3" data-mode={initial.modes[3]}>
      <rect x="0" y="268" width="640" height="178" rx="8" class="branded-id-flow__band-bg"></rect>
      <text x="10" y="286" class="branded-id-flow__band-label branded-id-flow__dimmable">受け取る関数</text>
      <g class="branded-id-flow__dimmable">
        <rect x="8" y="294" width="624" height="144" rx="8" class="branded-id-flow__function"></rect>
        <text x="24" y="318" class="branded-id-flow__node-text branded-id-flow__signature branded-id-flow__mono">acceptVeterinarianId(_id: VeterinarianId)</text>
        <g class="branded-id-flow__slot-tag branded-id-flow__slot-tag--string">
          <rect x="384" y="302" width="232" height="24" rx="12" class="branded-id-flow__pill-string"></rect>
          <text x="500" y="319" text-anchor="middle" class="branded-id-flow__node-text">VeterinarianId（中身は string）</text>
        </g>
        <g class="branded-id-flow__slot-tag branded-id-flow__slot-tag--brand" data-tone="veterinarian">
          <rect x="446" y="302" width="108" height="24" rx="12" class="branded-id-flow__pill-brand"></rect>
          <text x="500" y="319" text-anchor="middle" class="branded-id-flow__pill-text branded-id-flow__mono">VeterinarianId</text>
        </g>
        <rect x="290" y="338" width="190" height="64" rx="6" class="branded-id-flow__slot"></rect>
        <text x="385" y="374" text-anchor="middle" class="branded-id-flow__note">引数</text>
        <g class="branded-id-flow__verdict branded-id-flow__verdict--pass">
          <rect x="24" y="408" width="592" height="24" rx="6"></rect>
          <text x="320" y="425" text-anchor="middle">型検査: 通る（取り違えを検出できない）</text>
        </g>
        <g class="branded-id-flow__verdict branded-id-flow__verdict--error">
          <rect x="24" y="408" width="592" height="24" rx="6"></rect>
          <text x="320" y="425" text-anchor="middle">型検査: 型エラー</text>
        </g>
        <g class="branded-id-flow__reject">
          <circle cx="271" cy="370" r="10"></circle>
          <text x="271" y="375" text-anchor="middle">×</text>
        </g>
      </g>
    </g>

    <g class="branded-id-flow__tokens branded-id-flow__dimmable" data-tokens data-mode={initial.modes[0]}>
      {tokens.map((token, index) => (
        <g class="branded-id-flow__token" data-token={index} data-state={initial.tokens[index]}>
          <rect x={token.x} y="26" width="160" height="46" rx="6"></rect>
          <text x={token.x + 80} y="44" text-anchor="middle" class="branded-id-flow__node-text branded-id-flow__strong">{token.label}</text>
          <text x={token.x + 80} y="62" text-anchor="middle" class="branded-id-flow__node-text branded-id-flow__mono">{token.value}</text>
        </g>
      ))}
    </g>

    <g class="branded-id-flow__cards branded-id-flow__dimmable" data-cards data-mode={initial.modes[2]}>
      {cards.map((card) => (
        <g class="branded-id-flow__card" data-card={card.id}>
          <rect x="0" y="0" width="190" height="44" rx="6" class="branded-id-flow__card-body"></rect>
          <text x="95" y="18" text-anchor="middle" class="branded-id-flow__node-text branded-id-flow__strong">{card.label}</text>
          <text x="95" y="35" text-anchor="middle" class="branded-id-flow__node-text branded-id-flow__mono">{card.value}</text>
          <g class="branded-id-flow__tag-string">
            <rect x="33" y="48" width="124" height="22" rx="11" class="branded-id-flow__pill-string"></rect>
            <text x="95" y="63" text-anchor="middle" class="branded-id-flow__node-text branded-id-flow__mono">string</text>
          </g>
          <g class="branded-id-flow__tag-brand" data-tone={card.id}>
            <rect x="33" y="48" width="124" height="22" rx="11" class="branded-id-flow__pill-brand"></rect>
            <text x="95" y="63" text-anchor="middle" class="branded-id-flow__pill-text branded-id-flow__mono">{card.brand}</text>
          </g>
        </g>
      ))}
    </g>
  </svg>

  <div class="branded-id-flow__captions">
    <p class="branded-id-flow__live" data-live aria-live="polite" hidden></p>
    {frames.map((frame) => (
      <p class="branded-id-flow__sizer" aria-hidden="true">{frame.caption}</p>
    ))}
  </div>

  <ol class="branded-id-flow__frames">
    {frames.map((frame) => (
      <li data-frame data-has-code={frame.code || frame.extra ? "" : undefined}>
        <p class="branded-id-flow__caption">{frame.caption}</p>
        {frame.code && frame.stage && <MiniTree tree={treeFor(frame.code.key).tree} current={treeFor(frame.code.key).current} />}
        {frame.code && frame.stage && (
          <figure class="code-block branded-id-flow__code" data-version={frame.stage}>
            <figcaption><span class="branded-id-flow__tag" data-version={frame.stage}>{versionLabels[frame.stage]}</span> <code>{code[frame.code.key].path}</code></figcaption>
            <Code code={withMarks(code[frame.code.key].code, frame.code.lines)} lang="ts" defaultColor={false} transformers={[markKeyLines]} />
          </figure>
        )}
        {frame.extra === "fixture" && (
          <p class="branded-id-flow__note"><code>clinicFixture</code> は、このハンズオンのテスト用の固定データです。</p>
        )}
        {frame.extra === "compare" && (
          <div class="branded-id-flow__compare">
            {compareExamples.map((example) => (
              <section aria-label={example.label}>
                <p><strong>{example.label}</strong>: {example.text}</p>
                <Code code={example.code} lang="ts" />
              </section>
            ))}
          </div>
        )}
      </li>
    ))}
  </ol>
</div>

<script>
  type Mode = "normal" | "dim";
  type TokenState = "off" | "home" | "through" | "stop";
  type Frame = {
    caption: string;
    stage: "before" | "after" | null;
    modes: Mode[];
    tokens: TokenState[];
    marks: string;
    plug: string;
    slotTag: string;
    verdict: string | null;
    gate: string | null;
    runtime: boolean;
  };

  const versionLabels = { before: "ブランドなし", after: "ブランドあり" } as const;

  const setUp = (root: HTMLElement) => {
    if (root.dataset.ready !== undefined) return;
    const frames = JSON.parse(root.dataset.frames ?? "[]") as Frame[];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-frame]")];
    const svg = root.querySelector<SVGSVGElement>("svg");
    const bands = [...root.querySelectorAll<SVGGElement>("[data-band]")];
    const cards = root.querySelector<SVGGElement>("[data-cards]");
    const tokenLayer = root.querySelector<SVGGElement>("[data-tokens]");
    const tokens = [...root.querySelectorAll<SVGGElement>("[data-token]")];
    const gate = root.querySelector<SVGGElement>("[data-gate-group]");
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const stageTag = root.querySelector<HTMLElement>("[data-stage-tag]");
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    if (!svg || !cards || !tokenLayer || !gate || !stage || !stageTag || !controls || !prev || !next || !progress || !live) return;
    if (frames.length !== panels.length || bands.length !== 4 || tokens.length !== 3) return;
    root.dataset.ready = "";

    let current: number | null = null;
    const show = (index: number) => {
      const before = current === null ? null : frames[current];
      const frame = frames[index];
      current = index;
      panels.forEach((panel, i) => panel.classList.toggle("is-current", i === index));

      bands.forEach((band, i) => {
        band.dataset.mode = frame.modes[i];
      });
      cards.dataset.mode = frame.modes[2];
      tokenLayer.dataset.mode = frame.modes[0];

      tokens.forEach((token, i) => {
        const state = frame.tokens[i];
        const previous = before?.tokens[i];
        const jumps = (previous === "off" && (state === "through" || state === "stop")) || (previous === "through" && state === "home");
        if (jumps) {
          token.style.transition = "none";
          token.dataset.state = previous === "off" ? "home" : state;
          token.getBoundingClientRect();
          token.style.transition = "";
        }
        token.dataset.state = state;
      });

      svg.dataset.marks = frame.marks;
      svg.dataset.plug = frame.plug;
      svg.dataset.slotTag = frame.slotTag;
      svg.toggleAttribute("data-through", frame.tokens.includes("through"));
      svg.toggleAttribute("data-runtime", frame.runtime);
      if (frame.verdict) svg.dataset.verdict = frame.verdict;
      else delete svg.dataset.verdict;
      if (frame.gate) gate.dataset.gate = frame.gate;
      else delete gate.dataset.gate;

      if (frame.stage) {
        stageTag.hidden = false;
        stageTag.dataset.version = frame.stage;
        stageTag.textContent = versionLabels[frame.stage];
      } else {
        stageTag.hidden = true;
      }

      live.textContent = frame.caption;
      progress.textContent = `${index + 1} / ${frames.length}`;
      prev.disabled = index === 0;
      next.disabled = index === frames.length - 1;
    };

    prev.addEventListener("click", () => show(Math.max((current ?? 0) - 1, 0)));
    next.addEventListener("click", () => show(Math.min((current ?? 0) + 1, frames.length - 1)));

    root.dataset.animated = "";
    controls.hidden = false;
    stage.hidden = false;
    live.hidden = false;
    show(0);
  };

  document.querySelectorAll<HTMLElement>("[data-branded-id-flow]").forEach(setUp);
</script>

<style>
  .branded-id-flow {
    min-width: 0;
    max-width: 100%;
    margin: 1.5rem 0;
    --version-before: var(--case-pink);
    --version-after: var(--case-highlight);
    --brand-appointment: var(--case-ink);
    --brand-veterinarian: var(--case-muted);
    --verdict-error: var(--case-pink);
    --verdict-pass: var(--case-highlight);
  }

  [data-version="before"] {
    --version-color: var(--version-before);
  }

  [data-version="after"] {
    --version-color: var(--version-after);
  }

  .branded-id-flow svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    margin-inline: auto;
  }

  .branded-id-flow__band-bg {
    fill: var(--case-paper);
    stroke: var(--case-divider);
    stroke-width: 1.5;
  }

  .branded-id-flow__band-label,
  .branded-id-flow__node-text {
    fill: var(--case-ink);
    font-size: 13px;
  }

  .branded-id-flow__band-label {
    font-weight: 700;
  }

  .branded-id-flow__node-text {
    font-size: 13px;
  }

  .branded-id-flow__signature {
    font-size: 13px;
  }

  .branded-id-flow__strong {
    font-weight: 700;
