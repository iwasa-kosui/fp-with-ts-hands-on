---
import css from "./animated-explanation.css?raw";
import player from "./player.js?raw";
import type { Animation, AnimationStep } from "./types";

type Props = Readonly<{ animation: Animation }>;

const { animation } = Astro.props;
const frameOf = ({ text: _text, ...frame }: AnimationStep): string => JSON.stringify(frame);
---

<style is:inline set:html={css}></style>
<figure class="ax" data-ax id={`ax-${animation.id}`}>
  <figcaption class="ax-title">{animation.title}</figcaption>
  <p class="ax-lead" set:html={animation.lead} />
  <div class="ax-scene" data-ax-scene hidden aria-hidden="true" set:html={animation.scene} />
  <div class="ax-controls" data-ax-controls hidden>
    {animation.scenarios.length > 1 && (
      <div class="ax-tabs" role="group" aria-label="場面を選ぶ">
        {animation.scenarios.map((scenario) => (
          <button type="button" data-ax-tab aria-pressed="false">{scenario.label}</button>
        ))}
      </div>
    )}
    <div class="ax-buttons">
      <button type="button" data-ax-action="restart">最初へ</button>
      <button type="button" data-ax-action="back">前へ</button>
      <button type="button" data-ax-action="play">再生</button>
      <button type="button" data-ax-action="forward">次へ</button>
      <span class="ax-progress" data-ax-progress></span>
    </div>
  </div>
  <div class="ax-steps" aria-live="polite">
    {animation.scenarios.map((scenario) => (
      <div data-ax-scenario={scenario.id}>
        <p class="ax-scenario-title">{scenario.label}</p>
        <ol>
          {scenario.steps.map((step) => <li data-frame={frameOf(step)} set:html={step.text} />)}
        </ol>
      </div>
    ))}
  </div>
  {animation.note && <p class="ax-note" set:html={animation.note} />}
</figure>

{/* hoisted script にすると、アニメーションの無いページのスクリプトまで別ファイルに分かれる */}
<script is:inline type="module" set:html={`${player}\ninitAnimatedExplanations();`}></script>
