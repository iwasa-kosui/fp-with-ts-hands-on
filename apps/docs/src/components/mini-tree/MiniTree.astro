---
import type { MiniTreeData } from "./mini-tree";

type Props = {
  tree: MiniTreeData;
  current?: readonly string[];
  layout?: "ribbon" | "list";
  class?: string;
};

const { tree, current = [], layout = "ribbon", class: className } = Astro.props;

const isCurrent = (id: string) => current.includes(id);
---

<nav class:list={["mini-tree", className]} data-layout={layout} aria-label="ファイルの場所">
  <span class="mini-tree__root">{tree.root}</span>
  {tree.groups.map((group) => (
    <span class="mini-tree__group" data-new={group.isNew ? "" : undefined}>
      {layout === "list" ? (
        group.files.length === 0 ? (
          <span class="mini-tree__row">
            <span class="mini-tree__folder">{group.folder}</span>
            {group.note ? <span class="mini-tree__empty">{group.note}</span> : null}
            {group.isNew ? <span class="mini-tree__new">新しいフォルダ</span> : null}
          </span>
        ) : (
          group.files.map((file, index) => (
            <span class="mini-tree__row">
              <span class="mini-tree__folder">{group.folder}</span>
              <span class="mini-tree__file" data-mini-file={file.id} data-current={isCurrent(file.id) ? "" : undefined} aria-current={isCurrent(file.id) ? "true" : undefined}>{file.name}</span>
              {file.note ? <span class="mini-tree__note">{file.note}</span> : null}
              {index === 0 && group.note ? <span class="mini-tree__empty">{group.note}</span> : null}
              {index === 0 && group.isNew ? <span class="mini-tree__new">新しいフォルダ</span> : null}
            </span>
          ))
        )
      ) : (
        <>
          <span class="mini-tree__folder">{group.folder}</span>
          {group.files.map((file) => (
            <span class="mini-tree__file" data-mini-file={file.id} data-current={isCurrent(file.id) ? "" : undefined} aria-current={isCurrent(file.id) ? "true" : undefined}>
              {file.name}
              {file.note ? <span class="mini-tree__note">{file.note}</span> : null}
            </span>
          ))}
          {group.note ? <span class="mini-tree__empty">{group.note}</span> : null}
          {group.isNew ? <span class="mini-tree__new">新しいフォルダ</span> : null}
        </>
      )}
    </span>
  ))}
</nav>

<style>
  .mini-tree {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    line-height: 1.3;
  }

  .mini-tree__root,
  .mini-tree__folder,
  .mini-tree__empty {
    color: var(--role-muted);
  }

  .mini-tree__file {
    padding: 1px 0.3rem;
    border: 1px solid transparent;
    border-radius: 3px;
    color: var(--role-text);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .mini-tree__file[data-current] {
    border-color: var(--role-accent);
    background: var(--role-accent-soft);
    color: var(--role-accent);
    font-weight: 700;
  }

  .mini-tree__note {
    margin-inline-start: 0.35rem;
    color: var(--role-muted);
    font-weight: 400;
  }

  .mini-tree__new {
    color: var(--role-positive);
    font-size: 0.6875rem;
  }

  .mini-tree__group[data-new] {
    animation: mini-tree-enter 0.35s ease-out;
  }

  .mini-tree[data-layout="ribbon"] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 2px;
  }

  .mini-tree[data-layout="ribbon"] .mini-tree__group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .mini-tree[data-layout="ribbon"] .mini-tree__group + .mini-tree__group {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--role-rule);
  }

  .mini-tree[data-layout="list"] {
    display: grid;
    row-gap: 1px;
  }

  .mini-tree[data-layout="list"] .mini-tree__group {
    display: grid;
    row-gap: 1px;
  }

  .mini-tree[data-layout="list"] .mini-tree__row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .mini-tree[data-layout="list"] .mini-tree__note {
    margin-inline-start: auto;
  }

  .mini-tree[data-layout="list"] .mini-tree__new {
    margin-inline-start: auto;
  }

  @keyframes mini-tree-enter {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-tree__file {
      transition: none;
    }

    .mini-tree__group[data-new] {
      animation: none;
    }
  }
</style>
