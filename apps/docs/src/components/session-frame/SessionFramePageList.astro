---
import { sessionPageHref } from "../../sessions/pages/links";
import {
  sessionPageFlowLabels,
  sessionPageFlowOrder,
  type SessionPage,
} from "../../sessions/pages/types";

interface Props {
  sessionSlug: string;
  pages: readonly SessionPage[];
  currentPageSlug: string;
  idPrefix: string;
}

const { sessionSlug, pages, currentPageSlug, idPrefix } = Astro.props;
const groups = sessionPageFlowOrder.flatMap((flow) => {
  const members = pages.filter((page) => page.flow === flow);
  return members.length === 0 ? [] : [{ flow, members }];
});
const ordered = groups.flatMap(({ members }) => members);
const currentIndex = ordered.findIndex((page) => page.slug === currentPageSlug);
const routeOf = (page: SessionPage) =>
  page.slug === currentPageSlug
    ? "current"
    : ordered.indexOf(page) < currentIndex
      ? "past"
      : "future";
---

<nav class="session-frame__pages" aria-label="このセッションのページ">
  {
    groups.map(({ flow, members }) => (
      <div class="session-frame__group">
        <p class="session-frame__group-title" id={`${idPrefix}-${flow}`}>
          {sessionPageFlowLabels[flow]}
        </p>
        <ol aria-labelledby={`${idPrefix}-${flow}`}>
          {members.map((page) => (
            <li>
              <a
                href={sessionPageHref(sessionSlug, page.slug)}
                aria-current={page.slug === currentPageSlug ? "page" : undefined}
                data-route={routeOf(page)}
              >
                {page.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</nav>
