---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatMinutes,
  sessionPageEntries,
} from "../../sessions/pages/links";
import { sessionNavigationItems } from "../../sessions/navigation";
import { splitPageRole, type SessionPage } from "../../sessions/pages/types";
import "../../styles/sessions.css";
import "../../styles/code-playground.css";
import "../../styles/session-layout.css";
import "../../styles/theme-roles.css";
import "../../styles/session-frame.css";
import SessionFramePageList from "./SessionFramePageList.astro";

interface Props {
  sessionSlug: string;
  pages: readonly SessionPage[];
  pageSlug: string;
  description?: string;
  fullWidth?: boolean;
}

const { sessionSlug, pages, pageSlug, description, fullWidth = false } = Astro.props;
const entries = sessionPageEntries(sessionSlug, pages);
const entry = entries.find(({ page }) => page.slug === pageSlug);
if (entry === undefined) {
  throw new Error(`Unknown page "${pageSlug}" in session ${sessionSlug}`);
}
const { page, previous, next, later, position } = entry;
const sessionTitle =
  sessionNavigationItems.find(({ slug }) => slug === sessionSlug)?.title ?? "";
const hasGuardExercise = page.kind === "exercise" || page.slug === "peer-review";
const role = splitPageRole(page.role);
const sequence = sessionSlug === "final" ? "Final" : `S${sessionSlug.slice(0, 2)}`;
const isOtherSession = (href: string) => !href.startsWith(`/sessions/${sessionSlug}/`);
const previousLabel = previous !== undefined && isOtherSession(previous.href) ? "前の Session" : "前のページ";
const nextLabel = next !== undefined && isOtherSession(next.href) ? "次の Session" : "次のページ";
const sameKind = pages.filter(({ kind }) => (kind === "advanced") === (page.kind === "advanced"));
const progress = `${((sameKind.indexOf(page) + 1) / sameKind.length) * 100}%`;
---

<BaseLayout
  title={`${page.title} | ${sessionTitle} | FP with TypeScript`}
  description={description}
>
  <script is:inline slot="head">
    (() => {
      const root = document.documentElement;
      root.dataset.contentPending = "";
      const reveal = () => delete root.dataset.contentPending;
      setTimeout(reveal, 3000);
      document.addEventListener("DOMContentLoaded", () => {
        requestAnimationFrame(() => requestAnimationFrame(reveal));
      });
    })();
  </script>
  <div
    class:list={["case-file", "case-file--session", "session-frame", { "session-frame--wide": fullWidth }]}
    data-session={sessionSlug}
    data-guard-page={hasGuardExercise ? "true" : "false"}
  >
    <header class="session-frame__bar">
      <a class="session-frame__home" href="/">ホーム</a>
      <a class="session-frame__all" href="/sessions/">全セッション</a>
      <span class="session-frame__sequence" title={sessionTitle}>{sequence}</span>
      <h1 class="session-frame__title">{page.title}</h1>
      <p class="session-frame__position">
        <strong>{position}</strong>
        <span class="session-frame__minutes">目安 {formatMinutes(page.minutes)}</span>
      </p>
      <details class="session-frame__menu">
        <summary>ページ一覧</summary>
        <div class="session-frame__menu-content">
          <SessionFramePageList
            sessionSlug={sessionSlug}
            pages={pages}
            currentPageSlug={pageSlug}
            idPrefix="menu"
          />
        </div>
      </details>
    </header>

    <div class="session-frame__body">
      <aside class="session-frame__sidebar">
        <SessionFramePageList
          sessionSlug={sessionSlug}
          pages={pages}
          currentPageSlug={pageSlug}
          idPrefix="side"
        />
      </aside>
      <main class="session-frame__main">
        <p class="session-frame__role"><strong>{role.label}</strong>: {role.text}</p>
        <article class="session-frame__content case-file__content">
          <slot />
        </article>
      </main>
    </div>

    <nav class="session-frame__footer" aria-label="前後のページ">
      <span class="session-frame__progress" aria-hidden="true">
        <span class="session-frame__progress-fill" style={`width: ${progress}`}></span>
      </span>
      {
        previous === undefined ? (
          <span class="session-frame__link-slot"></span>
        ) : (
          <a
            class="session-frame__link session-frame__link--previous"
            rel="prev"
            href={previous.href}
            aria-label={`${previousLabel}: ${previous.title}`}
            title={previous.title}
          >
            <kbd aria-hidden="true">←</kbd>
            <span class="session-frame__link-arrow" aria-hidden="true">←</span>
            <span class="session-frame__link-label">{previousLabel}</span>
          </a>
        )
      }
      <div class="session-frame__center">
        {
          later === undefined ? null : (
            <a class="session-frame__later" data-session-later href={later.href}>
              あとで読む: 発展 {later.count}ページ
            </a>
          )
        }
        <span class="session-frame__key-hint">キーボードの ← → でも移動できます</span>
      </div>
      {
        next === undefined ? (
          <span class="session-frame__link-slot"></span>
        ) : (
          <a
            class="session-frame__link session-frame__link--next"
            rel="next"
            href={next.href}
            aria-label={`${nextLabel}: ${next.title}`}
            title={next.title}
          >
            <span class="session-frame__link-label">{nextLabel}</span>
            <span class="session-frame__link-arrow" aria-hidden="true">→</span>
            <kbd aria-hidden="true">→</kbd>
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<script>
  import {
    installPageKeyNavigation,
    pageKeyScope,
    type PageKeyScope,
  } from "../../sessions/pages/page-key-navigation";

  installPageKeyNavigation(document, (direction) => {
    const rel = direction === "previous" ? "prev" : "next";
    const href = document
      .querySelector<HTMLAnchorElement>(`.session-frame__footer a[rel="${rel}"]`)
      ?.getAttribute("href");
    if (href) location.assign(href);
  });

  const keyHints: Record<PageKeyScope, string> = {
    page: "キーボードの ← → でも移動できます",
    step: "いま ← → はこの図のコマ送りです",
    text: "いま ← → ではページを移動しません",
  };
  const keyHint = document.querySelector<HTMLElement>(".session-frame__key-hint");
  const showKeyHint = (target: EventTarget | null) => {
    if (keyHint === null) return;
    keyHint.textContent = keyHints[pageKeyScope(target instanceof Element ? target : null)];
  };
  document.addEventListener("focusin", (event) => showKeyHint(event.target));
  document.addEventListener("focusout", (event) => showKeyHint(event.relatedTarget));

  const sidebar = document.querySelector<HTMLElement>(".session-frame__sidebar");
  const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
  if (sidebar && current && sidebar.clientHeight > 0) {
    const above = current.getBoundingClientRect().top - sidebar.getBoundingClientRect().top;
    const below = current.getBoundingClientRect().bottom - sidebar.getBoundingClientRect().bottom;
    if (above < 0) sidebar.scrollTo({ top: sidebar.scrollTop + above, behavior: "instant" });
    else if (below > 0) sidebar.scrollTo({ top: sidebar.scrollTop + below, behavior: "instant" });
  }
</script>
