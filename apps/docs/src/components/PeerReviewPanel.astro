---
import type { PeerReview } from "../sessions/catalog";

type Props = Readonly<{
  peerReview: PeerReview;
  promisesHref: string;
}>;

const { peerReview, promisesHref } = Astro.props;
const headcount = peerReview.pickCount === 2 ? "1〜2名" : "1名";
---

<section class="peer-review-panel">
  <h3>班内相互レビュー（{peerReview.minutes}分・{headcount}）</h3>
  <p><a href={promisesHref}>進行上の約束事を確認する</a></p>
  <ol>
    {peerReview.questions.map((question) => <li>{question}</li>)}
  </ol>
</section>
