---
import { stages, type StageId } from "../sessions/overview-map";
import StepControls from "./stepper/StepControls.astro";

const stageScenes: Readonly<Record<StageId, number>> = {
  entry: 2,
  read: 3,
  decide: 4,
  save: 5,
  failure: 6,
};

const frames = [
  {
    caption: "獣医師が画面で「診察を開始する」を押します。どの予約を、どの獣医師が担当するかが、サーバーへ届きます。",
    alt: "獣医師の画面から下向きの矢印が伸び、入口の段へ向かっています。5つの段は、上から入口、読み取り、業務の判断、保存、失敗の返し方です。",
  },
  {
    caption: "入口は、届いた値を受け取ります。値の形を確かめてから次の段へ渡すのが、この段の仕事です。",
    alt: "5つの段のうち、一番上の入口を強調しています。",
  },
  {
    caption: "診察を始めてよいかを判断するために、対象の予約をデータベースから読みます。",
    alt: "5つの段のうち、上から2番目の読み取りを強調しています。",
  },
  {
    caption: "読んだ予約の状態を見て、この操作をしてよいかを決めます。来院済みの予約は、診察を始められます。",
    alt: "5つの段のうち、上から3番目の業務の判断を強調しています。",
  },
  {
    caption: "決まった結果をデータベースに残します。予約の今の状態と、誰が何をしたかの記録（監査記録）の2つです。",
    alt: "5つの段のうち、上から4番目の保存を強調しています。",
  },
  {
    caption: "途中の段で進めないと分かったら、その先の段には進みません。失敗は、その理由が分かる形で画面まで返します。",
    alt: "入口から保存までの4つの段の右側から横へ破線が分かれ、一番下の失敗の返し方の段へつながっています。失敗の返し方の段から、破線の矢印が画面へ向かっています。",
  },
] as const;

const X = 10;
const W = 240;
const H = 34;
const FIRST_Y = 76;
const PITCH = 46;
const MID = X + W / 2;
const FAIL_X = 292;
const TERM_H = 26;
const lastIndex = stages.length - 1;
const mainStages = stages.slice(0, lastIndex);
const mainY = (index: number) => FIRST_Y + index * PITCH;
const termY = mainY(lastIndex - 1) + H + 12;
const failY = termY + TERM_H + 22;
const stageY = (index: number) => (index < lastIndex ? mainY(index) : failY);

const headDown = (x: number, y: number) => `M ${x - 4} ${y - 7} L ${x} ${y} L ${x + 4} ${y - 7} z`;
const headUp = (x: number, y: number) => `M ${x - 4} ${y + 7} L ${x} ${y} L ${x + 4} ${y + 7} z`;
const headLeft = (x: number, y: number) => `M ${x + 7} ${y - 4} L ${x} ${y} L ${x + 7} ${y + 4} z`;
---

<figure class="start-map" data-start-map aria-label="診察を開始する依頼が通る道筋">
  <StepControls />

  <div aria-live="polite">
    <ol class="start-map__frames">
      {frames.map((frame) => (
        <li data-frame data-alt={frame.alt}>
          <p class="start-map__caption">{frame.caption}</p>
        </li>
      ))}
    </ol>
  </div>

  <svg viewBox={`0 0 340 ${failY + H + 12}`} role="img" aria-label={frames[0].alt} data-scene="1" data-map-svg>
    <g class="start-map__box" data-on="1">
      <rect x={X} y="4" width={W} height="40" rx="6"></rect>
      <text x={MID} y="21" text-anchor="middle" font-size="14">獣医師の画面</text>
      <text x={MID} y="37" text-anchor="middle" font-size="13">「診察を開始する」ボタン</text>
    </g>
    <path d={`M ${MID} 44 V ${FIRST_Y - 7}`} class="start-map__line"></path>
    <path d={headDown(MID, FIRST_Y)} class="start-map__head"></path>
    <g class="start-map__layer" data-scenes="1">
      <text x={MID + 10} y="57" font-size="13" class="start-map__note">サーバーへ届く値</text>
      <text x={MID + 10} y="71" font-size="13" class="start-map__note">予約・担当獣医師</text>
    </g>
    {mainStages.map((_, i) => (
      <>
        <path d={`M ${MID} ${mainY(i) + H} V ${i + 1 < lastIndex ? mainY(i + 1) - 7 : termY - 7}`} class="start-map__line"></path>
        <path d={headDown(MID, i + 1 < lastIndex ? mainY(i + 1) : termY)} class="start-map__head"></path>
      </>
    ))}
    <g class="start-map__box" data-on="6">
      <rect x={X + 40} y={termY} width={W - 80} height={TERM_H} rx="15"></rect>
      <text x={MID} y={termY + 18} text-anchor="middle" font-size="14">画面へ結果を返す</text>
    </g>
    {stages.map((stage, i) => (
      <g class:list={["start-map__box", { "start-map__box--fail": stage.id === "failure" }]} data-on={String(stageScenes[stage.id])}>
        <rect x={X} y={stageY(i)} width={W} height={H} rx="6"></rect>
        <text x={X + 12} y={stageY(i) + 23} font-size="15">{stage.label}</text>
      </g>
    ))}
    <g class="start-map__layer start-map__fail" data-scenes="6">
      {mainStages.map((_, i) => (
        <path d={`M ${X + W} ${stageY(i) + H / 2} H ${FAIL_X}`}></path>
      ))}
      <path d={`M ${FAIL_X} ${stageY(0) + H / 2} V ${failY + H / 2} H ${X + W + 7}`}></path>
      <path d={headLeft(X + W, stageY(lastIndex) + H / 2)} class="start-map__fail-head"></path>
      <path d={`M ${MID} ${failY} V ${termY + TERM_H + 7}`}></path>
      <path d={headUp(MID, termY + TERM_H)} class="start-map__fail-head"></path>
      <text x={FAIL_X + 6} y={stageY(2) + H / 2 + 5} font-size="14">失敗</text>
    </g>
  </svg>
</figure>

<script>
  import { mountStepper } from "./stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-start-map]").forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>("[data-map-svg]");
    const alts = [...root.querySelectorAll<HTMLElement>("[data-frame]")].map((panel) => panel.dataset.alt ?? "");
    mountStepper({
      root,
      onStep: (step) => {
        if (!svg) return;
        svg.dataset.scene = String(step + 1);
        svg.setAttribute("aria-label", alts[step] ?? "");
      },
    });
  });
</script>

<style>
  .start-map {
    min-width: 0;
    max-width: 100%;
    margin: 1rem 0;
  }

  .start-map__caption {
    margin: 0;
    font-weight: 700;
    line-height: 1.7;
  }

  .start-map svg {
    display: block;
    width: auto;
    max-width: 100%;
    height: clamp(21rem, 48vh, 28rem);
    margin: 0.5rem auto 0;
  }

  .start-map__frames {
    margin: 0.75rem 0 0;
    padding-inline-start: 1.5rem;
  }

  .start-map__frames > li {
    min-width: 0;
  }

  .start-map__frames > li + li {
    margin-top: 0.5rem;
  }

  .start-map svg[data-scene="1"] .start-map__box[data-on~="1"],
  .start-map svg[data-scene="2"] .start-map__box[data-on~="2"],
  .start-map svg[data-scene="3"] .start-map__box[data-on~="3"],
  .start-map svg[data-scene="4"] .start-map__box[data-on~="4"],
  .start-map svg[data-scene="5"] .start-map__box[data-on~="5"],
  .start-map svg[data-scene="6"] .start-map__box[data-on~="6"] {
    --box-fill: color-mix(in srgb, var(--role-accent) 22%, var(--role-surface));
    --box-stroke: var(--role-accent);
    --box-ink: var(--role-text);
    --box-width: 2.5;
  }

  .start-map__box[data-on] {
    --box-fill: var(--role-surface);
    --box-stroke: var(--role-border);
    --box-ink: var(--role-muted);
    --box-width: 1.5;
  }

  .start-map svg .start-map__box rect {
    fill: var(--box-fill);
    stroke: var(--box-stroke);
    stroke-width: var(--box-width);
  }

  .start-map svg .start-map__box text {
    fill: var(--box-ink);
  }

  .start-map svg .start-map__box--fail rect {
    stroke-dasharray: 5 3;
  }

  .start-map__line {
    fill: none;
    stroke: var(--role-border);
    stroke-width: 1.5;
  }

  .start-map__head {
    fill: var(--role-border);
  }

  .start-map__note {
    fill: var(--role-text);
    font-weight: 700;
  }

  .start-map__layer {
    opacity: 0;
  }

  .start-map svg[data-scene="1"] [data-scenes~="1"],
  .start-map svg[data-scene="6"] [data-scenes~="6"] {
    opacity: 1;
  }

  .start-map__fail path {
    fill: none;
    stroke: var(--role-negative);
    stroke-width: 2;
    stroke-dasharray: 5 3;
  }

  .start-map__fail .start-map__fail-head {
    fill: var(--role-negative);
    stroke: none;
  }

  .start-map__fail text {
    fill: var(--role-negative);
    font-weight: 700;
  }

  .start-map[data-ready] .start-map__frames {
    display: grid;
    padding-inline-start: 0;
    list-style: none;
  }

  .start-map[data-ready] .start-map__frames > li {
    grid-area: 1 / 1;
    margin: 0;
  }

  .start-map[data-ready] .start-map__frames > li[hidden] {
    display: block;
    visibility: hidden;
  }

  .start-map[data-ready] .start-map__layer,
  .start-map[data-ready] .start-map__box rect,
  .start-map[data-ready] .start-map__box text {
    transition: opacity 0.4s, fill 0.4s, stroke 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .start-map[data-ready] * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
