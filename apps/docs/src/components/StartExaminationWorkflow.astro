---
type Focus =
  | "overview"
  | "state"
  | "identifiers"
  | "boundary"
  | "errors"
  | "effects";

type Props = Readonly<{
  focus: Focus;
}>;

type StepId =
  | "http-input"
  | "typed-input"
  | "load"
  | "business-decision"
  | "domain-event"
  | "save";

const steps: readonly Readonly<{
  id: StepId;
  label: string;
  detail: string;
}>[] = [
  {
    id: "http-input",
    label: "HTTP入力",
    detail: "文字列の予約IDと獣医師ID",
  },
  {
    id: "typed-input",
    label: "型付き入力",
    detail: "AppointmentIdとVeterinarianId",
  },
  {
    id: "load",
    label: "Resolver",
    detail: "予約を取得する",
  },
  {
    id: "business-decision",
    label: "ドメインロジック",
    detail: "受付済みなら診察を開始する",
  },
  {
    id: "domain-event",
    label: "出力イベント",
    detail: "ExaminationStarted",
  },
  {
    id: "save",
    label: "Store",
    detail: "状態とイベントを記録する",
  },
] as const;

const highlightedByFocus = {
  overview: steps.map(({ id }) => id),
  state: ["business-decision"],
  identifiers: ["typed-input"],
  boundary: ["http-input", "typed-input"],
  errors: ["load", "business-decision"],
  effects: ["load", "domain-event", "save"],
} as const satisfies Readonly<Record<Focus, readonly StepId[]>>;

const { focus } = Astro.props;
const highlighted = new Set<StepId>(highlightedByFocus[focus]);
---

<div class="start-workflow">
  <ol class="start-workflow__steps">
    {
      steps.map((step) => {
        const isHighlighted = highlighted.has(step.id);
        return (
          <li
            class:list={["start-workflow__step", { "start-workflow__step--highlighted": isHighlighted }]}
            data-workflow-step={step.id}
            data-highlighted={isHighlighted ? "true" : undefined}
          >
            {isHighlighted ? <span class="sr-only">今回の対象: </span> : null}
            <strong>{step.label}</strong>
            <span>{step.detail}</span>
          </li>
        );
      })
    }
  </ol>
  <p class="start-workflow__boundary-note">
    ResolverとStoreは外部I/Oを担当し、ドメインロジックには取得済みの値を渡します。
  </p>
</div>
