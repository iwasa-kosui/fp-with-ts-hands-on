---
import { arm, dog, ink, legs, monitor, person, shadow } from "./clinic-art";

const scenes = [
  {
    key: "reception",
    title: "受付",
    label: "受付のカウンターで、受付担当者が飼い主と犬を迎えている。PC の画面には来院済みと表示されている",
    text: "飼い主が Mugi を連れて来院します。受付担当者が Mugi の来院を確かめ、「受付する」を押します。予約は「来院済み」になります。",
  },
  {
    key: "exam",
    title: "診察室",
    label: "診察室で、獣医師が診察台の犬を診ながら PC を操作している。PC の画面には診察中と表示されている",
    text: "獣医師が「診察を開始する」を押します。予約は「診察中」になります。診察を終えた獣医師が「診察結果を記録する」を押すと、予約は「会計待ち」になります。",
  },
  {
    key: "payment",
    title: "会計",
    label: "会計カウンターで、会計担当が飼い主から支払いを受けている。PC の画面には会計済みと表示されている",
    text: "会計担当が飼い主から4,800円を受け取り、「会計を記録する」を押します。予約は「会計済み」になります。",
  },
] as const;
