          <path d="M180 118 L190 134 L200 118Z" fill="#fff" stroke-width="2"/>
          <Fragment set:html={arm(166, 132, 150, 146, "#12dbb1", "#d9a37c")} />
          <Fragment set:html={arm(214, 132, 238, 146, "#12dbb1", "#d9a37c")} />
          <rect x="214" y="146" width="22" height="5" rx="2" fill="#fff" stroke-width="2"/>

          <rect x="-2" y="150" width="364" height="12" fill="#ffd21b"/>
