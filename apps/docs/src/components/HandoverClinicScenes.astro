          <Fragment set:html={arm(206, 140, 238, 157, "#fff", "#f6c9a0")} />
        </g>
      </svg>
      <h4>{scenes[1].title}</h4>
      <p>{scenes[1].text}</p>
    </li>

    <li class="hcs__arrow" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="32" height="32">
        <polygon points="2,11 17,11 17,4 30,16 17,28 17,21 2,21" fill="#ffd21b" stroke={ink} stroke-width="2.5" stroke-linejoin="round"/>
      </svg>
    </li>

    <li class="hcs__scene">
      <svg class="hcs__art" viewBox="0 0 360 260" role="img" aria-label={scenes[2].label}>
        <g stroke={ink} stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
          <rect width="360" height="172" fill="#fff8ce" stroke="none"/>
          <rect y="172" width="360" height="88" fill="#f0d5a0" stroke="none"/>
          <path d="M0 172H360" />
          <path d="M0 200H360M0 232H360" stroke="#d9b87c" stroke-width="2"/>

          <rect x="16" y="24" width="76" height="56" rx="4" fill="#c98a3f"/>
          <rect x="22" y="30" width="64" height="44" fill="#f0d5a0" stroke-width="2"/>
