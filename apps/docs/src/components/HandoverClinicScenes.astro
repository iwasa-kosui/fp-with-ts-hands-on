          <Fragment set:html={arm(40, 178, 32, 218, "#ff4f93", "#f6c9a0")} />
          <Fragment set:html={arm(80, 178, 100, 208, "#ff4f93", "#f6c9a0")} />
          <Fragment set:html={dog(200, 254)} />
          <path d="M100 208 Q165 186 230 214" fill="none" stroke-width="2.5"/>
        </g>
      </svg>
      <h4>{scenes[0].title}</h4>
      <p>{scenes[0].text}</p>
    </li>

    <li class="hcs__arrow" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="32" height="32">
