          <Fragment set:html={arm(54, 178, 46, 218, "#ff4f93", "#f6c9a0")} />
          <Fragment set:html={arm(96, 178, 112, 150, "#ff4f93", "#f6c9a0")} />
          <Fragment set:html={dog(176, 254)} />
        </g>
      </svg>
      <h4>{scenes[2].title}</h4>
      <p>{scenes[2].text}</p>
    </li>
  </ol>
  <figcaption>受付、診察室、会計の担当者は、同じ予約を同じシステムの画面で順に更新します。</figcaption>
</figure>

<style is:inline>
  .hcs {
    margin: 1.5rem 0;
    container-type: inline-size;
  }

  .hcs__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hcs__scene {
    min-width: 0;
    max-width: 26rem;
    margin-inline: auto;
    width: 100%;
  }

  .hcs__art {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid #17204d;
    border-radius: 12px;
    background: #fff8ce;
    box-shadow: 0.25rem 0.25rem 0 rgb(34 54 184 / 16%);
  }

  .hcs .hcs__scene h4 {
    margin: 0.75rem 0 0.25rem;
    color: #2236b8;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .hcs .hcs__scene p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .hcs__arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    margin-inline: auto;
  }

  .hcs__arrow svg {
    display: block;
    width: 2rem;
    height: 2rem;
    transform: rotate(90deg);
  }

  .hcs figcaption {
    margin-top: 0.9rem;
    color: #58596d;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  @container (min-width: 520px) {
    .hcs__scene {
      display: grid;
      grid-template-columns: 56% minmax(0, 1fr);
      column-gap: 1rem;
      max-width: none;
    }

    .hcs__scene .hcs__art {
      grid-row: 1 / span 2;
    }

    .hcs .hcs__scene h4 {
      align-self: end;
      margin-top: 0;
    }

    .hcs .hcs__scene p {
      align-self: start;
    }
  }
</style>
