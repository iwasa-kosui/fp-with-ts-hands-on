          <circle cx="178" cy="74" r="8" fill="#6b3f2a"/>
          <path d="M168 122L178 144L188 122Z" fill="#12dbb1" stroke-width="2"/>
          <path d="M178 144V234" stroke-width="2"/>
          <path d="M166 120Q168 150 178 150Q188 150 190 120" fill="none" stroke-width="2.5"/>
          <path d="M178 150Q140 176 99 156" fill="none" stroke-width="2.5"/>
          <Fragment set:html={arm(150, 140, 106, 150, "#fff", "#f6c9a0")} />
