  <ol class="hcs__grid">
    <li class="hcs__scene">
      <svg class="hcs__art" viewBox="0 0 360 260" role="img" aria-label={scenes[0].label}>
        <g stroke={ink} stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
          <rect width="360" height="172" fill="#fff8ce" stroke="none"/>
          <rect y="172" width="360" height="88" fill="#f0d5a0" stroke="none"/>
          <path d="M0 172H360" />
          <path d="M0 200H360M0 232H360" stroke="#d9b87c" stroke-width="2"/>

          <rect x="10" y="62" width="86" height="7" fill="#c98a3f"/>
          <rect x="10" y="104" width="86" height="7" fill="#c98a3f"/>
          <rect x="18" y="40" width="18" height="22" rx="4" fill="#fff"/>
          <rect x="46" y="32" width="30" height="30" rx="4" fill="#ff4f93"/>
          <rect x="18" y="74" width="12" height="30" fill="#2236b8"/>
          <rect x="32" y="70" width="12" height="34" fill="#ff4f93"/>
          <rect x="46" y="76" width="12" height="28" fill="#ffd21b"/>
          <rect x="64" y="84" width="28" height="20" rx="3" fill="#12dbb1"/>

          <rect x="118" y="24" width="56" height="44" rx="6" fill="#fff"/>
          <ellipse cx="146" cy="52" rx="10" ry="8" fill="#ff4f93" stroke-width="2"/>
          <circle cx="134" cy="41" r="4" fill="#ff4f93" stroke-width="2"/>
          <circle cx="142" cy="35" r="4" fill="#ff4f93" stroke-width="2"/>
          <circle cx="150" cy="35" r="4" fill="#ff4f93" stroke-width="2"/>
          <circle cx="158" cy="41" r="4" fill="#ff4f93" stroke-width="2"/>

          <ellipse cx="124" cy="104" rx="7" ry="24" fill="#12dbb1" transform="rotate(-42 124 130)"/>
          <ellipse cx="124" cy="104" rx="7" ry="24" fill="#0fb994" transform="rotate(42 124 130)"/>
          <ellipse cx="124" cy="104" rx="7" ry="24" fill="#12dbb1" transform="rotate(-16 124 130)"/>
          <ellipse cx="124" cy="104" rx="7" ry="24" fill="#0fb994" transform="rotate(16 124 130)"/>
          <ellipse cx="124" cy="104" rx="7" ry="24" fill="#12dbb1"/>
