          <Fragment set:html={arm(172, 132, 158, 146, "#2236b8", "#8c5a3a")} />
          <Fragment set:html={arm(220, 132, 238, 146, "#2236b8", "#8c5a3a")} />
          <rect x="214" y="146" width="22" height="5" rx="2" fill="#fff" stroke-width="2"/>

          <rect x="-2" y="150" width="364" height="12" fill="#fff"/>
