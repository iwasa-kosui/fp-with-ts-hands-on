---
import type { CodeGuide } from "../../code-explorer/code-guide";
import { projectFilesFor } from "../../code-explorer/project-files";
import { sessionWorkspaceFor } from "../../code-explorer/session-workspaces";
import "../../styles/code-playground.css";
import { CodeExplorer } from "./CodeExplorer";

type Props = Readonly<{
  slug: string;
  guides: readonly CodeGuide[];
}>;

const { slug, guides } = Astro.props;
if (guides.length === 0) throw new Error(`Code guides are empty: ${slug}`);
const workspace = sessionWorkspaceFor(slug);
const projectFiles = projectFilesFor(slug);
---

<section class="session-code-overview code-playground" aria-labelledby={`code-overview-${slug}`}>
  <h3 id={`code-overview-${slug}`}>配布コードの設計課題</h3>
  <p>ここでは修正せず、今回の事故につながる設計課題の場所を確認します。</p>
  <div data-code-explorer={workspace.slug} data-code-overview>
    <CodeExplorer
      client:load
      workspace={workspace}
      projectFiles={projectFiles}
      guides={guides}
    />
  </div>
</section>
