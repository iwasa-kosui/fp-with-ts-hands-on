---
import { Code } from "astro:components";
import type { Walkthrough } from "../sessions/boundary-walkthroughs";
import MiniTree from "./mini-tree/MiniTree.astro";

type Props = Readonly<{
  walkthrough: Walkthrough;
  scenarioIds?: readonly string[];
  codeless?: boolean;
}>;

const { walkthrough, scenarioIds, codeless = false } = Astro.props;
const pathOf = (fileId: string) =>
  walkthrough.files.find(({ id }) => id === fileId)?.path ?? "";
const chosenScenarios =
  scenarioIds === undefined
    ? walkthrough.scenarios
    : scenarioIds.map((scenarioId) => {
        const found = walkthrough.scenarios.find(({ id }) => id === scenarioId);
        if (found === undefined) throw new Error(`${scenarioId} is not a walkthrough scenario`);
        return found;
      });
const scenarios = codeless
  ? chosenScenarios.map((scenario) => ({
      ...scenario,
      frames: scenario.frames.filter(({ fileId }) => fileId !== "schemaResult"),
    }))
  : chosenScenarios;
const description = codeless
  ? (walkthrough.descriptionWithoutCode ?? walkthrough.description)
  : walkthrough.description;
const hasChoice = scenarios.length > 1;
const data = JSON.stringify({
  scenarios,
}).replaceAll("<", "\\u003c");
const values = [
  ...new Set(
    scenarios.flatMap(({ frames }) => frames.map(({ value }) => value)),
  ),
];
const valueLabels = [
  ...new Set(
    scenarios.flatMap(({ frames }) => frames.map(({ valueLabel }) => valueLabel)),
  ),
];
const texts = [
  ...new Set(
    scenarios.flatMap(({ frames }) => frames.map(({ text }) => text)),
  ),
];
---

<figure class="boundary-player" data-boundary-player data-step-figure>
  <figcaption>
    <strong>{walkthrough.title}</strong>
    <span>{hasChoice ? "場面を選んで再生します。" : ""}{description}</span>
  </figcaption>
  <script is:inline type="application/json" data-player-data set:html={data} />

  <div class="boundary-player__live" data-player-live>
    {hasChoice ? (
      <div class="boundary-player__scenarios" role="group" aria-label="場面を選ぶ">
        {scenarios.map((scenario) => (
          <button type="button" data-scenario={scenario.id} data-step-scene aria-pressed="false">
            {scenario.label}
            <small>{scenario.note}</small>
          </button>
        ))}
      </div>
    ) : (
      <p class="boundary-player__scenario-label">{scenarios[0]?.label}（{scenarios[0]?.note}）</p>
    )}
    {walkthrough.tree && !codeless && (
      <MiniTree
        tree={walkthrough.tree}
        current={[scenarios[0]?.frames[0]?.fileId ?? ""]}
        class="boundary-player__tree"
      />
    )}
    <div class="boundary-player__controls" data-controls>
      <button type="button" data-action="prev" data-prev>← 前のコマ</button>
      <button type="button" data-action="play" class="boundary-player__play">再生</button>
      <button type="button" data-action="next" data-next>次のコマ →</button>
      <span data-counter></span>
    </div>
    <div class="boundary-player__track" data-track>
      {walkthrough.zones.map((zone, index) => (
        <div class="boundary-player__zone" data-zone-index={index}>{zone}</div>
      ))}
      <span class="boundary-player__token" data-token aria-hidden="true">値</span>
    </div>
    <div class="boundary-player__value" data-status-box>
      <div class="boundary-player__stack">
        <p data-value-label></p>
        {valueLabels.map((label) => (
          <p class="boundary-player__sizer" aria-hidden="true">{label}</p>
        ))}
      </div>
      <div class="boundary-player__stack">
        {values.map((value) => (
          <div class="boundary-player__value-code" data-value-text={value} hidden>
            <Code code={value} lang="ts" wrap />
          </div>
        ))}
      </div>
    </div>
    <div class="boundary-player__text boundary-player__stack">
      <p data-text aria-live="polite"></p>
      {texts.map((text) => (
        <p class="boundary-player__sizer" aria-hidden="true">{text}</p>
      ))}
    </div>
  </div>

  {!codeless && (
    <div class="boundary-player__files">
      {walkthrough.files.map((file) => (
        <figure class="code-block" data-file={file.id}>
          <figcaption><code>{file.path}</code></figcaption>
          <div class="boundary-player__code" data-code-scroll>
            <Code code={file.code} lang="ts" />
          </div>
        </figure>
      ))}
    </div>
  )}

  <div class="boundary-player__static" data-player-static>
    {scenarios.map((scenario) => (
      <section>
        <h4>{scenario.label}（{scenario.note}）</h4>
        <ol>
          {scenario.frames.map((frame) => (
            <li data-status={frame.status}>
              <p>{walkthrough.zones[frame.zone]}: {frame.text}</p>
              {codeless ? (
                <p>{frame.valueLabel}</p>
              ) : (
                <p><code>{pathOf(frame.fileId)}</code>（{frame.valueLabel}）</p>
              )}
              <div class="boundary-player__value-code"><Code code={frame.value} lang="ts" wrap /></div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</figure>

<script is:inline>
  (() => {
  const frameMilliseconds = 3200;

  const setUp = (root) => {
    const { scenarios } = JSON.parse(
      root.querySelector("[data-player-data]")?.textContent ?? "{}",
    );
    const need = (selector) => {
      const element = root.querySelector(selector);
      if (element === null) throw new Error(`${selector} is missing`);
      return element;
    };
    const token = need("[data-token]");
    const track = need("[data-track]");
    const statusBox = need("[data-status-box]");
    const valueLabel = need("[data-value-label]");
    const values = [...root.querySelectorAll("[data-value-text]")];
    const text = need("[data-text]");
    const counter = need("[data-counter]");
    const prev = need('[data-action="prev"]');
    const play = need('[data-action="play"]');
    const next = need('[data-action="next"]');
    const scenarioButtons = [...root.querySelectorAll("[data-scenario]")];
    const files = [...root.querySelectorAll("[data-file]")];
    const miniFiles = [...root.querySelectorAll("[data-mini-file]")];

    const codeOf = new Map(
      files.map((file) => [
        file,
        { code: file.querySelector("pre code"), lines: [...file.querySelectorAll(".line")] },
      ]),
    );

    const fold = () => {
      const mark = document.createElement("span");
      mark.className = "boundary-player__fold";
      mark.setAttribute("aria-hidden", "true");
      mark.textContent = "…";
      return mark;
    };

    const rangeOf = (frame, total, rows) => {
      const count = frame.to - frame.from + 1;
      for (let size = rows; size >= count; size -= 1) {
        const extra = size - count;
        const roomAfter = total - 1 - frame.to;
        const before = Math.min(frame.from, Math.floor(extra * 0.3));
        const after = Math.min(roomAfter, extra - before);
        const first = frame.from - Math.min(frame.from, extra - after);
        const last = frame.to + after;
        const folds = (first > 0 ? 1 : 0) + (last < total - 1 ? 1 : 0);
        if (last - first + 1 + folds <= rows) return [first, last];
      }
      return [frame.from, frame.to];
    };

    const showWindow = ({ code, lines }, frame) => {
      const pre = code?.parentElement;
      if (!code || !pre) return;
      const style = getComputedStyle(pre);
      const lineHeight = Number.parseFloat(style.lineHeight) || Number.parseFloat(style.fontSize) * 1.45;
      const inner = pre.clientHeight - Number.parseFloat(style.paddingTop) - Number.parseFloat(style.paddingBottom);
      const count = frame.to - frame.from + 1;
      for (let rows = Math.max(1, Math.floor(inner / lineHeight)); rows >= count; rows -= 1) {
        const [first, last] = rangeOf(frame, lines.length, rows);
        const items = [
          ...(first > 0 ? [fold()] : []),
          ...lines.slice(first, last + 1),
          ...(last < lines.length - 1 ? [fold()] : []),
        ];
        code.replaceChildren(
          ...items.flatMap((item, index) => (index === 0 ? [item] : [document.createTextNode("\n"), item])),
        );
        if (pre.scrollHeight <= pre.clientHeight + 1) break;
      }
      pre.scrollTop = 0;
    };

    let scenario = scenarios[0];
    let index = 0;
    let timer;

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
      play.textContent = "再生";
    };

    const render = () => {
      const frame = scenario?.frames[index];
      if (scenario === undefined || frame === undefined) return;
      scenarioButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.scenario === scenario?.id));
      });
      track.dataset.status = frame.status;
      track.dataset.zone = String(frame.zone);
      token.style.setProperty("--token-position", `${frame.zone * 33.333 + 16.667}%`);
      token.textContent = frame.status === "stop" ? "✕" : "値";
      statusBox.dataset.status = frame.status;
      valueLabel.textContent = frame.valueLabel;
      for (const value of values) value.hidden = value.dataset.valueText !== frame.value;
      text.textContent = frame.text;
      counter.textContent = `${index + 1} / ${scenario.frames.length}`;
      prev.disabled = index === 0;
      next.disabled = index === scenario.frames.length - 1;

      for (const miniFile of miniFiles) {
        if (miniFile.dataset.miniFile === frame.fileId) {
          miniFile.setAttribute("data-current", "");
          miniFile.setAttribute("aria-current", "true");
        } else {
          miniFile.removeAttribute("data-current");
          miniFile.removeAttribute("aria-current");
        }
      }

      for (const file of files) {
        const active = file.dataset.file === frame.fileId;
        file.hidden = !active;
        const shown = codeOf.get(file);
        if (shown === undefined) continue;
        shown.lines.forEach((line, lineIndex) => {
          line.classList.toggle(
            "is-active",
            active && lineIndex >= frame.from && lineIndex <= frame.to,
          );
        });
        if (active) showWindow(shown, frame);
      }
    };

    const start = () => {
      const lastIndex = (scenario?.frames.length ?? 1) - 1;
      index = index >= lastIndex ? 0 : index + 1;
      render();
      if (index === lastIndex) {
        stop();
        return;
      }
      play.textContent = "一時停止";
      timer = window.setInterval(() => {
        if (scenario && index < scenario.frames.length - 1) {
          index += 1;
          render();
        }
        if (!scenario || index === scenario.frames.length - 1) stop();
      }, frameMilliseconds);
    };

    prev.addEventListener("click", () => {
      stop();
      index = Math.max(0, index - 1);
      render();
    });
    next.addEventListener("click", () => {
      stop();
      index = Math.min((scenario?.frames.length ?? 1) - 1, index + 1);
      render();
    });
    play.addEventListener("click", () => {
      if (timer === undefined) start();
      else stop();
    });
    scenarioButtons.forEach((button) => {
      button.addEventListener("click", () => {
        stop();
        scenario = scenarios.find(({ id }) => id === button.dataset.scenario) ?? scenario;
        index = 0;
        render();
      });
    });

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const applyMotion = () => {
      play.hidden = reducedMotion.matches;
      if (reducedMotion.matches) stop();
    };
    reducedMotion.addEventListener("change", applyMotion);
    applyMotion();
    window.addEventListener("resize", () => render());

    root.dataset.ready = "true";
    render();
  };

  setUp(document.currentScript.previousElementSibling);
  })();
</script>

<style>
  .boundary-player {
    min-width: 0;
    margin: 0.5rem 0;
    padding: 0.75rem 1rem;
    border: 2px solid var(--case-line);
    border-radius: 0.5rem;
    background: var(--case-paper);
  }

  .boundary-player > figcaption {
    display: grid;
    gap: 0.25rem;
    margin-block-end: 0.5rem;
  }

  .boundary-player > figcaption span {
    color: var(--case-muted);
  }

  .boundary-player__live {
    display: none;
  }

  .boundary-player[data-ready] .boundary-player__live {
    display: block;
  }

  .boundary-player[data-ready] .boundary-player__static {
    display: none;
  }

  [hidden] {
    display: none !important;
  }

  button {
    padding: 0.4rem 0.75rem;
    border: 2px solid var(--case-line);
    border-radius: 999px;
    background: var(--case-paper);
    color: var(--case-ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
  }

  [data-scenario] {
    padding-block: 0.25rem;
    border-radius: 0.5rem;
    line-height: 1.4;
    text-align: start;
  }

  [data-scenario] small {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  button:focus-visible {
    outline: 3px solid var(--role-accent, var(--case-blue));
    outline-offset: 2px;
  }

  .boundary-player__controls button {
    min-height: 2.125rem;
    padding: 0.25rem 0.75rem;
    border: 1.5px solid var(--role-accent, var(--case-blue));
    border-radius: 0.5rem;
    background: transparent;
    color: var(--role-accent, var(--case-blue));
    font-size: 0.85rem;
  }

  .boundary-player__controls button:disabled {
    border-color: var(--role-rule, var(--case-divider));
    color: var(--role-muted, var(--case-muted));
    opacity: 1;
  }

  button[aria-pressed="true"] {
    border-color: var(--role-accent, var(--case-blue));
    background: var(--role-accent, var(--case-blue));
    color: var(--role-on-accent, var(--case-paper));
  }

  .boundary-player__controls .boundary-player__play {
    background: var(--role-accent-soft, var(--case-paper));
  }

  .boundary-player__play { min-width: calc(4em + 1.5rem + 4px); }

  .boundary-player__controls {
    margin-block-start: 0.5rem;
  }

  .boundary-player__live :global(.boundary-player__tree) {
    margin-block-start: 0.5rem;
  }

  .boundary-player__scenarios,
  .boundary-player__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .boundary-player__scenario-label {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .boundary-player__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block-start: 0.5rem;
    border: 2px solid var(--case-line);
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .boundary-player__zone {
    min-height: 4.25rem;
    padding: 0.25rem 0.5rem 2.375rem;
    background: var(--case-paper);
    font-size: 0.875rem;
    font-weight: 700;
    text-align: center;
  }

  [data-zone-index="0"] {
    background: var(--case-cream);
  }

  [data-zone-index="1"] {
    border-inline: 6px solid var(--case-line);
  }

  [data-zone="0"] [data-zone-index="0"],
  [data-zone="1"] [data-zone-index="1"],
  [data-zone="2"] [data-zone-index="2"] {
    background: var(--case-yellow);
  }

  .boundary-player__token {
    position: absolute;
    bottom: 0.375rem;
    left: var(--token-position, 16.667%);
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 2px solid var(--case-line);
    border-radius: 50%;
    background: var(--case-paper);
    font-size: 0.875rem;
    font-weight: 700;
    transform: translateX(-50%);
  }

  [data-status="pass"] .boundary-player__token {
    border-color: var(--case-highlight);
    background: var(--case-highlight);
    color: var(--case-paper);
  }

  [data-status="stop"] .boundary-player__token,
  [data-status="danger"] .boundary-player__token {
    border-color: var(--case-pink);
    background: var(--case-pink);
    color: var(--case-paper);
  }

  .boundary-player__value {
    margin-block-start: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--case-divider);
    border-radius: 0.375rem;
  }

  .boundary-player__value[data-status="pass"] {
    border-color: var(--case-highlight);
  }

  .boundary-player__value[data-status="stop"],
  .boundary-player__value[data-status="danger"] {
    border-color: var(--case-pink);
  }

  .boundary-player__value p {
    margin: 0;
    color: var(--case-muted);
    font-size: 0.875rem;
  }

  .boundary-player__value-code {
    margin-block-start: 0.25rem;
  }

  .boundary-player__stack {
    display: grid;
  }

  .boundary-player__stack > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .boundary-player__stack > .boundary-player__value-code[hidden] {
    display: block !important;
    visibility: hidden;
  }

  .boundary-player__sizer {
    visibility: hidden;
  }

  .boundary-player__value-code :global(pre) {
    margin: 0;
    padding: 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .boundary-player__value-code :global(code) {
    overflow-wrap: anywhere;
  }

  .boundary-player__text {
    margin: 0.5rem 0 0;
  }

  .boundary-player__text p {
    margin: 0;
    font-weight: 700;
  }

  .boundary-player__controls span {
    color: var(--case-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .boundary-player__files {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    margin-block-start: 0.75rem;
  }

  .boundary-player__files figure {
    min-width: 0;
    margin: 0;
  }

  .boundary-player[data-ready] .boundary-player__code :global(pre) {
    max-height: 22rem;
    overflow: auto;
  }

  .boundary-player[data-ready] .boundary-player__code :global(:is(pre, code, .line)) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .boundary-player__code :global(.line) {
    display: inline-block;
    min-width: 100%;
  }

  .boundary-player__code :global(.boundary-player__fold) {
    display: inline-block;
    min-width: 100%;
    opacity: 0.6;
  }

  .boundary-player__code :global(.line.is-active) {
    background: color-mix(in srgb, var(--case-blue) 28%, transparent);
    box-shadow: inset 4px 0 0 var(--case-blue);
  }

  .boundary-player__static {
    margin-block-start: 1rem;
  }

  .boundary-player__static h4 {
    margin-block: 1rem 0.25rem;
  }

  .boundary-player__static p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .boundary-player__static li {
    margin-block-end: 0.75rem;
  }

  @media (max-height: 844px) {
    .boundary-player {
      margin-block: 0.25rem;
      padding: 0.5rem 0.75rem;
    }

    .boundary-player__value {
      padding-block: 0.25rem;
    }

    .boundary-player__value-code :global(pre) {
      padding: 0.125rem 0.5rem;
    }
  }

  @media (max-height: 700px) {
    [data-scenario] small {
      display: none;
    }

    [data-scenario] {
      line-height: 1.25;
    }

    .boundary-player__value p {
      line-height: 1.3;
    }

    .boundary-player__value-code {
      margin-block-start: 0.125rem;
    }

    .boundary-player__text p {
      line-height: 1.4;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .boundary-player__token {
      transition:
        left 0.7s ease-in-out,
        background-color 0.3s,
        border-color 0.3s;
    }

    [data-status="stop"] .boundary-player__token {
      animation: boundary-player-reject 0.4s ease-in-out;
    }

    .boundary-player__code :global(.line) {
      transition: background-color 0.25s;
    }

    .boundary-player__zone {
      transition: background-color 0.3s;
    }

    @keyframes boundary-player-reject {
      25% {
        transform: translateX(calc(-50% - 0.375rem));
      }

      75% {
        transform: translateX(calc(-50% + 0.375rem));
      }
    }
  }
</style>
