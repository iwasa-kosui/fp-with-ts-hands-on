---
import { Code } from "astro:components";
import routesSource from "../../../../examples/session-00/src/adaptor/primary/web/routes.ts?raw";
import startExaminationSource from "../../../../examples/session-00/src/useCase/startExamination.ts?raw";
import repositorySource from "../../../../examples/session-00/src/adaptor/secondary/sqlite/appointmentRepository.ts?raw";
import appointmentSource from "../../../../examples/session-00/src/domain/appointment/appointment.ts?raw";
import StepControls from "./stepper/StepControls.astro";

const appointmentId = "11111111-1111-4111-8111-111111111111";
const veterinarianId = "44444444-4444-4444-8444-444444444444";

const fail = (message: string): never => {
  throw new Error(`HandoverExamMock: ${message}`);
};

const dedent = (lines: string[]): string[] => {
  const indents = lines.filter((line) => line.trim() !== "").map((line) => line.length - line.trimStart().length);
  const common = indents.length === 0 ? 0 : Math.min(...indents);
  return lines.map((line) => line.slice(common));
};

const findLine = (lines: string[], text: string, from = 0): number => {
  const found = lines.findIndex((line, index) => index >= from && line.trim().startsWith(text));
  return found === -1 ? fail(`ソースに「${text}」が見つかりません`) : found;
};

const blockEnd = (lines: string[], start: number): number => {
  const indent = lines[start].length - lines[start].trimStart().length;
  const end = lines.findIndex(
    (line, index) => index > start && line.length - line.trimStart().length === indent && line.trimStart().startsWith("}"),
  );
  return end === -1 ? fail(`「${lines[start].trim()}」の閉じ括弧が見つかりません`) : end;
};

const routeLines = routesSource.split("\n");
const routeStart = findLine(routeLines, 'app.post("/appointments/:appointmentId/start-examination"');
const routeEnd = blockEnd(routeLines, routeStart);
const routeCode = dedent(routeLines.slice(routeStart, routeEnd + 1));

const useCaseLines = startExaminationSource.split("\n");
const useCaseStart = findLine(useCaseLines, "const current = repository.find(");
const useCaseEnd = blockEnd(useCaseLines, findLine(useCaseLines, "repository.appendAudit({"));
const useCaseCode = dedent(useCaseLines.slice(useCaseStart, useCaseEnd + 1));

const highlight = (file: string, lines: string[], text: string, multiline: boolean): string => {
  const start = findLine(lines, text);
  const end = multiline ? blockEnd(lines, start) : start;
  return `${file}:${start + 1}:${end + 1}`;
};

const cut = (source: string, startText: string, mode: "block" | "line" | "end"): string => {
  const lines = source.split("\n");
  const start = findLine(lines, startText);
  const end = mode === "block" ? blockEnd(lines, start) : mode === "line" ? start : lines.length - 1;
  return dedent(lines.slice(start, end + 1)).join("\n").trimEnd();
};

const part = (source: string, anchorText: string, fromText: string, toText: string): string => {
  const lines = source.split("\n");
  const anchor = findLine(lines, anchorText);
  const start = findLine(lines, fromText, anchor);
  const end = findLine(lines, toText, start);
  return dedent(lines.slice(start, end + 1)).join("\n").trimEnd();
};

const routeFile = "adaptor/primary/web/routes.ts";
const useCaseFile = "useCase/startExamination.ts";
const repositoryFile = "adaptor/secondary/sqlite/appointmentRepository.ts";
const appointmentFile = "domain/appointment/appointment.ts";

const updatedSummary = `updated: { status: "in-examination", amount: 4800, ... }`;

const layerLabels = [
  { id: "entry", name: "入口", path: "adaptor/primary/web" },
  { id: "useCase", name: "手順", path: "useCase" },
  { id: "domain", name: "決まり", path: "domain" },
  { id: "db", name: "DB", path: "adaptor/secondary/sqlite" },
] as const;

const steps = [
  {
    text: "会計が終わった Mugi の予約です。画面の「会計済み」と「Paid」、データベースの <code>paid</code> は、どれも同じ状態の表記です。獣医師は別の予約のつもりで、この画面を開いています。",
    file: "",
    highlight: undefined,
    impl: undefined,
    values: undefined,
    warn: undefined,
    empty: "まだサーバーは動いていません",
    layers: [],
  },
  {
    text: "獣医師が「診察を開始する」を押します。入口は、どの予約かを示す ID を受け取り、担当の獣医師の ID と合わせて次の手順へ渡します。受け取るのは ID だけなので、サーバーはまだ予約の状態を知りません。",
    file: "route",
    highlight: highlight("route", routeCode, "startExamination(repository)({", true),
    impl: undefined,
    values: {
      input: `{
  appointmentId: "${appointmentId}",
  veterinarianId: "${veterinarianId}",
}`,
      output: undefined,
    },
    warn: undefined,
    empty: undefined,
    layers: ["entry"],
  },
  {
    text: "サーバーは、データベースから Mugi の予約を読みます。読んだ状態は <code>paid</code> です。ここでサーバーは、この予約が会計済みだと分かります。コードの <code>repository</code> は、データベースを読み書きする部品です。",
    file: "use-case",
    highlight: highlight("use-case", useCaseCode, "const current = repository.find(input.appointmentId);", false),
    impl: {
      file: repositoryFile,
      code: part(repositorySource, "find: (appointmentId) => {", ".where(sql", "return row === undefined"),
    },
    values: {
      input: `appointmentId: "${appointmentId}"`,
      output: `current: { petName: "Mugi", status: "paid", amount: 4800, ... }`,
    },
    warn: undefined,
    empty: undefined,
    layers: ["useCase", "db"],
  },
  {
    text: "本来はここで止めるべきです。しかし <code>updateStatus</code> は、受け取った値で <code>status</code> を上書きするだけで、今の状態を見ません。ほかの行にも、状態を確かめる処理はありません。",
    file: "use-case",
    highlight: highlight("use-case", useCaseCode, "const updated = updateStatus(", true),
    impl: {
      file: appointmentFile,
      code: cut(appointmentSource, "export const updateStatus", "end"),
    },
    values: {
      input: `current: { status: "paid", ... }
status: "in-examination"`,
      output: `updated: { status: "in-examination",
  amount: 4800, ... }`,
    },
    warn: "状態を確かめる行がない",
    empty: undefined,
    layers: ["useCase", "domain"],
  },
  {
    text: "データベースの予約を、新しい内容で上書きします。<code>paid</code> は <code>in-examination</code> に変わります。<code>amount</code> と <code>paidAt</code> は残ったままなので、会計が済んだ予約が診察中になりました。",
    file: "use-case",
    highlight: highlight("use-case", useCaseCode, "repository.save(updated);", false),
    impl: {
      file: repositoryFile,
      code: part(repositorySource, "const save = (appointment: Appointment): void => {", ".values(row)", ".run();"),
    },
    values: { input: updatedSummary, output: undefined },
    warn: undefined,
    empty: undefined,
    layers: ["useCase", "db"],
  },
  {
    text: "監査記録に、診察を開始した操作を1行追加します。<code>payload</code> には予約全体が入るので、調査に要らない飼い主の氏名、メールアドレス、電話番号も残ります。これが課題2です。",
    file: "use-case",
    highlight: highlight("use-case", useCaseCode, "repository.appendAudit({", true),
    impl: {
      file: repositoryFile,
      code: part(repositorySource, "const appendAudit = (", "db.insert(auditLogsTable)", "})"),
    },
    values: {
      input: `{ eventName: "examination.started", occurredAt, appointment: updated, ... }`,
      output: undefined,
    },
    warn: undefined,
    empty: undefined,
    layers: ["useCase", "db"],
  },
  {
    text: "サーバーが画面を開き直させ、表示は「診察中」に変わります。受付はこの画面を見て会計前の来院だと判断し、会計担当が飼い主へ同じ4,800円をもう一度請求しました。これが課題1です。",
    file: "",
    highlight: undefined,
    impl: undefined,
    values: undefined,
    warn: undefined,
    empty: "どのファイルにも、会計済みの予約を止める行はありませんでした",
    layers: [],
  },
] as const;

const staticFrames = [
  { key: "before", label: "押す前", badge: "会計済み", kind: "Paid" },
  { key: "after", label: "押した後", badge: "診察中", kind: "InExamination" },
] as const;

const actions = [
  { label: "受付する", kind: "primary" },
  { label: "診察を開始する", kind: "start" },
  { label: "診察結果を記録する", kind: "primary" },
  { label: "会計を記録する", kind: "primary" },
] as const;

const auditSeed = [
  "appointment.seeded",
  "appointment.checked-in",
  "examination.started",
  "examination.result-recorded",
  "payment.recorded",
] as const;

const payloadLines = [
  { code: 'petName: "Mugi"', pii: false },
  { code: 'status: "in-examination"', pii: false },
  { code: 'ownerName: "Owner A"', pii: true },
  { code: 'ownerEmail: "owner@example.test"', pii: true },
  { code: 'ownerPhone: "090-0000-0000"', pii: true },
] as const;

const highlights = JSON.stringify(steps.map((step) => step.highlight ?? ""));
const files = JSON.stringify(steps.map((step) => step.file));
const layers = JSON.stringify(steps.map((step) => step.layers));
---

<figure class="hem" data-exam-mock data-highlights={highlights} data-files={files} data-layers={layers}>
  <div class="hem__player" data-player>
    <StepControls />

    <div aria-live="polite">
      <ol class="hem__frames">
        {steps.map((step) => <li data-frame><p class="hem__caption" set:html={step.text} /></li>)}
      </ol>
    </div>

    <div class="hem__grid">
      <section class="hem__col hem__col--screen" aria-label="画面">
        <h5 class="hem__col-title">画面</h5>
        <div class="hem__screen" data-screen>
          <section class="hem__card">
            <div class="hem__heading">
              <h6 class="hem__pet">Mugi</h6>
              <span class="hem__badge" data-switch-at="6" data-text-before="会計済み" data-text-after="診察中">会計済み</span>
            </div>
            <dl class="hem__state">
              <dt>状態</dt>
              <dd data-switch-at="6" data-text-before="Paid" data-text-after="InExamination">Paid</dd>
            </dl>
            <div class="hem__actions" aria-label="予約操作">
              {
                actions.map((action) =>
                  action.kind === "start" ? (
                    <button class="hem__action hem__action--primary hem__start" type="button" data-start>
                      <span>{action.label}</span>
                    </button>
                  ) : (
                    <span class="hem__action hem__action--primary">
                      <span>{action.label}</span>
                    </span>
                  ),
                )
              }
            </div>
          </section>
          <svg class="hem__cursor" data-cursor viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path d="M3 2 L3 19 L8 14.5 L11.5 22 L14.5 20.6 L11 13.2 L18 13 Z" stroke-width="1.8" stroke-linejoin="round"></path>
          </svg>
        </div>
      </section>

      <section class="hem__col hem__col--code">
        <h5 class="hem__col-title">コード（光っている札が、いま動いている場所）</h5>
        <ul class="hem__layers" aria-label="処理がいまどこにいるか">
          {
            layerLabels.map((layer) => (
              <li class="hem__layer" data-layer={layer.id}>
                <span class="hem__layer-name">{layer.name}</span>
                <span class="hem__layer-path">{layer.path}</span>
              </li>
            ))
          }
        </ul>
        <div class="hem__files" data-files-pane role="region" aria-label="コード">
          {
            steps.map((step, index) =>
              step.empty === undefined ? null : (
                <p class="hem__empty" data-empty-at={index} hidden>{step.empty}</p>
              ),
            )
          }
          <figure class="code-block hem__block" data-code-file="route">
            <figcaption>{routeFile}</figcaption>
            <Code code={routeCode.join("\n")} lang="ts" />
          </figure>
          <figure class="code-block hem__block" data-code-file="use-case" hidden>
            <figcaption>{useCaseFile}</figcaption>
            <Code code={useCaseCode.join("\n")} lang="ts" />
          </figure>
        </div>

        <div class="hem__impl">
          {
            steps.map((step, index) =>
              step.impl === undefined ? null : (
                <figure class="code-block hem__block" data-at={index}>
                  <figcaption>
                    <span>この行が呼ぶ関数</span>
                    <span>{step.impl.file}</span>
                  </figcaption>
                  <Code code={step.impl.code} lang="ts" />
                </figure>
              ),
            )
          }
        </div>

        <div class="hem__values">
          {
            steps.map((step, index) =>
              step.values === undefined ? null : (
                <div class:list={["hem__io", step.values.output === undefined && "hem__io--single"]} data-at={index}>
                  <div class="hem__io-cell">
                    <p class="hem__label">入力</p>
                    <Code code={step.values.input} lang="ts" />
                    {step.warn === undefined ? null : <p class="hem__warn">{step.warn}</p>}
                  </div>
                  {
                    step.values.output === undefined ? null : (
                      <Fragment>
                        <svg class="hem__flow" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true">
                          <polygon points="2,11 16,11 16,3 30,16 16,29 16,21 2,21" stroke-width="2" stroke-linejoin="round"></polygon>
                        </svg>
                        <div class="hem__io-cell">
                          <p class="hem__label">出力</p>
                          <Code code={step.values.output} lang="ts" />
                        </div>
                      </Fragment>
                    )
                  }
                </div>
              ),
            )
          }
        </div>
      </section>

      <section class="hem__col hem__col--db" aria-label="データベース">
        <h5 class="hem__col-title">データベース</h5>
        <div class="hem__table">
          <h6>現在の予約内容</h6>
          <ul class="hem__lines">
            <li data-until="4" data-focus-at="2" data-slot="1"><Code code={'status: "paid"'} lang="ts" inline /></li>
            <li data-from="4" data-flash-at="4" data-slot="1"><Code code={'status: "in-examination"'} lang="ts" inline /></li>
            <li><Code code="amount: 4800" lang="ts" inline /></li>
            <li><Code code={'paidAt: "2026-08-30T07:10:00.000Z"'} lang="ts" inline /></li>
            <li data-until="4" data-slot="4"><Code code="examinationStartedAt: 1回目の時刻" lang="ts" inline /></li>
            <li data-from="4" data-flash-at="4" data-slot="4"><Code code="examinationStartedAt: 押した時刻" lang="ts" inline /></li>
          </ul>
        </div>
        <div class="hem__table">
          <h6>監査記録</h6>
          <ul class="hem__lines">
            {
              auditSeed.map((name) => (
                <li data-fold-from="5"><Code code={`"${name}"`} lang="ts" inline /></li>
              ))
            }
            <li class="hem__fold-note" data-show-from="5">前の5行は省略</li>
            <li class="hem__new" data-show-from="5" data-flash-at="5"><Code code={'"examination.started"'} lang="ts" inline /></li>
            <li class="hem__fold-note hem__payload-label" data-show-from="5">payload</li>
            {
              payloadLines.map((line) => (
                <li class:list={["hem__nested", line.pii && "hem__pii"]} data-show-from="5" data-flash-at="5">
                  <Code code={line.code} lang="ts" inline />
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </div>

  <div class="hem__static">
    <div class="hem__frames-static">
      {
        staticFrames.map((frame) => (
          <div class="hem__frame">
            <p class="hem__frame-label">{frame.label}</p>
            <section class="hem__card">
              <div class="hem__heading">
                <h6 class="hem__pet">Mugi</h6>
                <span class:list={["hem__badge", frame.key === "after" && "is-after"]}>{frame.badge}</span>
              </div>
              <dl class="hem__state">
                <dt>状態</dt>
                <dd>{frame.kind}</dd>
              </dl>
              <div class="hem__actions" aria-label="予約操作">
                {
                  actions.map((action) => (
                    <span class="hem__action hem__action--primary">
                      <span>{action.label}</span>
                    </span>
                  ))
                }
              </div>
            </section>
            <div class="hem__table">
              <h6>現在の予約内容</h6>
              <ul class="hem__lines">
                <li>
                  <Code code={frame.key === "after" ? 'status: "paid" → "in-examination"' : 'status: "paid"'} lang="ts" inline />
                </li>
                <li><Code code="amount: 4800" lang="ts" inline /></li>
                <li><Code code={'paidAt: "2026-08-30T07:10:00.000Z"'} lang="ts" inline /></li>
                <li><Code code={frame.key === "after" ? "examinationStartedAt: 押した時刻" : "examinationStartedAt: 1回目の時刻"} lang="ts" inline /></li>
              </ul>
            </div>
            <div class="hem__table">
              <h6>監査記録</h6>
              <ul class="hem__lines">
                {auditSeed.map((name) => <li><Code code={`"${name}"`} lang="ts" inline /></li>)}
                {
                  frame.key === "after" ? (
                    <Fragment>
                      <li class="hem__new"><Code code={'"examination.started"'} lang="ts" inline /></li>
                      {
                        payloadLines.map((line) => (
                          <li class:list={["hem__nested", line.pii && "hem__pii"]}>
                            <Code code={line.code} lang="ts" inline />
                          </li>
                        ))
                      }
                    </Fragment>
                  ) : null
                }
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="hem__static-code">
      <figure class="code-block hem__block">
        <figcaption>{routeFile}</figcaption>
        <Code code={routeCode.join("\n")} lang="ts" />
      </figure>
      <figure class="code-block hem__block">
        <figcaption>{useCaseFile}</figcaption>
        <Code code={useCaseCode.join("\n")} lang="ts" />
      </figure>
    </div>

    <ol class="hem__steps">
      {
        steps.map((step) => (
          <li>
            <p set:html={step.text} />
            {
              step.impl === undefined ? null : (
                <Fragment>
                  <p class="hem__label">この行が呼ぶ関数</p>
                  <figure class="code-block hem__block">
                    <figcaption>{step.impl.file}</figcaption>
                    <Code code={step.impl.code} lang="ts" />
                  </figure>
                </Fragment>
              )
            }
            {
              step.values === undefined ? null : (
                <div class:list={["hem__io", step.values.output === undefined && "hem__io--single"]}>
                  <div class="hem__io-cell">
                    <p class="hem__label">入力</p>
                    <Code code={step.values.input} lang="ts" />
                    {step.warn === undefined ? null : <p class="hem__warn">{step.warn}</p>}
                  </div>
                  {
                    step.values.output === undefined ? null : (
                      <Fragment>
                        <svg class="hem__flow" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true">
                          <polygon points="2,11 16,11 16,3 30,16 16,29 16,21 2,21" stroke-width="2" stroke-linejoin="round"></polygon>
                        </svg>
                        <div class="hem__io-cell">
                          <p class="hem__label">出力</p>
                          <Code code={step.values.output} lang="ts" />
                        </div>
                      </Fragment>
                    )
                  }
                </div>
              )
            }
          </li>
        ))
      }
    </ol>
  </div>

  <figcaption class="hem__note">このモックは説明用で、データベースには接続しません。コードは examples/session-00 の実物です。手元で同じ値を見るには<a href="/sessions/00-system-handover/demo-screen/">デモ画面を手元で動かす</a>を開いてください。</figcaption>
</figure>

<script>
  import { mountStepper } from "./stepper/stepper";

  document.querySelectorAll<HTMLElement>("[data-exam-mock]").forEach((root) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const screen = root.querySelector<HTMLElement>("[data-screen]");
    const startButton = root.querySelector<HTMLElement>("[data-player] [data-start]");
    const cursor = root.querySelector<HTMLElement>("[data-cursor]");
    const pane = root.querySelector<HTMLElement>("[data-files-pane]");
    if (!screen || !startButton || !cursor || !pane) return;

    const highlights = JSON.parse(root.dataset.highlights ?? "[]") as string[];
    const files = JSON.parse(root.dataset.files ?? "[]") as string[];
    const layers = JSON.parse(root.dataset.layers ?? "[]") as string[][];
    const player = root.querySelector<HTMLElement>("[data-player]") ?? root;
    const blocks = [...pane.querySelectorAll<HTMLElement>("[data-code-file]")];
    const codeLines = new Map(
      blocks.map((block) => [block.dataset.codeFile ?? "", [...block.querySelectorAll<HTMLElement>(".line")]]),
    );
    let rendered = -1;

    const restartFlash = (element: HTMLElement) => {
      element.classList.remove("is-flash");
      void element.offsetWidth;
      element.classList.add("is-flash");
    };

    const placeCursor = (active: boolean) => {
      const screenBox = screen.getBoundingClientRect();
      const buttonBox = startButton.getBoundingClientRect();
      const x = buttonBox.left - screenBox.left + buttonBox.width * 0.7 - 3;
      const y = buttonBox.top - screenBox.top + buttonBox.height * 0.65 - 2;
      cursor.style.transform = active ? `translate(${x}px, ${y}px)` : `translate(${x + 70}px, ${y - 60}px)`;
      cursor.style.opacity = active ? "1" : "0";
    };

    const showCode = (index: number) => {
      const switched = blocks.find((block) => !block.hidden)?.dataset.codeFile !== files[index];
      blocks.forEach((block) => {
        block.hidden = block.dataset.codeFile !== files[index];
      });
      const scroller = pane.querySelector<HTMLElement>(".hem__block:not([hidden]) pre");
      if (switched) scroller?.scrollTo({ top: 0, behavior: "instant" });
      codeLines.forEach((lines) => lines.forEach((line) => line.classList.remove("is-hl")));
      const [file, from, to] = (highlights[index] ?? "").split(":");
      const lines = codeLines.get(file ?? "");
      const first = lines?.[Number(from) - 1];
      const last = lines?.[Number(to) - 1];
      if (!scroller) return;
      if (!lines || !first || !last) {
        scroller.scrollTo({ top: 0 });
        return;
      }
      lines.slice(Number(from) - 1, Number(to)).forEach((line) => line.classList.add("is-hl"));
      const lineHeight = parseFloat(getComputedStyle(first).minHeight);
      const padding = parseFloat(getComputedStyle(scroller).paddingTop);
      const scrollerTop = scroller.getBoundingClientRect().top;
      const top = first.getBoundingClientRect().top - scrollerTop + scroller.scrollTop - padding;
      const height = last.getBoundingClientRect().bottom - first.getBoundingClientRect().top;
      const view = scroller.clientHeight - 2 * padding;
      const wanted = height > view ? top : top - (view - height) / 2;
      const maxTop = Math.round((scroller.scrollHeight - scroller.clientHeight) / lineHeight) * lineHeight;
      const snapped = Math.min(Math.max(Math.round(wanted / lineHeight) * lineHeight, 0), maxTop);
      scroller.scrollTo({ top: snapped, behavior: "smooth" });
    };

    const render = (index: number) => {
      const changed = index !== rendered;
      rendered = index;

      player.querySelectorAll<HTMLElement>("[data-switch-at]").forEach((element) => {
        const after = index >= Number(element.dataset.switchAt);
        element.textContent = (after ? element.dataset.textAfter : element.dataset.textBefore) ?? "";
        element.classList.toggle("is-after", after);
        if (changed && index === Number(element.dataset.switchAt)) restartFlash(element);
      });
      player.querySelectorAll<HTMLElement>("[data-from]").forEach((element) => {
        element.classList.toggle("is-off", index < Number(element.dataset.from));
      });
      player.querySelectorAll<HTMLElement>("[data-until]").forEach((element) => {
        element.classList.toggle("is-off", index >= Number(element.dataset.until));
      });
      player.querySelectorAll<HTMLElement>("[data-show-from], [data-fold-from]").forEach((element) => {
        const from = Number(element.dataset.showFrom ?? 0);
        const until = Number(element.dataset.foldFrom ?? Number.POSITIVE_INFINITY);
        element.classList.toggle("is-gone", index < from || index >= until);
      });
      player.querySelectorAll<HTMLElement>("[data-empty-at]").forEach((element) => {
        element.hidden = index !== Number(element.dataset.emptyAt);
      });
      player.querySelectorAll<HTMLElement>("[data-layer]").forEach((element) => {
        const lit = layers[index]?.includes(element.dataset.layer ?? "") ?? false;
        element.classList.toggle("is-lit", lit);
        if (lit) element.setAttribute("aria-current", "true");
        else element.removeAttribute("aria-current");
      });
      player.querySelectorAll<HTMLElement>("[data-focus-at]").forEach((element) => {
        element.classList.toggle("is-focus", index === Number(element.dataset.focusAt));
      });
      player.querySelectorAll<HTMLElement>("[data-flash-at]").forEach((element) => {
        if (index !== Number(element.dataset.flashAt)) element.classList.remove("is-flash");
        else if (changed) restartFlash(element);
      });
      player.querySelectorAll<HTMLElement>(".hem__impl > [data-at], .hem__values > [data-at]").forEach((element) => {
        element.classList.toggle("is-off", index !== Number(element.dataset.at));
      });

      startButton.setAttribute("aria-disabled", String(index !== 0));
      startButton.classList.toggle("is-attention", index === 0);
      startButton.classList.toggle("is-pressed", index === 1);
      placeCursor(index === 1);
      showCode(index);
    };

    player.querySelectorAll(".hem__lines code").forEach((code) => code.removeAttribute("tabindex"));
    mountStepper({ root, onStep: render });
    startButton.addEventListener("click", () => {
      if (rendered !== 0) return;
      root.querySelector<HTMLButtonElement>("[data-next]")?.click();
    });
    new ResizeObserver(() => placeCursor(rendered === 1)).observe(screen);
  });
</script>

