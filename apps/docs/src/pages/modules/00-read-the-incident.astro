---
import CommandBlock from "../../components/CommandBlock.astro";
import ModuleLayout from "../../layouts/ModuleLayout.astro";
import { moduleBySlug } from "../../modules/catalog";

const module = moduleBySlug("00-read-the-incident");
if (module === undefined) throw new Error("Unknown module: 00-read-the-incident");
---

<ModuleLayout module={module}>
  <ol slot="toc">
    <li><a href="#requirement">要求を分解する</a></li>
    <li><a href="#exercise">要求をテストから読む</a></li>
    <li><a href="#preparation">次の編集の準備</a></li>
    <li><a href="#review">レビューと振り返り</a></li>
  </ol>

  <section id="requirement">
    <h2>要求を分解する</h2>
    <p>
      キャンセル後の業務対応に必要な情報を整理し、<strong
        >キャンセル理由と再診希望日を残せるようにします</strong
      >。
    </p>
    <p>今回のミッションは、この追加要求を状態ごとに必要な情報へ分解することです。</p>
    <p>
      キャンセル理由と再診希望日は、どの予約にも付ける属性ではありません。<code>Canceled</code>
      という状態にだけ必要なデータです。
    </p>
    <p>
      <strong>守る不変条件:</strong> Canceled は reason を持ち、再診希望はキャンセル時だけに存在します。
    </p>
  </section>

  <section id="exercise">
    <h2>要求をテストから読む</h2>
    <p>
      演習テストを実行し、キャンセル状態の必須情報と終端状態の制約を期待値から読み取ります。
    </p>
    <CommandBlock
      phase="red"
      command="pnpm --filter @fp-with-ts/clinic-example exercise:01"
      expected="キャンセル状態の必須情報と終端状態の制約がテストから読み取れます。"
    />

    <h3>先に読むファイル</h3>
    <dl>
      <dt><code>src/legacy/appointment.ts</code></dt>
      <dd>status だけでは、キャンセルされた理由も次の対応も分からない点を読みます。</dd>
      <dt><code>exercises/01-state-modeling.test.ts</code></dt>
      <dd>キャンセル状態の必須情報と終端状態の制約を期待値から読みます。</dd>
    </dl>
  </section>

  <section id="preparation">
    <h2>次の編集の準備</h2>
    <p>
      この実装には worked example が含まれるため <code>exercise:01</code>
      は成功します。当日の starter 差分では、同じ command
      を失敗するテストとして使い、状態とデータを同時に閉じる準備をします。
    </p>

    <h3>次に読む編集対象</h3>
    <p>
      <code>src/clinic/appointment.ts</code> にある <code>Appointment</code> と <code
        >Appointment.cancelWithReason</code
      > を読みます。
    </p>

    <h3>使う技法: 状態別の要求整理</h3>
    <p>
      全予約への optional field
      追加を避け、情報が属する状態を先に決めるため、状態別に要求を整理します。
    </p>
    <p>
      <strong>この技法の限界:</strong>
      このモジュールでは遷移関数を変更せず、次の状態モデリングに必要な整理までを行います。
    </p>
  </section>

  <section id="review">
    <h2>レビューと振り返り</h2>
    <h3>レビュー観点</h3>
    <p>状態ごとの必須プロパティを表にし、optional で逃がしていないか確認します。</p>

    <h3>完了条件</h3>
    <p>次の要求を状態の種類ごとの情報として言い換えられることです。</p>

    <CommandBlock
      phase="green"
      command="pnpm --filter @fp-with-ts/clinic-example test"
      expected="要求整理では実装を変更しないため、通常テストは成功したままです。"
    />

    <h3>業務への転用</h3>
    <p>キャンセル理由と再診希望を Canceled 状態に閉じる次のモデリングへ進めます。</p>

    <h3>振り返り</h3>
    <p>
      キャンセル理由と再診希望日を optional field
      にすると、どの不正な予約を表現できてしまいますか。
    </p>

    <h3>代替進行</h3>
    <p>
      Scheduled と Canceled の必須情報を書き出し、Canceled 以外から reason と再診希望を外します。
    </p>
  </section>
</ModuleLayout>
