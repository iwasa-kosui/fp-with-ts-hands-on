---
import CodeBlock from "../../components/CodeBlock.astro";
import CommandBlock from "../../components/CommandBlock.astro";
import ModuleLayout from "../../layouts/ModuleLayout.astro";
import { moduleBySlug } from "../../modules/catalog";

const module = moduleBySlug("03-result-errors");
if (module === undefined) throw new Error("Unknown module: 03-result-errors");
---

<ModuleLayout module={module}>
  <ol slot="toc">
    <li><a href="#separate-result-responsibilities">要求と結果の責任を分ける</a></li>
    <li><a href="#typed-failures">失敗を値として扱う</a></li>
    <li><a href="#successful-events">成功した変更だけを記録する</a></li>
    <li><a href="#review-result-scope">レビューと適用範囲を確認する</a></li>
  </ol>

  <section>
    <h2 id="separate-result-responsibilities">要求と結果の責任を分ける</h2>
    <p>診察開始の結果を UI と事故調査の両方で扱えるようにします。</p>
    <p>
      <strong>要求:</strong>
      診察開始の失敗理由を UI に表示し、成功した開始だけを追跡したい。
    </p>
    <p>
      UI が必要なのは、呼び出し元で網羅的に分岐できる失敗値です。一方、事故調査で追いたいのは、実際に成功した変更の記録です。両者を同じ値や同じタイミングで扱いません。
    </p>
    <p>
      <strong>守る不変条件:</strong> 失敗は Result の kind で返し、ExaminationStarted
      は成功時だけ記録する。
    </p>
    <p>
      今回のミッションは、呼び出し元が失敗を網羅的に分岐できる値と、成功した変更だけを示す event を別々の責任として実装することです。
    </p>
  </section>

  <section>
    <h2 id="typed-failures">失敗を値として扱う</h2>
    <p>
      失敗を <code>throw</code> や <code>undefined</code>
      に混ぜると、UI はどの表示を選ぶべきか判断できません。<code>StartExaminationError.kind</code>
      を <code>Result</code> の <code>Err</code>
      として返し、呼び出し元が失敗理由を漏れなく分岐できるようにします。
    </p>
    <p>
      入力 schema、予約の存在、現在の状態のどこで止まっても、診察開始は成功していません。これらの失敗経路では予約を保存せず、event も append しません。
    </p>

    <CommandBlock
      phase="red"
      command="pnpm --filter @fp-with-ts/clinic-example exercise:03"
      expected="starter では診察開始の成功と ExaminationStarted の append に関するテストが失敗します。この実装を読む環境では worked example があるため成功します。"
    />

    <h3>先に読むファイル</h3>
    <dl>
      <dt><code>packages/clinic-example/src/clinic/use-cases.ts</code></dt>
      <dd>
        <code>StartExaminationError</code> union、入力 schema、<code>ensureFound</code>、<code
          >ensureCheckedIn</code
        > と、<code>startExaminationUseCase</code> のすべての成功・失敗経路を読みます。
      </dd>
      <dt><code>packages/clinic-example/src/clinic/appointment-repository.ts</code></dt>
      <dd>
        <code>findById</code> と <code>save</code>
        が use case 境界のどの結果で呼ばれるか確認します。
      </dd>
      <dt><code>packages/clinic-example/src/clinic/domain-event-store.ts</code></dt>
      <dd>
        <code>append</code> と <code>all</code>
        を読み、成功した変更記録だけを保存する責務を確認します。
      </dd>
      <dt><code>packages/clinic-example/exercises/03-result-errors.test.ts</code></dt>
      <dd>
        成功した診察開始と <code>ExaminationStarted</code>
        の append に関する期待値を確認します。失敗の分岐は <code>use-cases.ts</code>
        の error union と guard から読みます。
      </dd>
    </dl>

    <h3>編集する場所</h3>
    <dl>
      <dt>
        <code>packages/clinic-example/src/clinic/use-cases.ts</code> — <code
          >startExaminationUseCase</code
        >
      </dt>
      <dd>
        この関数だけを編集し、schema、存在確認、状態確認からの早期 <code>Err</code>
        return を置きます。
      </dd>
    </dl>

    <CodeBlock
      language="typescript"
      label="UIが網羅できる失敗値"
      code={`type StartExaminationError =
  | Readonly<{ kind: "AppointmentNotFound" }>
  | Readonly<{ kind: "InvalidAppointmentState" }>
  | Readonly<{ kind: "ValidationError" }>;

if (checkedIn.kind === "Err") return checkedIn;`}
    />
  </section>

  <section>
    <h2 id="successful-events">成功した変更だけを記録する</h2>
    <p>
      <code>ExaminationStarted</code>
      は成功を説明する記録であり、失敗理由ではありません。予約の保存まで成功した後にだけ event store へ append し、失敗時の store は空のままにします。
    </p>

    <CodeBlock
      language="typescript"
      label="成功後の変更記録"
      code={`input.eventStore.append(ExaminationStarted.create({ /* successful change */ }));`}
    />

    <h3>使う技法: Result と最小の Domain Event</h3>
    <p>
      <code>Result</code>
      は呼び出し元が失敗理由を網羅的に扱うために使い、最小の Domain Event は成功した変更を後から追跡するために使います。
    </p>
    <p>
      <strong>この技法の限界:</strong> 今回は event sourcing、projection、永続イベントストアの設計には広げません。診察開始という一つの成功を記録する範囲に留めます。
    </p>

    <CommandBlock
      phase="green"
      command="pnpm --filter @fp-with-ts/clinic-example exercise:03"
      expected="成功した診察開始を返し、ExaminationStarted を1件 append できて exercise:03 が成功します。"
    />
  </section>

  <section>
    <h2 id="review-result-scope">レビューと適用範囲を確認する</h2>
    <h3>レビュー観点</h3>
    <ul>
      <li>
        <code>StartExaminationError</code> の <code>kind</code>
        を UI が網羅的に分岐できる。
      </li>
      <li>失敗理由が <code>Result.error.kind</code> として呼び出し元へ返る。</li>
      <li>
        schema、存在確認、状態確認の失敗時に <code>repository.save</code> と <code
          >eventStore.append</code
        > が呼ばれない。
      </li>
      <li>成功時だけ <code>ExaminationStarted</code> を記録する。</li>
      <li>event sourcing、projection、永続イベントストアへ広げていない。</li>
    </ul>

    <h3>完了条件</h3>
    <ul>
      <li>UI が分岐できる失敗値と、成功した変更記録を区別できる。</li>
      <li>
        失敗ケースでは event store が空で、成功ケースだけ <code>ExaminationStarted</code>
        があると説明できる。
      </li>
    </ul>

    <h3>業務への転用</h3>
    <p>
      UI は失敗理由を値として表示でき、監査では成功した診察開始だけを後から追えます。
    </p>

    <h3>振り返り</h3>
    <p>
      UI に返す失敗値と、事故調査のために残す成功イベントは、なぜ別の値ですか。
    </p>

    <h3>代替進行</h3>
    <p>
      実装できない場合は、<code>StartExaminationError</code> union と各 guard の <code
        >Err</code
      > return を読み、<code>exercise:03</code> では成功時の <code
        >ExaminationStarted</code
      > append だけを確認します。
    </p>

    <h3>参考資料</h3>
    <p>
      <a href="https://kosui.me/posts/2025/05/06/142842"
        >ドメインイベントを容易に記録する設計</a
      >
    </p>
  </section>
</ModuleLayout>
