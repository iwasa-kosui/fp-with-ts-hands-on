---
import { CodeExplorer } from "../components/code-explorer/CodeExplorer";
import { projectFilesFor } from "../code-explorer/project-files";
import { sessionWorkspaceFor } from "../code-explorer/session-workspaces";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/code-playground.css";
import "../styles/code-explorer-preview.css";

const sessionSlug = "00-onboarding";
const workspace = sessionWorkspaceFor(sessionSlug);
const projectFiles = projectFilesFor(sessionSlug);
---

<BaseLayout
  title="Code Explorer プレビュー | FP with TypeScript"
  description="ブラウザ上で TypeScript の教材コードを編集・実行する実験用プレビュー"
  bodyClass="code-explorer-preview"
>
  <header class="code-explorer-preview__header" aria-label="サイトヘッダー">
    <nav aria-label="サイトナビゲーション">
      <a href="/">← WAN NYAN CLINIC ホームへ</a>
    </nav>
  </header>

  <main class="code-explorer-preview__shell code-playground">
    <section class="code-explorer-preview__intro" aria-labelledby="page-title">
      <p class="code-explorer-preview__eyebrow">Experimental preview</p>
      <h1 id="page-title">Code Explorer を試す</h1>
      <p>
        ファイルを選んでコードを書き換え、実行ボタンで TypeScript のテストを動かせます。選択中のファイルだけを元に戻すこともできます。
      </p>
      <p>
        実行には最新版の Chrome または Edge を推奨します。初回は実行環境と依存パッケージの準備に時間がかかる場合があります。
      </p>
      <aside class="code-explorer-preview__notice" aria-label="プレビューについて">
        <strong>試用前にご確認ください</strong>
        <p>これは Session 00 の開始 snapshot を使う実験用プレビューです。編集内容はこのブラウザ内だけで動作し、保存されません。</p>
      </aside>
    </section>

    <div data-code-explorer={workspace.slug}>
      <CodeExplorer client:load workspace={workspace} projectFiles={projectFiles} />
    </div>
  </main>
</BaseLayout>
