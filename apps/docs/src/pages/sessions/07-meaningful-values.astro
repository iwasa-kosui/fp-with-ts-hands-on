---
import CommandBlock from "../../components/CommandBlock.astro";
import SessionCodePlayground from "../../components/code-explorer/SessionCodePlayground.astro";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";
const session = sessionBySlug("07-meaningful-values");
if (session === undefined) throw new Error("Unknown session: 07-meaningful-values");
---
<SessionLayout session={session}>
  <ol slot="toc"><li><a href="#incident">事故と不変条件</a></li><li><a href="#work">2関数の作業</a></li><li><a href="#code-playground">ブラウザで試す</a></li><li><a href="#technique">技法と限界</a></li><li><a href="#verification">検証</a></li><li><a href="#reflection">振り返り</a></li></ol>
  <section id="incident"><h2>同じ primitive の取り違えを止める</h2><p data-actor="受付スタッフ"><strong>登場人物:</strong> 受付スタッフが Pet ID を Owner ID 欄へ渡し、形式検証を通った別用途の UUID が保存されました。</p><p><strong>事故:</strong> どちらも string なので、schema を通っても用途の違いを失いました。</p><p><strong>守る不変条件:</strong> Owner、Pet、Appointment、Veterinarian の ID を相互に取り違えない。</p></section>
  <section id="work"><h2>値に用途を与える</h2><CommandBlock phase="red" command="pnpm exercise:07" expected="Pet ID を Owner ID として代入でき、unused `@ts-expect-error` になるため失敗します。" /><h3>先に読むファイル</h3><ul><li><code>examples/session-07/exercises/value-meaning.test.ts</code></li><li><code>examples/session-07/src/domain/ownerId.ts</code></li><li><code>examples/session-07/src/domain/petId.ts</code></li></ul><h3>作業範囲（最大2関数）</h3><p><code>OwnerIdSchema</code> と <code>PetIdSchema</code> の定義へ用途別 brand を追加し、既存の parse API から使います。</p></section>
  <SessionCodePlayground slug={session.slug} />
  <section id="technique"><h2>Branded Type で意味を分ける</h2><p><strong>使う技法:</strong> 同じ UUID schema でも用途別 brand を付け、関数の引数で取り違えを検出します。</p><p><strong>この技法の限界:</strong> brand は実行時には消えるため、外部入力検証、参照整合性、値の秘匿性は別に守ります。</p><CommandBlock phase="green" command="pnpm exercise:07" expected="用途の異なる ID を同じ値として扱えなくなります。" /></section>
  <section id="verification"><h2>3つの範囲で確かめる</h2><dl><dt>型で守ること</dt><dd>PetId を OwnerId 引数へ渡す誤りを型検査で検出します。</dd><dt>統合テストで守ること</dt><dd><code>pnpm --filter @fp-with-ts/clinic-session-07 test</code> で UUID と日時の実行時検証を確認します。</dd><dt>人がレビューすること</dt><dd>どの primitive に業務上の別の意味があるか、brand の粒度を確認します。</dd></dl></section>
  <section id="reflection"><h2>振り返り</h2><p>同じ string や number でも取り違えると事故になる値は何ですか。</p><p><a href="/sessions/08-pii-output/">次へ: PII を出力境界で守る</a></p></section>
</SessionLayout>
