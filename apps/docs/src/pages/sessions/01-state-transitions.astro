---
import AppointmentStateDiagram from "../../components/AppointmentStateDiagram.astro";
import CodeGuideCards from "../../components/CodeGuideCards.astro";
import CommandBlock from "../../components/CommandBlock.astro";
import SessionPageNavigation from "../../components/SessionPageNavigation.astro";
// MDX だけで import すると head に xterm.css の <link> が増える
import "../../components/code-explorer/CodeExplorer";
import Prose from "../../sessions/prose/01-state-transitions.mdx";
import type { CodeGuide } from "../../code-explorer/code-guide";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import type { SessionWorkspace } from "../../code-explorer/types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSolutionSnippets } from "../../sessions/solution-snippets";
import type {
  ExerciseSessionSummary,
  SessionSummary,
  TeachingCode,
} from "../../sessions/types";
import "../../styles/code-playground.css";
import "../../styles/sessions.css";
import EpisodeIllustration from "../../components/EpisodeIllustration.astro";

export const session: SessionSummary = {
  slug: "01-state-transitions",
  snapshot: "session-02",
  sequence: "01",
  kind: "exercise",
  title: "予約の状態と遷移をモデル化する",
  durationMinutes: 20,
  timeBreakdown: { brief: 3, teach: 6, exercise: 8, review: 3 },
  adv: { articulate: 2, delegate: 4, verify: 2 },
  peerReview: {
    minutes: 3,
    pickCount: 2,
    questions: [
      "`startExamination` は `CheckedIn` だけを受け取り、会計済み・キャンセル済みを型で拒否しますか。",
      "`recordPayment` は `AwaitingPayment` だけを受け取り、診察結果の記録前には会計できない型ですか。",
    ],
  },
  solutionSnapshot: "session-03",
  solutionPresentation: "excerpt",
  peerReviewPromises: "inline",
  animal: { name: "RABBIT", type: "rabbit", avatar: "🐇" },
  summary: "予約の6状態をDiscriminated Unionで表し、許可されていない状態遷移を型で拒否します。",
  episode: [
    "会計を終えたウサギは帰ったはずなのに、画面の中では診察室へ戻ってきました。",
    "受付画面は止めるどころか、2枚目の請求書まで手際よく用意します。",
    "許可された状態遷移を覚えていたのは人間だけで、コードは何でも通す危ない設計でした。",
  ],
  incident: "診察結果を記録していない予約が会計され、さらに会計済みの来院が診察中へ戻された。",
  exerciseCommand: "pnpm exercise:02",
  exerciseModule: {
    dir: "examples/session-02/src/domain/appointment",
    fileBudget: 1,
    lineBudget: 35,
  },
  delegationPrompt: {
    request:
      "予約状態の変更処理を、業務で許された遷移と各状態に必要な情報がコードから読み取れる形に改善してください。",
    decisions: [
      "どの状態からどの状態への遷移を許可するか",
      "各状態で必須にする情報は何か",
    ],
  },
  steps: [
    {
      id: "s2-narrow-start",
      goal: "会計済み・キャンセル済みの来院で診察を開始するコードを、コンパイルエラーにする。",
      startingFailure: "会計済み・キャンセル済みでも診察を開始できる。",
      targets: ["examples/session-02/src/domain/appointment/transitions.ts"],
      solutions: [{
        path: "examples/session-03/src/domain/appointment/transitions.ts",
        symbol: "startExamination",
        lines: [16, 26],
      }],
    },
    {
      id: "s2-require-cancel-reason",
      goal: "キャンセルには必ず理由を残す。",
      startingFailure: "理由を残さずに予約をキャンセルできる。",
      targets: ["examples/session-02/src/domain/appointment/transitions.ts"],
      solutions: [{
        path: "examples/session-03/src/domain/appointment/transitions.ts",
        symbol: "cancel",
        lines: [47, 60],
      }],
    },
    {
      id: "s2-align-transitions",
      goal: "診察結果の記録前に会計するコードをコンパイルエラーにし、残りの遷移も許可された遷移元だけを受け取る規約にそろえる。",
      startingFailure: "診察結果の記録前や、許可されていない状態から操作できる。",
      targets: ["examples/session-02/src/domain/appointment/transitions.ts"],
      solutions: [{
        path: "examples/session-03/src/domain/appointment/transitions.ts",
        symbol: "checkIn",
        lines: [13, 45],
      }],
    },
  ],
  decisions: [
    {
      invariant: "診察結果の記録前の会計と、許可されていない状態遷移を、型検査で拒否する。",
    },
    {
      invariant: "各状態において必要な情報の抜け漏れを許さない。",
    },
  ],
  finalReferences: [
    "examples/final/src/domain/appointment/appointment.ts",
  ],
};

export const guides = ([
  {
    id: "wide-transition-input",
    title: "current state を受け取る関数が Appointment 全体を受け入れている",
    currentDesign: "current state を型で絞らず、実行時の requireKind と throw に頼っています。completeExamination と recordPayment も同じ形です。",
    futureRisk: "禁止したい状態でも呼び出し側のコードはコンパイルが通り、as で結果を押し通せます。",
    path: "src/domain/appointment/transitions.ts",
    highlights: [
      { startLineNumber: 8, endLineNumber: 17 },
      { startLineNumber: 19, endLineNumber: 26 },
    ],
  },
  {
    id: "optional-cancellation-reason",
    title: "cancel がキャンセル理由なしの呼び出しを受け入れている",
    currentDesign: "cancel の reason が CancellationReason | undefined で、理由がなければ実行時に throw します。",
    futureRisk: "理由を渡さない呼び出しもコンパイルが通り、キャンセル理由の欠落は実行して初めて分かります。",
    path: "src/domain/appointment/transitions.ts",
    highlights: [{ startLineNumber: 51, endLineNumber: 59 }],
  },
] as const) satisfies readonly CodeGuide[];

const teaching: readonly Readonly<{ after: TeachingCode }>[] = [
  {
    after: {
      caption: "kindを持つDiscriminated Union",
      code: `type Appointment =
  | Readonly<{ kind: "Scheduled"; scheduledAt: string }>
  | Readonly<{
      kind: "CheckedIn";
      scheduledAt: string;
      checkedInAt: string;
    }>
  | Readonly<{
      kind: "InExamination";
      scheduledAt: string;
      checkedInAt: string;
      examinationStartedAt: string;
    }>;

const toStatusLabel = (appointment: Appointment): string => {
  switch (appointment.kind) {
    case "Scheduled": return "予約済み";
    case "CheckedIn": return "来院済み";
    case "InExamination": return "診察中";
  }
};`,
    },
  },
  {
    after: {
      sources: ["examples/session-03/src/domain/appointment/transitions.ts"],
      code: `export const startExamination = (
  appointment: CheckedIn,
  veterinarianId: string,
  examinationStartedAt: string,
): InExamination =>
  ({
    ...appointment,
    kind: "InExamination",
    veterinarianId,
    examinationStartedAt,
  }) as const satisfies InExamination;

export const completeExamination = (
  appointment: InExamination,
  input: CompleteExaminationInput,
  examinationCompletedAt: string,
): AwaitingPayment =>
  ({ ...appointment, ...input, kind: "AwaitingPayment", examinationCompletedAt })
    as const satisfies AwaitingPayment;

export const recordPayment = (
  appointment: AwaitingPayment,
  input: RecordPaymentInput,
  paidAt: string,
): Paid =>
  ({ ...appointment, ...input, kind: "Paid", paidAt }) as const satisfies Paid;`,
    },
  },
];

const narrative = {
  noDiscriminantCode: `type Appointment =
  | Readonly<{ scheduledAt: string }>
  | Readonly<{ scheduledAt: string; checkedInAt: string }>
  | Readonly<{
      scheduledAt: string;
      checkedInAt: string;
      examinationStartedAt: string;
    }>;

const toStatusLabel = (appointment: Appointment): string => {
  if ("examinationStartedAt" in appointment) return "診察中";
  if ("checkedInAt" in appointment) return "来院済み";
  return "予約済み";
};`,
  pitfallCode: {
    sources: ["examples/session-02/src/domain/appointment/transitions.ts"],
    code: `export const startExamination = (
  appointment: Appointment,
  veterinarianId: string,
  examinationStartedAt: string,
): Appointment => {
  requireKind(appointment, ["CheckedIn"]);
  return ({ ...appointment, kind: "InExamination", veterinarianId, examinationStartedAt }) as Appointment;
};

declare const paidAppointment: Paid;

// Paid を渡してもコンパイルできる
startExamination(
  paidAppointment,
  "vet-001",
  "2026-08-30T10:00:00+09:00",
);

declare const examining: InExamination;

// 診察結果を記録していなくてもコンパイルできる
recordPayment(
  examining,
  { diagnosis: "皮膚炎", treatment: "軟膏", amount: 4800 },
  "2026-08-30T10:30:00+09:00",
);

declare const checkedIn: CheckedIn;

// キャンセル理由がなくてもコンパイルできる
cancel(
  checkedIn,
  undefined,
  "2026-08-30T09:00:00+09:00",
);`,
  },
} as const;

const exerciseSession: ExerciseSessionSummary = session;
const initialExerciseFailureCount = 5;

export const workspace = ({
  slug: session.slug,
  snapshot: session.snapshot,
  initialFile: "exercises/state-modeling.test.ts",
  description: "current state の要求と作成対象を開始 snapshot で確認します。",
  visibleFiles: [
    "exercises/state-modeling.test.ts",
    "test/transitions.test.ts",
    "test/setup.test.ts",
    "src/domain/appointment/appointment.ts",
    "src/domain/appointment/transitions.ts",
  ],
} as const) satisfies SessionWorkspace;

const projectFiles = projectFilesForSnapshot(session.snapshot);
const solutionSteps = await Promise.all(
  session.steps.map(async (step) => ({
    step,
    presentation: step.solutions[0].presentation ?? "excerpt",
    snippets: await loadSolutionSnippets(step),
  })),
);
const distributedAppointmentSnippets = await loadSolutionSnippets({
  solutions: [
    {
      path: "examples/session-00/src/domain/appointment/appointment.ts",
      symbol: "Appointment",
      lines: [1, 23],
    },
    {
      path: "examples/session-00/src/domain/appointment/appointment.ts",
      symbol: "updateStatus",
      lines: [34, 38],
    },
  ],
});
const distributedAppointmentCode = distributedAppointmentSnippets
  .map(({ code }) => code)
  .join("\n\n");
const javaStateCode = `sealed interface Appointment permits CheckedIn, InExamination {}

record CheckedIn(String appointmentId, String checkedInAt)
    implements Appointment {}

record InExamination(String appointmentId, String checkedInAt, String veterinarianId)
    implements Appointment {}

static InExamination startExamination(CheckedIn appointment, String veterinarianId) {
  return new InExamination(
      appointment.appointmentId(), appointment.checkedInAt(), veterinarianId);
}`;
const rustStateCode = `struct CheckedIn { appointment_id: String, checked_in_at: String }

struct InExamination {
    appointment_id: String,
    checked_in_at: String,
    veterinarian_id: String,
}

enum Appointment {
    CheckedIn(CheckedIn),
    InExamination(InExamination),
}

fn start_examination(appointment: CheckedIn, veterinarian_id: String) -> InExamination {
    InExamination {
        appointment_id: appointment.appointment_id,
        checked_in_at: appointment.checked_in_at,
        veterinarian_id,
    }
}`;
const chapters = [
  { id: "incident", label: "今回つくるもの" },
  { id: "legacy", label: "コードを読み、失敗を再現する" },
  { id: "teach", label: "使う型を知る" },
  { id: "refactor", label: "型で閉じる" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
const commonReviewChecks = [
  "`as` によるキャストが入っていないか全文検索して確認する。",
  "`git diff --stat -- examples/session-02` で今回の snapshot だけを確認する。`git status --short` で想定外の path がないか確認する。",
  "型検査では確認できないことを、テストまたは実行時に確認して記録する。",
] as const;
const reviewCompletionArtifacts = [
  "起きてはいけない状態遷移",
  "Agentへの依頼文",
  "型検査では確認できず、テストまたは実行時に確認すること",
] as const;
const businessReflectionQuestion =
  "自分の業務コードで、今回と同種の問題が起きうる箇所はどこですか。";
const peerReviewPromises = [
  "人ではなく差分を見ます。「この差分は」で話し始め、優劣をつけません。",
  "本人は、実装メモまたはAgentへの依頼文を共有し、どの要求を満たそうとしたか説明します。",
  "同じ課題に対して設計判断が異なる差分を選びます。進行役がいない場合は、参加者で順番を決めます。",
  "複数回行う場合は、全員の差分を少なくとも一度確認できるようにします。",
] as const;
export const promisesHref = "#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/00-system-handover/",
    title: "業務とシステムを引き継ぐ",
  },
  next: {
    href: "/sessions/02-adt-and-exhaustiveness/",
    title: "予約の状態の分岐漏れを型で検出する",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const delegationPrompt = `次の変更を実装してください。

業務背景:
${session.incident}

依頼:
${exerciseSession.delegationPrompt.request}

起きてはいけない状態遷移: [言語化フェーズで書いた1文]

着手前に判断すること:
${exerciseSession.delegationPrompt.decisions.map((decision) => `- ${decision}: [自分の判断を書く]`).join("\n")}

まず配布コードと失敗しているテストを読み、上の判断と変更方針を短く説明してください。説明のあとで実装に進んでください。設計手段は既存コードに合うものを選び、選んだ理由も示してください。

受け入れ条件:
${session.steps.map((step) => `- ${step.goal}`).join("\n")}

変更範囲:
- ${session.exerciseModule.dir}/ のみ
- 最大 ${session.exerciseModule.fileBudget} ファイル・約 ${session.exerciseModule.lineBudget} 行
- 範囲外の変更が必要に見えた場合は、変更せず理由を報告する
- statusLabel.ts は次の Session で扱うため、変更しない
- 型エラーを \`as\` によるキャストで回避しない

検証:
- ${session.exerciseCommand} を実行し、分岐漏れの1個を除くすべての assertion が成功すること

完了時の報告:
- 変更したファイルと判断理由
- 検証コマンドの結果
- 型だけでは守れず、テストまたはレビューに残した点`;
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file case-file--session">
    <header class="case-file__site-header">
      <a href="/"><span class="case-file__brand-mark" aria-hidden="true">🐾</span>WAN NYAN CLINIC</a>
    </header>
    <main>
      <SessionPageNavigation currentSlug={session.slug} chapters={chapters}>
      <section slot="hero" class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <Prose
        components={{ AppointmentStateDiagram, CodeGuideCards, CommandBlock, EpisodeIllustration }}
        session={session}
        guides={guides}
        workspace={workspace}
        projectFiles={projectFiles}
        solutionSteps={solutionSteps}
        teaching={teaching}
        narrative={narrative}
        distributedAppointmentCode={distributedAppointmentCode}
        javaStateCode={javaStateCode}
        rustStateCode={rustStateCode}
        initialExerciseFailureCount={initialExerciseFailureCount}
        delegationPrompt={delegationPrompt}
        commonReviewChecks={commonReviewChecks}
        reviewCompletionArtifacts={reviewCompletionArtifacts}
        businessReflectionQuestion={businessReflectionQuestion}
        peerReviewPromises={peerReviewPromises}
        headcount={headcount}
        promisesHref={promisesHref}
      />
      <nav slot="footer" class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
      </SessionPageNavigation>
    </main>
  </div>
</BaseLayout>
