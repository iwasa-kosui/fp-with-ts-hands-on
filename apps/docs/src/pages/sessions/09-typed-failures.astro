---
import CommandBlock from "../../components/CommandBlock.astro";
import SessionCodePlayground from "../../components/code-explorer/SessionCodePlayground.astro";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";
const session = sessionBySlug("09-typed-failures");
if (session === undefined) throw new Error("Unknown session: 09-typed-failures");
---
<SessionLayout session={session}>
  <ol slot="toc"><li><a href="#incident">事故と不変条件</a></li><li><a href="#work">2関数の作業</a></li><li><a href="#code-playground">ブラウザで試す</a></li><li><a href="#technique">技法と限界</a></li><li><a href="#verification">検証</a></li><li><a href="#reflection">振り返り</a></li></ol>
  <section id="incident"><h2>利用側が扱えない失敗を分ける</h2><p data-actor="画面利用者"><strong>登場人物:</strong> 画面利用者は、予約がない場合と状態が違う場合のどちらでも同じ「失敗」しか表示されません。</p><p><strong>事故:</strong> undefined や例外では、呼び出し側が次の行動を選べません。</p><p><strong>守る不変条件:</strong> 診察開始前に予約の存在と CheckedIn を確認し、失敗理由を区別する。</p></section>
  <section id="work"><h2>失敗理由を2つの guard にする</h2><CommandBlock phase="red" command="pnpm exercise:09" expected="見つからない予約を AppointmentNotFound として返せず失敗します。" /><h3>先に読むファイル</h3><ul><li><code>examples/session-09/exercises/typed-failures.test.ts</code></li><li><code>examples/session-09/src/domain/appointment.ts</code></li></ul><h3>作業範囲（最大2関数）</h3><p><code>ensureFound</code> と <code>ensureCheckedIn</code> の2関数だけを作り、予期可能な失敗を判別可能にします。</p></section>
  <SessionCodePlayground slug={session.slug} />
  <section id="technique"><h2>Result とエラーの判別共用体</h2><p><strong>使う技法:</strong> <code>Result</code> で <code>AppointmentNotFound</code> と <code>InvalidAppointmentState</code> を値として返します。</p><p><strong>この技法の限界:</strong> DB 障害、非同期 port、認可、成功 event の保存までは扱いません。</p><CommandBlock phase="green" command="pnpm exercise:09" expected="未発見と不正状態を呼び出し側が kind で分けられます。" /></section>
  <section id="verification"><h2>3つの範囲で確かめる</h2><dl><dt>型で守ること</dt><dd>呼び出し側へ成功値と既知の失敗 union の処理を要求します。</dd><dt>統合テストで守ること</dt><dd><code>pnpm --filter @fp-with-ts/clinic-session-09 test</code> で入力と PII の既存境界を確認します。</dd><dt>人がレビューすること</dt><dd>どの失敗を利用者へ区別して伝え、どれを運用障害として扱うかを確認します。</dd></dl></section>
  <section id="reflection"><h2>振り返り</h2><p>undefined だけでは利用側が判断できない失敗は何ですか。</p><p><a href="/sessions/10-success-events/">次へ: 成功だけを記録する</a></p></section>
</SessionLayout>
