---
import SessionFrame from "../../components/session-frame/SessionFrame.astro";
import { sessionPages, sessionSlug } from "../../sessions/pages/05-business-events-and-workflows";
import * as content from "../../sessions/pages/05-business-events-and-workflows-content";
import Prose from "../../sessions/prose/05-business-events-and-workflows/index.mdx";

export const navigation = content.navigation;
export const session = content.session;
---

<SessionFrame
  sessionSlug={sessionSlug}
  pages={sessionPages}
  pageSlug=""
  description={session.summary}
>
  <Prose />
  <script is:inline>
    const destinations = new Map([
      ["pipeline", "steps/"],
      ["rop", "railway/"],
      ["io-boundaries", "io-outside/"],
      ["exercise", "exercise/"],
    ]);
    const destination = destinations.get(location.hash.slice(1));
    if (destination) {
      const base = location.pathname.endsWith("/") ? location.pathname : `${location.pathname}/`;
      location.replace(`${base}${destination}`);
    }
  </script>
</SessionFrame>
