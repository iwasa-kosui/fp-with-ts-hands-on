---
import guides from "../../code-explorer/code-guides/final";
import SessionCodeOverview from "../../components/code-explorer/SessionCodeOverview.astro";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { finalAggregateTour, sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("final");
if (session === undefined) throw new Error("Unknown session: final");
---

<SessionLayout session={session}>
  <section id="incident">
    <h2>何が起きたか</h2>
    <p>
      S4 の到達点 <code>examples/session-05</code> は、単一集約の ResultAsync pipeline
      です。最後の5分は講師が、同じ判断が大きな参照実装でどこへ広がるかを案内します。
    </p>
    <p><strong>今回守ること:</strong> 新しい演習を増やさず、今日の局所的な改善と参照実装の距離を3つの差分に絞ります。</p>
  </section>

  <section id="legacy">
    <h2>配布コードを読む</h2>
    <p>
      最初に <code>examples/final/src/useCase/startExaminationUseCase.ts</code>
      を開き、S4 と同じ <code>andThen</code> / <code>andThrough</code> の形を確認します。
    </p>
    <SessionCodeOverview slug={session.slug} guides={guides} />
  </section>

  <section id="review">
    <h2>レビューと持ち帰り</h2>
    <h3>今日の到達点から final までの3差分</h3>
    <ol class="final-differences">
      <li>
        <strong>{finalAggregateTour.label}</strong><br />
        <code>{finalAggregateTour.path}</code> の composition root から、次の7集約を接続する配線を読む。
        <ul>
          {finalAggregateTour.aggregates.map((aggregate) => <li>{aggregate}</li>)}
        </ul>
      </li>
      <li>
        <strong>in-memory → SQLite</strong><br />
        <code>examples/final/src/adaptor/secondary/sqlite/store/appointmentEventStore.ts</code>
        から、状態とイベントを同じ transaction で残す境界を読む。
      </li>
      <li>
        <strong>単体 → 全域検証</strong><br />
        <code>examples/final/src/domain/followUp/collectFollowUpTargets.ts</code>
        から、複数候補を all-or-nothing で検証する流れを読む。
      </li>
    </ol>
    <p>
      自習では、今日守れなかった残りのうち1つを選び、上の対応ファイルでどの境界へ移ったかを追ってください。
    </p>
  </section>
</SessionLayout>
