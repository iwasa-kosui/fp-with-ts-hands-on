---
import CodeBlock from "../../components/CodeBlock.astro";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("final");
if (session === undefined) throw new Error("Unknown session: final");
---

<SessionLayout session={session}>
  <ol slot="toc">
    <li><a href="#final-structure">一概念一ファイルの構成を確認する</a></li>
    <li><a href="#final-flow">診察開始の流れを追う</a></li>
    <li><a href="#final-follow-up">電話フォローとPII保護を確認する</a></li>
    <li><a href="#final-verify">完成例を検証する</a></li>
  </ol>

  <section>
    <h2 id="final-structure">一概念一ファイルの構成を確認する</h2>
    <p>
      <code>examples/final</code> は、各セッションで扱った事故への対策を統合した Kamae
      の完成例です。domain、application、ports、infrastructure、shared
      の責務を分け、一概念一ファイルで配置しています。
    </p>
    <p>
      <code>examples/final/src/domain/appointment.ts</code> は、Zod schema、状態の判別共用体、純粋な遷移関数を
      <code>Appointment</code> companion にまとめています。用途別 ID
      は個別ファイルへ分け、同じ文字列を誤って取り違えないようにします。
    </p>

    <CodeBlock
      language="typescript"
      label="Appointment companion"
      code={`export const Appointment = {
  schema: AppointmentSchema,
  book: (input: BookAppointmentInput): Scheduled => ({ kind: "Scheduled", ...input }),
  checkIn: (scheduled: Scheduled, checkedInAt: Timestamp): CheckedIn => ({
    ...scheduled,
    kind: "CheckedIn",
    checkedInAt,
  }),
  startExamination: (
    checkedIn: CheckedIn,
    veterinarianId: VeterinarianId,
    examinationStartedAt: Timestamp,
  ): InExamination => ({
    ...checkedIn,
    kind: "InExamination",
    veterinarianId,
    examinationStartedAt,
  }),
  recordPayment: (
    examining: InExamination,
    input: RecordPaymentInput,
    paidAt: Timestamp,
  ): Paid => ({ ...examining, ...input, kind: "Paid", paidAt }),
  cancelWithReason: (
    appointment: Scheduled | CheckedIn,
    reason: CancelReason,
    canceledAt: Timestamp,
    followUpRequestedAt?: Timestamp,
  ): Canceled => ({
    kind: "Canceled",
    appointmentId: appointment.appointmentId,
    petId: appointment.petId,
    ownerId: appointment.ownerId,
    scheduledAt: appointment.scheduledAt,
    reason,
    canceledAt,
    ...(followUpRequestedAt === undefined ? {} : { followUpRequestedAt }),
  }),
  isPaid: (appointment: Appointment) => appointment.kind === "Paid",
  isTerminal: (appointment: Appointment) =>
    appointment.kind === "Paid" || appointment.kind === "Canceled",
} as const;`}
    />
  </section>

  <section>
    <h2 id="final-flow">診察開始の流れを追う</h2>
    <p>
      <code>startExaminationUseCase</code> は外部の <code>unknown</code> を Zod
      で parse し、neverthrow の Result pipeline へ渡します。予約の取得と状態確認の後、<code
        >Appointment.startExamination</code
      > で純粋に次の状態と event を組み立てます。
    </p>
    <p>
      最後に <code>store.save(state, events)</code>
      を一度だけ呼び、状態と event を atomic save します。保存が失敗した場合は <code
        >isErr()</code
      > で扱える失敗値を返し、片方だけを保存しません。
    </p>

    <CodeBlock
      language="typescript"
      label="startExaminationUseCase"
      code={`export const startExaminationUseCase = (
  resolver: AppointmentResolver,
  store: AppointmentStore,
) =>
  (raw: unknown): Result<InExamination, StartExaminationError> =>
    StartExaminationInput.parse(raw).andThen((input) =>
      resolver
        .findById(input.appointmentId)
        .andThen(ensureFound(input.appointmentId))
        .andThen(ensureCheckedIn)
        .map((checkedIn) => transition(input, checkedIn))
        .andThrough(({ state, event }) => store.save(state, [event]))
        .map(({ state }) => state),
    );`}
    />
  </section>

  <section>
    <h2 id="final-follow-up">電話フォローとPII保護を確認する</h2>
    <p>
      <code>collectFollowUpTargets</code> は候補全体を parse
      してから、検査結果と予約の pet ID を検証します。不正な候補が一件でもあれば <code
        >isErr()</code
      > になるため、途中まで作った target や event を返しません。
    </p>
    <p>
      検証済みの候補は <code>filter</code>、<code>reduce</code>、<code>map</code>
      で宣言的に処理します。飼い主の電話番号は <code>Sensitive</code>
      のまま返し、JSON、文字列、Node.js inspect では <code>[REDACTED]</code>
      だけを表示して PII を守ります。
    </p>

    <CodeBlock
      language="typescript"
      label="collectFollowUpTargets"
      code={`export const collectFollowUpTargets = (
  raw: unknown,
): Result<ReadonlyArray<FollowUpTarget>, CollectFollowUpTargetsError> =>
  FollowUpCandidates.parse(raw)
    .andThen(collectValidatedCandidates)
    .map((candidates) =>
      candidates
        .filter(FollowUpCandidate.needsPhoneCall)
        .reduce<ReadonlyArray<FollowUpCandidate>>(
          (unique, candidate) =>
            unique.some(
              ({ appointment }) =>
                appointment.appointmentId === candidate.appointment.appointmentId,
            )
              ? unique
              : [...unique, candidate],
          [],
        )
        .map(FollowUpTarget.fromCandidate),
    );`}
    />
  </section>

  <section>
    <h2 id="final-verify">完成例を検証する</h2>
    <p>
      型検査で状態、用途別 ID、境界の契約を確認し、テストで Result、atomic save、PII
      保護、電話フォローの振る舞いを確認します。
    </p>
    <CodeBlock
      language="shell"
      label="final package の検証"
      code={`pnpm --filter @fp-with-ts/clinic-final typecheck
pnpm --filter @fp-with-ts/clinic-final test`}
    />
    <p>
      完成例は一度に導入する雛形ではありません。各セッションで事故と要求に対応して選んだ設計が、同じ package
      の中でどのようにつながるかを確認するための参照実装です。
    </p>
  </section>
</SessionLayout>
