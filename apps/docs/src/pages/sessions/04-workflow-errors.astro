const isErrUseCaseCode = `import { err, ok, type Result } from "neverthrow";

import {
  startExamination as transitionToInExamination,
} from "../domain/appointment/index.js";

const startExamination =
  (deps: Dependencies) =>
  (input: StartExaminationInput): Result<
    InExamination,
    StartExaminationError
  > => {
    const found = ensureAppointmentFound(
      deps.resolver.resolveById(input.appointmentId),
      input.appointmentId,
    );
    if (found.isErr()) {
      return err(found.error);
    }

    const checkedIn = ensureCheckedIn(found.value);
    if (checkedIn.isErr()) {
      return err(checkedIn.error);
    }

    const next = transitionToInExamination(
      checkedIn.value,
      input.veterinarianId,
      input.examinationStartedAt,
    );
    deps.store.save(next);
    return ok(next);
  };`;

const teaching: readonly TeachingSnippets[] = [
  {
    example: {
      caption: "診察開始を isErr で書いた説明用の例（配布コードにはありません）",
