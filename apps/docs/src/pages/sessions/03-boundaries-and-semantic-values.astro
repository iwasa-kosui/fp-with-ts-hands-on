---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/03-boundaries-and-semantic-values";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("03-boundaries-and-semantic-values");
if (session === undefined) {
  throw new Error("Unknown session: 03-boundaries-and-semantic-values");
}
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement: "外部から届く JSON を検証し、用途の異なる ID を区別する。飼い主の氏名・メールアドレス・電話番号はログから守る。",
      currentRisk: "検査機関から届く値をそのまま信頼すると、同じ string で表された ID を取り違え、予約全体のログから個人情報を漏らせる。",
      design: "input 欄は、unknown から受け取る Zod の入力境界、用途別の Branded Type、既定で伏せる Sensitive で実装する。",
      limitation: "Sensitive を unwrap した文字列と、永続化から復元した ID が正しいかは、別の使用箇所で対策する必要がある。",
      nextQuestion: "診察開始を続けられない条件を、呼び出し側が業務判断できる形でどう返すか。",
      legacy: "raw: any、手書きの境界型、平文の string で持つ連絡先を読み、入力・ID・出力の3つの境界を分けます。",
      reviewFocus: "unwrap を呼ぶ場所を限定し、JSON.stringify と util.inspect のどちらでも個人情報が伏せられるか。",
      fallback: "現在の2ステップを順に開き、まず不正な JSON を Err として返します。次に連絡先3項目を Sensitive にします。相互レビューの約束事はS2のリンク先を確認します。",
    }}
  />
</SessionLayout>
