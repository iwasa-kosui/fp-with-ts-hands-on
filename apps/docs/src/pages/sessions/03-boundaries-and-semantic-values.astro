---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/03-boundaries-and-semantic-values";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("03-boundaries-and-semantic-values");
if (session === undefined) {
  throw new Error("Unknown session: 03-boundaries-and-semantic-values");
}

const teaching = [
  {
    name: "schema による境界検証と Result",
    definition:
      "外から届く unknown を schema へ通し、通った値だけをドメイン型として扱います。通らなければ、失敗を戻り値の Result で返します。",
    before: {
      sources: ["examples/session-03/src/boundary/examResult.ts"],
      code: `export const parseExamResult = (raw: any): Result<ExamResult> =>
  ok({
    examId: raw.examId,
    petId: raw.petId,
    items: raw.items ?? [],
    needsFollowUp: !!raw.needsFollowUp,
  });`,
    },
    after: {
      sources: ["examples/session-04/src/boundary/examResult.ts"],
      code: `export const ExamResultSchema = z.object({
  examId: ExamId.schema,
  petId: PetId.schema,
  items: z.array(z.string().min(1)).readonly(),
  needsFollowUp: z.boolean().default(false),
}).readonly();

export type ExamResult = z.infer<typeof ExamResultSchema>;

export const parseExamResult = schemaResult(ExamResultSchema);`,
    },
    why: "before は raw を any で受けるため、検証を1行も書かなくても型検査が通ります。after は unknown を schema へ通すので、検証を書かない限り値を取り出せません。これで「外部入力は、境界で検証してからドメイン型になる」を型で守れます。parse は失敗しうる処理なので、失敗は例外ではなく戻り値の Result に現します。この回は失敗が戻り値に出るところまでを扱い、Result の分岐と andThen による合成は S4 で扱います。",
  },
  {
    name: "用途別 Branded Type",
    definition:
      "同じ文字列形式でも用途の違う ID を、別の型として扱います。zod の brand を付けると、互いに代入できない型ができます。",
    before: {
      sources: ["examples/session-03/src/domain/appointment/appointment.ts"],
      code: `export type Scheduled = Readonly<{
  kind: "Scheduled";
  appointmentId: string;
  petId: string;
  ownerId: string;
  scheduledAt: string;
  reason: string;
}>;`,
    },
    after: {
      sources: [
        "examples/session-04/src/domain/ids/petId.ts",
        "examples/session-04/src/domain/appointment/appointment.ts",
      ],
      code: `// domain/ids/petId.ts
const schema = z.string().uuid().brand<"PetId">();

export type PetId = z.infer<typeof schema>;
export const PetId = { schema, parse: schema.parse } as const;

// domain/appointment/appointment.ts
export type Scheduled = Readonly<{
  kind: "Scheduled";
  appointmentId: AppointmentId;
  petId: PetId;
  ownerId: OwnerId;
  scheduledAt: string;
  reason: string;
}>;`,
    },
    why: "before では appointmentId も petId も ownerId も string です。3つを取り違えて代入しても、引数の順番を入れ替えても、コンパイルは通ります。今回の事故そのものである ID の取り違えを、型は何も止めません。after では3つが別の型になり、互いに代入できなくなるため、取り違えはコンパイルエラーになります。ここで区別しているのは値の形式ではなく用途です。3つとも実体は同じ UUID の文字列なので、z.string().uuid() の検査をいくら重ねても区別はできません。",
  },
  {
    name: "Sensitive による既定のマスク",
    definition:
      "個人情報を包む型です。toJSON と toString を [REDACTED] にし、中身を取り出せるのは unwrap を呼んだ場所だけにします。",
    before: {
      sources: ["examples/session-03/src/boundary/ownerContact.ts"],
      code: `export type OwnerContact = Readonly<{
  ownerName: string;
  ownerEmail: string;
  ownerPhone: string;
}>;`,
    },
    after: {
      sources: [
        "examples/session-04/src/shared/sensitive.ts",
        "examples/session-04/src/boundary/ownerContact.ts",
      ],
      code: `// shared/sensitive.ts
export const Sensitive = {
  of: <T>(value: T): Sensitive<T> => ({
    unwrap: () => value,
    toJSON: () => "[REDACTED]",
    toString: () => "[REDACTED]",
    [inspect.custom]: () => "[REDACTED]",
  }),
} as const;

// boundary/ownerContact.ts
export const OwnerContactSchema = z
  .object({
    ownerName: z.string().min(1).brand<"OwnerName">().transform(Sensitive.of),
    ownerEmail: z.string().email().brand<"OwnerEmail">().transform(Sensitive.of),
    ownerPhone: z.string().min(1).brand<"OwnerPhone">().transform(Sensitive.of),
  })
  .readonly();`,
    },
    why: "平文の string で持つと、JSON.stringify も console.log も個人情報が出る経路になり、出さないことをレビューで守り続けることになります。Sensitive で包むと既定が伏せる側になり、値を出すには unwrap を書く必要が生じます。unwrap を検索すれば、個人情報が平文になる箇所を数えられます。これが「個人情報は既定でマスクし、値を取り出す場所を限定する」の型での表し方です。",
  },
] as const;
---

<SessionLayout session={session} teaching={teaching}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    teaching={teaching}
    narrative={{
      requirement: "外部から届く JSON を検証し、用途の異なる ID を区別する。飼い主の氏名・メールアドレス・電話番号はログから守る。",
      currentRisk: "検査機関から届く値をそのまま信頼すると、同じ string で表された ID を取り違え、予約全体のログから個人情報を漏らせる。",
      design: "input 欄は、unknown から受け取る Zod の入力境界、用途別の Branded Type、既定で伏せる Sensitive で実装する。",
      limitation: "Sensitive を unwrap した文字列と、永続化から復元した ID が正しいかは、別の使用箇所で対策する必要がある。",
      nextQuestion: "診察開始を続けられない条件を、呼び出し側が業務判断できる形でどう返すか。",
      legacy: "raw: any、手書きの境界型、平文の string で持つ連絡先を読み、入力・ID・出力の3つの境界を分けます。",
      reviewFocus: "unwrap を呼ぶ場所を限定し、JSON.stringify と util.inspect のどちらでも個人情報が伏せられるか。",
      fallback: "現在の2ステップを順に開き、まず不正な JSON を Err として返します。次に連絡先3項目を Sensitive にします。相互レビューの約束事はS2のリンク先を確認します。",
    }}
  />
</SessionLayout>
