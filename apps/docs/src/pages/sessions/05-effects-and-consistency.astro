---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/05-effects-and-consistency";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("05-effects-and-consistency");
if (session === undefined) {
  throw new Error("Unknown session: 05-effects-and-consistency");
}
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement: "誰がいつ診察を開始したかを出力イベントにし、予約状態と監査記録を一つの保存境界へ渡す。",
      currentRisk: "時刻とIDを処理中に直接作り、状態と監査記録を別々に保存するため、テストが揺れ、片方だけが残り得る。",
      design: "output eventとside effects欄を、注入した実行コンテキスト、ExaminationStarted、単一のstoreで実装する。予約なし・状態不正・予約競合は業務 Result の値として返し、保存障害や破損データはcatchで業務失敗へ変換せずPromiseのrejectとして外側の境界へ伝播する。",
      limitation: "in-memory実装の一括保存は契約の形を示すだけで、本番永続化の原子性にはtransactionと結合テストが必要になる。",
      nextQuestion: "外側の境界で技術的な例外を安全に記録して500へ変換し、次に減らす小さなリスクをどう選ぶか。",
      legacy: "直接生成する時刻・IDと、状態を保存してから監査記録を追加する2つの書き込み口を読みます。後の保存だけが失敗すると状態だけが残る順序と、用意された単一storeへ業務競合が届かない箇所を探します。",
      reviewFocus: "予約競合はResultの失敗値として残り、保存障害と破損データはrejectするか。成功時は状態と監査記録が一つのstoreへ順番どおり渡るか。",
      fallback: "各解答欄はimportと後続stepを含む完成ファイルをtargetごとに示します。表示された全target fileを反映後に同じexerciseをGREENにし、1stepずつの個別GREENは約束しません。講師デモへ切り替えても相互レビューは残します。",
    }}
  />
  <aside class="failure-boundary" aria-label="業務失敗とインフラ例外の区別">
    <h2>2つの失敗経路を見分ける</h2>
    <ul class="decision-list">
      <li>
        <strong>業務上の失敗:</strong> 予約なし、状態不正、予約競合は、呼び出し側が次の操作を選べるため
        <code>Result</code> の <code>Err</code> で返します。
      </li>
      <li>
        <strong>運用上の異常:</strong> 保存処理のrejectや破損データは業務エラーへ変換せず、外側の境界で安全に記録して詳細を含まない500応答へ変換します。
      </li>
    </ul>
  </aside>
</SessionLayout>
