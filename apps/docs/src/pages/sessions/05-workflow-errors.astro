---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/05-workflow-errors";
import SessionLayout from "../../layouts/SessionLayout.astro";
import type { SessionSummary } from "../../sessions/types";

export const session: SessionSummary = {
  slug: "05-workflow-errors",
  snapshot: "session-05",
  sequence: "05",
  kind: "exercise",
  title: "失敗をワークフローの結果として扱う",
  durationMinutes: 30,
  timeBreakdown: { brief: 4, teach: 3, exercise: 15, review: 8 },
  adv: { articulate: 2, delegate: 10, verify: 3 },
  peerReview: {
    minutes: 8,
    pickCount: 2,
    questions: [
      "予約なしと状態不正は、異なる `kind` を持つ `Err` になっていますか。",
      "`andThen` は、成功したときだけ次の検証と状態遷移へ進みますか。",
      "業務エラーの後に、状態の保存が実行されない構造になっていますか。",
    ],
  },
  solutionSnapshot: "session-06",
  solutionPresentation: "excerpt",
  peerReviewPromises: "reference",
  animal: { name: "HAMSTER", type: "hamster", avatar: "🐹" },
  summary: "診察開始の予期できる失敗を、呼び出し側が扱える値として返します。",
  incident: "例外メッセージの変更で画面の分岐が壊れ、受付が失敗理由を追えなくなった。",
  exerciseCommand: "pnpm exercise:05",
  exerciseModule: {
    dir: "examples/session-05/src/useCase",
    fileBudget: 3,
    lineBudget: 76,
  },
  delegationPrompt: {
    request:
      "診察開始で起こりうる業務上の失敗を、呼び出し側が判断できる形に改善してください。表示文言には依存せず、失敗後の処理を続けない設計にしてください。",
    decisions: [
      "何を予期できる業務上の失敗として扱うか",
      "呼び出し側が分岐に使う安定した情報は何か",
      "失敗後に実行してはいけない処理は何か",
    ],
  },
  steps: [
    {
      id: "s5-invalid-state",
      goal: "受付済みでない状態を型付きの失敗として返す。",
      targets: ["examples/session-05/src/useCase/errors.ts"],
      solutions: [{
        path: "examples/session-06/src/useCase/errors.ts",
        symbol: "ensureCheckedIn",
        lines: [31, 36],
      }],
    },
    {
      id: "s5-not-found",
      goal: "予約が見つからない失敗を型付きの値として返す。",
      targets: ["examples/session-05/src/useCase/errors.ts"],
      solutions: [{
        path: "examples/session-06/src/useCase/errors.ts",
        symbol: "ensureAppointmentFound",
        lines: [23, 29],
      }],
    },
    {
      id: "s5-result-pipeline",
      goal: "失敗理由をandThenのパイプラインで運ぶ。",
      targets: ["examples/session-05/src/useCase/startExamination.ts"],
      solutions: [{
        path: "examples/session-06/src/useCase/startExamination.ts",
        symbol: "startExamination",
        lines: [22, 40],
      }],
    },
  ],
  decisions: [
    {
      invariant: "予期できる失敗は戻り値に現れる。",
    },
    {
      invariant: "呼び出し側は文言ではなく失敗のkindで分岐する。",
    },
    {
      invariant: "失敗経路では後続の処理を行わない。",
    },
  ],
  finalReferences: [
    "examples/final/src/useCase/errors.ts",
    "examples/final/src/useCase/startExaminationUseCase.ts",
    "examples/final/src/adaptor/primary/web/routes/appointmentRoutes.ts",
    "examples/final/src/adaptor/primary/web/middleware/useCaseResponse.ts",
  ],
};

const teaching = [
  {
    name: "matchは成功と失敗を分ける。失敗のkindはswitchで網羅する",
    definition:
      "Result.matchは成功時と失敗時の処理を分けます。失敗側のコールバックはエラーのUnion全体を受け取るため、AppointmentNotFoundとInvalidAppointmentStateはerror.kindで分岐します。",
    before: {
      caption: "成功と失敗だけを分けた例",
      code: `const message = result.match(
  () => "診察を開始しました",
  () => "診察を開始できません",
);`,
    },
    after: {
      caption: "失敗理由まで網羅した例",
      code: `const assertNever = (error: never): never => {
  throw new Error(\`Unhandled error: \${JSON.stringify(error)}\`);
};

const message = result.match(
  () => "診察を開始しました",
  (error) => {
    switch (error.kind) {
      case "AppointmentNotFound":
        return "予約が見つかりません";
      case "InvalidAppointmentState":
        return "受付済みの予約だけ診察を開始できます";
      default:
        return assertNever(error);
    }
  },
);`,
    },
    example: {
      caption: "AppointmentConflictを追加し、呼び出し側のcaseを足し忘れた例",
      code: `type AppointmentConflict = Readonly<{
  kind: "AppointmentConflict";
}>;

type StartExaminationError =
  | AppointmentNotFound
  | InvalidAppointmentState
  | AppointmentConflict;

const toErrorMessage = (error: StartExaminationError): string => {
  switch (error.kind) {
    case "AppointmentNotFound":
      return "予約が見つかりません";
    case "InvalidAppointmentState":
      return "受付済みの予約だけ診察を開始できます";
    default:
      // errorはAppointmentConflictなので、neverへ渡せない。
      return assertNever(error);
  }
};`,
    },
    why: "matchの2つのコールバックは、成功か失敗かを扱います。失敗側でkindをswitchし、default節でneverだけを受け取るassertNeverを呼ぶと、現在のエラーをすべて処理したことを型検査で確認できます。エラーの種類を追加してcaseを足し忘れると、default節に新しい型が残るためコンパイルエラーになります。",
  },
] as const;
---

<SessionLayout session={session} teaching={teaching}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    teaching={teaching}
    narrative={{
      requirement: "診察を開始する際の予期できる業務エラーを、曖昧なエラーコードではなく、型付きの値として扱えるようにする。",
      currentRisk: "throw、undefined、例外メッセージへの依存が混在しているため、フロントエンドの受付画面でエラー理由を分岐できない。また、エラー発生後の処理も止めにくい。",
      design: "expected failures 欄は、kind を持つ業務エラーの判別共用体と、成功か失敗かを値で返す Result で実装する。andThen で成功時だけ処理をつなぎ、呼び出し側ではmatchの失敗側でerror.kindを網羅的に処理する。",
      limitation: "どのエラーを業務エラーとして扱うか、フロントエンドの画面でどのように表示するかは、人の判断とレビューが必要になる。",
      legacy: "throw や try/catch の利用、エラーメッセージに依存した判定、間違ったエラーのマッピングが行われているコードを読みます。この回では予期できる業務エラーをResultとして扱います。",
      fallback: "同じ形の2つのguardを解答からコピペします。次に startExamination の try/catch を andThen に置き換えます。",
    }}
  />
</SessionLayout>
