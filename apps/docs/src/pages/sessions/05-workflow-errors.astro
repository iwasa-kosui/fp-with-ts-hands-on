export const guides = ([
  {
    id: "throws-known-errors",
    title: "起こりうる業務エラーが戻り値の型に現れない",
    currentDesign: "guard は成功値だけを返す型ですが、予約なしと状態不正では Error をthrowします。",
    futureRisk: "呼び出し側は実装を読まないと、どの例外を処理すべきか判断できません。",
    path: "src/useCase/errors.ts",
    highlights: [{ startLineNumber: 4, endLineNumber: 23 }],
  },
  {
    id: "catch-misses-state-error",
    title: "Web側が予約なしだけを文言でcatchしている",
    currentDesign: "例外メッセージにwas not foundが含まれる場合だけnoticeへ変換し、それ以外は500になります。",
    futureRisk: "例外の種類を追加しても呼び出し側に型エラーが出ず、今回のような処理漏れが残ります。",
    path: "src/web/routes.ts",
    highlights: [{ startLineNumber: 76, endLineNumber: 94 }],
  },
] as const) satisfies readonly CodeGuide[];

const teaching: readonly TeachingTopic[] = [
  {
    name: "neverthrow の Result<T, E> は成功と失敗を値で表す",
    definition:
      "このプロジェクトでは neverthrow の Result を使います。Result<T, E> の T は成功値、E は呼び出し側が扱う業務上の失敗です。ok(value) は成功側の Ok、err(error) は失敗側の Err を作り、どちらも Result<T, E> として扱えます。",
    before: {
      caption: "見つからない場合に例外を投げる guard",
      code: `const ensureAppointmentFound = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Appointment => {
  if (appointment === undefined) {
    throw new Error(\`Appointment \${appointmentId} was not found\`);
  }

  return appointment;
};`,
    },
    after: {
      caption: "neverthrow で業務上の失敗を返す guard",
      code: `import { err, ok, type Result } from "neverthrow";

const ensureAppointmentFound = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Result<Appointment, AppointmentNotFound> =>
  appointment === undefined
    ? err({ kind: "AppointmentNotFound", appointmentId })
    : ok(appointment);`,
    },
    why: "例外では、関数の型から失敗理由を読み取れません。Result の E に業務エラーを置くと、呼び出し側は実行前から起こりうる失敗を把握し、表示や次の操作を選べます。err は例外を投げず、失敗理由を値として返します。ただし、保存障害など呼び出し側で業務上の対応を選べない異常まで Result に入れるわけではありません。",
  },
  {
    name: "andThen と map は成功した経路だけを進める",
    definition:
      "andThen は Ok のときだけ次の Result を返す処理へ進み、map は Ok の成功値だけを変換します。Err になった後のコールバックは呼ばれません。状態遷移は外部依存ではなくドメインの純粋関数なので、ユースケースから直接呼びます。",
    before: {
      caption: "途中で何がthrowされるか型から分からないワークフロー",
      code: `import {
  startExamination as transitionToInExamination,
} from "../domain/appointment/transitions.js";

const startExamination =
  (deps: Dependencies) =>
  (input: StartExaminationInput): InExamination => {
    const found = ensureAppointmentFound(
      deps.resolver.resolveById(input.appointmentId),
      input.appointmentId,
    );
    const checkedIn = ensureCheckedIn(found);
    const next = transitionToInExamination(
      checkedIn,
      input.veterinarianId,
      input.examinationStartedAt,
    );

    deps.store.save(next);
    return next;
  };`,
    },
    after: {
      caption: "Result の型と処理順を同時に読めるワークフロー",
      code: `import type { Result } from "neverthrow";

import type { Appointment } from "../domain/appointment/appointment.js";
import {
  startExamination as transitionToInExamination,
} from "../domain/appointment/transitions.js";
import type { AppointmentId } from "../domain/ids/appointmentId.js";
import type { OwnerId } from "../domain/ids/ownerId.js";
import type { PetId } from "../domain/ids/petId.js";
import type { VeterinarianId } from "../domain/ids/veterinarianId.js";

type InExamination = Readonly<{
  kind: "InExamination";
  appointmentId: AppointmentId;
  petId: PetId;
  ownerId: OwnerId;
  scheduledAt: string;
  reason: string;
  checkedInAt: string;
  veterinarianId: VeterinarianId;
  examinationStartedAt: string;
}>;

type AppointmentNotFound = Readonly<{
  kind: "AppointmentNotFound";
  appointmentId: AppointmentId;
}>;

type InvalidAppointmentState = Readonly<{
  kind: "InvalidAppointmentState";
  actual: Appointment["kind"];
}>;

type StartExaminationError =
  | AppointmentNotFound
  | InvalidAppointmentState;

const startExamination =
  (deps: Dependencies) =>
  (input: StartExaminationInput): Result<
    InExamination,
    StartExaminationError
  > =>
    ensureAppointmentFound(
      deps.resolver.resolveById(input.appointmentId),
      input.appointmentId,
    )
      .andThen(ensureCheckedIn)
      .map((appointment) =>
        transitionToInExamination(
          appointment,
          input.veterinarianId,
          input.examinationStartedAt,
        ),
      )
      .map((appointment) => {
        deps.store.save(appointment);
        return appointment;
      });`,
    },
    why: "before は実行時には例外で処理が止まりますが、どの行が何をthrowするかは型に現れません。after は成功時に InExamination のどの情報が得られるかと、予約なし・状態不正のどちらで失敗するかを定義から確認できます。Err になった時点で後続の andThen と map は呼ばれません。resolver と store は外部境界として deps から受け取りますが、状態遷移はドメイン知識なので直接呼びます。保存障害など map 内で発生する予期しない例外は捕捉せず、業務エラーへ偽装しません。",
  },
  {
    name: "match と switch で呼び出し側の処理漏れを型エラーにする",
    definition:
      "Result.match は成功時と失敗時の処理を分けます。失敗側は StartExaminationError 全体を受け取り、error.kind の switch で各 notice へ変換します。",
    before: {
      caption: "予約なしだけを例外メッセージで処理する呼び出し側",
      code: `try {
  startExamination(dependencies)(input);
  return context.redirect("/", 303);
} catch (error) {
  if (
    error instanceof Error &&
    error.message.includes("was not found")
  ) {
    return context.redirect("/?notice=not-found", 303);
  }

  // 状態不正の例外はここへ到達し、500になる。
  throw error;
}`,
    },
    after: {
      caption: "業務エラーのkindを網羅してnoticeへ変換する呼び出し側",
      code: `const assertNever = (error: never): never => {
  throw new Error(\`Unhandled error: \${JSON.stringify(error)}\`);
};

const toNoticeCode = (error: StartExaminationError) => {
  switch (error.kind) {
    case "AppointmentNotFound":
      return "not-found";
    case "InvalidAppointmentState":
      return "invalid-state";
    default:
      return assertNever(error);
  }
};

return result.match(
  () => context.redirect("/", 303),
  (error) =>
    context.redirect(
      \`/?notice=\${toNoticeCode(error)}\`,
      303,
    ),
);`,
    },
    example: {
      caption: "AppointmentConflictを追加し、呼び出し側のcaseを足し忘れた例",
      code: `type AppointmentConflict = Readonly<{
  kind: "AppointmentConflict";
}>;

type StartExaminationError =
  | AppointmentNotFound
  | InvalidAppointmentState
  | AppointmentConflict;

const toNoticeCode = (error: StartExaminationError): string => {
  switch (error.kind) {
    case "AppointmentNotFound":
      return "not-found";
    case "InvalidAppointmentState":
      return "invalid-state";
    default:
      // errorはAppointmentConflictなので、neverへ渡せない。
      return assertNever(error);
  }
};`,
    },
    why: "before では InvalidAppointmentState が追加されても catch に型エラーが出ないため、受付前の予約だけ500になりました。after は match の失敗側で union 全体を受け取り、default 節から never 専用の assertNever を呼びます。エラーの種類を追加して case を足し忘れると新しい型が default 節に残り、コンパイルエラーになります。技術的な例外は Result に入れていないため、この switch では捕捉せず外側の例外境界へ伝えます。",
  },
];

const safeTryColumn = {
  title: "中間値に名前を付ける safeTry",
  introduction:
    "andThen のチェーンでは値を次の処理へ直接渡します。途中の成功値を複数使う場合や、名前を付けながら上から読みたい場合は safeTry も選べます。",
  caption: "safeTryでErrを早期returnし、Okの値を取り出す",
  code: `import { ok, safeTry, type Result } from "neverthrow";

import {
  startExamination as transitionToInExamination,
} from "../domain/appointment/transitions.js";

const startExamination = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Result<InExamination, StartExaminationError> =>
  safeTry(function* () {
    const found = yield* ensureAppointmentFound(
      appointment,
      appointmentId,
    );
    const checkedIn = yield* ensureCheckedIn(found);

    return ok(transitionToInExamination(checkedIn));
  });`,
} as const;

const narrative = {
  requirement: "診察開始で予期できる業務エラーを型付きの値として返し、Web側が失敗理由ごとに受付の次の操作を選べるようにする。",
  currentRisk: "ユースケースは成功値だけを返す型のまま複数の Error をthrowします。Web側は予約なしの文言だけをcatchしているため、後から追加された状態不正を処理できず500にしています。",
  design: "予約なしと状態不正を kind を持つ判別共用体にし、Result で返す。andThen で失敗後の遷移と保存を止める。状態遷移はドメイン関数を直接呼び、外部境界のresolverとstoreだけを依存として受け取る。Web側はmatchとswitchで業務エラーを網羅してnoticeへ変換する。",
  limitation: "どの失敗を業務エラーとして扱うか、画面でどのnoticeへ変換するかは、人の判断とレビューが必要になる。保存障害など予期しない異常はResultへ変換せず、外側の例外境界へ伝える。",
  legacy: "成功値しか現れない関数シグネチャ、複数箇所のthrow、例外メッセージに依存したcatchを読みます。受付前の予約だけ500になる処理漏れを、演習テストで再現します。",
  fallback: "2つのguardと startExamination は解答例を反映します。最後にWebルートをmatchとswitchへ置き換え、2種類のnoticeを確認します。",
} as const;

