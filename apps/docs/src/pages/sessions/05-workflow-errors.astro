export const guides = ([
  {
    id: "throws-known-errors",
    title: "expected failures を例外メッセージとして扱っている",
    currentDesign: "expected failures の union を宣言していても、guard の本体は throw します。",
    futureRisk: "呼び出し側が kind ではなく文言へ依存します。",
    path: "src/useCase/errors.ts",
    highlights: [
      { startLineNumber: 18, endLineNumber: 27 },
      { startLineNumber: 29, endLineNumber: 37 },
    ],
  },
  {
    id: "catch-collapses-errors",
    title: "catch が expected failures を1種類にまとめてしまう",
    currentDesign: "not found と invalid state を try/catch で同じエラーに変換しています。",
    futureRisk: "予約なしまで InvalidAppointmentState として返り、受付が理由を判別できません。",
    path: "src/useCase/startExamination.ts",
    highlights: [{ startLineNumber: 15, endLineNumber: 40 }],
  },
] as const) satisfies readonly CodeGuide[];

const resultOperationSignatures = `// 実装は省略し、各処理の入出力だけを示す
declare const ensureAppointmentFound: (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
) => Result<Appointment, AppointmentNotFound>;

declare const ensureCheckedIn: (
  appointment: Appointment,
) => Result<CheckedIn, InvalidAppointmentState>;

declare const transitionToInExamination: (
  appointment: CheckedIn,
) => InExamination;

declare const toErrorKind: (
  error: AppointmentNotFound | InvalidAppointmentState,
) => "AppointmentNotFound" | "InvalidAppointmentState";`;

const teaching: readonly TeachingTopic[] = [
  {
    name: "neverthrow の Result<T, E> は成功と失敗を値で表す",
    definition:
      "このプロジェクトでは neverthrow の Result を使います。Result<T, E> の T は成功値、E は呼び出し側が扱う業務上の失敗です。ok(value) は成功側の Ok、err(error) は失敗側の Err を作り、どちらも Result<T, E> として扱えます。",
    before: {
      caption: "見つからない場合に例外を投げる guard",
      code: `const ensureAppointmentFound = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Appointment => {
  if (appointment === undefined) {
    throw new Error(\`Appointment \${appointmentId} was not found\`);
  }

  return appointment;
};`,
    },
    after: {
      caption: "neverthrow で業務上の失敗を返す guard",
      code: `import { err, ok, type Result } from "neverthrow";

const ensureAppointmentFound = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Result<Appointment, AppointmentNotFound> =>
  appointment === undefined
    ? err({ kind: "AppointmentNotFound", appointmentId })
    : ok(appointment);`,
    },
    why: "例外では、関数の型から失敗理由を読み取れません。Result の E に業務エラーを置くと、呼び出し側は実行前から起こりうる失敗を把握し、表示や次の操作を選べます。err は例外を投げず、失敗理由を値として返します。ただし、保存障害など呼び出し側で業務上の対応を選べない異常まで Result に入れるわけではありません。",
  },
  {
    name: "map、mapErr、andThen は片方の経路だけを進める",
    definition:
      "map は Ok の成功値、mapErr は Err の失敗理由だけを変換します。andThen は Ok のときだけ、次の Result を返す処理へ進みます。3つとも反対側の値には触れません。",
    before: {
      caption: "成功と失敗を明示的に分岐する書き方",
      code: `${resultOperationSignatures}

const startExamination = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Result<
  InExamination,
  "AppointmentNotFound" | "InvalidAppointmentState"
> => {
  const found = ensureAppointmentFound(appointment, appointmentId);

  if (found.isErr()) {
    return err(toErrorKind(found.error));
  }

  const checkedIn = ensureCheckedIn(found.value);

  if (checkedIn.isErr()) {
    return err(toErrorKind(checkedIn.error));
  }

  return ok(transitionToInExamination(checkedIn.value));
};`,
    },
    after: {
      caption: "関数の型を確認し、成功経路を上から読む書き方",
      code: `${resultOperationSignatures}

const startExamination = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Result<
  InExamination,
  "AppointmentNotFound" | "InvalidAppointmentState"
> =>
  ensureAppointmentFound(appointment, appointmentId)
    .andThen(ensureCheckedIn)
    .map(transitionToInExamination)
    .mapErr(toErrorKind);`,
    },
    why: "map のコールバックは通常の成功値を返し、mapErr のコールバックは失敗理由を別の形へ変換します。mapErr を呼んでも Err は Ok にならないため、再試行や復旧ではありません。andThen のコールバックは次の Result を返します。前の処理が Err なら呼ばれないので、検証に失敗した後の状態遷移や保存を実行せずに済みます。明示的な分岐と動作は同じですが、処理が増えても成功経路を上から順に読めます。",
  },
  {
    name: "matchは成功と失敗を分ける。失敗のkindはswitchで網羅する",
    definition:
      "Result.matchは成功時と失敗時の処理を分けます。失敗側のコールバックはエラーのUnion全体を受け取るため、AppointmentNotFoundとInvalidAppointmentStateはerror.kindで分岐します。",
    before: {
      caption: "成功と失敗だけを分けた例",
      code: `const message = result.match(
  () => "診察を開始しました",
  () => "診察を開始できません",
);`,
    },
    after: {
      caption: "失敗理由まで網羅した例",
      code: `const assertNever = (error: never): never => {
  throw new Error(\`Unhandled error: \${JSON.stringify(error)}\`);
};

const message = result.match(
  () => "診察を開始しました",
  (error) => {
    switch (error.kind) {
      case "AppointmentNotFound":
        return "予約が見つかりません";
      case "InvalidAppointmentState":
        return "受付済みの予約だけ診察を開始できます";
      default:
        return assertNever(error);
    }
  },
);`,
    },
    example: {
      caption: "AppointmentConflictを追加し、呼び出し側のcaseを足し忘れた例",
      code: `type AppointmentConflict = Readonly<{
  kind: "AppointmentConflict";
}>;

type StartExaminationError =
  | AppointmentNotFound
  | InvalidAppointmentState
  | AppointmentConflict;

const toErrorMessage = (error: StartExaminationError): string => {
  switch (error.kind) {
    case "AppointmentNotFound":
      return "予約が見つかりません";
    case "InvalidAppointmentState":
      return "受付済みの予約だけ診察を開始できます";
    default:
      // errorはAppointmentConflictなので、neverへ渡せない。
      return assertNever(error);
  }
};`,
    },
    why: "matchの2つのコールバックは、成功か失敗かを扱います。失敗側でkindをswitchし、default節でneverだけを受け取るassertNeverを呼ぶと、現在のエラーをすべて処理したことを型検査で確認できます。エラーの種類を追加してcaseを足し忘れると、default節に新しい型が残るためコンパイルエラーになります。",
  },
];

const safeTryColumn = {
  title: "中間値に名前を付ける safeTry",
  introduction:
    "andThen のチェーンでは値を次の処理へ直接渡します。途中の成功値を複数使う場合や、名前を付けながら上から読みたい場合は safeTry も選べます。",
  caption: "safeTryでErrを早期returnし、Okの値を取り出す",
  code: `import { ok, safeTry, type Result } from "neverthrow";

const startExamination = (
  appointment: Appointment | undefined,
  appointmentId: AppointmentId,
): Result<InExamination, StartExaminationError> =>
  safeTry(function* () {
    const found = yield* ensureAppointmentFound(
      appointment,
      appointmentId,
    );
    const checkedIn = yield* ensureCheckedIn(found);

    return ok(transitionToInExamination(checkedIn));
  });`,
} as const;

const narrative = {
  requirement: "診察を開始する際の予期できる業務エラーを、曖昧なエラーコードではなく、型付きの値として扱えるようにする。",
  currentRisk: "throw、undefined、例外メッセージへの依存が混在しているため、フロントエンドの受付画面でエラー理由を分岐できない。また、エラー発生後の処理も止めにくい。",
  design: "expected failures 欄は、kind を持つ業務エラーの判別共用体と、成功か失敗かを値で返す Result で実装する。andThen で成功時だけ処理をつなぎ、呼び出し側ではmatchの失敗側でerror.kindを網羅的に処理する。",
  limitation: "どのエラーを業務エラーとして扱うか、フロントエンドの画面でどのように表示するかは、人の判断とレビューが必要になる。",
  legacy: "throw や try/catch の利用、エラーメッセージに依存した判定、間違ったエラーのマッピングが行われているコードを読みます。この回では予期できる業務エラーをResultとして扱います。",
  fallback: "同じ形の2つのguardを解答からコピペします。次に startExamination の try/catch を andThen に置き換えます。",
} as const;

const exerciseSession: ExerciseSessionSummary = session;

export const workspace = ({
  slug: session.slug,
  snapshot: session.snapshot,
  initialFile: "exercises/result-errors.test.ts",
  description: "expected failures と Result の要求を開始 snapshot で確認します。",
  visibleFiles: [
    "exercises/result-errors.test.ts",
    "test/regression/boundary-and-ids.test.ts",
    "test/regression/state-modeling.test.ts",
    "src/boundary/examResult.ts",
    "src/boundary/ownerContact.ts",
    "src/domain/appointment/appointment.ts",
    "src/domain/appointment/transitions.ts",
    "src/domain/appointment/statusLabel.ts",
    "src/domain/ids/appointmentId.ts",
    "src/domain/ids/examId.ts",
    "src/domain/ids/ownerId.ts",
    "src/domain/ids/petId.ts",
    "src/domain/ids/veterinarianId.ts",
    "src/shared/sensitive.ts",
    "src/useCase/errors.ts",
    "src/useCase/startExamination.ts",
  ],
} as const) satisfies SessionWorkspace;

const projectFiles = projectFilesForSnapshot(session.snapshot);
const solutionSteps = await Promise.all(
  session.steps.map(async (step) => ({
    step,
    presentation: step.solutions[0].presentation ?? "excerpt",
    snippets: await loadSolutionSnippets(step),
  })),
);
const chapters = [
  { id: "incident", label: "今回つくるもの" },
  { id: "legacy", label: "コードを読み、失敗を再現する" },
  { id: "teach", label: "使う型を知る" },
  { id: "refactor", label: "型で閉じる" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
const commonReviewChecks = [
  "`as` によるキャストが入っていないか全文検索して確認する。",
  "`git diff --stat -- examples/session-05` で今回の snapshot だけを確認する。`git status --short` で想定外の path がないか確認する。",
  "不変条件を型で守っているか、実行時の `if` で守っているかを判定し、型で守れなかった残りを記録する。",
] as const;
const reviewCompletionArtifacts = [
  "守る不変条件の1文",
  "依頼文",
  "型で守れなかった残り",
] as const;
const businessReflectionQuestion =
  "自分の業務コードで、今回と同種の問題が起きうる箇所はどこですか。";
export const promisesHref =
  "/sessions/02-state-transitions/#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/04-boundaries-and-pii/",
    title: "外部入力を境界で検証し個人情報を守る",
  },
  next: {
    href: "/sessions/06-effects-and-consistency/",
    title: "副作用と整合性境界を設計する",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const delegationPrompt = `次の変更を実装してください。

業務背景:
${session.incident}

依頼:
${exerciseSession.delegationPrompt.request}

守る不変条件: [言語化フェーズで書いた1文]

着手前に判断すること:
${exerciseSession.delegationPrompt.decisions.map((decision) => `- ${decision}: [自分の判断を書く]`).join("\n")}

まず配布コードと失敗しているテストを読み、上の判断と変更方針を短く説明してください。説明のあとで実装に進んでください。設計手段は既存コードに合うものを選び、選んだ理由も示してください。

受け入れ条件:
${session.steps.map((step) => `- ${step.goal}`).join("\n")}

変更範囲:
- ${session.exerciseModule.dir}/ のみ
- 最大 ${session.exerciseModule.fileBudget} ファイル・約 ${session.exerciseModule.lineBudget} 行
- 範囲外の変更が必要に見えた場合は、変更せず理由を報告する
- 型エラーを \`as\` によるキャストで回避しない

検証:
- ${session.exerciseCommand} を実行し、すべての assertion が成功すること

完了時の報告:
- 変更したファイルと判断理由
- 検証コマンドの結果
- 型だけでは守れず、テストまたはレビューに残した点`;
