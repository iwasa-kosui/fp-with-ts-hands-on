---
import CommandBlock from "../../components/CommandBlock.astro";
import SessionCodePlayground from "../../components/code-explorer/SessionCodePlayground.astro";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("00-onboarding");
if (session === undefined) throw new Error("Unknown session: 00-onboarding");
---

<SessionLayout session={session}>
  <ol slot="toc">
    <li><a href="#incident">引き継いだ事故を読む</a></li>
    <li><a href="#learning-loop">事故から始める進め方</a></li>
    <li><a href="#onboarding-technique">観察の役割と限界</a></li>
    <li><a href="#code-playground">先人のコードを読む</a></li>
    <li><a href="#onboarding-verification">開始状態を確認する</a></li>
    <li><a href="#onboarding-reflection">最初の問いを残す</a></li>
  </ol>

  <section id="incident">
    <h2>引き継いだ事故を読む</h2>
    <p data-actor="院長"><strong>登場人物:</strong> 院長から、退職した先人の獣医が診療の合間に作った予約管理システムを引き継ぎます。</p>
    <p><strong>事故:</strong> 会計済みの来院を診察中へ戻せるうえ、飼い主の PII を含む値が運用ログへそのまま出ます。</p>
    <p><strong>最初に守ること:</strong> 終わった来院を通常フローへ戻さず、PII を不要な出力へ露出させない。</p>
    <CommandBlock phase="red" command="pnpm exercise:00" expected="会計済みの来院が診察中へ戻る事故を再現するため、意図的に失敗します。" />
    <h3>事故を読むファイル</h3>
    <ul>
      <li><code>examples/session-00/exercises/incident.test.ts</code></li>
      <li><code>examples/session-00/src/appointment.ts</code></li>
      <li><code>examples/session-00/src/logger.ts</code></li>
    </ul>
  </section>

  <section id="learning-loop">
    <h2>事故から始める進め方</h2>
    <p>この教材は完成形を写す講座ではありません。各回で次の小さなループを繰り返します。</p>
    <ol>
      <li>登場人物と事故を確認する。</li>
      <li>守る不変条件を業務の言葉で書く。</li>
      <li>RED を観察し、作業を最大2関数に絞る。</li>
      <li>事故に合う技法と、その技法の限界を確認する。</li>
      <li>GREEN の後、型・統合テスト・人のレビューを分けて確認する。</li>
      <li>未解決のリスクから次の一歩を決める。</li>
    </ol>
    <p>Session 00 では legacy を直しません。事故を再現できることが、次の変更を安全に始めるための作業です。</p>
  </section>

  <section id="onboarding-technique">
    <h2>観察の役割と限界</h2>
    <p><strong>使う技法:</strong> 事故再現テストと legacy の読解で、変更前の問題を観察可能にします。</p>
    <p><strong>この技法の限界:</strong> 観察だけでは事故を防げません。次回から一つの不変条件に対して必要な手段を選びます。</p>
  </section>

  <SessionCodePlayground slug={session.slug} />

  <section id="onboarding-verification">
    <h2>開始状態を確認する</h2>
    <CommandBlock phase="green" command="pnpm --filter @fp-with-ts/clinic-session-00 test" expected="通常の予約から会計までのフローは成功し、事故用 exercise と区別できます。" />
    <dl>
      <dt>型で守ること</dt><dd>legacy の string status ではまだ守れていない、と説明できること。</dd>
      <dt>統合テストで守ること</dt><dd>通常フローと事故再現を別コマンドで観察すること。</dd>
      <dt>人がレビューすること</dt><dd>終端状態、PII の閲覧者、ログの用途を病院スタッフへ確認すること。</dd>
    </dl>
  </section>

  <section id="onboarding-reflection">
    <h2>最初の問いを残す</h2>
    <p>事故を止めるため、まず一文で固定すべき業務ルールは何ですか。</p>
    <p><a href="/sessions/01-invariants/">次へ: 守るべき不変条件を固定する</a></p>
  </section>
</SessionLayout>
