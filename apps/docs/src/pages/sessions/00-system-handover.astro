---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { CodeGuide } from "../../code-explorer/code-guide";
import type { SessionNavigation, SessionSummary } from "../../sessions/types";
import "../../styles/sessions.css";

export const session: SessionSummary = {
  slug: "00-system-handover",
  snapshot: "session-00",
  sequence: "00",
  kind: "orientation",
  title: "業務とシステムを引き継ぐ",
  durationMinutes: 10,
  timeBreakdown: { brief: 4, teach: 3, exercise: 0, review: 3 },
  animal: { name: "DOG", type: "dog", avatar: "🐕" },
  summary: "WAN NYAN CLINIC の現行業務、SQLite の状態保存と監査記録、現在起きている事故を確認します。",
  episode: [
    "新人エンジニアの初出勤を歓迎するように、犬が観葉植物を倒し、プリンターは事故報告を吐き続けていました。",
    "会計済みの予約は「診察中」へ戻り、請求書は2枚。ログには飼い主の電話番号まで律儀にそろっています。",
    "引き継ぎ資料を開く前に、二重請求と個人情報流出の再現条件だけは確認できました。",
  ],
  incident: "会計済みの予約が診察中へ戻り、予約ログから飼い主の個人情報が流出した。",
  steps: [],
  decisions: [],
  finalReferences: [],
};

export const guides = ([
  {
    id: "string-status",
    title: "状態を任意の文字列で表している",
    currentDesign: "status と更新先の状態を string で受け取っています。",
    futureRisk: "業務で使う状態と許可する遷移を型から判断できません。",
    path: "src/domain/appointment/appointment.ts",
    highlights: [{ startLineNumber: 11, endLineNumber: 11 }],
  },
  {
    id: "optional-state-data",
    title: "状態固有の情報が複数の optional field に分散している",
    currentDesign: "診察、会計、キャンセルの情報が、一つの型にある複数の optional field として定義されています。",
    futureRisk: "どの状態で何が必須なのかを型から判断できません。",
    path: "src/domain/appointment/appointment.ts",
    highlights: [{ startLineNumber: 13, endLineNumber: 13 }],
  },
  {
    id: "plain-string-ids",
    title: "用途の異なる ID がすべて string である",
    currentDesign: "予約、動物、飼い主、獣医師の ID が同じ string です。",
    futureRisk: "実行時には同じ形式の ID を TypeScript が区別できません。",
    path: "src/domain/appointment/appointment.ts",
    highlights: [
      { startLineNumber: 3, endLineNumber: 3 },
      { startLineNumber: 5, endLineNumber: 5 },
    ],
  },
  {
    id: "session-00-unvalidated-exam-json",
    title: "外部の診察結果を any のまま受け取っている",
    currentDesign: "診察結果の parse は raw: any をそのまま返します。",
    futureRisk: "壊れた JSON や用途の違う ID が、検証されずに状態保存へ入ります。",
    path: "src/boundary/examResult.ts",
    highlights: [{ startLineNumber: 4, endLineNumber: 4 }],
  },
  {
    id: "session-00-raw-pii-audit",
    title: "個人情報を監査記録の payload に残している",
    currentDesign: "予約全体を監査記録の payload として SQLite へ保存します。",
    futureRisk: "氏名、メールアドレス、電話番号を含む個人情報が監査記録から読めます。",
    path: "src/adaptor/secondary/sqlite/appointmentStore.ts",
    highlights: [{ startLineNumber: 67, endLineNumber: 67 }],
  },
  {
    id: "session-00-message-mapped-errors",
    title: "失敗理由を例外メッセージで判定している",
    currentDesign: "catch した例外の message を部分一致で調べ、状態不正として画面へ戻します。",
    futureRisk: "予約なしと別の失敗を型で区別できず、表示と対応を誤ります。",
    path: "src/web/routes.ts",
    highlights: [{ startLineNumber: 209, endLineNumber: 211 }],
  },
  {
    id: "session-00-hidden-nondeterminism",
    title: "時刻と監査 ID を処理の中で直接生成している",
    currentDesign: "診察開始の処理が現在時刻と UUID を直接生成します。",
    futureRisk: "同じ操作でも記録が毎回変わり、テストと事故調査の比較が安定しません。",
    path: "src/useCase/startExamination.ts",
    highlights: [
      { startLineNumber: 24, endLineNumber: 24 },
      { startLineNumber: 42, endLineNumber: 42 },
    ],
  },
  {
    id: "session-00-dual-write",
    title: "状態保存と監査記録を別々に保存している",
    currentDesign: "予約を保存した後で、監査記録を別の呼び出しで追記します。",
    futureRisk: "監査追記が失敗すると、監査記録を伴わない状態保存だけが残ります。",
    path: "src/useCase/startExamination.ts",
    highlights: [{ startLineNumber: 30, endLineNumber: 31 }],
  },
] as const) satisfies readonly CodeGuide[];

const chapters = [
  { id: "incident", label: "現行業務と事故" },
  { id: "system", label: "SQLite の状態・監査" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
export const navigation = ({
  previous: undefined,
  next: {
    href: "/sessions/01-business-events-and-workflows/",
    title: "ビジネスイベントからワークフローを描く",
  },
} as SessionNavigation);
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header">
      <a href="/">WAN NYAN CLINIC</a>
    </header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
        <aside class="case-file__episode" aria-label="動物病院のひと幕">
          <p class="case-file__episode-label">動物病院のひと幕</p>
          {session.episode.map((line) => <p data-episode-line>{line}</p>)}
        </aside>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </details>
        <article class="case-file__content">
  <section id="incident">
    <h2>現行業務と起きている事故</h2>
    <p>
      新任エンジニアとして WAN NYAN CLINIC の予約システムを引き継ぎます。この10分は修正案を出さず、
      現場の担当者、日々の操作、実際に起きた事故を、同じ事実に基づいて読み解きます。
    </p>
    <h3>現行業務</h3>
    <dl>
      <dt>受付</dt>
      <dd>予約を確認し、来院を受け付け、診察室へ案内し、会計までの状態を更新する。</dd>
      <dt>獣医師</dt>
      <dd>受付済みの予約から診察を開始し、担当者と開始時刻をカルテへ残す。</dd>
      <dt>飼い主</dt>
      <dd>予約と連絡先を預け、受付から失敗理由や次の案内を受け取る。</dd>
    </dl>
    <h3>起きている事故</h3>
    <article class="incident-report">
      <h4>事故報告1: 状態</h4>
      <p>会計済みの予約が診察中に戻され、同じ来院に対して会計が二度行われました。</p>
    </article>
    <article class="incident-report">
      <h4>事故報告2: ID</h4>
      <p>飼い主 ID が患者 ID として保存され、別の飼い主の情報を結び付ける可能性があります。</p>
    </article>
    <article class="incident-report">
      <h4>事故報告3: 入力</h4>
      <p>壊れた診察結果 JSON を検証せずに保存し、患者 ID と検査項目が不正なまま残りました。</p>
    </article>
    <article class="incident-report">
      <h4>事故報告4: 個人情報</h4>
      <p>監査記録に、飼い主の氏名・メールアドレス・電話番号がそのまま保存されました。</p>
    </article>
    <article class="incident-report">
      <h4>事故報告5: 失敗</h4>
      <p>予約なしの例外をメッセージで判定し、状態不正として表示しました。</p>
    </article>
    <article class="incident-report">
      <h4>事故報告6: 非決定値</h4>
      <p>同じ診察開始でも時刻と監査 ID が毎回変わり、記録を比較できません。</p>
    </article>
    <article class="incident-report">
      <h4>事故報告7: 二重保存</h4>
      <p>状態保存の後に監査記録を追記するため、監査だけ失敗しても状態だけが残ります。</p>
    </article>
    <article class="incident-report">
      <h4>事故報告8: 永続 JSON</h4>
      <p>SQLite に保存した予約と監査記録の JSON は、起動し直した後も残り、事故の結果を引き継ぎます。</p>
    </article>
  </section>

  <section id="system">
    <h2>SQLite の状態保存と監査記録</h2>
    <p>
      現在の画面で行う操作は SQLite に保存されます。サーバーを起動し直しても状態保存と監査記録は残り、
      「デモを初期状態へ戻す」を実行したときだけ初期状態へ戻ります。ここでも修正はせず、事故報告と現在の動きがどこで結び付くかを確認します。
    </p>
    <h3>現在の操作</h3>
    <table>
      <thead><tr><th>担当</th><th>画面で行う操作</th><th>現在の記録</th></tr></thead>
      <tbody>
        <tr><th>受付</th><td>予約検索、来院受付、診察室への案内、会計完了を入力する。</td><td>予約の現在の状態と操作を行った時刻を更新する。</td></tr>
        <tr><th>獣医師</th><td>受付済みの予約から診察を開始し、診療内容を入力する。</td><td>担当者、開始時刻、診療内容を残す。</td></tr>
        <tr><th>会計担当</th><td>診察料、検査料、処方料を確認して会計をする。</td><td>請求額と会計をした時刻を残す。</td></tr>
      </tbody>
    </table>
    <h3>DB inspection で読む状態保存と監査記録</h3>
    <table>
      <thead><tr><th>保存・記録先</th><th>現在保存されているデータ</th><th>事故報告との対応</th></tr></thead>
      <tbody>
        <tr><th>状態保存 JSON</th><td>予約 ID、患者 ID、飼い主 ID、現在状態、各操作の時刻。</td><td>未知の状態や ID の取り違え、不正な診察結果が SQLite に残る。</td></tr>
        <tr><th>監査記録 JSON</th><td>イベント ID、イベント名、時刻、予約全体の payload。</td><td>payload に個人情報が含まれ、状態保存と一致しない記録が残り得る。</td></tr>
        <tr><th>警告</th><td>未知の状態、ID の一致、状態保存と最新の監査記録の不一致、個人情報の有無。</td><td>事故再現を実行した後に、どの JSON を確認するかを示す。</td></tr>
      </tbody>
    </table>
  </section>

  <section id="review">
    <h2>レビューと持ち帰り</h2>
    <p>
      班で「誰が、どの操作をし、何が起き、SQLite のどの JSON に残ったか」を1件ずつ共有します。
      Session 00 では事故を修正しません。Session 02 から Session 07 で、状態、ID、入力と個人情報、失敗、非決定値、状態保存と監査記録の整合性を順に改善する理由を確認します。
    </p>
  </section>
        </article>
      </div>
      <nav class="case-file__session-nav" aria-label="前後のセッション">
        {
          navigation.previous === undefined ? null : (
            <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
          )
        }
        {
          navigation.next === undefined ? null : (
            <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
          )
        }
      </nav>
    </main>
  </div>
</BaseLayout>
