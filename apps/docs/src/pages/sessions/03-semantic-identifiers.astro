---
import { Code } from "astro:components";
import CodeGuideCards from "../../components/CodeGuideCards.astro";
import CommandBlock from "../../components/CommandBlock.astro";
import { CodeExplorer } from "../../components/code-explorer/CodeExplorer";
import type { CodeGuide } from "../../code-explorer/code-guide";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import type { SessionWorkspace } from "../../code-explorer/types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSolutionSnippets } from "../../sessions/solution-snippets";
import type {
  ExerciseSessionSummary,
  SessionSummary,
} from "../../sessions/types";
import "../../styles/code-playground.css";
import "../../styles/sessions.css";

type TeachingCode = Readonly<{
  sources?: readonly [string, ...string[]];
  caption?: string;
  code: string;
}>;

type TeachingTopic = Readonly<{
  name: string;
  definition: string;
  before: TeachingCode;
  after: TeachingCode;
  example?: Readonly<{ caption: string; code: string }>;
  why: string;
}>;

export const session: SessionSummary = {
  slug: "03-semantic-identifiers",
  snapshot: "session-03",
  sequence: "03",
  kind: "exercise",
  title: "診察開始の識別子を型で区別する",
  durationMinutes: 30,
  timeBreakdown: { brief: 4, teach: 6, exercise: 13, review: 7 },
  adv: { articulate: 2, delegate: 9, verify: 2 },
  peerReview: {
    minutes: 7,
    pickCount: 2,
    questions: [
      "`AppointmentId` と `VeterinarianId` を取り違えたコードは、型テストでコンパイルエラーになりますか。",
      "予約の全状態で、`appointmentId` が `AppointmentId` になっていますか。",
      "`startExamination` は、担当獣医師を `VeterinarianId` として受け取っていますか。",
    ],
  },
  solutionSnapshot: "session-04",
  solutionPresentation: "excerpt",
  peerReviewPromises: "reference",
  animal: { name: "HEDGEHOG", type: "hedgehog", avatar: "🦔" },
  summary: "診察開始で使う予約IDと担当獣医師IDを、取り違えられない型にします。",
  episode: [
    "診察開始の入力で、予約IDと担当獣医師IDが入れ替わっていました。",
    "どちらもUUIDなので、文字列の検査だけでは取り違えを止められません。",
    "予約を選ぶ値と担当者を選ぶ値を、型で区別する必要があります。",
  ],
  incident: "診察開始で AppointmentId と VeterinarianId を取り違えても、型検査が通った。",
  exerciseCommand: "pnpm exercise:03",
  exerciseModule: {
    dir: "examples/session-03/src/domain",
    fileBudget: 5,
    lineBudget: 34,
  },
  delegationPrompt: {
    request:
      "診察開始で使う予約IDと担当獣医師IDを改善してください。同じUUID形式でも、用途を取り違えたコードはコンパイルを通らない状態を目指します。",
    decisions: [
      "AppointmentIdとVeterinarianIdをどの型として定義するか",
      "用途の区別を予約状態とstartExaminationへどう伝えるか",
      "取り違えをコンパイルエラーとしてどう残すか",
    ],
  },
  steps: [
    {
      id: "s3-brand-start-examination-ids",
      goal: "予約IDと担当獣医師IDを、配布済みの識別子と同じ規約で別々の型にする。",
      startingFailure: "予約IDと担当獣医師IDを取り違えても、型検査が通る。",
      targets: [
        "examples/session-03/src/domain/appointment/appointmentId.ts",
        "examples/session-03/src/domain/appointment/veterinarianId.ts",
      ],
      solutions: [
        {
          path: "examples/session-04/src/domain/appointment/appointmentId.ts",
          symbol: "AppointmentId",
          lines: [3, 6],
        },
        {
          path: "examples/session-04/src/domain/appointment/veterinarianId.ts",
          symbol: "VeterinarianId",
          lines: [3, 6],
        },
      ],
    },
    {
      id: "s3-apply-start-examination-ids",
      goal: "予約の6状態とstartExaminationが、用途別の識別子を受け取るようにする。",
      startingFailure: "予約状態とstartExaminationが、用途を区別しないstringを受け取る。",
      targets: [
        "examples/session-03/src/domain/appointment/appointment.ts",
        "examples/session-03/src/domain/appointment/transitions.ts",
      ],
      solutions: [
        {
          path: "examples/session-04/src/domain/appointment/appointment.ts",
          symbol: "Scheduled",
          lines: [1, 15],
        },
        {
          path: "examples/session-04/src/domain/appointment/transitions.ts",
          symbol: "startExamination",
          lines: [17, 27],
        },
      ],
    },
    {
      id: "s3-reject-id-swap",
      goal: "AppointmentIdとVeterinarianIdを入れ替えたコードがコンパイルできないことを、型テストで確かめる。",
      startingFailure: "取り違えた2行が、型エラーにならないままコンパイルされる。",
      targets: ["examples/session-03/src/domain/domain.test-types.ts"],
      solutions: [{
        path: "examples/session-04/src/domain/domain.test-types.ts",
        symbol: "acceptAppointmentId",
        lines: [1, 14],
      }],
    },
  ],
  decisions: [
    {
      invariant: "AppointmentIdとVeterinarianIdを取り違えない。",
    },
    {
      invariant: "予約はどの状態でもAppointmentIdを持つ。",
    },
    {
      invariant: "startExaminationはVeterinarianIdを受け取る。",
    },
  ],
  finalReferences: [
    "examples/final/src/domain/appointment/appointmentId.ts",
    "examples/final/src/domain/appointment/veterinarianId.ts",
  ],
};

export const guides = ([
  {
    id: "swapped-domain-identifiers",
    title: "予約IDと担当獣医師IDを逆の用途へ渡している",
    currentDesign: "AppointmentIdを必要とする関数へVeterinarianIdを、VeterinarianIdを必要とする関数へAppointmentIdを渡しています。",
    futureRisk: "どちらの型も実体はstringなので、この2行があっても型検査は成功します。",
    path: "src/domain/domain.test-types.ts",
    highlights: [{ startLineNumber: 4, endLineNumber: 10 }],
  },
  {
    id: "untyped-start-examination-id",
    title: "予約IDと担当獣医師IDがUUID文字列のままになっている",
    currentDesign: "AppointmentIdとVeterinarianIdはuuid検査だけで、用途を表すbrandがありません。PetId、OwnerId、ExamIdにはbrandがあります。",
    futureRisk: "予約IDを担当獣医師IDの位置へ渡しても、どちらもstringなのでコンパイルは通ります。",
    path: "src/domain/appointment/appointmentId.ts",
    highlights: [{ startLineNumber: 3, endLineNumber: 6 }],
  },
  {
    id: "plain-string-start-examination",
    title: "予約状態とstartExaminationがstringを受け取っている",
    currentDesign: "予約のappointmentIdと、startExaminationのveterinarianIdがstringで宣言されています。",
    futureRisk: "予約IDと担当獣医師IDを入れ替えても検出できません。",
    path: "src/domain/appointment/appointment.ts",
    highlights: [{ startLineNumber: 8, endLineNumber: 14 }],
  },
] as const) satisfies readonly CodeGuide[];

const teaching: readonly TeachingTopic[] = [
  {
    name: "用途別の Branded Type",
    definition:
      "同じ文字列形式でも、用途の違う識別子は別の型として扱います。zod の brand を付けると、互いに代入できない型ができます。",
    before: {
      sources: ["examples/session-03/src/domain/appointment/appointmentId.ts"],
      code: `const schema = z.string().uuid();

export type AppointmentId = z.infer<typeof schema>;
export const AppointmentId = { schema, parse: schema.parse } as const;`,
    },
    after: {
      sources: ["examples/session-04/src/domain/appointment/appointmentId.ts"],
      code: `const schema = z.string().uuid().brand<"AppointmentId">();

export type AppointmentId = z.infer<typeof schema>;
export const AppointmentId = { schema, parse: schema.parse } as const;`,
    },
    why: "AppointmentIdとVeterinarianIdは、どちらもUUID形式のstringです。uuid検査だけでは相互に代入できます。演習ではPetId、OwnerId、ExamIdの実装を手本にして、それぞれ別のbrandを付けます。区別するのは値の形式ではなく用途です。",
  },
  {
    name: "識別子をドメインモデルと状態遷移で利用する",
    definition:
      "予約の状態を表す型・状態遷移関数を、作成した Branded Type を利用する形に変更します。",
    before: {
      sources: [
        "examples/session-03/src/domain/appointment/appointment.ts",
        "examples/session-03/src/domain/appointment/transitions.ts",
      ],
      code: `export type Scheduled = Readonly<{
  kind: "Scheduled";
  appointmentId: string;
  // ...
}>;

export const startExamination = (
  appointment: CheckedIn,
  veterinarianId: string,
  examinationStartedAt: string,
): InExamination =>`,
    },
    after: {
      sources: [
        "examples/session-04/src/domain/appointment/appointment.ts",
        "examples/session-04/src/domain/appointment/transitions.ts",
      ],
      code: `export type Scheduled = Readonly<{
  kind: "Scheduled";
  appointmentId: AppointmentId;
  // ...
}>;

export const startExamination = (
  appointment: CheckedIn,
  veterinarianId: VeterinarianId,
  examinationStartedAt: string,
): InExamination =>`,
    },
    why: "識別子型を定義しただけでは、予約状態と遷移関数がstringを受け取るままです。予約の6状態にあるappointmentIdをAppointmentIdへ変え、startExaminationの引数とInExaminationのveterinarianIdをVeterinarianIdへ変えます。入力から状態遷移まで同じ型を使うと、取り違えを型検査で止められます。",
  },
  {
    name: "@ts-expect-error による型テスト",
    definition:
      "わざとコンパイルエラーになるコードを書き、その行で確かにコンパイルエラーが発生することを検査します。もし誰かが実装を変更して意図せずコンパイルエラーが出なくなってしまった場合、@ts-expect-error は「不要なエラー抑制を行なっている」ことになり、逆にコンパイルエラーとなります。",
    before: {
      sources: ["examples/session-03/src/domain/domain.test-types.ts"],
      code: `const acceptAppointmentId = (_id: AppointmentId): void => undefined;
const acceptVeterinarianId = (_id: VeterinarianId): void => undefined;

acceptAppointmentId(veterinarianId);
acceptVeterinarianId(appointmentId);`,
    },
    after: {
      sources: ["examples/session-04/src/domain/domain.test-types.ts"],
      code: `const acceptAppointmentId = (_id: AppointmentId): void => undefined;
const acceptVeterinarianId = (_id: VeterinarianId): void => undefined;

// @ts-expect-error VeterinarianIdをAppointmentIdとして使えません。
acceptAppointmentId(veterinarianId);

// @ts-expect-error AppointmentIdをVeterinarianIdとして使えません。
acceptVeterinarianId(appointmentId);`,
    },
    why: "実行時テストでは、間違えた値を渡すとコンパイルエラーになることを確かめられません。@ts-expect-errorは次の行に型エラーが必要だと宣言します。後から2つの識別子が同じ型へ戻ると、不要なエラー抑制として型検査が失敗します。",
  },
];

const narrative = {
  requirement: "診察開始の入力にある予約IDと担当獣医師IDを、用途ごとに区別して扱う。",
  currentRisk: "AppointmentIdとVeterinarianIdは、どちらもUUID検査済みのstringです。startExaminationへ逆の順番で渡しても、型検査では止まりません。",
  design: "2つの識別子を別々のBranded Typeで定義し、予約状態とstartExaminationまで同じ型を使う。",
  limitation: "異なる用途は区別できますが、同じAppointmentId型を持つ別の予約を選ぶ誤りは型だけでは検出できない。",
  legacy: "最初に、AppointmentIdとVeterinarianIdを実際に逆の用途へ渡しているコードを読みます。そのうえで、2つの識別子にbrandがなく、予約状態とstartExaminationにもstringが残っていることを確認します。",
  fallback: "現在の3ステップを順に開き、まずAppointmentIdとVeterinarianIdに別々のbrandを付けます。次に予約状態とstartExaminationへ反映し、取り違えがコンパイルエラーになることを型テストで確かめます。相互レビューの約束事はS2のリンク先を確認します。",
} as const;

const exerciseSession: ExerciseSessionSummary = session;

export const workspace = ({
  slug: session.slug,
  snapshot: session.snapshot,
  initialFile: "exercises/semantic-identifiers.test.ts",
  description: "診察開始で使う予約IDと獣医師IDを、開始snapshotで確認します。",
  visibleFiles: [
    "exercises/semantic-identifiers.test.ts",
    "test/regression/state-modeling.test.ts",
    "src/domain/appointment/appointmentId.ts",
    "src/domain/appointment/veterinarianId.ts",
    "src/domain/appointment/appointment.ts",
    "src/domain/appointment/transitions.ts",
    "src/domain/domain.test-types.ts",
  ],
} as const) satisfies SessionWorkspace;

const projectFiles = projectFilesForSnapshot(session.snapshot);
const typecheckCommand =
  "pnpm --filter @fp-with-ts/clinic-session-03 typecheck";
const solutionSteps = await Promise.all(
  session.steps.map(async (step) => ({
    step,
    presentation: step.solutions[0].presentation ?? "excerpt",
    snippets: await loadSolutionSnippets(step),
  })),
);
const chapters = [
  { id: "incident", label: "今回つくるもの" },
  { id: "legacy", label: "コードを読み、失敗を再現する" },
  { id: "teach", label: "使う型を知る" },
  { id: "refactor", label: "型で閉じる" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
const commonReviewChecks = [
  "`as` によるキャストが入っていないか全文検索して確認する。",
  "`git diff --stat -- examples/session-03` で今回の snapshot だけを確認する。`git status --short` で想定外の path がないか確認する。",
  "型検査では確認できないことを、テストまたは実行時に確認して記録する。",
] as const;
const reviewCompletionArtifacts = [
  "取り違えてはいけない値",
  "Agentへの依頼文",
  "型検査では確認できず、テストまたは実行時に確認すること",
] as const;
const businessReflectionQuestion =
  "自分の業務コードで、今回と同種の問題が起きうる箇所はどこですか。";
export const promisesHref =
  "/sessions/02-state-transitions/#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/02-state-transitions/",
    title: "予約の状態と遷移をモデル化する",
  },
  next: {
    href: "/sessions/04-boundaries-and-pii/",
    title: "診察開始の入力を境界で検証する",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const delegationPrompt = `次の変更を実装してください。

業務背景:
${session.incident}

依頼:
${exerciseSession.delegationPrompt.request}

取り違えてはいけない値: [言語化フェーズで書いた1文]

着手前に判断すること:
${exerciseSession.delegationPrompt.decisions.map((decision) => `- ${decision}: [自分の判断を書く]`).join("\n")}

まず配布コードと失敗しているテストを読み、上の判断と変更方針を短く説明してください。説明のあとで実装に進んでください。設計手段は既存コードに合うものを選び、選んだ理由も示してください。

受け入れ条件:
${session.steps.map((step) => `- ${step.goal}`).join("\n")}

変更範囲:
- ${session.exerciseModule.dir}/ のみ
- 最大 ${session.exerciseModule.fileBudget} ファイル・約 ${session.exerciseModule.lineBudget} 行
- 範囲外の変更が必要に見えた場合は、変更せず理由を報告する
- 型エラーを \`as\` によるキャストで回避しない

検証:
- ${session.exerciseCommand} を実行し、すべての assertion が成功すること

完了時の報告:
- 変更したファイルと判断理由
- 検証コマンドの結果
- 型だけでは守れず、テストまたはレビューに残した点`;
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header"><a href="/">WAN NYAN CLINIC</a></header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次"><ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次"><ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
        </details>
        <article class="case-file__content">
          <section id="incident">
            <h2>今回つくるもの</h2>
            <aside class="case-file__episode" aria-label="動物病院のひと幕">
              <p class="case-file__episode-label">動物病院のひと幕</p>
              {session.episode.map((line) => <p data-episode-line>{line}</p>)}
            </aside>
            <p>S1で「どの予約を、どの獣医師が開始するか」と決めた入力を、用途別の型で表します。</p>
            <h3 data-story-stage="use-case">追加したい機能</h3>
            <p>{narrative.requirement}</p>
            <h3 data-story-stage="pitfall">素朴な実装の落とし穴</h3>
            <p>{narrative.currentRisk}</p>
            <h3 data-story-stage="goal">このセッションのゴール</h3>
            <p>{narrative.design}</p>
            <h3>このセッションで守ること</h3>
            <ul class="decision-list">{session.decisions.map(({ invariant }) => <li>{invariant}</li>)}</ul>
            <p>今回の変更は <code>{session.exerciseModule.dir}</code> 内の1モジュールに限定します。</p>
          </section>

          <section id="legacy" class="code-playground">
            <h2>コードを読み、失敗を再現する</h2>
            <p>{narrative.legacy}</p>
            <p>
              編集する範囲は <code>{session.exerciseModule.dir}</code>、変更するファイル数は最大
              {session.exerciseModule.fileBudget}ファイル・約{session.exerciseModule.lineBudget}行です。
            </p>
            <CodeGuideCards guides={guides} projectFiles={projectFiles} />
            <h3>取り違えたまま型検査する</h3>
            <p><code>acceptAppointmentId</code> と <code>acceptVeterinarianId</code> の呼び出しは、渡す値が逆です。この状態で型検査を実行します。</p>
            <figure class="code-block" data-typecheck-reproduction>
              <figcaption>型検査コマンド</figcaption>
              <Code code={typecheckCommand} lang="shell" />
              <p><strong>期待結果:</strong> 取り違えた2行が残っていても、型検査は成功します。</p>
            </figure>
            <p>型検査が成功したこと自体が失敗の再現です。現在の <code>AppointmentId</code> と <code>VeterinarianId</code> は、どちらもUUID検査済みの <code>string</code> なので、TypeScriptには用途の違いが見えません。</p>
            <h3>修正前の失敗を確認する</h3>
            <p>修正前は、次の{session.steps.length}件に対応する演習テストが失敗します。</p>
            <ul class="exercise-failures" aria-label="修正前に確認する問題">
              {session.steps.map((step) => <li>{step.startingFailure}</li>)}
            </ul>
            <CommandBlock phase="red" command={session.exerciseCommand} expected={`${session.steps.length}件の演習テストが失敗します。`} />
            <p>ブラウザ内の変更はローカルへ反映されません。</p>
            <div data-code-explorer={workspace.slug}>
              <CodeExplorer
                client:load
                workspace={workspace}
                projectFiles={projectFiles}
                initialCommand={session.exerciseCommand}
              />
            </div>
          </section>

          <section id="teach">
            <h2>事前知識（{session.timeBreakdown.teach}分）</h2>
            <p>この回で利用する型について確認します。配布コードの書き方を before、次のスナップショットの書き方を after として並べています。</p>
            {teaching.map((topic) => (
              <article class="teaching-topic">
                <h3>{topic.name}</h3>
                <p>{topic.definition}</p>
                <div class="teaching-topic__diff">
                  <figure class="code-block">
                    <figcaption>
                      before:
                      {topic.before.caption === undefined ? topic.before.sources?.map((source, index) => (
                        <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                      )) : <span>{topic.before.caption}</span>}
                    </figcaption>
                    <Code code={topic.before.code} lang="ts" />
                  </figure>
                  <figure class="code-block">
                    <figcaption>
                      after:
                      {topic.after.caption === undefined ? topic.after.sources?.map((source, index) => (
                        <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                      )) : <span>{topic.after.caption}</span>}
                    </figcaption>
                    <Code code={topic.after.code} lang="ts" />
                  </figure>
                </div>
                {topic.example === undefined ? null : (
                  <figure class="code-block" data-teaching-example>
                    <figcaption>{topic.example.caption}</figcaption>
                    <Code code={topic.example.code} lang="ts" />
                  </figure>
                )}
                <p class="teaching-topic__why">{topic.why}</p>
              </article>
            ))}
          </section>

          <section id="refactor">
            <h2>演習</h2>
            <h3>進め方: 言語化 → Agentへの依頼 → 検証</h3>
            <ol class="adv-flow">
              <li><strong>言語化（{session.adv.articulate}分）</strong>: 取り違えてはいけない値を1文で書く。</li>
              <li><strong>依頼（{session.adv.delegate}分）</strong>: その1文と自分の判断をテンプレートへ入れ、Agent に依頼する。</li>
              <li><strong>検証（{session.adv.verify}分）</strong>: 型、テスト、差分の範囲を確認する。</li>
            </ol>
            <div class="delegation-prompt">
              <h3>プロンプトのテンプレート</h3>
              <p>角括弧の中は、事故と配布コードを読んだ自分の判断で埋めます。技法名や完成形を先に指定する必要はありません。</p>
              <pre><code>{delegationPrompt}</code></pre>
            </div>
            <h3>この演習で解決しないこと</h3>
            <p>{narrative.limitation}</p>
            <h3 data-solution-heading>{exerciseSession.solutionPresentation === "completed-file" ? "完成ファイルの解答例" : "ステップごとの解答"}</h3>
            {exerciseSession.solutionPresentation === "completed-file" ? (
              <div class="before-after" aria-label="業務結果と非同期例外経路の見比べ方">
                <p><strong>演習の開始時点:</strong> 予期できる業務 Result と、保存処理が reject する技術的な例外経路を分けて読む。</p>
                <p><strong>完成例:</strong> 下のすべての target file には、後続 step を含む完成状態が表示される。</p>
              </div>
            ) : null}
            {solutionSteps.map(({ step, presentation, snippets }) => (
              <div class="solution-step">
                <details class="step-solution" data-presentation={presentation}>
                  <summary>{step.goal}</summary>
                  {presentation === "completed-file" ? (
                    <p class="step-solution__completed-file-note">この完成例には後続 step を含みます。すべての target file を反映してから検証します。</p>
                  ) : null}
                  {snippets.map(({ solution, code }) => (
                    <section class="step-solution__snippet">
                      <h4><code>{solution.path}</code></h4>
                      <Code code={code} lang="ts" />
                    </section>
                  ))}
                </details>
              </div>
            ))}
            <CommandBlock phase="green" command={session.exerciseCommand} expected="演習テストがすべて成功します。" />
            <h3>演習を完了できないとき</h3>
            <p>{narrative.fallback}</p>
          </section>

          <section id="review">
            <h2>レビューと持ち帰り</h2>
            <div class="exercise-review-checklist">
              <h3>個人で確認する</h3>
              <ol>{commonReviewChecks.map((check) => <li>{check}</li>)}</ol>
              <p>前のセッションの未commit差分は残して構いません。reset、stash、commit は不要です。</p>
              <p><strong>残すもの:</strong> {reviewCompletionArtifacts.join("、")}</p>
              <h3>業務へ持ち帰る</h3>
              <p>{businessReflectionQuestion}</p>
            </div>
            <section class="peer-review-panel">
              <h3>班内相互レビュー（{session.peerReview.minutes}分・{headcount}）</h3>
              <p><a href={promisesHref}>進行上の約束事を確認する</a></p>
              <ol>{session.peerReview.questions.map((question) => <li>{question}</li>)}</ol>
            </section>
          </section>
        </article>
      </div>
      <nav class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
    </main>
  </div>
</BaseLayout>
