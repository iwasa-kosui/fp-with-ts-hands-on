---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/03-semantic-identifiers";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("03-semantic-identifiers");
if (session === undefined) {
  throw new Error("Unknown session: 03-semantic-identifiers");
}

const teaching = [
  {
    name: "用途別の Branded Type",
    definition:
      "同じ文字列形式でも、用途の違う識別子は別の型として扱います。zod の brand を付けると、互いに代入できない型ができます。",
    before: {
      sources: ["examples/session-03/src/domain/ids/petId.ts"],
      code: `const schema = z.string().uuid();

export type PetId = z.infer<typeof schema>;
export const PetId = { schema, parse: schema.parse } as const;`,
    },
    after: {
      sources: ["examples/session-04/src/domain/ids/petId.ts"],
      code: `const schema = z.string().uuid().brand<"PetId">();

export type PetId = z.infer<typeof schema>;
export const PetId = { schema, parse: schema.parse } as const;`,
    },
    why: "before の PetId は string の別名です。名前は付いていますが、OwnerId も ExamId も同じ string なので、互いに代入できます。after では brand が付いた別の型になり、代入すると型検査で止まります。ここで区別しているのは値の形式ではなく用途です。3つとも実体は同じ UUID の文字列なので、z.string().uuid() のバリデーションでは区別はできません。配布済みの ExamId が同じ書き方をしているので、お手本として読んでから残りも修正しましょう。",
  },
  {
    name: "識別子をドメインモデルと状態遷移で利用する",
    definition:
      "予約の状態を表す型・状態遷移関数を、作成した Branded Type を利用する形に変更します。",
    before: {
      sources: ["examples/session-03/src/domain/appointment/appointment.ts"],
      code: `export type Scheduled = Readonly<{
  kind: "Scheduled";
  appointmentId: string;
  petId: string;
  ownerId: string;
  scheduledAt: string;
  reason: string;
}>;`,
    },
    after: {
      sources: [
        "examples/session-04/src/domain/appointment/appointment.ts",
        "examples/session-04/src/domain/appointment/transitions.ts",
      ],
      code: `export type Scheduled = Readonly<{
  kind: "Scheduled";
  appointmentId: AppointmentId;
  petId: PetId;
  ownerId: OwnerId;
  scheduledAt: string;
  reason: string;
}>;

export const startExamination = (
  appointment: CheckedIn,
  veterinarianId: VeterinarianId,
  examinationStartedAt: string,
): InExamination =>`,
    },
    why: "before では appointmentId も petId も ownerId も string です。3つを取り違えて代入したり、引数の順番を入れ替えたりしても、コンパイルは通ってしまいます。after では3つがそれぞれ別の型になり、互いに代入ができなくなります。遷移関数の veterinarianId も同じで、引数の型を string のままにすると、間違えて予約の識別子を担当獣医師の識別子として渡しても型検査で検出できません。状態の型と関数の引数の両方で Branded Types を利用することで、取り違えを防止することができます。",
  },
  {
    name: "@ts-expect-error による型テスト",
    definition:
      "わざとコンパイルエラーになるコードを書き、その行で確かにコンパイルエラーが発生することを検査します。もし誰かが実装を変更して意図せずコンパイルエラーが出なくなってしまった場合、@ts-expect-error は「不要なエラー抑制を行なっている」ことになり、逆にコンパイルエラーとなります。",
    before: {
      sources: ["examples/session-03/src/domain/domain.test-types.ts"],
      code: `export {};`,
    },
    after: {
      sources: ["examples/session-04/src/domain/domain.test-types.ts"],
      code: `const acceptPetId = (_petId: PetId): void => undefined;

// @ts-expect-error 飼い主の識別子を、ペットの識別子として渡せません。
acceptPetId(scheduled.ownerId);

// @ts-expect-error 予約の識別子を、担当獣医師の識別子として渡せません。
startExamination(checkedIn, scheduled.appointmentId, "2026-08-30T06:30:00.000Z");`,
    },
    why: "通常のテストは実際に実行することで挙動が正しいか確認します。しかし、「間違えた値を渡すとコンパイルエラーが出ること」は通常の方法では確かめられません。@ts-expect-error は、次の行にエラーが出ることを期待する指示です。もし誰かが実装を変更して意図せずコンパイルエラーが出なくなってしまった場合、@ts-expect-error は「不要なエラー抑制を行なっている」ことになり、逆にコンパイルエラーとなります。型で守っている部分が後から壊れたときに気付ける形にしておきます。",
  },
] as const;
---

<SessionLayout session={session} teaching={teaching}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    teaching={teaching}
    narrative={{
      requirement: "予約・ペット・飼い主・担当獣医師の識別子を、取り違えられない形で扱う。",
      currentRisk: "4種類の識別子がすべて同じ UUID の文字列なので、ラボから届いた検査結果を別の患者へ結び付けてもコンパイルエラーにならない。",
      design: "ワークフローが受け取る型を用途ごとの Branded Type で定義し、予約の状態を表す型・状態遷移関数の両方で利用する。",
      limitation: "データベースなどの永続化層から取り出した値が正しい識別子かどうかは、境界で parse して確かめる必要がある。",
      nextQuestion: "外部から入力される JSON が期待した形になっているかをどこで確かめるか。",
      legacy: "配布済みの ExamId と、素の string のままの PetId・OwnerId を読み比べ、予約の各状態が識別子をどのように定義しているかを確認します。",
      reviewFocus: "識別子の型を、状態の型と状態遷移関数の引数の両方で利用できているか",
      fallback: "現在の3ステップを順に開き、まず PetId と OwnerId に brand をコピペします。次に予約の各状態を表す型と状態遷移関数にも反映し、取り違えがコンパイルエラーになることを型テストで確かめます。相互レビューの約束事はS2のリンク先を確認します。",
    }}
  />
</SessionLayout>
