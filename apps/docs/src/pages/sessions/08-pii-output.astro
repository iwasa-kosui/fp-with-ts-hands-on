---
import CommandBlock from "../../components/CommandBlock.astro";
import SessionCodePlayground from "../../components/code-explorer/SessionCodePlayground.astro";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";
const session = sessionBySlug("08-pii-output");
if (session === undefined) throw new Error("Unknown session: 08-pii-output");
---
<SessionLayout session={session}>
  <ol slot="toc"><li><a href="#incident">事故と不変条件</a></li><li><a href="#work">2関数の作業</a></li><li><a href="#code-playground">ブラウザで試す</a></li><li><a href="#technique">技法と限界</a></li><li><a href="#verification">検証</a></li><li><a href="#reflection">振り返り</a></li></ol>
  <section id="incident"><h2>電話番号の意図しない出力を止める</h2><p data-actor="飼い主"><strong>登場人物:</strong> 飼い主の電話番号がデバッグ用 JSON と Node inspect に出力されました。</p><p><strong>事故:</strong> ID の意味を守っても、PII を通常の文字列として出力できました。</p><p><strong>守る不変条件:</strong> 連絡先を JSON、文字列化、inspect の既定出力へ露出させない。</p></section>
  <section id="work"><h2>出力時に秘匿する</h2><CommandBlock phase="red" command="pnpm exercise:08" expected="飼い主の電話番号が JSON.stringify に現れるため失敗します。" /><h3>先に読むファイル</h3><ul><li><code>examples/session-08/exercises/pii-redaction.test.ts</code></li><li><code>examples/session-08/src/domain/ownerContact.ts</code></li><li><code>examples/session-08/src/domain/shared/sensitive.ts</code></li></ul><h3>作業範囲（最大2関数）</h3><p>提供済みの <code>Sensitive.of</code> を使い、<code>OwnerContact.parse</code> を編集して検証済み連絡先を秘匿値として保持します。</p></section>
  <SessionCodePlayground slug={session.slug} />
  <section id="technique"><h2>Sensitive を出力境界に置く</h2><p><strong>使う技法:</strong> <code>Sensitive</code> が <code>toJSON</code>、<code>toString</code>、Node inspect を <code>[REDACTED]</code> にします。</p><p><strong>この技法の限界:</strong> <code>unwrap</code> 後の利用、アクセス権、保持期間、外部送信先は型だけでは決まりません。</p><CommandBlock phase="green" command="pnpm exercise:08" expected="PII が既定の文字列出力へ現れません。" /></section>
  <section id="verification"><h2>3つの範囲で確かめる</h2><dl><dt>型で守ること</dt><dd>連絡先を通常 string と区別し、明示的な unwrap を要求します。</dd><dt>統合テストで守ること</dt><dd><code>pnpm --filter @fp-with-ts/clinic-session-08 test</code> と JSON・String・inspect の出力を確認します。</dd><dt>人がレビューすること</dt><dd>誰がどの画面で PII を見られるか、ログや監査の allowlist を確認します。</dd></dl></section>
  <section id="reflection"><h2>振り返り</h2><p>文字列化やログ出力で漏れる可能性がある機密値は何ですか。</p><p><a href="/sessions/09-typed-failures/">次へ: 失敗を値にする</a></p></section>
</SessionLayout>
