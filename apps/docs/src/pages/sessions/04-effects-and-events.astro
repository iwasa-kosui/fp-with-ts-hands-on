---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/04-effects-and-events";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("04-effects-and-events");
if (session === undefined) throw new Error("Unknown session: 04-effects-and-events");
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement: "誰がいつ診察を開始したかを決定的なイベントとして作り、状態と監査記録を1回の非同期保存で残す。",
      legacy: "直接生成する時刻・ID、Promise + try/catch、2つの書き込み口を読みます。",
      technique: "S3 の同期 startExamination を保ち、効果付きの startExaminationWithEffects だけを Clock / EventIdGenerator、single store(event)、ResultAsync と andThrough で組み立てます。adapter の診断エラーは mapErr で cause のない公開エラーへ変換します。",
      limitation: "in-memory の原子性は実装上の約束であり、本番永続化では transaction が必要です。",
      reviewFocus: "保存を andThen で値ごと置き換えず、andThrough 後も event.aggregateState が残るか。",
      fallback: "各解答欄はimportと後続stepを含む完成ファイルをtargetごとに示します。表示された全target fileを反映した後に同じexerciseをGREENにする方式で、1stepずつの個別GREENは約束しません。自動overlayではtypecheck・通常回帰・exerciseを確認済みですが、人が8〜10分で反映できるかは現地リハーサルで確認します。ステップ3は講師デモに切り替えても相互レビュー自体は残します。",
    }}
  />
</SessionLayout>
