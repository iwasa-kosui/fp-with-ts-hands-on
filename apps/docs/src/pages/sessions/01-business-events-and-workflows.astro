---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SessionSummary } from "../../sessions/types";
import "../../styles/sessions.css";

export const session: SessionSummary = {
  slug: "01-business-events-and-workflows",
  snapshot: undefined,
  sequence: "01",
  kind: "workshop",
  title: "ビジネスイベントからワークフローを描く",
  durationMinutes: 15,
  timeBreakdown: { brief: 3, teach: 4, exercise: 6, review: 2 },
  animal: { name: "CAT", type: "cat", avatar: "🐈" },
  summary: "動物病院の一日を描いた散文からドメインイベントを拾い、集約の境界を班で引きます。",
  episode: [
    "開院3分で、柴犬は問診票を踏み、猫は棚へ登り、受付の電話は2本同時に鳴りました。",
    "受付、看護師、獣医師、会計担当は仕事をこなしますが、同じ一日を全員が別の言葉で説明します。",
    "システム改修の前に、人間同士の仕様が同期していないことが判明しました。",
  ],
  incident: "業務全体のどこからどこまでが診察開始のワークフローなのか、担当者ごとに認識が揃っていない。",
  steps: [],
  decisions: [],
  finalReferences: [],
};

const timing = session.timeBreakdown;

type DomainEvent = Readonly<{
  id: string;
  name: string;
  actor: string;
  command: string;
  aggregate: string;
}>;

// 時系列の順序は配列の並び順で表す。散文から実際に拾えるイベントだけを並べている。
const domainEvents: readonly DomainEvent[] = [
  {
    id: "checked-in",
    name: "来院が受け付けられた",
    actor: "受付スタッフ",
    command: "来院を受け付ける",
    aggregate: "予約",
  },
  {
    id: "intake-recorded",
    name: "問診と体重が記録された",
    actor: "動物看護師",
    command: "問診と体重測定を行う",
    aggregate: "カルテ",
  },
  {
    id: "examination-started",
    name: "診察が開始された",
    actor: "獣医師",
    command: "診察を始める",
    aggregate: "予約",
  },
  {
    id: "findings-recorded",
    name: "所見が記録された",
    actor: "獣医師",
    command: "所見を記録する",
    aggregate: "カルテ",
  },
  {
    id: "billing-completed",
    name: "会計が完了した",
    actor: "受付スタッフ",
    command: "会計を行う",
    aggregate: "会計",
  },
] as const;

const teacherDemoEvent = domainEvents[0];

// 集約ごとにイベントをまとめる。並び順は集約が最初に現れた順で、時系列の情報は各イベントの order に残す。
const domainEventsWithOrder = domainEvents.map((event, index) => ({
  ...event,
  order: index + 1,
}));
const aggregateNames = [
  ...new Set(domainEventsWithOrder.map((event) => event.aggregate)),
];
const aggregateGroups = aggregateNames.map((aggregate) => ({
  aggregate,
  events: domainEventsWithOrder.filter(
    (event) => event.aggregate === aggregate,
  ),
}));

const excalidrawTemplatePath =
  "docs/event/session-01-event-storming.excalidraw";
const excalidrawTemplateUrl = `https://github.com/iwasa-kosui/fp-with-ts-hands-on/blob/main/${excalidrawTemplatePath}`;
const chapters = [
  { id: "incident", label: "何が起きたか" },
  { id: "workflow", label: "ワークフローを描く" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
export const navigation = ({
  previous: {
    href: "/sessions/00-system-handover/",
    title: "業務とシステムを引き継ぐ",
  },
  next: {
    href: "/sessions/02-state-transitions/",
    title: "予約の状態と遷移をモデル化する",
  },
} as const);
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header">
      <a href="/">WAN NYAN CLINIC</a>
    </header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
        <aside class="case-file__episode" aria-label="動物病院のひと幕">
          <p class="case-file__episode-label">動物病院のひと幕</p>
          {session.episode.map((line) => <p data-episode-line>{line}</p>)}
        </aside>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </details>
        <article class="case-file__content">
  <section id="incident">
    <h2>ブリーフィング{timing.brief}分: 動物病院の一日を読む</h2>
    <p>
      この15分はコードを書きません。次の文章から業務上起きた出来事を拾い、集約ごとの境界を班で引けるようになることが目標です。
    </p>
    <div class="incident-report">
      <p>
        よく晴れた朝、開院してすぐの時間帯に、飼い主が数日前から元気のない柴犬を連れて来院しました。受付スタッフは前日に電話で受けていた予約を確認し、飼い主に問診票を渡して受付を行いました。待合室にはほかの飼い主と猫もいて、少し賑やかな雰囲気でした。
      </p>
      <p>
        しばらく待ってもらったあと、動物看護師が診察室前に飼い主を呼び、問診票の内容を確認しながら体重を測り、来院時の症状や直近の食欲、排せつの様子について丁寧に聞き取りました。動物看護師は、柴犬がいつもより落ち着かない足取りだったことも合わせて記録しました。
      </p>
      <p>
        続いて担当の獣医師が診察室へ飼い主と犬を呼び入れ、診察を始めました。獣医師は聴診と触診を行い、看護師が記録した体重の変化も参考にしながら、飼い主に自宅での様子をさらに詳しく尋ねました。今回は追加の検査は必要ないと判断し、診察を終えます。獣医師は所見と自宅での過ごし方の注意点をカルテに書き留め、飼い主にも口頭で分かりやすく説明しました。獣医師は次の患者の準備のため看護師に一声かけ、診察室を出ました。
      </p>
      <p>
        診察が終わると、受付スタッフが会計を担当しました。診察料と処方した薬の代金を項目ごとに計算し、内訳を示しながら飼い主に伝えて支払いを受け取りました。受付スタッフは会計が済んだことを記録しました。飼い主は処方された薬を受け取り、家での飲ませ方をもう一度確認してから、笑顔で動物病院をあとにしました。受付スタッフは待合室の様子を見渡し、次に呼ぶ飼い主の準備に取りかかりました。
      </p>
    </div>
  </section>

  <section id="workflow">
    <h2>ワークフローを描く</h2>

    <h3>説明{timing.teach}分: 語彙の確認・ドメインイベントの見つけ方</h3>
    <p>今回はポリシー、読み取りモデル、外部システムは扱いません。</p>
    <dl>
      <dt>ドメインイベント</dt>
      <dd>業務上起きた出来事。CheckedIn Eventのように過去形で表します。</dd>
      <dt>コマンド</dt>
      <dd>
        誰かが出した依頼。コマンドが起点となり、ドメインイベントが発生します。
      </dd>
      <dt>ワークフロー</dt>
      <dd>
        一つの依頼を受けてドメインイベントを出すまでのひとかたまりの処理。
      </dd>
      <dt>集約</dt>
      <dd>
        コマンドを受けて状態を変更し、ドメインイベントを発生させるまでのひとまとまり。中は一貫性を保ちながら一緒に変わります。
      </dd>
    </dl>
    <p>手順は次の4段です。班ワーク中もこのページで参照できます。</p>
    <ol class="exercise-steps">
      <li>起きた出来事を過去形で書き出す</li>
      <li>時間の順に並べる</li>
      <li>それぞれの出来事が、誰の何の依頼で起きたかを添える</li>
      <li>同じ集約を変えるドメインイベントをまとめ、集約に名前を付ける</li>
    </ol>
    <p>
      講師は文章からドメインイベントを1件だけ拾い、コマンドとアクター、集約を添えて
      Excalidraw に置いて見せます。
    </p>
    <article
      class="decision-card"
      data-domain-event-id={teacherDemoEvent.id}
      data-aggregate={teacherDemoEvent.aggregate}
    >
      <h4>講師実演: {teacherDemoEvent.name}</h4>
      <p><strong>誰の依頼か:</strong> {teacherDemoEvent.actor}</p>
      <p><strong>コマンド:</strong> {teacherDemoEvent.command}</p>
      <p><strong>集約:</strong> {teacherDemoEvent.aggregate}</p>
    </article>

    <h3>
      班ワーク{timing.exercise}分: 残りのドメインイベントを拾い、境界を引く
    </h3>
    <p>
      残りのドメインイベントを文章から拾って時系列に並べ、各イベントに誰の何の依頼で起きたかを添えます。そのうえで、同じ集約を変えるドメインイベントをまとめて囲み、集約に名前を付けます。
    </p>
    <p>
      班ワークは次の Excalidraw テンプレートで行います。TA が excalidraw.com
      でテンプレートを開いて Live collaboration を開始し、班へリンクを配ります。
    </p>
    <p>
      <a href={excalidrawTemplateUrl}><code>{excalidrawTemplatePath}</code></a>
    </p>
  </section>

  <section id="review">
    <h2>レビュー{timing.review}分: 講師回答例と粒度の違いを比べる</h2>
    <p>
      班の結果と次の講師回答例を見比べます。集約ごとにドメインイベントをまとめてあります。カード上部の数字は時系列の順序です。
    </p>
    <div class="aggregate-groups">
      {
        aggregateGroups.map((group) => (
          <section class="aggregate-group" data-aggregate={group.aggregate}>
            <h3>集約: {group.aggregate}</h3>
            <ol class="decision-list">
              {group.events.map((event) => (
                <li
                  class="decision-card"
                  data-domain-event-id={event.id}
                  data-aggregate={event.aggregate}
                >
                  <p class="event-order">{event.order}件目</p>
                  <h4>{event.name}</h4>
                  <p>
                    <strong>誰の依頼か:</strong> {event.actor}
                  </p>
                  <p>
                    <strong>コマンド:</strong> {event.command}
                  </p>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
    <p>
      予約集約の中で、S2 からは「診察を始める」という依頼を詳しく見ていきます。
    </p>
    <p>
      ドメインイベントの粒度に着目して班で共有してみましょう（正誤は気にする必要はありません）。
      一つのドメインイベントをさらに細かく分けているか、逆に複数の出来事を一つにまとめているか、などの観点で比べてみましょう。
    </p>
  </section>
        </article>
      </div>
      <nav class="case-file__session-nav" aria-label="前後のセッション">
        {
          navigation.previous === undefined ? null : (
            <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
          )
        }
        {
          navigation.next === undefined ? null : (
            <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
          )
        }
      </nav>
    </main>
  </div>
</BaseLayout>
