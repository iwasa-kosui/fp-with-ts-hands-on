---
import EventStormingRopComparison from "../../components/EventStormingRopComparison.astro";
import RailwayOrientedProgramming from "../../components/RailwayOrientedProgramming.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SessionSummary } from "../../sessions/types";
import "../../styles/sessions.css";

export const session: SessionSummary = {
  slug: "01-business-events-and-workflows",
  snapshot: undefined,
  sequence: "01",
  kind: "workshop",
  title: "EventStormingとROPで予約キャンセルを設計する",
  durationMinutes: 15,
  timeBreakdown: { brief: 2, teach: 7, exercise: 4, review: 2 },
  animal: { name: "CAT", type: "cat", avatar: "🐈" },
  summary: "予約がキャンセルされた出来事からコマンドと業務ルールを逆算し、集約、ROP、イベント出力、永続化境界へ写します。",
  episode: [
    "会計済みの予約を、受付担当者が誤ってキャンセルできました。",
    "理由のないキャンセルが保存され、どの条件を確認したか説明できません。",
    "実装へ進む前に、依頼、業務ルール、集約、成功時に起きる出来事を決めます。",
  ],
  incident: "予約キャンセルで、実行者、予約の存在、現在状態、理由を一貫して確認できていない。",
  steps: [],
  decisions: [],
  finalReferences: [],
};

const domainEvents = [
  { id: "appointment-canceled", name: "予約がキャンセルされた" },
] as const;

const notation = [
  { name: "ドメインイベント", description: "業務で起きた出来事(イベント)を書いてください。ドメインイベントは過去形（〇〇された）で表現します。" },
  { name: "コマンド", description: "ドメインイベントが発生する起点となる指示や操作を書いてください" },
  { name: "アクター", description: "コマンドを発する人、あるいは役割を書いてください" },
  { name: "集約", description: "状態の整合性を守るドメインモデルを書いてください。" },
  { name: "Hotspot", description: "答えが揃わなかった点や、今後決める必要があることを書いてください。" },
] as const;

const excalidrawTemplatePath = "docs/event/session-01-event-storming.excalidraw";
const excalidrawTemplateUrl =
  `https://github.com/iwasa-kosui/fp-with-ts-hands-on/blob/main/${excalidrawTemplatePath}`;

const chapters = [
  { id: "incident", label: "一つの出来事" },
  { id: "workshop", label: "コマンドと条件" },
  { id: "workflow", label: "ROPと永続化境界" },
] as const;

export const navigation = ({
  previous: {
    href: "/sessions/00-system-handover/",
    title: "業務とシステムを引き継ぐ",
  },
  next: {
    href: "/sessions/02-state-transitions/",
    title: "予約の状態と遷移をモデル化する",
  },
} as const);
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header">
      <a href="/">WAN NYAN CLINIC</a>
    </header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </details>

        <article class="case-file__content">
          <section id="incident">
            <h2>起きた出来事から業務を始める</h2>
            <aside class="case-file__episode" aria-label="動物病院のひと幕">
              <p class="case-file__episode-label">動物病院のひと幕</p>
              {session.episode.map((line) => <p data-episode-line>{line}</p>)}
            </aside>
            <p>画面やデータベース設計から考えるのではなく、実際にあるべき業務の流れから考え始めます。</p>
            <ol class="eventstorming-timeline" aria-label="事前配置するドメインイベント">
              {
                domainEvents.map((event) => (
                  <li data-domain-event-id={event.id}>
                    <span>ドメインイベント</span>
                    <strong>{event.name}</strong>
                  </li>
                ))
              }
            </ol>
            <p>この出来事から、原因となるコマンドと、成功に必要だった条件を逆算します。</p>
          </section>

          <section id="workshop">
            <h2>コマンド、業務ルール、集約を見つける</h2>

            <h3>コマンドと条件を逆算する</h3>
            <dl>
              {notation.map((item) => <Fragment><dt>{item.name}</dt><dd>{item.description}</dd></Fragment>)}
            </dl>
            <p>班で次の3問を順に話しましょう。</p>
            <ol class="exercise-steps">
              <li>この出来事は、誰が、何を依頼したことによって発生しましたか。</li>
              <li>その実行者には、予約を管理する権限がありますか。</li>
              <li>予約の状態とキャンセル理由は、どんな条件を満たす必要がありますか。</li>
            </ol>
            <div class="eventstorming-focus" aria-label="班で完成させる予約キャンセルの並び">
              <div class="eventstorming-note eventstorming-note--actor">
                <span>アクター</span>
                <strong>受付担当者</strong>
              </div>
              <span aria-hidden="true">→</span>
              <div class="eventstorming-note eventstorming-note--command">
                <span>コマンド</span>
                <strong>予約をキャンセルする</strong>
              </div>
              <span aria-hidden="true">→</span>
              <div class="eventstorming-note eventstorming-note--event">
                <span>成功時の出来事</span>
                <strong>予約がキャンセルされた</strong>
              </div>
            </div>
            <p>診察直前のキャンセルを認めるかなど、答えが揃わない点は無理に決めずHotspotとして残します。</p>
            <blockquote>
              <p>予約を管理する担当者が、診察開始前の予約だけを、キャンセルできます。キャンセルする際には、キャンセル理由を記入する必要があります。</p>
            </blockquote>
            <p>この条件は、コマンドを受けたワークフローが確認する業務ルールとしてまとめます。</p>

            <h3>業務ルール、集約、ワークフローを区別する</h3>
            <p>
              業務ワークフローはResolverから実行者と予約を受け取り、権限や存在を確認します。<code>Appointment</code>集約は、キャンセルできる状態と理由の不変条件を守り、<code>Appointment.cancel</code>から成功イベントを返します。
            </p>
            <p>この例で使う集約は一つですが、集約とワークフローが対応するわけではありません。集約は状態の整合性を守るドメインモデル、ワークフローは入出力と失敗を含めて業務判断を調整する関数です。</p>
          </section>

          <section id="workflow">
            <h2>Railway Oriented Programming と永続化層</h2>

            <h3>2本のレールを考える</h3>
            <p>
              Railway Oriented Programming（ROR）は、処理のパイプラインを鉄道のレールと分岐に見立てた考え方です。
              レールは2本存在し、一方は処理に成功した場合のルート、他方は失敗した場合のルートを表します。

              <br/>

              各工程では、何かの処理を行い、成功すればその出力を次の処理へ渡します。失敗が起きた場合は下のレールへ移ります。図からも分かる通り、一度失敗のレールに移動すれば、以降の処理はスキップされます。
            </p>
            <RailwayOrientedProgramming />

            <h3>なぜROPを利用するのか</h3>
            <p>
              それぞれの処理で発生する失敗を同じフローで扱い、その失敗を網羅的に検証することで、変更箇所とテスト観点を追いやすくなります。これにより、「キャンセル先の予約が存在しない」、「キャンセルする権限がない」などさまざまな理由で止まっても、それを適切にハンドリングでき、全体の処理のうち一部だけ処理されて不整合が発生することを防げます。
            </p>

            <h3>EventStormingを業務ワークフローへ写す</h3>
            <p>
              コマンドはワークフローの入力へ、集約は<code>Appointment.cancel</code>へ、ドメインイベントは成功出力へ対応させます。権限や状態の条件は、これらとは別にワークフロー内の業務ルールとして表します。
            </p>
            <dl>
              <dt>入力</dt>
              <dd>予約キャンセルのコマンドと、Resolverから取得した実行者・予約の現在状態。</dd>
              <dt>業務判断</dt>
              <dd>業務ルールとして実行者の権限と予約の存在を確認し、状態と理由の不変条件を守る集約の<code>Appointment.cancel</code>を実行する。</dd>
              <dt>成功時の出力</dt>
              <dd><code>AppointmentCanceled</code>。</dd>
            </dl>
            <EventStormingRopComparison />

            <h3>なぜ永続化をワークフローの両端へ置くのか</h3>
            <p>
              入力側のUser ResolverとAppointment Resolverが実行者と予約の現在状態を取得し、中心の業務ワークフローへ値として渡します。ワークフローはデータベースへ接続せずに業務ルールを評価し、条件を通過したときだけ<code>AppointmentCanceled</code>を返します。出力側のEvent Storeはそのイベントを追記し、失敗時はイベントが返らないため保存も起きません。
            </p>
            <p>
              この境界により、不正なキャンセルや途中状態が保存されず、誰がいつどの予約をキャンセルしたかを業務上の出来事として追えます。同時に、業務ルールをデータベースのAPIから切り離して値だけでテストでき、読み方や保存先が変わってもResolverとEvent Storeを差し替えるだけで中心の判断を保てます。Web向けの現在状態が必要なら、保存後のイベントからレスポンスへ変換します。
            </p>
            <aside class="decision-card">
              <h3>このハンズオンでEvent Storeを選ぶ理由</h3>
              <p>
                これはDMMF一般の必須条件ではなく、このハンズオンの設計判断です。業務ワークフローの成功の場合の出力を、そのままEvent Storeに保存します。
              </p>
            </aside>

            <h3>S1で残す成果物</h3>
            <ol>
              <li>アクター、コマンド、<code>Appointment</code>集約、<code>AppointmentCanceled</code>を順に並べた図</li>
              <li>権限、予約の存在、現在状態、理由の条件とHotspot</li>
              <li>3か所で失敗へ切り替わるROP基本図と、ResolverとEvent Storeを外側へ置いた業務ワークフロー図</li>
            </ol>
            <p>
              班ワークは <a href={excalidrawTemplateUrl}><code>{excalidrawTemplatePath}</code></a> を使います。TAが開始前にボードを開きます。
            </p>
          </section>
        </article>
      </div>

      <nav class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
    </main>
  </div>
</BaseLayout>
