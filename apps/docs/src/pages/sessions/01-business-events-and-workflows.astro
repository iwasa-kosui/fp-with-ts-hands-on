---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SessionSummary } from "../../sessions/types";
import "../../styles/sessions.css";

export const session: SessionSummary = {
  slug: "01-business-events-and-workflows",
  snapshot: undefined,
  sequence: "01",
  kind: "workshop",
  title: "ビジネスイベントからワークフローを描く",
  durationMinutes: 15,
  timeBreakdown: { brief: 3, teach: 4, exercise: 6, review: 2 },
  animal: { name: "CAT", type: "cat", avatar: "🐈" },
  summary: "予約患者と急患が並行して動く記録からドメインイベントを拾い、集約の境界と未解決の問いを班で見つけます。",
  episode: [
    "予約の柴犬ムギが受付を終えた直後、呼吸の荒い猫ソラが予約なしで運び込まれました。",
    "受付は来院順、看護師は緊急度、獣医師は診察準備の状況を見て、それぞれ別の順番を想定しています。",
    "急患を先に診る判断が、2頭の予約とカルテのどこまでを変えるのか、誰も同じ図を持っていません。",
  ],
  incident: "予約患者と急患の処理が並行し、急患優先後に予約患者の保留を記録して受付へ伝える責任について、担当者の認識が揃っていない。",
  steps: [],
  decisions: [],
  finalReferences: [],
};

const timing = session.timeBreakdown;

type DomainEvent = Readonly<{
  id: string;
  laneId: string;
  minute: number;
  name: string;
  actor?: string;
  command: string;
  aggregate: string;
}>;

export const eventStormingScenario = ({
  lanes: [
    { id: "scheduled", label: "予約患者: 柴犬ムギ" },
    { id: "emergency", label: "急患: 猫ソラ" },
  ],
  events: [
    {
      id: "mugi-checked-in",
      laneId: "scheduled",
      minute: 0,
      name: "ムギの来院が受け付けられた",
      actor: "受付スタッフ",
      command: "予約患者の来院を受け付ける",
      aggregate: "予約",
    },
    {
      id: "mugi-intake-recorded",
      laneId: "scheduled",
      minute: 4,
      name: "ムギの問診と体重が記録された",
      actor: "動物看護師",
      command: "問診と体重測定を行う",
      aggregate: "カルテ",
    },
    {
      id: "sora-walk-in-accepted",
      laneId: "emergency",
      minute: 4,
      name: "ソラの救急来院が受け付けられた",
      actor: "受付スタッフ",
      command: "予約なしの急患を受け付ける",
      aggregate: "予約",
    },
    {
      id: "sora-urgency-recorded",
      laneId: "emergency",
      minute: 6,
      name: "ソラの緊急度が記録された",
      actor: "動物看護師",
      command: "急患の状態を確認する",
      aggregate: "カルテ",
    },
    {
      id: "mugi-examination-held",
      laneId: "scheduled",
      minute: 8,
      name: "ムギの診察開始が保留された",
      command: "予約患者の診察を保留する",
      aggregate: "予約",
    },
    {
      id: "sora-examination-started",
      laneId: "emergency",
      minute: 8,
      name: "ソラの診察が開始された",
      actor: "獣医師",
      command: "急患の診察を始める",
      aggregate: "予約",
    },
    {
      id: "mugi-examination-started",
      laneId: "scheduled",
      minute: 20,
      name: "ムギの診察が開始された",
      actor: "獣医師",
      command: "予約患者の診察を始める",
      aggregate: "予約",
    },
  ] satisfies readonly DomainEvent[],
  hotspots: [
    {
      id: "examination-priority-owner",
      prompt: "獣医師が急患優先を決めたあと、ムギの診察保留を誰が予約へ記録し、受付へ伝えるのか。",
      relatedEventIds: [
        "sora-urgency-recorded",
        "mugi-examination-held",
        "sora-examination-started",
      ],
    },
  ],
} as const);

const domainEvents = eventStormingScenario.events;
const laneById = new Map<string, Readonly<{ id: string; label: string }>>(
  eventStormingScenario.lanes.map((lane) => [lane.id, lane]),
);

const teacherDemoEvent = domainEvents[0];

// 集約の型だけでなく対象の患者も区別し、別々の一貫性単位を1つに混ぜない。
const workflowLanes = eventStormingScenario.lanes.map((lane) => ({
  ...lane,
  events: domainEvents.filter((event) => event.laneId === lane.id),
}));
const aggregateKeys = [
  ...new Set(
    domainEvents.map(
      (event) => `${event.laneId}:${event.aggregate}`,
    ),
  ),
];
const aggregateGroups = aggregateKeys.map((key) => {
  const [laneId, aggregate] = key.split(":");
  return {
    aggregate,
    laneLabel: laneById.get(laneId)?.label ?? laneId,
    events: domainEvents.filter(
      (event) => event.laneId === laneId && event.aggregate === aggregate,
    ),
  };
});

const excalidrawTemplatePath =
  "docs/event/session-01-event-storming.excalidraw";
const excalidrawTemplateUrl = `https://github.com/iwasa-kosui/fp-with-ts-hands-on/blob/main/${excalidrawTemplatePath}`;
const chapters = [
  { id: "incident", label: "何が起きたか" },
  { id: "workflow", label: "ワークフローを描く" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
export const navigation = ({
  previous: {
    href: "/sessions/00-system-handover/",
    title: "業務とシステムを引き継ぐ",
  },
  next: {
    href: "/sessions/02-state-transitions/",
    title: "予約の状態と遷移をモデル化する",
  },
} as const);
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header">
      <a href="/">WAN NYAN CLINIC</a>
    </header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </details>
        <article class="case-file__content">
  <section id="incident">
    <h2>ブリーフィング{timing.brief}分: 動物病院の一日を読む</h2>
    <aside class="case-file__episode" aria-label="動物病院のひと幕">
      <p class="case-file__episode-label">動物病院のひと幕</p>
      {session.episode.map((line) => <p data-episode-line>{line}</p>)}
    </aside>
    <p>
      この15分はコードを書きません。担当者ごとの記録を1枚の時間軸へ合わせ、並行する仕事と集約の境界、まだ決められていない点を班で見つけることが目標です。
    </p>
    <div class="incident-report">
      <h3>受付スタッフの記録</h3>
      <p>
        9:00、受付スタッフは予約どおりに来院した柴犬ムギの受付を済ませました。9:04、呼吸の荒い猫ソラが予約なしで運び込まれたため、救急来院として受け付け、ムギの飼い主には診察が遅れるかもしれないと伝えました。
      </p>
      <h3>動物看護師の記録</h3>
      <p>
        動物看護師は9:04までムギの問診と体重測定を行っていました。ソラの到着後に呼吸と意識を確認し、9:06に緊急度が高いと記録して獣医師へ伝えました。ムギの診察順を変えるかどうかは、獣医師が決めるものだと考えていました。
      </p>
      <h3>獣医師の記録</h3>
      <p>
        獣医師はムギの診察を始める準備をしていましたが、9:08にソラを先に診ると判断し、ソラの診察を始めました。ムギは診察開始を保留する必要がありましたが、誰が予約へ記録して受付へ伝えるかは確認しませんでした。ソラの容体が落ち着いたあと、9:20にムギの診察を始めました。
      </p>
    </div>
  </section>

  <section id="workflow">
    <h2>ワークフローを描く</h2>

    <h3>説明{timing.teach}分: 語彙の確認・ドメインイベントの見つけ方</h3>
    <p>今回はポリシー、読み取りモデル、外部システムは扱いません。</p>
    <dl>
      <dt>ドメインイベント</dt>
      <dd>業務上起きた出来事。CheckedIn Eventのように過去形で表します。</dd>
      <dt>コマンド</dt>
      <dd>
        誰かが出した依頼。コマンドが起点となり、ドメインイベントが発生します。
      </dd>
      <dt>ワークフロー</dt>
      <dd>
        一つの依頼を受けてドメインイベントを出すまでのひとかたまりの処理。
      </dd>
      <dt>集約</dt>
      <dd>
        状態を一貫させたい業務上のまとまり。どのイベントが同じ対象を変更するかを手掛かりに境界を考えます。
      </dd>
    </dl>
    <p>
      責任者や更新範囲を決められない箇所には「?」を置きます。今回はポリシーとして解決せず、認識が揃っていない場所を見つけるところまで扱います。
    </p>
    <p>手順は次の4段です。班ワーク中もこのページで参照できます。</p>
    <ol class="exercise-steps">
      <li>起きた出来事を過去形で書き出す</li>
      <li>患者ごとの列に分け、同じ時刻の出来事を並べる</li>
      <li>それぞれの出来事が、誰の何の依頼で起きたかを添える</li>
      <li>一貫性を保ちたい対象ごとにイベントを囲み、集約名と未解決の問いを付ける</li>
    </ol>
    <p>
      講師は文章からドメインイベントを1件だけ拾い、コマンドとアクター、集約を添えて
      Excalidraw に置いて見せます。
    </p>
    <article
      class="decision-card"
      data-domain-event-id={teacherDemoEvent.id}
      data-aggregate={teacherDemoEvent.aggregate}
    >
      <h4>講師実演: {teacherDemoEvent.name}</h4>
      <p><strong>対象:</strong> {laneById.get(teacherDemoEvent.laneId)?.label}</p>
      <p><strong>誰の依頼か:</strong> {teacherDemoEvent.actor ?? "未確認（?）"}</p>
      <p><strong>コマンド:</strong> {teacherDemoEvent.command}</p>
      <p><strong>集約:</strong> {teacherDemoEvent.aggregate}</p>
    </article>

    <h3>
      班ワーク{timing.exercise}分: 残りのドメインイベントを拾い、境界を引く
    </h3>
    <p>
      残りのドメインイベントを担当者の記録から拾い、ムギとソラの列へ置きます。同じ時刻に別の列で起きたイベントを横に並べ、誰の何の依頼で起きたかを添えます。そのうえで、一貫性を保ちたい対象ごとに囲み、集約名を付けます。2つの列へ影響する判断には「?」を置いてください。
    </p>
    <p>
      班ワークは次の Excalidraw テンプレートで行います。TA が excalidraw.com
      でテンプレートを開いて Live collaboration を開始し、班へリンクを配ります。
    </p>
    <p>
      <a href={excalidrawTemplateUrl}><code>{excalidrawTemplatePath}</code></a>
    </p>
  </section>

  <section id="review">
    <h2>レビュー{timing.review}分: 講師回答例と粒度の違いを比べる</h2>
    <p>
      まず患者ごとの列を見比べます。同じ「4分後」と「8分後」に、別の患者について出来事が起きています。カード上部の数字は来院受付からの経過時間です。
    </p>
    <div class="aggregate-groups workflow-lanes" data-workflow-lanes>
      {
        workflowLanes.map((lane) => (
          <section class="aggregate-group" data-lane={lane.id}>
            <h3>{lane.label}</h3>
            <ol class="decision-list">
              {lane.events.map((event) => (
                <li class="decision-card" data-domain-event-id={event.id}>
                  <p class="event-order">{event.minute}分後</p>
                  <h4>{event.name}</h4>
                  <p><strong>誰の依頼か:</strong> {event.actor ?? "未確認（?）"}</p>
                  <p><strong>コマンド:</strong> {event.command}</p>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
    <h3>集約ごとにまとめ直す</h3>
    <p>
      時系列を保ったまま、一貫性を保ちたい業務対象ごとにイベントをまとめ直します。同じ「予約」でも、ムギとソラは別々の集約です。
    </p>
    <div class="aggregate-groups">
      {
        aggregateGroups.map((group) => (
          <section class="aggregate-group" data-aggregate={group.aggregate}>
            <h4>集約: {group.aggregate} / {group.laneLabel}</h4>
            <ol class="decision-list">
              {group.events.map((event) => (
                <li
                  class="decision-card"
                  data-domain-event-id={event.id}
                  data-aggregate={event.aggregate}
                >
                  <p class="event-order">{event.minute}分後</p>
                  <h4>{event.name}</h4>
                  <p>
                    <strong>誰の依頼か:</strong> {event.actor ?? "未確認（?）"}
                  </p>
                  <p>
                    <strong>コマンド:</strong> {event.command}
                  </p>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
    <aside class="decision-card" aria-label="未解決の問い">
      <h3>「?」として残す問い</h3>
      {eventStormingScenario.hotspots.map((hotspot) => <p>{hotspot.prompt}</p>)}
    </aside>
    <p>
      ソラの診察開始は獣医師が依頼できます。一方、ムギの診察保留を誰が予約へ記録し、受付へ伝えるかは決まっていません。保留だけが伝わらないと、受付と診察室で順番が食い違います。S2 からは予約集約の「診察を始める」という依頼を詳しく見ていきます。
    </p>
    <p>
      ドメインイベントの粒度に着目して班で共有してみましょう（正誤は気にする必要はありません）。
      一つのドメインイベントをさらに細かく分けているか、逆に複数の出来事を一つにまとめているか、などの観点で比べてみましょう。
    </p>
  </section>
        </article>
      </div>
      <nav class="case-file__session-nav" aria-label="前後のセッション">
        {
          navigation.previous === undefined ? null : (
            <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
          )
        }
        {
          navigation.next === undefined ? null : (
            <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
          )
        }
      </nav>
    </main>
  </div>
</BaseLayout>
