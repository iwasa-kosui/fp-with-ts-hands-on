---
import StartExaminationWorkflow from "../../components/StartExaminationWorkflow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SessionSummary } from "../../sessions/types";
import "../../styles/sessions.css";

export const session: SessionSummary = {
  slug: "01-business-events-and-workflows",
  snapshot: undefined,
  sequence: "01",
  kind: "workshop",
  title: "EventStormingから診察開始を定義する",
  durationMinutes: 15,
  timeBreakdown: { brief: 3, teach: 5.5, exercise: 4, review: 2.5 },
  animal: { name: "CAT", type: "cat", avatar: "🐈" },
  summary: "診察開始の出来事から依頼と事前条件を逆算し、ワークフローの入出力と境界を整理します。",
  episode: [
    "会計済みの予約で診察開始を実行すると、予約は診察中へ戻りました。",
    "誰が開始を依頼し、どの状態なら受け付けてよいかを担当者に聞くと、答えが揃いません。",
    "実装へ進む前に、診察開始の依頼と事前条件を業務の言葉で決めます。",
  ],
  incident: "会計済みの予約でも診察を開始でき、診察開始の事前条件が決まっていない。",
  steps: [],
  decisions: [],
  finalReferences: [],
};

const domainEvents = [
  { id: "checked-in", name: "来院が受け付けられた" },
  { id: "examination-started", name: "診察が開始された" },
  { id: "examination-completed", name: "診察が完了した" },
  { id: "billing-completed", name: "会計が完了した" },
] as const;

const notation = [
  { name: "ドメインイベント", description: "業務で起きたことを過去形で書きます。" },
  { name: "アクター", description: "コマンドを出す人や役割を書きます。" },
  { name: "コマンド", description: "何をしてほしいかを命令形で書きます。" },
  { name: "Hotspot", description: "答えが揃わないことや、決める必要があることを書きます。" },
] as const;

const excalidrawTemplatePath = "docs/event/session-01-event-storming.excalidraw";
const excalidrawTemplateUrl =
  `https://github.com/iwasa-kosui/fp-with-ts-hands-on/blob/main/${excalidrawTemplatePath}`;

const chapters = [
  { id: "incident", label: "事故と4つの出来事" },
  { id: "workshop", label: "班ワーク" },
  { id: "workflow", label: "ワークフローへ整理" },
  { id: "handoff", label: "S2〜S6への接続" },
] as const;

export const navigation = ({
  previous: {
    href: "/sessions/00-system-handover/",
    title: "業務とシステムを引き継ぐ",
  },
  next: {
    href: "/sessions/02-state-transitions/",
    title: "予約の状態と遷移をモデル化する",
  },
} as const);
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header">
      <a href="/">WAN NYAN CLINIC</a>
    </header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次">
            <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
        </details>

        <article class="case-file__content">
          <section id="incident">
            <h2>0:00〜1:30　事故と4つの出来事を確認する</h2>
            <aside class="case-file__episode" aria-label="動物病院のひと幕">
              <p class="case-file__episode-label">動物病院のひと幕</p>
              {session.episode.map((line) => <p data-episode-line>{line}</p>)}
            </aside>
            <p>
              S0では、会計済みの予約でも診察開始を実行できました。何を直すか決める前に、同じ予約で起きる出来事を時間順に確認します。
            </p>
            <ol class="eventstorming-timeline" aria-label="事前配置するドメインイベント">
              {
                domainEvents.map((event) => (
                  <li data-domain-event-id={event.id}>
                    <span>ドメインイベント</span>
                    <strong>{event.name}</strong>
                  </li>
                ))
              }
            </ol>
            <p>この4枚は講師が事前に配置します。参加者は文章からイベントを書き写しません。</p>
          </section>

          <section id="workshop">
            <h2>1:30〜9:00　診察開始の依頼と事前条件を決める</h2>

            <h3>1:30〜3:00　使う付箋を確認する</h3>
            <dl>
              {notation.map((item) => <Fragment><dt>{item.name}</dt><dd>{item.description}</dd></Fragment>)}
            </dl>
            <p>ポリシー、読み取りモデル、外部システムは扱いません。集約は班ワークの後に講師が説明します。</p>

            <h3>3:00〜7:00　「診察が開始された」から逆算する</h3>
            <p>班で次の3問を順に話します。</p>
            <ol class="exercise-steps">
              <li>この出来事は、誰が、どんな依頼を出したために起きましたか。</li>
              <li>その依頼を受け付ける前に、予約がどうなっている必要がありますか。</li>
              <li>会計済みとキャンセル済みの場合はどうなりますか。</li>
            </ol>
            <div class="eventstorming-focus" aria-label="班で完成させる診察開始の並び">
              <div class="eventstorming-note eventstorming-note--actor">
                <span>アクター</span>
                <strong>班で決める</strong>
              </div>
              <span aria-hidden="true">→</span>
              <div class="eventstorming-note eventstorming-note--command">
                <span>コマンド</span>
                <strong>診察を始める</strong>
              </div>
              <span aria-hidden="true">→</span>
              <div class="eventstorming-note eventstorming-note--event">
                <span>ドメインイベント</span>
                <strong>診察が開始された</strong>
              </div>
            </div>
            <p>
              アクターは獣医師を正解として配りません。獣医師、看護師、受付など、班で答えが異なる場合は責任が決まっていないことをHotspotとして残します。
            </p>
            <blockquote>
              <p>受付を済ませた予約だけ、診察を始められます。</p>
            </blockquote>

            <h3>7:00〜9:00　班の答えを比べ、予約集約を加える</h3>
            <p>
              講師は1〜2班の答えを比べます。アクターの正解を一つに決めるのではなく、責任の認識が揃っているかを確認します。
            </p>
            <p>
              事前条件を確認した後、講師がコマンドとイベントの間に「予約」を置きます。予約は、診察を開始できる状態かを判断し、状態を一貫させる単位です。
            </p>
            <p>参加者に集約名を当てさせたり、一日の全イベントを集約ごとに分類させたりしません。</p>

            <aside class="decision-card">
              <h3>班の分担</h3>
              <p>
                5人班では、1人が付箋を操作し、1人が事故とイベント列を読み上げ、3人がアクター、コマンド、事前条件の案を出します。人数が少ない場合は役割を兼ねます。
              </p>
            </aside>
          </section>

          <section id="workflow">
            <h2>9:00〜12:30　入力、業務判断、出力へ整理する</h2>
            <p>同じ付箋を、次の3つへ読み替えます。</p>
            <dl>
              <dt>入力</dt>
              <dd>どの予約を、どの獣医師が開始するか。</dd>
              <dt>業務判断</dt>
              <dd>予約が受付済みなら診察中へ変更する。</dd>
              <dt>出力</dt>
              <dd>診察が開始されたというドメインイベント。</dd>
            </dl>
            <StartExaminationWorkflow focus="overview" />
            <p>
              予約の読み込みとイベントの保存は、受付済みかどうかを判断する処理の外に置きます。時刻とイベントIDも外から受け取ります。
            </p>
          </section>

          <section id="handoff">
            <h2>12:30〜15:00　S2〜S6で実装する部分を確認する</h2>
            <ol class="exercise-steps">
              <li><strong>S2:</strong> 受付済みだけを受け取る状態型と状態遷移</li>
              <li><strong>S3:</strong> 予約IDと獣医師IDの区別</li>
              <li><strong>S4:</strong> HTTPから来た値の検査と型付き入力への変換</li>
              <li><strong>S5:</strong> 予約なしと状態不正をResultで返す処理</li>
              <li><strong>S6:</strong> 時刻、イベントID、読み込み、保存の分離</li>
            </ol>
            <h3>S1で残す成果物</h3>
            <ol>
              <li>アクター、コマンド、予約、ドメインイベントを並べた図</li>
              <li>「受付を済ませた予約だけ、診察を始められる」という事前条件</li>
              <li>入力、業務判断、出力、読み込み、保存を分けた <code>startExamination</code> の構成図</li>
            </ol>
            <p>
              班ワークは <a href={excalidrawTemplateUrl}><code>{excalidrawTemplatePath}</code></a> を使います。TAが開始前にボードを開きます。
            </p>
          </section>
        </article>
      </div>

      <nav class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
    </main>
  </div>
</BaseLayout>
