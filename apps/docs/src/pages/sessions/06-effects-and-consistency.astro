---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/06-effects-and-consistency";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("06-effects-and-consistency");
if (session === undefined) {
  throw new Error("Unknown session: 06-effects-and-consistency");
}
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement: "誰がいつ診察を開始したかを出力イベントにし、予約状態と監査記録を一つの保存境界へ渡す。",
      currentRisk: "時刻と ID を処理中に直接作り、状態と監査記録を別々に保存するため、テスト結果が安定せず、片方だけが残り得る。",
      design: "output event と side effects 欄は、注入した実行コンテキスト、ExaminationStarted、単一の store で実装する。予約なし・状態不正・予約競合は業務 Result の値として返す。保存障害や破損データは catch で業務失敗へ変換せず、Promise の reject として外側の境界へ伝える。",
      limitation: "in-memory の一括保存は契約の形を示す。本番の永続化で原子性を守るには、transaction と結合テストが必要になる。",
      nextQuestion: "外側の境界で技術的な例外を安全に記録して HTTP 500 応答に変換し、次に減らす小さなリスクをどう選ぶか。",
      legacy: "直接生成する時刻・IDと、状態を保存してから監査記録を追加する2つの書き込み口を読みます。後半の保存だけが失敗すると、状態だけが残ります。また、用意された単一の store に業務競合が届かない箇所を探します。",
      reviewFocus: "予約競合は Result の失敗値として残るか。保存障害や破損データは reject として伝わるか。成功時は状態と監査記録が一つの store へ順番どおり渡るか。",
      fallback: "各解答欄には、import と後続 step を含む完成ファイルを target ごとに示します。表示されたすべての target file を反映した後、同じ exercise が GREEN になることを確認します。各 step を個別に GREEN にすることは想定していません。講師デモへ切り替えても相互レビューは残します。",
    }}
  />
  <aside class="failure-boundary" aria-label="業務失敗とインフラ例外の区別">
    <h2>2つの失敗経路を見分ける</h2>
    <ul class="decision-list">
      <li>
        <strong>業務上の失敗:</strong> 予約なし、状態不正、予約競合は、呼び出し側が次の操作を選べるため
        <code>Result</code> の <code>Err</code> で返します。
      </li>
      <li>
        <strong>運用上の異常:</strong> 保存処理の reject や破損データは業務エラーへ変換せず、外側の境界で安全に記録して詳細を含まない HTTP 500 応答へ変換します。
      </li>
    </ul>
  </aside>
</SessionLayout>
