        "examples/session-06/src/useCase/startExamination.ts",
      ],
      code: `export type EffectsDependencies = Readonly<{
  resolver: AppointmentResolver;
  stateStore: Readonly<{
    save: (appointment: InExamination) => Promise<void>;
  }>;
  eventLog: Readonly<{
    append: (event: ExaminationStarted) => Promise<void>;
  }>;
}>;

await deps.stateStore.save(event.aggregateState);
await deps.eventLog.append(event);`,
    },
    after: {
      sources: [
        "examples/session-07/src/useCase/dependencies.ts",
        "examples/session-07/src/useCase/startExamination.ts",
      ],
      code: `export type ExaminationStartedStore = Readonly<{
  store: (event: ExaminationStarted) => ResultAsync<void, AppointmentConflict>;
}>;

.andThrough((event) => deps.store.store(event))`,
    },
    examples: [
      {
        sources: ["examples/session-07/src/adaptor/secondary/sqlite/examinationStartedStore.ts"],
        code: `const storeAtomically = (event: ExaminationStarted) =>
  database.transaction((transaction) => {
    const current = findInTransaction(transaction, event.appointmentId);
    if (current === undefined || current.kind !== "CheckedIn") {
      return err({
        kind: "AppointmentConflict",
        appointmentId: event.appointmentId,
      } as const);
    }

    const committedEvent = Appointment.startExamination({
      eventId: event.eventId,
      occurredAt: event.occurredAt,
    })(current, event.aggregateState.veterinarianId);

    saveState(transaction, committedEvent.aggregateState);
    appendAudit(transaction, committedEvent);
    return ok(undefined);
  });`,
      },
      {
        sources: ["examples/session-07/src/adaptor/inMemoryExaminationStartedStore.ts"],
        code: `const currentAppointment = appointments.get(event.appointmentId);
if (currentAppointment === undefined) {
  throw new Error(\`Appointment missing at commit: \${event.appointmentId}\`);
}
if (currentAppointment.kind !== "CheckedIn") {
  return err({
    kind: "AppointmentConflict",
    appointmentId: event.appointmentId,
  } as const);
}

const nextAppointments = new Map(appointments);
nextAppointments.set(event.appointmentId, event.aggregateState);
const nextEvents = [...events, event];

appointments = nextAppointments;
events = nextEvents;

return ok(undefined);`,
      },
    ],
    why: "保存処理を1つにすると、ユースケースは片方だけ成功した場合の後始末を書かずに済みます。状態と監査記録をそろえる責任は store の実装に集まります。型だけでは transaction の有無を確かめられないので、examples/session-07/test/integration/fileSqliteTransaction.test.ts が監査記録の失敗時に状態が戻ることを確かめています。",
  },
  {
    name: "ResultAsync と andThrough で非同期の保存をつなぐ",
    definition: "ResultAsync<T, E> は、Promise<Result<T, E>> を包む neverthrow の型です。await を書かずに、S5 と同じ andThen と map をつなげられます。andThen のコールバックは、同期の Result も ResultAsync も返せます。",
    guidance: [
      "andThrough は、Ok の値を別の処理へ渡して実行し、その処理が Ok なら元の値を次へ渡します。その処理が Err を返したら、結果はその Err になります。",
      "store の成功値は void です。andThen でつなぐと次へ渡る値が void になり、続く map でイベントから aggregateState を取り出せません。andThrough なら、保存の成功後もイベントが次へ渡ります。",
      "andTee は使いません。andTee はコールバックの結果を見ないので、AppointmentConflict を結果に含められず、reject も握りつぶします。",
    ],
    before: {
      sources: ["examples/session-06/src/useCase/startExamination.ts"],
      code: `export const startExaminationWithEffects =
  (deps: EffectsDependencies) =>
  async (
    input: Omit<StartExaminationInput, "examinationStartedAt">,
  ): Promise<Result<void, StartExaminationWithEffectsError>> => {
    const occurredAt = new Date().toISOString();
    const result = startExamination({
      resolver: deps.resolver,
      store: { save: () => undefined },
    })({ ...input, examinationStartedAt: occurredAt });

    if (result.isErr()) {
      return err(result.error);
    }

    const event = {
      kind: "ExaminationStarted",
      eventId: EventId.parse(crypto.randomUUID()),
      occurredAt,
      appointmentId: result.value.appointmentId,
      aggregateState: result.value,
    } as const satisfies ExaminationStarted;

    await deps.stateStore.save(event.aggregateState);
    await deps.eventLog.append(event);
    return ok(undefined);
  };`,
    },
    after: {
      sources: ["examples/session-07/src/useCase/startExamination.ts"],
      code: `export const startExaminationWithEffects =
  (deps: EffectsDependencies) =>
  (
    input: StartExaminationWithEffectsInput,
  ): ResultAsync<InExamination, StartExaminationWithEffectsError> =>
    ResultAsync.fromSafePromise<AppointmentState | undefined>(
      Promise.resolve().then(() =>
        deps.resolver.resolveById(input.appointmentId),
      ),
    )
      .andThen((appointment) =>
        ensureAppointmentFound(appointment, input.appointmentId),
      )
      .andThen(ensureCheckedIn)
      .map((appointment) =>
        Appointment.startExamination(createEventContext(deps))(
          appointment,
          input.veterinarianId,
        ),
      )
      .andThrough((event) => deps.store.store(event))
      .map((event) => event.aggregateState);`,
    },
    examples: [
      {
        caption: "andThen でつなぐと、次へ渡る値が void になります（配布コードにはありません）",
        code: `.andThen((event) => deps.store.store(event)) // 次へ渡る値は void
.map((event) => event.aggregateState); // 型エラー`,
      },
    ],
    why: "before は isErr で分岐してから await で保存を並べ、成功時は ok(undefined) を返します。before の型にも AppointmentConflict はありますが、保存処理が Promise<void> を返すので、before のコードは競合を返せません。after は S5 と同じ順に読め、store が返す AppointmentConflict をそのまま結果に含めます。成功時は InExamination を返します。",
  },
  {
    name: "保存障害は Err へ変換せず、reject のまま伝える",
    definition: "S5 で外側へ伝えたシステムエラーは、非同期の処理では Promise の reject になります。ResultAsync の E には業務エラーだけを書き、reject の理由は E に書きません。",
    guidance: [
      "AppointmentConflict と保存障害では、呼び出し側の対応が違います。競合なら、呼び出し側は最新の予約を確認して操作をやり直せます。データベースの障害や破損データには、呼び出し側が理由別に選べる対応がありません。",
      "neverthrow の関数でこの2つの経路が分かれます。ResultAsync.fromPromise は、reject を第2引数の関数で Err へ変換します。ResultAsync.fromSafePromise は変換しないので、reject は reject のまま残ります。after は fromSafePromise を使います。",
      "before のように fromPromise ですべての reject を AppointmentConflict へ変換すると、データベースの障害でも画面は競合として案内します。例外が外側の例外境界へ届かないので、障害はログに記録されません。",
      "after は resolver の呼び出しを Promise.resolve().then(...) で包みます。resolver は同期の関数で、破損データを読むと ZodError を投げます。then の中で呼ぶと、この throw も reject になります。包まずに呼ぶと、ResultAsync を返す前に例外が呼び出し元へ飛びます。",
      "store の実装も fromSafePromise を使います。transaction の中の throw は reject になり、そのまま andThrough を通り抜けます。",
      "reject は、S5 で確認した外側の例外境界が受け取ります。例外境界は、エラーの詳細を含まない 500 応答へ変換します。本番ではここでログへも記録します。配布コードの app.onError は記録を省いています。",
    ],
    before: {
      caption: "すべての reject を業務エラーへ変換する書き方（配布コードにはありません）",
      code: `ResultAsync.fromPromise(
  deps.stateStore.save(event.aggregateState),
  () =>
    ({
      kind: "AppointmentConflict",
      appointmentId: event.appointmentId,
    }) as const,
);`,
    },
    after: {
      sources: ["examples/session-07/src/useCase/startExamination.ts"],
      code: `ResultAsync.fromSafePromise<AppointmentState | undefined>(
  Promise.resolve().then(() =>
    deps.resolver.resolveById(input.appointmentId),
  ),
)`,
    },
    examples: [
      {
        sources: ["examples/session-07/src/adaptor/secondary/sqlite/examinationStartedStore.ts"],
        code: `store: (event) =>
  ResultAsync.fromSafePromise(
    Promise.resolve().then(() => storeAtomically(event)),
  ).andThen((result) => result),`,
      },
    ],
    why: "E に AppointmentConflict だけを書くと、呼び出し側は選べる対応だけを型から読み取れます。演習の Step 4 は、競合が Err になり、保存障害と破損データが reject になることをテストで確かめます。",
  },
];
const chapters = [
  { id: "incident", label: "今回つくるもの" },
  { id: "legacy", label: "コードを読み、失敗を再現する" },
  { id: "teach", label: "使う型を知る" },
  { id: "refactor", label: "型で閉じる" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
const commonReviewChecks = [
  "`as` によるキャストが入っていないか全文検索して確認する。",
  "`git diff --stat -- examples/session-06` で今回の snapshot だけを確認する。`git status --short` で想定外の path がないか確認する。",
  "型検査では確認できないことを、テストまたは実行時に確認して記録する。",
] as const;
const reviewCompletionArtifacts = [
  "一緒に記録する必要がある値",
  "Agentへの依頼文",
  "型検査では確認できず、テストまたは実行時に確認すること",
] as const;
const businessReflectionQuestion =
  "自分の業務コードで、今回と同種の問題が起きうる箇所はどこですか。";
export const promisesHref =
  "/sessions/02-state-transitions/#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/05-workflow-errors/",
    title: "失敗をユースケースの結果として扱う",
  },
  next: {
    href: "/sessions/final/",
    title: "参照実装で境界をたどる",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const delegationPrompt = `次の変更を実装してください。

業務背景:
${session.incident}

依頼:
${exerciseSession.delegationPrompt.request}

一緒に記録する必要がある値: [言語化フェーズで書いた1文]

着手前に判断すること:
${exerciseSession.delegationPrompt.decisions.map((decision) => `- ${decision}: [自分の判断を書く]`).join("\n")}

まず配布コードと失敗しているテストを読み、上の判断と変更方針を短く説明してください。説明のあとで実装に進んでください。設計手段は既存コードに合うものを選び、選んだ理由も示してください。

受け入れ条件:
${session.steps.map((step) => `- ${step.goal}`).join("\n")}

変更範囲:
- ${session.exerciseModule.dir}/ のみ
- 最大 ${session.exerciseModule.fileBudget} ファイル・約 ${session.exerciseModule.lineBudget} 行
- 範囲外の変更が必要に見えた場合は、変更せず理由を報告する
- 型エラーを \`as\` によるキャストで回避しない

検証:
- ${session.exerciseCommand} を実行し、すべての assertion が成功すること

完了時の報告:
- 変更したファイルと判断理由
- 検証コマンドの結果
- 型だけでは守れず、テストまたはレビューに残した点`;
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file case-file--session">
    <header class="case-file__site-header"><a href="/"><span class="case-file__brand-mark" aria-hidden="true">🐾</span>WAN NYAN CLINIC</a></header>
    <main>
      <SessionPageNavigation currentSlug={session.slug} chapters={chapters}>
      <section slot="hero" class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
          <section id="incident">
            <h2>今回つくるもの</h2>
            <aside class="case-file__episode" aria-label="動物病院のひと幕">
              <p class="case-file__episode-label">動物病院のひと幕</p>
              {session.episode.map((line) => <p data-episode-line>{line}</p>)}
            </aside>
            <p>読み込み、時刻とイベントIDの生成、保存を外から渡し、診察開始イベントを1回保存します。</p>
            <h3 data-story-stage="use-case">追加したい機能</h3>
            <p>{narrative.requirement}</p>
            <h3 data-story-stage="pitfall">素朴な実装の落とし穴</h3>
            <p>{narrative.currentRisk}</p>
            <h3 data-story-stage="goal">このセッションのゴール</h3>
            <p>{narrative.design}</p>
            <h3>このセッションで守ること</h3>
            <ul class="decision-list">{session.decisions.map(({ invariant }) => <li>{invariant}</li>)}</ul>
            <p>今回の変更は <code>{session.exerciseModule.dir}</code> 内の1モジュールに限定します。</p>
          </section>

          <section id="legacy" class="code-playground">
            <h2>コードを読み、失敗を再現する</h2>
            <p>{narrative.legacy}</p>
            <p>
              編集する範囲は <code>{session.exerciseModule.dir}</code>、変更するファイル数は最大
              {session.exerciseModule.fileBudget}ファイル・約{session.exerciseModule.lineBudget}行です。
            </p>
            <CodeGuideCards guides={guides} projectFiles={projectFiles} />
            <h3>修正前の失敗を確認する</h3>
            <p>修正前は、次の{session.steps.length}件に対応する演習テストが失敗します。</p>
            <ul class="exercise-failures" aria-label="修正前に確認する問題">
              {session.steps.map((step) => <li>{step.startingFailure}</li>)}
            </ul>
            <CommandBlock phase="red" command={session.exerciseCommand} expected={`${session.steps.length}件の演習テストが失敗します。`} />
            <p>ブラウザ内の変更はローカルへ反映されません。</p>
            <div data-code-explorer={workspace.slug}>
              <CodeExplorer
                client:load
                workspace={workspace}
                projectFiles={projectFiles}
                initialCommand={session.exerciseCommand}
              />
            </div>
          </section>

          <section id="teach">
            <h2>事前知識（{session.timeBreakdown.teach}分）</h2>
            <p>S5 では、呼び出し側に理由別の対応がなく、要求された処理を完了できない異常をシステムエラーと呼び、Result へ変換せずに外側へ伝えました。S6 はこの続きです。保存が非同期になり、保存先が状態と監査記録の2か所になると、システムエラーが起きたときに何が残るかを設計しなければなりません。</p>
            <p>次の4つのトピックは、演習の Step 1 から Step 4 に順に対応します。before は配布コードまたは避けたい書き方、after は次のスナップショットの書き方です。</p>
            {teaching.map((topic) => (
              <article class="teaching-topic">
                <h3>{topic.name}</h3>
                <p>{topic.definition}</p>
                {topic.guidance.map((paragraph) => <p>{paragraph}</p>)}
                <div class="teaching-topic__diff">
                  <figure class="code-block">
                    <figcaption>
                      before:
                      {topic.before.caption === undefined ? topic.before.sources?.map((source, index) => (
                        <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                      )) : <span>{topic.before.caption}</span>}
                    </figcaption>
                    <Code code={topic.before.code} lang="ts" />
                  </figure>
                  <figure class="code-block">
                    <figcaption>
                      after:
                      {topic.after.caption === undefined ? topic.after.sources?.map((source, index) => (
                        <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                      )) : <span>{topic.after.caption}</span>}
                    </figcaption>
                    <Code code={topic.after.code} lang="ts" />
                  </figure>
                </div>
                {topic.examples?.map((example) => (
                  <figure class="code-block" data-teaching-example>
                    <figcaption>
                      {example.caption === undefined ? example.sources?.map((source, index) => (
                        <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                      )) : <span>{example.caption}</span>}
                    </figcaption>
                    <Code code={example.code} lang="ts" />
                  </figure>
                ))}
                <p class="teaching-topic__why">{topic.why}</p>
              </article>
            ))}
          </section>

          <aside class="failure-boundary" aria-label="業務エラーとインフラ例外の区別">
            <h2>2つの失敗経路を見分ける</h2>
            <ul class="decision-list">
              <li>
                <strong>業務エラー:</strong> 予約が存在しない・予約の状態が不正・予約が競合しているケースは、呼び出し元で次の対応を選択する余地があるため、
                <code>Result</code> の <code>Err</code> で返します。
              </li>
              <li>
                <strong>システムエラー:</strong> データベース起因のエラーやデータが破損しているエラーは呼び出し元でも解決できません。外側の例外境界で安全に記録し、エラーの詳細を含まない形で
                HTTP 500 のレスポンスに変換します。
              </li>
            </ul>
          </aside>

          <section id="refactor">
            <h2>演習</h2>
            <h3>進め方: 言語化 → Agentへの依頼 → 検証</h3>
            <p>Agentを使わない場合は、テンプレートを実装メモとして使って自分で実装します。以降の「Agentへの依頼文」も実装メモに読み替えてください。</p>
            <ol class="adv-flow">
              <li><strong>言語化（{session.adv.articulate}分）</strong>: 一緒に記録する必要がある値を1文で書く。</li>
              <li><strong>依頼（{session.adv.delegate}分）</strong>: その1文と自分の判断をテンプレートへ入れ、Agent に依頼する。</li>
              <li><strong>検証（{session.adv.verify}分）</strong>: 型、テスト、差分の範囲を確認する。</li>
            </ol>
            <div class="delegation-prompt">
              <h3>プロンプトのテンプレート</h3>
              <p>角括弧の中は、事故と配布コードを読んだ自分の判断で埋めます。技法名や完成形を先に指定する必要はありません。</p>
              <pre><code>{delegationPrompt}</code></pre>
            </div>
            <h3>この演習で解決しないこと</h3>
            <p>{narrative.limitation}</p>
            <h3 data-solution-heading>{exerciseSession.solutionPresentation === "completed-file" ? "完成ファイルの解答例" : "ステップごとの解答"}</h3>
            {exerciseSession.solutionPresentation === "completed-file" ? (
              <div class="before-after" aria-label="業務エラーとシステムエラーの見比べ方">
                <p><strong>演習の開始時点:</strong> 業務エラーとして返す Result と、保存処理が reject するシステムエラーの経路を分けて読む。</p>
                <p><strong>完成例:</strong> 下のすべての target file には、後続 step を含む完成状態が表示される。</p>
              </div>
            ) : null}
            {solutionSteps.map(({ step, presentation, snippets }) => (
              <div class="solution-step">
                <details class="step-solution" data-presentation={presentation}>
                  <summary>{step.goal}</summary>
                  {presentation === "completed-file" ? (
                    <p class="step-solution__completed-file-note">この完成例には後続 step を含みます。すべての target file を反映してから検証します。</p>
                  ) : null}
                  {snippets.map(({ solution, code }) => (
                    <section class="step-solution__snippet">
                      <h4><code>{solution.path}</code></h4>
                      <Code code={code} lang="ts" />
                    </section>
                  ))}
                </details>
              </div>
            ))}
            <CommandBlock phase="green" command={session.exerciseCommand} expected="演習テストがすべて成功します。" />
            <h3>演習を完了できないとき</h3>
            <p>{narrative.fallback}</p>
          </section>

          <section id="review">
            <h2>レビューと持ち帰り</h2>
            <div class="exercise-review-checklist">
              <h3>個人で確認する</h3>
              <ol>{commonReviewChecks.map((check) => <li>{check}</li>)}</ol>
              <p>前のセッションの未commit差分は残して構いません。reset、stash、commit は不要です。</p>
              <p><strong>残すもの:</strong> {reviewCompletionArtifacts.join("、")}</p>
              <h3>業務へ持ち帰る</h3>
              <p>{businessReflectionQuestion}</p>
            </div>
            <section class="peer-review-panel">
              <h3>設計を振り返る</h3>
              <p>ひとりの場合は、次の問いへの答えと根拠になるコードをメモします。複数人の場合は、お互いの差分を見ながら確認します。相互レビューは{session.peerReview.minutes}分・{headcount}を目安にしてください。</p>
              <p><a href={promisesHref}>進行上の約束事を確認する</a></p>
              <ol>{session.peerReview.questions.map((question) => <li>{question}</li>)}</ol>
            </section>
          </section>
      <nav slot="footer" class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
      </SessionPageNavigation>
    </main>
  </div>
</BaseLayout>
