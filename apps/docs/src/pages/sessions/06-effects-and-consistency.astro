      code: `export type Clock = Readonly<{
  now: () => string;
}>;

export type EventIdGenerator = Readonly<{
  generate: () => EventId;
}>;

export const createEventContext = (
  deps: EventContextDependencies,
): EventContext => ({
  eventId: deps.eventIdGenerator.generate(),
  occurredAt: deps.clock.now(),
});

.map((appointment) =>
  Appointment.startExamination(createEventContext(deps))(
    appointment,
    input.veterinarianId,
  ),
)`,
    },
    why: "時刻と ID を引数で受け取ると、状態遷移は同じ入力から同じイベントを返す純粋関数のままです。実行ごとに変わる値を作る場所がユースケースの1か所に決まるので、テストは同じ実行を再現できます。",
  },
  {
    name: "状態と監査記録は1回の保存で残す",
    definition: "診察開始では、予約の状態の更新と監査記録の追加の2つの書き込みが起きます。この2つを別々の保存処理に分けると、途中で失敗したときに片方だけが残ります。",
    guidance: [
      "before は stateStore.save の後に eventLog.append を呼びます。append だけが失敗すると、予約は診察中になるのに、誰がいつ診察を開始したかの記録は残りません。順番を入れ替えても、今度は記録だけが残る可能性があります。",
      "after は ExaminationStarted を store へ1回渡します。ExaminationStarted の aggregateState は保存後の予約の状態を持つので、1つの値が状態と監査記録の両方を表します。どう書き込むかは store の実装が決めます。",
      "同時に残すことを実際に守るのは store の実装です。SQLite の実装は、saveState と appendAudit を1つの transaction の中で呼びます。appendAudit が例外を投げると transaction が取り消され、状態の更新も残りません。",
      "store は transaction の中で現在の予約を読み直します。SQLite の実装は、ユースケースが読んだ後に予約が変わっていて、予約が無いときや現在の状態が CheckedIn でないときに、AppointmentConflict を返します。このとき store は saveState の前に返るので、何も書き込みません。",
