---
import CodeGuideCards from "../../components/CodeGuideCards.astro";
import CommandBlock from "../../components/CommandBlock.astro";
import SessionPageNavigation from "../../components/SessionPageNavigation.astro";
import Prose from "../../sessions/prose/06-effects-and-consistency.mdx";
import type { CodeGuide } from "../../code-explorer/code-guide";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import type { SessionWorkspace } from "../../code-explorer/types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSolutionSnippets } from "../../sessions/solution-snippets";
import type {
  ExerciseSessionSummary,
  SessionSummary,
  TeachingCode,
} from "../../sessions/types";
import "../../styles/code-playground.css";
import "../../styles/sessions.css";
import EpisodeIllustration from "../../components/EpisodeIllustration.astro";

type TeachingSnippets = Readonly<{
  before: TeachingCode;
  after: TeachingCode;
  examples?: readonly TeachingCode[];
}>;

export const session: SessionSummary = {
  slug: "06-effects-and-consistency",
  snapshot: "session-06",
  sequence: "06",
  kind: "exercise",
  title: "副作用と整合性境界を設計する",
  durationMinutes: 40,
  timeBreakdown: { brief: 4, teach: 13, exercise: 15, review: 8 },
  adv: { articulate: 2, delegate: 10, verify: 3 },
  peerReview: {
    minutes: 8,
    pickCount: 2,
    questions: [
      "時刻とイベント ID は実行ごとに一度だけ生成され、同じ `EventContext` に入りますか。",
      "状態と監査記録は、1つのイベントとして同じ `store` に渡されますか。",
      "業務上の競合だけを `Result` で返し、保存障害は reject のまま伝播しますか。",
    ],
  },
  solutionSnapshot: "session-07",
  solutionPresentation: "completed-file",
  peerReviewPromises: "reference",
  animal: { name: "TURTLE", type: "turtle", avatar: "🐢" },
  summary: "時刻や ID など実行のたびに変わる値と保存を port に切り出し、状態と監査記録を一度に保存します。",
  episode: [
    "カメの診察を開始すると、予約状態だけが先に更新され、監査記録はどこにも残りませんでした。",
    "再現テストでは時刻とイベント ID が毎回変わり、失敗したときの値を同じ形で確かめられません。",
    "状態の更新はすぐに終わりますが、監査記録の保存は別の処理です。そのため、原因を調べる作業だけが長引きます。",
  ],
  incident: "実行のたびに変わる値でテスト結果が安定せず、状態だけ保存され監査記録が残らない予約が生まれた。",
  exerciseCommand: "pnpm exercise:06",
  exerciseModule: {
    dir: "examples/session-06/src/useCase",
    fileBudget: 3,
    lineBudget: 55,
  },
  delegationPrompt: {
    request:
      "診察開始で作る状態と監査記録に、1回の実行で生成した値を使ってください。保存時に片方だけが残らない形へ改善してください。",
    decisions: [
      "実行ごとに変わる値をいつ生成するか",
      "どの状態と記録を同時に保存するか",
      "保存障害をどの境界まで伝えるか",
    ],
  },
  steps: [
    {
      id: "s6-inject-context",
      goal: "Clock と ID generator を使って EventContext を一度だけ生成する。",
      startingFailure: "同じ条件で実行しても、時刻とイベント ID が毎回変わる。",
      targets: [
        "examples/session-06/src/useCase/dependencies.ts",
        "examples/session-06/src/useCase/startExamination.ts",
      ],
      solutions: [
        {
          path: "examples/session-07/src/useCase/dependencies.ts",
          symbol: "EventContextDependencies",
          lines: [1, 35],
          presentation: "completed-file",
        },
        {
          path: "examples/session-07/src/useCase/startExamination.ts",
          symbol: "createEventContext",
          lines: [1, 90],
          presentation: "completed-file",
        },
      ],
    },
    {
      id: "s6-atomic-store",
      goal: "状態と監査記録を1回の保存で残す。",
      startingFailure: "状態と監査記録を別々に保存している。",
      targets: ["examples/session-06/src/useCase/dependencies.ts"],
      solutions: [
        {
          path: "examples/session-07/src/useCase/dependencies.ts",
          symbol: "ExaminationStartedStore",
          lines: [1, 35],
          presentation: "completed-file",
        },
      ],
    },
    {
      id: "s6-result-async",
      goal: "非同期で保存しても、イベントを結果として返す。",
      startingFailure: "保存後に、更新した予約の状態を受け取れない。",
      targets: ["examples/session-06/src/useCase/startExamination.ts"],
      solutions: [{
        path: "examples/session-07/src/useCase/startExamination.ts",
        symbol: "startExaminationWithEffects",
        lines: [1, 90],
        presentation: "completed-file",
      }],
    },
    {
      id: "s6-propagate-store-failure",
      goal: "保存障害を業務エラーの Result へ変換せず、例外として外側の境界へ伝播する。",
      startingFailure: "業務上の競合と、保存障害・破損データを区別して返せない。",
      targets: [
        "examples/session-06/src/useCase/errors.ts",
        "examples/session-06/src/useCase/startExamination.ts",
      ],
      solutions: [
        {
          path: "examples/session-07/src/useCase/errors.ts",
          symbol: "AppointmentConflict",
          lines: [1, 39],
          presentation: "completed-file",
        },
        {
          path: "examples/session-07/src/useCase/startExamination.ts",
          symbol: "startExaminationWithEffects",
          lines: [1, 90],
          presentation: "completed-file",
        },
      ],
    },
  ],
  decisions: [
    {
      invariant: "時刻とイベント ID は1回のユースケース実行で一度だけ生成し、同じ実行コンテキストから状態と監査記録を作る。",
    },
    {
      invariant: "状態と監査記録は同時に残るか、どちらも残らない。",
    },
    {
      invariant: "保存障害を、呼び出し側が選択できる業務上の失敗へ偽装しない。",
    },
  ],
  finalReferences: [
    "examples/final/src/domain/aggregate/clock.ts",
    "examples/final/src/domain/aggregate/eventIdGenerator.ts",
    "examples/final/src/domain/aggregate/eventContext.ts",
    "examples/final/src/domain/aggregate/aggregateStore.ts",
    "examples/final/src/domain/appointment/appointmentStores.ts",
    "examples/final/src/useCase/startExaminationUseCase.ts",
    "examples/final/src/app.ts",
  ],
};

export const guides = ([
  {
    id: "hidden-nondeterminism",
    title: "出力イベントの時刻と ID をユースケース内で生成している",
    currentDesign: "Date と randomUUID を直接呼び、同じ入力でも出力イベントが変わります。",
    futureRisk: "期待値を固定できず、テストが実行時刻に依存します。",
    path: "src/useCase/startExamination.ts",
    highlights: [{ startLineNumber: 45, endLineNumber: 67 }],
  },
  {
    id: "dual-write",
    title: "状態と監査記録の保存が2つの処理に分かれている",
    currentDesign: "stateStore.save と eventLog.append を順番に await しています。",
    futureRisk: "片方だけ成功すると、監査記録を伴わない状態変更が残ります。",
    path: "src/useCase/startExamination.ts",
    highlights: [{ startLineNumber: 69, endLineNumber: 70 }],
  },
] as const) satisfies readonly CodeGuide[];

const exerciseSession: ExerciseSessionSummary = session;

export const workspace = ({
  slug: session.slug,
  snapshot: session.snapshot,
  initialFile: "exercises/effects-and-events.test.ts",
  description: "出力イベントと副作用の要求を、開始スナップショットで確認します。",
  visibleFiles: [
    "exercises/effects-and-events.test.ts",
    "test/regression/result-errors.test.ts",
    "src/domain/aggregate/clock.ts",
    "src/domain/aggregate/eventContext.ts",
    "src/domain/aggregate/eventId.ts",
    "src/domain/aggregate/eventIdGenerator.ts",
    "src/domain/appointment/examinationStarted.ts",
    "src/useCase/dependencies.ts",
    "src/useCase/errors.ts",
    "src/useCase/startExamination.ts",
    "src/shared/schemaResult.ts",
    "src/shared/sensitive.ts",
  ],
} as const) satisfies SessionWorkspace;

const projectFiles = projectFilesForSnapshot(session.snapshot);
const solutionSteps = await Promise.all(
  session.steps.map(async (step) => ({
    step,
    presentation: step.solutions[0].presentation ?? "excerpt",
    snippets: await loadSolutionSnippets(step),
  })),
);
const teaching: readonly TeachingSnippets[] = [
  {
    before: {
      sources: ["examples/session-06/src/useCase/startExamination.ts"],
      code: `const occurredAt = new Date().toISOString();

const event = {
  kind: "ExaminationStarted",
  eventId: EventId.parse(crypto.randomUUID()),
  occurredAt,
  appointmentId: result.value.appointmentId,
  aggregateState: result.value,
} as const satisfies ExaminationStarted;`,
    },
    after: {
      sources: [
        "examples/session-07/src/domain/aggregate/clock.ts",
        "examples/session-07/src/domain/aggregate/eventIdGenerator.ts",
        "examples/session-07/src/useCase/startExamination.ts",
      ],
      code: `export type Clock = Readonly<{
  now: () => string;
}>;

export type EventIdGenerator = Readonly<{
  generate: () => EventId;
}>;

export const createEventContext = (
  deps: EventContextDependencies,
): EventContext => ({
  eventId: deps.eventIdGenerator.generate(),
  occurredAt: deps.clock.now(),
});

const startExaminationEvent =
  (deps: EffectsDependencies, veterinarianId: VeterinarianId) =>
  (appointment: CheckedIn): ExaminationStarted =>
    Appointment.startExamination(createEventContext(deps))(
      appointment,
      veterinarianId,
    );

.map(startExaminationEvent(deps, input.veterinarianId))`,
    },
  },
  {
    before: {
      sources: [
        "examples/session-06/src/useCase/dependencies.ts",
        "examples/session-06/src/useCase/startExamination.ts",
      ],
      code: `export type EffectsDependencies = Readonly<{
  resolver: AppointmentResolver;
  stateStore: Readonly<{
    save: (appointment: InExamination) => Promise<void>;
  }>;
  eventLog: Readonly<{
    append: (event: ExaminationStarted) => Promise<void>;
  }>;
}>;

await deps.stateStore.save(event.aggregateState);
await deps.eventLog.append(event);`,
    },
    after: {
      sources: [
        "examples/session-07/src/useCase/dependencies.ts",
        "examples/session-07/src/useCase/startExamination.ts",
      ],
      code: `export type ExaminationStartedStore = Readonly<{
  store: (event: ExaminationStarted) => ResultAsync<void, AppointmentConflict>;
}>;

.andThrough(deps.examinationStartedStore.store)`,
    },
    examples: [
      {
        sources: ["examples/session-07/src/adaptor/secondary/sqlite/examinationStartedStore.ts"],
        code: `const storeAtomically = (event: ExaminationStarted) =>
  database.transaction((transaction) => {
    const current = findInTransaction(transaction, event.appointmentId);
    if (current === undefined || current.kind !== "CheckedIn") {
      return err({
        kind: "AppointmentConflict",
        appointmentId: event.appointmentId,
      } as const);
    }

    const committedEvent = Appointment.startExamination({
      eventId: event.eventId,
      occurredAt: event.occurredAt,
    })(current, event.aggregateState.veterinarianId);

    saveState(transaction, committedEvent.aggregateState);
    appendAudit(transaction, committedEvent);
    return ok(undefined);
  });`,
      },
      {
        sources: ["examples/session-07/src/adaptor/inMemoryExaminationStartedStore.ts"],
        code: `const currentAppointment = appointments.get(event.appointmentId);
if (currentAppointment === undefined) {
  throw new Error(\`Appointment missing at commit: \${event.appointmentId}\`);
}
if (currentAppointment.kind !== "CheckedIn") {
  return err({
    kind: "AppointmentConflict",
    appointmentId: event.appointmentId,
  } as const);
}

const nextAppointments = new Map(appointments);
nextAppointments.set(event.appointmentId, event.aggregateState);
const nextEvents = [...events, event];

appointments = nextAppointments;
events = nextEvents;

return ok(undefined);`,
      },
    ],
  },
  {
    before: {
      sources: ["examples/session-06/src/useCase/startExamination.ts"],
      code: `export const startExaminationWithEffects =
  (deps: EffectsDependencies) =>
  async (
    input: Omit<StartExaminationInput, "examinationStartedAt">,
  ): Promise<Result<void, StartExaminationWithEffectsError>> => {
    const occurredAt = new Date().toISOString();
    const result = startExamination({
      resolver: deps.resolver,
      store: { save: () => undefined },
    })({ ...input, examinationStartedAt: occurredAt });

    if (result.isErr()) {
      return err(result.error);
    }

    const event = {
      kind: "ExaminationStarted",
      eventId: EventId.parse(crypto.randomUUID()),
      occurredAt,
      appointmentId: result.value.appointmentId,
      aggregateState: result.value,
    } as const satisfies ExaminationStarted;

    await deps.stateStore.save(event.aggregateState);
    await deps.eventLog.append(event);
    return ok(undefined);
  };`,
    },
    after: {
      sources: ["examples/session-07/src/useCase/startExamination.ts"],
      code: `const ensureFound =
  (appointmentId: AppointmentId) =>
  (appointment: AppointmentState | undefined) =>
    ensureAppointmentFound(appointment, appointmentId);

export const startExaminationWithEffects =
  (deps: EffectsDependencies) =>
  (
    input: StartExaminationWithEffectsInput,
  ): ResultAsync<InExamination, StartExaminationWithEffectsError> =>
    resolveAppointment(deps)(input.appointmentId)
      .andThen(ensureFound(input.appointmentId))
      .andThen(ensureCheckedIn)
      .map(startExaminationEvent(deps, input.veterinarianId))
      .andThrough(deps.examinationStartedStore.store)
      .map((event) => event.aggregateState);`,
    },
    examples: [
      {
        caption: "andThen でつなぐと、次へ渡る値が void になります（配布コードにはありません）",
        code: `.andThen(deps.examinationStartedStore.store) // 次へ渡る値は void
.map((event) => event.aggregateState); // 型エラー`,
      },
    ],
  },
  {
    before: {
      caption: "すべての reject を業務エラーへ変換する書き方（配布コードにはありません）",
      code: `ResultAsync.fromPromise(
  deps.stateStore.save(event.aggregateState),
  () =>
    ({
      kind: "AppointmentConflict",
      appointmentId: event.appointmentId,
    }) as const,
);`,
    },
    after: {
      sources: ["examples/session-07/src/useCase/startExamination.ts"],
      code: `const resolveAppointment =
  (deps: EffectsDependencies) =>
  (appointmentId: AppointmentId): ResultAsync<AppointmentState | undefined, never> =>
    ResultAsync.fromSafePromise(
      Promise.resolve().then(() => deps.resolver.resolveById(appointmentId)),
    );`,
    },
    examples: [
      {
        sources: ["examples/session-07/src/adaptor/secondary/sqlite/examinationStartedStore.ts"],
        code: `store: (event) =>
  ResultAsync.fromSafePromise(
    Promise.resolve().then(() => storeAtomically(event)),
  ).andThen((result) => result),`,
      },
    ],
  },
];
const chapters = [
  { id: "incident", label: "今回つくるもの" },
  { id: "legacy", label: "コードを読み、失敗を再現する" },
  { id: "teach", label: "事前知識" },
  { id: "refactor", label: "演習" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
export const promisesHref =
  "/sessions/01-state-transitions/#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/05-business-events-and-workflows/",
    title: "データとパイプラインで予約キャンセルを設計する",
  },
  next: {
    href: "/sessions/final/",
    title: "参照実装で境界をたどる",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const delegationPrompt = `次の変更を実装してください。

業務背景:
${session.incident}

依頼:
${exerciseSession.delegationPrompt.request}

一緒に記録する必要がある値: [言語化フェーズで書いた1文]

着手前に判断すること:
${exerciseSession.delegationPrompt.decisions.map((decision) => `- ${decision}: [自分の判断を書く]`).join("\n")}

まず配布コードと失敗しているテストを読み、上の判断と変更方針を短く説明してください。説明のあとで実装に進んでください。設計手段は既存コードに合うものを選び、選んだ理由も示してください。

受け入れ条件:
${session.steps.map((step) => `- ${step.goal}`).join("\n")}

変更範囲:
- ${session.exerciseModule.dir}/ のみ
- 最大 ${session.exerciseModule.fileBudget} ファイル・約 ${session.exerciseModule.lineBudget} 行
- 範囲外の変更が必要に見えた場合は、変更せず理由を報告してください
- 型エラーを \`as\` による型アサーションで回避しないでください

検証:
- ${session.exerciseCommand} を実行し、すべての assertion が成功することを確かめてください

完了時の報告:
- 変更したファイルと判断理由
- 検証コマンドの結果
- 型だけでは守れず、テストまたはレビューに残した点`;
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file case-file--session">
    <header class="case-file__site-header"><a href="/"><span class="case-file__brand-mark" aria-hidden="true">🐾</span>WAN NYAN CLINIC</a></header>
    <main>
      <SessionPageNavigation currentSlug={session.slug} chapters={chapters}>
      <section slot="hero" class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <Prose
        components={{ CodeGuideCards, CommandBlock, EpisodeIllustration }}
        session={session}
        guides={guides}
        workspace={workspace}
        projectFiles={projectFiles}
        solutionSteps={solutionSteps}
        teaching={teaching}
        delegationPrompt={delegationPrompt}
        headcount={headcount}
        promisesHref={promisesHref}
      />
      <nav slot="footer" class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
      </SessionPageNavigation>
    </main>
  </div>
</BaseLayout>
