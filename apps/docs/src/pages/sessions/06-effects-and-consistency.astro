---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/06-effects-and-consistency";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("06-effects-and-consistency");
if (session === undefined) {
  throw new Error("Unknown session: 06-effects-and-consistency");
}
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement:
        "誰がいつ診察を開始したかを業務イベントとし、予約状態と監査記録を一つの保存境界へ渡す。",
      currentRisk:
        "時刻と ID を処理中に直接作り、状態と監査記録を別々に保存するため、テスト結果が安定せず、片方だけが残り得る。",
      design:
        "Clock と EventIdGenerator を port として注入し、副作用を調整するワークフローで EventContext を一度だけ生成する。純粋な状態遷移にはその EventContext を渡し、状態と監査記録を表す ExaminationStarted を単一の store へ保存する。予約が存在しない・予約の状態が不正・予約が競合しているケースは Result のエラーを返す。データベース起因のエラーやデータが破損しているエラーは業務エラーには変換せず、Promise の reject として外側の境界へ伝える。",
      limitation:
        "in-memory の一括保存は契約の形を示す。本番の永続化層でアトミック性を守るには、transaction と結合テストが必要になる。",
      nextQuestion:
        "境界の外側でインフラ起因のエラーなどの技術的なエラーを安全に記録し、500 エラーに変換するにはどのように実装するか。",
      legacy:
        "直接時刻を参照したりIDを生成したりしている処理、状態の保存と監査記録の保存がアトミックになっていない実装を読んでみましょう。例えば監査記録の保存だけが失敗した場合、状態の保存のみが実行され、不整合な状況が発生してしまいます。また、用意された単一の store に業務競合が届かない箇所を探します。",
      reviewFocus:
        "予約の競合は Result のエラーとして扱われているか。データベース起因のエラーやデータが破損しているエラーは Promise の reject として呼び出し元に伝わっているか。また成功時は、状態の保存とと監査記録の保存が一つの store へ順番通りに渡るか。",
      fallback:
        "各解答欄には、import と後続 step を含む完成ファイルを target ごとに示します。表示されたすべての target file を反映した後、同じ exercise の検査がパスすることを確認します。各 step を個別にパスすることは想定していません。講師のデモへ切り替えた場合でも、相互レビューは実施しましょう。",
    }}
  />
  <aside class="failure-boundary" aria-label="業務エラーとインフラ例外の区別">
    <h2>2つの失敗経路を見分ける</h2>
    <ul class="decision-list">
      <li>
        <strong>業務上のエラー:</strong> 予約が存在しない・予約の状態が不正・予約が競合しているケースは、呼び出し元で次の対応を選択する余地があるため、
        <code>Result</code> の <code>Err</code> で返します。
      </li>
      <li>
        <strong>運用上の異常:</strong> データベース起因のエラーやデータが破損しているエラーは呼び出し元でも解決できません。境界の外側で安全に記録し、エラーの詳細を含まない形で
        HTTP 500 のレスポンスに変換します。
      </li>
    </ul>
  </aside>
</SessionLayout>
