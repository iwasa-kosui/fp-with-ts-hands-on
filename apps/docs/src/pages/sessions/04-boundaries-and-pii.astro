---
import { Code } from "astro:components";
import CommandBlock from "../../components/CommandBlock.astro";
import { CodeExplorer } from "../../components/code-explorer/CodeExplorer";
import type { CodeGuide } from "../../code-explorer/code-guide";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import type { SessionWorkspace } from "../../code-explorer/types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSolutionSnippets } from "../../sessions/solution-snippets";
import type {
  ExerciseSessionSummary,
  SessionSummary,
} from "../../sessions/types";
import "../../styles/code-playground.css";
import "../../styles/sessions.css";

type TeachingCode = Readonly<{
  sources?: readonly [string, ...string[]];
  caption?: string;
  code: string;
}>;

type TeachingTopic = Readonly<{
  name: string;
  definition: string;
  before: TeachingCode;
  after: TeachingCode;
  example?: Readonly<{ caption: string; code: string }>;
  why: string;
}>;

export const session: SessionSummary = {
  slug: "04-boundaries-and-pii",
  snapshot: "session-04",
  sequence: "04",
  kind: "exercise",
  title: "外部入力を境界で検証し個人情報を守る",
  durationMinutes: 30,
  timeBreakdown: { brief: 4, teach: 7, exercise: 12, review: 7 },
  adv: { articulate: 2, delegate: 8, verify: 2 },
  peerReview: {
    minutes: 7,
    pickCount: 2,
    questions: [
      "外部 JSON は、Zod の検証に成功したときだけ `ExamResult` になりますか。",
      "氏名・電話番号・メールは、`JSON.stringify` と `util.inspect` のどちらでも既定でマスクされますか。",
      "`OwnerContact` の各項目は、平文の `string` ではなく `Sensitive` になっていますか。",
    ],
  },
  solutionSnapshot: "session-05",
  solutionPresentation: "excerpt",
  peerReviewPromises: "reference",
  animal: { name: "BIRD", type: "bird", avatar: "🐦" },
  summary: "外部 JSON と飼い主の連絡先を、境界で安全な値へ変換します。",
  episode: [
    "小鳥の検査結果は、項目が欠け、余計な値が増え、「要経過観察」だけが妙に元気な JSON でした。",
    "システムは全部受け入れたうえ、調査ログへ飼い主の電話番号まで丁寧に転載します。",
    "入力には寛大で、個人情報にはおしゃべり。それが現在の境界です。",
  ],
  incident: "検査機関から届いた JSON をそのまま信頼し、調査用のログへ飼い主の連絡先が流出した。",
  exerciseCommand: "pnpm exercise:04",
  exerciseModule: {
    dir: "examples/session-04/src/boundary",
    fileBudget: 2,
    lineBudget: 26,
  },
  delegationPrompt: {
    request:
      "検査機関の JSON と飼い主の連絡先を別のリスクとして扱ってください。未検証の入力がドメインへ入らず、連絡先が既定で公開されない形に改善してください。",
    decisions: [
      "外部入力を信頼済みの値へ変える境界はどこか",
      "連絡先を取り出してよい処理はどこか",
    ],
  },
  steps: [
    {
      id: "s4-parse-exam-result",
      goal: "形式が異なる検査結果の JSON は、ドメイン型にならないようにする。",
      targets: ["examples/session-04/src/boundary/examResult.ts"],
      solutions: [{
        path: "examples/session-05/src/boundary/examResult.ts",
        symbol: "ExamResult",
        lines: [7, 19],
      }],
    },
    {
      id: "s4-protect-contact",
      goal: "電話番号とメールは既定でログに出ないようにする。",
      targets: ["examples/session-04/src/boundary/ownerContact.ts"],
      solutions: [{
        path: "examples/session-05/src/boundary/ownerContact.ts",
        symbol: "OwnerContact",
        lines: [6, 19],
      }],
    },
  ],
  decisions: [
    {
      invariant: "外部入力は、境界で検証してからドメイン型になる。",
    },
    {
      invariant: "個人情報は既定でマスクし、値を取り出す場所を限定する。",
    },
  ],
  finalReferences: [
    "examples/final/src/domain/shared/schemaResult.ts",
    "examples/final/src/domain/shared/sensitive.ts",
    "examples/final/src/domain/owner/ownerPhone.ts",
    "examples/final/src/domain/examResult/examResult.ts",
  ],
};

export const guides = ([
  {
    id: "unvalidated-exam-json",
    title: "入力された検査 JSON を any のままドメイン型へ入れている",
    currentDesign: "入力値の形式を検証せず、手書きの ExamResult へ詰め替えています。",
    futureRisk: "petId の欠落が境界を通過し、後続の処理で初めて壊れます。",
    path: "src/boundary/examResult.ts",
    highlights: [{ startLineNumber: 5, endLineNumber: 20 }],
  },
  {
    id: "plain-contact-pii",
    title: "input から連絡先を文字列のまま返している",
    currentDesign: "ownerName・email・phone を any からそのままコピーしています。",
    futureRisk: "JSON化やログ出力で個人情報がそのまま露出します。",
    path: "src/boundary/ownerContact.ts",
    highlights: [{ startLineNumber: 3, endLineNumber: 16 }],
  },
] as const) satisfies readonly CodeGuide[];

const teaching: readonly TeachingTopic[] = [
  {
    name: "schema による境界検証と Result",
    definition:
      "外から届く unknown 型の値を schema でバリデーションし、正しい値だけをドメイン型として扱います。バリデーションに失敗した場合、エラーを Result で返します。",
    before: {
      sources: ["examples/session-04/src/boundary/examResult.ts"],
      code: `export const ExamResult = {
  parse: (raw: any): Result<ExamResult> =>
    ok({
      examId: raw.examId,
      petId: raw.petId,
      items: raw.items ?? [],
      needsFollowUp: !!raw.needsFollowUp,
    }),
} as const;`,
    },
    after: {
      sources: ["examples/session-05/src/boundary/examResult.ts"],
      code: `const ExamResultSchema = z.object({
  examId: ExamId.schema,
  petId: PetId.schema,
  items: z.array(z.string().min(1)).readonly(),
  needsFollowUp: z.boolean().default(false),
}).readonly();

export type ExamResult = z.infer<typeof ExamResultSchema>;

export const ExamResult = {
  schema: ExamResultSchema,
  parse: schemaResult(ExamResultSchema),
} as const;`,
    },
    why: "before は raw を any で受けるため、検証を行わなくても型検査が通ってしまいます。after は unknown を schema でパースするので、検証を通さない限り値を取り出せません。これで「外部入力は、境界で検証してからドメイン型にする」ことを型で守れます。前の回で作った ExamId.schema と PetId.schema をここへ埋め込むと、識別子を作る経路が境界の1か所に集まります。parse は失敗しうる処理なので、失敗は例外ではなく戻り値の Result に現します。この回は失敗が戻り値に出るところまでを扱い、Result の分岐と合成は S5 で扱います。",
  },
  {
    name: "Sensitive を実装して、デフォルトで情報がログに出力されないようにする",
    definition:
      "個人情報を wrap する型です。toJSON と toString をオーバーライドし [REDACTED] を返すようにします。中身を取り出すためには unwrap を呼び出す必要があります。",
    before: {
      sources: ["examples/session-04/src/boundary/ownerContact.ts"],
      code: `export type OwnerContact = Readonly<{
  ownerName: string;
  ownerEmail: string;
  ownerPhone: string;
}>;`,
    },
    after: {
      sources: [
        "examples/session-05/src/shared/sensitive.ts",
        "examples/session-05/src/boundary/ownerContact.ts",
      ],
      code: `export const Sensitive = {
  of: <T>(value: T): Sensitive<T> => ({
    unwrap: () => value,
    toJSON: () => "[REDACTED]",
    toString: () => "[REDACTED]",
    [inspect.custom]: () => "[REDACTED]",
  }),
} as const;

const OwnerContactSchema = z
  .object({
    ownerName: z.string().min(1).brand<"OwnerName">().transform(Sensitive.of),
    ownerEmail: z.string().email().brand<"OwnerEmail">().transform(Sensitive.of),
    ownerPhone: z.string().min(1).brand<"OwnerPhone">().transform(Sensitive.of),
  })
  .readonly();`,
    },
    why: "個人情報を平文の string で持つと、JSON.stringify や console.log で簡単に個人情報がログに出てしまうことになります。これをレビューで守り続けることは困難でしょう。Sensitive で wrap するとデフォルトで値が表示されないようになり、値を取り出すには unwrap を明示的に呼び出さなければなりません。unwrap で検索すれば、個人情報が平文として取り出されている箇所を簡単に調べることができます。1行に brand と transform が並んでいますが、2つは別の目的です。brand は OwnerEmail を OwnerPhone などの他の値と取り違えないようにするための仕組み（Branded Type）で、ログ出力には影響しません。ログへの漏えいを防いでいるのは Sensitive.of のほうです。",
  },
];

const narrative = {
  requirement: "外部から入力される JSON が想定とは異なる場合、エラーにする。また、個人情報はデフォルトでログには出力されないようにする。",
  currentRisk: "検査機関から届く値をそのまま信頼してしまうと、想定している型とは違う形のデータがドメインに入り込んでしまう可能性がある。また、個人情報などを適切に検出できず、うっかりログなどに載ってしまう可能性がある。",
  design: "外部から入力される JSON は、必ず検証してからドメイン型に変換する。個人情報は、デフォルトでログに出力されないような形に変換して取り扱う。",
  limitation: "Sensitive を unwrap した後の文字列の扱いは、型では守れない。",
  legacy: "raw: any 型の値を受け取る parse や、連絡先を平文の string で保持する実装を確認します。これを改善して、入力と出力の境界を明確にしましょう。",
  fallback: "現在の2ステップを順に開き、まず不正な JSON を Err として返します。次に連絡先の3項目を Sensitive にします。相互レビューの約束事はS2のリンク先を確認します。",
} as const;

const exerciseSession: ExerciseSessionSummary = session;

export const workspace = ({
  slug: session.slug,
  snapshot: session.snapshot,
  initialFile: "exercises/boundary-and-pii.test.ts",
  description: "input の検証と PII の境界を開始 snapshot で確認します。",
  visibleFiles: [
    "exercises/boundary-and-pii.test.ts",
    "test/regression/semantic-identifiers.test.ts",
    "test/regression/state-modeling.test.ts",
    "src/domain/appointment/appointment.ts",
    "src/boundary/examResult.ts",
    "src/boundary/ownerContact.ts",
  ],
} as const) satisfies SessionWorkspace;

const projectFiles = projectFilesForSnapshot(session.snapshot);
const solutionSteps = await Promise.all(
  session.steps.map(async (step) => ({
    step,
    presentation: step.solutions[0].presentation ?? "excerpt",
    snippets: await loadSolutionSnippets(step),
  })),
);
const chapters = [
  { id: "incident", label: "今回つくるもの" },
  { id: "legacy", label: "コードを読み、失敗を再現する" },
  { id: "teach", label: "使う型を知る" },
  { id: "refactor", label: "型で閉じる" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
const commonReviewChecks = [
  "`as` によるキャストが入っていないか全文検索して確認する。",
  "`git diff --stat -- examples/session-04` で今回の snapshot だけを確認する。`git status --short` で想定外の path がないか確認する。",
  "不変条件を型で守っているか、実行時の `if` で守っているかを判定し、型で守れなかった残りを記録する。",
] as const;
const reviewCompletionArtifacts = [
  "守る不変条件の1文",
  "依頼文",
  "型で守れなかった残り",
] as const;
const businessReflectionQuestion =
  "自分の業務コードで、今回と同種の問題が起きうる箇所はどこですか。";
export const promisesHref =
  "/sessions/02-state-transitions/#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/03-semantic-identifiers/",
    title: "用途の異なる識別子を型で区別する",
  },
  next: {
    href: "/sessions/05-workflow-errors/",
    title: "失敗をワークフローの結果として扱う",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const delegationPrompt = `次の変更を実装してください。

業務背景:
${session.incident}

依頼:
${exerciseSession.delegationPrompt.request}

守る不変条件: [言語化フェーズで書いた1文]

着手前に判断すること:
${exerciseSession.delegationPrompt.decisions.map((decision) => `- ${decision}: [自分の判断を書く]`).join("\n")}

まず配布コードと失敗しているテストを読み、上の判断と変更方針を短く説明してください。説明のあとで実装に進んでください。設計手段は既存コードに合うものを選び、選んだ理由も示してください。

受け入れ条件:
${session.steps.map((step) => `- ${step.goal}`).join("\n")}

変更範囲:
- ${session.exerciseModule.dir}/ のみ
- 最大 ${session.exerciseModule.fileBudget} ファイル・約 ${session.exerciseModule.lineBudget} 行
- 範囲外の変更が必要に見えた場合は、変更せず理由を報告する
- 型エラーを \`as\` によるキャストで回避しない

検証:
- ${session.exerciseCommand} を実行し、すべての assertion が成功すること

完了時の報告:
- 変更したファイルと判断理由
- 検証コマンドの結果
- 型だけでは守れず、テストまたはレビューに残した点`;
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header"><a href="/">WAN NYAN CLINIC</a></header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <div class="case-file__body">
        <aside class="case-file__toc case-file__toc--desktop">
          <nav aria-label="ページ内目次"><ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
        </aside>
        <details class="case-file__toc case-file__toc--mobile">
          <summary>目次</summary>
          <nav aria-label="ページ内目次"><ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
        </details>
        <article class="case-file__content">
          <section id="incident">
            <h2>今回つくるもの</h2>
            <aside class="case-file__episode" aria-label="動物病院のひと幕">
              <p class="case-file__episode-label">動物病院のひと幕</p>
              {session.episode.map((line) => <p data-episode-line>{line}</p>)}
            </aside>
            <h3 data-story-stage="use-case">追加したい機能</h3>
            <p>{narrative.requirement}</p>
            <h3 data-story-stage="pitfall">素朴な実装の落とし穴</h3>
            <p>{narrative.currentRisk}</p>
            <h3 data-story-stage="goal">このセッションのゴール</h3>
            <p>{narrative.design}</p>
            <h3>このセッションで守ること</h3>
            <ul class="decision-list">{session.decisions.map(({ invariant }) => <li>{invariant}</li>)}</ul>
            <p>今回の変更は <code>{session.exerciseModule.dir}</code> 内の1モジュールに限定します。</p>
          </section>

          <section id="legacy">
            <h2>コードを読み、失敗を再現する</h2>
            <p>{narrative.legacy}</p>
            <p>
              編集する範囲は <code>{session.exerciseModule.dir}</code>、変更するファイル数は最大
              {session.exerciseModule.fileBudget}ファイル・約{session.exerciseModule.lineBudget}行です。
            </p>
            <section class="session-code-overview code-playground" aria-labelledby={`code-overview-${session.slug}`}>
              <h3 id={`code-overview-${session.slug}`}>配布コードの設計課題</h3>
              <p>ここでは修正せず、今回の事故につながる設計課題の場所を確認します。</p>
              <div data-code-explorer={workspace.slug} data-code-overview>
                <CodeExplorer client:load workspace={workspace} projectFiles={projectFiles} guides={guides} />
              </div>
            </section>
            <h3>見つけた問題を RED で確かめる</h3>
            <p>配布コードで見つけた問題が、業務名を持つ assertion の失敗として現れることを確認します。</p>
            <CommandBlock phase="red" command={session.exerciseCommand} expected={`${session.steps.length}件の参加者ステップが、業務上の未解決条件として失敗します。`} />
            <h3>今回のステップ</h3>
            <ol class="exercise-steps">{session.steps.map((step) => <li><strong>{step.goal}</strong></li>)}</ol>
          </section>

          <section id="teach">
            <h2>事前知識（{session.timeBreakdown.teach}分）</h2>
            <p>この回で利用する型について確認します。配布コードの書き方を before、次のスナップショットの書き方を after として並べています。</p>
            {teaching.map((topic) => (
              <article class="teaching-topic">
                <h3>{topic.name}</h3>
                <p>{topic.definition}</p>
                <div class="teaching-topic__diff">
                  <figure class="code-block">
                    <figcaption>
                      before:
                      {topic.before.caption === undefined ? topic.before.sources?.map((source, index) => (
                        <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                      )) : <span>{topic.before.caption}</span>}
                    </figcaption>
                    <Code code={topic.before.code} lang="ts" />
                  </figure>
                  <figure class="code-block">
                    <figcaption>
                      after:
                      {topic.after.caption === undefined ? topic.after.sources?.map((source, index) => (
                        <Fragment>{index === 0 ? null : "、"}<code>{source}</code></Fragment>
                      )) : <span>{topic.after.caption}</span>}
                    </figcaption>
                    <Code code={topic.after.code} lang="ts" />
                  </figure>
                </div>
                {topic.example === undefined ? null : (
                  <figure class="code-block" data-teaching-example>
                    <figcaption>{topic.example.caption}</figcaption>
                    <Code code={topic.example.code} lang="ts" />
                  </figure>
                )}
                <p class="teaching-topic__why">{topic.why}</p>
              </article>
            ))}
          </section>

          <section id="refactor">
            <h2>演習</h2>
            <h3>進め方: 言語化 → Agentへの依頼 → 検証</h3>
            <ol class="adv-flow">
              <li><strong>言語化（{session.adv.articulate}分）</strong>: 守るべき不変条件を1文で書く。</li>
              <li><strong>依頼（{session.adv.delegate}分）</strong>: 不変条件と自分の判断をテンプレートへ入れ、Agent に依頼する。</li>
              <li><strong>検証（{session.adv.verify}分）</strong>: 型、テスト、差分の範囲を確認する。</li>
            </ol>
            <div class="delegation-prompt">
              <h3>プロンプトのテンプレート</h3>
              <p>角括弧の中は、事故と配布コードを読んだ自分の判断で埋めます。技法名や完成形を先に指定する必要はありません。</p>
              <pre><code>{delegationPrompt}</code></pre>
            </div>
            <h3>この演習で解決しないこと</h3>
            <p>{narrative.limitation}</p>
            <h3 data-solution-heading>{exerciseSession.solutionPresentation === "completed-file" ? "完成ファイルの解答例" : "ステップごとの解答"}</h3>
            {exerciseSession.solutionPresentation === "completed-file" ? (
              <div class="before-after" aria-label="業務結果と非同期例外経路の見比べ方">
                <p><strong>演習の開始時点:</strong> 予期できる業務 Result と、保存処理が reject する技術的な例外経路を分けて読む。</p>
                <p><strong>完成例:</strong> 下のすべての target file には、後続 step を含む完成状態が表示される。</p>
              </div>
            ) : null}
            {solutionSteps.map(({ step, presentation, snippets }) => (
              <div class="solution-step">
                <details class="step-solution" data-presentation={presentation}>
                  <summary>{step.goal}</summary>
                  {presentation === "completed-file" ? (
                    <p class="step-solution__completed-file-note">この完成例には後続 step を含みます。表示されたすべての target file を反映した後、同じ exercise を GREEN にします。</p>
                  ) : null}
                  {snippets.map(({ solution, code }) => (
                    <section class="step-solution__snippet">
                      <h4><code>{solution.path}</code></h4>
                      <Code code={code} lang="ts" />
                    </section>
                  ))}
                </details>
              </div>
            ))}
            <section class="session-code-playground code-playground" aria-labelledby="code-playground">
              <h3 id="code-playground">ブラウザで試す</h3>
              <p>このセッションの開始時点のコード一式を編集して、ターミナルから任意のコマンドで確認できます。</p>
              <p>編集内容とコマンドはこのブラウザ内だけに保持されます。ターミナルを利用できない場合は、ページ内の <code>pnpm</code> 手順を使います。</p>
              <div data-code-explorer={workspace.slug}><CodeExplorer client:load workspace={workspace} projectFiles={projectFiles} /></div>
            </section>
            <CommandBlock phase="green" command={session.exerciseCommand} expected="assertionが成功することを確認する" />
            <h3>演習を完了できないとき</h3>
            <p>{narrative.fallback}</p>
          </section>

          <section id="review">
            <h2>レビューと持ち帰り</h2>
            <div class="exercise-review-checklist">
              <h3>個人で確認する</h3>
              <ol>{commonReviewChecks.map((check) => <li>{check}</li>)}</ol>
              <p>前のセッションの未commit差分は残して構いません。reset、stash、commit は不要です。</p>
              <p><strong>残すもの:</strong> {reviewCompletionArtifacts.join("、")}</p>
              <h3>業務へ持ち帰る</h3>
              <p>{businessReflectionQuestion}</p>
            </div>
            <section class="peer-review-panel">
              <h3>班内相互レビュー（{session.peerReview.minutes}分・{headcount}）</h3>
              <p><a href={promisesHref}>進行上の約束事を確認する</a></p>
              <ol>{session.peerReview.questions.map((question) => <li>{question}</li>)}</ol>
            </section>
          </section>
        </article>
      </div>
      <nav class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
    </main>
  </div>
</BaseLayout>
