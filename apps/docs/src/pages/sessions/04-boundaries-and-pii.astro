---
import { Code } from "astro:components";
import CodeGuideCards from "../../components/CodeGuideCards.astro";
import CommandBlock from "../../components/CommandBlock.astro";
import SessionPageNavigation from "../../components/SessionPageNavigation.astro";
import { CodeExplorer } from "../../components/code-explorer/CodeExplorer";
import type { CodeGuide } from "../../code-explorer/code-guide";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import type { SessionWorkspace } from "../../code-explorer/types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSolutionSnippets } from "../../sessions/solution-snippets";
import type {
  ExerciseSessionSummary,
  SessionSummary,
} from "../../sessions/types";
import "../../styles/code-playground.css";
import "../../styles/sessions.css";

type TeachingTopic = Readonly<{
  name: string;
  explanation: string;
  code: string;
  takeaway: string;
}>;

export const session: SessionSummary = {
  slug: "04-boundaries-and-pii",
  snapshot: "session-04",
  sequence: "04",
  kind: "exercise",
  title: "入力を検証し、監査記録から個人情報を除く",
  durationMinutes: 30,
  timeBreakdown: { brief: 4, teach: 6, exercise: 15, review: 5 },
  adv: { articulate: 3, delegate: 9, verify: 3 },
  peerReview: {
    minutes: 5,
    pickCount: 2,
    questions: [
      "不正な2項目を同時に送ったとき、両方の検証問題とpathを確認できますか。",
      "422を返す経路では、予約状態と監査記録が変更されませんか。",
      "診察開始の監査データは3項目だけで、予約テーブルにも飼い主の連絡先が残りませんか。",
    ],
  },
  solutionSnapshot: "session-05",
  solutionPresentation: "excerpt",
  peerReviewPromises: "reference",
  animal: { name: "BIRD", type: "bird", avatar: "🐦" },
  summary: "外部入力は検証してから受け入れ、監査記録には必要な項目だけを保存します。",
  episode: [
    "2026年8月30日15時20分、猫のムギは受付を終え、診察開始を待っていました。",
    "15時30分、勤務表連携から獣医師IDの代わりに「night-shift」が届きましたが、予約は診察中へ変わりました。",
    "原因を追った監査記録には、不正な担当者IDと一緒に飼い主の氏名、メールアドレス、電話番号まで残っていました。",
  ],
  incident: "不正な獣医師IDで診察が始まり、調査用の監査記録には不要な飼い主の連絡先まで保存された。",
  exerciseCommand: "pnpm exercise:04",
  exerciseModule: {
    dir: "examples/session-04",
    fileBudget: 5,
    lineBudget: 80,
  },
  delegationPrompt: {
    request:
      "診察開始要求の入口と監査記録への出口を改善してください。不正な入力では副作用を起こさず、正常な診察開始では必要な監査項目だけを保存します。",
    decisions: [
      "検証失敗時にどの問題を呼び出し側へ返すか",
      "どの処理より前に422を返すか",
      "診察開始の監査に必要な項目は何か",
    ],
  },
  steps: [
    {
      id: "s4-validate-all-start-input",
      goal: "不正な予約IDと獣医師IDを拒否し、両方の検証問題とpathを残す。",
      startingFailure: "不正な2種類のIDを同時に送っても、型付き入力として受け入れてしまう。",
      targets: [
        "examples/session-04/src/boundary/startExaminationInput.ts",
      ],
      solutions: [
        {
          path: "examples/session-05/src/boundary/startExaminationInput.ts",
          symbol: "StartExaminationInput",
          lines: [1, 17],
        },
      ],
    },
    {
      id: "s4-return-422-without-side-effects",
      goal: "検証失敗では422を返し、予約状態と監査記録を変更しない。",
      startingFailure: "不正な獣医師IDでも303を返し、予約状態と監査記録を変更してしまう。",
      targets: ["examples/session-04/src/web/routes.ts"],
      solutions: [
        {
          path: "examples/session-05/src/web/routes.ts",
          symbol: "decodeStartExaminationPayload",
          lines: [46, 52],
        },
        {
          path: "examples/session-05/src/web/routes.ts",
          symbol: "registerClinicRoutes",
          lines: [81, 88],
        },
      ],
    },
    {
      id: "s4-minimize-persisted-audit-data",
      goal: "診察開始の監査データを3項目へ絞り、利用しない飼い主の連絡先を保存しない。",
      startingFailure: "予約全体と飼い主の連絡先を監査記録と予約テーブルへ保存している。",
      targets: [
        "examples/session-04/src/adaptor/secondary/sqlite/appointmentRepository.ts",
        "examples/session-04/src/adaptor/secondary/sqlite/schema.ts",
        "examples/session-04/drizzle/0000_initial.sql",
      ],
      solutions: [
        {
          path: "examples/session-05/src/adaptor/secondary/sqlite/appointmentRepository.ts",
          symbol: "ExaminationStartedAuditPayload",
          lines: [23, 27],
        },
        {
          path: "examples/session-05/src/adaptor/secondary/sqlite/appointmentRepository.ts",
          symbol: "toExaminationStartedAuditPayload",
          lines: [47, 61],
        },
        {
          path: "examples/session-05/src/adaptor/secondary/sqlite/appointmentRepository.ts",
          symbol: "reset",
          lines: [145, 152],
        },
        {
          path: "examples/session-05/src/adaptor/secondary/sqlite/schema.ts",
          symbol: "appointmentsTable",
          lines: [3, 12],
        },
      ],
    },
  ],
  decisions: [
    {
      invariant: "外部の値はunknownとして受け取り、検証に成功するまでドメインの入力として扱わない。",
    },
    {
      invariant: "検証失敗は副作用より前に422へ変換し、項目ごとの問題を呼び出し側へ返す。",
    },
    {
      invariant: "保存先へ渡すデータは、除外項目ではなく必要項目を列挙して組み立てる。",
    },
  ],
  finalReferences: [
    "examples/final/src/shared/schemaResult.ts",
    "examples/final/src/domain/appointment/appointmentId.ts",
    "examples/final/src/domain/appointment/veterinarianId.ts",
    "examples/final/src/useCase/startExaminationUseCase.ts",
  ],
};

export const guides = ([
  {
    id: "http-start-examination-input",
    title: "HTTP本文を検証せず診察開始へ渡している",
    currentDesign: "path parameterとHTTP本文をまとめた後、検証結果をunsafeに取り出しています。",
    futureRisk: "不正な値を受け入れるか、検証を追加しても失敗を500へ変換してしまいます。",
    path: "src/web/routes.ts",
    highlights: [{ startLineNumber: 109, endLineNumber: 114 }],
  },
  {
    id: "unvalidated-start-examination-input",
    title: "anyを手書きの型へコピーしている",
    currentDesign: "予約IDと獣医師IDを検証せず、型注釈だけを付けています。",
    futureRisk: "実行時の文字列がUUIDでなくてもStartExaminationInputになります。",
    path: "src/boundary/startExaminationInput.ts",
    highlights: [{ startLineNumber: 1, endLineNumber: 15 }],
  },
  {
    id: "overbroad-audit-payload",
    title: "予約全体と飼い主の連絡先を監査へコピーしている",
    currentDesign: "すべての監査データへ予約全体とownerContactを追加しています。",
    futureRisk: "診察開始の追跡に不要な個人情報まで、監査記録へ長期間残ります。",
    path: "src/adaptor/secondary/sqlite/appointmentRepository.ts",
    highlights: [{ startLineNumber: 86, endLineNumber: 96 }],
  },
] as const) satisfies readonly CodeGuide[];

const teaching: readonly TeachingTopic[] = [
  {
    name: "入口ではunknownから始める",
    explanation:
      "TypeScriptの型注釈は、HTTPから届いた実行時の値を検証しません。境界ではunknownとして受け取り、schemaの検証に成功した値だけを型付き入力として扱います。",
    code: `unknown
  → 検証
      ├─ Err: ValidationIssue[]
      └─ Ok: StartExaminationInput`,
    takeaway: "入力の型は、検証を通過した事実を表します。",
  },
  {
    name: "検証失敗は副作用より前で止める",
    explanation:
      "422を返すだけでは足りません。予約の読み込み、状態遷移、保存、監査追加のどれにも進んでいないことを、演習では要求前後のRepository、通常テストでは実ファイルSQLiteで確認します。",
    code: `検証結果
  ├─ Err → 422
  │         予約状態: 変更なし
  │         監査件数: 変更なし
  └─ Ok  → 診察開始へ進む`,
    takeaway: "失敗時に実行しない処理まで含めて、境界の契約にします。",
  },
  {
    name: "出口では必要な項目を列挙する",
    explanation:
      "予約全体から個人情報だけを削ると、将来追加された項目が監査へ流れます。診察開始の追跡に必要な予約ID、獣医師ID、診察開始時刻を明示的に組み立てます。",
    code: `type ExaminationStartedAuditPayload = Readonly<{
  appointmentId: AppointmentId;
  veterinarianId: VeterinarianId;
  examinationStartedAt: string;
}>;`,
    takeaway: "許可する項目を先に決めると、ドメインモデルの拡張が監査データを勝手に広げません。",
  },
];

const narrative = {
  requirement:
    "病院責任者は、不正な要求で予約を変更せず、診察開始の監査には予約ID、獣医師ID、診察開始時刻だけを残すよう求めています。",
  currentRisk:
    "入口ではanyを型付き入力へコピーし、出口では予約全体と飼い主の連絡先を監査へコピーしています。どちらも境界を越えるデータを制限できていません。",
  design:
    "入口ではunknownを検証して失敗を422へ変換し、出口では用途別の監査データを明示的に組み立てます。",
  limitation:
    "JSONとして読み取れないHTTP本文の正規化は扱いません。予約が存在しない場合と受付前の状態はSession 05、状態保存と監査追加の整合性や保存障害はSession 06で扱います。",
  legacy:
    "診察開始route、入力変換、監査保存を順に読み、一つのHTTP要求がどこまで不正な値と個人情報を運ぶか確認します。",
  fallback:
    "まず入力変換だけを直して検証問題を確認し、次にrouteの422分岐、最後に監査データの組み立てへ進みます。3段階を同時に変更せず、各段階で演習テストを実行します。",
} as const;

const exerciseSession: ExerciseSessionSummary = session;

export const workspace = ({
  slug: session.slug,
  snapshot: session.snapshot,
  initialFile: "exercises/start-examination-input.test.ts",
  description: "診察開始要求の入口と、監査記録へ出すデータを確認します。",
  visibleFiles: [
    "exercises/start-examination-input.test.ts",
    "src/domain/appointment/appointmentId.ts",
    "src/domain/appointment/veterinarianId.ts",
    "src/boundary/startExaminationInput.ts",
    "src/shared/schemaResult.ts",
    "src/web/routes.ts",
    "src/adaptor/secondary/sqlite/appointmentRepository.ts",
    "src/adaptor/secondary/sqlite/schema.ts",
    "drizzle/0000_initial.sql",
  ],
} as const) satisfies SessionWorkspace;

const projectFiles = projectFilesForSnapshot(session.snapshot);
const solutionSteps = await Promise.all(
  session.steps.map(async (step) => ({
    step,
    presentation: step.solutions[0].presentation ?? "excerpt",
    snippets: await loadSolutionSnippets(step),
  })),
);
const chapters = [
  { id: "incident", label: "事故を把握する" },
  { id: "legacy", label: "失敗を再現する" },
  { id: "teach", label: "境界の原則" },
  { id: "refactor", label: "演習" },
  { id: "review", label: "レビュー" },
] as const;
const commonReviewChecks = [
  "`as` によるキャストが入っていないか全文検索して確認する。",
  "`git diff --stat -- examples/session-04` で今回の snapshot だけを確認する。`git status --short` で想定外の path がないか確認する。",
  "型検査では確認できないことを、テストまたは実行時に確認して記録する。",
] as const;
const reviewCompletionArtifacts = [
  "境界で拒否する入力",
  "保存を許可する監査項目",
  "Agentへの依頼文",
  "型検査では確認できず、テストまたは実行時に確認すること",
] as const;
const businessReflectionQuestion =
  "自分の業務コードで、今回と同種の問題が起きうる箇所はどこですか。";
export const promisesHref =
  "/sessions/02-state-transitions/#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/03-semantic-identifiers/",
    title: "診察開始の識別子を型で区別する",
  },
  next: {
    href: "/sessions/05-workflow-errors/",
    title: "失敗をユースケースの結果として扱う",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const delegationPrompt = `次の変更を実装してください。

業務背景:
${session.incident}

依頼:
${exerciseSession.delegationPrompt.request}

境界で止める入力と保存する監査項目: [言語化フェーズで書いた内容]

着手前に判断すること:
${exerciseSession.delegationPrompt.decisions.map((decision) => `- ${decision}: [自分の判断を書く]`).join("\n")}

まず配布コードと失敗しているテストを読み、上の判断と変更方針を短く説明してください。説明のあとで実装に進んでください。

受け入れ条件:
${session.steps.map((step) => `- ${step.goal}`).join("\n")}

変更範囲:
- ${session.exerciseModule.dir}/ のみ
- 最大 ${session.exerciseModule.fileBudget} ファイル・約 ${session.exerciseModule.lineBudget} 行
- 範囲外の変更が必要に見えた場合は、変更せず理由を報告する
- 型エラーを as によるキャストで回避しない

検証:
- ${session.exerciseCommand} を実行し、すべての assertion が成功すること

完了時の報告:
- 変更したファイルと判断理由
- 検証コマンドの結果
- 不正な要求の前後で確認した予約状態と監査件数
- 正常な診察開始で保存した監査項目`;
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file">
    <header class="case-file__site-header"><a href="/">WAN NYAN CLINIC</a></header>
    <main>
      <section class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>

      <SessionPageNavigation currentSlug={session.slug} chapters={chapters}>
        <section id="incident">
          <h2>事故を把握する</h2>
          <aside class="case-file__episode" aria-label="動物病院のひと幕">
            <p class="case-file__episode-label">動物病院のひと幕</p>
            {session.episode.map((line) => <p data-episode-line>{line}</p>)}
          </aside>

          <h3 data-story-stage="use-case">病院責任者からの要求</h3>
          <p>{narrative.requirement}</p>

          <h3 data-story-stage="pitfall">現在の処理</h3>
          <p>{narrative.currentRisk}</p>
          <div class="before-after" aria-label="修正前の入力と監査の流れ">
            <p><strong>入口:</strong> HTTP本文 → any → 型付き入力 → 状態変更</p>
            <p><strong>出口:</strong> 予約全体 → 飼い主の連絡先を追加 → 監査記録</p>
          </div>

          <h3 data-story-stage="goal">このセッションのゴール</h3>
          <p>{narrative.design}</p>
          <ul class="decision-list">
            {session.decisions.map(({ invariant }) => <li>{invariant}</li>)}
          </ul>
        </section>

        <section id="legacy" class="code-playground">
          <h2>失敗を再現する</h2>
          <p>{narrative.legacy}</p>
          <p>
            編集範囲は <code>{session.exerciseModule.dir}</code>、最大
            {session.exerciseModule.fileBudget}ファイル・約{session.exerciseModule.lineBudget}行です。
          </p>
          <p>
            検証問題を保持する <code>src/shared/schemaResult.ts</code> は配布済みです。
            このファイルは読みますが、演習では変更しません。
          </p>
          <p>
            ブラウザ内でも同じ失敗を再現できるよう、演習テストはインメモリRepositoryで
            HTTP前後の状態と監査記録を観測し、Drizzle schemaとmigration SQLも検査します。
            実ファイルSQLiteの接続と再起動は通常テストで確認します。
          </p>
          <CodeGuideCards guides={guides} projectFiles={projectFiles} />

          <h3>修正前の失敗を確認する</h3>
          <ul class="exercise-failures" aria-label="修正前に確認する問題">
            {session.steps.map((step) => <li>{step.startingFailure}</li>)}
          </ul>
          <CommandBlock phase="red" command={session.exerciseCommand} expected="6件の演習テストが失敗します。正常入力の1件だけ成功します。" />
          <p>ブラウザ内の変更はローカルへ反映されません。</p>
          <div data-code-explorer={workspace.slug}>
            <CodeExplorer
              client:load
              workspace={workspace}
              projectFiles={projectFiles}
              initialCommand={session.exerciseCommand}
            />
          </div>
        </section>

        <section id="teach">
          <h2>境界の原則（{session.timeBreakdown.teach}分）</h2>
          <p>
            完成コードを写す前に、入口で止める処理と出口で絞る処理を分けて確認します。
            どちらも、境界を越えてよいデータを明示する設計です。
          </p>
          {teaching.map((topic) => (
            <article class="teaching-topic">
              <h3>{topic.name}</h3>
              <p>{topic.explanation}</p>
              <figure class="code-block">
                <Code code={topic.code} lang={topic.code.includes("type ") ? "ts" : "text"} />
              </figure>
              <p class="teaching-topic__why">{topic.takeaway}</p>
            </article>
          ))}

          <aside class="decision-card">
            <h3>時間外の補足</h3>
            <details>
              <summary>検査結果のJSONへ同じ考え方を移す</summary>
              <p>
                <code>ExamResult</code> も外部から届く値です。診察開始入力の修正後に、項目の欠落、配列の要素、識別子を同じ順序で検証できます。
              </p>
            </details>
            <details>
              <summary>Sensitiveは追加の誤出力対策として使う</summary>
              <p>
                正当な理由で読み込んだ機密値を既定で伏せる対策です。今回のように不要な個人情報を収集または保存しない設計の代わりにはなりません。
              </p>
            </details>
          </aside>
        </section>

        <section id="refactor">
          <h2>演習</h2>
          <h3>進め方: 言語化 → Agentへの依頼 → 検証</h3>
          <ol class="adv-flow">
            <li><strong>言語化（{session.adv.articulate}分）</strong>: 境界で止める入力と、保存を許可する監査項目を書く。</li>
            <li><strong>依頼（{session.adv.delegate}分）</strong>: 3つの判断を埋めてAgentへ依頼し、段階ごとに演習テストを実行する。</li>
            <li><strong>検証（{session.adv.verify}分）</strong>: 422の前後と正常時の監査データをRepositoryで比較し、通常テストで実ファイルSQLiteも確認する。</li>
          </ol>

          <div class="delegation-prompt">
            <h3>プロンプトのテンプレート</h3>
            <p>角括弧の中は、事故と配布コードを読んだ自分の判断で埋めます。</p>
            <pre><code>{delegationPrompt}</code></pre>
          </div>

          <h3>実装する順序</h3>
          <ol>
            {session.steps.map((step) => <li>{step.goal}</li>)}
          </ol>

          <h3>この演習で解決しないこと</h3>
          <p>{narrative.limitation}</p>

          <h3 data-solution-heading>ステップごとの解答</h3>
          <p>
            解答はSession 05の関連箇所だけを示します。Session 04にある既存の引数や型は残し、
            5つのtarget file内で検証、422分岐、保存項目の絞り込みを行います。
          </p>
          {solutionSteps.map(({ step, presentation, snippets }) => (
            <div class="solution-step">
              <details class="step-solution" data-presentation={presentation}>
                <summary>{step.goal}</summary>
                {snippets.map(({ solution, code }) => (
                  <section class="step-solution__snippet">
                    <h4><code>{solution.path}</code></h4>
                    <Code code={code} lang="ts" />
                  </section>
                ))}
              </details>
            </div>
          ))}
          <CommandBlock phase="green" command={session.exerciseCommand} expected="7件の演習テストがすべて成功します。" />
          <h3>既にデモを起動していた場合</h3>
          <p>
            <code>drizzle/0000_initial.sql</code> はSession 04の開始スナップショットなので、
            適用済みの <code>clinic.sqlite</code> へ修正後の初期schemaは再適用されません。
            デモを停止し、次のコマンドでSession 04のローカルDBを作り直してから再起動します。
            予約状態と監査記録は初期状態へ戻り、削除したDBは復元されません。
          </p>
          <CommandBlock phase="green" command="pnpm demo:reset:04\npnpm demo:04" expected="owner_contact列のない初期schemaでデモが起動します。" />

          <h3>演習を完了できないとき</h3>
          <p>{narrative.fallback}</p>
        </section>

        <section id="review">
          <h2>レビューと持ち帰り</h2>
          <div class="exercise-review-checklist">
            <h3>個人で確認する</h3>
            <ol>{commonReviewChecks.map((check) => <li>{check}</li>)}</ol>
            <p>前のセッションの未commit差分は残して構いません。reset、stash、commit は不要です。</p>
            <p><strong>残すもの:</strong> {reviewCompletionArtifacts.join("、")}</p>
            <h3>業務へ持ち帰る</h3>
            <p>{businessReflectionQuestion}</p>
          </div>
          <section class="peer-review-panel">
            <h3>班内相互レビュー（{session.peerReview.minutes}分・{headcount}）</h3>
            <p><a href={promisesHref}>進行上の約束事を確認する</a></p>
            <ol>{session.peerReview.questions.map((question) => <li>{question}</li>)}</ol>
          </section>
        </section>
      </SessionPageNavigation>

      <nav class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
    </main>
  </div>
</BaseLayout>
