---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/03-result-errors";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("03-result-errors");
if (session === undefined) throw new Error("Unknown session: 03-result-errors");
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement: "診察開始に失敗した理由を、受付画面が文言ではなく型付きの値として扱えるようにする。",
      legacy: "throw、try/catch、文言依存、誤ったエラー写像を読みます。この回の主題は同期 Result であり、Domain Event ではありません。",
      technique: "kind を持つ error union、Result、ok / err、andThen の同期パイプライン、fake port。",
      limitation: "予期できる失敗と予期できない例外の線引きや利用者向け文言は、人の判断とレビューに残ります。",
      reviewFocus: "Result を返す guard を map で入れ子にせず、andThen で接続し、失敗後に遷移・保存しないか。",
      fallback: "同じ形の2つの guard を解答から写し、最後に startExamination の try/catch を andThen へ置き換えます。",
    }}
  />
</SessionLayout>
