---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/02-state-transitions";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("02-state-transitions");
if (session === undefined) throw new Error("Unknown session: 02-state-transitions");
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement: "会計済み・キャンセル済みの予約を診察中に戻してはいけない。また、各状態ごとに必要十分な情報を持つ",
      currentRisk: "予約を任意の状態に更新できてしまう。また各状態で本来必要な情報も省略できてしまうため、二重請求につながる予約を作れてしまう。",
      design: "予約モデルは、状態ごとに型を分けて定義する（判別共用体）。また、状態の変更は状態遷移として捉え、純粋関数で表現する。この関数は、型を利用して事前に許可した遷移のみを許容する形にする。複数の状態を扱う場合は網羅チェックを行い、状態の抜け漏れがないようにする。",
      limitation: "外部から入力される未検証の値や、型アサーションで無理やり型付けされた値は、このモジュールの状態表現だけでは防げない。",
      nextQuestion: "外部入力をどこで検証し、同じ文字列形式のIDや公開してよい情報をどう区別するか。",
      legacy: "Appointment 全体を受ける遷移関数、throw、as Appointment、default 分岐など、current state 欄を壊す処理を探します。",
      reviewFocus: "toStatusLabel の default が消え、新しい状態を足すとコンパイルエラーになるか。",
      fallback: "解答スナップショットをステップ単位で開き、まず遷移関数の引数型、その後に網羅分岐をコピペします。相互レビューは行いましょう。",
    }}
  />
</SessionLayout>
