---
import SessionFrame from "../../components/session-frame/SessionFrame.astro";
import { sessionPages, sessionSlug } from "../../sessions/pages/03-boundaries-and-pii";
import * as content from "../../sessions/pages/03-boundaries-and-pii-content";
import Prose from "../../sessions/prose/03-boundaries-and-pii/index.mdx";

export const guides = content.guides;
export const navigation = content.navigation;
export const paymentAmountQuote = content.paymentAmountQuote;
export const promisesHref = content.promisesHref;
export const session = content.session;
export const supplementaryExercise = content.supplementaryExercise;
export const workspace = content.workspace;
---

<SessionFrame
  sessionSlug={sessionSlug}
  pages={sessionPages}
  pageSlug=""
  description={session.summary}
>
  <Prose />
  <script is:inline>
    const destinations = new Map([
      ["incident", "night-shift/"],
      ["legacy", "current-code/"],
      ["teach", "result/"],
      ["supplementary", "exercise/"],
      ["refactor", "exercise/"],
      ["review", "review/"],
    ]);
    const destination = destinations.get(location.hash.slice(1));
    if (destination) {
      const base = location.pathname.endsWith("/") ? location.pathname : `${location.pathname}/`;
      location.replace(`${base}${destination}`);
    }
  </script>
</SessionFrame>
