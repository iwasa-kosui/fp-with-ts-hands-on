---
import CodeGuideCards from "../../components/CodeGuideCards.astro";
import CommandBlock from "../../components/CommandBlock.astro";
import GuardTable from "../../components/GuardTable.astro";
import SessionPageNavigation from "../../components/SessionPageNavigation.astro";
// CSS chunk の分割と読み込み順を変換前と同じに保つ
import "../../components/code-explorer/CodeExplorer";
import Prose from "../../sessions/prose/03-boundaries-and-pii.mdx";
import type { CodeGuide } from "../../code-explorer/code-guide";
import { projectFilesForSnapshot } from "../../code-explorer/project-files";
import type { ProjectFiles, SessionWorkspace } from "../../code-explorer/types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSolutionSnippets } from "../../sessions/solution-snippets";
import { blockOf, sourceOf } from "../../sessions/source-quotes";
import type {
  DelegationPrompt,
  ExampleSnapshot,
  ExerciseModule,
  ExerciseSessionSummary,
  ExerciseStep,
  SessionSummary,
  SolutionPresentation,
} from "../../sessions/types";
import "../../styles/code-playground.css";
import "../../styles/sessions.css";
import EpisodeIllustration from "../../components/EpisodeIllustration.astro";

type TeachingSnippets = Readonly<{
  before: string;
  after: string;
}>;

type SupplementaryExercise = Readonly<{
  exerciseCommand: string;
  exerciseModule: ExerciseModule;
  solutionSnapshot: ExampleSnapshot;
  solutionPresentation: SolutionPresentation;
  incident: string;
  delegationPrompt: DelegationPrompt;
  steps: readonly ExerciseStep[];
}>;

export const session: SessionSummary = {
  slug: "03-boundaries-and-pii",
  snapshot: "session-04",
  sequence: "03",
  kind: "exercise",
  title: "診察開始の入力を境界で検証する",
  durationMinutes: 35,
  timeBreakdown: { brief: 3, teach: 10, exercise: 15, review: 7 },
  adv: { articulate: 2, delegate: 11, verify: 2 },
  peerReview: {
    minutes: 7,
    pickCount: 2,
    questions: [
      "不正な予約IDまたは獣医師IDを含む入力は、`StartExaminationInput` になりませんか。",
      "`parse` は外部入力を `unknown` として受け取っていますか。",
      "検証に成功した場合だけ、`AppointmentId` と `VeterinarianId` をユースケースへ渡せますか。",
    ],
  },
  solutionSnapshot: "session-05",
  solutionPresentation: "excerpt",
  peerReviewPromises: "reference",
  animal: { name: "BIRD", type: "bird", avatar: "🐦" },
  summary: "値の制約を型で表す書き方を学び、HTTPから届く予約IDと担当獣医師IDを検査して、型付きの診察開始入力へ変換します。",
  episode: [
    "15時30分、受付担当者が診察開始画面で夜勤の獣医師を選びました。",
    "フロントエンドの送信処理は、獣医師のUUIDではなく画面表示用の勤務区分「night-shift」をveterinarianIdへ入れました。",
    "境界のparseは値を検査せずOkを返し、不正な値からStartExaminationInputを作りました。",
  ],
  incident: "HTTPから届いた不正なIDを検査せず、診察開始の入力として扱った。",
  exerciseCommand: "pnpm exercise:04",
  exerciseModule: {
    dir: "examples/session-04/src/boundary",
    fileBudget: 1,
    lineBudget: 18,
  },
  delegationPrompt: {
    decisions: [
      "外部入力をunknownとして受け取る場所はどこか",
      "AppointmentIdとVeterinarianIdのschemaをどう組み合わせるか",
    ],
  },
  steps: [
    {
      id: "s4-reject-invalid-appointment-id",
      goal: "不正な予約IDを含むHTTP入力は、StartExaminationInputにならないようにする。",
      startingFailure: "不正な予約IDでも、診察開始の入力として扱える。",
      targets: ["examples/session-04/src/boundary/startExaminationInput.ts"],
      solutions: [{
        path: "examples/session-05/src/boundary/startExaminationInput.ts",
        symbol: "StartExaminationInput",
        lines: [6, 18],
      }],
    },
    {
      id: "s4-reject-invalid-veterinarian-id",
      goal: "不正な担当獣医師IDを含むHTTP入力は、StartExaminationInputにならないようにする。",
      startingFailure: "不正な担当獣医師IDでも、診察開始の入力として扱える。",
      targets: ["examples/session-04/src/boundary/startExaminationInput.ts"],
      solutions: [{
        path: "examples/session-05/src/boundary/startExaminationInput.ts",
        symbol: "StartExaminationInput",
        lines: [6, 18],
      }],
    },
  ],
  decisions: [
    {
      invariant: "外部入力はunknownとして受け取り、境界で検証してから型付き入力になる。",
    },
    {
      invariant: "予約IDと担当獣医師IDの両方が正しい場合だけ、startExaminationへ渡す。",
    },
  ],
  finalReferences: [
    "examples/final/src/domain/shared/schemaResult.ts",
    "examples/final/src/domain/appointment/appointmentId.ts",
    "examples/final/src/domain/appointment/veterinarianId.ts",
    "examples/final/src/useCase/startExaminationUseCase.ts",
    "examples/final/src/domain/appointment/paymentAmount.ts",
  ],
};

export const supplementaryExercise: SupplementaryExercise = {
  exerciseCommand: "pnpm exercise:03",
  exerciseModule: {
    dir: "examples/session-03/src/domain",
    fileBudget: 5,
    lineBudget: 34,
  },
  solutionSnapshot: "session-04",
  solutionPresentation: "excerpt",
  incident: "診察開始で AppointmentId と VeterinarianId を取り違えても、型検査が通った。",
  delegationPrompt: {
    decisions: [
      "AppointmentIdとVeterinarianIdをどの型として定義するか",
      "用途の区別を予約状態とstartExaminationへどう伝えるか",
      "取り違えをコンパイルエラーとしてどう残すか",
    ],
  },
  steps: [
    {
      id: "s3-brand-start-examination-ids",
      goal: "予約IDと担当獣医師IDを、配布済みの識別子と同じ規約で別々の型にする。",
      startingFailure: "予約IDと担当獣医師IDを取り違えても、型検査が通る。",
      targets: [
        "examples/session-03/src/domain/appointment/appointmentId.ts",
        "examples/session-03/src/domain/appointment/veterinarianId.ts",
      ],
      solutions: [
        {
          path: "examples/session-04/src/domain/appointment/appointmentId.ts",
          symbol: "AppointmentId",
          lines: [3, 6],
        },
        {
          path: "examples/session-04/src/domain/appointment/veterinarianId.ts",
          symbol: "VeterinarianId",
          lines: [3, 6],
        },
      ],
    },
    {
      id: "s3-apply-start-examination-ids",
      goal: "予約の6状態とstartExaminationが、用途別の識別子を受け取るようにする。",
      startingFailure: "予約状態とstartExaminationが、用途を区別しないstringを受け取る。",
      targets: [
        "examples/session-03/src/domain/appointment/appointment.ts",
        "examples/session-03/src/domain/appointment/transitions.ts",
      ],
      solutions: [
        {
          path: "examples/session-04/src/domain/appointment/appointment.ts",
          symbol: "Scheduled",
          lines: [1, 15],
        },
        {
          path: "examples/session-04/src/domain/appointment/transitions.ts",
          symbol: "startExamination",
          lines: [17, 27],
        },
      ],
    },
    {
      id: "s3-reject-id-swap",
      goal: "AppointmentIdとVeterinarianIdを入れ替えたコードがコンパイルできないことを、型テストで確かめる。",
      startingFailure: "取り違えた2行が、型エラーにならないままコンパイルされる。",
      targets: ["examples/session-03/src/domain/domain.test-types.ts"],
      solutions: [{
        path: "examples/session-04/src/domain/domain.test-types.ts",
        symbol: "acceptAppointmentId",
        lines: [1, 14],
      }],
    },
  ],
};

export const guides = ([
  {
    id: "http-start-examination-input",
    title: "診察開始のHTTP入力はrouteで組み立てている",
    currentDesign: "path parameterの予約IDとrequest bodyのveterinarianIdを、raw objectへまとめてStartExaminationInput.parseへ渡しています。",
    futureRisk: "bodyへnight-shiftが入っても、境界のparserが検査しなければStartExaminationInputとして処理されます。",
    path: "src/web/routes.ts",
    highlights: [{ startLineNumber: 109, endLineNumber: 115 }],
  },
  {
    id: "unvalidated-start-examination-input",
    title: "HTTP入力をanyのまま診察開始の入力へ入れている",
    currentDesign: "raw: anyから2項目をコピーし、検査せずに必ずokを返しています。",
    futureRisk: "TypeScriptは返り値の型注釈を信頼するため、night-shiftも型の上ではVeterinarianIdとして後続処理へ渡ります。",
    path: "src/boundary/startExaminationInput.ts",
    highlights: [{ startLineNumber: 1, endLineNumber: 15 }],
  },
] as const) satisfies readonly CodeGuide[];

export const paymentAmountQuote = ({
  source: "examples/final/src/domain/appointment/paymentAmount.ts",
  code: sourceOf(
    projectFilesForSnapshot("final"),
    "src/domain/appointment/paymentAmount.ts",
  ),
} as const);

const paymentAmountCaption = `実コード: ${paymentAmountQuote.source}`;

const session03Files = projectFilesForSnapshot("session-03");
const session04Files = projectFilesForSnapshot("session-04");
const examResultQuote = {
  path: "examples/session-05/src/boundary/examResult.ts",
  code: sourceOf(projectFilesForSnapshot("session-05"), "src/boundary/examResult.ts"),
};

const appointmentAndStartExamination = (files: ProjectFiles) => `${blockOf(
  files,
  "src/domain/appointment/appointment.ts",
  "export type Scheduled = Readonly<{",
  "}>;",
)}

${blockOf(
  files,
  "src/domain/appointment/transitions.ts",
  "export const startExamination = (",
  "  }) as const satisfies InExamination;",
)}`;

const supplementaryExerciseTeaching: readonly TeachingSnippets[] = [
  {
    before: sourceOf(session03Files, "src/domain/appointment/appointmentId.ts"),
    after: sourceOf(session04Files, "src/domain/appointment/appointmentId.ts"),
  },
  {
    before: appointmentAndStartExamination(session03Files),
    after: appointmentAndStartExamination(session04Files),
  },
  {
    before: sourceOf(session03Files, "src/domain/domain.test-types.ts"),
    after: sourceOf(session04Files, "src/domain/domain.test-types.ts"),
  },
];

const supplementaryExerciseTypecheckCommand =
  "pnpm --filter @fp-with-ts/clinic-session-03 typecheck";
const supplementaryExerciseSolutionSteps = await Promise.all(
  supplementaryExercise.steps.map(async (step) => ({
    step,
    snippets: await loadSolutionSnippets(step),
  })),
);
const supplementaryExercisePrompt = `${supplementaryExercise.exerciseModule.dir} のコードを直して、
${supplementaryExercise.exerciseCommand} を成功させてください。

取り違えてはいけない値: [言語化フェーズで書いた1文]`;

const incidentRequest = `POST /appointments/11111111-1111-4111-8111-111111111111/start-examination
Content-Type: application/json

{
  "veterinarianId": "night-shift"
}`;

const exerciseSession: ExerciseSessionSummary = session;

export const workspace = ({
  slug: session.slug,
  snapshot: session.snapshot,
  initialFile: "exercises/start-examination-input.test.ts",
  description: "HTTP入力を診察開始の型付き入力へ変換する境界を確認します。",
  visibleFiles: [
    "exercises/start-examination-input.test.ts",
    "test/regression/semantic-identifiers.test.ts",
    "test/regression/state-modeling.test.ts",
    "src/domain/appointment/appointmentId.ts",
    "src/domain/appointment/veterinarianId.ts",
    "src/boundary/startExaminationInput.ts",
    "src/shared/schemaResult.ts",
    "src/web/routes.ts",
  ],
} as const) satisfies SessionWorkspace;

const projectFiles = projectFilesForSnapshot(session.snapshot);
const solutionSteps = await Promise.all(
  session.steps.map(async (step) => ({
    step,
    presentation: step.solutions[0].presentation ?? "excerpt",
    snippets: await loadSolutionSnippets(step),
  })),
);
const chapters = [
  { id: "incident", label: "今回つくるもの" },
  { id: "legacy", label: "コードを読み、失敗を再現する" },
  { id: "teach", label: "事前知識" },
  { id: "supplementary", label: "補助演習" },
  { id: "refactor", label: "演習" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
export const promisesHref =
  "/sessions/01-state-transitions/#peer-review-promises";
export const navigation = ({
  previous: {
    href: "/sessions/02-adt-and-exhaustiveness/",
    title: "予約の状態の分岐漏れを型で検出する",
  },
  next: {
    href: "/sessions/04-workflow-errors/",
    title: "失敗をユースケースの結果として扱う",
  },
} as const);
const headcount = session.peerReview.pickCount === 2 ? "1〜2名" : "1名";
const guardQuestion = "<code>as</code> で <code>AppointmentId</code> を作ると、検査を通らない値が型付きの入力になります。これを、文面のほかにどの仕組みで防げますか。";
const guards = [
  {
    problem: "予約 ID と獣医師 ID を取り違える",
    mechanism: "Branded Type",
    signal: "<code>pnpm exercise:03</code> の型検査",
  },
  {
    problem: "検査していない外部入力を診察開始へ渡す",
    mechanism: "Zod の schema と <code>Result</code> を返す入力の検査",
    signal: "<code>pnpm exercise:04</code> の演習テスト",
  },
] as const;
const guardModules = [supplementaryExercise.exerciseModule, session.exerciseModule];
const delegationPrompt = `${session.exerciseModule.dir} のコードを直して、
${session.exerciseCommand} を成功させてください。

境界で拒否する入力: [言語化フェーズで書いた1文]`;
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file case-file--session">
    <header class="case-file__site-header"><a href="/"><span class="case-file__brand-mark" aria-hidden="true">🐾</span>WAN NYAN CLINIC</a></header>
    <main>
      <SessionPageNavigation currentSlug={session.slug} chapters={chapters}>
      <section slot="hero" class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.animal.avatar}</span>
          {session.summary}
        </p>
      </section>
      <Prose
        components={{ CodeGuideCards, CommandBlock, EpisodeIllustration, GuardTable }}
        session={session}
        supplementaryExercise={supplementaryExercise}
        guides={guides}
        workspace={workspace}
        projectFiles={projectFiles}
        solutionSteps={solutionSteps}
        incidentRequest={incidentRequest}
        paymentAmountCaption={paymentAmountCaption}
        paymentAmountCode={paymentAmountQuote.code}
        examResultQuote={examResultQuote}
        supplementaryExerciseTeaching={supplementaryExerciseTeaching}
        supplementaryExerciseTypecheckCommand={supplementaryExerciseTypecheckCommand}
        supplementaryExerciseSolutionSteps={supplementaryExerciseSolutionSteps}
        supplementaryExercisePrompt={supplementaryExercisePrompt}
        delegationPrompt={delegationPrompt}
        delegationDecisions={exerciseSession.delegationPrompt.decisions}
        supplementaryDelegationDecisions={supplementaryExercise.delegationPrompt.decisions}
        guards={guards}
        guardQuestion={guardQuestion}
        guardModules={guardModules}
        headcount={headcount}
        promisesHref={promisesHref}
      />
      <nav slot="footer" class="case-file__session-nav" aria-label="前後のセッション">
        <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
        <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
      </nav>
      </SessionPageNavigation>
    </main>
  </div>
</BaseLayout>
