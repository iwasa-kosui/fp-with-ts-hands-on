---
import ExerciseSessionContent from "../../components/ExerciseSessionContent.astro";
import guides from "../../code-explorer/code-guides/01-state-modeling";
import SessionLayout from "../../layouts/SessionLayout.astro";
import { sessionBySlug } from "../../sessions/catalog";

const session = sessionBySlug("01-state-modeling");
if (session === undefined) throw new Error("Unknown session: 01-state-modeling");
---

<SessionLayout session={session}>
  <ExerciseSessionContent
    session={session}
    guides={guides}
    narrative={{
      requirement: "Scheduled / CheckedIn / InExamination / Paid / Canceled の5状態と、許可した遷移だけをコードへ移す。キャンセル理由は必ず残す。",
      accident: "会計済みの来院が診察中へ戻され、会計が二度行われた。",
      legacy: "Appointment 全体を受ける遷移関数、throw、as Appointment、default 分岐を読みます。",
      technique: "判別共用体、遷移元を限定した純粋関数、as const satisfies、assertNever。",
      limitation: "外部 JSON から捏造された状態は、このモジュールの型だけでは検証できません。",
      reviewFocus: "toStatusLabel の default が消え、6つ目の状態を足すとコンパイルエラーになるか。",
      fallback: "次スナップショットの解答をステップ単位で開き、まず遷移関数の引数型、その後に網羅分岐を写します。相互レビューは省きません。",
    }}
  />
</SessionLayout>
