---
import type { GetStaticPaths } from "astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import SessionFrame from "../../../components/session-frame/SessionFrame.astro";
import { sessionPages, sessionSlug } from "../../../sessions/pages/03-boundaries-and-pii";

export const getStaticPaths = (() =>
  sessionPages
    .filter(({ slug }) => slug !== "")
    .map((page) => ({ params: { page: page.slug }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props;
const proseModules = import.meta.glob<{ Content: AstroComponentFactory }>(
  "../../../sessions/prose/03-boundaries-and-pii/*.mdx",
);
const loadProse = proseModules[`../../../sessions/prose/03-boundaries-and-pii/${page.slug}.mdx`];
if (loadProse === undefined) {
  throw new Error(`Missing prose for ${sessionSlug}/${page.slug}`);
}
const { Content } = await loadProse();
---

<SessionFrame
  sessionSlug={sessionSlug}
  pages={sessionPages}
  pageSlug={page.slug}
  fullWidth={page.kind === "exercise"}
>
  <Content />
</SessionFrame>
